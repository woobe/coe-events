   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 13., 14.00</p></td>
  </tr>
  <tr id="717">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>6.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
