   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 14., 14.00</p></td>
  </tr>
  <tr id="735">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>8.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">angol nyelv</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">angol nyelv</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 15., 8.00</p></td>
  </tr>
  <tr id="744">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>9.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">kémia,<br>
     gazdasági ismeretek,<br>
     honvédelmi alapismeretek</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">kémia,<br>
     honvédelmi alapismeretek, természettudomány</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 15., 14.00</p></td>
  </tr>
  <tr id="753">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>10.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">nemzetiségi nyelv és irodalom</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">nemzetiségi nyelv és irodalom</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 16., 8.00</p></td>
  </tr>
  <tr id="762">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>11.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">vizuális kultúra,<br>
     filozófia</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">vizuális kultúra,<br>
     filozófia</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 16., 14.00</p></td>
  </tr>
  <tr id="771">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>12.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
