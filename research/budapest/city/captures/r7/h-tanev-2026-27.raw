   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">történelem</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">2026. október 14., 8.00</p></td>
  </tr>
  <tr id="726">
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP"><b>7.</b></p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
    <p class="AC mhk-KOZEP">francia nyelv</p></td>
   <td colspan="1" rowspan="1" valign="BASELINE" align="CENTER" class="bot bor bol bob">
