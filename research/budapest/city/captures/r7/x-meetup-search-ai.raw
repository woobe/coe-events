8854902","name":"Tamas Majer","memberPhoto":{"__ref":"PhotoInfo:297650515"}},"PhotoInfo:326383579":{"__typename":"PhotoInfo","id":"326383579","highResUrl":"https://secure.meetupstatic.com/photos/member/a/a/3/b/highres_326383579.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:481404368":{"__typename":"Member","id":"481404368","name":"leventepapp87","memberPhoto":{"__ref":"PhotoInfo:326383579"}},"PhotoInfo:322726014":{"__typename":"PhotoInfo","id":"322726014","highResUrl":"https://secure.meetupstatic.com/photos/member/b/3/b/e/highres_322726014.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:455627538":{"__typename":"Member","id":"455627538","name":"Antony","memberPhoto":{"__ref":"PhotoInfo:322726014"}},"PhotoInfo:325435087":{"__typename":"PhotoInfo","id":"325435087","highResUrl":"https://secure.meetupstatic.com/photos/member/d/7/2/f/highres_325435087.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:406084638":{"__typename":"Member","id":"406084638","name":"Ryan B","memberPhoto":{"__ref":"PhotoInfo:325435087"}},"Member:485540157":{"__typename":"Member","id":"485540157","name":"G","memberPhoto":null},"PhotoInfo:326504301":{"__typename":"PhotoInfo","id":"326504301","highResUrl":"https://secure.meetupstatic.com/photos/member/a/d/0/d/highres_326504301.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:484700964":{"__typename":"Member","id":"484700964","name":"Judit","memberPhoto":{"__ref":"PhotoInfo:326504301"}},"Event:317520852":{"__typename":"Event","id":"317520852","title":"Open philosophy session - Tonight you bring the topic!","dateTime":"2026-11-26T18:00:00+01:00","description":"Tonight, everybody is encouraged to bring one or more questions, ideas, dilemmas, or topics they would like to discuss. We will vote to decide the order of the topics to discuss.\nSome example questions:\n- Can freedom exist without responsibility?\n- Is technology making us wiser?\n- What makes a good life?\n- Is suffering necessary for growth?\n- Can morality exist without religion?\n- How much should we rely on science vs other sources - including our own intuition?\n- How would immortality change our attitude towards things in life?\n- What does personal freedom really mean?\n- Do people actually want democracy or is it just an acceptable consensus?\n\nThe goal is not to win an argument or reach consensus, but to think, challenge assumptions, and encounter perspectives different from our own.\n- Bring a question! We'll take care of the rest.\n\n**Free event. We'll start at 18:00 so make sure you arrive in time!**","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/budapest-philosophy/events/317520852/","isAttending":false,"isSaved":false,"maxTickets":20,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536533611"},"displayPhoto":{"__ref":"PhotoInfo:536533611"},"feeSettings":null,"group":{"__ref":"Group:37807709"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":20,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:332812860"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:480556907"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:467910127"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:160350902"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:475892410"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:194011897"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484496220"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485390320"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:163461342"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:193602002"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:479178598"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484646311"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483408232"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:479673365"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:118854902"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481404368"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:455627538"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:406084638"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485540157"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484700964"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Művház Kávézó","address":"Budapest, Bartók Béla út 33, 1114 Hungary","city":"Budapest","state":"","country":"hu"}},"PhotoInfo:536917586":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/9/2/d/2/highres_536917586.jpeg","id":"536917586"},"PhotoInfo:258845916":{"__typename":"PhotoInfo","id":"258845916","highResUrl":"https://secure.meetupstatic.com/photos/member/1/7/1/c/highres_258845916.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:190362333":{"__typename":"Member","id":"190362333","name":"Daniel Szegö","memberPhoto":{"__ref":"PhotoInfo:258845916"}},"Member:357270870":{"__typename":"Member","id":"357270870","name":"Frank Rehder","memberPhoto":null},"PhotoInfo:262404389":{"__typename":"PhotoInfo","id":"262404389","highResUrl":"https://secure.meetupstatic.com/photos/member/5/f/4/5/highres_262404389.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:196043422":{"__typename":"Member","id":"196043422","name":"Banee Ishaque K","memberPhoto":{"__ref":"PhotoInfo:262404389"}},"PhotoInfo:314596892":{"__typename":"PhotoInfo","id":"314596892","highResUrl":"https://secure.meetupstatic.com/photos/member/4/1/f/c/highres_314596892.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:362833509":{"__typename":"Member","id":"362833509","name":"Mikhail Poma","memberPhoto":{"__ref":"PhotoInfo:314596892"}},"PhotoInfo:324583928":{"__typename":"PhotoInfo","id":"324583928","highResUrl":"https://secure.meetupstatic.com/photos/member/a/b/9/8/highres_324583928.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:388235604":{"__typename":"Member","id":"388235604","name":"Teacher/Coder Jason","memberPhoto":{"__ref":"PhotoInfo:324583928"}},"Member:484443205":{"__typename":"Member","id":"484443205","name":"aisha","memberPhoto":null},"Event:317237690":{"__typename":"Event","id":"317237690","title":"ZK Learning Group: Wrap-up 2026, ZK order book matching","dateTime":"2026-12-10T18:00:00+01:00","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: https://discord.com/channels/905194001349627914/1329201532628898036\nGithub repo for the lab:\nhttps://github.com/LF-Decentralized-Trust-labs/zk-learning-group\nIn this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317237690/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536917586"},"displayPhoto":{"__ref":"PhotoInfo:536917586"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":7,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:190362333"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:357270870"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:196043422"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:362833509"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:388235604"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484443205"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:389749595"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}}},"_sentryTraceData":"bb55d68d94b137cf1948306d3a17ff6f-950feba70497002c-0","_sentryBaggage":"sentry-environment=production,sentry-release=ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb,sentry-public_key=5d12cd2317664353456ab4c40d079af2,sentry-trace_id=bb55d68d94b137cf1948306d3a17ff6f,sentry-org_id=6787,sentry-sampled=false,sentry-sample_rand=0.6191130565165384,sentry-sample_rate=0.01"},"__N_SSP":true},"page":"/find","query":{"location":"hu--Budapest","source":"EVENTS","keywords":"artificial intelligence"},"buildId":"ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb","isFallback":false,"isExperimentalCompile":false,"gssp":true,"locale":"en-US","locales":["en-US","en-AU","de","de-DE","es","es-ES","fr","fr-FR","it","it-IT","ja","ja-JP","ko","ko-KR","nl","nl-NL","pl","pl-PL","pt","pt-BR","ru","ru-RU","tr","tr-TR","th-TH"],"defaultLocale":"en-US","scriptLoader":[]}</script></body></html>