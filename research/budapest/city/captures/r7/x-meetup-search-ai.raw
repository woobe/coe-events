M.","memberPhoto":{"__ref":"PhotoInfo:309146052"}},"PhotoInfo:270995029":{"__typename":"PhotoInfo","id":"270995029","highResUrl":"https://secure.meetupstatic.com/photos/member/8/8/d/5/highres_270995029.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:194984375":{"__typename":"Member","id":"194984375","name":"Mihály Orsós","memberPhoto":{"__ref":"PhotoInfo:270995029"}},"Member:469420368":{"__typename":"Member","id":"469420368","name":"istvan.pataki","memberPhoto":null},"Member:409217002":{"__typename":"Member","id":"409217002","name":"János Rokai","memberPhoto":null},"PhotoInfo:283082444":{"__typename":"PhotoInfo","id":"283082444","highResUrl":"https://secure.meetupstatic.com/photos/member/9/8/c/highres_283082444.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:269466655":{"__typename":"Member","id":"269466655","name":"Sipos Róbert","memberPhoto":{"__ref":"PhotoInfo:283082444"}},"Member:280484392":{"__typename":"Member","id":"280484392","name":"Gyorgy Acs","memberPhoto":null},"Member:404223154":{"__typename":"Member","id":"404223154","name":"Ernest Prorok","memberPhoto":null},"Member:176888182":{"__typename":"Member","id":"176888182","name":"Anett Lukács","memberPhoto":null},"PhotoInfo:318460381":{"__typename":"PhotoInfo","id":"318460381","highResUrl":"https://secure.meetupstatic.com/photos/member/9/d/b/d/highres_318460381.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:234192501":{"__typename":"Member","id":"234192501","name":"Kendi J.","memberPhoto":{"__ref":"PhotoInfo:318460381"}},"PhotoInfo:268613802":{"__typename":"PhotoInfo","id":"268613802","highResUrl":"https://secure.meetupstatic.com/photos/member/d/2/2/a/highres_268613802.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:129419512":{"__typename":"Member","id":"129419512","name":"Zsolt Simon","memberPhoto":{"__ref":"PhotoInfo:268613802"}},"PhotoInfo:81946052":{"__typename":"PhotoInfo","id":"81946052","highResUrl":"https://secure.meetupstatic.com/photos/member/b/3/e/4/highres_81946052.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:69575172":{"__typename":"Member","id":"69575172","name":"Zalán Tóth","memberPhoto":{"__ref":"PhotoInfo:81946052"}},"PhotoInfo:322341664":{"__typename":"PhotoInfo","id":"322341664","highResUrl":"https://secure.meetupstatic.com/photos/member/5/4/a/0/highres_322341664.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:374431832":{"__typename":"Member","id":"374431832","name":"Péter Gönczi","memberPhoto":{"__ref":"PhotoInfo:322341664"}},"Member:477090229":{"__typename":"Member","id":"477090229","name":"csalaraakos","memberPhoto":null},"Event:317410124":{"__typename":"Event","id":"317410124","title":"Budapest ML Meetup #12","dateTime":"2026-12-01T18:00:00+01:00","description":"🔻🔸🔻 ***Please fill out the [Registration form](https://www.cognitoforms.com/bic1/MeetupRegistration2026)***[ ](https://www.cognitoforms.com/bic1/MeetupRegistration2026) **to sign up**🔸🔻🔸\n*an additional registration form is required to participate this time*\n\nWe're happy to announce the 12th Budapest ML Meetup!\nJoin the next session in-person to connect with the community and enjoy the presentations.\n\n📆 Date: December 1, 2026 **·** Tuesday **·** 18:00 - 20:00\n📍 Location: Budapest **·** 1134 **·** Váci út 47 E **·** GTC White House Office\n🗣 Language: English\n\n**Talks**\n\n* [Balogh Kitti](https://www.linkedin.com/in/kitti-balogh/), Senior, BlackRock\n*Beyond facts: Preserving narrative in LLM-generated documents*\n* [Arató Bence,](https://www.linkedin.com/in/bencearato/) managing director, BI Consulting\n*AI industry and market trends in 2026*\n\n**Planned Schedule**\n\n* 18:00 Arrival\n* 18:30 Welcome notes and Presentations\n* 19:30 Follow-up discussions\n* 20:00 Closing time\n\n🎉 Catering and the venue are provided by Aladdin Engineering.\n🙋‍♂️ This will be an in-person event with no streaming or recording.\n📸Please let us know on-site if you do not wish to appear in the photos.\n\n**Registration**\nClicking the ‘Attend’ button here is not sufficient to register for this event. To attend, you’ll need to fill out a separate [REGISTRATION FORM](https://www.cognitoforms.com/bic1/meetupregistration2026/). The event is still completely free, and the form only takes a minute to complete. Thanks for your cooperation!","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/budapest-ml-meetup/events/317410124/","isAttending":false,"isSaved":false,"maxTickets":100,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537119052"},"displayPhoto":{"__ref":"PhotoInfo:537119052"},"feeSettings":null,"group":{"__ref":"Group:36320964"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":58,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:237021268"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:343737303"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:402197170"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:480762572"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:182790097"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:469709146"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:224479789"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:244220222"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:194984375"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:469420368"}}},{"__typ