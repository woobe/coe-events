name":"Member","id":"221434171","name":"Alexander Shvets","memberPhoto":{"__ref":"PhotoInfo:321204009"}},"PhotoInfo:216761922":{"__typename":"PhotoInfo","id":"216761922","highResUrl":"https://secure.meetupstatic.com/photos/member/a/3/c/2/highres_216761922.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:160340152":{"__typename":"Member","id":"160340152","name":"Balázs Ilsinszki","memberPhoto":{"__ref":"PhotoInfo:216761922"}},"PhotoInfo:325446885":{"__typename":"PhotoInfo","id":"325446885","highResUrl":"https://secure.meetupstatic.com/photos/member/1/a/e/5/highres_325446885.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:476456485":{"__typename":"Member","id":"476456485","name":"Kovács Eszter","memberPhoto":{"__ref":"PhotoInfo:325446885"}},"PhotoInfo:323493629":{"__typename":"PhotoInfo","id":"323493629","highResUrl":"https://secure.meetupstatic.com/photos/member/8/3/5/d/highres_323493629.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:469709146":{"__typename":"Member","id":"469709146","name":"Georgiy Iakunenko","memberPhoto":{"__ref":"PhotoInfo:323493629"}},"PhotoInfo:317533050":{"__typename":"PhotoInfo","id":"317533050","highResUrl":"https://secure.meetupstatic.com/photos/member/3/2/f/a/highres_317533050.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:310669681":{"__typename":"Member","id":"310669681","name":"Isabell Luo","memberPhoto":{"__ref":"PhotoInfo:317533050"}},"PhotoInfo:323270002":{"__typename":"PhotoInfo","id":"323270002","highResUrl":"https://secure.meetupstatic.com/photos/member/c/3/5/2/highres_323270002.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:420343160":{"__typename":"Member","id":"420343160","name":"Peter Pusztai ","memberPhoto":{"__ref":"PhotoInfo:323270002"}},"PhotoInfo:275060647":{"__typename":"PhotoInfo","id":"275060647","highResUrl":"https://secure.meetupstatic.com/photos/member/5/0/a/7/highres_275060647.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:249049021":{"__typename":"Member","id":"249049021","name":"Bálint Nagy","memberPhoto":{"__ref":"PhotoInfo:275060647"}},"Member:44298052":{"__typename":"Member","id":"44298052","name":"Karoly Horvath","memberPhoto":null},"Event:317427421":{"__typename":"Event","id":"317427421","title":"DevBP #19: Building Faster, Big and Small","dateTime":"2026-11-26T17:30:00+01:00","description":"AI is rapidly rewriting the rules of software development—but what actually happens inside engineering organizations once writing code is no longer the primary bottleneck?\n\nJoin us for an evening of candid, practical insights from engineering leaders navigating the shift to AI-native workflows across two very different worlds: high-velocity product development and global, heavily regulated finance.\n\n=== === === ===\n\n**What Happens When Writing Code Is No Longer the Bottleneck?**\n**[Ákos Kapui](https://www.linkedin.com/in/akoskapui/) -** *CTO @ Shapr3D*\n\nSoftware engineering throughput has always been a major constraint on productivity. If AI removes that constraint, everything should become faster, right?\n\nIn theory, yes. In practice, that's not what happens for most organisations. While many see only marginal improvements, some AI-native companies seem to achieve exponential gains. What makes the difference? Why do some organisations become dramatically faster while others struggle to move beyond incremental improvements?\n\n**Moving Fast in a Highly Regulated World**\n**[Krisztián Fekete](https://www.linkedin.com/in/kfekete/) -** *Director of Engineering @ BlackRock*\n\nA look inside software engineering at a large financial institution, and how AI is changing the way teams work. Drawing on experiences at BlackRock, this talk explores the practical realities of adopting AI in a highly regulated environment, where innovation, governance, security, and compliance all need to coexist.\n\n=== === === ===\n\nThis English-language event will be held at the **Shapr3D office**, where we'll provide snacks and drinks to fuel conversations.\n\nArrival is from 17:30, the presentations start at 18:00.\n\nYou can also find the recordings of previous events on the [@DevBPMeetup YouTube channel](https://www.youtube.com/@DevBPMeetup).\n\nAlso join our brand new Discord server for some online discussions [here](https://discord.gg/Tk5sNM2xu)!","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/devbp-meetup/events/317427421/","isAttending":false,"isSaved":false,"maxTickets":110,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537130434"},"displayPhoto":{"__ref":"PhotoInfo:537130434"},"feeSettings":null,"group":{"__ref":"Group:37782711"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":105,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:211452710"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:372525452"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:227465394"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:401611232"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:437711499"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:394147367"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:262615890"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:468319277"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:243067906"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:419140