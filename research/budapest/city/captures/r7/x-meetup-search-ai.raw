<!DOCTYPE html><html lang="en-US"><head><meta charSet="utf-8" data-next-head=""/><style data-fullcalendar="true" data-next-head=""></style><meta name="viewport" content="width=device-width, initial-scale=1" data-next-head=""/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" data-next-head=""/><meta name="service" content="web-next" data-next-head=""/><meta name="X-Location" content="east" data-next-head=""/><meta name="X-Build-Version" content="ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb" data-next-head=""/><link rel="icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" type="image/x-icon" sizes="any" data-next-head=""/><link rel="shortcut icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" data-next-head=""/><link rel="apple-touch-icon" sizes="120x120" href="https://secure.meetupstatic.com/next/images/general/m_redesign_120x120.png" data-next-head=""/><link rel="apple-touch-icon" sizes="152x152" href="https://secure.meetupstatic.com/next/images/general/m_redesign_152x152.png" data-next-head=""/><link rel="apple-touch-icon" sizes="167x167" href="https://secure.meetupstatic.com/next/images/general/m_redesign_167x167.png" data-next-head=""/><link rel="shortcut icon" sizes="128x128" href="https://secure.meetupstatic.com/next/images/general/m_redesign_128x128.png" data-next-head=""/><link rel="shortcut icon" sizes="196x196" href="https://secure.meetupstatic.com/next/images/general/m_redesign_196x196.png" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Regular.1ca3b39b.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Medium.7b11edcf.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Bold.5c45f750.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Book.27256a60.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/Boyrun-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="https://www.facebook.com/tr?id=792405807634160&amp;ev=PageView&amp;noscript=1" as="image" data-next-head=""/><script type="application/ld+json" data-next-head="">{"@type":"Organization","@context":"https://schema.org","url":"https://www.meetup.com/find/","name":"Meetup","logo":"https://secure.meetupstatic.com/next/images/general/m_redesign_630x630.png","sameAs":["https://www.facebook.com/meetup/","https://twitter.com/Meetup/","https://www.youtube.com/meetup","https://www.instagram.com/meetup/"]}</script><title data-next-head="">Find Events &amp; Groups | Meetup</title><meta name="description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="fb:app_id" content="2403839689" data-next-head=""/><meta property="og:site_name" content="Meetup" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:title" content="Find Events &amp; Groups | Meetup" data-next-head=""/><meta property="og:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="og:url" content="https://www.meetup.com/find/" data-next-head=""/><meta property="og:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="al:android:app_name" content="Meetup" data-next-head=""/><meta property="al:android:package" content="com.meetup" data-next-head=""/><meta property="al:ios:app_store_id" content="375990038" data-next-head=""/><meta property="al:ios:app_name" content="Meetup" data-next-head=""/><meta property="al:web:should_fallback" content="true" data-next-head=""/><meta property="al:android:url" content="meetup://" data-next-head=""/><meta property="al:ios:url" content="meetup://" data-next-head=""/><meta property="al:web:url" content="https://www.meetup.com/" data-next-head=""/><meta property="twitter:card" content="summary_large_image" data-next-head=""/><meta property="twitter:site" content="@meetup" data-next-head=""/><meta property="twitter:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="twitter:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="twitter:app:id:iphone" content="375990038" data-next-head=""/><meta property="twitter:app:name:iphone" content="Meetup" data-next-head=""/><meta property="twitter:app:id:ipad" content="375990038" data-next-head=""/><meta property="twitter:app:name:ipad" content="Meetup" data-next-head=""/><meta property="twitter:app:id:googleplay" content="com.meetup" data-next-head=""/><meta property="twitter:app:name:googleplay" content="Meetup" data-next-head=""/><meta name="robots" content="noindex, follow" data-next-head=""/><link rel="canonical" href="https://www.meetup.com/find/" data-next-head=""/><link rel="preconnect" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com" data-next-head=""/><link rel="dns-prefetch" href="https://www.googletagmanager.com" data-next-head=""/><script type="application/ld+json" data-next-head="">[{"@context":"https://schema.org","@type":"Event","name":"DevBP #19: Building Faster, Big and Small","url":"https://www.meetup.com/devbp-meetup/events/317427421/","description":"AI is rapidly rewriting the rules of software development—but what actually happens inside engineering organizations once writing code is no longer the primary bottleneck?\n\nJoin us for an evening of candid, practical insights from engineering leaders navigating the shift to AI-native workflows across two very different worlds: high-velocity product development and global, heavily regulated finance.\n\n=== === === ===\n\n**What Happens When Writing Code Is No Longer the Bottleneck?**\n**[Ákos Kapui](https://www.linkedin.com/in/akoskapui/) -** *CTO @ Shapr3D*\n\nSoftware engineering throughput has always been a major constraint on productivity. If AI removes that constraint, everything should become faster, right?\n\nIn theory, yes. In practice, that's not what happens for most organisations. While many see only marginal improvements, some AI-native companies seem to achieve exponential gains. What makes the difference? Why do some organisations become dramatically faster while others struggle to move beyond incremental improvements?\n\n**Moving Fast in a Highly Regulated World**\n**[Krisztián Fekete](https://www.linkedin.com/in/kfekete/) -** *Director of Engineering @ BlackRock*\n\nA look inside software engineering at a large financial institution, and how AI is changing the way teams work. Drawing on experiences at BlackRock, this talk explores the practical realities of adopting AI in a highly regulated environment, where innovation, governance, security, and compliance all need to coexist.\n\n=== === === ===\n\nThis English-language event will be held at the **Shapr3D office**, where we'll provide snacks and drinks to fuel conversations.\n\nArrival is from 17:30, the presentations start at 18:00.\n\nYou can also find the recordings of previous events on the [@DevBPMeetup YouTube channel](https://www.youtube.com/@DevBPMeetup).\n\nAlso join our brand new Discord server for some online discussions [here](https://discord.gg/Tk5sNM2xu)!","startDate":"2026-11-26T16:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Shapr3D HQ","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Akadémia u. 6, 1054 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"DevBP","url":"https://www.meetup.com/devbp-meetup/"},"performer":"DevBP"},{"@context":"https://schema.org","@type":"Event","name":"Budapest ML Meetup #12","url":"https://www.meetup.com/budapest-ml-meetup/events/317410124/","description":"🔻🔸🔻 ***Please fill out the [Registration form](https://www.cognitoforms.com/bic1/MeetupRegistration2026)***[ ](https://www.cognitoforms.com/bic1/MeetupRegistration2026) **to sign up**🔸🔻🔸\n*an additional registration form is required to participate this time*\n\nWe're happy to announce the 12th Budapest ML Meetup!\nJoin the next session in-person to connect with the community and enjoy the presentations.\n\n📆 Date: December 1, 2026 **·** Tuesday **·** 18:00 - 20:00\n📍 Location: Budapest **·** 1134 **·** Váci út 47 E **·** GTC White House Office\n🗣 Language: English\n\n**Talks**\n\n* [Balogh Kitti](https://www.linkedin.com/in/kitti-balogh/), Senior, BlackRock\n*Beyond facts: Preserving narrative in LLM-generated documents*\n* [Arató Bence,](https://www.linkedin.com/in/bencearato/) managing director, BI Consulting\n*AI industry and market trends in 2026*\n\n**Planned Schedule**\n\n* 18:00 Arrival\n* 18:30 Welcome notes and Presentations\n* 19:30 Follow-up discussions\n* 20:00 Closing time\n\n🎉 Catering and the venue are provided by Aladdin Engineering.\n🙋‍♂️ This will be an in-person event with no streaming or recording.\n📸Please let us know on-site if you do not wish to appear in the photos.\n\n**Registration**\nClicking the ‘Attend’ button here is not sufficient to register for this event. To attend, you’ll need to fill out a separate [REGISTRATION FORM](https://www.cognitoforms.com/bic1/meetupregistration2026/). The event is still completely free, and the form only takes a minute to complete. Thanks for your cooperation!","startDate":"2026-12-01T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"GTC White House","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Váci út 47, Budapest"}},"organizer":{"@type":"Organization","name":"Budapest ML Meetup","url":"https://www.meetup.com/budapest-ml-meetup/"},"performer":"Budapest ML Meetup"},{"@context":"https://schema.org","@type":"Event","name":"Agents & Dragons: Once Upon Agentic AI","url":"https://www.meetup.com/aws-serverless-budapest/events/317367738/","description":"⚔️ **Adventurers, your quest awaits!**\nJoin us at SnapSoft HQ in Budapest on **December 10** for **Agents & Dragons: Once Upon Agentic AI**, a hands-on workshop where you’ll build your own **AI Game Master**. It’s an intelligent agent that runs a role-playing adventure, and you’ll build it with **Strands Agents**, the open source SDK from AWS for building AI agents.\nThis is not a sit-back-and-watch session. Everyone codes, and everyone goes home with a working AI Game Master.\n\n🗺️ **What you’ll learn**\n\n* What LLMs and AI agents are, and how agents use tools\n* **MCP (Model Context Protocol):** how agents connect to APIs, databases and third-party tools\n* **A2A (Agent2Agent):** how agents discover each other and work together\n* How to build agents in a few lines of Python with Strands Agents\n\n🐉 **What you’ll build**\nOver several chapters you’ll put together a multi-agent system: a Game Master agent, a custom dice-roll MCP server, a Character agent and a Rules agent backed by a knowledge base. The agents talk to each other over A2A.\n\n🕖 **Agenda**\n\n* 18:00 Registration\n* 18:15 Workshop introduction\n* 18:30 Workshop starts\n* 20:00–20:15 Break\n* 21:00 Workshop ends, then networking with free pizza 🍕 and beer 🍺\n\n🎒 **Before you come**\n\n1. **Bring your own laptop.** A personal machine works best. Corporate firewalls and TLS inspection have blocked the AWS calls the workshop relies on at earlier events.\n2. **Create an AWS Builder Center account** before the event.\n3. **Do not launch an AWS Builder Center sandbox after December 3.** Each account gets one free sandbox workshop per week, and you’ll need yours on the night.\n4. Install **git**, **Python 3.10 or later** and **uv**.\n\nYou don’t need any previous experience with agents. Some Python helps, and a sense of adventure helps even more.\n\n⚠️ **Seats are limited.** If you RSVP and then can’t make it, please update your RSVP so someone on the waitlist can take your place.\nSee you at the table. Roll for initiative! 🎲","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"SnapSoft Kft.","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Focus Point Irodaház, Dohány u. 14, 1074 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"AWS Serverless Budapest","url":"https://www.meetup.com/aws-serverless-budapest/"},"performer":"AWS Serverless Budapest"},{"@context":"https://schema.org","@type":"Event","name":"Data & AI Pub Quiz: Christmas Edition 🎄","url":"https://www.meetup.com/databricks-community-hungary/events/317493586/","description":"Free event, [registration](https://datapao.com/events-webinars/databricks-data-ai-pub-quiz-christmas-edition) is required.\n\nLet’s close 2026 the fun way! No slides and no long talks. Just a pub quiz, good company, and a few festive surprises the day after Santa.\n\nGrab your colleagues (or meet new ones on the night), form a team of 4–5, and battle it out across four rounds:\n\n* **Databricks:** how well do you really know the platform?\n* **Data & AI:** the big moments, famous names and a few Hungarian legends\n* **Christmas trivia:** because it’s December, after all\n* **Picture round:** logos, charts and some surprises\n\nThe questions are a mix of easy and tricky, so you don’t need to be a Databricks expert to win. Curiosity and a good team name go a long way. 😉\nWe’ll also be joined by **some of our friends from Databricks**, so come say hi and chat about what’s coming in 2027.\n\n📅 **AGENDA** (subject to change, times in CET):\n**17:30 – 18:00 \\| Arrival & registration:** Doors open, grab a drink, and find your team. Coming solo? We’ll match you up.\n**18:00 – 18:15 \\| Welcome & a hello from Databricks:** Quiz rules and a short, informal chat with our Databricks guest.\n**18:15 – 18:50 \\| Rounds 1 & 2:** Databricks, then Data & AI\n**18:50 – 19:10 \\| Break:** Refuel with fresh veggie dips (brain food for rounds 3 & 4 🥕) and grab another drink\n**19:10 – 19:45 \\| Rounds 3 & 4:** Christmas trivia, then the picture round\n**19:45 – 19:55 \\| Results & prizes:** Plus a prize for the best team name\n**19:55 – 21:00 \\| Networking & drinks:** Use your drink vouchers, stick around and celebrate the year with the Budapest data community.\n⏰ The quiz starts at **18:00 sharp**, so come at 17:30 to register and find your team.\n\n🎁 **WHAT’S IN IT FOR YOU:**\nA relaxed evening with the people who make this community what it is. You can test your knowledge, pick up a few fun facts, win some prizes, and end the year on a high note.\n\n🍻 **FOOD & DRINKS:**\nEvery participant gets **2 drink vouchers** to toast the end of the year. To keep your mind sharp for the tough questions, we’ll also have **fresh veggie dips**. Light, crunchy and festive, so your brain can do the heavy lifting. 😉\n\n🇬🇧 **LANGUAGE:** English\n\n👛 **EVENT FEE:** Free\n\n✍️ **REGISTRATION:** This event is free, but seats are limited to about 30 people. Registrations will be confirmed based on availability. Register here: https://datapao.com/events-webinars/databricks-data-ai-pub-quiz-christmas-edition\n\n🗺️ **LOCATION:** [Enter Bar](https://enterbar.hu/) (1111 Budapest, Lágymányosi u. 9.)\n\nℹ️ **ABOUT [DATABRICKS COMMUNITY HUNGARY](https://www.linkedin.com/company/datapao):**\nThis group is dedicated to bringing together data enthusiasts, analysts, and engineers interested in learning and sharing knowledge about Databricks and Apache Spark. Whether you are a beginner looking to delve into the world of data & AI or a seasoned professional looking to take your skills to the next level, our meetups offer a platform to connect, collaborate, and learn from each other. Let’s ignite our passion for data together!\n\n🌶️ **ABOUT [DATAPAO](https://datapao.com/):**\nWe’re a data and AI consulting and training company focused exclusively on Databricks, with over 10 years of experience on the platform. We help organizations build production-ready platforms, deliver real data and AI use cases, and train their teams to run Databricks independently.\n\nSee you on the 7th of December. Bring your brightest teammates and your festive spirit!\n\nThe Datapao team","startDate":"2026-12-07T16:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Enter Bar","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Lágymányosi u. 9, 1111 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Databricks Community Hungary","url":"https://www.meetup.com/databricks-community-hungary/"},"performer":"Databricks Community Hungary"},{"@context":"https://schema.org","@type":"Event","name":"ITSM meetup: az IT-szolgáltatásmenedzsment jelene és jövője","url":"https://www.meetup.com/magyar-atlassian-meetup/events/317499504/","description":"**Eseményünkön bemutatjuk, hogy látjuk az ITSM jelenét és mit vizionálunk a jövőre nézve**\n**A jelen:** hogyan kezdtek bele, mire számítottak, és mi lett belőle valójában? Partnerünk, egy IT-szolgáltató, valós ügyféltörténeten keresztül mutatja meg, hogyan alakította át az IT-szolgáltatásmenedzsmentjét.\n**A jövő:** merre tart az ITSM az AI világában? Mi lenne, ha egy ITSM-rendszer nem hónapok alatt, hanem egy rövid igényfelmérés után készülne el? Megmutatjuk, hogyan látjuk, és azt is, min dolgozunk már most.\nUtána pedig van idő arra, amiért igazán megéri személyesen találkozni: beszélgetni.\n\nRészletek és regisztráció: https://www.meta-inf.hu/esemenyek/itsm-meetup-valos-bevezetesek-oszinte-tapasztalatok","startDate":"2026-12-08T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"META-INF Kft","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Irinyi József u. 4-20, 1117 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Magyar Atlassian Meetup","url":"https://www.meetup.com/magyar-atlassian-meetup/"},"performer":"Magyar Atlassian Meetup"},{"@context":"https://schema.org","@type":"Event","name":"Applied AI Budapest","url":"https://www.meetup.com/budapest-artificial-intelligence-meetup/events/317479365/","description":"Join us for the next Applied AI Budapest meetup, where we’ll explore real-world AI applications that work in practice and create value in the business world.\n\n🍕🍺 **Free pizza and beer will be available during the event**, sponsored by EPAM (non-alcoholic beer will be available too for drivers)\"\n\nThroughout the evening, several speakers will share practical examples, real-world experiences, and AI solutions that can help you work more efficiently. There will be breaks between the presentations, giving attendees plenty of opportunities to network, exchange ideas, and discuss the topics with one another.\nThe event will be held in either English or Hungarian, depending on the language preferences of registered attendees.\n\nOur main sponsor, EPAM, is a global leader in AI transformation engineering and integrated consulting. They play an essential role in making this event possible, and we’re delighted to partner with them. Please enjoy the food, drinks, and gift packages, courtesy of EPAM.\n\n**Speaker 1: TBA**\n\n**Speaker 2: TBA**\n\n📅 Date: November 12, 6:00–9:00 PM\n📍 Venue: PUZL CowOrKing, Budapest\n🎟️ Admission: Free, but registration is required\n📧 A valid email address is required to register\nWe will also do our best to accommodate dietary requirements and food intolerances. If you have any allergies, intolerances, or dietary preferences, please mention them when registering so we can plan the appropriate amount of food for everyone.\n\nWe’ll be taking a few photos and short videos during the event to capture the atmosphere and share highlights with our community. If you’d prefer not to appear in any content, just let a member of our team know.\nCome connect, learn, and explore the possibilities of applied AI with us!","startDate":"2027-01-21T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Puzl CowOrKing Budapest","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Lajos u. 126-130, 1036 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Applied AI Budapest","url":"https://www.meetup.com/budapest-artificial-intelligence-meetup/"},"performer":"Applied AI Budapest"},{"@context":"https://schema.org","@type":"Event","name":"AI MÁSKÉPPEN - Vállalati bevezetéstől, FinOpson át a vizuális kultúráig meetup","url":"https://www.meetup.com/it-deepdive-meetups/events/317480921/","description":"Egy meetup, ahol nincs mellébeszélés, mert minket sem az érdekel! Gyere, beszélgessünk közösen, valós példákon keresztül! Meetup-sorozatunk ötödik állomásán az AI kerül terítékre, de ezúttal egy kicsit másképpen.\n\n**IDŐPONT**\n2026.12.02., 17:30-20:00\n\n**HELYSZÍN**\n**MOME Filmstúdió (1121 Budapest, Zugligeti út 9.)**\n\n**Hogyan csatlakozhatsz?**\nLehetőséged van **személyesen** ellátogatni meetupunkra, amit a regisztrációhoz elkülönített aloldalon tudsz megtenni **(a rendezvényen való részvétel regisztráció köteles).**\n***[https://event.telekom.hu/ai-maskeppen/](https://event.telekom.hu/ai-maskeppen/)***\n\nAI-hírekkel és rendezvényekkel már tele a padlás. Ezek vagy az egzisztenciális szorongásunkat erősítik, vagy elsősorban a fejlesztőkhöz szólnak. Pedig a témának számos más, legalább ennyire izgalmas technológiai vonatkozása is van.\n\nKülönösen érdekes kérdés, hogyan lehet az AI-t átgondoltan bevezetni vállalati környezetben. Milyen szempontok alapján választunk modelleket és eszközöket? Mikor érdemes saját infrastruktúrán futtatott, és mikor szolgáltatásként elérhető modelleket használni? Milyen új kihívásokat jelent mindez az IT számára, amely nemcsak használja az AI-t a saját munkájában, hanem a vállalat teljes AI-infrastruktúráját is üzemelteti?\nÉs persze ott vannak a költségek: azok tervezése, menedzselése és folyamatos nyomon követése, vagyis az AI FinOps, amire már a bevezetés kezdetétől érdemes figyelni.\n\nA záró előadásban aztán egy kicsit kilépünk a vállalati világból. Az AI terjedésével ugyanis könnyen tovább erősödhet az angolszász kultúra amúgy sem csekély dominanciája. Megnézzük, mit tehetünk ez ellen, és hogyan jelenhet meg a hazai vizuális kultúra is az AI-modellekben, hogy a digitális térben is tovább élhessen.\n\nA rendezvény végén egy mini kiállítás keretében a részvevők megtekinthetik a MOME és a Telekom közös adatvizualizációs projektje alapján készült vizuális installációkat.\n\n***Figyelem! A meetupunkra külön kell regisztrálni a weboldalunkon, ahol további részleteket is olvashattok az eseményünkről:***\n***[https://event.telekom.hu/ai-maskeppen/](https://event.telekom.hu/ai-maskeppen/)***","startDate":"2026-12-02T16:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Moholy-Nagy Művészeti Egyetem","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Zugligeti út 9, 1121 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"IT Deepdive Meetups","url":"https://www.meetup.com/it-deepdive-meetups/"},"performer":"IT Deepdive Meetups"},{"@context":"https://schema.org","@type":"Event","name":"IBM Bob Coding Watch Party in Wien & Online","url":"https://www.meetup.com/ibmpoweraivienna/events/316255276/","description":"Practitioners - let's get our hands dirty! Join the final event of our hybrid series of hands-on AI dev events in 2026 around IBM Bob, the new **AI**-powered development partner designed to help you ideate, build, modernize and ship better code, faster.\n\n​What makes these events stand out?\n👩‍💻👨‍💻🧑‍💻🪩 Coding Watch Parties in Berlin, Cologne, Frankfurt, Ehningen, Vienna, Zurich and online/remote at the same time.\n\nJoin live sessions together with other creators — not just watching, but discussing, reacting, and learning in real time.\nThink of it as turning a webinar into a shared experience.\n\nThe final AI Coding Watch Party with Bob, with **tracks for beginners, intermediate and experts**, will take place on 1st December.\n\n*The Coding Watch Party is free of charge. Onsite tickets are limited.*\n\n​🥷🧙‍♀️🧝🪄 Hands-on + Community-first\nFrom hackathons to deep dives, these events are built to help you explore modern AI-driven development workflows and connect with peers.\n​\n**Bob is built to support domain users without coding experience as well as R&D + Ops folks** from the ideation stage up to modernization of legacy apps, to secure, fullstack enterprise-ready development. IBM Bob supports the entire SDLC — and these sessions show and guide you how it actually works in best practice.\n\n​If you’re curious about where AI is taking software engineering next, this is a great place to plug in.\n\nDetailed agenda will follow... 🙂","startDate":"2026-12-01T15:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/MixedEventAttendanceMode","location":[{"@type":"VirtualLocation","url":"https://www.meetup.com/ibmpoweraivienna/events/316255276/"},{"@type":"Place","name":"IBM Vienna","address":{"@type":"PostalAddress","addressLocality":"Vienna","addressRegion":"","addressCountry":"at","streetAddress":"Obere Donaustraße 95, Vienna"}}],"organizer":{"@type":"Organization","name":"The Journey to AI (Artificial Intelligence) @ Vienna","url":"https://www.meetup.com/ibmpoweraivienna/"},"performer":"The Journey to AI (Artificial Intelligence) @ Vienna"},{"@context":"https://schema.org","@type":"Event","name":"Bob TV Episode 4: Why generic AI fails at mainframe scale - and what works","url":"https://www.meetup.com/ibm-developer-budapest/events/317470596/","description":"Join us for the fourth episode of Bob TV, the monthly digital event series hosted by Max Jesch, IBM Bob’s outbound product manager. Each month, Max sits down with a technical guest to explore real examples of your trusted AI assistant in action—showing how Bob accelerates enterprise software development across the entire lifecycle.\nFeaturing Special Guest: Ethan Mendel, Development Lead, IBM Z premium package for Bob\nEthan will discuss why mainframe modernization is hard — and why AI alone is not enough.\n\n* The real scope of the challenge: 10-year modernization timelines, skill shortages, and technical debt that runs so deep some clients haven't touched certain programs in decades\n* Why generic AI falls short: LLMs achieve only \\~30% accuracy on non-trivial impact analysis questions for large mainframe applications — hallucination gets worse as scale increases\n* The Premium Package for Z approach: static code analytics + metadata-enriched model intelligence as the foundation, not a replacement for AI but a way to make AI reliable at enterprise scale\n\nBob TV is your monthly window into Bob capabilities:\n\n* AI assisted development workflows\n* Enterprise modernization patterns\n* Agent based software engineering\n\n**Host:**\n**![](https://cache.webcasts.com/content/ibmx001/1771850/content/8605de84345dc42143086f23cfcb2d55984805ea/common/Screenshot20260803at1.28.53PM.png)Maximilian Jesch**, Outbound Product Manager, IBM Bob\n\n![](https://cache.webcasts.com/content/ibmx001/1781965/content/757422b7d448e30f3b8159a77a44b5cfcd8c0f05/common/EthanMendel1.png)**Ethan Mendel**, Development Lead, IBM Z premium package for IBM Bob","startDate":"2026-12-01T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ibm-developer-budapest/events/317470596/"},"organizer":{"@type":"Organization","name":"IBM Developer Hungary","url":"https://www.meetup.com/ibm-developer-budapest/"},"performer":"IBM Developer Hungary"},{"@context":"https://schema.org","@type":"Event","name":"GitHub Copilot - Beyond Basics","url":"https://www.meetup.com/gloster-ai-klub/events/317483207/","description":"**Miről lesz szó?**\nMegmutatjuk, hogyan használjuk a GitHub Copilotot a mindennapi fejlesztés során: az AI-támogatott kódolástól és kódellenőrzéstől egészen a gyakorlati UI-tesztekig az Integrated Browser segítségével.\nBemutatjuk, hogyan dolgozik a Copilot egy futó alkalmazással, milyen szerepe van a harnessnek és az egyedi workspace-beállításoknak, valamint összehasonlítjuk a VS Code-ot a Visual Studióval.\nHasznos, a gyakorlatban bevált tippeket is megosztunk.\nSzó lesz arról is, hol van szükség emberi ellenőrzésre és döntésre.\n\n**Előadók:** Hornyák Dániel + Hriech Richárd 😊\n**Az előadás nyelve**: magyar\n**Dátum és idő:** november 26. 17:00-19:00\n\n**Az eseményen való részvétel előzetes regisztrációhoz kötött, itt tudsz jelentkezni:** [AI Klub feliratkozás 2026. november 26. – Fill out form](https://forms.cloud.microsoft/e/MnPq45w749)\nA helyszínről a regisztrált résztvevőknek emailben küldünk tájékoztatást.","startDate":"2026-11-26T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","address":{"@type":"PostalAddress","addressLocality":"","addressRegion":"","addressCountry":""}},"organizer":{"@type":"Organization","name":"Gloster AI Klub","url":"https://www.meetup.com/gloster-ai-klub/"},"performer":"Gloster AI Klub"},{"@context":"https://schema.org","@type":"Event","name":"Bob TV Episode 4: Why generic AI fails at mainframe scale - and what works","url":"https://www.meetup.com/ibmpoweraivienna/events/317470617/","description":"Join us for the fourth episode of Bob TV, the monthly digital event series hosted by Max Jesch, IBM Bob’s outbound product manager. Each month, Max sits down with a technical guest to explore real examples of your trusted AI assistant in action—showing how Bob accelerates enterprise software development across the entire lifecycle.\nFeaturing Special Guest: Ethan Mendel, Development Lead, IBM Z premium package for Bob\nEthan will discuss why mainframe modernization is hard — and why AI alone is not enough.\n\n* The real scope of the challenge: 10-year modernization timelines, skill shortages, and technical debt that runs so deep some clients haven't touched certain programs in decades\n* Why generic AI falls short: LLMs achieve only \\~30% accuracy on non-trivial impact analysis questions for large mainframe applications — hallucination gets worse as scale increases\n* The Premium Package for Z approach: static code analytics + metadata-enriched model intelligence as the foundation, not a replacement for AI but a way to make AI reliable at enterprise scale\n\nBob TV is your monthly window into Bob capabilities:\n\n* AI assisted development workflows\n* Enterprise modernization patterns\n* Agent based software engineering\n\n**Host:**\n**![](https://cache.webcasts.com/content/ibmx001/1771850/content/8605de84345dc42143086f23cfcb2d55984805ea/common/Screenshot20260803at1.28.53PM.png)Maximilian Jesch**, Outbound Product Manager, IBM Bob\n\n![](https://cache.webcasts.com/content/ibmx001/1781965/content/757422b7d448e30f3b8159a77a44b5cfcd8c0f05/common/EthanMendel1.png)**Ethan Mendel**, Development Lead, IBM Z premium package for IBM Bob","startDate":"2026-12-01T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ibmpoweraivienna/events/317470617/"},"organizer":{"@type":"Organization","name":"The Journey to AI (Artificial Intelligence) @ Vienna","url":"https://www.meetup.com/ibmpoweraivienna/"},"performer":"The Journey to AI (Artificial Intelligence) @ Vienna"},{"@context":"https://schema.org","@type":"Event","name":"Dokumentumkezelés AI-al","url":"https://www.meetup.com/apexbudapest/events/317454264/","description":"**A céges dokumentumokban ott vannak a válaszok. De hogyan találja meg őket az AI, és hogyan biztosítjuk, hogy mindenki csak ahhoz férjen hozzá, amihez jogosultsága van?**\n\nA december 1-jei Oracle APEX meetupon egy dokumentum útját követjük végig: a feltöltéstől és feldolgozástól a keresésen át egy saját adatokra épülő, jogosultságalapú chatig. Rövid prezentációkkal és gyakorlati demókkal mutatjuk be, hogyan kapcsolható össze az **Oracle Database, az APEX és az AI**.\n\nHárom témára koncentrálunk:\n\n* **Dokumentumfeldolgozás Oracle Database-ben és APEX-ben:** hogyan töltsünk fel és tároljunk dokumentumokat, nyerjük ki a tartalmukat, és készítsük elő őket AI-alapú felhasználásra?\n* **Keresés és válaszadás saját dokumentumokból:** mire jó a vektoros keresés és a RAG, és hogyan juthatunk el egy magyarul feltett kérdéstől a forrásokkal alátámasztott válaszig?\n* **Jogosultságalapú AI-chat:** hogyan építsünk olyan asszisztenst, amely figyelembe veszi, hogy a felhasználó mely projektekhez, adatokhoz és dokumentumokhoz férhet hozzá?\n\n**Ugyanaz a kérdés, különböző felhasználók, eltérő hozzáférések.** A demóban azt is megmutatjuk, mit jelent ez a gyakorlatban, és hol kell érvényesíteni a jogosultságokat.\nAz IT-szektor átalakulása kapcsán röviden arról is beszélünk, hogyan változik a fejlesztők szerepe, és miért fontos az adatbázisok, az üzleti folyamatok és az integrációk ismerete az AI-megoldások építésében.\nHa APEX- vagy PL/SQL-fejlesztőként dolgozol, vállalati alkalmazásokat építesz, vagy szeretnéd látni, hogyan használhatod az AI-t a saját dokumentumaiddal, várunk december 1-jén!\n\n**A tervezett program – 2026. december 1., kedd:**\n\n* **18:00–18:10** – Köszöntő\n* **18:10–18:15** – Változó IT, felértékelődő szakértelem\n* **18:15–18:40** – Dokumentumfeldolgozás Oracle Database-ben és APEX-ben – prezentáció és demó\n* **18:40–19:00** – Keresés és válaszadás saját dokumentumokból – prezentáció és demó\n* **19:00–19:25** – Jogosultságalapú AI-chat APEX-ben – prezentáció és demó\n* **19:25–19:30** – Kérdések, zárás, Kahoot\n\n**A rendezvény ingyenes, de regisztrációhoz kötött.** A férőhelyek száma korlátozott, ezért érdemes időben jelentkezni.","startDate":"2026-12-01T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Oracle Hungary Kft","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Balatoni út 2, Budapest"}},"organizer":{"@type":"Organization","name":"Oracle APEX Budapest","url":"https://www.meetup.com/apexbudapest/"},"performer":"Oracle APEX Budapest"},{"@context":"https://schema.org","@type":"Event","name":"Demystifying Intelligent Model Routing: What Works…and What Doesn’t","url":"https://www.meetup.com/kong-vienna/events/317554188/","description":"Multi-model architectures are becoming the default, and intelligent routing is often pitched as the layer that makes them simple and more cost effective. The reality is much more complicated.\nIn this session, Kong experts share where model routing is heading and which ideas don’t hold up in production. We’ll explore different routing philosophies and which philosophies work best for coding harness, chatbot, and other agentic use cases.\n**What you’ll learn:**\n\n* Why routing logic belongs in the infrastructure layer as you adopt more models and providers\n* Why most routing claims in the market are questionable at best\n* Where and when to use certain routing strategies to improve cost efficiency, quality, security, and resilience","startDate":"2026-12-03T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/kong-vienna/events/317554188/"},"organizer":{"@type":"Organization","name":"Kong/VIENNA","url":"https://www.meetup.com/kong-vienna/"},"performer":"Kong/VIENNA"},{"@context":"https://schema.org","@type":"Event","name":"Tokenization was the Beginning. Agentic Capital Markets is the endgame","url":"https://www.meetup.com/lfdt-hungary/events/317457067/","description":"Join us for a webinar with Brickken, an LFDT general member, on building Agentic Capital Markets. Tokenization has made financial assets programmable. What comes next when AI agents can help discover opportunities and coordinate activity within defined mandates? Edwin Mata, Brickken's CEO & Co-Founder, will discuss the permissions, legal enforceability and operational controls needed to make Agentic Capital Markets work for institutions.\n\nThe webinar will take place on Wednesday, **December 2** at **7AM PST/10AM EST/16:00 CET/08:30 PM IST**\n\nPlease register here: https://zoom.us/webinar/register/8716754539090/WN_2WwuUCLLSZao28Vv-TiPnw\n\nWe hope to see you there!","startDate":"2026-12-02T15:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317457067/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"Unity 3D × Stay HUNGRY x Devin Community Meetup : AI assisted development","url":"https://www.meetup.com/unity-3d-budapest/events/317564419/","description":"*Register on Luma too to be able to enter!*\nhttps://luma.com/o7hssy8k\n\nFor our December meetup we're teaming up with **Unity 3D** and **Stay HUNGRY ([StayHungry.vc](https://stayhungry.vc/?utm_source=luma)).** for a festive evening of game building. In one night you'll go from idea to a playable game, with **Devin** writing code alongside you and **Unity** powering the game. Then take it home and play it with family\nand friends over the holidays, or keep it for yourself as a solo challenge.\n​**How it works**\n​- Come solo or bring your crew. Build alone or team up on the night.\n\\- We kick off with a quick live demo: building a small game with Devin \\+ Unity from scratch\\.\n\\- Pick a holiday idea \\(party games for the family table\\, co\\-op couch games\\, cozy solo\npuzzlers, snowball fights...) or bring your own.\n\\- Build for a couple of hours with Devin and Unity\\, with mentors from both teams on hand\\.\n​No game dev experience required. If you've never opened Unity or used an AI coding agent,\nthis is a friendly place to start. Engineers, designers, PMs, students, parents: all welcome.\n​**Co-hosted with Unity 3D & Stay HUNGRY.**\n​**Unity 3D** is the engine behind a huge share of the world's games, from indie hits to mobile\nfavorites. The Unity team will be there to help you get your game running and share tips.\n​**Stay HUNGRY.** is Hungary's home for builders: an open community where entrepreneurs help\nentrepreneurs, from your first spark of curiosity to scaling a startup through their\naccelerator. If tonight's game gives you the building bug, they're the people to talk to.\n​**Agenda**\n​- 18:30 — Doors open, festive drinks & snacks\n\\- 18:45 — Welcome from Devin\\, Unity & Stay HUNGRY\\.\n\\- 19:00 — Live demo: building a holiday game with Devin \\+ Unity\n\\- 19:15 — Build time \\(solo or teams\\)\n\\- 21:45 — Holiday drinks & networking\n\\- 22:00 — Wrap\n​**What to bring**\n​- 💻 A laptop and charger\n\\- 🛠 Devin \\+ Unity Hub \\+ Unity Editor installed beforehand if you can \\(it's a big download\\, and\nvenue Wi-Fi will thank you)\n\\- 🎁 A game idea\\, or just your holiday spirit\n​**Details**\n​- 📅 Tuesday 8 December 2026\n\\- 🕕 18:30–22:00\n\\- 📍 Puzl CowOrKing Budapest\\, Lajos utca 126–130\\, 1036 Budapest\n\\- 🍪 Festive drinks & snacks provided\n\\- 🎟 Free\\, but spots are limited\\. RSVP required","startDate":"2026-12-08T17:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Puzl CowOrKing Budapest","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Lajos u. 126-130, 1036 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Unity 3D Budapest","url":"https://www.meetup.com/unity-3d-budapest/"},"performer":"Unity 3D Budapest"},{"@context":"https://schema.org","@type":"Event","name":"AWS X-Mas Meetup '26","url":"https://www.meetup.com/aws-user-group-hungary/events/317591108/","description":"🇬🇧 English version below 👇\n\n***\n\n🎄✨ Újra itt az év legünnepibb hazai AWS eseménye: a már hagyományossá vált X-Mas Meetupunk! ✨🎄\n\nHogyan lehet megfigyelhetővé tenni a rövid életű, nehezen debugolható Lambda függvényeket, napi 75 millió hívás mellett? És mi minden történt idén az AWS közösségben, a re:Cap-től a re:Inventig?\n\nÉvzáró esténken egy gyakorlati observability előadással kezdünk, aztán a szokásos ünnepi kerekasztalon visszatekintünk a tartalmas évre, és végigmegyünk a legfontosabb re:Invent bejelentéseken. A végére egy meglepetéssel is készülünk! 🎁\n\nZárd velünk az évet, beszélgessünk az AWS-ről, és hangolódjunk rá együtt a karácsonyra, tech stílusban! ☁️🤝\n\n***\n\n🗓️ **Program**\n\n**17:00 – Kapunyitás**\n\n**17:20 – OpenTelemetry Observability for AWS Lambda** (angolul)\n**Hegedűs Ádám** – Engineering Manager, Infrastructure @ Zocks\n\nA Lambda függvények rövid életűek, ezért nehéz őket debugolni. A platform ugyan egyre nyitottabb, de az üzemeltetőknek még mindig kevés lehetőségük van az observability kiépítésére: vagy minden egyes híváskor fix többletköltséget fizetnek, vagy maguknak kell kezelniük a különálló layerek életciklusát.\nAz előadásból kiderül, hogyan monitorozunk napi 75 millió Lambda-hívást OpenTelemetry segítségével. Megtartjuk a teljes rugalmasságot, a nyílt forráskódú ökoszisztémára építünk, és a saját fejlesztéseink egy részét vissza is adjuk a közösségnek.\n\n* 🔍 Miért nehéz a Lambda observability, és milyen kompromisszumokkal jár?\n* 📡 Hogyan épül fel egy OpenTelemetry-alapú megoldás nagy léptékben?\n* 🌱 Hogyan lehet a nyílt forráskódú ökoszisztémára építeni, és visszaadni a közösségnek?\n\n**18:00 – 🎤 Ünnepi kerekasztal: A 2026-os év az AWS közösségben**\nModerátor: **Nagy Olivér** – Head of DevOps & Infrastructure @ ShiwaForce\nRésztvevők:\n**Fodor-Horváth Júlia** – Principal Software Engineer @ Bitrise, AWS User Group Budapest Leader\n**Balassy Mihály** – Principal Cloud Architect @ LaniSys, AWS User Group Budapest Leader, AWS Community Builder\n\nAz X-Mas meetup hagyományaihoz híven átbeszéljük az év legfontosabb közösségi eseményeit: a re:Cap-et, az AWS Community Day CEE-t és az AWS User Group Leaders Summitot. Utána rátérünk az idei re:Invent legizgalmasabb bejelentéseire, és arra, mit jelentenek ezek a mindennapi munkánkban. Végül pedig jön egy meglepetés… 🎁\n\n**🎅 X-Mas Networking és ünnepi harapnivaló**\nLesz a szokásos szaloncukor 🍬, sör 🍺 és pizza 🍕!\nKérdezz az előadóktól, oszd meg a tapasztalataidat, és építs új szakmai kapcsolatokat az AWS közösségben.\n\n🌐 **Nyelvi megjegyzés:** Az előadás angol nyelven hangzik el. Kérdezni magyarul és angolul is lehet.\n\nVárunk szeretettel! 🎄☁️🤝\n\n***\n\n🇬🇧 **ENGLISH**\n\n🎄✨ The most festive AWS meetup of the year is here: our traditional AWS User Group Budapest X-Mas Meetup! ✨🎄\n\nHow do you make short-lived, hard-to-debug Lambda functions observable at 75 million invocations a day? And what happened in the AWS community this year, from re:Cap all the way to re:Invent?\n\nWe'll open the evening with a hands-on observability talk. Then comes our traditional holiday roundtable, where we look back on the year and go through the biggest re:Invent announcements. And we've got a surprise for you at the end! 🎁\n\nJoin us to close out the year, talk AWS, and get into the holiday spirit, tech style! ☁️🤝\n\n***\n\n🗓️ **Agenda**\n\n**17:00 – Doors open**\n\n**17:20 – OpenTelemetry Observability for AWS Lambda**\nAdam Hegedus – Engineering Manager, Infrastructure @ Zocks\n\nLambda functions are short-lived and hard to debug. The platform has grown more open, but operators still have few ways to add observability. They either pay a fixed cost on every invocation or manage the lifecycle of decoupled layers themselves. See how we monitor 75M daily Lambda invocations with OpenTelemetry. We keep full flexibility, build on the open-source ecosystem, and share some of our own contributions back.\n\n**18:00 – 🎤 Holiday Roundtable: The Year 2026 in the AWS Community**\nModerated by **Oliver Nagy** – Head of DevOps & Infrastructure @ ShiwaForce\nPanelists:\n**Julia Fodor-Horvath** – Principal Software Engineer @ Bitrise, AWS User Group Budapest Leader\n**Mihaly Balassy** – Principal Cloud Architect @ LaniSys, AWS User Group Budapest Leader, AWS Community Builder\n\nAs our X-Mas tradition, we'll look back on the year's highlights: re:Cap, AWS Community Day CEE and the AWS User Group Leaders Summit. Then we'll dive into the most exciting re:Invent announcements and what they mean for our everyday work. And finally… a surprise! 🎁\n\n**🎅 X-Mas Networking & Holiday Treats**\nThe usual szaloncukor 🍬 (traditional Hungarian Christmas candy), beer 🍺 and pizza 🍕 are on us!\n\n🌐 **Language note:** The talk will be delivered in English. Questions are welcome in English or Hungarian.\n\nWe look forward to seeing you! 🎄☁️🤝","startDate":"2026-12-08T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Shiwaforce","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Mosaic Office, Alkotás u. 17-19-7. emelet, 1123 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"AWS User Group Budapest","url":"https://www.meetup.com/aws-user-group-hungary/"},"performer":"AWS User Group Budapest"},{"@context":"https://schema.org","@type":"Event","name":"Introducing ThunderID: Open Source Identity for Humans, AI Agents, and Machines","url":"https://www.meetup.com/lfdt-hungary/events/317272395/","description":"ThunderID ([https://github.com/thunder-id](https://github.com/thunder-id)) is an open source identity and access management project, hosted by LF Decentralized Trust as an incubation project. It is built from scratch in Go and treats humans, AI agents, and machines as first-class identities.\n\nIn this meetup, we will introduce the motivation behind ThunderID, including why it was built from scratch rather than extending existing IAM stacks. We will look at the challenges IAM now has to solve and how much the operational and environmental complexity of identity has changed. The session will introduce ThunderID’s key features and its four foundational pillars:\n\n⚡ Native agent identity\n⚡ Post-quantum safe by design\n⚡ Integration with decentralized identity infrastructure\n⚡ A high-performance, lightweight runtime with GitOps support\n\nThe session closes with practical demos showing how ThunderID addresses these problems.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-10T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317272395/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"Open philosophy session - Tonight you bring the topic!","url":"https://www.meetup.com/budapest-philosophy/events/317520852/","description":"Tonight, everybody is encouraged to bring one or more questions, ideas, dilemmas, or topics they would like to discuss. We will vote to decide the order of the topics to discuss.\nSome example questions:\n- Can freedom exist without responsibility?\n- Is technology making us wiser?\n- What makes a good life?\n- Is suffering necessary for growth?\n- Can morality exist without religion?\n- How much should we rely on science vs other sources - including our own intuition?\n- How would immortality change our attitude towards things in life?\n- What does personal freedom really mean?\n- Do people actually want democracy or is it just an acceptable consensus?\n\nThe goal is not to win an argument or reach consensus, but to think, challenge assumptions, and encounter perspectives different from our own.\n- Bring a question! We'll take care of the rest.\n\n**Free event. We'll start at 18:00 so make sure you arrive in time!**","startDate":"2026-11-26T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Művház Kávézó","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Bartók Béla út 33, 1114 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Budapest Philosophy Group","url":"https://www.meetup.com/budapest-philosophy/"},"performer":"Budapest Philosophy Group"},{"@context":"https://schema.org","@type":"Event","name":"ZK Learning Group: Wrap-up 2026, ZK order book matching","url":"https://www.meetup.com/lfdt-hungary/events/317237690/","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: https://discord.com/channels/905194001349627914/1329201532628898036\nGithub repo for the lab:\nhttps://github.com/LF-Decentralized-Trust-labs/zk-learning-group\nIn this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317237690/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"}]</script><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/8/c/2/highres_537130434.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/e/6/a/c/highres_537119052.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/3/8/c/c/highres_537074540.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/6/0/c/4/highres_537204772.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/7/4/4/1/highres_537209761.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/a/a/a/highres_537235978.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/3/a/7/2/highres_537194962.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/7/0/2/3/highres_535228707.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/8/3/0/highres_537186192.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/7/3/b/8/highres_537269624.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/8/4/4/highres_537186212.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/c/b/d/1/highres_537172177.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/8/7/c/d/highres_537274765.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/1/1/e/highres_537173534.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/b/0/8/a/highres_537285194.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/0/8/3/highres_537308323.jpeg" as="image" data-next-head=""/><meta name="next_csrf" content="bec0cc37-285e-484f-9d18-a