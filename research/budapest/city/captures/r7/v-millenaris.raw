			<div data-elementor-type="wp-page" data-elementor-id="28510" class="elementor elementor-28510" data-elementor-post-type="page">
				<div class="elementor-element elementor-element-2c065bc e-flex e-con-boxed wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no wpr-column-slider-no wpr-equal-height-no e-con e-parent" data-id="2c065bc" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
