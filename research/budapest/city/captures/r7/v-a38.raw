			/>
		</div>
	</div>
	<span class="message text-[#ffef00] text-12 mt-2 leading-none" data-validate-for="venues-form-email"></span>
	</div>                            <div
	class=" input-container form-row form-row--required form-row--error form-row--venues-form-phone"
>
	<div class="flex flex-row items-center shadow-input-normal">
		<label
			for="venues-form-phone"			class="font-extrabold text-16 lg:text-20"
		>
			Email
					</label>

		<div class="form-row-control flex-1 flex">
			<input
								type="tel"
									id="venues-form-phone"
													name="venues-form-phone"
