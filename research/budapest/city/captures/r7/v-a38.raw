			/>
		</div>
	</div>
	<span class="message text-[#ffef00] text-12 mt-2 leading-none" data-validate-for="venues-form-name"></span>
	</div>                            <div
	class=" input-container form-row form-row--required form-row--error form-row--venues-form-email"
>
	<div class="flex flex-row items-center shadow-input-normal">
		<label
			for="venues-form-email"			class="font-extrabold text-16 lg:text-20"
		>
			Email
					</label>

		<div class="form-row-control flex-1 flex">
			<input
								type="text"
									id="venues-form-email"
													name="venues-form-email"
