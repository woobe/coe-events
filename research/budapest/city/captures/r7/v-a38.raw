                                <div class="vrd-layout-btn">
                                    <svg class="" viewBox="0 0 25 25" xmlns="http://www.w3.org/2000/svg">
    <path d="M18.0781 24.5H0.5V0.5H24.5V24.5H21.6406V23.0938H23.0938V15.4062H16.7422L16.6719 15.4766V20.2344H15.2656V14.0703L15.3359 14H23.0938V1.90625H15.2188V9.96875H19.9531V11.3047L19.8828 11.375H7.57812V9.96875H13.7422L13.8125 9.89844V1.90625H1.90625V9.96875H3.96875V11.375H1.90625V14H3.96875V15.4062H1.90625V23.0938H9.6875V15.4062H7.57812V14H12.2188V15.4062H11.0938V23.0938H18.0781V24.5Z" fill="currentColor" stroke="currentColor"/>
