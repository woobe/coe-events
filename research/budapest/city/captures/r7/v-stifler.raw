<script nowprocket type="text/javascript">
// Function to hash data using SHA-256
async function hashPII(data) {
    const encoder = new TextEncoder();
    const dataEncoded = encoder.encode(data);
    const hashBuffer = await crypto.subtle.digest('SHA-256', dataEncoded);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    return hashHex;
}

// Function to clean email addresses
function cleanEmail(email) {
    const emailLower = email.toLowerCase();
    const [localPart, domain] = emailLower.split('@');
    if (domain === 'gmail.com' || domain === 'googlemail.com') {
        const cleanLocalPart = localPart.replace(/\./g, '');
        return cleanLocalPart + '@' + domain;
    }
    return emailLower;
}

// Function to sanitize phone number
function sanitizePhone(phone) {
    return phone.replace(/\+/g, '');
}

// Function to validate phone number in E.164 format
function isValidPhoneNumber(phone) {
    return /^\+[1-9]\d{1,14}$/.test(phone);
}

jQuery(document).ready(function($) {
    $(document).on('submit', '.elementor-form', async function(event) {
        const $form = $(this);
        const formData = new FormData(this);
        const phone = formData.get('form_fields[tel]').trim();

        // Validate phone number
        if (!isValidPhoneNumber(phone)) {
            // Let the form run its own validation
            return;
        }

        event.preventDefault(); // Prevent the form from submitting immediately

        const firstName = formData.get('form_fields[firstname]').trim().toLowerCase();
        const lastName = formData.get('form_fields[lastname]').trim().toLowerCase();
        const cleanemail = cleanEmail(formData.get('form_fields[email]').trim());
        const email = formData.get('form_fields[email]').trim();
        const fbphone = sanitizePhone(phone);
        const formId = this.id;

        const hashedFirstName = await hashPII(firstName);
        const hashedLastName = await hashPII(lastName);
        const hashedEmail = await hashPII(cleanemail);
        const hashedPhone = await hashPII(phone);

        // Push to dataLayer
        window.dataLayer = window.dataLayer || [];
        dataLayer.push({
            'event': 'enhanced_form_submission',
            'firstname': firstName,
            'lastname': lastName,
            'email': email,
            'phone': phone,
            'fbphone': fbphone,
            'hashedFirstName': hashedFirstName,
            'hashedLastName': hashedLastName,
            'hashedEmail': hashedEmail,
            'hashedPhone': hashedPhone,
            'formid': formId
        });

        // Submit the form using AJAX to control the process and prevent double submission
        $.ajax({
            type: 'POST', // Form method
            url: this.action, // Form action URL
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                console.log('Form submitted successfully');
            },
            error: function(xhr, status, error) {
                console.error('Submission failed: ' + error);
            }
        });
    });
});
</script>

<script type="text/javascript" nowprocket>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('input[type="tel"]').forEach(function(input) {
        input.removeAttribute('pattern');
    });
});
</script>
