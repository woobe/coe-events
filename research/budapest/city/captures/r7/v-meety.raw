<script>
    var wto;
    var wto2;
    var oldValue = "";
    $(".search-input").keyup(function () {
        var val = $(this).val();
        clearTimeout(wto);

        if(val.length > 2) {
            if (val != oldValue) {
                var $input = $(this);
                wto = setTimeout(function () {
                    oldValue = val;
                    search.doSearch($input.val());
                    $(".search-block-result").show();
                }, 500);
            }
        } else {
            $(".search-block-result").hide();
        }


    });
    $(".search-block-result").mouseleave(function () {
        clearTimeout(wto2);
        var $sr = $(this);
        wto2 = setTimeout(function () {
            $sr.hide();
        }, 500);
    }).mouseenter(function () {
        clearTimeout(wto2);
    });

    $(function () {
        $('.headerbutton').popover({
            html: true,
            placement: 'bottom'
        })
    })

    $(function() {
        $("[data-toggle='true']").on('click', function() {
            $(".collapse-table").slideToggle();
        });
    })
