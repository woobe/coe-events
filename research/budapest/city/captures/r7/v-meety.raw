<!--Naptárhoz tartozó js-->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        calendarRender();
    });

    function calendarRender() {
        var calendarEl = document.getElementById('calendar');

        calendar = new FullCalendar.Calendar(calendarEl, {

            //MEGJELENÉS
            //themeSystem: 'bootstrap', //bootstrap-es témához kell alapból nem volt benne
            locale: 'hu', //magyar nyelv
            headerToolbar: {
                right: 'prev,prevMonth,today,nextMonth,next',
                left: 'title',
                center: 'timeGridWeek,timeGridDay', //csak heti nézet legyen, ezért az összes gombot kivettem: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
            },
            navLinks: false, // can click day/week names to navigate views
            allDaySlot: false, //ne legyen egésznapos eseményeknek hely az órára bontott lista felett
            initialView: 'timeGridWeek', //a heti nézet legyen az alapértelmezett,desktopra:timeGridWeek mobilra: timeGridDay
            dayHeaderFormat: { weekday: 'short', month: '2-digit', day: '2-digit', omitCommas: true },
            slotDuration: '00:30:00', //harminc perces osztás legyen
            slotLabelInterval: '00:30:00', //harminc perces osztás legyen és mindegyik megjelenjen ne csak minden második
            slotLabelFormat: { hour: '2-digit', minute: '2-digit', omitZeroMinute: false, meridiem: 'short'},
            firstDay: 1, //hétfővel indul a hét
            contentHeight: 'auto',
            selectLongPressDelay:500, //mobile

            initialDate: '2026-11-26', //az aktuális naplegyen kijelölve '2020-09-12' BACKEND
            validRange: { //ne engedjen elmúlt időpoontra visszamenni, nem kezeli az aznapi elmúlt órákat sajnos
                start: '2026-11-26', //az aktuális hét hétfőjétől látható a naptár BACKEND
                end: '2027-11-26' //előrefelé 1 évig, ezt majd le kell velük egyeztetni mennyi legyen !!!!!!!!!!!
            },
            slotMinTime: '08:00', //ide a legkorábbi nyitási időpontot kell rakni az összes nap közül BACKEND
            slotMaxTime: '20:00', //ide a legkésőbbi zárási időpontot kell rakni az összes nap közül BACKEND
            businessHours: [{"daysOfWeek":[1],"startTime":"08:00","endTime":"20:00"},{"daysOfWeek":[2],"startTime":"08:00","endTime":"20:00"},{"daysOfWeek":[3],"startTime":"08:00","endTime":"20:00"},{"daysOfWeek":[4],"startTime":"08:00","endTime":"20:00"},{"daysOfWeek":[5],"startTime":"08:00","endTime":"20:00"},{"daysOfWeek":[6],"startTime":"08:00","endTime":"20:00"},{"daysOfWeek":[0],"startTime":"08:00","endTime":"20:00"}],
            events: "/getReservationEvents/238",

            //IDŐPONT KIVÁLASZTÁS
            editable: false,
            selectable: true,
            selectConstraint: 'businessHours', //csak nyitvatartási időből választhat időpontot,a többi alapból le van tiltva
            selectOverlap: false, //nem választhat időpontot, ahol már van foglalás
            selectMirror: true, //a kiválasztáskor mutasson rögtön egy esemény dobozt
            unselectAuto: false,
            eventColor: '#BC2CDB',

            select: function(info) {
                calendar.refetchEvents();
                $("#startTime").val("");
                $("#endTime").val("");
                //$('html,body').animate({scrollTop: $("html").offset().top}, 'slow');
                var myDate = new Date(info.start);
                var myDate2 = new Date(info.endStr);
                var kulonbozett = diff_hours(myDate, myDate2);

                if(kulonbozett < 2) {
                    $('#basketPopup').modal('show');
                    if ($(window).width() < 800) {
                        $('#basketPopup').css({
                            position: 'absolute'
                        });
                        $('html,body').animate({scrollTop: $('.calendarBorder').offset().top-150}, 'slow');
                    }
                    $('#meeting_room_error').show();
                    $('#meeting_room_error_text').html("MINIMUM IDŐ: 2 óra").show();
                    $('#calerbutton').show();
                    $('#meeting_room_successful').hide();
                    $('#meeting_room_successful_text').hide();
                    $('#calsusbutton').hide();
                } else {
                    $("#startTime").val(moment(myDate).format('YYYY.MM.DD HH:mm'));
                    $("#endTime").val(moment(myDate2).format('YYYY.MM.DD HH:mm'));

                    $('#basketPopup').modal('show');
                    if ($(window).width() < 800) {
                        $('#basketPopup').css({
                            position: 'absolute'
                        });
                        $('html,body').animate({scrollTop: $('.calendarBorder').offset().top-150}, 'slow');
                    }
                    $('#meeting_room_error').hide();
                    $('#meeting_room_error_text').hide();
                    $('#calerbutton').hide();
                    $('#meeting_room_successful').show();
                    $('#meeting_room_successful_text').show();
                    $('#calsusbutton').show();
                }
                $('.total-container').show();
                $('#response').hide();
                $('#meeting_room_popup').hide();
                $('#calpopbutton').hide();
                meetingroom.updatePrice();
            },
            eventClick: function () {
                calendar.refetchEvents();
            }
        });
        calendar.render();

        $(document).on('click', '.fc-button', function(e) {
            $('.fc-theme-bootstrap').addClass('row');
            $('.fc-toolbar').addClass('col-lg-12');
        });
        if ($(window).width() < 769) {
            $(".fc-timeGridDay-button").click();
        } else {
            $(".fc-timeGridWeek-button").click();
        }

        calendar.updateSize();
    }

    setInterval(function(){
        calendar.refetchEvents();
    }, 30000);

    function diff_hours(dt2, dt1) {
        var diff =(dt2.getTime() - dt1.getTime()) / 1000;
        diff /= (60 * 60);
        return Math.abs(diff);
    }

    $('#startTime, #endTime').click(function() {
        $('#tab-calendar').click();
        if ($(window).width() < 800) {
            $('#basketPopup').css({
                position: 'absolute'
            });
            setTimeout(function () {
                $('html,body').animate({ scrollTop: $(".calendarBorder").offset().top-150}, 'slow');
                $('#basketPopup').modal('show');
            }, 200);
        }else{
            $('html,body').animate({ scrollTop: $(".calendarBorder").offset().top-150}, 'slow');
            $('#basketPopup').modal('show');
        }

        $('#meeting_room_popup').show();
        $('#calpopbutton').show();
        $('#meeting_room_successful').hide();
        $('#calsusbutton').hide();
        $('#meeting_room_error').hide();
        $('#calerbutton').hide();
        /*setTimeout(function () {
            $('html,body').animate({scrollTop: $('.calendarBorder').offset().top-200}, 'slow');
        }, 500);*/
        // var naptarm=$('.fc-timeGridWeek-view').height();
        // $('.fc-view-harness').height(naptarm);
    });
    $('#tab-calendar').click(function () {
        $('#basketPopup').css({
            position: 'absolute'
        });
        setTimeout(function () {
            $('html,body').animate({ scrollTop: $(".calendarBorder").offset().top-150}, 'slow');
            $('#basketPopup').modal('show');
        }, 200);
        setTimeout(function () {
            calendar.refetchEvents();
        }, 500);
    });
</script>            </div>

        
