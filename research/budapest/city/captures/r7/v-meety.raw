    function calerbutton(){
        $('#basketPopup').modal('hide');
        if ($(window).width() < 800) {
            $('html,body').animate({scrollTop: $('.calendarBorder').offset().top-150}, 'slow');
        }
    }
    function calsusbutton() {
        $('#basketPopup').modal('hide');
        $('html,body').animate({ scrollTop: $("#meety-foglalo").offset().top}, 'slow');
    }
    function caltovabbbutton() {
        $('#basketPopup').modal('hide');
        $('html,body').animate({ scrollTop: $(".calendarBorder").offset().top-150}, 'slow');
    }
</script>                        <div id='calendar'></div>
