  <section class="conference-history" aria-labelledby="conference-history-title">
    <div class="history-heading">
      <p class="eyebrow">Our history</p>
      <h3 id="conference-history-title">A conversation<br>that keeps moving.</h3>
    </div>
    <ol class="history-timeline">
      <li>
        <p class="history-year"><time datetime="2015">2015</time></p>
        <p class="history-description">The event began in 2015 as the Budapest Smart Ticketing &amp; Digital Services Forum, bringing transport and technology professionals from across Europe to Budapest.</p>
      </li>
      <li>
        <p class="history-year"><time datetime="2026">2026</time></p>
        <p class="history-description">In 2026, it became The Budapest Exchange. The name changed; the focus on practical experience and time to talk stayed.</p>
      </li>
      <li class="history-next">
        <p class="history-year"><time datetime="2027">2027</time></p>
        <p class="history-description">The next edition. New questions, familiar faces and more connections to make.</p>
        <p class="history-date">13–14 October 2027</p>
        <a href="#join" class="inline-link">See you in 2027</a>
      </li>
    </ol>
  </section>
</div></section>

