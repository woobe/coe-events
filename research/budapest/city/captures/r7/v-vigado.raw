nt\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Panorama Corridor, located on the 2nd floor, can be rented as a complementary event space, for example for hosting standing receptions.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1}],\"direction\":null,\"textFormat\":1}}}]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-01-29T10:11:32.782Z\",\"createdAt\":\"2025-11-17T12:52:05.426Z\"},{\"id\":11,\"name\":\"Exhibitional Hall - 5th floor\",\"floor\":\"5. Floor\",\"coverImage\":{\"id\":55,\"alt\":\"V.emelet_kiallitoterem\",\"prefix\":\"media\",\"folder\":\"$6:props:rooms:0:coverImage:folder\",\"updatedAt\":\"2025-11-17T10:46:41.887Z\",\"createdAt\":\"2025-11-17T10:46:41.887Z\",\"url\":\"/api/media/file/V.emelet_kiallitoterem.jpg\",\"thumbnailURL\":null,\"filename\":\"V.emelet_kiallitoterem.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":3205194,\"width\":3648,\"height\":2432,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[{\"id\":\"691b226a6c6a9b7fb4531401\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The exhibition hall of the \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Vigadó Gallery\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\", located on the 5th floor, was created through the development of the former attic space in 2014.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The 360 m² exhibition space has no windows, therefore no natural light enters the room. Exhibition lighting is provided by specialized, adjustable lighting fixtures. The gallery can be accessed via the northern and southern panoramic elevators.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[{\"id\":\"691afcd42c07e0592c58f25a\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"In the 21st century, the Pesti Vigadó has been enriched with new spaces through the conversion of the former attic and, in part, by reducing the ceiling height of the Ceremonial Hall, resulting in the creation of the 5th and 6th floors. The 5th-floor exhibition hall provides a venue for contemporary fine and applied arts, as well as photography exhibitions, across more than 350 m².\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"updatedAt\":\"2026-01-29T10:12:51.798Z\",\"createdAt\":\"2025-11-17T10:47:02.097Z\"},{\"id\":10,\"name\":\"Southern Hall\",\"floor\":\"2. Floor\",\"coverImage\":{\"id\":54,\"alt\":\"Deli_terem\",\"prefix\":\"media\",\"folder\":\"$6:props:rooms:0:coverImage:folder\",\"updatedAt\":\"2025-11-17T10:43:23.179Z\",\"createdAt\":\"2025-11-17T10:43:23.179Z\",\"url\":\"/api/media/file/Deli_terem.jpg\",\"thumbnailURL\":null,\"filename\":\"Deli_terem.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":328923,\"width\":1500,\"height\":1000,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[{\"id\":\"691b19f1a980fa9a522e7adb\",\"blockName\":\"Déli terem - leírás\",\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Southern Hall, located on the 2nd floor of the Pesti Vigadó, provides an excellent venue for smaller concerts, cultural events, conferences, standing and seated receptions, and gala dinners.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"It is also recommended as a complementary space to the Ceremonial Hall for standing and seated dinner events. The various layout options of the Southern Hall can be viewed in the gallery below.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Capacity of the Southern Hall:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Theatre-style seating: 190 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Standing reception: 200 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Seated buffet-style or plated dinner: 130 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null,\"textFormat\":1}}}]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[{\"id\":\"691afc142c07e0592c58f259\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Southern Hall\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" was a historic site of the birth of Budapest, where in 1873 the unification of the three cities—Buda, Pest, and Óbuda—was decided. The inaugural meeting of the new municipal assembly was held here, during which \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Károly Ráth\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" was elected as the first Mayor of the capital.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Since then, \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"November 17\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" has been celebrated as the official birthday of \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Budapest\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\". On this ceremonial occasion, \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Ferenc Liszt\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"’s oratorio \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Christus\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" was performed. On the 50th anniversary in 1923, \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Zoltán Kodály\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"’s \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Psalmus Hungaricus\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" was premiered under the direction of \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Ernő Dohnányi\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\".\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"updatedAt\":\"2026-01-29T10:14:56.468Z\",\"createdAt\":\"2025-11-17T10:44:35.585Z\"},{\"id\":5,\"name\":\"Vigadó Gallery - Ground Floor\",\"floor\":\"Ground Floor\",\"coverImage\":{\"id\":51,\"alt\":\"Vigado_Galeria_foldszint\",\"prefix\":\"media\",\"folder\":\"$6:props:rooms:0:coverImage:folder\",\"updatedAt\":\"2025-11-17T10:26:23.437Z\",\"createdAt\":\"2025-11-17T10:26:23.437Z\",\"url\":\"/api/media/file/Vigado_Galeria_foldszint.jpg\",\"thumbnailURL\":null,\"filename\":\"Vigado_Galeria_foldszint.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":277981,\"width\":1500,\"height\":1000,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":80,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[{\"id\":\"691b22366c6a9b7fb4531400\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The ground-floor exhibition space of the Pesti Vigadó is the original home of the Vigadó Gallery.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"When the building reopened in 1980, it became home to the Vigadó Gallery, a venue dedicated to exhibiting contemporary Hungarian art. During the most recent renovation, the space was redesigned—restoring its original beauty—and now has a total floor area of 227 m².\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[{\"id\":\"691af8552c07e0592c58f254\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The ground-floor exhibition space of the Vigadó Gallery was created during the 1980 renovation and was expanded with a lower level in 2014. Even in the era of the Redoute, the venue hosted highly successful exhibitions: in 1842, at the proposal of Lajos Kossuth, the First Hungarian Exhibition of Applied Arts opened here and was visited by nearly fifteen thousand people within a single month.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"In the early 20th century, the café operating at this location became a regular meeting place for the writers of \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Nyugat\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\". Dezső Kosztolányi, Endre Ady, and Frigyes Karinthy were all frequent guests.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"updatedAt\":\"2026-01-29T10:16:27.803Z\",\"createdAt\":\"2025-11-17T10:26:34.170Z\"},{\"id\":4,\"name\":\"Vigadó Galley - Lower Floor\",\"floor\":\"Lower Floor (-1)\",\"coverImage\":{\"id\":50,\"alt\":\"Vigado_Galeria_also_szint\",\"prefix\":\"media\",\"folder\":\"$6:props:rooms:0:coverImage:folder\",\"updatedAt\":\"2025-11-17T10:24:36.570Z\",\"createdAt\":\"2025-11-17T10:24:36.569Z\",\"url\":\"/api/media/file/Vigado_Gal_also_szint.jpg\",\"thumbnailURL\":null,\"filename\":\"Vigado_Gal_also_szint.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":321674,\"width\":1024,\"height\":576,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[{\"id\":\"691b22156c6a9b7fb45313ff\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"An additional exhibition space is located on the lower level of the building, beneath the ground-floor gallery.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"With a total area of approximately 200 m², the space is primarily used for presenting contemporary works. It can be utilized either for standalone exhibitions or in conjunction with the ground-floor exhibition space.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[{\"id\":\"691af78b2c07e0592c58f253\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"For the reopening of the Pesti Vigadó in 2014, a 260 m² lower-level exhibition space was created, accessible from the ground-floor exhibition hall of the Vigadó Gallery. The space is also suitable for hosting exhibitions in combination with the ground-floor gallery.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}]},\"updatedAt\":\"2026-01-29T10:17:33.199Z\",\"createdAt\":\"2025-11-17T10:24:40.476Z\"}],\"staticContent\":{\"content\":[]}}]\n"])</script></body></html>