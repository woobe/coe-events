f the Northern Hall:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Theatre-style seating: 130 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Standing reception: 150 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Seated buffet-style or plated dinner: 100 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null,\"textFormat\":1}}},{\"id\":\"691b1c31a980fa9a522e7ade\",\"blockName\":null,\"slides\":[{\"id\":\"691b1c35a980fa9a522e7adf\",\"image\":{\"id\":80,\"alt\":\"Eszaki_terem_oldalnezet\",\"prefix\":\"media\",\"folder\":{\"id\":6,\"name\":\"Északi_terem_galéria\",\"folder\":null,\"documentsAndFolders\":{\"docs\":[{\"relationTo\":\"media\",\"value\":81},{\"relationTo\":\"media\",\"value\":80}],\"hasNextPage\":false},\"folderType\":[\"media\"],\"updatedAt\":\"2025-11-17T12:55:53.485Z\",\"createdAt\":\"2025-11-17T12:55:53.485Z\"},\"updatedAt\":\"2025-11-17T13:00:18.453Z\",\"createdAt\":\"2025-11-17T12:56:24.978Z\",\"url\":\"/api/media/file/Eszaki_terem_1.jpg\",\"thumbnailURL\":null,\"filename\":\"Eszaki_terem_1.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":719083,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1c3d