"Resume slideshow\",\"slide_announcement\":\"Slide {current} of {total}\",\"remove_filter\":\"Remove filter: {label}\"},\"Gallery\":{\"title\":\"Gallery ({count} images)\",\"lightbox_title\":\"Gallery — {current} / {total} images\"},\"Events\":{\"featured_events\":\"Featured Events\",\"all_events\":\"All Events\",\"constant\":\"Permanent\",\"upcoming_events\":\"Upcoming Events\",\"concert\":\"Concert\",\"exhibition\":\"Exhibition\",\"informative\":\"Informative\",\"general\":\"General\",\"archiv\":\"Archive\",\"virtual\":\"Virtual\",\"vigado-podcast\":\"Vigadó Podcast\",\"current_exhibitions\":\"Current exhibitions\",\"vigado_club_card_info\":\"Get your Pesti Vigadó Club Card at Vigadó Pont, which provides its holders with special discounts and privileges!\",\"all_exhibitions\":\"All exhibitions\",\"title\":\"Events\",\"list_view_tab_label\":\"List view\",\"calendar_view_tab_label\":\"Calendar view\",\"category_filter_label\":\"Category\",\"room_filter_label\":\"Venue\",\"date_filter_label\":\"Date\",\"delete_filters_button_label\":\"Clear filters\",\"apply_filters_button_label\":\"Apply\",\"apply_filters_button_disabled_tooltip\":\"Select a start and end date\",\"list_show_more_button_label\":\"Show more\",\"no_events_alert_message\":\"There are no events on this day! However, you are welcome to visit our exhibitions!\",\"exhibitions_carosuel_title\":\"Exhibitions\",\"exhibition_banner_title\":\"Our current exhibitions\",\"exhibition_banner_description\":\"Get your Pesti Vigadó Club Card at Vigadó Pont, which provides special discounts and privileges for its holders!\",\"exhibition_banner_button_label\":\"All exhibitions\",\"closed_alert_message\":\"The Vigadó building is closed on this day!\",\"room_link_label\":\"Venue page\",\"ticket_types_label\":\"Ticket types\",\"share_label\":\"Share\",\"buy_tickets\":\"Buy tickets\",\"register_to_event\":\"Register to event\",\"publicationsTitle\":\"Publications for purchase\",\"banner_more_button_label\":\"More information\",\"galleryTitle\":\"Vigadó Gallery\",\"galleryDescription\":\"Explore our past exhibitions and virtual exhibitions in the Vigadó Gallery!\",\"galleryYearFilterLabel\":\"Year\",\"currentExhibitions\":\"Current Exhibitions\",\"eventsByYearLabel\":\"Archive and Virtual Exhibitions\",\"countLabel\":\"items\",\"multipleEvents\":\"Multiple time slots\",\"moreTimeSlots\":\"More time slots\"},\"EventApplication\":{\"free\":\"Free\",\"formTitle\":\"Event Application\",\"formTitleCancellation\":\"Event Application cancellation\",\"seatLabel\":\"Seat\",\"firstNamePlaceholder\":\"First Name\",\"lastNamePlaceholder\":\"Last Name\",\"emailPlaceholder\":\"E-mail address\",\"formLabel\":\"Please provide your details.\",\"waitlistFormAlert\":\"Unfortunately, this event is already fully booked. By applying, you will be placed on a waitlist, and if a cancellation occurs, we will notify you via email.\",\"acceptTerms\":\"I accept the \u003clink\u003ePrivacy Policy\u003c/link\u003e.\",\"submitLabel\":\"Submit\",\"pendingAlert\":\"A jelentkezés véglegesítéséhez kérjük, erősítse meg e-mail címét a kiküldött levélben található linken. Amennyiben nem kapta meg az e-mailt, kérhet újraküldést, vagy ellenőrizheti megadott címét.\",\"acceptedAlert\":\"A jelentkezése sikerült. A visszaigazolást elküldtük önnek e-mailben. Jó szórakozást kívánunk!\",\"cancelledAlert\":\"A jelentkezés lemondása sikerült.\",\"waitlistAlert\":\"Sikeresen jelentkezett a várólistára. A visszaigazolást elküldtünk önnek e-mailben. Amennyiben lemondás történik, értesíteni fogjuk a megadott elérhetőségen.\",\"failedAlert\":\"A megerősítés sikertelen volt. Kérjük próbálja újra.\",\"cancellationFailedError\":\"A jelentkezés lemondása sikertelen volt. Kérjük próbálja újra.\",\"genericError\":\"An error occurred during registration. Please try again.\",\"duplicateEmailError\":\"A registration for this event already exists with this email address. Please try a different email.\",\"eventAlreadyStartedError\":\"This event has already started or ended. Please check out our other events!\",\"registrationClosedError\":\"Registration for this event is currently closed. Please check out our other events!\",\"formDescription\":\"{programTitle} — {eventDate}\"},\"Rooms\":{\"events_in_this_room\":\"Events in this room\",\"more_rooms\":\"More rooms\",\"all_rooms\":\"All rooms\",\"currently_not_available\":\"Currently not available!\",\"visitable_rooms_title\":\"Visitable Rooms\",\"visitable_rooms_list_title\":\"Visitable Rooms\",\"visitable_rooms_subtitle\":\"Event venue in the heart of history – at Pesti Vigadó\",\"visitable_rooms_description\":\"As the headquarters of the Hungarian Academy of Arts, Pesti Vigadó is one of the defining venues of Hungarian cultural life, standing out not only for its historical heritage but also for its contemporary art events. Its imposing halls – which have hosted numerous prestigious events from the 19th century to the present day – are also available to external partners as event venues.\",\"rentals\":\"Room Rental\",\"rentable_rooms_title\":\"Room Rental\",\"rentable_rooms_subtitle\":\"Event venue in the heart of history – at Pesti Vigadó\",\"rentable_rooms_description\":\"As the headquarters of the Hungarian Academy of Arts, Pesti Vigadó is one of the defining venues of Hungarian cultural life, standing out not only for its historical heritage but also for its contemporary art events. Its imposing halls – which have hosted numerous prestigious events from the 19th century to the present day – are also available to external partners as event venues.\",\"rentable_rooms_list_title\":\"Rentable rooms\",\"rentable_rooms_alert\":\"The possibility of renting the venue is subject to individual assessment in each case. Information about the conditions of use, related services, and available dates can be provided upon written request via the contact details below.\",\"rental_information_business_events_title\":\"Business \u0026 corporate events\",\"rental_information_b