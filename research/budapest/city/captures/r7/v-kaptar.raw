<div class="vc_btn3-container  btn-y vc_btn3-inline vc_do_btn" ><a class="vc_general vc_btn3 vc_btn3-size-md vc_btn3-shape-rounded vc_btn3-style-flat vc_btn3-color-grey" href="#meeting-rooms" title="">CHOOSE A MEETING ROOM</a></div></div></div></div></div></div></div></div></div><section class="vc_section vc_custom_1729871633140"><div class="vc_row wpb_row vc_row-fluid vc_custom_1589269662489"><div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner"><div class="wpb_wrapper">
