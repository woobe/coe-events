<script></script>    <script>
    document.addEventListener("DOMContentLoaded", function() {
        // Csak desktopon (768px felett)
        if (window.innerWidth >= 768) {
            var forms = document.querySelectorAll('.wpcf7-form');

            forms.forEach(function(form) {
                var inputs = form.querySelectorAll('input:not([type="submit"]), textarea, select');

                var revealTurnstile = function() {
                    // JAVÍTVA: Itt a 'user-started-typing' osztályt kell hozzáadni, mert ez van a CSS-ben!
                    form.classList.add('user-started-typing');
                    
                    inputs.forEach(function(el) {
                        el.removeEventListener('focus', revealTurnstile);
                        el.removeEventListener('input', revealTurnstile);
                        el.removeEventListener('click', revealTurnstile);
                    });
                };

                inputs.forEach(function(el) {
                    el.addEventListener('focus', revealTurnstile, {passive: true});
                    el.addEventListener('input', revealTurnstile, {passive: true});
                    el.addEventListener('click', revealTurnstile, {passive: true});
                });
            });
        }
    });
    </script>
    <script>
