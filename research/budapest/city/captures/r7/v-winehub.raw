<div id="cookie-consent-wrapper"
     data-module="cookie-consent"
     class="cookie-consent"
     role="region"
     aria-label="Cookie beállítások">

    
    <div class="cookie-consent__bar" id="cookie-consent-bar" aria-hidden="true">
        <div class="cookie-consent__bar-inner">
            <div class="cookie-consent__bar-content">
                <h2 class="cookie-consent__title">Cookie beállítások</h2>
                <p class="cookie-consent__description">Weboldalunk sütiket használ a felhasználói élmény javítása, a forgalom elemzése és a marketing célú tartalmak megjelenítése érdekében. Az „Összes elfogadása&quot; gombra kattintva hozzájárul az összes süti használatához.</p>
                            </div>
            <div class="cookie-consent__bar-actions">
                <button type="button" class="cookie-consent__btn cookie-consent__btn--primary" data-cc-accept>
                    Összes elfogadása
                </button>
                <button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" data-cc-reject>
                    Összes elutasítása
                </button>
                <button type="button" class="cookie-consent__btn cookie-consent__btn--link" data-cc-open-settings>
                    Beállítások
                </button>
            </div>
        </div>
    </div>

    
    <div class="cookie-consent__modal-overlay" id="cookie-consent-modal" aria-hidden="true">
        <div class="cookie-consent__modal" role="dialog" aria-modal="true" aria-label="Cookie beállítások">
            <div class="cookie-consent__modal-header">
                <h2 class="cookie-consent__modal-title">Cookie beállítások</h2>
                <button type="button" class="cookie-consent__modal-close" data-cc-close-modal aria-label="Bezárás">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="cookie-consent__modal-body">
                <p class="cookie-consent__modal-description">Weboldalunk sütiket használ a felhasználói élmény javítása, a forgalom elemzése és a marketing célú tartalmak megjelenítése érdekében. Az „Összes elfogadása&quot; gombra kattintva hozzájárul az összes süti használatához.</p>

                <div class="cookie-consent__categories">
                                            <div class="cookie-consent__category">
                            <div class="cookie-consent__category-header">
                                <div class="cookie-consent__category-info">
                                    <h3 class="cookie-consent__category-name">Szükséges</h3>
                                    <p class="cookie-consent__category-desc">Ezek a sütik elengedhetetlenek a weboldal alapvető működéséhez, és nem kapcsolhatók ki.</p>
                                </div>
                                <label class="cookie-consent__toggle">
                                    <input type="checkbox"
                                           name="cc_necessary"
                                           data-cc-toggle="necessary"
                                           checked                                           disabled>
                                    <span class="cookie-consent__toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                                            <div class="cookie-consent__category">
                            <div class="cookie-consent__category-header">
                                <div class="cookie-consent__category-info">
