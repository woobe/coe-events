  <body class="wp-singular page-template-default page page-id-4495 wp-embed-responsive wp-theme-winehub theme-winehub woocommerce-no-js venue-rental">
    
    <div id="app">
      <a class="sr-only focus:not-sr-only" href="#main">
        Skip to content
      </a>

            <header class="sticky top-0 z-50 shadow-md">
    <div class="relative">
        
        <div class="bg-neutral-900 text-white">
            <div class="max-w-[1136px] mx-auto flex">
                <div class="hidden lg:block w-[192px] shrink-0"></div>
                <div class="flex-1 px-4 py-2 flex items-center justify-between text-xs leading-4">
                    <p class="font-body">
                                                                                    Rendelj 15.000 Ft felett és a házhozszállítás díját mi fizetjük!
                                                                        </p>
                    <div class="flex items-center gap-4 shrink-0">
                        
                                                    <nav aria-label="Nyelvi váltó">
                                                                <div class="flex items-center gap-2">
                                                                                                                    <a href="https://winehub.hu/helyszinberles/"
                                           lang="hu-HU"
                                           hreflang="hu-HU"
                                           class="hover:underline"
                                           >
                                            HU
                                        </a>
                                                                                                                        <span>-</span>
                                                                                <a href="https://winehub.hu/en/venue-rental/"
                                           lang="en-GB"
                                           hreflang="en-GB"
                                           class="font-bold"
                                            aria-current="true" >
                                            EN
                                        </a>
                                                                    </div>
                            </nav>
                                            </div>
                </div>
            </div>
        </div>

        
        <div class="bg-secondary-300">
            <div class="max-w-[1136px] mx-auto flex">
                <div class="hidden lg:block w-[192px] shrink-0"></div>
                <div class="flex-1 px-4 py-2 flex items-center justify-between gap-8">
                    
                    <a href="https://winehub.hu/" class="shrink-0 lg:hidden" aria-label="WINE CONNECTS – Winehub - Kezdőlap">
                        <img src="https://winehub.hu/app/themes/winehub/public/build/assets/images/winehub.C1VyE-TI.svg"
                             alt="WINE CONNECTS – Winehub"
                             class="h-8 w-auto brightness-0"
                             width="117"
