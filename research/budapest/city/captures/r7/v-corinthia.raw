<section data-visibility="false" class="section__hero">
    
    <div class="container">
        <div class="text-only-hero__wrapper">
            <div class="text-only-hero page-header" data-module="HeroText">
                    <p class="label --sm" data-animate="label">CORINTHIA BUDAPEST</p>
                <h1 data-animate="title" class="text"> Meetings &amp; Events</h1>
            </div>
        </div>
    </div>

</section>


<section>

<section class="full-width section">
    <div class="container">
        <div class="generic-content-block">
            <div data-module="RichTextLayout" class="generic-content-block__body rich-text ">
                
<h2 style="text-align: center;"><strong>Connect&nbsp;<em>and&nbsp;</em>inspire</strong></h2>
<p style="text-align: center;" data-pm-slice="1 1 []">A setting that brings people together, where ideas flow and celebrations unfold with effortless style. At Corinthia Budapest, we blend historic grandeur with modern sophistication to create moments that matter. From elegant weddings beneath glittering chandeliers to high-level meetings and private dining experiences, every event is elevated by seamless service, exquisite cuisine and the timeless beauty of our landmark hotel in the heart of the city.</p>
            </div>
        </div>
    </div>
</section></section><section>
