	button.button.alt, #btn-join {
		background-color: #7EBB55!important;
    font-family: "Poppins", Sans-serif;
    font-weight: bold;
    border-style: none;
    border-radius: 100px 100px 100px 100px;
    padding: 16px 32px 16px 32px;
	}
	button.button.alt:hover, #btn-join:hover {
		background-color: #67924B!important;
	}
	#btn-join{
		color: #fff;
	}
	#ult-login-form #ult-login-submit {
		background: #7EBB55;
		font-family: "Poppins", Sans-serif;
    font-weight: bold;
    border-style: none;
    border-radius: 100px 100px 100px 100px;
    padding: 16px 32px 16px 32px;}
	#ult-login-form #ult-login-submit:hover {
		background: #67924B;}
	.course-lista .ld-course-list-items .ld_course_grid .thumbnail.course img {
   display: none;
}
	.course-lista .ld-course-list-items .ld_course_grid .entry-title {
    margin: 0 !important;
		padding-top: 2rem;}
	.course-lista .ld-course-list-items .ld_course_grid .btn-primary {
    background-color: #812926;
		border-color: #812926;}
	.course-lista .ld-course-list-items .ld_course_grid .btn-primary:hover{
    background-color: #C96924;
		border-color: #C96924;}
	.course-lista .ld-course-list-items .ld_course_grid .thumbnail.course .ribbon.enrolled {
    background: #812926;
}
	.course-lista .ld-course-list-items .ld_course_grid .thumbnail.course .ribbon.enrolled:before {
    border-top: 4px solid #812926d4;
		border-right: 4px solid #812926d4;}
