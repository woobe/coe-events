    var el = document.querySelector(SEL);
    if (!el || typeof Splide !== 'function') return;
    if (el.getAttribute('data-craft-autoscroll') === '1') return;
    var instances = (window.bricksData && window.bricksData.splideInstances) || {};
    var old = instances.tstgrd;
    if (!old) {
      window.setTimeout(boot, 50);
      return;
    }
    el.setAttribute('data-craft-autoscroll', '1');
    var opts = {};
    try { opts = JSON.parse(el.getAttribute('data-splide') || '{}'); } catch (e) {}
    old.destroy(true);
    var next = new Splide(el, Object.assign({}, opts, {
      autoplay: false,
