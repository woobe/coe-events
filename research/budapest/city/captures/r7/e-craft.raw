decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure-1536x1536.jpeg" data-srcset="https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure-1536x1536.jpeg 1536w, https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure-300x300.jpeg 300w, https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure-1024x1024.jpeg 1024w, https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure-150x150.jpeg 150w, https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure-768x768.jpeg 768w, https://craft-conf.com/2027/wp-content/uploads/2026/11/SH-Avatar-Azure.jpeg 2048w" data-sizes="(max-width: 1536px) 100vw, 1536px" /><img width="109" height="36" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='109'%20height='36'%20viewBox='0%200%20109%2036'%3E%3C/svg%3E" class="brxe-jxmskk brxe-image speaker-card__company css-filter size-large perfmatters-lazy" alt decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/11/Screenshot-2026-11-24-at-22.04.16.png" /></div><div class="brxe-jotvpm brxe-block speaker-card__body"><div class="brxe-gmovrk brxe-block speaker-card__copy"><p class="brxe-wginyq brxe-text-basic speaker-card__name">Sander Hoogendoorn</p><p class="brxe-mnijnx brxe-text-basic speaker-card__role">CTO @ ibood.com</p></div></div></a></div><div class="brxe-sk2lp brxe-block speaker-loop"><a href="https://craft-conf.com/2027/speaker/taylor-poindexter/" class="brxe-c51313 brxe-block speaker-card anim--1_element"><div class="brxe-nzhets brxe-block"><img width="400" height="400" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='400'%20height='400'%20viewBox='0%200%20400%20400'%3E%3C/svg%3E" class="brxe-bzxcwt brxe-image speaker-card__media css-filter size-1536x1536 perfmatters-lazy" alt decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/09/Taylor-Poindexter.webp" data-srcset="https://craft-conf.com/2027/wp-content/uploads/2026/09/Taylor-Poindexter.webp 400w, https://craft-conf.com/2027/wp-content/uploads/2026/09/Taylor-Poindexter-300x300.webp 300w, https://craft-conf.com/2027/wp-content/uploads/2026/09/Taylor-Poindexter-150x150.webp 150w" data-sizes="(max-width: 400px) 100vw, 400px" /><img width="960" height="289" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='960'%20height='289'%20viewBox='0%200%20960%20289'%3E%3C/svg%3E" class="brxe-jxmskk brxe-image speaker-card__company css-filter size-large perfmatters-lazy" alt decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/09/Spotify_logo_with_text.svg.webp" data-srcset="https://craft-conf.com/2027/wp-content/uploads/2026/09/Spotify_logo_with_text.svg.webp 960w, https://craft-conf.com/2027/wp-content/uploads/2026/09/Spotify_logo_with_text.svg-300x90.webp 300w, https://craft-conf.com/2027/wp-content/uploads/2026/09/Spotify_logo_with_text.svg-768x231.webp 768w" data-sizes="(max-width: 960px) 100vw, 960px" /></div><div class="brxe-jotvpm brxe-block speaker-card__body"><div class="brxe-gmovrk brxe-block speaker-card__copy"><p class="brxe-wginyq brxe-text-basic speaker-card__name">Taylor Poindexter</p><p class="brxe-mnijnx brxe-text-basic speaker-card__role">Engineering Manager @ Spotify</p></div></div></a></div><div class="brx-query-trail" data-query-element-id="sk2lp" data-query-vars="{&quot;meta_query&quot;:[{&quot;key&quot;:&quot;speaker_category&quot;,&quot;value&quot;:&quot;Featured&quot;},{&quot;key&quot;:&quot;speaker_is_previous&quot;,&quot;value&quot;:&quot;0&quot;}],&quot;number&quot;:&quot;-1&quot;,&quot;orderby&quot;:{&quot;display_name&quot;:&quot;ASC&quot;},&quot;role__in&quot;:[&quot;speaker&quot;],&quot;paged&quot;:1,&quot;original_offset&quot;:0,&quot;_bricks_query_signature&quot;:&quot;0f9fba1f9b0612944b63f13ad5c1dab6abd716fa5b55d702b50eec4e6b7f6488&quot;}" data-original-query-vars="[]" data-page="1" data-max-pages="-8" data-start="1" data-end="8"></div></div><div class="brxe-div anim--1_trigger"><a class="brxe-button btn btn--outline anim--1_element bricks-button" href="https://craft-conf.com/2027/?page_id=361">Check out the lineup</a></div></div></section></div><section id="brxe-dkbsec" class="brxe-section dekor-band"><div id="brxe-dkbvid" data-script-id="dkbvid" class="brxe-video dekor-band__train"><video src="https://craft-conf.com/2027/wp-content/uploads/2026/08/Sequence-01_1.mp4" preload="auto" autoplay playsinline onclick="this.paused ? this.play() : this.pause()" loop muted><p>Your browser does not support the video tag.</p></video></div></section><section  id="brxe-tagsec" class="brxe-section value-split"><div  id="brxe-msbhmf" data-script-id="msbhmf" class="brxe-video speakers__decor speakers__decor--csavar"><video src="https://craft-conf.com/2027/wp-content/uploads/2026/08/csavar-3d-elem-blur-fekete-hatter.webm" preload="auto" autoplay playsinline onclick="this.paused ? this.play() : this.pause()" loop muted><p>Your browser does not support the video tag.</p></video></div><div  class="brxe-image value-split__decor value-split__decor--blob tag"><img width="3012" height="2005" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='3012'%20height='2005'%20viewBox='0%200%203012%202005'%3E%3C/svg%3E" class="css-filter size-full perfmatters-lazy" alt decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/01/value-blob-ellipse-figma.webp" /></div><div  class="brxe-container value-split__inner"><div class="brxe-block value-split__intro"><div class="brxe-block value-split__head"><span class="brxe-text-basic value-split__tagline">Keynote highlights</span><h2 class="brxe-heading value-split__heading">Reconnect with the pure passion of creating software</h2></div><p class="brxe-text-basic value-split__body">Deep technical depth without the corporate stiffness. Walk away with Monday-ready practices for your stack - not just a badge gathering dust on your desk.</p><h2 class="brxe-heading value-split__heading">Less talk. More building.</h2><p class="brxe-text-basic value-split__body">Come for the ideas.<br>Stay for the conversations.<br>Leave ready to build.</p><h2 class="brxe-heading value-split__heading">From promises to value.</h2><p id="brxe-unghns" class="brxe-text-basic value-split__body">Because good ideas only matter when you can put them to work.</p></div><div class="brxe-block value-split__list"><div class="brxe-block value-row"><div class="brxe-image value-row__media tag"><img width="2048" height="1365" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='2048'%20height='1365'%20viewBox='0%200%202048%201365'%3E%3C/svg%3E" class="css-filter size-full perfmatters-lazy" alt decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/09/worldclassspeakers.webp" data-srcset="https://craft-conf.com/2027/wp-content/uploads/2026/09/worldclassspeakers.webp 2048w, https://craft-conf.com/2027/wp-content/uploads/2026/09/worldclassspeakers-300x200.webp 300w, https://craft-conf.com/2027/wp-content/uploads/2026/09/worldclassspeakers-1024x683.webp 1024w, https://craft-conf.com/2027/wp-content/uploads/2026/09/worldclassspeakers-768x512.webp 768w, https://craft-conf.com/2027/wp-content/uploads/2026/09/worldclassspeakers-1536x1024.webp 1536w" data-sizes="(max-width: 2048px) 100vw, 2048px" /></div><div class="brxe-block value-row__body"><div class="brxe-image value-row__icon tag"><img width="184" height="192" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='184'%20height='192'%20viewBox='0%200%20184%20192'%3E%3C/svg%3E" class="css-filter size-full perfmatters-lazy" alt decoding="async" data-src="https://craft-conf.com/2027/wp-content/uploads/2026/01/value-icon-speakers.webp" /></div><div class="brxe-block value-row__copy"><h3 class="brxe-heading value-row__title">Techstar speakers</h3><p class="brxe-text-basic value-row__text">Industry heavyweights who don't hide behind VIP curtains – ready for unscripted conversations and honest Q&As.</p></div></div><svg class="brxe-svg value-row__barcode" preserveAspectRatio="none" overflow="visible" style="display: block;" width="113.323" height="55" viewBox="0 0 113.323 55" fill="none" xmlns="http://www.w3.org/2000/svg">
