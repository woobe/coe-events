.subscribe-block__barcode {align-items: center; background-color: var(--bricks-color-col-8br14l); border-radius: 4px; display: flex; justify-content: center; overflow: hidden; padding-top: 4px; padding-right: 5px; padding-bottom: 4px; padding-left: 5px; width: 3.5rem; align-self: stretch !important; width: 100%}
.subscribe-block__barcode { flex: 0 0 3.5rem; width: 3.5rem; max-width: 3.5rem; box-shadow: 0 31px 9px rgba(0,0,0,0), 0 20px 8px rgba(0,0,0,0.01), 0 11px 7px rgba(0,0,0,0.03), 0 5px 5px rgba(0,0,0,0.05), 0 1px 3px rgba(0,0,0,0.06);} .subscribe-block__barcode svg { transform: rotate(-90deg); width: 11.65rem; height: 3.5rem; max-width: none;}


