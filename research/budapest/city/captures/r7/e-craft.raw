.testimonials__glow { pointer-events: none;} .testimonials__glow img { width: 130.3%; height: auto; aspect-ratio: 1506 / 1002; max-width: none; flex: 0 0 auto; object-fit: contain; transform: rotate(174.7deg);}


/* BREAKPOINT: Desktop (BASE) */
