.faq__icon { flex-shrink: 0; width: 2rem; height: 2rem; color: #000000; fill: currentColor;} .faq__icon .icon-svg,.faq__icon svg,.faq__icon i { width: 2rem; height: 2rem; font-size: 2rem; line-height: 1; display: block;}


/* BREAKPOINT: Desktop (BASE) */
.faq__answer {padding-top: 0; padding-right: 1.5rem; padding-bottom: 1.5rem; padding-left: 1.5rem; color: var(--bricks-color-col-518ssz); font-size: var(--text-m); font-weight: 400; line-height: 1.5; width: 100%}
