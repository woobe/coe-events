ht: 3rem; width: 7.3125rem}.footer__social {align-items: center; column-gap: 0.75rem; flex-direction: row; display: flex; row-gap: 0.75rem}.footer__social-icon {height: 1.5rem; width: 1.5rem}.footer__social-icon, .footer__social-icon path { fill: #ffffff; transition: fill .25s ease, transform .25s ease;} .footer__social-icon { transition: fill .25s ease, transform .25s ease;}a:hover .footer__social-icon,.footer__social-icon:hover { transform: scale(1.1);}a:hover .footer__social-icon,a:hover .footer__social-icon path,.footer__social-icon:hover,.footer__social-icon:hover path { fill: #fff5ed;}.footer__cols {align-items: flex-start; column-gap: 2rem; flex-direction: row; display: flex; flex-wrap: wrap; row-gap: 2rem; flex-grow: 0; flex-shrink: 0; width: auto}.footer__cols.brxe-block { width: auto !important; max-width: none;}@media (max-width: 478px) {.footer__cols {flex-direction: column}}.footer__col {align-items: flex-start; column-gap: 0.5rem; flex-direction: column; display: flex; row-gap: 0.5rem}.footer__col { width: auto; flex: 0 1 auto;}.footer__heading {color: var(--bricks-color-col-8br14l); font-size: var(--text-s); font-weight: 700; line-height: 1.5}.link--footer {display: inline-flex; color: var(--bricks-color-col-8br14l); font-size: var(--text-s); font-weight: 400; line-height: 1.5; text-decoration: none}.link--footer:hover {color: var(--bricks-color-col-4mjyxu)}.link--footer { transition: color .2s ease;} .link--footer:hover, .link--footer:focus-visible { color: #f35e1c;}.footer__credits {align-items: center; column-gap: 1.5rem; flex-direction: row; display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 1.5rem}.footer__legal {align-items: center; column-gap: 1.5rem; flex-direction: row; display: flex; flex-wrap: wrap; row-gap: 0.5rem}.footer__note {color: var(--bricks-color-col-8br14l); font-size: var(--text-s); font-weight: 500; line-height: 1.5}.tickets-popup {align-items: center; background-color: var(--bricks-color-col-8br14l); borde