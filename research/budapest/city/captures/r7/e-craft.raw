.subscribe-block__card { box-shadow: 0 92px 26px rgba(0,0,0,0), 0 59px 24px rgba(0,0,0,0.01), 0 33px 20px rgba(0,0,0,0.05), 0 15px 15px rgba(0,0,0,0.09), 0 4px 8px rgba(0,0,0,0.1);}

