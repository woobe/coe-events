<style id="bricks-global-classes-inline-inline-css">

/* BREAKPOINT: Desktop (BASE) */
.dekor-band {background-color: var(--bricks-color-col-8br14l); overflow: hidden; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; position: relative}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner {align-items: center; background-color: var(--bricks-color-col-8br14l); flex-direction: column; display: flex; justify-content: center; overflow: hidden; position: relative}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__nut {height: 35.85rem; overflow: visible; position: absolute; width: 35.85rem; z-index: 0; bottom: 0px; right: -10%}
.cta-banner__nut { mix-blend-mode: multiply;}

/* BREAKPOINT: Mobile portrait */
@media (max-width: 478px) {
.cta-banner__nut {width: 18.75rem; height: 18.75rem; left: 0px}
}

/* BREAKPOINT: Desktop (BASE) */
.cta-banner__inner {align-items: center; flex-direction: column; display: flex; justify-content: center; position: relative; z-index: 1}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__card {align-items: center; border-radius: 2.5rem; flex-direction: column; display: flex; justify-content: center; overflow: visible; padding-top: var(--space-2xl); padding-right: 3rem; padding-bottom: var(--space-2xl); padding-left: 3rem; position: relative; row-gap: var(--space-2xl); width: 70rem; z-index: 1}
.cta-banner__card { box-shadow: 0 237px 66px rgba(0,0,0,0), 0 152px 61px rgba(0,0,0,0.01), 0 85px 51px rgba(0,0,0,0.05), 0 38px 38px rgba(0,0,0,0.09), 0 9px 21px rgba(0,0,0,0.1);}

/* BREAKPOINT: Tablet portrait */
@media (max-width: 991px) {
.cta-banner__card {width: 100%}
}
/* BREAKPOINT: Mobile portrait */
@media (max-width: 478px) {
.cta-banner__card {width: 100%}
}

/* BREAKPOINT: Desktop (BASE) */
.cta-banner__media {border-radius: 2.5rem; bottom: 0px; height: 100%; left: 0px; overflow: hidden; position: absolute; right: 0px; top: 0px; width: 100%; z-index: 0}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__photo {bottom: 0px; height: 100%; left: 0px; position: absolute; right: 0px; top: 0px; width: 100%; z-index: 0}
.cta-banner__photo:not(.tag), .cta-banner__photo img {object-fit: cover}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__overlay {background-color: rgba(0,0,0,0.8); bottom: 0px; height: 100%; left: 0px; position: absolute; right: 0px; top: 0px; width: 100%; z-index: 1}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__glow {height: 28.1rem; overflow: visible; position: absolute; width: 32.75rem; z-index: 1}
.cta-banner__glow { transform: rotate(75deg);}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__glow--left {left: -18.0625rem; top: 15.977rem}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__glow--right {right: -19.5rem; top: -14.649rem}


/* BREAKPOINT: Desktop (BASE) */
.cta-banner__content {align-items: center; flex-direction: column; display: flex; position: relative; row-gap: var(--space-l); width: 100%; z-index: 2}


/* BREAKPOINT: Desktop (BASE) */
