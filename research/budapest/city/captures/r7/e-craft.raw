</script></div></section><section  class="brxe-section faq"><svg class="brxe-svg faq__glow" preserveAspectRatio="none" overflow="visible" style="display: block;" width="1241.34" height="1237.54" viewBox="0 0 1241.34 1237.54" fill="none" xmlns="http://www.w3.org/2000/svg">
