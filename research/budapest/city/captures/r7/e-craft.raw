@property --barcode-peel { syntax: "<angle>"; inherits: false; initial-value: 0deg;}@property --barcode-x { syntax: "<length>"; inherits: false; initial-value: 0px;}@property --barcode-y { syntax: "<length>"; inherits: false; initial-value: 0px;}@property --barcode-wobble { syntax: "<number>"; inherits: false; initial-value: 0;} .cta-banner__barcode { box-shadow: 0 31px 9px rgba(0,0,0,0), 0 20px 8px rgba(0,0,0,.01), 0 11px 7px rgba(0,0,0,.03), 0 5px 5px rgba(0,0,0,.05), 0 1px 3px rgba(0,0,0,.06); pointer-events: none; z-index: 1; transform-origin: top left; --barcode-peel: 0deg; --barcode-x: 0px; --barcode-y: 0px; --barcode-wobble: 0; transform: rotate(calc(var(--barcode-peel) + var(--barcode-wobble) * 3deg * (var(--barcode-peel) / 30deg)))       translate(var(--barcode-x), calc(var(--barcode-y) + var(--barcode-wobble) * 2px * (var(--barcode-peel) / 30deg))); transition:  --barcode-peel .4s cubic-bezier(.34, 1.3, .64, 1),  --barcode-x .4s cubic-bezier(.34, 1.3, .64, 1),  --barcode-y .4s cubic-bezier(.34, 1.3, .64, 1),  box-shadow .4s ease; animation: barcode-wobble 1.6s ease-in-out infinite;}@keyframes barcode-wobble { 0%, 100% { --barcode-wobble: 1; } 50%   { --barcode-wobble: -1; }}

