.subscribe-block__form {width: 100%}
.bricks-is-frontend .brxe-brf-pro-forms.subscribe-block__form { display: grid; grid-template-columns: 1fr auto; gap: 1rem 0; width: 100%; align-items: stretch;} .bricks-is-frontend .subscribe-block__form .form-group:not(.submit-button-wrapper):not(.brf-steps) { padding-bottom: 0;} .subscribe-block__form > .brxe-brf-pro-forms-field-email { grid-column: 1; grid-row: 1; min-width: 0;} .subscribe-block__form > .brxe-brf-pro-forms-field-submit-button { grid-column: 2; grid-row: 1;} .subscribe-block__form > .brxe-brf-pro-forms-field-checkbox { grid-column: 1 / -1; grid-row: 2;} .subscribe-block__form input[type=email] { width: 100%; height: 3.5rem; background-color: #ffffff; border: 0; border-radius: 12px 0 0 12px; padding: 12px; font-size: 1rem; line-height: 1.5; color: #444444;} .subscribe-block__form input[type=email]::placeholder { color: #444444; opacity: 0.8;} .subscribe-block__form .brxe-brf-pro-forms-field-submit-button button,.subscribe-block__form button[type=submit] { height: 3.5rem; background-color: var(--bricks-color-g3okvn, #e44412); color: #ffffff; border: 0; border-radius: 0 12px 12px 0; padding: 12px 24px; font-size: 1.125rem; font-weight: 700; line-height: 1.5; white-space: nowrap; cursor: pointer;} .subscribe-block__form .brxe-brf-pro-forms-field-submit-button button:hover,.subscribe-block__form button[type=submit]:hover { background-color: var(--bricks-color-4mjyxu, #f35e1c);} .subscribe-block__form .brxe-brf-pro-forms-field-checkbox { display: flex; gap: 8px; align-items: flex-start;} .subscribe-block__form .brxe-brf-pro-forms-field-checkbox label { color: #ffffff; font-size: 0.875rem; font-weight: 400; line-height: 1.5;} .subscribe-block__form .brxe-brf-pro-forms-field-checkbox a { color: inherit; text-decoration: underline;} .subscribe-block__form .brxe-brf-pro-forms-field-checkbox input[type=checkbox] { width: 24px; height: 24px; flex-shrink: 0; appearance: none; -webkit-appearance: none; background-color: #ffffff; border: 1.5px solid #f35e1c; border-radius: 4px; margin: 0; cursor: pointer;} .subscribe-block__form .brxe-brf-pro-forms-field-checkbox input[type=checkbox]:checked { background-color: #f35e1c;}@media (max-width: 767px) { .bricks-is-frontend .brxe-brf-pro-forms.subscribe-block__form {  grid-template-columns: 1fr; } .subscribe-block__form > .brxe-brf-pro-forms-field-email, .subscribe-block__form > .brxe-brf-pro-forms-field-submit-button, .subscribe-block__form > .brxe-brf-pro-forms-field-checkbox {  grid-column: 1;  grid-row: auto; } .subscribe-block__form input[type=email], .subscribe-block__form .brxe-brf-pro-forms-field-submit-button button, .subscribe-block__form button[type=submit] {  border-radius: 12px;  width: 100%; }}


