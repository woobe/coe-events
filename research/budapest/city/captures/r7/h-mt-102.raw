<div data-ng-controller="cookieLawCtrl" data-ng-init="init()"
     class="cookie-law ng-cloak flex fixed w-full color-white" data-ng-show="!accepted">
    <div class="cookie-law__holder flex flex-row justify-center items-center gap-40">
        <div class="flex flex-row gap-8">
            <i class="ri-information-2-fill text-24 color-white"></i>
            <span class="text-medium color-white font-medium">
                <span data-ng-non-bindable="true">A működéshez szükséges sütik mellett a Google Analytics statisztikai sütijeit, a munkamenet-azonosítót és a bejelentkezést csak az Ön hozzájárulásával használjuk. Döntését bármikor megváltoztathatja a lábléc „Süti beállítások” hivatkozásával.</span>
                <span data-ng-hide="onCookiePage"><br/><span data-ng-non-bindable="true">A cookie-k kezeléséről részletesebb információt <a href="static/cookie">ide</a> kattintva olvashat.</span></span>
            </span>
        </div>
        <div class="flex flex-row gap-8">
            <button class="button primary" id="acceptButton" data-ng-if="!consentGiven"
                    data-ng-click="acceptCookieLaw()">Elfogadom</button>
            <button class="button primary" id="keepButton" data-ng-if="consentGiven"
                    data-ng-click="keepCookieLaw()">Nem változtatok</button>
            <button class="button outline inverted" id="rejectButton"
                    data-ng-click="rejectCookieLaw()">Elutasítom</button>
        </div>
    </div>
</div>
