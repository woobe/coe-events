        reportReasons['i100'] = 'Detected Spam';
        
        
        reportReasons['i101'] = 'Detected Spam High';
        
        
        reportReasons['i250'] = 'Internal Note';
        
        
        reportReasons['i251'] = 'Internal Note Auto';
        
    function getReportReasonText(s) {
