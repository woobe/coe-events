                <h2 style="text-transform: uppercase; font-weight: bold; letter-spacing: 6px;" class="m-b-sm">Call for Speakers</h2>
            </div>
                <div class="ibox-content no-padding">
                    <img src="https://cdn.sessionize.com/image/31b8-1140o400o3-L81ZZ4geZJ7D1jkdnp7dvM.png" style="max-width: 100%" alt="" />
