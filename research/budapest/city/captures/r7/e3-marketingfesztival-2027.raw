<script type="text/javascript">
//////////////////////////
  function isValidEmailAddress(emailAddress) { var pattern = new RegExp(/^((([a-z]|\d|[!#\$%&'\*\+\-\/=\?\^_`{\|}~]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+(\.([a-z]|\d|[!#\$%&'\*\+\-\/=\?\^_`{\|}~]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+)*)|((\x22)((((\x20|\x09)*(\x0d\x0a))?(\x20|\x09)+)?(([\x01-\x08\x0b\x0c\x0e-\x1f\x7f]|\x21|[\x23-\x5b]|[\x5d-\x7e]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])|(\\([\x01-\x09\x0b\x0c\x0d-\x7f]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF]))))*(((\x20|\x09)*(\x0d\x0a))?(\x20|\x09)+)?(\x22)))@((([a-z]|\d|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])|(([a-z]|\d|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])([a-z]|\d|-|\.|_|~|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])*([a-z]|\d|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])))\.)+(([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])|(([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])([a-z]|\d|-|\.|_|~|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])*([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])))\.?$/i); return pattern.test(emailAddress); };
  
  
/* ============================================================
   GA4 / GTM ECOMMERCE MERES
   ESEMENY: form_submit_ticket

   Cel:
   Sikeres jegyurlap validacio utan, kozvetlenul a tovabblepes
   elott elkuldjuk a jegyvasarlasi urlap adatait.

   Dinamikusan merjuk:
   - jegytipus
   - fizetesi mod
   - darabszam
   - tenyleges netto fizetendo osszeg
   - ervenyes kuponkod, ha volt
   - megfelelo GA4 items adat

   Fontos:
   - csak ervenyes urlapnal fusson
   - minden ecommerce push elott ecommerce:null urites
   - kozvetlen GA4 / Google Ads / Meta kod nincs
   - ES5 kompatibilis
   ============================================================ */

function pushTicketFormSubmit(formSelector, ticketType, paymentFieldName) {

    var form = $(formSelector);

    if (!form.length) {
        return;
    }

    var quantity = parseInt(
        form.find("select[name='darab']").val(),
        10
    ) || 0;

    var value = parseInt(
        form.find("input.fizetendo").val(),
        10
    ) || 0;

    var paymentType = form.find(
        "input[name='" + paymentFieldName + "']:checked"
    ).val() || "";
	
	var email = form.find("input[name='email']").val() || "";
	
	var phoneNumber = form.find("input[name='mobil']").val() || "";

    var couponValid = form.data("coupon-valid") === true;
    var couponCode = form.data("coupon-code") || "";

    var item = null;


    /* Fesztivalozo */
    if (ticketType === "fesztivalozo") {

        item = {
            item_id: "jegy_fesztivalozo",
            item_name: "Fesztiválozó jegy",
            item_brand: "Magyar Marketing Fesztivál",
            item_category: "Jegy",
            item_category2: "Fesztiválozó",
            price: quantity > 0 ? Math.round(value / quantity) : 0,
            quantity: quantity,
            index: 0
        };
    }


    /* Kapcsolatepito */
    if (ticketType === "kapcsolatepito") {

        item = {
            item_id: "jegy_kapcsolatepito",
            item_name: "Kapcsolatépítő jegy",
            item_brand: "Magyar Marketing Fesztivál",
            item_category: "Jegy",
            item_category2: "Kapcsolatépítő",
            price: quantity > 0 ? Math.round(value / quantity) : 0,
            quantity: quantity,
            index: 1
        };
    }


    /* PREMIUM+ */
    if (ticketType === "premium") {

        item = {
            item_id: "jegy_premium",
            item_name: "PRÉMIUM+ jegy",
            item_brand: "Magyar Marketing Fesztivál",
            item_category: "Jegy",
            item_category2: "Prémium",
            price: quantity > 0 ? Math.round(value / quantity) : 0,
            quantity: quantity,
            index: 2
        };
    }


    if (!item) {
        return;
    }


    var ecommerceData = {
        currency: "HUF",
        value: value,
        items: [item]
    };


    /* Coupon csak akkor kerul bele, ha tenylegesen ervenyes. */
    if (couponValid && couponCode !== "") {
        ecommerceData.coupon = couponCode;
    }


    window.dataLayer.push({
        ecommerce: null
    });


    window.dataLayer.push({
        event: "form_submit_ticket",
        ticket_type: ticketType,
        payment_type: paymentType,
		user_data: {
			email: email,
			phone_number: phoneNumber
		},
        ecommerce: ecommerceData
    });
	
	console.log("FORM_SUBMIT_TICKET PUSH JSON: " + JSON.stringify({
    event: "form_submit_ticket",
    ticket_type: ticketType,
    payment_type: paymentType,
	user_data: {
		email: email,
		phone_number: phoneNumber
	},
    ecommerce: ecommerceData
}));

}

  
////////////////// Kapcsolatépítő JEGY >
  
$(document).ready(function () {
    $("#form-kapcsolatepito").submit(function (e) {
	
	if( $('#form-kapcsolatepito select[name="darab"] option:selected').val()=="0" )
		{
			
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>Hágy darab jegyet vásárol?</h4></div>");
			return false;
		}

		
	if($('#form-kapcsolatepito input[name="vezeteknev"]').val()=="")
		{
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>Adja meg a vezetéknevét!</h4></div>");
			return false;
		}
	if($('#form-kapcsolatepito input[name="keresztnev"]').val()=="")
		{
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>Adja meg a keresztnevét!</h4></div>");
			return false;
		}	
	
	if($('#form-kapcsolatepito input[name="cegnev"]').val()=="")
		{

			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>Add meg a számlára kerülő cégnevet és adószámot, vagy természetes személy esetén a saját neved.</h4></div>");
			return false;
		}	
		
	
		
	
	if($('#form-kapcsolatepito input[name="email"]').val()=="")
		{
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>Írja be az e-mail címét!</h4></div>");
			return false;
		}
		
		
		if (!isValidEmailAddress($('#form-kapcsolatepito input[name="email"]').val())) {
        $("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>A megadott e-mail cím helytelen!</h4></div>");
			return false;
      }
	
	
	if($('#form-kapcsolatepito input[name="szamlacim_irnyszam"]').val()=="")
		{
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>A számlázási irányítószám hiányzik!</h4></div>");
			return false;
		}	
	
	if($('#form-kapcsolatepito input[name="szamlacim_varos"]').val()=="")
		{
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>A számlázási település hiányzik!</h4></div>");
			return false;
		}
	
	if($('#form-kapcsolatepito input[name="szamlacim_cim"]').val()=="")
		{
			$("#msg").html("<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button><h4>A számlázási utca, házszám hiányzik!</h4></div>");
			return false;
		}
		
		
			
			t = false;
			$('#form-kapcsolatepito input[name="fizmodkapcsolatepito"]').each(function(){
			   t = t || $(this).is(':checked'); 
			});
			if(!t)
			{
				$("#msg").html("<div class='alertdiv'><div class='alert alert-danger' role='alert' id='alert-div'><button type='button' class='close' data-dismiss='alert'><span aria-hidden='true'>×</span></button><span class='alert-text'>Válassz fizetési módot!</span></div></div>");
				return false;
			}
			
			t2 = false;
			$('input[name="aszfkapcsolatepito"]').each(function(){
			   t2 = t2 || $(this).is(':checked');
			});
			if(!t2)
			{
				
				$("#msg").html("<div class='alertdiv'><div class='alert alert-danger' role='alert' id='alert-div'><button type='button' class='close' data-dismiss='alert'><span aria-hidden='true'>×</span></button><span class='alert-text'>Fogadd el a szerődési feltételeket a vásárláshoz!</span></div></div>");
				return false;
			}
			
		// ha bepipálja a Magánszemély boxot akkor nem ellenőrizzük az adószám mezőt!	
		t3 = false;
			$('input[name="maganszemelykapcsolatepito"]').each(function(){
			   t3 = t3 || $(this).is(':checked');
			});
			if(!t3)
			{
				// ha nincs pipa a magánszemély vagyoknál akkor ellenőrizzük az adószmát
				
			
			 // Adószám ellenőrzése valós időben
        var adoszam = $('#form-kapcsolatepito input[name="adoszam"]').val();
        var errors = [];

        // Feltétel 1: "+" karakter nem lehet benne
        if (adoszam.includes('+')) {
            errors.push('Az adószám nem tartalmazhat "+" karaktert.');
        }

        // Feltétel 2: maximum két "-" karakter lehet benne
        if ((adoszam.match(/-/g) || []).length > 2) {
            errors.push('Az adószám legfeljebb két "-" karaktert tartalmazhat.');
        }

        // Feltétel 3: maximum két betű karakter lehet benne (kis- és nagybetű egyaránt)
        if ((adoszam.match(/[a-zA-Z]/g) || []).length > 2) {
            errors.push('Az adószám legfeljebb két betű karaktert tartalmazhat.');
        }

        // Feltétel 4: egyébként csak szám lehet benne
        if (!/^[0-9a-zA-Z-]*$/.test(adoszam)) {
            errors.push('Az adószám csak számokat, betűket és "-" karaktereket tartalmazhat.');
        }

        // Feltétel 5: maximum hossz 15 karakter
        if (adoszam.length > 15) {
            errors.push('Az adószám minimum 8 és maximum 15 karakter hosszú lehet.');
        }
		
		// Feltétel 6: maximum hossz 15 karakter
        if (adoszam.length < 8) {
            errors.push('Az adószám minimum 8 és maximum 15 karakter hosszú lehet.');
        }

        // Ha van hiba, megjelenítjük az üzenetet
        if (errors.length > 0) {
            var errorHtml = "<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button>";
            errors.forEach(function (error) {
                errorHtml += "" + error + "";
            });
            errorHtml += "</div>";

            $("#msg").html(errorHtml);
            return false;
        }
		
			}
	

		$("#buttondiv").hide();
		$("#loaddiv").show();
		$("#msg").html("Folyamatban...");
		
			
				$("#msg").html("Kis türemet...");
				var data=[];
				
				data["jegytipus"]=$("#form-kapcsolatepito input[name='jegytipus']").val();
				data["jegy"]=$("#form-kapcsolatepito input[name='jegy']").val();
				data["partnertag"]=$("#form-kapcsolatepito input[name='partnertag']").val();
				data["partnertag1"]=$("#form-kapcsolatepito input[name='partnertag1']").val();
				
				
				data["darab"] = $("#form-kapcsolatepito select[name='darab'] option:selected").val();
				data["vezeteknev"]=$("#form-kapcsolatepito input[name='vezeteknev']").val();
				data["keresztnev"]=$("#form-kapcsolatepito input[name='keresztnev']").val();
				data["email"]=$("#form-kapcsolatepito input[name='email']").val();
				data["mobil"]=$("#form-kapcsolatepito input[name='mobil']").val();
				
				data["cegnev"]=$("#form-kapcsolatepito input[name='cegnev']").val();
				data["adoszam"]=$("#form-kapcsolatepito input[name='adoszam']").val();
				data["szamlacim_irnyszam"]=$("#form-kapcsolatepito input[name='szamlacim_irnyszam']").val();
				data["szamlacim_varos"]=$("#form-kapcsolatepito input[name='szamlacim_varos']").val();
				data["szamlacim_cim"]=$("#form-kapcsolatepito input[name='szamlacim_cim']").val();

				data["kupon"]=$("#form-kapcsolatepito input[name='kupon']").val();
				data["megjegyzes"]=$("#form-kapcsolatepito input[name='megjegyzes']").val();
				
				data["fizmodkapcsolatepito"]=$("#form-kapcsolatepito input[name='fizmodkapcsolatepito']:checked").val();
				
				console.log("KAPCSOLATEPITO DATA:", {
					jegytipus: data["jegytipus"],
					jegy: data["jegy"],
					darab: data["darab"],
					kupon: data["kupon"],
					fizmod: data["fizmodkapcsolatepito"]
				});
				
				pushTicketFormSubmit(
					"#form-kapcsolatepito",
					"kapcsolatepito",
					"fizmodkapcsolatepito"
				);

						
					if( $('#form-kapcsolatepito select[name="darab"] option:selected').val()=="1" && $('#form-kapcsolatepito input[name="kupon"]').val()!="MMF2022_KAPCSOLATEPITO_VIP" && $('#form-kapcsolatepito input[name="kupon"]').val()!="MMF2019_FESZTIVALOZO_VIP")
					{
							   post_to_url("https://marketingfesztival.hu/upsell/?eb=1",data);

					}
					else {
							   post_to_url("https://marketingfesztival.hu/upsell/?eb=1",data);

					}
					

return false;
    });	
		
	
	
});

function post_to_url(path, params) {
    var form = $('<form/>').attr({'action': path, 'method': 'post', 'id': 'replacer'});
    for(var key in params) {
        form.append($('<input/>').attr({'type': 'hidden', 'name': key, 'value': params[key]}));
    }
    $('body').append(form);
    form.submit();
}

