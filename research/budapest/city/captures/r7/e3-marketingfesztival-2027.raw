	<script>
    function showDiv(id) {

    /* ========================================================
       JEGYURLAP MEGNYITASA
       + GA4 / GTM ECOMMERCE MERES

       Meres:
       - div1 = Fesztivalozo jegy add_to_cart
       - div2 = Kapcsolatepito jegy add_to_cart
       - div3 = PREMIUM+ jegy add_to_cart

       Az add_to_cart akkor fut le, amikor a latogato
       az adott jegytipust kivalasztja es az urlap megnyilik.

       Fontos:
       - kozvetlen GA4 / Google Ads / Meta kod nincs
       - csak window.dataLayer.push()
       - minden ecommerce esemeny elott ecommerce:null urites
       - ES5 kompatibilis kod
       ======================================================== */

    var contents = document.querySelectorAll('.jegyContent');
    var i;

    for (i = 0; i < contents.length; i++) {
        contents[i].style.display = 'none';
    }

    var target = document.getElementById(id);

    if (target) {
        target.style.display = 'block';
    }


    /* ========================================================
       add_to_cart - Fesztivalozo jegy
       ======================================================== */

    if (id === 'div1') {

        window.dataLayer.push({
            ecommerce: null
        });

        window.dataLayer.push({
            event: 'add_to_cart',
            ecommerce: {
                currency: 'HUF',
                value: 24900,
                items: [
                    {
                        item_id: 'jegy_fesztivalozo',
                        item_name: 'Fesztiválozó jegy',
                        item_brand: 'Magyar Marketing Fesztivál',
                        item_category: 'Jegy',
                        item_category2: 'Fesztiválozó',
                        price: 24900,
                        quantity: 1,
                        index: 0
                    }
                ]
            }
        });
    }


    /* ========================================================
       add_to_cart - Kapcsolatepito jegy
       ======================================================== */

    if (id === 'div2') {

        window.dataLayer.push({
            ecommerce: null
        });

        window.dataLayer.push({
            event: 'add_to_cart',
            ecommerce: {
                currency: 'HUF',
                value: 29900,
                items: [
                    {
                        item_id: 'jegy_kapcsolatepito',
                        item_name: 'Kapcsolatépítő jegy',
                        item_brand: 'Magyar Marketing Fesztivál',
                        item_category: 'Jegy',
                        item_category2: 'Kapcsolatépítő',
                        price: 29900,
                        quantity: 1,
                        index: 1
                    }
                ]
            }
        });
    }


    /* ========================================================
       add_to_cart - PREMIUM+ jegy
       ======================================================== */

    if (id === 'div3') {

        window.dataLayer.push({
            ecommerce: null
        });

        window.dataLayer.push({
            event: 'add_to_cart',
            ecommerce: {
                currency: 'HUF',
                value: 49900,
                items: [
                    {
                        item_id: 'jegy_premium',
                        item_name: 'PRÉMIUM+ jegy',
                        item_brand: 'Magyar Marketing Fesztivál',
                        item_category: 'Jegy',
