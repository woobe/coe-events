			{
				// ha nincs pipa a magánszemély vagyoknál akkor ellenőrizzük az adószmát
				

			
			 // Adószám ellenőrzése valós időben
        var adoszam = $('#form-vip input[name="adoszam"]').val();
        var errors = [];

        // Feltétel 1: "+" karakter nem lehet benne
        if (adoszam.includes('+')) {
            errors.push('Az adószám nem tartalmazhat "+" karaktert.');
        }

        // Feltétel 2: maximum két "-" karakter lehet benne
        if ((adoszam.match(/-/g) || []).length > 2) {
            errors.push('Az adószám legfeljebb két "-" karaktert tartalmazhat.');
        }

        // Feltétel 3: maximum két betű karakter lehet benne (kis- és nagybetű egyaránt)
        if ((adoszam.match(/[a-zA-Z]/g) || []).length > 3) {
            errors.push('Az adószám legfeljebb három betű karaktert tartalmazhat.');
        }

        // Feltétel 4: egyébként csak szám lehet benne
        if (!/^[0-9a-zA-Z-]*$/.test(adoszam)) {
            errors.push('Az adószám csak számokat, betűket és "-" karaktereket tartalmazhat.');
        }

        // Feltétel 5: maximum hossz 15 karakter
        if (adoszam.length > 15) {
            errors.push('Az adószám minimum 8 és maximum 15 karakter hosszú lehet.');
        }
		
		// Feltétel 6: minimum hossz 8 karakter
        if (adoszam.length < 8) {
            errors.push('Az adószám minimum 8 és maximum 15 karakter hosszú lehet.');
        }

        // Ha van hiba, megjelenítjük az üzenetet
        if (errors.length > 0) {
            var errorHtml = "<div class='alert alert-dismissable alert-danger'><button type='button' class='close' data-dismiss='alert' aria-hidden='true'>×</button>";
            errors.forEach(function (error) {
                errorHtml += "" + error + "";
            });
            errorHtml += "</div>";

            $("#msg3").html(errorHtml);
            return false;
        }
		
		
			}

		$("#buttondiv").hide();
		$("#loaddiv").show();
		$("#msg3").html("Folyamatban...");
		
			
				$("#msg3").html("Kis türemet...");
				var data=[];
				
