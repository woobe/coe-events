<div class="helyekszama">Válaszd ki, melyik típusú részvételi csomagot szeretnéd lefoglalni és kattints az <strong>[Ezt a típust választom]</strong> gombra! Az adatok megadása után kattints a <strong>Megrendelés</strong> gombra. 
<img src="https://marketingfesztival.hu/2022/img/figyelem.png" width="30" height="26" /> <strong>FONTOS: </strong> A helyek száma idén is korlátozott! </div>  
   
   
   <div class="col-md-12" style="height:150px;">

        	<script>

function toDateString(strTempString) {
        strReturnString = "";
        if (strTempString < 10) {
                strReturnString += "0";
        }
        return strReturnString + strTempString.toString();
}
</script>
<script language="JavaScript"  type="text/javascript">
// javascriptben 0-tól kezdődik a hónapok számozása, php-ban meg 1-től !!!
var datediff = new Date() - new Date(2026,10,26,11,28,56);
</script>

 
   
  <div class="visszaszamolkoepre">
      <div class="helyekszama">Még eddig megvásárolhatod meg a jegyed:</div>
    </div>
 
 <div class="visszaszamolkoepre">
    <div class="nap4" id="day"></div>
    <div class="nap3" id="hour"></div>
    <div class="nap2" id="min"></div>
    <div class="nap1" id="sec"></div>
    

<script language="JavaScript"  type="text/javascript">
// javascriptben 0-tól kezdődik a hónapok számozása, php-ban meg 1-től !!!
function countdown() {
	
	var strEventDate = new Date(2027,0,28,8,29,59);
   		
        
        var now = new Date();
        diff = Math.floor((strEventDate.getTime() - now.getTime()+datediff)/1000);
        if(diff <= 0) {
                return; 
        }

        intsec = toDateString(diff % 60);
        diff = Math.floor(diff / 60);
        intMinutes = toDateString(diff % 60);
        diff = Math.floor(diff / 60);
        intHours = toDateString(diff % 24);
        diff = Math.floor(diff / 24);
        intDays = diff;   
		document.getElementById("sec").innerHTML = intsec;
		document.getElementById("min").innerHTML = intMinutes;

        document.getElementById("hour").innerHTML = intHours;
		document.getElementById("day").innerHTML = intDays;
        setTimeout("countdown();", 500);
}
if (window.addEventListener){window.addEventListener('load', countdown, false);}
else if (window.attachEvent){window.attachEvent('onload', countdown);}
</script>

</div>


