	t = false;
			$('#form-vip input[name="fizmodvip"]').each(function(){
			   t = t || $(this).is(':checked'); 
			});
			if(!t)
			{
				$("#msg3").html("<div class='alertdiv'><div class='alert alert-danger' role='alert' id='alert-div'><button type='button' class='close' data-dismiss='alert'><span aria-hidden='true'>×</span></button><span class='alert-text'>Válassz fizetési módot!</span></div></div>");
				return false;
