				$("#msg3").html("<div class='alertdiv'><div class='alert alert-danger' role='alert' id='alert-div'><button type='button' class='close' data-dismiss='alert'><span aria-hidden='true'>×</span></button><span class='alert-text'>Fogadd el a szerődési feltételeket a vásárláshoz!</span></div></div>");
				return false;
