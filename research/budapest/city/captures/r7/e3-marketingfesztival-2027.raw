<!-- A vissza a tetejére gomb -->
<div id="scrollTopButton" class="hidden" onclick="scrollToTop()">
    ▲ Oldal teteje
</div>

<!-- A jegyekhez ugró gomb -->
<div id="scrollToTicketsButton" class="hidden" onclick="scrollToTickets()">
    Jegyekhez
</div>

<!-- A vissza a tetejére gomb -->
<div id="scrollTopButton" class="hidden" onclick="scrollToTop()">
    ▲ Oldal teteje
</div>

<!-- A jegyekhez ugró gomb -->
<div id="scrollToTicketsButton" class="hidden" onclick="scrollToTickets()">
    Jegyekhez
</div>

<script>
let showScrollButton = false;
let showTicketsButton = false;

// Ellenőrzi, hogy elérte-e a megfelelő részt, és beállítja a showButton értékét
window.onscroll = function() {
    const bannerSection = document.getElementById("bannerek");
    const eloadokSection = document.getElementById("eloadok");
    
    if (isScrolledPast(bannerSection)) {
        showScrollButton = true;
    } else {
        showScrollButton = false;
    }

    if (isScrolledPast(eloadokSection)) {
        showTicketsButton = true;
    } else {
        showTicketsButton = false;
    }
};

// Ellenőrzi, hogy a felhasználó túlgörgette-e az elemet
function isScrolledPast(element) {
    const rect = element.getBoundingClientRect();
    return rect.top <= window.innerHeight;
}

// A gombok megjelenítése/felrejtése a megfelelő szekciókhoz való görgetés szerint
window.addEventListener("scroll", function () {
    const scrollTopButton = document.getElementById("scrollTopButton");
    const scrollToTicketsButton = document.getElementById("scrollToTicketsButton");
    const jegyekSection = document.getElementById("jegyekbox");

    // Megnézzük, hogy a #jegyek szekció látható-e
    const jegyekRect = jegyekSection.getBoundingClientRect();
    const isJegyekVisible = (
        jegyekRect.top < window.innerHeight &&
        jegyekRect.bottom > 0
    );

    // Gombok megjelenítése/felrejtése
    if (showScrollButton) {
        scrollTopButton.classList.remove("hidden");
    } else {
        scrollTopButton.classList.add("hidden");
    }

    if (!isJegyekVisible) {
        scrollToTicketsButton.classList.remove("hidden");
    } else {
        scrollToTicketsButton.classList.add("hidden");
    }
});


// Az oldal tetejére ugrás funkció
function scrollToTop() {
    window.scrollTo({ top: 0, behavior: 'smooth' }); // Smooth görgetés tetejére
}

// A jegyek részhez ugrás funkció
function scrollToTickets() {
    const ticketsSection = document.getElementById("jegyek");
    ticketsSection.scrollIntoView({ behavior: 'smooth' }); // Smooth görgetés a jegyekhez
}
</script>









