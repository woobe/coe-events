<!-- DATALAYERPUSH-01 START -->
  <script>
/* ============================================================
   GA4 / GTM ECOMMERCE MERES
   ESEMENY: view_item_list

   Cel:
   Akkor kuldjuk el, amikor a fooldali jegyvalaszto szekcio
   legalabb 50%-ban lathatova valik.

   Fontos:
   - oldalbetoltesenkent csak egyszer futhat le
   - kozvetlen GA4 / Google Ads / Meta kodot NEM hivunk
   - csak window.dataLayer.push() tortenik
   - minden ecommerce esemeny elott ecommerce:null urites kell

   Merendo HTML elem:
   #jegyekbox

   Specifikacio:
   Cseh Gabor E.V. - GA4 Ecommerce dataLayer specifikacio v1.0
   ============================================================ */

(function () {

    var ticketSection = document.getElementById('jegyekbox');

    /* Ha az elem valamiert nem letezik, ne fusson tovabb. */
    if (!ticketSection) {
        return;
    }

    /* Biztonsagi flag: oldalankent csak egyszer kuldjuk el. */
    var viewItemListSent = false;

    var observer = new IntersectionObserver(function (entries) {

        var entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.1 && !viewItemListSent) {

            viewItemListSent = true;

            /* Az elozo ecommerce objektum kotelezo uritese. */
            window.dataLayer.push({
                ecommerce: null
            });

            /* Jegylista megtekintese. */
            window.dataLayer.push({
                event: 'view_item_list',
                ecommerce: {
                    currency: 'HUF',
                    item_list_id: 'jegyek_fooldal',
                    item_list_name: 'Jegyek – főoldal',
                    items: [
                        {
                            item_id: 'jegy_fesztivalozo',
                            item_name: 'Fesztiválozó jegy',
                            item_brand: 'Magyar Marketing Fesztivál',
                            item_category: 'Jegy',
                            item_category2: 'Fesztiválozó',
                            price: 24900,
                            quantity: 1,
                            index: 0
                        },
                        {
                            item_id: 'jegy_kapcsolatepito',
                            item_name: 'Kapcsolatépítő jegy',
                            item_brand: 'Magyar Marketing Fesztivál',
                            item_category: 'Jegy',
                            item_category2: 'Kapcsolatépítő',
                            price: 29900,
                            quantity: 1,
                            index: 1
                        },
                        {
                            item_id: 'jegy_premium',
                            item_name: 'PRÉMIUM+ jegy',
                            item_brand: 'Magyar Marketing Fesztivál',
                            item_category: 'Jegy',
                            item_category2: 'Prémium',
                            price: 49900,
                            quantity: 1,
                            index: 2
                        }
                    ]
                }
            });

            /* Nincs ra tobbet szukseg ezen az oldalbetoltesen. */
            observer.unobserve(ticketSection);
        }

    }, {
        threshold: 0.5
    });

    observer.observe(ticketSection);

})();
</script>
<!-- DATALAYERPUSH-01 END -->


        </div>
         
     </div>  
</div>



