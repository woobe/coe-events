<!-- ár és kupon számolás -->
<script>

$("form.ticketForm").each(function(){
  var form = $(this);
  var db = form.find("select[name='darab']");
  var kuponInfo = form.find(".kuponinfo");
  var kuponInput = form.find("input.kuponinput");
  var fizetendo = form.find("input.fizetendo");
  var ticketPrice = form.data("ticket-price");
  var discount = 0;
  var darab = 0;

  db.on("change", function(){
    darab = $(this).val();
    updatePrice();
  });

  var timer = null;
  kuponInput.on("input", function() {
    var kupon = $(this).val();
    clearTimeout(timer);
    timer = setTimeout(function(){
     $.post("kupon.php", {kupon: kupon, jegytipus: $("#jegytipus").val()}, function(data){
        
		if (data.error) {
		  kuponInfo.text("Érvénytelen kupon!");
		  discount = 0;

		  /* Analitika számára: nincs érvényes kupon */
		  form.data("coupon-valid", false);
		  form.data("coupon-code", "");
		  form.data("discount", 0);

		} else {
		  discount = data.ertek;

		  /* Analitika számára eltesszük az érvényes kupont */
		  form.data("coupon-valid", true);
		  form.data("coupon-code", kupon);
		  form.data("discount", discount);
		}
		
        updatePrice();
      });
    }, 1000);
  });

  function updatePrice() {
    var total = (ticketPrice - discount) * darab;
    fizetendo.val(total);
    if (discount > 0) {
      kuponInfo.text("A kupon érvényes. Kedvezmény: "+(discount*darab)+"Ft");
    }
  }
});


$("form.ticketFormVip").each(function(){
  var form = $(this);
  var db = form.find("select[name='darab']");
  var kuponInfo = form.find(".kuponinfo");
  var kuponInput = form.find("input.kuponinput");
  var fizetendo = form.find("input.fizetendo");
  var ticketPrice = form.data("ticket-price");
  var discount = 0;
  var darab = 0;

  db.on("change", function(){
    darab = $(this).val();
    updatePrice();
  });

  var timer = null;
  kuponInput.on("input", function() {
    var kupon = $(this).val();
    clearTimeout(timer);
    timer = setTimeout(function(){
		
		$.post("kupon.php", {kupon: kupon, jegytipus: form.find("#jegytipus").val()}, function(data){
        
		if (data.error) {
		  kuponInfo.text("Érvénytelen kupon!");
		  discount = 0;

		  /* Analitika számára: nincs érvényes kupon */
		  form.data("coupon-valid", false);
		  form.data("coupon-code", "");
		  form.data("discount", 0);

		} else {
		  discount = data.ertek;

		  /* Analitika számára eltesszük az érvényes kupont */
		  form.data("coupon-valid", true);
		  form.data("coupon-code", kupon);
		  form.data("discount", discount);
		}
		
        updatePrice();
      });
    }, 1000);
  });

  function updatePrice() {
    var total = (ticketPrice - discount) * darab;
    fizetendo.val(total);
    if (discount > 0) {
      kuponInfo.text("A kupon érvényes. Kedvezmény: "+(discount*darab)+"Ft");
    }
  }
});

function numberWithSpaces2(x) {
    return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ");
}

