#c26bf .gform_wrapper input[type=text],#c26bf .gform_wrapper input[type=email],#c26bf .gform_wrapper input[type=tel],#c26bf .gform_wrapper select{width:100%;border:1px solid #c9c3be!important;height:46px!important;padding:0 16px!important;font-size:15px!important;border-radius:14px!important;background-color:#fff!important;color:#000!important;box-shadow:none!important;font-family:"DM Sans",system-ui,sans-serif!important}
