  var COL = ['#6B7482', '#6B7482', '#ED6129', '#73877B', '#000000'];
  var FIG = [['bowl','bowl','sq'], ['ci','bowl','bowl'], ['ci','sq'], ['bowl','bowl','arch'], ['bowl','arch']];

