    var keses = T0 - START;
    MAX = Math.max(700, 1650 - Math.max(0, keses - 600));
    MIN = Math.min(MIN, MAX);
    L.classList.add('is-indul');
    morfT = setTimeout(function(){ figura(++n); morfI = setInterval(function(){ figura(++n); }, 300); }, 950);
    setTimeout(probal, MIN);
    setTimeout(probal, MAX);
  }

  for (var e = 0; e < ESEM.length; e++) window.addEventListener(ESEM[e], kihagy, { capture: true, passive: true });
