#c26bf-badge{position:fixed;left:24px;bottom:80px;z-index:999997;width:88px;height:88px;border-radius:50%;background:#ED6129;color:#fff;border:0;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
 font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;font-weight:700;font-size:25px;letter-spacing:-.02em;line-height:1;box-shadow:0 8px 24px rgba(237,97,41,.45);cursor:pointer;transition:transform .3s,opacity .3s}
#c26bf-badge small{font-family:"DM Sans",sans-serif;font-size:9px;letter-spacing:.1em;font-weight:700;margin-top:4px}
#c26bf-badge::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:2px solid #ED6129;opacity:.5;animation:c26p 2.2s infinite}
@keyframes c26p{0%{transform:scale(.92);opacity:.6}100%{transform:scale(1.25);opacity:0}}
#c26bf-badge.hide{opacity:0;transform:scale(.5);pointer-events:none;visibility:hidden}
#c26bf-badge.hide::after{animation:none}
