  ['c26-loader', 'c26b-loader', 'c26v3-betolto'].forEach(function(id){
    var el = document.getElementById(id); if (el && el.parentNode) el.parentNode.removeChild(el);
  });
  d.classList.add('c26v4');

  // Munkamenet: az első oldalmegnyitás (betöltő) vagy belső oldalváltás (gyors mód)?
  var KULCS = 'c26v4-alap-volt', volt = false;
  try { volt = sessionStorage.getItem(KULCS) === '1'; sessionStorage.setItem(KULCS, '1'); } catch (e) { volt = false; }
  var belso = false;
  try { belso = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (e) {}
  if (/[?&]c26betolto=1(&|$)/.test(q)) { volt = false; belso = false; }   // tesztelőnek: betöltő kikényszerítése
  d.classList.add(volt || belso ? 'c26v4-gyors' : 'c26v4-elso');

