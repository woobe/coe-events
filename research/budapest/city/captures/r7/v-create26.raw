    '<path d="M1527.2,472.6c0-15.7,11.1-25.9,31.4-25.9c19.3,0,31.4,9.4,31.4,24.3c0,11.3-6.9,17.9-26.5,25.6c-11.8,4.5-19.8,10-19.8,16h47.8v14.1h-65.9v-11c0-12.9,11.5-24.6,31.8-32.6c12.4-4.9,16-7.5,16-12.1c0-6.1-5.2-9.4-14.9-9.4s-14.9,4.9-14.9,11H1527.2z"/>' +
    '<path d="M1638.9,477.3c19.5,0,32.2,9.9,32.2,25.1c0,15.8-13,25.9-33.7,25.9c-24.2,0-36.9-14.6-36.9-40.8c0-25.9,13.3-40.8,36.2-40.8c18.8,0,31.2,9.6,31.2,24.3h-16.5c0-5.6-6-9.4-14.7-9.4c-12.2,0-18.5,7.1-19.6,21.5C1622.6,480,1630,477.3,1638.9,477.3z M1654.6,502.4c0-7.1-6.4-11-18.5-11c-7.4,0-13.6,3.1-18.2,6.3c2.2,10.7,8.3,15.7,19.6,15.7C1647.9,513.4,1654.6,509,1654.6,502.4z"/>' +
    '<path d="M400.7,561.5h41.5c-7.8,49.2-47.3,83.3-99.6,83.3c-58.1,0-100.8-42.6-100.8-100.8c0-58.1,42.6-100.8,100.8-100.8c52.3,0,91.9,34.1,99.6,83.3h-41.5c-6.6-27.9-29.1-46.5-58.1-46.5c-34.9,0-60.1,27.1-60.1,64c0,36.8,25.2,64,60.1,64C371.6,608,394.1,589,400.7,561.5z"/>' +
    '<path d="M467.8,447.1h139.5c34.9,0,58.1,23.3,58.1,58.1c0,31-20.2,52.7-50.8,55.8c2.7,3.1,5.4,6.6,7,9.3l43.8,70.5h-43.8l-49.2-79.5h-65.9v79.5h-38.8V447.1z M607.4,526.6c11.6,0,19.4-7.8,19.4-19.4v-5.8c0-11.6-7.8-19.4-19.4-19.4H506.6v44.6H607.4z"/>' +
    '<path d="M728.6,482v44.6H841v34.9H728.6V606h151.2v34.9H689.9V447.1h189.9V482H728.6z"/>' +
    '<path d="M895.6,640.9L975,447.1h58.1l79.5,193.8h-39l-32.9-78.4h-71L937.9,641L895.6,640.9z M1024.8,526.7l-19.1-44.7h-3.9l-17.8,44.7H1024.8z"/>' +
    '<path d="M1080.5,447.1h193.8V482h-77.5v158.9H1158V482h-77.5V447.1z"/>' +
    '<path d="M1344.6,482v44.6H1457v34.9h-112.4V606h151.2v34.9h-189.9V447.1h189.9V482H1344.6z"/>' +
    '</svg>';

