    var keses = T0 - START;
    MIN = Math.max(900, MIN - Math.max(0, keses - 400));
    MAX = Math.max(MIN, MAX - Math.max(0, keses - 400));
    // V1 időzítés: a formák alulról felfelé esnek be (120 ms + 170 ms-onként), 600 ms-onként új figura, 650 ms: logó
    for (var i = slots.length - 1, j = 0; i >= 0; i--, j++) (function(s, k){ ido(function(){ s.classList.add('c26v4-alap-be'); }, 120 + k * 170); })(slots[i], j);
    morf = setInterval(function(){ fig(++n); }, 600);
    ido(function(){ L.classList.add('c26v4-alap-szo'); }, 650);
    setTimeout(probal, MIN);
    setTimeout(probal, MAX);
  }

  for (var e = 0; e < ESEM.length; e++) window.addEventListener(ESEM[e], kihagy, { capture: true, passive: true });
  if (!domKesz) document.addEventListener('DOMContentLoaded', function(){ domKesz = true; probal(); }, { once: true });
  if (!betoltve) window.addEventListener('load', function(){ betoltve = true; probal(); }, { once: true });

