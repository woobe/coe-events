<!-- CREATE26 animációk – TESZT (csak ?c26anim=1 után látszik). Kikapcsolás: Snippets > CREATE26 animációk (TESZT) > Deactivate -->
<script>
(function(){
  var C26_LIVE = false;
  try{
    var q = location.search;
    if(q.indexOf('c26anim=1')>-1) localStorage.setItem('c26anim','1');
    if(q.indexOf('c26anim=0')>-1) localStorage.removeItem('c26anim');
    var on = C26_LIVE || localStorage.getItem('c26anim')==='1';
  }catch(e){ var on = C26_LIVE; }
  if(!on || /wp-admin|customize|elementor|action=edit/.test(location.href)) return;
  var d = document.documentElement;
  d.classList.add('c26a');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var seen = false; try{ seen = sessionStorage.getItem('c26loader')==='1'; }catch(e){}
  if(!reduce && !seen) d.classList.add('c26-loading');
  window.__c26 = { reduce: reduce };
})();
</script>
<style>
html.c26-loading body{ overflow:hidden; }
html.c26-loading::before{ content:""; position:fixed; inset:0; background:#EBE7E4; z-index:99998; }
#c26-loader{ position:fixed; inset:0; z-index:99999; background:#EBE7E4; display:grid; place-items:center; clip-path:circle(150% at 50% 50%); transition:clip-path .9s cubic-bezier(.7,0,.2,1); }
#c26-loader.done{ clip-path:circle(0% at 50% 46%); pointer-events:none; }
#c26-loader .stk{ display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:240px; }
#c26-loader .sl{ width:96px; height:48px; background:#6B7482; transform:translateY(-120vh); transition:height .55s cubic-bezier(.5,0,.2,1.4), border-radius .55s ease, background .55s ease, transform .55s ease, opacity .35s ease; }
#c26-loader .sl.in{ transform:none; }
#c26-loader.burst .sl{ opacity:0; }
#c26-loader img{ width:180px; margin-top:28px; opacity:0; transform:translateY(10px); transition:.5s ease .2s; }
#c26-loader.word img{ opacity:1; transform:none; }
html.c26a .c26-r{ opacity:0; transform:translateY(40px); transition:opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
html.c26a .c26-r.c26-in{ opacity:1; transform:none; }
html.c26a .c26-w{ display:inline-block; overflow:hidden; vertical-align:bottom; }
html.c26a .c26-w > span{ display:inline-block; transform:translateY(105%); transition:transform .7s cubic-bezier(.2,.8,.2,1); }
html.c26a .c26-split.c26-in .c26-w > span{ transform:none; }
html.c26a .c26-img{ clip-path:inset(16% 16% 16% 16% round 200px); transition:clip-path 1.1s cubic-bezier(.6,0,.2,1); }
html.c26a .c26-img.c26-in{ clip-path:inset(0 0 0 0 round 0px); }
html.c26a .c26-img img{ transform:scale(1.12); transition:transform 1.6s cubic-bezier(.2,.7,.2,1); }
html.c26a .c26-img.c26-in img{ transform:scale(1); }
html.c26a .c26-pop{ transform:scale(0) rotate(-30deg); transition:transform .7s cubic-bezier(.3,1.6,.4,1); }
html.c26a .c26-pop.c26-in{ transform:none; }
html.c26a .c26-shape{ position:absolute; z-index:0; pointer-events:none; will-change:transform; opacity:.9; }
html.c26a .c26-host{ position:relative; overflow:hidden; }
html.c26a .c26-host > .kt-row-column-wrap{ position:relative; z-index:1; }
html.c26a .c26-iconbg{ position:relative; }
html.c26a .c26-iconbg::before{ content:""; position:absolute; width:64px; height:64px; left:50%; top:50%; transform:translate(-50%,-50%) scale(0); z-index:-1; background:#EBE7E4; border-radius:50%; transition:transform .6s cubic-bezier(.3,1.6,.4,1); }
html.c26a .c26-iconbg.c26-s2::before{ border-radius:0; }
html.c26a .c26-iconbg.c26-s3::before{ border-radius:32px 32px 0 0; }
html.c26a .c26-iconbg.c26-in::before{ transform:translate(-50%,-50%) scale(1); }
#c26-progress{ position:fixed; top:0; left:0; height:3px; width:100%; transform-origin:0 50%; transform:scaleX(0); background:#ED6129; z-index:9999; pointer-events:none; }
@media (prefers-reduced-motion: reduce){ html.c26a .c26-r, html.c26a .c26-w > span, html.c26a .c26-pop{ opacity:1 !important; transform:none !important; transition:none !important; } html.c26a .c26-img{ clip-path:none !important; } }
</style>
<script>
document.addEventListener('DOMContentLoaded', function(){
  if(!document.documentElement.classList.contains('c26a')) return;
  var reduce = window.__c26.reduce;
  var logo = 'https://create26.hu/wp-content/uploads/2024/06/create26.svg';
  if(document.documentElement.classList.contains('c26-loading')){
    var L = document.createElement('div'); L.id='c26-loader'; L.setAttribute('aria-hidden','true');
    L.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center"><div class="stk"></div><img alt="" src="'+logo+'"></div>';
    document.body.appendChild(L);
    var stk = L.querySelector('.stk'), slots=[];
    for(var i=0;i<3;i++){ var s=document.createElement('div'); s.className='sl'; stk.appendChild(s); slots.push(s); }
    var SH = { sq:[48,'0'], ci:[96,'50%'], bowl:[48,'0 0 48px 48px'], arch:[96,'48px 48px 0 0'] };
    var COL = ['#6B7482','#6B7482','#ED6129','#73877B','#000000'];
    var FIG = [['bowl','bowl','sq'],['ci','bowl','bowl'],['ci','sq'],['bowl','bowl','arch'],['bowl','arch']];
    function fig(n){ var f=FIG[n%FIG.length]; slots.forEach(function(s,i){ var k=f[i]; if(!k){ s.style.height='0'; s.style.opacity='0'; return; } s.style.opacity='1'; s.style.height=SH[k][0]+'px'; s.style.borderRadius=SH[k][1]; s.style.background=COL[(n+i)%COL.length]; }); }
    fig(0);
    slots.slice().reverse().forEach(function(s,i){ setTimeout(function(){ s.classList.add('in'); }, 120+i*170); });
    var n=0, t=setInterval(function(){ fig(++n); }, 600);
    setTimeout(function(){ L.classList.add('word'); }, 650);
    var t0=Date.now(), ended=false;
    function end(){ if(ended) return; ended=true; setTimeout(function(){ clearInterval(t); L.classList.add('burst'); setTimeout(function(){ L.classList.add('done'); document.documentElement.classList.remove('c26-loading'); try{sessionStorage.setItem('c26loader','1');}catch(e){} }, 220); setTimeout(function(){ L.remove(); }, 1300); }, Math.max(0, 2200-(Date.now()-t0))); }
    if(document.readyState==='complete') end(); else window.addEventListener('load', end, {once:true});
    setTimeout(end, 6000);
  }
  if(reduce) return;
  var main = document.querySelector('#main') || document.querySelector('main') || document.body;
  var skip = '.kb-gallery-wrap-id-1203_d37aca-3f, .ti-widget, header, footer, .site-header, .site-footer, #c26-loader';
  function ok(el){ return !el.closest(skip); }
  function mark(sel, cls){ main.querySelectorAll(sel).forEach(function(el){ if(ok(el)) el.classList.add(cls); }); }
  main.querySelectorAll('h1, h2').forEach(function(h){
    if(!ok(h) || h.children.length || h.textContent.length > 90) return; var cs=getComputedStyle(h); if(/text/.test(cs.webkitBackgroundClip||cs.backgroundClip||'') || cs.color==='rgba(0, 0, 0, 0)') return;
    var w = h.textContent.trim().split(/\s+/);
    h.innerHTML = w.map(function(x,i){ return '<span class="c26-w"><span style="transition-delay:'+(i*55)+'ms">'+x.replace(/</g,'&lt;')+'</span></span>'; }).join(' ');
    h.classList.add('c26-split');
  });
  mark('.wp-block-kadence-advancedheading:not(h1):not(h2), .wp-block-kadence-advancedbtn, .wp-block-kadence-infobox, .wp-block-kadence-iconlist, .wp-block-kadence-posts article', 'c26-r');
  mark('.wp-block-kadence-image, .wp-block-image', 'c26-img');
  var k=0;
  main.querySelectorAll('img').forEach(function(im){
    if(!ok(im)) return;
    var w = im.getAttribute('width')|0, src = im.getAttribute('src')||'';
    if((w && w<=80) || /\/(community|Edit|location|247|Coffee|bike|playroom|approve-chat)\.png/.test(src)){
      var box = im.closest('figure') || im.parentElement;
      box.classList.remove('c26-img'); box.classList.add('c26-iconbg', 'c26-s'+(1+(k++%3)));
      im.classList.add('c26-pop');
    }
  });
  main.querySelectorAll('.kt-row-column-wrap').forEach(function(row){
    Array.prototype.forEach.call(row.children, function(col,i){ col.querySelectorAll('.c26-r, .c26-img').forEach(function(el){ el.style.transitionDelay = (i*110)+'ms'; }); });
  });
  var SHAPES = ['<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#ED6129"/></svg>','<svg viewBox="0 0 100 50"><path d="M0 0H100A50 50 0 0 1 0 0Z" fill="#73877B"/></svg>','<svg viewBox="0 0 100 100"><rect width="100" height="100" fill="#6B7482"/></svg>','<svg viewBox="0 0 100 100"><path d="M0 100V50A50 50 0 0 1 100 50V100Z" fill="#ED6129"/></svg>','<svg viewBox="0 0 100 100"><path d="M50 0A50 50 0 0 1 50 100Z" fill="#6B7482"/><path d="M50 0A50 50 0 0 0 50 100Z" fill="#73877B"/></svg>'];
  var floats=[], idx=0;
  main.querySelectorAll('.kb-row-layout-wrap').forEach(function(row){
    if(!ok(row) || row.parentElement.closest('.kb-row-layout-wrap') || row.offsetHeight < 260) return;
    if((idx++) % 2) return;
    row.classList.add('c26-host');
    var j=floats.length, sz=[110,150,90,130,120][j%5], left=j%2===0;
    var f=document.createElement('div'); f.className='c26-shape'; f.setAttribute('aria-hidden','true');
    f.style.width=sz+'px'; f.style.top='12%'; f.style[left?'left':'right']='-'+Math.round(sz*0.35)+'px';
    f.innerHTML=SHAPES[j%SHAPES.length]; row.appendChild(f); floats.push({el:f,row:row,sp:(left?0.18:-0.18)});
  });
  var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('c26-in'); io.unobserve(e.target); } }); }, { threshold:.15, rootMargin:'0px 0px -6% 0px' });
  main.querySelectorAll('.c26-r, .c26-img, .c26-split, .c26-pop, .c26-iconbg').forEach(function(el){ io.observe(el); });
  var bar=document.createElement('div'); bar.id='c26-progress'; bar.setAttribute('aria-hidden','true'); document.body.appendChild(bar);
  var ticking=false;
  function frame(){ ticking=false; var y=scrollY, H=document.documentElement.scrollHeight-innerHeight; bar.style.transform='scaleX('+(H>0?y/H:0)+')'; floats.forEach(function(f){ var r=f.row.getBoundingClientRect(); if(r.bottom<0||r.top>innerHeight) return; f.el.style.transform='translateY('+(r.top*f.sp)+'px) rotate('+(r.top*f.sp*0.25)+'deg)'; }); }
  addEventListener('scroll', function(){ if(!ticking){ ticking=true; requestAnimationFrame(frame); } }, {passive:true});
  frame();
});
</script>
