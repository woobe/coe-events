<button type="button" id="c26bf-badge" class="hide" aria-label="Black Friday: 26% off your membership – open offer"><span>−26%</span><small>BLACK FRIDAY</small></button>
<script id="c26bf-js">
(function(){
var VEGE=Date.UTC(2026,10,27,23,0,0); // 2026-11-28 00:00 Europe/Budapest
var ids=['c26bf','c26bf-ov','c26bf-badge','c26bf-css'];
if(Date.now()>=VEGE){ids.forEach(function(i){var e=document.getElementById(i);if(e)e.remove();});return;}
var AUTO=false;
if(AUTO)document.documentElement.classList.add('c26bf-aktiv');
var PCT="OFF MEMBERSHIP",PCTFS=".062";
var OR='#ED6129',W='#ffffff',G='#606a72',NS='http://www.w3.org/2000/svg';
function C(cx,cy){return 'M'+(cx-.5)+','+cy+'A.5,.5 0 1 1 '+(cx+.5)+','+cy+'A.5,.5 0 1 1 '+(cx-.5)+','+cy+'Z';}
var S=[[C(.5,.5),W,'bf',.5,.5],['M1.5,0A.5,.5 0 0 0 1.5,1Z',W],[C(2,.5),OR,'pct',2,.5],['M4,0H3A.5,.5 0 0 0 3,1H4Z',G],
 ['M0,1H1A.5,.5 0 0 1 1,2H0Z',G],[C(2,1.5),W],['M2.5,1A.5,.5 0 0 1 2.5,2Z',W],[C(3.5,1.5),W]];
function txt(x,y,s,fam,fs,fill,ls){var t=document.createElementNS(NS,'text');t.setAttribute('x',x);t.setAttribute('y',y);t.setAttribute('text-anchor','middle');t.setAttribute('font-family',fam);t.setAttribute('font-weight','700');t.setAttribute('font-size',fs);t.setAttribute('fill',fill);if(ls)t.setAttribute('letter-spacing',ls);t.textContent=s;return t;}
function build(svg,vert){
 if(!svg)return;
 var g=document.createElementNS(NS,'g');if(vert)g.setAttribute('transform','translate(2,0) rotate(90)');
 var lab=[];var HN='Helvetica Neue,Helvetica,Arial';
 S.forEach(function(s){var p=document.createElementNS(NS,'path');p.setAttribute('d',s[0]);p.setAttribute('fill',s[1]);g.appendChild(p);
  if(s[2]){var cx=s[3],cy=s[4];if(vert){var nx=2-cy,ny=cx;cx=nx;cy=ny;}
   if(s[2]==='pct'){lab.push(txt(cx,cy+.03,'−26%',HN,'.27','#fff','-.01'));lab.push(txt(cx,cy+.2,PCT,'DM Sans',PCTFS,'#fff','.005'));}
   else{lab.push(txt(cx,cy-.02,'Black',HN,'.15','#000'));lab.push(txt(cx,cy+.14,'Friday',HN,'.15','#000'));}}
 });
 svg.appendChild(g);lab.forEach(function(l){svg.appendChild(l);});
}
build(document.getElementById('c26bf-sv'),true);build(document.getElementById('c26bf-sh'),false);
var pop=document.getElementById('c26bf'),ov=document.getElementById('c26bf-ov'),bd=document.getElementById('c26bf-badge'),x=document.getElementById('c26bf-x');
var KEY='c26bf2026_latta',tar=null;
try{tar=window.localStorage;tar.setItem('c26bf_t','1');tar.removeItem('c26bf_t');}catch(e){tar=null;}
var nyitva=false,elozo=null,wct=0;
function wc(){pop.style.willChange='transform,opacity';clearTimeout(wct);wct=setTimeout(function(){pop.style.willChange='';},400);}
function close(){if(!nyitva)return;nyitva=false;document.documentElement.classList.remove('c26bf-nyitva');pop.classList.add('closed');pop.setAttribute('aria-hidden','true');ov.classList.remove('on');wc();setTimeout(function(){bd.classList.remove('hide');var sc=pop.querySelector('.sc');if(sc)sc.scrollTop=0;},250);if(elozo&&elozo.focus)try{elozo.focus();}catch(e){}}
function open(){nyitva=true;wc();document.documentElement.classList.add('c26bf-nyitva');elozo=document.activeElement;bd.classList.add('hide');pop.classList.remove('closed');pop.setAttribute('aria-hidden','false');ov.classList.add('on');setTimeout(function(){try{x.focus({preventScroll:true});}catch(e){}},60);}
window.c26bfOpen=open;window.c26bfClose=close;
x.addEventListener('click',close);ov.addEventListener('click',close);bd.addEventListener('click',open);
document.addEventListener('keydown',function(e){if(nyitva&&(e.key==='Escape'||e.keyCode===27))close();});
var latta=false;if(tar){try{latta=!!tar.getItem(KEY);}catch(e){latta=true;}}else{latta=true;}
if(latta||!AUTO){bd.classList.remove('hide');}
else{setTimeout(function(){try{tar.setItem(KEY,String(Date.now()));}catch(e){}open();},7000);}
})();
</script>
		<div  id="cart-drawer" class="popup-drawer popup-drawer-layout-sidepanel popup-drawer-side-right popup-mobile-drawer-side-right" data-drawer-target-string="#cart-drawer">
