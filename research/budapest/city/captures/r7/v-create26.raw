  var l=document.createElement('link'); l.rel='stylesheet'; l.href='https://create26.hu/?c26v2asset=css&v=2.0.6'; document.head.appendChild(l);
  var s=document.createElement('script'); s.src='https://create26.hu/?c26v2asset=js&v=2.0.6'; s.async=true; s.setAttribute('data-cookieconsent','ignore'); document.head.appendChild(s);
