  if (window.requestAnimationFrame) requestAnimationFrame(function(){ requestAnimationFrame(indul); });
  setTimeout(indul, 1200);                                    // ha a rAF nem jönne (pl. háttérlap)

  // biztonsági időkorlát: mindenképp eltűnik (a CSS-ben 5 s-os vészfék is van)
  setTimeout(function(){ ki(true); }, 3600);
  setTimeout(torol, 4600);
  window.addEventListener('pageshow', function(ev){ if (ev.persisted) { ki(true); torol(); } });
})();
</script>
