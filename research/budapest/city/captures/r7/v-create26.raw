<style id="c26v3-betolto-css">
/* CREATE26 animációk V3 – BETÖLTŐ modul (TESZT)
   Hely: INLINE a <head>-ben, a betolto.js ELŐTT. Csak html.c26v3 alatt hat.
   A JS a --c26v3-betolto-css jelzőváltozóból tudja, hogy a CSS jelen van és a feltételek
   (nincs reduced-motion, a böngésző támogatja) teljesülnek; ha nincs, a betöltő nem indul. */
@media (prefers-reduced-motion: no-preference){
@supports (inset:0) and (aspect-ratio:1/1){

html.c26v3{--c26v3-betolto-css:1}

html.c26v3 #c26v3-betolto{
  --u:46px;
  position:fixed;inset:0;z-index:2147483000;overflow:hidden;contain:strict;
  pointer-events:auto;cursor:pointer;-webkit-tap-highlight-color:transparent;
  /* CSS-vészfék: ha a JS bármiért elakadna, 5 s után mindenképp eltűnik */
  animation:c26v3-betolto-veszfek .01s linear 5s forwards;
}
@media (max-width:600px){ html.c26v3 #c26v3-betolto{--u:34px} }
html.c26v3 #c26v3-betolto.is-ki{pointer-events:none;cursor:auto}
@keyframes c26v3-betolto-veszfek{to{opacity:0;visibility:hidden}}

/* ---- függöny: két réteg függőleges panel, félkör éllel ---- */
html.c26v3 .c26v3-betolto-fuggony{position:absolute;inset:0;display:flex;z-index:1}
html.c26v3 .c26v3-betolto-fuggony.c26v3-betolto-elol{z-index:2}
html.c26v3 .c26v3-betolto-panel{
  display:block;position:relative;flex:1 1 0;height:100%;margin-right:-1px;
  background:var(--szin,#EBE7E4);will-change:transform;
  transition:transform .58s cubic-bezier(.76,0,.24,1);transition-delay:var(--k,0ms);
}
html.c26v3 .c26v3-betolto-panel::after{content:"";position:absolute;left:0;right:0;aspect-ratio:2/1;background:inherit}
html.c26v3 .c26v3-betolto-fel::after{top:calc(100% - 1px);border-radius:0 0 50% 50%/0 0 100% 100%}
html.c26v3 .c26v3-betolto-le::after{bottom:calc(100% - 1px);border-radius:50% 50% 0 0/100% 100% 0 0}
html.c26v3 #c26v3-betolto.is-ki .c26v3-betolto-fel{transform:translate3d(0,calc(-100% - 14vw),0)}
html.c26v3 #c26v3-betolto.is-ki .c26v3-betolto-le{transform:translate3d(0,calc(100% + 14vw),0)}
html.c26v3 #c26v3-betolto.is-gyors .c26v3-betolto-panel{transition-duration:.42s}

/* ---- színpad: forma-„emberek” + logó ---- */
html.c26v3 .c26v3-betolto-szinpad{
  position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:calc(var(--u)*.7);padding-bottom:4vh;
}
html.c26v3 .c26v3-betolto-csoport{display:flex;align-items:flex-end;gap:calc(var(--u)*.22);height:calc(var(--u)*3)}
html.c26v3 .c26v3-betolto-oszlop{display:flex;flex-direction:column-reverse;width:var(--u)}
html.c26v3 .c26v3-betolto-cella{position:relative;width:var(--u);height:var(--u);opacity:0}
html.c26v3 #c26v3-betolto.is-indul .c26v3-betolto-cella{
  opacity:1;will-change:transform;
  animation:c26v3-betolto-esik .5s cubic-bezier(.34,1.45,.55,1) backwards;animation-delay:var(--e,0ms);
}
@keyframes c26v3-betolto-esik{from{transform:translate3d(0,-62vh,0) rotate(var(--fr,-25deg))}to{transform:none}}
html.c26v3 #c26v3-betolto.is-ki .c26v3-betolto-cella{
  animation:none;opacity:0;
  transform:translate3d(var(--dx,0),var(--dy,0),0) rotate(var(--dr,90deg)) scale(.4);
  transition:transform .5s cubic-bezier(.55,0,.8,.35),opacity .35s ease .12s;
}
html.c26v3 .c26v3-betolto-forma{
  position:absolute;inset:0;background:#6B7482;opacity:0;
  transform:scale(0) rotate(-90deg);
  transition:transform .42s cubic-bezier(.3,1.5,.5,1),opacity .2s ease;
}
html.c26v3 .c26v3-betolto-forma.is-be{opacity:1;transform:none}
html.c26v3 .c26v3-betolto-o{background:#ED6129}
html.c26v3 .c26v3-betolto-z{background:#73877B}
/* formák: k = kör, n = négyzet, f = ív (felül kerek), t = tál (alul kerek), q / p = negyedkör */
html.c26v3 .c26v3-betolto-s-k{border-radius:50%}
html.c26v3 .c26v3-betolto-s-n{border-radius:0}
html.c26v3 .c26v3-betolto-s-f{border-radius:50% 50% 0 0}
html.c26v3 .c26v3-betolto-s-t{border-radius:0 0 50% 50%}
html.c26v3 .c26v3-betolto-s-q{border-radius:100% 0 0 0}
html.c26v3 .c26v3-betolto-s-p{border-radius:0 100% 0 0}

html.c26v3 .c26v3-betolto-logo{display:block;width:clamp(150px,22vw,210px);color:#000;overflow:hidden;padding:2px 0}
html.c26v3 .c26v3-betolto-logo svg{
  display:block;width:100%;height:auto;transform:translate3d(0,115%,0);
  transition:transform .6s cubic-bezier(.2,.8,.2,1) .6s;
}
html.c26v3 #c26v3-betolto.is-indul .c26v3-betolto-logo svg{transform:none}
html.c26v3 #c26v3-betolto.is-ki .c26v3-betolto-logo svg{
  transform:translate3d(0,-115%,0);transition:transform .34s cubic-bezier(.6,0,.8,.3) 0s;
}

}
}
</style>
<script nowprocket data-no-optimize="1" data-cookieconsent="ignore">
/* CREATE26 animációk V3 – BETÖLTŐ modul (TESZT)
   Hely: TELJES EGÉSZÉBEN INLINE a <head>-ben, a betolto.css UTÁN és a c26v3 kapcsoló-szkript UTÁN.
   A <script> címkén: nowprocket data-no-optimize="1" data-cookieconsent="ignore"
   (különben a WP Rocket késlelteti, a Cookiebot pedig blokkolhatja). Footerbe nem kell semmi.
   Kifelé: a futás alatt html.c26v3-betolto-fut osztály; a kilépés elején a document-en
   'c26v3:betolto-vege' esemény (a hero-belépő ehhez igazodhat). */
(function(){
  'use strict';
  var D = document.documentElement;
  if (!D.classList.contains('c26v3')) return;
  if (document.getElementById('c26v3-betolto')) return;

  var MINDEN_BETOLTESNEL = true;           // teszt: minden oldalbetöltésnél fut; false = munkamenetenként egyszer
  var KULCS = 'c26v3-betolto';
  try {
    if (/[?&]c26betolto=0/.test(location.search)) return;   // fejlesztői kikapcsoló
    if (!MINDEN_BETOLTESNEL && sessionStorage.getItem(KULCS)) return;
  } catch (e) {}
  if (document.visibilityState === 'hidden') return;          // háttérlapon / előtöltéskor nem fut
  try {
    // a CSS jelzőváltozója: csak akkor van, ha a CSS betöltődött, nincs reduced-motion és van támogatás
    if (!getComputedStyle(D).getPropertyValue('--c26v3-betolto-css')) return;
  } catch (e) { return; }

  var most = (window.performance && performance.now) ? function(){ return performance.now(); } : function(){ return Date.now(); };
  var START = most();

  // --- formák és figurák (oszloponként alulról felfelé; k kör, n négyzet, f ív, t tál, q/p negyedkör) ---
  var FIG = [
    { f: [['n','t'], ['n','t','k'], ['q','k']],       o: [1,2], z: [0,0] },
    { f: [['t','t'], ['f','n','k'], ['n','f']],       o: [0,1], z: [2,0] },
    { f: [['k','k'], ['t','f','k'], ['p','t']],       o: [2,1], z: [1,0] },
    { f: [['n','f'], ['f','t','t'], ['f','k']],       o: [1,0], z: [2,1] }
  ];
  var HATSO = ['#6B7482', '#ED6129', '#73877B', '#6B7482', '#000000', '#ED6129', '#73877B'];

  var W = window.innerWidth || D.clientWidth || 1024;
  var N = W < 600 ? 4 : (W < 1100 ? 5 : 7);

  function panelek(hatso){
    var h = '';
    for (var i = 0; i < N; i++) {
      var tav = Math.abs(i - (N - 1) / 2);
      var k = Math.round(100 + tav * 35 + (hatso ? 90 : 0));
      var szin = hatso ? HATSO[i % HATSO.length] : '#EBE7E4';
      h += '<i class="c26v3-betolto-panel ' + (i % 2 ? 'c26v3-betolto-le' : 'c26v3-betolto-fel') +
           '" style="--k:' + k + 'ms;--szin:' + szin + '"></i>';
    }
    return h;
  }

  var csoport = '';
  for (var c = 0; c < 3; c++) {
    csoport += '<span class="c26v3-betolto-oszlop">';
    for (var r = 0; r < 3; r++) {
      var sz = (c * 3 + r) * 47 % 360;                          // determinisztikus „szórás” a kilépéshez
      var dx = Math.round(Math.cos(sz * Math.PI / 180) * 38) + 'vw';
      var dy = Math.round(Math.sin(sz * Math.PI / 180) * 34 - 6) + 'vh';
      csoport += '<span class="c26v3-betolto-cella" style="--e:' + (40 + c * 80 + r * 90) + 'ms;--fr:' +
                 (c % 2 ? 25 : -25) + 'deg;--dx:' + dx + ';--dy:' + dy + ';--dr:' + (sz % 2 ? -1 : 1) * (90 + sz % 90) + 'deg">' +
                 '<span class="c26v3-betolto-forma"></span><span class="c26v3-betolto-forma"></span></span>';
    }
    csoport += '</span>';
  }

  var LOGO = '<svg viewBox="236 440 1440 208" aria-hidden="true" focusable="false" fill="currentColor">' +
    '<path d="M1527.2,472.6c0-15.7,11.1-25.9,31.4-25.9c19.3,0,31.4,9.4,31.4,24.3c0,11.3-6.9,17.9-26.5,25.6c-11.8,4.5-19.8,10-19.8,16h47.8v14.1h-65.9v-11c0-12.9,11.5-24.6,31.8-32.6c12.4-4.9,16-7.5,16-12.1c0-6.1-5.2-9.4-14.9-9.4s-14.9,4.9-14.9,11H1527.2z"/>' +
    '<path d="M1638.9,477.3c19.5,0,32.2,9.9,32.2,25.1c0,15.8-13,25.9-33.7,25.9c-24.2,0-36.9-14.6-36.9-40.8c0-25.9,13.3-40.8,36.2-40.8c18.8,0,31.2,9.6,31.2,24.3h-16.5c0-5.6-6-9.4-14.7-9.4c-12.2,0-18.5,7.1-19.6,21.5C1622.6,480,1630,477.3,1638.9,477.3z M1654.6,502.4c0-7.1-6.4-11-18.5-11c-7.4,0-13.6,3.1-18.2,6.3c2.2,10.7,8.3,15.7,19.6,15.7C1647.9,513.4,1654.6,509,1654.6,502.4z"/>' +
    '<path d="M400.7,561.5h41.5c-7.8,49.2-47.3,83.3-99.6,83.3c-58.1,0-100.8-42.6-100.8-100.8c0-58.1,42.6-100.8,100.8-100.8c52.3,0,91.9,34.1,99.6,83.3h-41.5c-6.6-27.9-29.1-46.5-58.1-46.5c-34.9,0-60.1,27.1-60.1,64c0,36.8,25.2,64,60.1,64C371.6,608,394.1,589,400.7,561.5z"/>' +
    '<path d="M467.8,447.1h139.5c34.9,0,58.1,23.3,58.1,58.1c0,31-20.2,52.7-50.8,55.8c2.7,3.1,5.4,6.6,7,9.3l43.8,70.5h-43.8l-49.2-79.5h-65.9v79.5h-38.8V447.1z M607.4,526.6c11.6,0,19.4-7.8,19.4-19.4v-5.8c0-11.6-7.8-19.4-19.4-19.4H506.6v44.6H607.4z"/>' +
    '<path d="M728.6,482v44.6H841v34.9H728.6V606h151.2v34.9H689.9V447.1h189.9V482H728.6z"/>' +
    '<path d="M895.6,640.9L975,447.1h58.1l79.5,193.8h-39l-32.9-78.4h-71L937.9,641L895.6,640.9z M1024.8,526.7l-19.1-44.7h-3.9l-17.8,44.7H1024.8z"/>' +
    '<path d="M1080.5,447.1h193.8V482h-77.5v158.9H1158V482h-77.5V447.1z"/>' +
    '<path d="M1344.6,482v44.6H1457v34.9h-112.4V606h151.2v34.9h-189.9V447.1h189.9V482H1344.6z"/>' +
    '</svg>';

  var L = document.createElement('div');
  L.id = 'c26v3-betolto';
  L.setAttribute('aria-hidden', 'true');
  L.innerHTML =
    '<div class="c26v3-betolto-fuggony">' + panelek(true) + '</div>' +
    '<div class="c26v3-betolto-fuggony c26v3-betolto-elol">' + panelek(false) + '</div>' +
    '<div class="c26v3-betolto-szinpad"><span class="c26v3-betolto-csoport">' + csoport + '</span>' +
    '<span class="c26v3-betolto-logo">' + LOGO + '</span></div>';
  // A <head>-ben még nincs <body>: a <html>-be kerül (a <body> elé), így az első képkockán már látszik.
  (document.body || D).appendChild(L);
  D.classList.add('c26v3-betolto-fut');

  // cellák: [oszlop][sor] = { a: [forma0, forma1], cur: 0 }
  var cellak = [], oszlopok = L.querySelectorAll('.c26v3-betolto-oszlop');
  for (var i = 0; i < oszlopok.length; i++) {
    var sorok = oszlopok[i].querySelectorAll('.c26v3-betolto-cella'), o = [];
    for (var j = 0; j < sorok.length; j++) o.push({ a: sorok[j].querySelectorAll('.c26v3-betolto-forma'), cur: 0 });
    cellak.push(o);
  }
  function figura(n, elso){
    var F = FIG[n % FIG.length];
    for (var c = 0; c < 3; c++) for (var r = 0; r < 3; r++) {
      var cell = cellak[c][r], kod = F.f[c][r], regi = cell.a[cell.cur], uj = cell.a[1 - cell.cur];
      if (!elso) regi.classList.remove('is-be');
      if (!kod) { if (elso) regi.className = 'c26v3-betolto-forma'; continue; }
      var cel = elso ? regi : uj;
      var szin = (F.o[0] === c && F.o[1] === r) ? ' c26v3-betolto-o' : ((F.z[0] === c && F.z[1] === r) ? ' c26v3-betolto-z' : '');
      cel.className = 'c26v3-betolto-forma c26v3-betolto-s-' + kod + szin + ' is-be';
      if (!elso) cell.cur = 1 - cell.cur;
    }
  }
  figura(0, true);

  var T0 = 0, indult = false, kesz = false, torolve = false, n = 0, morfT = 0, morfI = 0;
  var domKesz = document.readyState !== 'loading';
  var ESEM = ['pointerdown', 'keydown', 'wheel', 'touchstart'];

  function torol(){
    if (torolve) return; torolve = true;
    if (L.parentNode) L.parentNode.removeChild(L);
  }
  function ki(gyors){
    if (kesz) return; kesz = true;
    clearTimeout(morfT); clearInterval(morfI);
    for (var e = 0; e < ESEM.length; e++) window.removeEventListener(ESEM[e], kihagy, true);
    if (gyors) L.classList.add('is-gyors');
    L.classList.add('is-ki');
    D.classList.remove('c26v3-betolto-fut');
    try { if (!MINDEN_BETOLTESNEL) sessionStorage.setItem(KULCS, '1'); } catch (e2) {}
    try { document.dispatchEvent(new CustomEvent('c26v3:betolto-vege')); } catch (e3) {}
    setTimeout(torol, gyors ? 900 : 1150);
  }
  function kihagy(){ ki(true); }
  function probal(){
    if (!indult || kesz) return;
    var t = most() - T0;
    if ((t >= MIN && domKesz) || t >= MAX) ki(false);
  }
  var MIN = 1400, MAX = 1650;
  function indul(){
    if (indult || kesz) return; indult = true;
    T0 = most();
