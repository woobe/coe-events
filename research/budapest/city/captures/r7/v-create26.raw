	<!-- CREATE26 animációk V4 – TESZT (csak ?c26v4=1 után látszik). Kikapcsolás: ?c26v4=0, vagy Snippets > CREATE26 animációk V4 (TESZT) > Deactivate -->
<style id="c26v4-alap-css">
/* CREATE26 animációk V4 – ALAP modul (TESZT): V1-es betöltő + gyors oldalváltás
   Hely: TELJES EGÉSZÉBEN INLINE a <head> elején, <style id="c26v4-alap-css">, az alap.js ELŐTT.
   Csak html.c26v4 alatt hat (ezt a kapcsoló-szkript teszi fel) → kapcsoló nélkül semmit nem változtat.
   Az @view-transition szabályt NEM itt, hanem az alap.js kapcsolója szúrja be (at-rule nem köthető
   a html.c26v4 osztályhoz; így csak bekapcsolt állapotban él).
   A JS a --c26v4-alap-css jelzőváltozóból tudja, hogy a CSS jelen van, nincs reduced-motion
   és a böngésző támogatja a betöltőt; ha nincs, a betöltő nem indul (nincs stílus nélküli villanás). */

/* ---- gyors oldalváltás: rövid, finom áttűnés (csak ha az alap.js bekapcsolta) ---- */
html.c26v4::view-transition-group(root){animation-duration:.22s}
html.c26v4::view-transition-old(root),
html.c26v4::view-transition-new(root){animation-duration:.22s;animation-timing-function:cubic-bezier(.2,.7,.2,1)}

@media (prefers-reduced-motion: no-preference){
@supports (inset:0) and (clip-path:circle(10% at 50% 50%)){

html.c26v4{--c26v4-alap-css:1}

/* ---- V1 betöltő: bézs lap, egymásra eső és átalakuló formák (forma-„ember”), logó, kör alakú kilépés ---- */
html.c26v4 #c26v4-alap-betolto{
  position:fixed;inset:0;z-index:2147483000;           /* a BF-ablak (999999) fölött, a Cookiebot (2147483631) alatt */
  display:grid;place-items:center;background:#EBE7E4;
  contain:strict;overflow:hidden;cursor:pointer;-webkit-tap-highlight-color:transparent;
  clip-path:circle(150% at 50% 50%);
  transition:clip-path .9s cubic-bezier(.7,0,.2,1);
  /* CSS-vészfék: ha a JS bármiért elakadna, 5,5 s után mindenképp eltűnik */
  animation:c26v4-alap-veszfek .01s linear 5.5s forwards;
}
@keyframes c26v4-alap-veszfek{to{opacity:0;visibility:hidden;pointer-events:none}}
html.c26v4 #c26v4-alap-betolto.c26v4-alap-ki{clip-path:circle(0% at 50% 46%);pointer-events:none;cursor:auto}
html.c26v4 #c26v4-alap-betolto.c26v4-alap-gyorsan{transition-duration:.5s}

html.c26v4 .c26v4-alap-szinpad{display:flex;flex-direction:column;align-items:center}
html.c26v4 .c26v4-alap-oszlop{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:240px}
html.c26v4 .c26v4-alap-forma{
  display:block;width:96px;height:48px;background:#6B7482;
  transform:translate3d(0,-120vh,0);will-change:transform;
  transition:height .55s cubic-bezier(.5,0,.2,1.4),border-radius .55s ease,background-color .55s ease,
             transform .55s ease,opacity .35s ease;
}
html.c26v4 .c26v4-alap-forma.c26v4-alap-be{transform:none}
html.c26v4 #c26v4-alap-betolto.c26v4-alap-szet .c26v4-alap-forma{opacity:0}

html.c26v4 .c26v4-alap-logo{
  display:block;width:180px;margin-top:28px;color:#000;
  opacity:0;transform:translate3d(0,10px,0);transition:opacity .5s ease .2s,transform .5s ease .2s;
}
html.c26v4 .c26v4-alap-logo svg{display:block;width:100%;height:auto}
html.c26v4 #c26v4-alap-betolto.c26v4-alap-szo .c26v4-alap-logo{opacity:1;transform:none}

@media (max-width:600px){
  html.c26v4 .c26v4-alap-oszlop{height:200px}
  html.c26v4 .c26v4-alap-logo{width:156px}
}

}
}
</style>
<script nowprocket data-no-optimize="1" data-cookieconsent="ignore">
/* CREATE26 animációk V4 – ALAP modul (TESZT): kapcsoló + V1-es betöltő + közös keret (c26v4:ready)
   Hely: TELJES EGÉSZÉBEN INLINE a <head> lehető legelején (wp_head, prioritás 1), az alap.css <style>-ja UTÁN:
     script-elem (nowprocket, data-no-optimize="1", data-cookieconsent="ignore") → ez a fájl
   (nowprocket / data-no-optimize: a WP Rocket ne késleltesse; data-cookieconsent="ignore": a Cookiebot ne blokkolja.)
   Footerbe ebből a modulból NEM kell semmi. Három önálló IIFE, globális változó nincs
   (kivétel: window.__c26sp – a logósáv Splide-példányai, a V3-mal azonos szerződés).
   Részletek és a többi modulnak szóló szerződés: alap.md. */

/* ===== 1) KAPCSOLÓ: ?c26v4=1 bekapcsol, ?c26v4=0 kikapcsol; V1/V2/V3 kizárása; html.c26v4 ===== */
(function(){
  'use strict';
  var d = document.documentElement, q = location.search, on = false;
  function torolJelzo(k){
    try { localStorage.removeItem(k); } catch (e) {}
    try { document.cookie = k + '=; Max-Age=0; path=/; SameSite=Lax'; } catch (e) {}
  }
  function suti(k){ try { return new RegExp('(?:^|; )' + k + '=1(?:;|$)').test(document.cookie); } catch (e) { return false; } }

  // V1 (?c26anim=1), V2 (?c26v2=1), V3 (?c26v3=1) bekapcsolása vagy ?c26v4=0 → V4 ki
  if (/[?&](c26v4=0|c26anim=1|c26v2=1|c26v3=1)(&|$)/.test(q)) {
    torolJelzo('c26v4');
  } else if (/[?&]c26v4=1(&|$)/.test(q)) {
