    if (!on) on = suti('c26v4');                              // ha a localStorage tiltott/üres
  }
  if (!on || /wp-admin|wp-login|customize|action=edit|elementor|ct_builder/.test(location.href)) return;
  if (window.self !== window.top) return;                    // beágyazott előnézetben (iframe) nem fut

