c-member/"},"Member:479544069":{"__typename":"Member","id":"479544069","name":"zsolt.kramer","memberPhoto":{"__ref":"PhotoInfo:325166084"}},"PhotoInfo:271849370":{"__typename":"PhotoInfo","id":"271849370","highResUrl":"https://secure.meetupstatic.com/photos/member/c/0/d/a/highres_271849370.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:239722494":{"__typename":"Member","id":"239722494","name":"Szigetvári László","memberPhoto":{"__ref":"PhotoInfo:271849370"}},"PhotoInfo:252698043":{"__typename":"PhotoInfo","id":"252698043","highResUrl":"https://secure.meetupstatic.com/photos/member/9/4/9/b/highres_252698043.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:197203497":{"__typename":"Member","id":"197203497","name":"Reka Krüplné Teleki","memberPhoto":{"__ref":"PhotoInfo:252698043"}},"Member:480566068":{"__typename":"Member","id":"480566068","name":"utrigergely","memberPhoto":null},"Member:485107870":{"__typename":"Member","id":"485107870","name":"Várnai Zoltán Soma","memberPhoto":null},"PhotoInfo:311606578":{"__typename":"PhotoInfo","id":"311606578","highResUrl":"https://secure.meetupstatic.com/photos/member/6/7/d/2/highres_311606578.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:366660699":{"__typename":"Member","id":"366660699","name":"Helen Jun Chen","memberPhoto":{"__ref":"PhotoInfo:311606578"}},"PhotoInfo:326211299":{"__typename":"PhotoInfo","id":"326211299","highResUrl":"https://secure.meetupstatic.com/photos/member/c/8/6/3/highres_326211299.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:483561732":{"__typename":"Member","id":"483561732","name":"Ujvári Orsi","memberPhoto":{"__ref":"PhotoInfo:326211299"}},"Event:317310886":{"__typename":"Event","id":"317310886","title":"A tudós, az ügynök és a lázadó...","dateTime":"2026-12-08T18:00:00+01:00","description":"Bemegy egy kocsmába, és …\nNa jó, most nem kocsmába megyünk, hanem a Budapest Agile Meetup következő eseményére — ahol csak az alábbi (kezdeti) forgatókönyv lesz, és a ti kérdéseitek.\n\nOffice Lean — mit hozhat a lean gondolkodás a napi munkaszervezésben?\nLean vállalati transzformációban — mi működik a hivatalos prezentációkon túl?\nZombi Scrum csapatok — mikor csak ceremóniát ceremóniára halmoznak - érték nélkül, hogyan lehet őket feltámasztani?\n\nNincs prezi, nincsenek nagykönyvi kivonatok, egy flipchart, két filc, megy a beszélgetés, és meglátjuk, hová visz a vita heve.\nMi ott leszünk. Ti is?\n\n--\nAz eseményt a Sprint Consulting támogatta.\nThis event will be held in Hungarian.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/agilehungary/events/317310886/","isAttending":false,"isSaved":false,"maxTickets":40,"rsvpState":"JOIN_APPROVAL","featuredEventPhoto":{"__ref":"PhotoInfo:537000634"},"displayPhoto":{"__ref":"PhotoInfo:537000634"},"feeSettings":null,"group":{"__ref":"Group:1626758"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":25,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:275440520"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:408362324"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:11874080"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:64819822"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484959651"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:242079936"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:217218340"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:301825254"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"me