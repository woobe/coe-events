<!DOCTYPE html><html lang="en-US"><head><meta charSet="utf-8" data-next-head=""/><style data-fullcalendar="true" data-next-head=""></style><meta name="viewport" content="width=device-width, initial-scale=1" data-next-head=""/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" data-next-head=""/><meta name="service" content="web-next" data-next-head=""/><meta name="X-Location" content="east" data-next-head=""/><meta name="X-Build-Version" content="ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb" data-next-head=""/><link rel="icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" type="image/x-icon" sizes="any" data-next-head=""/><link rel="shortcut icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" data-next-head=""/><link rel="apple-touch-icon" sizes="120x120" href="https://secure.meetupstatic.com/next/images/general/m_redesign_120x120.png" data-next-head=""/><link rel="apple-touch-icon" sizes="152x152" href="https://secure.meetupstatic.com/next/images/general/m_redesign_152x152.png" data-next-head=""/><link rel="apple-touch-icon" sizes="167x167" href="https://secure.meetupstatic.com/next/images/general/m_redesign_167x167.png" data-next-head=""/><link rel="shortcut icon" sizes="128x128" href="https://secure.meetupstatic.com/next/images/general/m_redesign_128x128.png" data-next-head=""/><link rel="shortcut icon" sizes="196x196" href="https://secure.meetupstatic.com/next/images/general/m_redesign_196x196.png" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Regular.1ca3b39b.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Medium.7b11edcf.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Bold.5c45f750.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Book.27256a60.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/Boyrun-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="https://www.facebook.com/tr?id=792405807634160&amp;ev=PageView&amp;noscript=1" as="image" data-next-head=""/><script type="application/ld+json" data-next-head="">{"@type":"Organization","@context":"https://schema.org","url":"https://www.meetup.com/find/","name":"Meetup","logo":"https://secure.meetupstatic.com/next/images/general/m_redesign_630x630.png","sameAs":["https://www.facebook.com/meetup/","https://twitter.com/Meetup/","https://www.youtube.com/meetup","https://www.instagram.com/meetup/"]}</script><title data-next-head="">Find Events &amp; Groups | Meetup</title><meta name="description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="fb:app_id" content="2403839689" data-next-head=""/><meta property="og:site_name" content="Meetup" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:title" content="Find Events &amp; Groups | Meetup" data-next-head=""/><meta property="og:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="og:url" content="https://www.meetup.com/find/" data-next-head=""/><meta property="og:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="al:android:app_name" content="Meetup" data-next-head=""/><meta property="al:android:package" content="com.meetup" data-next-head=""/><meta property="al:ios:app_store_id" content="375990038" data-next-head=""/><meta property="al:ios:app_name" content="Meetup" data-next-head=""/><meta property="al:web:should_fallback" content="true" data-next-head=""/><meta property="al:android:url" content="meetup://" data-next-head=""/><meta property="al:ios:url" content="meetup://" data-next-head=""/><meta property="al:web:url" content="https://www.meetup.com/" data-next-head=""/><meta property="twitter:card" content="summary_large_image" data-next-head=""/><meta property="twitter:site" content="@meetup" data-next-head=""/><meta property="twitter:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="twitter:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="twitter:app:id:iphone" content="375990038" data-next-head=""/><meta property="twitter:app:name:iphone" content="Meetup" data-next-head=""/><meta property="twitter:app:id:ipad" content="375990038" data-next-head=""/><meta property="twitter:app:name:ipad" content="Meetup" data-next-head=""/><meta property="twitter:app:id:googleplay" content="com.meetup" data-next-head=""/><meta property="twitter:app:name:googleplay" content="Meetup" data-next-head=""/><meta name="robots" content="noindex, follow" data-next-head=""/><link rel="canonical" href="https://www.meetup.com/find/" data-next-head=""/><link rel="preconnect" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com" data-next-head=""/><link rel="dns-prefetch" href="https://www.googletagmanager.com" data-next-head=""/><script type="application/ld+json" data-next-head="">[{"@context":"https://schema.org","@type":"Event","name":"ZK Learning Group: Wrap-up 2026, ZK order book matching","url":"https://www.meetup.com/lfdt-hungary/events/317237690/","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: https://discord.com/channels/905194001349627914/1329201532628898036\nGithub repo for the lab:\nhttps://github.com/LF-Decentralized-Trust-labs/zk-learning-group\nIn this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317237690/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"Hyperledger Fabric for Aerospace Part Traceability: A Doctoral Research Overview","url":"https://www.meetup.com/lfdt-hungary/events/317315330/","description":"Aircraft parts and components move across airlines, manufacturers, suppliers, and maintenance organizations throughout their service lives. Keeping their maintenance and ownership records accurate and\nconsistent across these organizations is a continuing challenge, especially when each organization uses different enterprise systems.\n\nIn this session, Abhinag Vangala, a doctoral candidate at the University of the Cumberlands, will share an overview of his qualitative research on the use of Hyperledger Fabric for part and component traceability in\nmulti-organizational environments. The session will cover:\n\n* The traceability challenge in aerospace maintenance, repair, and overhaul (MRO)\n* What prior research has found, and where gaps remain\n* Why Hyperledger Fabric was selected for this study\n* The study’s three focus areas: system performance, enterprise system integration, and operational suitability\n\nThis session may interest Fabric developers, architects, and practitioners who have worked on networks involving multiple organizations.\n\nAbhinag will also share how U.S. based professionals with experience in Hyperledger Fabric or enterprise permissioned blockchain systems can voluntarily take part in the study.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-01T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317315330/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"Introducing ThunderID: Open Source Identity for Humans, AI Agents, and Machines","url":"https://www.meetup.com/lfdt-hungary/events/317272395/","description":"ThunderID ([https://github.com/thunder-id](https://github.com/thunder-id)) is an open source identity and access management project, hosted by LF Decentralized Trust as an incubation project. It is built from scratch in Go and treats humans, AI agents, and machines as first-class identities.\n\nIn this meetup, we will introduce the motivation behind ThunderID, including why it was built from scratch rather than extending existing IAM stacks. We will look at the challenges IAM now has to solve and how much the operational and environmental complexity of identity has changed. The session will introduce ThunderID’s key features and its four foundational pillars:\n\n⚡ Native agent identity\n⚡ Post-quantum safe by design\n⚡ Integration with decentralized identity infrastructure\n⚡ A high-performance, lightweight runtime with GitOps support\n\nThe session closes with practical demos showing how ThunderID addresses these problems.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-10T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317272395/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"ZK Learning Group: Wrap-up 2026, ZK order book matching","url":"https://www.meetup.com/lfdt-slovakia/events/317272056/","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\n\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\n\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: [https://discord.com/channels/905194001349627914/1329201532628898036](https://discord.com/channels/905194001349627914/1329201532628898036)\n\nGithub repo for the lab:\n[https://github.com/LF-Decentralized-Trust-labs/zk-learning-group](https://github.com/LF-Decentralized-Trust-labs/zk-learning-group)\n\n**In this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.**\n\n**Zoom Meeting link:** [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-slovakia/events/317272056/"},"organizer":{"@type":"Organization","name":"LFDT Slovakia","url":"https://www.meetup.com/lfdt-slovakia/"},"performer":"LFDT Slovakia"},{"@context":"https://schema.org","@type":"Event","name":"Tokenization was the Beginning. Agentic Capital Markets is the endgame","url":"https://www.meetup.com/lfdt-hungary/events/317457067/","description":"Join us for a webinar with Brickken, an LFDT general member, on building Agentic Capital Markets. Tokenization has made financial assets programmable. What comes next when AI agents can help discover opportunities and coordinate activity within defined mandates? Edwin Mata, Brickken's CEO & Co-Founder, will discuss the permissions, legal enforceability and operational controls needed to make Agentic Capital Markets work for institutions.\n\nThe webinar will take place on Wednesday, **December 2** at **7AM PST/10AM EST/16:00 CET/08:30 PM IST**\n\nPlease register here: https://zoom.us/webinar/register/8716754539090/WN_2WwuUCLLSZao28Vv-TiPnw\n\nWe hope to see you there!","startDate":"2026-12-02T15:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317457067/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","url":"https://www.meetup.com/lfdt-hungary/events/317415426/","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-08T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317415426/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"DevBP #19: Building Faster, Big and Small","url":"https://www.meetup.com/devbp-meetup/events/317427421/","description":"AI is rapidly rewriting the rules of software development—but what actually happens inside engineering organizations once writing code is no longer the primary bottleneck?\n\nJoin us for an evening of candid, practical insights from engineering leaders navigating the shift to AI-native workflows across two very different worlds: high-velocity product development and global, heavily regulated finance.\n\n=== === === ===\n\n**What Happens When Writing Code Is No Longer the Bottleneck?**\n**[Ákos Kapui](https://www.linkedin.com/in/akoskapui/) -** *CTO @ Shapr3D*\n\nSoftware engineering throughput has always been a major constraint on productivity. If AI removes that constraint, everything should become faster, right?\n\nIn theory, yes. In practice, that's not what happens for most organisations. While many see only marginal improvements, some AI-native companies seem to achieve exponential gains. What makes the difference? Why do some organisations become dramatically faster while others struggle to move beyond incremental improvements?\n\n**Moving Fast in a Highly Regulated World**\n**[Krisztián Fekete](https://www.linkedin.com/in/kfekete/) -** *Director of Engineering @ BlackRock*\n\nA look inside software engineering at a large financial institution, and how AI is changing the way teams work. Drawing on experiences at BlackRock, this talk explores the practical realities of adopting AI in a highly regulated environment, where innovation, governance, security, and compliance all need to coexist.\n\n=== === === ===\n\nThis English-language event will be held at the **Shapr3D office**, where we'll provide snacks and drinks to fuel conversations.\n\nArrival is from 17:30, the presentations start at 18:00.\n\nYou can also find the recordings of previous events on the [@DevBPMeetup YouTube channel](https://www.youtube.com/@DevBPMeetup).\n\nAlso join our brand new Discord server for some online discussions [here](https://discord.gg/Tk5sNM2xu)!","startDate":"2026-11-26T16:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Shapr3D HQ","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Akadémia u. 6, 1054 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"DevBP","url":"https://www.meetup.com/devbp-meetup/"},"performer":"DevBP"},{"@context":"https://schema.org","@type":"Event","name":"AWS X-Mas Meetup '26","url":"https://www.meetup.com/aws-user-group-hungary/events/317591108/","description":"🇬🇧 English version below 👇\n\n***\n\n🎄✨ Újra itt az év legünnepibb hazai AWS eseménye: a már hagyományossá vált X-Mas Meetupunk! ✨🎄\n\nHogyan lehet megfigyelhetővé tenni a rövid életű, nehezen debugolható Lambda függvényeket, napi 75 millió hívás mellett? És mi minden történt idén az AWS közösségben, a re:Cap-től a re:Inventig?\n\nÉvzáró esténken egy gyakorlati observability előadással kezdünk, aztán a szokásos ünnepi kerekasztalon visszatekintünk a tartalmas évre, és végigmegyünk a legfontosabb re:Invent bejelentéseken. A végére egy meglepetéssel is készülünk! 🎁\n\nZárd velünk az évet, beszélgessünk az AWS-ről, és hangolódjunk rá együtt a karácsonyra, tech stílusban! ☁️🤝\n\n***\n\n🗓️ **Program**\n\n**17:00 – Kapunyitás**\n\n**17:20 – OpenTelemetry Observability for AWS Lambda** (angolul)\n**Hegedűs Ádám** – Engineering Manager, Infrastructure @ Zocks\n\nA Lambda függvények rövid életűek, ezért nehéz őket debugolni. A platform ugyan egyre nyitottabb, de az üzemeltetőknek még mindig kevés lehetőségük van az observability kiépítésére: vagy minden egyes híváskor fix többletköltséget fizetnek, vagy maguknak kell kezelniük a különálló layerek életciklusát.\nAz előadásból kiderül, hogyan monitorozunk napi 75 millió Lambda-hívást OpenTelemetry segítségével. Megtartjuk a teljes rugalmasságot, a nyílt forráskódú ökoszisztémára építünk, és a saját fejlesztéseink egy részét vissza is adjuk a közösségnek.\n\n* 🔍 Miért nehéz a Lambda observability, és milyen kompromisszumokkal jár?\n* 📡 Hogyan épül fel egy OpenTelemetry-alapú megoldás nagy léptékben?\n* 🌱 Hogyan lehet a nyílt forráskódú ökoszisztémára építeni, és visszaadni a közösségnek?\n\n**18:00 – 🎤 Ünnepi kerekasztal: A 2026-os év az AWS közösségben**\nModerátor: **Nagy Olivér** – Head of DevOps & Infrastructure @ ShiwaForce\nRésztvevők:\n**Fodor-Horváth Júlia** – Principal Software Engineer @ Bitrise, AWS User Group Budapest Leader\n**Balassy Mihály** – Principal Cloud Architect @ LaniSys, AWS User Group Budapest Leader, AWS Community Builder\n\nAz X-Mas meetup hagyományaihoz híven átbeszéljük az év legfontosabb közösségi eseményeit: a re:Cap-et, az AWS Community Day CEE-t és az AWS User Group Leaders Summitot. Utána rátérünk az idei re:Invent legizgalmasabb bejelentéseire, és arra, mit jelentenek ezek a mindennapi munkánkban. Végül pedig jön egy meglepetés… 🎁\n\n**🎅 X-Mas Networking és ünnepi harapnivaló**\nLesz a szokásos szaloncukor 🍬, sör 🍺 és pizza 🍕!\nKérdezz az előadóktól, oszd meg a tapasztalataidat, és építs új szakmai kapcsolatokat az AWS közösségben.\n\n🌐 **Nyelvi megjegyzés:** Az előadás angol nyelven hangzik el. Kérdezni magyarul és angolul is lehet.\n\nVárunk szeretettel! 🎄☁️🤝\n\n***\n\n🇬🇧 **ENGLISH**\n\n🎄✨ The most festive AWS meetup of the year is here: our traditional AWS User Group Budapest X-Mas Meetup! ✨🎄\n\nHow do you make short-lived, hard-to-debug Lambda functions observable at 75 million invocations a day? And what happened in the AWS community this year, from re:Cap all the way to re:Invent?\n\nWe'll open the evening with a hands-on observability talk. Then comes our traditional holiday roundtable, where we look back on the year and go through the biggest re:Invent announcements. And we've got a surprise for you at the end! 🎁\n\nJoin us to close out the year, talk AWS, and get into the holiday spirit, tech style! ☁️🤝\n\n***\n\n🗓️ **Agenda**\n\n**17:00 – Doors open**\n\n**17:20 – OpenTelemetry Observability for AWS Lambda**\nAdam Hegedus – Engineering Manager, Infrastructure @ Zocks\n\nLambda functions are short-lived and hard to debug. The platform has grown more open, but operators still have few ways to add observability. They either pay a fixed cost on every invocation or manage the lifecycle of decoupled layers themselves. See how we monitor 75M daily Lambda invocations with OpenTelemetry. We keep full flexibility, build on the open-source ecosystem, and share some of our own contributions back.\n\n**18:00 – 🎤 Holiday Roundtable: The Year 2026 in the AWS Community**\nModerated by **Oliver Nagy** – Head of DevOps & Infrastructure @ ShiwaForce\nPanelists:\n**Julia Fodor-Horvath** – Principal Software Engineer @ Bitrise, AWS User Group Budapest Leader\n**Mihaly Balassy** – Principal Cloud Architect @ LaniSys, AWS User Group Budapest Leader, AWS Community Builder\n\nAs our X-Mas tradition, we'll look back on the year's highlights: re:Cap, AWS Community Day CEE and the AWS User Group Leaders Summit. Then we'll dive into the most exciting re:Invent announcements and what they mean for our everyday work. And finally… a surprise! 🎁\n\n**🎅 X-Mas Networking & Holiday Treats**\nThe usual szaloncukor 🍬 (traditional Hungarian Christmas candy), beer 🍺 and pizza 🍕 are on us!\n\n🌐 **Language note:** The talk will be delivered in English. Questions are welcome in English or Hungarian.\n\nWe look forward to seeing you! 🎄☁️🤝","startDate":"2026-12-08T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Shiwaforce","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Mosaic Office, Alkotás u. 17-19-7. emelet, 1123 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"AWS User Group Budapest","url":"https://www.meetup.com/aws-user-group-hungary/"},"performer":"AWS User Group Budapest"},{"@context":"https://schema.org","@type":"Event","name":"Data & AI Pub Quiz: Christmas Edition 🎄","url":"https://www.meetup.com/databricks-community-hungary/events/317493586/","description":"Free event, [registration](https://datapao.com/events-webinars/databricks-data-ai-pub-quiz-christmas-edition) is required.\n\nLet’s close 2026 the fun way! No slides and no long talks. Just a pub quiz, good company, and a few festive surprises the day after Santa.\n\nGrab your colleagues (or meet new ones on the night), form a team of 4–5, and battle it out across four rounds:\n\n* **Databricks:** how well do you really know the platform?\n* **Data & AI:** the big moments, famous names and a few Hungarian legends\n* **Christmas trivia:** because it’s December, after all\n* **Picture round:** logos, charts and some surprises\n\nThe questions are a mix of easy and tricky, so you don’t need to be a Databricks expert to win. Curiosity and a good team name go a long way. 😉\nWe’ll also be joined by **some of our friends from Databricks**, so come say hi and chat about what’s coming in 2027.\n\n📅 **AGENDA** (subject to change, times in CET):\n**17:30 – 18:00 \\| Arrival & registration:** Doors open, grab a drink, and find your team. Coming solo? We’ll match you up.\n**18:00 – 18:15 \\| Welcome & a hello from Databricks:** Quiz rules and a short, informal chat with our Databricks guest.\n**18:15 – 18:50 \\| Rounds 1 & 2:** Databricks, then Data & AI\n**18:50 – 19:10 \\| Break:** Refuel with fresh veggie dips (brain food for rounds 3 & 4 🥕) and grab another drink\n**19:10 – 19:45 \\| Rounds 3 & 4:** Christmas trivia, then the picture round\n**19:45 – 19:55 \\| Results & prizes:** Plus a prize for the best team name\n**19:55 – 21:00 \\| Networking & drinks:** Use your drink vouchers, stick around and celebrate the year with the Budapest data community.\n⏰ The quiz starts at **18:00 sharp**, so come at 17:30 to register and find your team.\n\n🎁 **WHAT’S IN IT FOR YOU:**\nA relaxed evening with the people who make this community what it is. You can test your knowledge, pick up a few fun facts, win some prizes, and end the year on a high note.\n\n🍻 **FOOD & DRINKS:**\nEvery participant gets **2 drink vouchers** to toast the end of the year. To keep your mind sharp for the tough questions, we’ll also have **fresh veggie dips**. Light, crunchy and festive, so your brain can do the heavy lifting. 😉\n\n🇬🇧 **LANGUAGE:** English\n\n👛 **EVENT FEE:** Free\n\n✍️ **REGISTRATION:** This event is free, but seats are limited to about 30 people. Registrations will be confirmed based on availability. Register here: https://datapao.com/events-webinars/databricks-data-ai-pub-quiz-christmas-edition\n\n🗺️ **LOCATION:** [Enter Bar](https://enterbar.hu/) (1111 Budapest, Lágymányosi u. 9.)\n\nℹ️ **ABOUT [DATABRICKS COMMUNITY HUNGARY](https://www.linkedin.com/company/datapao):**\nThis group is dedicated to bringing together data enthusiasts, analysts, and engineers interested in learning and sharing knowledge about Databricks and Apache Spark. Whether you are a beginner looking to delve into the world of data & AI or a seasoned professional looking to take your skills to the next level, our meetups offer a platform to connect, collaborate, and learn from each other. Let’s ignite our passion for data together!\n\n🌶️ **ABOUT [DATAPAO](https://datapao.com/):**\nWe’re a data and AI consulting and training company focused exclusively on Databricks, with over 10 years of experience on the platform. We help organizations build production-ready platforms, deliver real data and AI use cases, and train their teams to run Databricks independently.\n\nSee you on the 7th of December. Bring your brightest teammates and your festive spirit!\n\nThe Datapao team","startDate":"2026-12-07T16:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Enter Bar","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Lágymányosi u. 9, 1111 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Databricks Community Hungary","url":"https://www.meetup.com/databricks-community-hungary/"},"performer":"Databricks Community Hungary"},{"@context":"https://schema.org","@type":"Event","name":"ITSM meetup: az IT-szolgáltatásmenedzsment jelene és jövője","url":"https://www.meetup.com/magyar-atlassian-meetup/events/317499504/","description":"**Eseményünkön bemutatjuk, hogy látjuk az ITSM jelenét és mit vizionálunk a jövőre nézve**\n**A jelen:** hogyan kezdtek bele, mire számítottak, és mi lett belőle valójában? Partnerünk, egy IT-szolgáltató, valós ügyféltörténeten keresztül mutatja meg, hogyan alakította át az IT-szolgáltatásmenedzsmentjét.\n**A jövő:** merre tart az ITSM az AI világában? Mi lenne, ha egy ITSM-rendszer nem hónapok alatt, hanem egy rövid igényfelmérés után készülne el? Megmutatjuk, hogyan látjuk, és azt is, min dolgozunk már most.\nUtána pedig van idő arra, amiért igazán megéri személyesen találkozni: beszélgetni.\n\nRészletek és regisztráció: https://www.meta-inf.hu/esemenyek/itsm-meetup-valos-bevezetesek-oszinte-tapasztalatok","startDate":"2026-12-08T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"META-INF Kft","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Irinyi József u. 4-20, 1117 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Magyar Atlassian Meetup","url":"https://www.meetup.com/magyar-atlassian-meetup/"},"performer":"Magyar Atlassian Meetup"},{"@context":"https://schema.org","@type":"Event","name":"LFDT Mentorship: Talent Angels - Final Mentorship Presentation","url":"https://www.meetup.com/lfdt-hungary/events/317065199/","description":"This is a third event in a series about the Talent Angels mentorship project.\n\n**Speakers:**\nAlejandro Kantún, Shubhang Sinha, Aman Kumar Sarraf, Vishwajit Sarak-Patil\n\n**Mentors of the LFDT Mentorship Program:**\nAlfonso Govela, Alberto Ceballos, José Enmanuel Amaya Araujo, Noemí Muñiz\n\n**Resources:**\n**Part of the LFX Mentorship, Talent Angels @ Learning Tokens: AI Graph Agents for Human Skills Empowerment:** [https://mentorship.lfx.linuxfoundation.org/project/106dc6c2-c09d-44c7-b997-5647059d4491](https://mentorship.lfx.linuxfoundation.org/project/106dc6c2-c09d-44c7-b997-5647059d4491)\n\nTalent Angels GitHub: [https://github.com/LFX-Talent-Angels](https://github.com/LFX-Talent-Angels)\n\nLearning Tokens Webpage: [https://hyperledger-labs.github.io/learning-tokens/](https://hyperledger-labs.github.io/learning-tokens/)\n\nLearning Tokens GitHub: [https://github.com/hyperledger-labs/learning-tokens](https://github.com/hyperledger-labs/learning-tokens)\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-09T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-hungary/events/317065199/"},"organizer":{"@type":"Organization","name":"LFDT Hungary","url":"https://www.meetup.com/lfdt-hungary/"},"performer":"LFDT Hungary"},{"@context":"https://schema.org","@type":"Event","name":"A tudós, az ügynök és a lázadó...","url":"https://www.meetup.com/agilehungary/events/317310886/","description":"Bemegy egy kocsmába, és …\nNa jó, most nem kocsmába megyünk, hanem a Budapest Agile Meetup következő eseményére — ahol csak az alábbi (kezdeti) forgatókönyv lesz, és a ti kérdéseitek.\n\nOffice Lean — mit hozhat a lean gondolkodás a napi munkaszervezésben?\nLean vállalati transzformációban — mi működik a hivatalos prezentációkon túl?\nZombi Scrum csapatok — mikor csak ceremóniát ceremóniára halmoznak - érték nélkül, hogyan lehet őket feltámasztani?\n\nNincs prezi, nincsenek nagykönyvi kivonatok, egy flipchart, két filc, megy a beszélgetés, és meglátjuk, hová visz a vita heve.\nMi ott leszünk. Ti is?\n\n--\nAz eseményt a Sprint Consulting támogatta.\nThis event will be held in Hungarian.","startDate":"2026-12-08T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"MagNet Közösségi Ház","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Andrássy út 98, 1062 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"Budapest Agile Meetup Group","url":"https://www.meetup.com/agilehungary/"},"performer":"Budapest Agile Meetup Group"},{"@context":"https://schema.org","@type":"Event","name":"Agents & Dragons: Once Upon Agentic AI","url":"https://www.meetup.com/aws-serverless-budapest/events/317367738/","description":"⚔️ **Adventurers, your quest awaits!**\nJoin us at SnapSoft HQ in Budapest on **December 10** for **Agents & Dragons: Once Upon Agentic AI**, a hands-on workshop where you’ll build your own **AI Game Master**. It’s an intelligent agent that runs a role-playing adventure, and you’ll build it with **Strands Agents**, the open source SDK from AWS for building AI agents.\nThis is not a sit-back-and-watch session. Everyone codes, and everyone goes home with a working AI Game Master.\n\n🗺️ **What you’ll learn**\n\n* What LLMs and AI agents are, and how agents use tools\n* **MCP (Model Context Protocol):** how agents connect to APIs, databases and third-party tools\n* **A2A (Agent2Agent):** how agents discover each other and work together\n* How to build agents in a few lines of Python with Strands Agents\n\n🐉 **What you’ll build**\nOver several chapters you’ll put together a multi-agent system: a Game Master agent, a custom dice-roll MCP server, a Character agent and a Rules agent backed by a knowledge base. The agents talk to each other over A2A.\n\n🕖 **Agenda**\n\n* 18:00 Registration\n* 18:15 Workshop introduction\n* 18:30 Workshop starts\n* 20:00–20:15 Break\n* 21:00 Workshop ends, then networking with free pizza 🍕 and beer 🍺\n\n🎒 **Before you come**\n\n1. **Bring your own laptop.** A personal machine works best. Corporate firewalls and TLS inspection have blocked the AWS calls the workshop relies on at earlier events.\n2. **Create an AWS Builder Center account** before the event.\n3. **Do not launch an AWS Builder Center sandbox after December 3.** Each account gets one free sandbox workshop per week, and you’ll need yours on the night.\n4. Install **git**, **Python 3.10 or later** and **uv**.\n\nYou don’t need any previous experience with agents. Some Python helps, and a sense of adventure helps even more.\n\n⚠️ **Seats are limited.** If you RSVP and then can’t make it, please update your RSVP so someone on the waitlist can take your place.\nSee you at the table. Roll for initiative! 🎲","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"SnapSoft Kft.","address":{"@type":"PostalAddress","addressLocality":"Budapest","addressRegion":"","addressCountry":"hu","streetAddress":"Budapest, Focus Point Irodaház, Dohány u. 14, 1074 Hungary, Budapest"}},"organizer":{"@type":"Organization","name":"AWS Serverless Budapest","url":"https://www.meetup.com/aws-serverless-budapest/"},"performer":"AWS Serverless Budapest"}]</script><link rel="preload" href="https://secure.meetupstatic.com/photos/event/9/2/d/2/highres_536917586.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/0/c/4/highres_537004292.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/5/a/5/b/highres_536963131.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/5/8/a/8/highres_536962696.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/1/1/e/highres_537173534.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/b/0/8/a/highres_537225194.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/8/c/2/highres_537130434.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/0/8/3/highres_537308323.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/6/0/c/4/highres_537204772.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/7/4/4/1/highres_537209761.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/4/9/9/0/highres_536718832.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/7/a/highres_537000634.jpeg" as="image" data-next-head=""/><meta name="next_csrf" content="eef78ea3-95f8-4af1-a8bb-a8b81138f2db"/><script>(function(){try{if(typeof performance==="undefined"||!performance.getEntriesByType)return;var n=performance.getEntriesByType("navigation");if(!n||!n[0]||!n[0].name)return;var u=new URL(n[0].name);var h=u.hash||"";var m=h.match(/:~:text=([^&]+)/);if(m){window.__meetup_text_fragment__={hasTextFragment:true,textFragment:decodeURIComponent(m[1]).trim().slice(0,100),capturedAt:Date.now()}}else{window.__meetup_text_fragment__={hasTextFragment:false,capturedAt:Date.now()}}}catch(e){}})()</script><script>(function(){try{var hasCookie=document.cookie.split(';').some(function(c){return c.trim()==='isNativeApp=true'});var hasParam=window.location.search.indexOf('isNativeApp=true')!==-1;if(!hasCookie&&!hasParam)return;var s=document.createElement('style');s.textContent='#onetrust-consent-sdk{display:none!important}';document.head.appendChild(s);window.OptanonWrapper=function(){window.OneTrust&&window.OneTrust.Close&&window.OneTrust.Close()}}catch(e){}})()</script><link data-next-font="" rel="preconnect" href="/" crossorigin="anonymous"/><link rel="preload" href="/_next/static/css/4f3c5c8e994eb55f.css" as="style"/><link rel="stylesheet" href="/_next/static/css/4f3c5c8e994eb55f.css" data-n-g=""/><link rel="preload" href="/_next/static/css/873f7fff7cff85a1.css" as="style"/><link rel="stylesheet" href="/_next/static/css/873f7fff7cff85a1.css" data-n-p=""/><noscript data-n-css=""></noscript><script defer="" nomodule="" src="/_next/static/chunks/polyfills-42372ed130431b0a.js"></script><script src="/_next/static/chunks/webpack-920509eb5f34eeb6.js" defer=""></script><script src="/_next/static/chunks/framework-ace7f6a5f771b851.js" defer=""></script><script src="/_next/static/chunks/main-a7881118e7843e7c.js" defer=""></script><script src="/_next/static/chunks/pages/_app-9ff421c1ca3d1b68.js" defer=""></script><script src="/_next/static/chunks/40617-f8fdce331b8a6ec5.js" defer=""></script><script src="/_next/static/chunks/66589-574e3b675dc561fa.js" defer=""></script><script src="/_next/static/chunks/99209-1bfc737e1b69dabd.js" defer=""></script><script src="/_next/static/chunks/72959-42090c4dbf003ca6.js" defer=""></script><script src="/_next/static/chunks/44652-15f2930e6dda8997.js" defer=""></script><script src="/_next/static/chunks/68311-8962e9f71351630a.js" defer=""></script><script src="/_next/static/chunks/63678-7fcb77d0adf94bb9.js" defer=""></script><script src="/_next/static/chunks/11824-a53af9cfeb4740b5.js" defer=""></script><script src="/_next/static/chunks/31392-0e9a9be70f07f96f.js" defer=""></script><script src="/_next/static/chunks/41631-3d28c5267f96f460.js" defer=""></script><script src="/_next/sta