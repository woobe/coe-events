highResUrl":"https://secure.meetupstatic.com/photos/member/4/1/f/c/highres_314596892.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:362833509":{"__typename":"Member","id":"362833509","name":"Mikhail Poma","memberPhoto":{"__ref":"PhotoInfo:314596892"}},"PhotoInfo:324583928":{"__typename":"PhotoInfo","id":"324583928","highResUrl":"https://secure.meetupstatic.com/photos/member/a/b/9/8/highres_324583928.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:388235604":{"__typename":"Member","id":"388235604","name":"Teacher/Coder Jason","memberPhoto":{"__ref":"PhotoInfo:324583928"}},"Member:484443205":{"__typename":"Member","id":"484443205","name":"aisha","memberPhoto":null},"PhotoInfo:318450031":{"__typename":"PhotoInfo","id":"318450031","highResUrl":"https://secure.meetupstatic.com/photos/member/7/5/4/f/highres_318450031.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:389749595":{"__typename":"Member","id":"389749595","name":"Kevin Bravo","memberPhoto":{"__ref":"PhotoInfo:318450031"}},"Event:317237690":{"__typename":"Event","id":"317237690","title":"ZK Learning Group: Wrap-up 2026, ZK order book matching","dateTime":"2026-12-10T18:00:00+01:00","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: https://discord.com/channels/905194001349627914/1329201532628898036\nGithub repo for the lab:\nhttps://github.com/LF-Decentralized-Trust-labs/zk-learning-group\nIn this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317237690/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536917586"},"displayPhoto":{"__ref":"PhotoInfo:536917586"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":7,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:190362333"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:357270870"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:196043422"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:362833509"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:388235604"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484443205"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:389749595"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537004292":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/0/c/4/highres_537004292.jpeg","id":"537004292"},"PhotoInfo:272804026":{"__typename":"PhotoInfo","id":"272804026","highResUrl":"https://secure.meetupstatic.com/photos/member/a/b/f/a/highres_272804026.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:263561479":{"__typename":"PhotoInfo","id":"263561479","highResUrl":"https://secure.meetupstatic.com/photos/member/a/2/0/7/highres_263561479.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:219888552":{"__typename":"PhotoInfo","id":"219888552","highResUrl":"https://secure.meetupstatic.com/photos/member/b/d/a/8/highres_219888552.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:260335795":{"__typename":"PhotoInfo","id":"260335795","highResUrl":"https://secure.meetupstatic.com/photos/member/d/9/f/3/highres_260335795.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:243310269":{"__typename":"PhotoInfo","id":"243310269","highResUrl":"https://secure.meetupstatic.com/photos/member/2/8/1/d/highres_243310269.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:322323845":{"__typename":"PhotoInfo","id":"322323845","highResUrl":"https://secure.meetupstatic.com/photos/member/f/0/5/highres_322323845.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Event:317315330":{"__typename":"Event","id":"317315330","title":"Hyperledger Fabric for Aerospace Part Traceability: A Doctoral Research Overview","dateTime":"2026-12-01T18:00:00+01:00","description":"Aircraft parts and components move across airlines, manufacturers, suppliers, and maintenance organizations throughout their service lives. Keeping their maintenance and ownership records accurate and\nconsistent across these organizations is a continuing challenge, especially when each organization uses different enterprise systems.\n\nIn this session, Abhinag Vangala, a doctoral candidate at the University of the Cumberlands, will share an overview of his qualitative research on the use of Hyperledger Fabric for part and component traceability in\nmulti-organizational environments. The session will cover:\n\n* The traceability challenge in aerospace maintenance, repair, and overhaul (MRO)\n* What prior research has found, and where gaps remain\n* Why Hyperledger Fabric was selected for this study\n* The study’s three focus areas: system performance, enterprise system integration, and operational suitability\n\nThis session may interest Fabric developers, architects, and practitioners who have worked on networks involving multiple organizations.\n\nAbhinag will also share how U.S. based professionals with experience in Hyperledger Fabric or enterprise permissioned blockchain systems can voluntarily take part in the study.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317315330/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537004292"},"displayPhoto":{"__ref":"PhotoInfo:537004292"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":32,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:324583928"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272804026"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:263561479"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:219888552"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260335795"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:243310269"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:322323845"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:388235604"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:536963131":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/a/5/b/highres_536963131.jpeg","id":"536963131"},"PhotoInfo:291827510":{"__typename":"PhotoInfo","id":"291827510","highResUrl":"https://secure.meetupstatic.com/photos/member/b/9/9/6/highres_291827510.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:83430532":{"__typename":"Member","id":"83430532","name":"István Bánfi","memberPhoto":{"__ref":"PhotoInfo:291827510"}},"Member:9072697":{"__typename":"Member","id":"9072697","name":"MLL","memberPhoto":null},"Event:317272395":{"__typename":"Event","id":"317272395","title":"Introducing ThunderID: Open Source Identity for Humans, AI Agents, and Machines","dateTime":"2026-12-10T17:00:00+01:00","description":"ThunderID ([https://github.com/thunder-id](https://github.com/thunder-id)) is an open source identity and access management project, hosted by LF Decentralized Trust as an incubation project. It is built from scratch in Go and treats humans, AI agents, and machines as first-class identities.\n\nIn this meetup, we will introduce the motivation behind ThunderID, including why it was built from scratch rather than extending existing IAM stacks. We will look at the challenges IAM now has to solve and how much the operational and environmental complexity of identity has changed. The session will introduce ThunderID’s key features and its four foundational pillars:\n\n⚡ Native agent identity\n⚡ Post-quantum safe by design\n⚡ Integration with decentralized identity infrastructure\n⚡ A high-performance, lightweight runtime with GitOps support\n\nThe session closes with practical demos showing how ThunderID addresses these problems.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317272395/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536963131"},"displayPhoto":{"__ref":"PhotoInfo:536963131"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":32,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:291827510"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:318450031"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272804026"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:263561479"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:219888552"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260335795"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:243310269"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:83430532"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:9072697"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:389749595"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:536962696":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/8/a/8/highres_536962696.jpeg","id":"536962696"},"PhotoInfo:523678008":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/e/2/9/8/highres_523678008.jpeg","id":"523678008"},"Group:33287750":{"__typename":"Group","id":"33287750","name":"LFDT Slovakia","urlname":"lfdt-slovakia","timezone":"Europe/Bratislava","keyGroupPhoto":{"__ref":"PhotoInfo:523678008"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4,"totalRatings":1}},"isNewGroup":false},"PhotoInfo:286503551":{"__typename":"PhotoInfo","id":"286503551","highResUrl":"https://secure.meetupstatic.com/photos/member/d/d/f/highres_286503551.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:286969126":{"__typename":"PhotoInfo","id":"286969126","highResUrl":"https://secure.meetupstatic.com/photos/member/b/f/e/6/highres_286969126.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:290150699":{"__typename":"PhotoInfo","id":"290150699","highResUrl":"https://secure.meetupstatic.com/photos/member/c/6/0/b/highres_290150699.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:297642899":{"__typename":"PhotoInfo","id":"297642899","highResUrl":"https://secure.meetupstatic.com/photos/member/a/7/9/3/highres_297642899.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:293361690":{"__typename":"PhotoInfo","id":"293361690","highResUrl":"https://secure.meetupstatic.com/photos/member/5/4/b/a/highres_293361690.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:308066440":{"__typename":"PhotoInfo","id":"308066440","highResUrl":"https://secure.meetupstatic.com/photos/member/6/7/4/8/highres_308066440.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:233409662":{"__typename":"PhotoInfo","id":"233409662","highResUrl":"https://secure.meetupstatic.com/photos/member/2/5/b/e/highres_233409662.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Event:317272056":{"__typename":"Event","id":"317272056","title":"ZK Learning Group: Wrap-up 2026, ZK order book matching","dateTime":"2026-12-10T18:00:00+01:00","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\n\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\n\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: [https://discord.com/channels/905194001349627914/1329201532628898036](https://discord.com/channels/905194001349627914/1329201532628898036)\n\nGithub repo for the lab:\n[https://github.com/LF-Decentralized-Trust-labs/zk-learning-group](https://github.com/LF-Decentralized-Trust-labs/zk-learning-group)\n\n**In this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.**\n\n**Zoom Meeting link:** [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-slovakia/events/317272056/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536962696"},"displayPhoto":{"__ref":"PhotoInfo:536962696"},"feeSettings":null,"group":{"__ref":"Group:33287750"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":34,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:286503551"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:286969126"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:290150699"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:297642899"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:293361690"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:308066440"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:233409662"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":0,"edges":[]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537173534":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/1/1/e/highres_537173534.jpeg","id":"537173534"},"PhotoInfo:272060094":{"__typename":"PhotoInfo","id":"272060094","highResUrl":"https://secure.meetupstatic.com/photos/member/4/e/7/e/highres_272060094.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:295478958":{"__typename":"PhotoInfo","id":"295478958","highResUrl":"https://secure.meetupstatic.com/photos/member/9/8/2/e/highres_295478958.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:63804762":{"__typename":"Member","id":"63804762","name":"Gabor Szentpeteri","memberPhoto":{"__ref":"PhotoInfo:272060094"}},"Member:298449493":{"__typename":"Member","id":"298449493","name":"Prasadh Kumar","memberPhoto":{"__ref":"PhotoInfo:295478958"}},"Event:317457067":{"__typename":"Event","id":"317457067","title":"Tokenization was the Beginning. Agentic Capital Markets is the endgame","dateTime":"2026-12-02T16:00:00+01:00","description":"Join us for a webinar with Brickken, an LFDT general member, on building Agentic Capital Markets. Tokenization has made financial assets programmable. What comes next when AI agents can help discover opportunities and coordinate activity within defined mandates? Edwin Mata, Brickken's CEO \u0026 Co-Founder, will discuss the permissions, legal enforceability and operational controls needed to make Agentic Capital Markets work for institutions.\n\nThe webinar will take place on Wednesday, **December 2** at **7AM PST/10AM EST/16:00 CET/08:30 PM IST**\n\nPlease register here: https://zoom.us/webinar/register/8716754539090/WN_2WwuUCLLSZao28Vv-TiPnw\n\nWe hope to see you there!","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317457067/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537173534"},"displayPhoto":{"__ref":"PhotoInfo:537173534"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":37,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272060094"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:295478958"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272804026"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:263561479"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:219888552"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260335795"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:243310269"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:63804762"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:298449493"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537225194":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/0/8/a/highres_537225194.jpeg","id":"537225194"},"PhotoInfo:261929098":{"__typename":"PhotoInfo","id":"261929098","highResUrl":"https://secure.meetupstatic.com/photos/member/7/1/a/a/highres_261929098.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:273729851":{"__typename":"Member","id":"273729851","name":"Enzo B.","memberPhoto":null},"PhotoInfo:322109447":{"__typename":"PhotoInfo","id":"322109447","highResUrl":"https://secure.meetupstatic.com/photos/member/7/3/0/7/highres_322109447.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:208556900":{"__typename":"Member","id":"208556900","name":"LF Decentralized Trust","memberPhoto":{"__ref":"PhotoInfo:322109447"}},"Event:317415426":{"__typename":"Event","id":"317415426","title":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","dateTime":"2026-12-08T18:00:00+01:00","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317415426/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537225194"},"displayPhoto":{"__ref":"PhotoInfo:537225194"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":29,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272804026"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:263561479"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:219888552"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260335795"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:243310269"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:322323845"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:261929098"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:273729851"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:208556900"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537130434":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/8/c/2/highres_537130434.jpeg","id":"537130434"},"PhotoInfo:524759851":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/e/9/c/b/highres_524759851.jpeg","id":"524759851"},"Group:37782711":{"__typename":"Group","id":"37782711","name":"DevBP","urlname":"devbp-meetup","timezone":"Europe/Budapest","keyGroupPhoto":{"__ref":"PhotoInfo:524759851"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.75,"totalRatings":220}},"isNewGroup":false},"PhotoInfo:326665906":{"__typename":"PhotoInfo","id":"326665906","highResUrl":"https://secure.meetupstatic.com/photos/member/6/5/3/2/highres_326665906.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:211452710":{"__typename":"Member","id":"211452710","name":"Matyi N","memberPhoto":{"__ref":"PhotoInfo:326665906"}},"PhotoInfo:321041339":{"__typename":"PhotoInfo","id":"321041339","highResUrl":"https://secure.meetupstatic.com/photos/member/a/1/7/b/highres_321041339.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:372525452":{"__typename":"Member","id":"372525452","name":"Akos Kapui","memberPhoto":{"__ref":"PhotoInfo:321041339"}},"PhotoInfo:266869056":{"__typename":"PhotoInfo","id":"266869056","highResUrl":"https://secure.meetupstatic.com/photos/member/b/f/a/0/highres_266869056.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:227465394":{"__typename":"Member","id":"227465394","name":"Gergő Haragos","memberPhoto":{"__ref":"PhotoInfo:266869056"}},"PhotoInfo:324322856":{"__typename":"PhotoInfo","id":"324322856","highResUrl":"https://secure.meetupstatic.com/photos/member/5/9/4/8/highres_324322856.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:401611232":{"__typename":"Member","id":"401611232","name":"Dorka","memberPhoto":{"__ref":"PhotoInfo:324322856"}},"Member:437711499":{"__typename":"Member","id":"437711499","name":"Sólyom Bálint","memberPhoto":null},"Member:394147367":{"__typename":"Member","id":"394147367","name":"Gabriella Durugy","memberPhoto":null},"PhotoInfo:321086338":{"__typename":"PhotoInfo","id":"321086338","highResUrl":"https://secure.meetupstatic.com/photos/member/6/6/e/2/highres_321086338.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:262615890":{"__typename":"Member","id":"262615890","name":"Balázs Czap","memberPhoto":{"__ref":"PhotoInfo:321086338"}},"Member:468319277":{"__typename":"Member","id":"468319277","name":"Anujin Amartuvshin","memberPhoto":null},"Member:243067906":{"__typename":"Member","id":"243067906","name":"Krisztián Török","memberPhoto":null},"Member:419140258":{"__typename":"Member","id":"419140258","name":"Zuhriddin Ziyadullaev","memberPhoto":null},"Member:305253823":{"__typename":"Member","id":"305253823","name":"Jani Jež","memberPhoto":null},"Member:478587099":{"__typename":"Member","id":"478587099","name":"Alex Szabó","memberPhoto":null},"PhotoInfo:321204009":{"__typename":"PhotoInfo","id":"321204009","highResUrl":"https://secure.meetupstatic.com/photos/member/5/d/c/9/highres_321204009.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:221434171":{"__typename":"Member","id":"221434171","name":"Alexander Shvets","memberPhoto":{"__ref":"PhotoInfo:321204009"}},"PhotoInfo:216761922":{"__typename":"PhotoInfo","id":"216761922","highResUrl":"https://secure.meetupstatic.com/photos/member/a/3/c/2/highres_216761922.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:160340152":{"__typename":"Member","id":"160340152","name":"Balázs Ilsinszki","memberPhoto":{"__ref":"PhotoInfo:216761922"}},"PhotoInfo:325446885":{"__typename":"PhotoInfo","id":"325446885","highResUrl":"https://secure.meetupstatic.com/photos/member/1/a/e/5/highres_325446885.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:476456485":{"__typename":"Member","id":"476456485","name":"Kovács Eszter","memberPhoto":{"__ref":"PhotoInfo:325446885"}},"PhotoInfo:323493629":{"__typename":"PhotoInfo","id":"323493629","highResUrl":"https://secure.meetupstatic.com/photos/member/8/3/5/d/highres_323493629.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:469709146":{"__typename":"Member","id":"469709146","name":"Georgiy Iakunenko","memberPhoto":{"__ref":"PhotoInfo:323493629"}},"PhotoInfo:317533050":{"__typename":"PhotoInfo","id":"317533050","highResUrl":"https://secure.meetupstatic.com/photos/member/3/2/f/a/highres_317533050.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:310669681":{"__typename":"Member","id":"310669681","name":"Isabell Luo","memberPhoto":{"__ref":"PhotoInfo:317533050"}},"PhotoInfo:323270002":{"__typename":"PhotoInfo","id":"323270002","highResUrl":"https://secure.meetupstatic.com/photos/member/c/3/5/2/highres_323270002.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:420343160":{"__typename":"Member","id":"420343160","name":"Peter Pusztai ","memberPhoto":{"__ref":"PhotoInfo:323270002"}},"PhotoInfo:275060647":{"__typename":"PhotoInfo","id":"275060647","highResUrl":"https://secure.meetupstatic.com/photos/member/5/0/a/7/highres_275060647.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:249049021":{"__typename":"Member","id":"249049021","name":"Bálint Nagy","memberPhoto":{"__ref":"PhotoInfo:275060647"}},"Member:44298052":{"__typename":"Member","id":"44298052","name":"Karoly Horvath","memberPhoto":null},"Event:317427421":{"__typename":"Event","id":"317427421","title":"DevBP #19: Building Faster, Big and Small","dateTime":"2026-11-26T17:30:00+01:00","description":"AI is rapidly rewriting the rules of software development—but what actually happens inside engineering organizations once writing code is no longer the primary bottleneck?\n\nJoin us for an evening of candid, practical insights from engineering leaders navigating the shift to AI-native workflows across two very different worlds: high-velocity product development and global, heavily regulated finance.\n\n=== === === ===\n\n**What Happens When Writing Code Is No Longer the Bottleneck?**\n**[Ákos Kapui](https://www.linkedin.com/in/akoskapui/) -** *CTO @ Shapr3D*\n\nSoftware engineering throughput has always been a major constraint on productivity. If AI removes that constraint, everything should become faster, right?\n\nIn theory, yes. In practice, that's not what happens for most organisations. While many see only marginal improvements, some AI-native companies seem to achieve exponential gains. What makes the difference? Why do some organisations become dramatically faster while others struggle to move beyond incremental improvements?\n\n**Moving Fast in a Highly Regulated World**\n**[Krisztián Fekete](https://www.linkedin.com/in/kfekete/) -** *Director of Engineering @ BlackRock*\n\nA look inside software engineering at a large financial institution, and how AI is changing the way teams work. Drawing on experiences at BlackRock, this talk explores the practical realities of adopting AI in a highly regulated environment, where innovation, governance, security, and compliance all need to coexist.\n\n=== === === ===\n\nThis English-language event will be held at the **Shapr3D office**, where we'll provide snacks and drinks to fuel conversations.\n\nArrival is from 17:30, the presentations start at 18:00.\n\nYou can also find the recordings of previous events on the [@DevBPMeetup YouTube channel](https://www.youtube.com/@DevBPMeetup).\n\nAlso join our brand new Discord server for some online discussions [here](https://discord.gg/Tk5sNM2xu)!","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/devbp-meetup/events/317427421/","isAttending":false,"isSaved":false,"maxTickets":110,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537130434"},"displayPhoto":{"__ref":"PhotoInfo:537130434"},"feeSettings":null,"group":{"__ref":"Group:37782711"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":105,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:211452710"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:372525452"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:227465394"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:401611232"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:437711499"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:394147367"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:262615890"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:468319277"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:243067906"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:419140258"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:305253823"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:478587099"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:221434171"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:160340152"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:476456485"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:469709146"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:310669681"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:420343160"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:249049021"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:44298052"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Shapr3D HQ","address":"Budapest, Akadémia u. 6, 1054 Hungary","city":"Budapest","state":"","country":"hu"}},"PhotoInfo:537308323":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/0/8/3/highres_537308323.jpeg","id":"537308323"},"PhotoInfo:524189669":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/7/3/e/5/highres_524189669.jpeg","id":"524189669"},"Group:17458192":{"__typename":"Group","id":"17458192","name":"AWS User Group Budapest","urlname":"aws-user-group-hungary","timezone":"Europe/Budapest","keyGroupPhoto":{"__ref":"PhotoInfo:524189669"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.8,"totalRatings":83}},"isNewGroup":false},"PhotoInfo:232639012":{"__typename":"PhotoInfo","id":"232639012","highResUrl":"https://secure.meetupstatic.com/photos/member/4/a/4/4/highres_232639012.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:129796312":{"__typename":"PhotoInfo","id":"129796312","highResUrl":"https://secure.meetupstatic.com/photos/member/3/f/b/8/highres_129796312.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:258836204":{"__typename":"PhotoInfo","id":"258836204","highResUrl":"https://secure.meetupstatic.com/photos/member/d/b/8/c/highres_258836204.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:232658092":{"__typename":"PhotoInfo","id":"232658092","highResUrl":"https://secure.meetupstatic.com/photos/member/9/4/c/c/highres_232658092.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:286026789":{"__typename":"PhotoInfo","id":"286026789","highResUrl":"https://secure.meetupstatic.com/photos/member/1/a/8/5/highres_286026789.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:270396801":{"__typename":"PhotoInfo","id":"270396801","highResUrl":"https://secure.meetupstatic.com/photos/member/8/f/c/1/highres_270396801.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:280123717":{"__typename":"PhotoInfo","id":"280123717","highResUrl":"https://secure.meetupstatic.com/photos/member/a/a/c/5/highres_280123717.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:319463880":{"__typename":"PhotoInfo","id":"319463880","highResUrl":"https://secure.meetupstatic.com/photos/member/5/d/4/8/highres_319463880.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:419777486":{"__typename":"Member","id":"419777486","name":"Mihaly Balassy","memberPhoto":{"__ref":"PhotoInfo:319463880"}},"Event:317591108":{"__typename":"Event","id":"317591108","title":"AWS X-Mas Meetup '26","dateTime":"2026-12-08T17:00:00+01:00","description":"🇬🇧 English version below 👇\n\n***\n\n🎄✨ Újra itt az év legünnepibb hazai AWS eseménye: a már hagyományossá vált X-Mas Meetupunk! ✨🎄\n\nHogyan lehet megfigyelhetővé tenni a rövid életű, nehezen debugolható Lambda függvényeket, napi 75 millió hívás mellett? És mi minden történt idén az AWS közösségben, a re:Cap-től a re:Inventig?\n\nÉvzáró esténken egy gyakorlati observability előadással kezdünk, aztán a szokásos ünnepi kerekasztalon visszatekintünk a tartalmas évre, és végigmegyünk a legfontosabb re:Invent bejelentéseken. A végére egy meglepetéssel is készülünk! 🎁\n\nZárd velünk az évet, beszélgessünk az AWS-ről, és hangolódjunk rá együtt a karácsonyra, tech stílusban! ☁️🤝\n\n***\n\n🗓️ **Program**\n\n**17:00 – Kapunyitás**\n\n**17:20 – OpenTelemetry Observability for AWS Lambda** (angolul)\n**Hegedűs Ádám** – Engineering Manager, Infrastructure @ Zocks\n\nA Lambda függvények rövid életűek, ezért nehéz őket debugolni. A platform ugyan egyre nyitottabb, de az üzemeltetőknek még mindig kevés lehetőségük van az observability kiépítésére: vagy minden egyes híváskor fix többletköltséget fizetnek, vagy maguknak kell kezelniük a különálló layerek életciklusát.\nAz előadásból kiderül, hogyan monitorozunk napi 75 millió Lambda-hívást OpenTelemetry segítségével. Megtartjuk a teljes rugalmasságot, a nyílt forráskódú ökoszisztémára építünk, és a saját fejlesztéseink egy részét vissza is adjuk a közösségnek.\n\n* 🔍 Miért nehéz a Lambda observability, és milyen kompromisszumokkal jár?\n* 📡 Hogyan épül fel egy OpenTelemetry-alapú megoldás nagy léptékben?\n* 🌱 Hogyan lehet a nyílt forráskódú ökoszisztémára építeni, és visszaadni a közösségnek?\n\n**18:00 – 🎤 Ünnepi kerekasztal: A 2026-os év az AWS közösségben**\nModerátor: **Nagy Olivér** – Head of DevOps \u0026 Infrastructure @ ShiwaForce\nRésztvevők:\n**Fodor-Horváth Júlia** – Principal Software Engineer @ Bitrise, AWS User Group Budapest Leader\n**Balassy Mihály** – Principal Cloud Architect @ LaniSys, AWS User Group Budapest Leader, AWS Community Builder\n\nAz X-Mas meetup hagyományaihoz híven átbeszéljük az év legfontosabb közösségi eseményeit: a re:Cap-et, az AWS Community Day CEE-t és az AWS User Group Leaders Summitot. Utána rátérünk az idei re:Invent legizgalmasabb bejelentéseire, és arra, mit jelentenek ezek a mindennapi munkánkban. Végül pedig jön egy meglepetés… 🎁\n\n**🎅 X-Mas Networking és ünnepi harapnivaló**\nLesz a szokásos szaloncukor 🍬, sör 🍺 és pizza 🍕!\nKérdezz az előadóktól, oszd meg a tapasztalataidat, és építs új szakmai kapcsolatokat az AWS közösségben.\n\n🌐 **Nyelvi megjegyzés:** Az előadás angol nyelven hangzik el. Kérdezni magyarul és angolul is lehet.\n\nVárunk szeretettel! 🎄☁️🤝\n\n***\n\n🇬🇧 **ENGLISH**\n\n🎄✨ The most festive AWS meetup of the year is here: our traditional AWS User Group Budapest X-Mas Meetup! ✨🎄\n\nHow do you make short-lived, hard-to-debug Lambda functions observable at 75 million invocations a day? And what happened in the AWS community this year, from re:Cap all the way to re:Invent?\n\nWe'll open the evening with a hands-on observability talk. Then comes our traditional holiday roundtable, where we look back on the year and go through the biggest re:Invent announcements. And we've got a surprise for you at the end! 🎁\n\nJoin us to close out the year, talk AWS, and get into the holiday spirit, tech style! ☁️🤝\n\n***\n\n🗓️ **Agenda**\n\n**17:00 – Doors open**\n\n**17:20 – OpenTelemetry Observability for AWS Lambda**\nAdam Hegedus – Engineering Manager, Infrastructure @ Zocks\n\nLambda functions are short-lived and hard to debug. The platform has grown more open, but operators still have few ways to add observability. They either pay a fixed cost on every invocation or manage the lifecycle of decoupled layers themselves. See how we monitor 75M daily Lambda invocations with OpenTelemetry. We keep full flexibility, build on the open-source ecosystem, and share some of our own contributions back.\n\n**18:00 – 🎤 Holiday Roundtable: The Year 2026 in the AWS Community**\nModerated by **Oliver Nagy** – Head of DevOps \u0026 Infrastructure @ ShiwaForce\nPanelists:\n**Julia Fodor-Horvath** – Principal Software Engineer @ Bitrise, AWS User Group Budapest Leader\n**Mihaly Balassy** – Principal Cloud Architect @ LaniSys, AWS User Group Budapest Leader, AWS Community Builder\n\nAs our X-Mas tradition, we'll look back on the year's highlights: re:Cap, AWS Community Day CEE and the AWS User Group Leaders Summit. Then we'll dive into the most exciting re:Invent announcements and what they mean for our everyday work. And finally… a surprise! 🎁\n\n**🎅 X-Mas Networking \u0026 Holiday Treats**\nThe usual szaloncukor 🍬 (traditional Hungarian Christmas candy), beer 🍺 and pizza 🍕 are on us!\n\n🌐 **Language note:** The talk will be delivered in English. Questions are welcome in English or Hungarian.\n\nWe look forward to seeing you! 🎄☁️🤝","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/aws-user-group-hungary/events/317591108/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537308323"},"displayPhoto":{"__ref":"PhotoInfo:537308323"},"feeSettings":null,"group":{"__ref":"Group:17458192"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":34,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:232639012"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:129796312"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:258836204"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:232658092"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:286026789"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:270396801"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:280123717"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:419777486"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Shiwaforce","address":"Budapest, Mosaic Office, Alkotás u. 17-19-7. emelet, 1123 Hungary","city":"Budapest","state":"","country":"hu"}},"PhotoInfo:537204772":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/6/0/c/4/highres_537204772.jpeg","id":"537204772"},"PhotoInfo:524208728":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/e/5/8/highres_524208728.jpeg","id":"524208728"},"Group:37789789":{"__typename":"Group","id":"37789789","name":"Databricks Community Hungary","urlname":"databricks-community-hungary","timezone":"Europe/Budapest","keyGroupPhoto":{"__ref":"PhotoInfo:524208728"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.81,"totalRatings":26}},"isNewGroup":false},"PhotoInfo:321114645":{"__typename":"PhotoInfo","id":"321114645","highResUrl":"https://secure.meetupstatic.com/photos/member/d/5/7/5/highres_321114645.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:437688242":{"__typename":"Member","id":"437688242","name":"DATAPAO Kft.","memberPhoto":{"__ref":"PhotoInfo:321114645"}},"PhotoInfo:270995029":{"__typename":"PhotoInfo","id":"270995029","highResUrl":"https://secure.meetupstatic.com/photos/member/8/8/d/5/highres_270995029.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:194984375":{"__typename":"Member","id":"194984375","name":"Mihály Orsós","memberPhoto":{"__ref":"PhotoInfo:270995029"}},"PhotoInfo:326476766":{"__typename":"PhotoInfo","id":"326476766","highResUrl":"https://secure.meetupstatic.com/photos/member/4/1/7/e/highres_326476766.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:461228245":{"__typename":"Member","id":"461228245","name":"Dima","memberPhoto":{"__ref":"PhotoInfo:326476766"}},"PhotoInfo:312460186":{"__typename":"PhotoInfo","id":"312460186","highResUrl":"https://secure.meetupstatic.com/photos/member/9/c/f/a/highres_312460186.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:370781506":{"__typename":"Member","id":"370781506","name":"Andrea Illes","memberPhoto":{"__ref":"PhotoInfo:312460186"}},"PhotoInfo:279544488":{"__typename":"PhotoInfo","id":"279544488","highResUrl":"https://secure.meetupstatic.com/photos/member/1/1/8/8/highres_279544488.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:260567509":{"__typename":"Member","id":"260567509","name":"Kristóf Varga","memberPhoto":{"__ref":"PhotoInfo:279544488"}},"Member:250624543":{"__typename":"Member","id":"250624543","name":"m. judit","memberPhoto":null},"PhotoInfo:249378107":{"__typename":"PhotoInfo","id":"249378107","highResUrl":"https://secure.meetupstatic.com/photos/member/4/6/b/b/highres_249378107.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:192196629":{"__typename":"Member","id":"192196629","name":"Berta Krisztián","memberPhoto":{"__ref":"PhotoInfo:249378107"}},"PhotoInfo:44351912":{"__typename":"PhotoInfo","id":"44351912","highResUrl":"https://secure.meetupstatic.com/photos/member/2/e/8/8/highres_44351912.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:24087142":{"__typename":"Member","id":"24087142","name":"Daniel","memberPhoto":{"__ref":"PhotoInfo:44351912"}},"Member:247173957":{"__typename":"Member","id":"247173957","name":"László Szabó","memberPhoto":null},"PhotoInfo:186340142":{"__typename":"PhotoInfo","id":"186340142","highResUrl":"https://secure.meetupstatic.com/photos/member/9/c/c/e/highres_186340142.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:135416812":{"__typename":"Member","id":"135416812","name":"Veronika Csanyi","memberPhoto":{"__ref":"PhotoInfo:186340142"}},"Event:317493586":{"__typename":"Event","id":"317493586","title":"Data \u0026 AI Pub Quiz: Christmas Edition 🎄","dateTime":"2026-12-07T17:30:00+01:00","description":"Free event, [registration](https://datapao.com/events-webinars/databricks-data-ai-pub-quiz-christmas-edition) is required.\n\nLet’s close 2026 the fun way! No slides and no long talks. Just a pub quiz, good company, and a few festive surprises the day after Santa.\n\nGrab your colleagues (or meet new ones on the night), form a team of 4–5, and battle it out across four rounds:\n\n* **Databricks:** how well do you really know the platform?\n* **Data \u0026 AI:** the big moments, famous names and a few Hungarian legends\n* **Christmas trivia:** because it’s December, after all\n* **Picture round:** logos, charts and some surprises\n\nThe questions are a mix of easy and tricky, so you don’t need to be a Databricks expert to win. Curiosity and a good team name go a long way. 😉\nWe’ll also be joined by **some of our friends from Databricks**, so come say hi and chat about what’s coming in 2027.\n\n📅 **AGENDA** (subject to change, times in CET):\n**17:30 – 18:00 \\| Arrival \u0026 registration:** Doors open, grab a drink, and find your team. Coming solo? We’ll match you up.\n**18:00 – 18:15 \\| Welcome \u0026 a hello from Databricks:** Quiz rules and a short, informal chat with our Databricks guest.\n**18:15 – 18:50 \\| Rounds 1 \u0026 2:** Databricks, then Data \u0026 AI\n**18:50 – 19:10 \\| Break:** Refuel with fresh veggie dips (brain food for rounds 3 \u0026 4 🥕) and grab another drink\n**19:10 – 19:45 \\| Rounds 3 \u0026 4:** Christmas trivia, then the picture round\n**19:45 – 19:55 \\| Results \u0026 prizes:** Plus a prize for the best team name\n**19:55 – 21:00 \\| Networking \u0026 drinks:** Use your drink vouchers, stick around and celebrate the year with the Budapest data community.\n⏰ The quiz starts at **18:00 sharp**, so come at 17:30 to register and find your team.\n\n🎁 **WHAT’S IN IT FOR YOU:**\nA relaxed evening with the people who make this community what it is. You can test your knowledge, pick up a few fun facts, win some prizes, and end the year on a high note.\n\n🍻 **FOOD \u0026 DRINKS:**\nEvery participant gets **2 drink vouchers** to toast the end of the year. To keep your mind sharp for the tough questions, we’ll also have **fresh veggie dips**. Light, crunchy and festive, so your brain can do the heavy lifting. 😉\n\n🇬🇧 **LANGUAGE:** English\n\n👛 **EVENT FEE:** Free\n\n✍️ **REGISTRATION:** This event is free, but seats are limited to about 30 people. Registrations will be confirmed based on availability. Register here: https://datapao.com/events-webinars/databricks-data-ai-pub-quiz-christmas-edition\n\n🗺️ **LOCATION:** [Enter Bar](https://enterbar.hu/) (1111 Budapest, Lágymányosi u. 9.)\n\nℹ️ **ABOUT [DATABRICKS COMMUNITY HUNGARY](https://www.linkedin.com/company/datapao):**\nThis group is dedicated to bringing together data enthusiasts, analysts, and engineers interested in learning and sharing knowledge about Databricks and Apache Spark. Whether you are a beginner looking to delve into the world of data \u0026 AI or a seasoned professional looking to take your skills to the next level, our meetups offer a platform to connect, collaborate, and learn from each other. Let’s ignite our passion for data together!\n\n🌶️ **ABOUT [DATAPAO](https://datapao.com/):**\nWe’re a data and AI consulting and training company focused exclusively on Databricks, with over 10 years of experience on the platform. We help organizations build production-ready platforms, deliver real data and AI use cases, and train their teams to run Databricks independently.\n\nSee you on the 7th of December. Bring your brightest teammates and your festive spirit!\n\nThe Datapao team","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/databricks-community-hungary/events/317493586/","isAttending":false,"isSaved":false,"maxTickets":40,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537204772"},"displayPhoto":{"__ref":"PhotoInfo:537204772"},"feeSettings":null,"group":{"__ref":"Group:37789789"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":11,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:437688242"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:194984375"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:461228245"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:370781506"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:260567509"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:250624543"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192196629"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:24087142"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:247173957"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:135416812"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:476456485"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Enter Bar","address":"Budapest, Lágymányosi u. 9, 1111 Hungary","city":"Budapest","state":"","country":"hu"}},"PhotoInfo:537209761":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/7/4/4/1/highres_537209761.jpeg","id":"537209761"},"PhotoInfo:478256338":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/c/1/2/highres_478256338.jpeg","id":"478256338"},"Group:18520893":{"__typename":"Group","id":"18520893","name":"Magyar Atlassian Meetup","urlname":"Magyar-Atlassian-Meetup","timezone":"Europe/Budapest","keyGroupPhoto":{"__ref":"PhotoInfo:478256338"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.57,"totalRatings":174}},"isNewGroup":false},"PhotoInfo:316754364":{"__typename":"PhotoInfo","id":"316754364","highResUrl":"https://secure.meetupstatic.com/photos/member/3/8/1/c/highres_316754364.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:402138825":{"__typename":"Member","id":"402138825","name":"Eszter Galamb","memberPhoto":{"__ref":"PhotoInfo:316754364"}},"Member:173176792":{"__typename":"Member","id":"173176792","name":"Tamás Heigl","memberPhoto":null},"PhotoInfo:283082444":{"__typename":"PhotoInfo","id":"283082444","highResUrl":"https://secure.meetupstatic.com/photos/member/9/8/c/highres_283082444.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:269466655":{"__typename":"Member","id":"269466655","name":"Sipos Róbert","memberPhoto":{"__ref":"PhotoInfo:283082444"}},"PhotoInfo:323436855":{"__typename":"PhotoInfo","id":"323436855","highResUrl":"https://secure.meetupstatic.com/photos/member/8/f/f/7/highres_323436855.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:30898062":{"__typename":"Member","id":"30898062","name":"Zoltan Ludanyi","memberPhoto":{"__ref":"PhotoInfo:323436855"}},"PhotoInfo:263803089":{"__typename":"PhotoInfo","id":"263803089","highResUrl":"https://secure.meetupstatic.com/photos/member/a/8/5/1/highres_263803089.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:182619718":{"__typename":"Member","id":"182619718","name":"Birizdó Zsolt","memberPhoto":{"__ref":"PhotoInfo:263803089"}},"Event:317499504":{"__typename":"Event","id":"317499504","title":"ITSM meetup: az IT-szolgáltatásmenedzsment jelene és jövője","dateTime":"2026-12-08T17:00:00+01:00","description":"**Eseményünkön bemutatjuk, hogy látjuk az ITSM jelenét és mit vizionálunk a jövőre nézve**\n**A jelen:** hogyan kezdtek bele, mire számítottak, és mi lett belőle valójában? Partnerünk, egy IT-szolgáltató, valós ügyféltörténeten keresztül mutatja meg, hogyan alakította át az IT-szolgáltatásmenedzsmentjét.\n**A jövő:** merre tart az ITSM az AI világában? Mi lenne, ha egy ITSM-rendszer nem hónapok alatt, hanem egy rövid igényfelmérés után készülne el? Megmutatjuk, hogyan látjuk, és azt is, min dolgozunk már most.\nUtána pedig van idő arra, amiért igazán megéri személyesen találkozni: beszélgetni.\n\nRészletek és regisztráció: https://www.meta-inf.hu/esemenyek/itsm-meetup-valos-bevezetesek-oszinte-tapasztalatok","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/magyar-atlassian-meetup/events/317499504/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537209761"},"displayPhoto":{"__ref":"PhotoInfo:537209761"},"feeSettings":null,"group":{"__ref":"Group:18520893"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":8,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:402138825"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:173176792"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:269466655"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192196629"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:30898062"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:24087142"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:247173957"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:182619718"}}}]},"series":null,"venue":{"__typename":"Venue","name":"META-INF Kft","address":"Budapest, Irinyi József u. 4-20, 1117 Hungary","city":"Budapest","state":"","country":"hu"}},"PhotoInfo:536718832":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/9/9/0/highres_536718832.jpeg","id":"536718832"},"Event:317065199":{"__typename":"Event","id":"317065199","title":"LFDT Mentorship: Talent Angels - Final Mentorship Presentation","dateTime":"2026-12-09T18:00:00+01:00","description":"This is a third event in a series about the Talent Angels mentorship project.\n\n**Speakers:**\nAlejandro Kantún, Shubhang Sinha, Aman Kumar Sarraf, Vishwajit Sarak-Patil\n\n**Mentors of the LFDT Mentorship Program:**\nAlfonso Govela, Alberto Ceballos, José Enmanuel Amaya Araujo, Noemí Muñiz\n\n**Resources:**\n**Part of the LFX Mentorship, Talent Angels @ Learning Tokens: AI Graph Agents for Human Skills Empowerment:** [https://mentorship.lfx.linuxfoundation.org/project/106dc6c2-c09d-44c7-b997-5647059d4491](https://mentorship.lfx.linuxfoundation.org/project/106dc6c2-c09d-44c7-b997-5647059d4491)\n\nTalent Angels GitHub: [https://github.com/LFX-Talent-Angels](https://github.com/LFX-Talent-Angels)\n\nLearning Tokens Webpage: [https://hyperledger-labs.github.io/learning-tokens/](https://hyperledger-labs.github.io/learning-tokens/)\n\nLearning Tokens GitHub: [https://github.com/hyperledger-labs/learning-tokens](https://github.com/hyperledger-labs/learning-tokens)\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-hungary/events/317065199/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536718832"},"displayPhoto":{"__ref":"PhotoInfo:536718832"},"feeSettings":null,"group":{"__ref":"Group:27511932"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":40,"interestedUsersSample":[{"__type