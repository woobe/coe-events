nfo:323554800"}},"PhotoInfo:316739114":{"__typename":"PhotoInfo","id":"316739114","highResUrl":"https://secure.meetupstatic.com/photos/member/e/6/e/a/highres_316739114.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:6636944":{"__typename":"Member","id":"6636944","name":"Gergely Csonka","memberPhoto":{"__ref":"PhotoInfo:316739114"}},"Member:393562583":{"__typename":"Member","id":"393562583","name":"Daniel Papp","memberPhoto":null},"PhotoInfo:244663346":{"__typename":"PhotoInfo","id":"244663346","highResUrl":"https://secure.meetupstatic.com/photos/member/a/9/5/2/highres_244663346.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:185374896":{"__typename":"Member","id":"185374896","name":"Gellért Stadler","memberPhoto":{"__ref":"PhotoInfo:244663346"}},"Member:478525246":{"__typename":"Member","id":"478525246","name":"Attila Alexovics","memberPhoto":null},"PhotoInfo:318630178":{"__typename":"PhotoInfo","id":"318630178","highResUrl":"https://secure.meetupstatic.com/photos/member/7/5/e/2/highres_318630178.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:11045501":{"__typename":"Member","id":"11045501","name":"Gergo Bakos","memberPhoto":{"__ref":"PhotoInfo:318630178"}},"Member:428238808":{"__typename":"Member","id":"428238808","name":"János Torba","memberPhoto":null},"PhotoInfo:265607065":{"__typename":"PhotoInfo","id":"265607065","highResUrl":"https://secure.meetupstatic.com/photos/member/b/7/d/9/highres_265607065.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:8176796":{"__typename":"Member","id":"8176796","name":"Antal István","memberPhoto":{"__ref":"PhotoInfo:265607065"}},"PhotoInfo:316135726":{"__typename":"PhotoInfo","id":"316135726","highResUrl":"https://secure.meetupstatic.com/photos/member/d/9/a/e/highres_316135726.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:302724263":{"__typename":"Member","id":"302724263","name":"Balint","memberPhoto":{"__ref":"PhotoInfo:316135726"}},"Member:485344999":{"__typename":"Member","id":"485344999","name":"Zorán Heinczinger","memberPhoto":null},"PhotoInfo:284470854":{"__typename":"PhotoInfo","id":"284470854","highResUrl":"https://secure.meetupstatic.com/photos/member/2/a/6/6/highres_284470854.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:190340484":{"__typename":"Member","id":"190340484","name":"csorbasebestyen","memberPhoto":{"__ref":"PhotoInfo:284470854"}},"PhotoInfo:322808554":{"__typename":"PhotoInfo","id":"322808554","highResUrl":"https://secure.meetupstatic.com/photos/member/2/1/6/a/highres_322808554.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:464859612":{"__typename":"Member","id":"464859612","name":"Gábor Szentpéteri","memberPhoto":{"__ref":"PhotoInfo:322808554"}},"Event:317367738":{"__typename":"Event","id":"317367738","title":"Agents \u0026 Dragons: Once Upon Agentic AI","dateTime":"2026-12-10T18:00:00+01:00","description":"⚔️ **Adventurers, your quest awaits!**\nJoin us at SnapSoft HQ in Budapest on **December 10** for **Agents \u0026 Dragons: Once Upon Agentic AI**, a hands-on workshop where you’ll build your own **AI Game Master**. It’s an intelligent agent that runs a role-playing adventure, and you’ll build it with **Strands Agents**, the open source SDK from AWS for building AI agents.\nThis is not a sit-back-and-watch session. Everyone codes, and everyone goes home with a working AI Game Master.\n\n🗺️ **What you’ll learn**\n\n* What LLMs and AI agents are, and how agents use tools\n* **MCP (Model Context Protocol):** how agents connect to APIs, databases and third-party tools\n* **A2A (Agent2Agent):** how agents discover each other and work together\n* How to build agents in a few lines of Python with Strands Agents\n\n🐉 **What you’ll build**\nOver several chapters you’ll put together a multi-agent system: a Game Master agent, a custom dice-roll MCP server, a Character agent and a Rules agent backed by a knowledge base. The agents talk to each other over A2A.\n\n🕖 **Agenda**\n\n* 18:00 Registration\n* 18:15 Workshop introduction\n* 18:30 Workshop starts\n* 20:00–20:15 Break\n* 21:00 Workshop ends, then networking with free pizza 🍕 and beer 🍺\n\n🎒 **Before you come**\n\n1. **Bring your own laptop.** A personal machine works best. Corporate firewalls and TLS inspection have blocked the AWS calls the workshop relies on at earlier events.\n2. **Create an AWS Builder Center account** before the event.\n3. **Do not launch an AWS Builder Center sandbox after December 3.** Each account gets one free sandbox workshop per week, and you’ll need yours on the night.\n4. Install **git**, **Python 3.10 or later** and **uv**.\n\nYou don’t need any previous experience with agents. Some Python helps, and a sense of adventure helps even more.\n\n⚠️ **Seats are limited.** If you RSVP and then can’t make it, please update your RSVP so someone on the waitlist can take your place.\nSee you at the table. Roll for initiative! 🎲","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/aws-serverless-budapest/events/317367738/","isAttending":false,"isSaved":false,"maxTickets":50,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537074540"},"displayPhoto":{"__ref":"PhotoInfo:537074540"},"feeSettings":null,"group":{"__ref":"Group:36572413"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":40,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:226326705"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:273909886"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:227706158"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:428325998"}}},{"__typ