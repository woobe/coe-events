-circle-dollar-sign" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>Pénzügyek</a></nav></div></header><main id="main-content" tabindex="-1"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Szabadság 2027: hány nap jár, és mi változik?","description":"Szabadság 2027: hány nap jár életkor szerint, a 2027-ben betöltött kor táblázata, a gyermek utáni és egyéb pótszabadságok, és mit mond a hatályos Mt. a 2027-es évre.","url":"https://www.allaskisokos.hu/szabadsag-2027","dateModified":"2026-11-17","inLanguage":"hu","author":{"@type":"Organization","name":"ÁllásKisokos.hu","url":"https://www.allaskisokos.hu"},"editor":{"@type":"Person","@id":"https://www.allaskisokos.hu/a-szerkesztorol#szerkeszto","name":"Pálinkás András","url":"https://www.allaskisokos.hu/a-szerkesztorol"},"publisher":{"@type":"Organization","name":"ÁllásKisokos.hu","url":"https://www.allaskisokos.hu"},"image":"https://www.allaskisokos.hu/opengraph-image"}</script><header class="ak-narrow-hyphens ak-container ak-pagehead ak-stack" style="gap:16px;max-width:1200px"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Főoldal","item":"https://www.allaskisokos.hu/"},{"@type":"ListItem","position":2,"name":"Munkajog","item":"https://www.allaskisokos.hu/kategoria/munkaszerzodesek"},{"@type":"ListItem","position":3,"name":"Szabadság 2027: hány nap jár, és mi változik?","item":"https://www.allaskisokos.hu/szabadsag-2027"}]}</script><nav aria-label="Navigációs útvonal"><ol class="ak-crumbs"><li><a href="/">Főoldal</a></li><li><a href="/kategoria/munkaszerzodesek">Munkajog</a></li><li><span aria-current="page">Szabadság 2027: hány nap jár, és mi változik?</span></li></ol></nav><span style="align-self:flex-start"><span class="ak-badge ak-badge--cat">Munkajog</span></span><h1 class="ak-h1" style="max-width:860px">Szabadság 2027: hány nap jár, és mi változik?</h1><p class="ak-lead">Szabadság 2027: hány nap jár életkor szerint, a 2027-ben betöltött kor táblázata, a gyermek utáni és egyéb pótszabadságok, és mit mond a hatályos Mt. a 2027-es évre.</p><div class="ak-meta"><span>ÁllásKisokos.hu</span><span>Frissítve: <!-- -->2026. 11. 17.</span><span>5<!-- --> perc olvasás</span></div></header><div class="ak-container ak-article" style="padding-bottom:72px"><aside class="ak-article__aside" aria-label="Tartalom"><details class="ak-toc"><summary>Tartalom<!-- --> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><ol><li><a href="#osszefoglalo">Összefoglaló</a></li><li><a href="#roviden-hany-nap-jar-2027-ben">Röviden: hány nap jár 2027-ben?</a></li><li><a href="#2027-szuletesi-ev-szerinti-tablazat">2027: születési év szerinti táblázat</a></li><li><a href="#mi-valtozik-2027-ben">Mi változik 2027-ben?</a></li><li><a href="#gyermek-utan-jaro-potszabadsag">Gyermek után járó pótszabadság</a></li><li><a href="#tovabbi-potszabadsagok">További pótszabadságok</a></li><li><a href="#ha-ev-kozben-kezdesz-vagy-szunik-meg-a-munkaviszonyod">Ha év közben kezdesz vagy szűnik meg a munkaviszonyod</a></li><li><a href="#a-szabadsag-kiadasa">A szabadság kiadása</a></li><li><a href="#gyik">Gyakori kérdések</a></li></ol></details></aside><article class="ak-narrow-hyphens ak-prose"><nav aria-label="Első lépés" class="my-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap"><a class="inline-flex min-h-11 max-w-full flex-1 [overflow-wrap:break-word] items-center justify-center rounded-xl border-2 border-emerald-700 bg-white px-4 py-2.5 text-center text-sm font-semibold text-emerald-800 transition-colors hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" href="/kalkulator/szabadsag">Szabadság kalkulátor</a><a class="inline-flex min-h-11 max-w-full flex-1 [overflow-wrap:break-word] items-center justify-center rounded-xl border-2 border-emerald-700 bg-white px-4 py-2.5 text-center text-sm font-semibold text-emerald-800 transition-colors hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" href="/kalkulator/szabadsag-tervezo">Szabadság tervező</a></nav><div class="my-6 bg-emerald-50/60 border border-emerald-200 rounded-2xl p-4 sm:p-5"><h2 id="osszefoglalo" class="text-sm font-bold text-emerald-800 uppercase tracking-wider mb-3">Összefoglaló</h2><dl class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div class="min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100"><dt class="text-xs text-gray-500 font-medium">Alapszabadság</dt><dd class="text-base font-bold text-gray-900 mt-0.5">20 munkanap<span class="mt-0.5 block text-xs font-normal text-gray-500">Mt. 116. §</span></dd></div><div class="min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100"><dt class="text-xs text-gray-500 font-medium">Életkori pótszabadság</dt><dd class="text-base font-bold text-gray-900 mt-0.5">legfeljebb 10 munkanap<span class="mt-0.5 block text-xs font-normal text-gray-500">A 45. életévtől, Mt. 117. § (1)</span></dd></div><div class="min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100"><dt class="text-xs text-gray-500 font-medium">Melyik életkor számít?</dt><dd class="text-base font-bold text-gray-900 mt-0.5">A 2027-ben betöltött<span class="mt-0.5 block text-xs font-normal text-gray-500">Mt. 117. § (2): az az év számít, amelyben betöltöd</span></dd></div><div class="min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100"><dt class="text-xs text-gray-500 font-medium">Gyermek után</dt><dd class="text-base font-bold text-gray-900 mt-0.5">2 / 4 / összesen 7 munkanap<span class="mt-0.5 block text-xs font-normal text-gray-500">A 16 évnél fiatalabb gyermek után, Mt. 118. § (1)</span></dd></div></dl></div><p>A saját számodat az <a href="/kalkulator/szabadsag">életkor szerinti szabadság kalkulátor</a> azonnal megadja. Ez a cikk azt mutatja meg, hogyan jön ki a szám 2027-re.</p>
<h2 id="roviden-hany-nap-jar-2027-ben">Röviden: hány nap jár 2027-ben?</h2>
<p>A szabadság alap- és pótszabadságból áll (Mt. 115. § (1)). Az alapszabadság húsz munkanap (Mt. 116. §). Az életkori pótszabadság a 25. életévtől egy, a 28.-tól kettő, és így tovább, a 45. életévtől tíz munkanap (Mt. 117. § (1)).</p>
<p>A döntő pont: a hosszabb tartamú pótszabadság <strong>abban az évben jár először, amelyben az adott életkort betölti</strong> (Mt. 117. § (2)). Ezért 2027-ben a 2027-es betöltött életkor számít, vagyis 2027 mínusz a születési éved, attól függetlenül, hogy a születésnapod januárban vagy decemberben van.</p>
<h2 id="2027-szuletesi-ev-szerinti-tablazat">2027: születési év szerinti táblázat</h2>
<p>Az alábbi táblázat a törvény lépcsőiből számolt, <strong>a gyermek utáni és az egyéb pótszabadságok nélkül</strong>. Az első oszlop a születési éved, a második a 2027-ben betöltött életkor.</p>
<div class="ak-table-wrap" role="region" aria-label="Görgethető táblázat: 2027: születési év szerinti táblázat" tabindex="0"><table class="ak-table"><thead><tr><th scope="col">Születési év</th><th scope="col">2027-ben betöltött életkor</th><th scope="col">Szabadság összesen (munkanap)</th></tr></thead><tbody><tr><td>2003 vagy később</td><td>legfeljebb 24</td><td>20</td></tr><tr><td>2002 - 2000</td><td>25 - 27</td><td>21</td></tr><tr><td>1999 - 1997</td><td>28 - 30</td><td>22</td></tr><tr><td>1996 - 1995</td><td>31 - 32</td><td>23</td></tr><tr><td>1994 - 1993</td><td>33 - 34</td><td>24</td></tr><tr><td>1992 - 1991</td><td>35 - 36</td><td>25</td></tr><tr><td>1990 - 1989</td><td>37 - 38</td><td>26</td></tr><tr><td>1988 - 1987</td><td>39 - 40</td><td>27</td></tr><tr><td>1986 - 1985</td><td>41 - 42</td><td>28</td></tr><tr><td>1984 - 1983</td><td>43 - 44</td><td>29</td></tr><tr><td>1982 vagy korábban</td><td>legalább 45</td><td>30</td></tr></tbody></table></div>
<p>Ez számítás, nem a törvény szövege: a törvény az életkori lépcsőket adja (Mt. 117. § (1)), a táblázat ezekből a 2027-ben betöltött életkorra fordítja le őket.</p>
<h2 id="mi-valtozik-2027-ben">Mi változik 2027-ben?</h2>
<p>Az alap- és pótszabadság szabályai (Mt. 115-121. §) a cikkben idézett szövegben hatályosak. A Jogtárban (<span class="hyphens-manual">net.jogtar.hu</span>) az Mt. mai szövegének hatálya nyitott végű (2026. október 1-jétől), későbbi kihirdetett módosítás nincs benne. A 2026. november 5-i országgyűlési irományok listáján (35 törvényjavaslat) nincs olyan javaslat, amely a szabadság szabályait (Mt. 115-121. §) módosítaná. A szabadság napjainak száma 2027-ben tehát a mai szabályok szerint számolható, ezt a kihirdetésig tekintjük érvényesnek.</p>
<p><strong>December 24. munkaszüneti nap (kihirdetve, hatályos).</strong> A 2026. évi LXXII. törvény 3. §-a az Mt. 102. § (1) bekezdését így állapítja meg: &quot;Munkaszüneti nap: január 1., március 15., nagypéntek, húsvéthétfő, május 1., pünkösdhétfő, augusztus 20., október 23., november 1. és december 24-26.&quot; A törvényt az Országgyűlés 2026. november 3-án fogadta el, a Magyar Közlöny 2026. évi 171. számában, 2026. november 13-án hirdették ki, és a záró rendelkezése szerint a kihirdetését követő napon lépett hatályba, vagyis 2026. november 14-től hatályos. A javaslat korábbi állapotát (T/714.) ezzel a kihirdetett szöveggel vetettük össze; a lényeges rendelkezések azonosak.</p>
<p>Mit jelent ez a szabadságnál? A szabadságot a munkaidő-beosztás szerinti munkanapokra kell kiadni (Mt. 124. § (1)), egyenlőtlen munkaidő-beosztás esetén pedig a munkaszüneti nap nem számít munkanapnak a szabadság kiadásakor (Mt. 124. § (2)). 2027-ben december 24. péntekre esik (számítás), ezért december 24-ére a munkaszüneti nap szabályai vonatkoznak: nem kell rá szabadságot kivenni. A törvény átmeneti szabályt is tartalmaz a 2026. december 24-re és 12-re a folyamatban lévő munkaidőkeretre (a 2012. évi LXXXVI. törvény 19/G. §-a); ezt a 2027-es szabadság nem érinti. A december 24-i változásról részletesen: <a href="/december-24-munkaszuneti-nap">December 24. munkaszüneti nap: mit jelent a munkavállalónak?</a>.</p>
<p>A 2027. évi munkaszüneti napok körüli munkarendről szóló miniszteri rendeletet még nem találtunk; ha megjelenik, ide is felvesszük.</p>
<h2 id="gyermek-utan-jaro-potszabadsag">Gyermek után járó pótszabadság</h2>
<p>A 16 évnél fiatalabb gyermek után (Mt. 118. § (1)):</p>
<ul>
<li>egy gyermek után 2 munkanap;</li>
<li>két gyermek után 4 munkanap;</li>
<li>kettőnél több gyermek után összesen 7 munkanap.</li>
</ul>
<p>Ha a gyermek fogyatékos, a pótszabadság gyermekenként két munkanappal nő (Mt. 118. § (2)). A gyermeket először a születése évében, utoljára abban az évben kell figyelembe venni, amelyben a 16. életévét betölti (Mt. 118. § (3)).</p>
<h2 id="tovabbi-potszabadsagok">További pótszabadságok</h2>
<ul>
<li><strong>Fiatal munkavállaló:</strong> évenként 5 munkanap, utoljára abban az évben, amelyben a 18. életévét betölti (Mt. 119. § (1)).</li>
<li><strong>Föld alatt vagy ionizáló sugárzásnak kitett munkahelyen</strong> naponta legalább három órát dolgozó munkavállaló: évenként 5 munkanap (Mt. 119. § (2)).</li>
<li><strong>Megváltozott munkaképességű, fogyatékossági támogatásra vagy vakok személyi járadékára jogosult munkavállaló:</strong> évenként 5 munkanap (Mt. 120. §).</li>
</ul>
<h2 id="ha-ev-kozben-kezdesz-vagy-szunik-meg-a-munkaviszonyod">Ha év közben kezdesz vagy szűnik meg a munkaviszonyod</h2>
<p>Ha a munkaviszonyod év közben kezdődik vagy szűnik meg, a szabadság arányos része jár, az apasági és a szülői szabadság kivételével. A fél napot elérő töredéknap egész munkanapnak számít (Mt. 121. §). A ki nem adott arányos szabadságot a megszűnéskor meg kell váltani (Mt. 125. §). Erről részletesen a <a href="/kozos-megegyezes-munkaviszony-megszuntetese-2026">közös megegyezés</a> cikkben írtunk.</p>
<h2 id="a-szabadsag-kiadasa">A szabadság kiadása</h2>
<p>A szabadságot a munkáltató adja ki, a munkavállaló előzetes meghallgatása után (Mt. 122. § (1)). Évente hét munkanap szabadságot a munkaviszony első három hónapját kivéve a munkavállaló kérésének megfelelő időpontban, legfeljebb két részletben kell kiadni, ha az igényét legalább tizenöt nappal a szabadság kezdete előtt bejelenti (Mt. 122. § (2)). Eltérő megállapodás hiányában úgy kell kiadni, hogy naptári évenként egy alkalommal legalább tizennégy egybefüggő napra mentesülj a munkavégzési és rendelkezésre állási kötelezettség alól (Mt. 122. § (3)).</p>
<p>A szabadság alatt távolléti díj jár, ennek számítását a <a href="/tavolleti-dij-2026">távolléti díj 2026</a> cikkben találod. A szabadságod beosztásához a <a href="/kalkulator/szabadsag-tervezo">szabadság tervező</a> nyújt segítséget. A 2026-os szabályokról és a részletes példákról a <a href="/szabadsag-napok-szama-2026">Hány nap szabadság jár 2026-ban?</a> és a <a href="/potszabadsag-eletkor-szerint-2026">Pótszabadság életkor szerint</a> cikkben olvashatsz.</p>
<p>A cikk a hatályos jogszabályi szöveget összegzi, a pontos összeget és a napok számát a munkáltatód számítása adja.</p><section class="ak-faq"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Hány nap szabadság jár 2027-ben?","acceptedAnswer":{"@type":"Answer","text":"Az alapszabadság húsz munkanap (Mt. 116. §), ehhez jön az életkori pótszabadság: a 25. életévtől egy, a 45. életévtől tíz munkanap (Mt. 117. § (1)). A 2027-ben betöltött életkor számít, vagyis 2027 mínusz a születési éved (Mt. 117. § (2)). Gyermek, fogyatékosság és más okok miatt további pótszabadság járhat."}},{"@type":"Question","name":"Melyik életkor számít, a mostani vagy a 2027-ben betöltött?","acceptedAnswer":{"@type":"Answer","text":"A 2027-ben betöltött. A hosszabb tartamú pótszabadság abban az évben jár először, amelyben az adott életkort betöltöd, és az egész évre jár (Mt. 117. § (2))."}},{"@type":"Question","name":"Hogyan számolja a kalkulátor a 2027-es szabadságot?","acceptedAnswer":{"@type":"Answer","text":"A szabadság kalkulátor a naptári évvel és a megadott születési dátummal számol: a 2027-ben betöltött életkort a 2027 mínusz a születési év adja. Amíg 2026 van, a kalkulátor a 2026-os évet mutatja; a 2027-es értéket a cikkbeli táblázatból olvashatod ki."}},{"@type":"Question","name":"Munkaszüneti nap december 24-e?","acceptedAnswer":{"@type":"Answer","text":"Igen. A december 24-ét munkaszüneti nappá nyilvánító 2026. évi LXXII. törvényt a Magyar Közlöny 2026. évi 171. számában, 2026. november 13-án kihirdették, és a kihirdetését követő napon, 2026. november 14-én hatályba lépett. Az Mt. 102. § (1) bekezdése szerint a munkaszüneti napok: január 1., március 15., nagypéntek, húsvéthétfő, május 1., pünkösdhétfő, augusztus 20., október 23., november 1. és december 24-26. A 2026-os átmeneti szabályt az Mt. hatálybalépésével összefüggő 2012. évi LXXXVI. törvény 19/G. §-a adja."}},{"@type":"Question","name":"Jár pótszabadság a gyermek után?","acceptedAnswer":{"@type":"Answer","text":"Igen, a 16 évnél fiatalabb gyermek után: egy gyermek után kettő, két gyermek után négy, kettőnél több gyermek után összesen hét munkanap (Mt. 118. § (1)). Fogyatékos gyermekenként további két munkanap jár (Mt. 118. § (2))."}},{"@type":"Question","name":"Kinek jár még pótszabadság?","acceptedAnswer":{"@type":"Answer","text":"A fiatal munkavállalónak évenként öt munkanap, utoljára abban az évben, amelyben a 18. életévét betölti (Mt. 119. § (1)). A megváltozott munkaképességű, a fogyatékossági támogatásra jogosult és a vakok személyi járadékára jogosult munkavállalónak évenként öt munkanap (Mt. 120. §)."}}]}</script><h2 id="gyik">Gyakori kérdések</h2><details><summary>Hány nap szabadság jár 2027-ben?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><p>Az alapszabadság húsz munkanap (Mt. 116. §), ehhez jön az életkori pótszabadság: a 25. életévtől egy, a 45. életévtől tíz munkanap (Mt. 117. § (1)). A 2027-ben betöltött életkor számít, vagyis 2027 mínusz a születési éved (Mt. 117. § (2)). Gyermek, fogyatékosság és más okok miatt további pótszabadság járhat.</p></details><details><summary>Melyik életkor számít, a mostani vagy a 2027-ben betöltött?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><p>A 2027-ben betöltött. A hosszabb tartamú pótszabadság abban az évben jár először, amelyben az adott életkort betöltöd, és az egész évre jár (Mt. 117. § (2)).</p></details><details><summary>Hogyan számolja a kalkulátor a 2027-es szabadságot?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><p>A szabadság kalkulátor a naptári évvel és a megadott születési dátummal számol: a 2027-ben betöltött életkort a 2027 mínusz a születési év adja. Amíg 2026 van, a kalkulátor a 2026-os évet mutatja; a 2027-es értéket a cikkbeli táblázatból olvashatod ki.</p></details><details><summary>Munkaszüneti nap december 24-e?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><p>Igen. A december 24-ét munkaszüneti nappá nyilvánító 2026. évi LXXII. törvényt a Magyar Közlöny 2026. évi 171. számában, 2026. november 13-án kihirdették, és a kihirdetését követő napon, 2026. november 14-én hatályba lépett. Az Mt. 102. § (1) bekezdése szerint a munkaszüneti napok: január 1., március 15., nagypéntek, húsvéthétfő, május 1., pünkösdhétfő, augusztus 20., október 23., november 1. és december 24-26. A 2026-os átmeneti szabályt az Mt. hatálybalépésével összefüggő 2012. évi LXXXVI. törvény 19/G. §-a adja.</p></details><details><summary>Jár pótszabadság a gyermek után?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><p>Igen, a 16 évnél fiatalabb gyermek után: egy gyermek után kettő, két gyermek után négy, kettőnél több gyermek után összesen hét munkanap (Mt. 118. § (1)). Fogyatékos gyermekenként további két munkanap jár (Mt. 118. § (2)).</p></details><details><summary>Kinek jár még pótszabadság?<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><p>A fiatal munkavállalónak évenként öt munkanap, utoljára abban az évben, amelyben a 18. életévét betölti (Mt. 119. § (1)). A megváltozott munkaképességű, a fogyatékossági támogatásra jogosult és a vakok személyi járadékára jogosult munkavállalónak évenként öt munkanap (Mt. 120. §).</p></details></section><div class="ak-feedback" style="margin-top:40px"><span style="font-weight:600;font-size:16px">Hasznos volt ez a cikk?</span><div class="ak-row" style="gap:8px"><button type="button" class="ak-btn ak-btn--ghost">Igen</button><button type="button" class="ak-btn ak-btn--ghost">Nem igazán</button></div></div><div class="my-8 rounded-lg border border-gray-200 bg-gray-50 text-sm text-gray-600"><div class="flex items-start gap-2.5 p-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg><div class="min-w-0 [overflow-wrap:anywhere]"><p class="font-medium text-gray-700 mb-1">Mesterséges intelligencia közreműködésével készült</p><p class="leading-relaxed">Ez a cikk AI segítségével, szerkesztői ellenőrzés mellett készült. Törekszünk a pontosságra és a naprakészségre, de előfordulhatnak hibák, félreértések vagy időközben elavult részek, ezért fokozott óvatossággal kezeld, és fontos döntés előtt mindig ellenőrizd az információt hivatalos forrásból.</p></div></div><div class="flex items-start gap-2.5 p-4 border-t border-gray-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 text-gray-500 flex-shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 [overflow-wrap:anywhere]"><p class="font-medium text-gray-700 mb-1">Tájékoztató jellegű tartalom</p><p class="leading-relaxed">Az oldalon megjelenő információk általános, oktatási célú tájékoztatást nyújtanak, és nem minősülnek jogi, munkajogi, adó- vagy pénzügyi (befektetési) tanácsadásnak. Döntés előtt ellenőrizd az aktuális szabályokat, vagy fordulj szakképzett szakértőhöz.</p></div></div></div></article><aside class="ak-article__rail ak-article__aside ak-stack" aria-label="Kapcsolódó eszköz: Bruttó-nettó kalkulátor"><div class="ak-card ak-stack" style="gap:12px"><span aria-hidden="true" class="ak-icon-tile"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg></span><strong>Bruttó-nettó kalkulátor</strong><span class="ak-card__text">Nézd meg, mennyi marad a fizetésedből.</span><a class="ak-btn ak-btn--primary ak-btn--block" href="/kalkulator/brutto-netto">Kiszámolom</a></div></aside></div><section class="ak-band"><div class="ak-container ak-section"><div class="ak-section-head"><h2 class="ak-h2">Ezek is érdekelhetnek</h2><a class="ak-more" href="/kategoria/munkaszerzodesek">Munkajog<!-- --> <span aria-hidden="true">→</span></a></div><div class="ak-grid ak-grid--3"><a class="ak-card ak-card--flat ak-card--link" href="/szabadsag-napok-szama-2026"><span style="align-self:flex-start"><span class="ak-badge ak-badge--cat">Munkajog</span></span><div class="ak-card__title">Hány nap szabadság jár 2026-ban? Alap- és pótszabadság táblázat</div><div class="ak-card__meta">5<!-- --> perc olvasás</div></a><a class="ak-card ak-card--flat ak-card--link" href="/potszabadsag-eletkor-szerint-2026"><span style="align-self:flex-start"><span class="ak-badge ak-badge--cat">Munkajog</span></span><div class="ak-card__title">Pótszabadság 2026: hány nap jár életkor szerint?</div><div class="ak-card__meta">7<!-- --> perc olvasás</div></a><a class="ak-card ak-card--flat ak-card--link" href="/tavolleti-dij-2026"><span style="align-self:flex-start"><span class="ak-badge ak-badge--cat">Munkajog</span></span><div class="ak-card__title">Távolléti díj 2026: mikor jár, mi számít bele, és hogyan számolják</div><div class="ak-card__meta">6<!-- --> perc olvasás</div></a></div><div style="margin-top:32px"><h3 class="ak-h4" style="margin-bottom:12px">További kapcsolódó cikkek</h3><ul style="margin:0;padding-left:20px;list-style:disc"><li style="margin-bottom:6px"><a style="color:var(--ak-primary-strong);text-decoration:underline;text-underline-offset:3px" href="/kozos-megegyezes-munkaviszony-megszuntetese-2026">Közös megegyezés a munkaviszony megszüntetésére 2026: minta és menete</a></li><li style="margin-bottom:6px"><a style="color:var(--ak-primary-strong);text-decoration:underline;text-underline-offset:3px" href="/2027-valtozasok-statusz">2027: mi változik, és hol tart?</a></li></ul></div></div></section><!--$--><!--/$--></main><footer class="ak-footer" style="margin-top:64px"><div class="ak-container"><section class="ak-newsletter ak-on-dark" aria-labelledby="footer-newsletter-title" style="margin-top:40px"><div class="ak-stack ak-stack--sm"><h3 id="footer-newsletter-title" class="ak-h4 ak-row" style="gap:8px;margin:0;color:#fff"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true" style="color:var(--ak-accent)"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>Iratkozz fel a hírlevelünkre</h3><p class="ak-small">Legfeljebb havonta egyszer írunk: munkajogi változások, új kalkulátorok, karriertippek. Nem spammelünk.</p></div><div><form class="ak-newsletter__form"><div><label for="_R_1hdb_-name">Neved</label><input type="text" placeholder="Példa Anna" id="_R_1hdb_-name" autoComplete="name" maxLength="100" required="" value=""/></div><div><label for="_R_1hdb_-email">E-mail-címed</label><input type="email" id="_R_1hdb_-email" placeholder="pelda@example.com" required="" value=""/></div><button type="submit" class="ak-btn ak-btn--accent">Feliratkozás</button><p class="ak-newsletter__full ak-newsletter__consent">A nevedet a hozzájárulásod rögzítéséhez kérjük.<!-- --> <!-- -->A megadott nevet és e-mail-címet a hírlevél küldéséhez és a hozzájárulásod igazolásához kezeljük, az<!-- --> <a href="/adatkezelesi-tajekoztato">Adatkezelési tájékoztató</a> <!-- -->szerint. Bármikor, indoklás nélkül leiratkozhatsz.</p></form></div></section></div><div class="ak-container ak-footer__grid"><div class="ak-footer__brand ak-stack ak-stack--sm"><a class="ak-logo" href="/"><span class="ak-logo__mark" aria-hidden="true">ÁK</span><span class="ak-logo__word">ÁllásKisokos</span></a><p class="ak-muted" style="margin:0;max-width:320px;font-size:15px">Az <strong>Állás Kisokos</strong> (ÁllásKisokos.hu) ingyenes önéletrajz készítőt, útmutatókat és kalkulátorokat kínál: álláskeresés, állásinterjú, munkajog, vállalkozás és pénzügyek (megtakarítás, befektetés, FIRE) egy helyen.</p><p class="ak-disclaimer" style="max-width:320px">Tájékoztató jellegű oldal. Nem minősül jogi, munkajogi, adó- vagy pénzügyi (befektetési) tanácsadásnak.</p></div><nav class="ak-footer__col" aria-label="Témakörök (lábléc)"><h3>Témakörök</h3><ul class="ak-footer__list"><li><a href="/kategoria/oneletrajz">Önéletrajz</a></li><li><a href="/kategoria/interju">Állásinterjú</a></li><li><a href="/kategoria/allas-keresese">Álláskeresés</a></li><li><a href="/kategoria/munkaszerzodesek">Munkajog</a></li><li><a href="/kategoria/vallalkozas">Vállalkozás</a></li><li><a href="/kategoria/penzugyek">Pénzügyek</a></li></ul></nav><nav class="ak-footer__col" aria-label="Eszközök"><h3>Eszközök</h3><ul class="ak-footer__list"><li><a href="/oneletrajz-keszito">Önéletrajz-készítő</a></li><li><a href="/kalkulator">Kalkulátorok</a></li><li><a href="/fizetesek">Fizetések szakmák szerint</a></li><li><a href="/sablonok">Sablonok</a></li><li><a class="ak-footer__pro" href="/pro?src=lablec">Pro csomag</a></li><li><a href="/cikkek">Összes cikk</a></li></ul></nav><nav class="ak-footer__col" aria-label="Információk"><h3>Információk</h3><ul class="ak-footer__list"><li><a href="/aszf">ÁSZF</a></li><li><a href="/jogi-nyilatkozat">Jogi nyilatkozat</a></li><li><a href="/a-szerkesztorol">A szerkesztőről</a></li><li><a href="/adatkezelesi-tajekoztato">Adatkezelési tájékoztató</a></li><li><a href="/cookie-tajekoztato">Cookie tájékoztató</a></li><li><a href="/hirdetes">Hirdetés</a></li><li><a href="/kapcsolat">Kapcsolat</a></li><li><a href="/sitemap.xml">Sitemap</a></li><li><button type="button" class="ak-footer__button" aria-label="Cookie beállítások (hozzájárulás visszavonása)">Cookie beállítások</button></li></ul></nav></div><div class="ak-container ak-footer__pay"><picture><source srcSet="/barion/png/light/Large-nobg-ligh