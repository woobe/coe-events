ame\":\"min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-xs text-gray-500 font-medium\",\"children\":\"Életkori pótszabadság\"}],[\"$\",\"dd\",null,{\"className\":\"text-base font-bold text-gray-900 mt-0.5\",\"children\":[[\"legfeljebb 10 munkanap\"],[\"$\",\"span\",null,{\"className\":\"mt-0.5 block text-xs font-normal text-gray-500\",\"children\":[\"A 45. életévtől, Mt. 117. § (1)\"]}]]}]]}],[\"$\",\"div\",\"2\",{\"className\":\"min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-xs text-gray-500 font-medium\",\"children\":\"Melyik életkor számít?\"}],[\"$\",\"dd\",null,{\"className\":\"text-base font-bold text-gray-900 mt-0.5\",\"children\":[[\"A 2027-ben betöltött\"],[\"$\",\"span\",null,{\"className\":\"mt-0.5 block text-xs font-normal text-gray-500\",\"children\":[\"Mt. 117. § (2): az az év számít, amelyben betöltöd\"]}]]}]]}],[\"$\",\"div\",\"3\",{\"className\":\"min-w-0 [overflow-wrap:anywhere] bg-white rounded-xl p-3.5 border border-emerald-100\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-xs text-gray-500 font-medium\",\"children\":\"Gyermek után\"}],[\"$\",\"dd\",null,{\"className\":\"text-base font-bold text-gray-900 mt-0.5\",\"children\":[[\"2 / 4 / összesen 7 munkanap\"],[\"$\",\"span\",null,{\"className\":\"mt-0.5 block text-xs font-normal text-gray-500\",\"children\":[\"A 16 évnél fiatalabb gyermek után, Mt. 118. § (1)\"]}]]}]]}]]}]]}]\n3e:[[\"$\",\"p\",null,{\"children\":[\"A saját számodat az \",[\"$\",\"$L22\",null,{\"href\":\"/kalkulator/szabadsag\",\"children\":\"életkor szerinti szabadság kalkulátor\"}],\" azonnal megadja. Ez a cikk azt mutatja meg, hogyan jön ki a szám 2027-re.\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"roviden-hany-nap-jar-2027-ben\",\"children\":\"Röviden: hány nap jár 2027-ben?\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"A szabadság alap- és pótszabadságból áll (Mt. 115. § (1)). Az alapszabadság húsz munkanap (Mt. 116. §). Az életkori pótszabadság a 25. életévtől egy, a 28.-tól kettő, és így tovább, a 45. életévtől tíz munkanap (Mt. 117. § (1)).\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"A döntő pont: a hosszabb tartamú pótszabadság \",[\"$\",\"strong\",null,{\"children\":\"abban az évben jár először, amelyben az adott életkort betölti\"}],\" (Mt. 117. § (2)). Ezért 2027-ben a 2027-es betöltött életkor számít, vagyis 2027 mínusz a születési éved, attól függetlenül, hogy a születésnapod januárban vagy decemberben van.\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"2027-szuletesi-ev-szerinti-tablazat\",\"children\":\"2027: születési év szerinti táblázat\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Az alábbi táblázat a törvény lépcsőiből számolt, \",[\"$\",\"strong\",null,{\"children\":\"a gyermek utáni és az egyéb pótszabadságok nélkül\"}],\". Az első oszlop a születési éved, a második a 2027-ben betöltött életkor.\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"ak-table-wrap\",\"role\":\"region\",\"aria-label\":\"Görgethető táblázat: 2027: születési év szerinti táblázat\",\"tabIndex\":0,\"children\":[\"$\",\"table\",null,{\"className\":\"ak-table\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Születési év\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"2027-ben betöltött életkor\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Szabadság összesen (munkanap)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"2003 vagy később\"}],[\"$\",\"td\",null,{\"children\":\"legfeljebb 24\"}],[\"$\",\"td\",null,{\"children\":\"20\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"2002 - 2000\"}],[\"$\",\"td\",null,{\"children\":\"25 - 27\"}],[\"$\",\"td\",null,{\"children\":\"21\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1999 - 1997\"}],[\"$\",\"td\",null,{\"children\":\"28 - 30\"}],[\"$\",\"td\",null,{\"children\":\"22\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1996 - 1995\"}],[\"$\",\"td\",null,{\"children\":\"31 - 32\"}],[\"$\",\"td\",null,{\"children\":\"23\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1994 - 1993\"}],[\"$\",\"td\",null,{\"children\":\"33 - 34\"}],[\"$\",\"td\",null,{\"children\":\"24\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1992 - 1991\"}],[\"$\",\"td\",null,{\"children\":\"35 - 36\"}],[\"$\",\"td\",null,{\"children\":\"25\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1990 - 1989\"}],[\"$\",\"td\",null,{\"children\":\"37 - 38\"}],[\"$\",\"td\",null,{\"children\":\"26\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1988 - 1987\"}],[\"$\",\"td\",null,{\"children\":\"39 - 40\"}],[\"$\",\"td\",null,{\"children\":\"27\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1986 - 1985\"}],[\"$\",\"td\",null,{\"children\":\"41 - 42\"}],[\"$\",\"td\",null,{\"children\":\"28\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1984 - 1983\"}],[\"$\",\"td\",null,{\"children\":\"43 - 44\"}],[\"$\",\"td\",null,{\"children\":\"29\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1982 vagy korábban\"}],[\"$\",\"td\",null,{\"children\":\"legalább 45\"}],[\"$\",\"td\",null,{\"children\":\"30\"}]]}]]}]]}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Ez számítás, nem a törvény szövege: a törvény az életkori lépcsőket adja (Mt. 117. § (1)), a táblázat ezekből a 2027-ben betöltött életkorra fordítja le őket.\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"mi-valtozik-2027-ben\",\"children\":\"Mi változik 2027-ben?\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Az alap- és pótszabadság szabályai (Mt. 115-121. §) a cikkben idézett szövegben hatályosak. A Jogtárban (\",[\"$\",\"span\",null,{\"className\":\"hyphens-manual\",\"children\":\"net.jogtar.hu\"}],\") az Mt. mai szövegének hatálya nyitott végű (2026. október 1-jétől), későbbi kihirdetett módosítás nincs benne. A 2026. november 5-i országgyűlési irományok listáján (35 törvényjavaslat) nincs olyan javaslat, amely a szabadság szabályait (Mt. 115-121. §) módosítaná. A szabadság napjainak száma 2027-ben tehát a mai szabályok szerint számolható, ezt a kihirdetésig tekintjük érvényesnek.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"$L46\",\" A 2026. évi LXXII. törvény 3. §-a az Mt. 102. § (1) bekezdését így állapítja meg: \\\"Munkaszüneti nap: január 1., március 15., nagypéntek, húsvéthétfő, május 1., pünkösdhétfő, augusztus 20., október 23., november 1. és december 24-26.\\\" A törvényt az Országgyűlés 2026. november 3-án fogadta el, a Magyar Közlöny 2026. évi 171. számában, 2026. november 13-án hirdették ki, és a záró rendelkezése szerint a kihirdetését követő napon lépett hatályba, vagyis 2026. november 14-től hatályos. A javaslat korábbi állapotát (T/714.) ezzel a kihirdetett szöveggel vetettük össze; a lényeges rendelkezések azonosak.\"]}],\"\\n\",\"$L47\",\"\\n\",\"$L48\",\"\\n\",\"$L49\",\"\\n\",\"$L4a\",\"\\n\",\"$L4b\",\"\\n\",\"$L4c\",\"\\n\",\"$L4d\",\"\\n\",\"$L4e\",\"\\n\",\"$L4f\",\"\\n\",\"$L50\",\"\\n\",\"$L51\",\"\\n\",\"$L52\",\"\\n\",\"$L53\",\"\\n\",\"$L54\"]\n3f:null\n55:Ta8d,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Hány nap szabadság jár 2027-ben?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Az alapszabadság húsz munkanap (Mt. 116. §), ehhez jön az életkori pótszabadság: a 25. életévtől egy, a 45. életévtől tíz munkanap (Mt. 117. § (1)). A 2027-ben betöltött életkor számít, vagyis 2027 mínusz a születési éved (Mt. 117. § (2)). Gyermek, fogyatékosság és más okok miatt további pótszabadság járhat.\"}},{\"@type\":\"Question\",\"name\":\"Melyik életkor számít, a mostani vagy a 2027-ben betöltött?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A 2027-ben betöltött. A hosszabb tartamú pótszabadság abban az évben jár először, amelyben az adott életkort betöltöd, és az egész évre jár (Mt. 117. § (2)).\"}},{\"@type\":\"Question\",\"name\":\"Hogyan számolja a kalkulátor a 2027-es szabadságot?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A szabadság kalkulátor a naptári évvel és a megadott születési dátummal számol: a 2027-ben betöltött életkort a 2027 mínusz a születési év adja. Amíg 2026 van, a kalkulátor a 2026-os évet mutatja; a 2027-es értéket a cikkbeli táblázatból olvashatod ki.\"}},{\"@type\":\"Question\",\"name\":\"Munkaszüneti nap december 24-e?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Igen. A december 24-ét munkaszüneti nappá nyilvánító 2026. évi LXXII. törvényt a Magyar Közlöny 2026. évi 171. számában, 2026. november 13-án kihirdették, és a kihirdetését követő napon, 2026. november 14-én hatályba lépett. Az Mt. 102. § (1) bekezdése szerint a munkaszüneti napok: január 1., március 15., nagypéntek, húsvéthétfő, május 1., pünkösdhétfő, augusztus 20., október 23., november 1. és december 24-26. A 2026-os átmeneti szabályt az Mt. hatálybalépésével összefüggő 2012. évi LXXXVI. törvény 19/G. §-a adja.\"}},{\"@type\":\"Question\",\"name\":\"Jár pótszabadság a gyermek után?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Igen, a 16 évnél fiatalabb gyermek után: egy gyermek után kettő, két gyermek után négy, kettőnél több gyermek után összesen hét munkanap (Mt. 118. § (1)). Fogyatékos gyermekenként további két munkanap jár (Mt. 118. § (2)).\"}},{\"@type\":\"Question\",\"name\":\"Kinek jár még pótszabadság?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A fiatal munkavállalónak évenként öt munkanap, utoljára abban az évben, amelyben a 18. életévét betölti (Mt. 119. § (1)). A megváltozott munkaképességű, a fogyatékossági támogatásra jogosult és a vakok személyi járadékára jogosult munkavállalónak évenként öt munkanap (Mt. 120. §).\"}}]}40:[\"$\",\"section\",null,{\"className\":\"ak-faq\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$55\"}}],[\"$\",\"h2\",null,{\"id\":\"gyik\",\"children\":\"Gyakori kérdések\"}],[[\"$\",\"details\",\"0\",{\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Hány nap szabadság jár 2027-ben?\",[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"m6 9 6 6 6-6\",\"key\":\"qrunsl\"}]],\"className\":\"lucide-chevron-down\",\"width\":20,\"height\":20,\"aria-hidden\":\"true\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"Az alapszabadság húsz munkanap (Mt. 116. §), ehhez jön az életkori pótszabadság: a 25. életévtől egy, a 45. életévtől tíz munkanap (Mt. 117. § (1)). A 2027-ben betöltött életkor számít, vagyis 2027 mínusz a születési éved (Mt. 117. § (2)). Gyermek, fogyatékosság és más okok miatt további pótszabadság járhat.\"]]}]]}],[\"$\",\"details\",\"1\",{\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Melyik életkor számít, a mostani vagy a 2027-ben betöltött?\",\"$L56\"]}],\"$L57\"]}],\"$L58\",\"$L59\",\"$L5a\",\"$L5b\"]]}]\n41:[\"$\",\"$L5c\",null,{\"slug\":\"szabadsag-2027\"}]\n42:[\"$\",\"div\",null,{\"className\":\"my-8 rounded-lg border border-gray-200 bg-gray-50 text-sm text-gray-600\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start gap-2.5 p-4\",\"children\":[[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\",\"key\":\"1s2grr\"}],[\"path\",{\"d\":\"M20 2v4\",\"key\":\"1rf3ol\"}],[\"path\",{\"d\":\"M22 4h-4\",\"key\":\"gwowj6\"}],[\"circle\",{\"cx\":\"4\",\"cy\":\"20\",\"r\":\"2\",\"key\":\"6kqj1y\"}]],\"className\":\"lucide-sparkles w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 [overflow-wrap:anywhere]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-gray-700 mb-1\",\"children\":\"Mesterséges intelligencia közreműködésével készült\"}],[\"$\",\"p\",null,{\"className\":\"leading-relaxed\",\"children\":\"Ez a cikk AI segítségével, szerkesztői ellenőrzés mellett készült. Törekszünk a pontosságra és a naprakészségre, de előfordulhatnak hibák, félreértések vagy időközben elavult részek, ezért fokozott óvatossággal kezeld, és fontos döntés előtt mindig ellenőrizd az információt hivatalos forrásból.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-start gap-2.5 p-4 border-t border-gray-200\",\"children\":[[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"circle\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\",\"key\":\"1mglay\"}],[\"path\",{\"d\":\"M12 16v-4\",\"key\":\"1dtifu\"}],[\"path\",{\"d\":\"M12 8h.01\",\"key\":\"e9boi3\"}]],\"className\":\"lucide-info w-4 h-4 text-gray-500 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 [overflow-wrap:anywhere]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-gray-700 mb-1\",\"children\":\"Tájékoztató jellegű tartalom\"}],[\"$\",\"p\",null,{\"className\":\"leading-relaxed\",\"children\":\"Az oldalon megjelenő információk általános, oktatási célú tájékoztatást nyújtanak, és nem minősülnek jogi, munkajogi, adó- vagy pénzügyi (befektetési) tanácsadásnak. Döntés előtt ellenőrizd az aktuális szabályokat, vagy fordulj szakképzett szakértőhöz.\"}]]}]]}]]}]\n43:[\"$\",\"$L5d\",null,{\"source\":\"cikk\",\"kind\":\"cikk\",\"tool\":\"szabadsag-2027\"}]\n44:[\"$\",\"aside\",null,{\"className\":\"ak-article__rail ak-article__aside ak-stack\",\"aria-label\":\"Kapcsolódó eszköz: Bruttó-nettó kalkulátor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ak-card ak-stack\",\"style\":{\"gap\":12},\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"ak-icon-tile\",\"children\":[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$8:props:children:2:props:children:props:notFound:0:props:children:1:props:children:1:props:children:0:props:children:0:props:children:props:iconNode\",\"className\":\"lucide-calculator\",\"width\":22,\"height\":22}]}],\"$undefined\",[\"$\",\"strong\",null,{\"children\":\"Bruttó-nettó kalkulátor\"}],[\"$\",\"span\",null,{\"className\":\"ak-card__text\",\"children\":\"Nézd meg, mennyi marad a fizetésedből.\"}],[\"$\",\"$L22\",null,{\"href\":\"/kalkulator/brutto-netto\",\"className\":\"ak-btn ak-btn--primary ak-btn--block\",\"children\":\"Kiszámolom\"}]]}]}]\n45:[\"$\",\"section\",null,{\"className\":\"ak-band\",\"children\":[\"$\",\"div\",null,{\"className\":\"ak-container ak-section\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ak-section-head\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"ak-h2\",\"children\":\"Ezek is érdekelhetnek\"}],[\"$\",\"$L22\",null,{\"href\":\"/kategoria/munkaszerzodesek\",\"className\":\"ak-more\",\"children\":[\"Munkajog\",\" \",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"→\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"ak-grid ak-grid--3\",\"children\":[[\"$\",\"$L22\",\"szabadsag-napok-szama-2026\",{\"href\":\"/szabadsag-napok-szama-2026\",\"className\":\"ak-card ak-card--flat ak-card--link\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"alignSelf\":\"flex-start\"},\"children\":[\"$\",\"span\",null,{\"className\":\"ak-badge ak-badge--cat\",\"children\":\"Munkajog\"}]}],[\"$\",\"div\",null,{\"className\":\"ak-card__title\",\"children\":\"Hány nap szabadság jár 2026-ban? Alap- és pótszabadság táblázat\"}],[\"$\",\"div\",null,{\"className\":\"ak-card__meta\",\"children\":[5,\" perc olvasás\"]}]]}],[\"$\",\"$L22\",\"potszabadsag-eletkor-szerint-2026\",{\"href\":\"/potszabadsag-eletkor-szerint-2026\",\"className\":\"ak-card ak-card--flat ak-card--link\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"alignSelf\":\"flex-start\"},\"children\":[\"$\",\"span\",null,{\"className\":\"ak-badge ak-badge--cat\",\"children\":\"Munkajog\"}]}],[\"$\",\"div\",null,{\"className\":\"ak-card__title\",\"children\":\"Pótszabadság 2026: hány nap jár életkor szerint?\"}],[\"$\",\"div\",null,{\"className\":\"ak-card__meta\",\"children\":[7,\" perc olvasás\"]}]]}],[\"$\",\"$L22\",\"tavolleti-dij-2026\",{\"href\":\"/tavolleti-dij-2026\",\"className\":\"ak-card ak-card--flat ak-card--link\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"alignSelf\":\"flex-start\"},\"children\":[\"$\",\"span\",null,{\"className\":\"ak-badge ak-badge--cat\",\"children\":\"Munkajog\"}]}],[\"$\",\"div\",null,{\"className\":\"ak-card__title\",\"children\":\"Távolléti díj 2026: mikor jár, mi számít bele, és hogyan számolják\"}],[\"$\",\"div\",null,{\"className\":\"ak-card__meta\",\"children\":[6,\" perc olvasás\"]}]]}]]}],[\"$\",\"div\",null,{\"style\":{\"marginTop\":32},\"children\":[[\"$\",\"h3\",null,{\"className\":\"ak-h4\",\"style\":{\"marginBottom\":12},\"children\":\"További kapcsolódó cikkek\"}],[\"$\",\"ul\",null,{\"style\":{\"margin\":0,\"paddingLeft\":20,\"listStyle\":\"disc\"},\"children\":[[\"$\",\"li\",\"kozos-megegyezes-munkaviszony-megszuntetese-2026\",{\"style\":{\"marginBottom\":6},\"children\":[\"$\",\"$L22\",null,{\"href\":\"/kozos-megegyezes-munkaviszony-megszuntetese-2026\",\"style\":{\"color\":\"var(--ak-primary-strong)\",\"textDecoration\":\"underline\",\"textUnderlineOffset\":3},\"children\":\"Közös megegyezés a munkaviszony megszüntetésére 2026: minta és menete\"}]}],[\"$\",\"li\",\"2027-valtozasok-statusz\",{\"style\":{\"marginBottom\":6},\"children\":[\"$\",\"$L22\",null,{\"href\":\"/2027-valtozasok-statusz\",\"style\":{\"color\":\"var(--ak-primary-strong)\",\"textDecoration\":\"underline\",\"textUnderlineOffset\":3},\"children\":\"2027: mi változik, és hol tart?\"}]}]]}]]}]]}]}]\n46:[\"$\",\"strong\",null,{\"children\":\"December 24. munkaszüneti nap (kihirdetve, hatályos).\"}]\n47:[\"$\",\"p\",null,{\"children\":[\"Mit jelent ez a szabadságnál? A szabadságot a munkaidő-beosztás szerinti munkanapokra kell kiadni (Mt. 124. § (1)), egyenlőtlen munkaidő-beosztás esetén pedig a munkaszüneti nap nem számít munkanapnak a szabadság kiadásakor (Mt. 124. § (2)). 2027-ben december 24. péntekre esik (számítás), ezért december 24-ére a munkaszüneti nap szabályai vonatkoznak: nem kell rá szabadságot kivenni. A törvény átmeneti szabályt is tartalmaz a 2026. december 24-re és 12-re a folyamatban lévő munkaidőkeretre (a 2012. évi LXXXVI. törvény 19/G. §-a); ezt a 2027-es szabadság nem érinti. A december 24-i változásról részletesen: \",[\"$\",\"$L22\",null,{\"href\":\"/december-24-munkaszuneti-nap\",\"children\":\"December 24. munkaszüneti nap: mit jelent a munkavállalónak?\"}],\".\"]}]\n48:[\"$\",\"p\",null,{\"children\":\"A 2027. évi munkaszüneti napok körüli munkarendről szóló miniszteri rendeletet még nem találtunk; ha megjelenik, ide is felvesszük.\"}]\n49:[\"$\",\"h2\",null,{\"id\":\"gyermek-utan-jaro-potszabadsag\",\"children\":\"Gyermek után járó pótszabadság\"}]\n4a:[\"$\",\"p\",null,{\"children\":\"A 16 évnél fiatalabb gyermek után (Mt. 118. § (1)):\"}]\n4b:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"egy gyermek után 2 munkanap;\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"két gyermek után 4 munkanap;\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"kettőnél több gyermek után összesen 7 munkanap.\"}],\"\\n\"]}]\n4c:[\"$\",\"p\",null,{\"children\":\"Ha a gyermek fogyatékos, a pótszabadság gyermekenként két munkanappal nő (Mt. 118. § (2)). A gyermeket először a születése évében, utoljára abban az évben kell figyelembe venni, amelyben a 16. életévét betölti (Mt. 118. § (3)).\"}]\n4d:[\"$\",\"h2\",null,{\"id\":\"tovabbi-potszabadsagok\",\"children\":\"További pótszabadságok\"}]\n4e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Fiatal munkavállaló:\"}],\" évenként 5 munkanap, utoljára abban az évben, amelyben a 18. életévét betölti (Mt. 119. § (1)).\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Föld alatt vagy ionizáló sugárzásnak kitett munkahelyen\"}],\" naponta legalább három órát dolgozó munkavállaló: évenként 5 munkanap (Mt. 119. § (2)).\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Megváltozott munkaképességű, fogyatékossági támogatásra vagy vakok személyi járadékára jogosult munkavállaló:\"}],\" évenként 5 munkanap (Mt. 120. §).\"]}],\"\\n\"]}]\n4f:[\"$\",\"h2\",null,{\"id\":\"ha-ev-kozben-kezdesz-vagy-szunik-meg-a-munkaviszonyod\",\"children\":\"Ha év közben kezdesz vagy szűnik meg a munkaviszonyod\"}]\n50:[\"$\",\"p\",null,{\"children\":[\"Ha a munkaviszonyod év közben kezdődik vagy szűnik meg, a szabadság arányos része jár, az apasági és a szülői szabadság kivételével. A fél napot elérő töredéknap egész munkanapnak számít (Mt. 121. §). A ki nem adott arányos szabadságot a megszűnéskor meg kell váltani (Mt. 125. §). Erről részletesen a \",[\"$\",\"$L22\",null,{\"href\":\"/kozos-megegyezes-munkaviszony-megszuntetese-2026\",\"children\":\"közös megegyezés\"}],\" cikkben írtunk.\"]}]\n51:[\"$\",\"h2\",null,{\"id\":\"a-szabadsag-kiadasa\",\"children\":\"A szabadság kiadása\"}]\n52:[\"$\",\"p\",null,{\"children\":\"A szabadságot a munkáltató adja ki, a munkavállaló előzetes meghallgatása után (Mt. 122. § (1)). Évente hét munkanap szabadságot a munkaviszony első három hónapját kivéve a munkavállaló kérésének megfelelő időpontban, legfeljebb két részletben kell kiadni, ha az igényét legalább tizenöt nappal a szabadság kezdete előtt bejelenti (Mt. 122. § (2)). Eltérő megállapodás hiányában úgy kell kiadni, hogy naptári évenként egy alkalommal legalább tizennégy egybefüggő napra mentesülj a munkavégzési és rendelkezésre állási kötelezettség alól (Mt. 122. § (3)).\"}]\n53:[\"$\",\"p\",null,{\"children\":[\"A szabadság alatt távolléti díj jár, ennek számítását a \",[\"$\",\"$L22\",null,{\"href\":\"/tavolleti-dij-2026\",\"children\":\"távolléti díj 2026\"}],\" cikkben találod. A szabadságod beosztásához a \",[\"$\",\"$L22\",null,{\"href\":\"/kalkulator/szabadsag-tervezo\",\"children\":\"szabadság tervező\"}],\" nyújt segítséget. A 2026-os szabályokról és a részletes példákról a \",[\"$\",\"$L22\",null,{\"href\":\"/szabadsag-napok-szama-2026\",\"children\":\"Hány nap szabadság jár 2026-ban?\"}],\" és a \",[\"$\",\"$L22\",null,{\"href\":\"/potszabadsag-eletkor-szerint-2026\",\"children\":\"Pótszabadság életkor szerint\"}],\" cikkben olvashatsz.\"]}]\n54:[\"$\",\"p\",null,{\"children\":\"A cikk a hatályos jogszabályi szöveget összegzi, a pontos összeget és a napok számát a munkáltatód számítása adja.\"}]\n56:[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$40:props:children:2:0:props:children:0:props:children:1:props:iconNode\",\"className\":\"lucide-chevron-down\",\"width\":20,\"height\":20,\"aria-hidden\":\"true\"}]\n57:[\"$\",\"p\",null,{\"children\":[[\"A 2027-ben betöltött. A hosszabb tartamú pótszabadság abban az évben jár először, amelyben az adott életkort betöltöd, és az egész évre jár (Mt. 117. § (2)).\"]]}]\n58:[\"$\",\"details\",\"2\",{\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Hogyan számolja a kalkulátor a 2027-es szabadságot?\",[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$40:props:children:2:0:props:children:0:props:children:1:props:iconNode\",\"className\":\"lucide-chevron-down\",\"width\":20,\"height\":20,\"aria-hidden\":\"true\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"A szabadság kalkulátor a naptári évvel és a megadott születési dátummal számol: a 2027-ben betöltött életkort a 2027 mínusz a születési év adja. Amíg 2026 van, a kalkulátor a 2026-os évet mutatja; a 2027-es értéket a cikkbeli táblázatból olvashatod ki.\"]]}]]}]\n59:[\"$\",\"details\",\"3\",{\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Munkaszüneti nap december 24-e?\",[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$40:props:children:2:0:props:children:0:props:children:1:props:iconNode\",\"className\":\"lucide-chevron-down\",\"width\":20,\"height\":20,\"aria-hidden\":\"true\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"Igen. A december 24-ét munkaszüneti nappá nyilvánító 2026. évi LXXII. törvényt a Magyar Közlöny 2026. évi 171. számában, 2026. november 13-án kihirdették, és a kihirdetését követő napon, 2026. november 14-én hatályba lépett. Az Mt. 102. § (1) bekezdése szerint a munkaszüneti napok: január 1., március 15., nagypéntek, húsvéthétfő, május 1., pünkösdhétfő, augusztus 20., október 23., november 1. és december 24-26. A 2026-os átmeneti szabályt az Mt. hatálybalépésével összefüggő 2012. évi LXXXVI. törvény 19/G. §-a adja.\"]]}]]}]\n5a:[\"$\",\"details\",\"4\",{\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Jár pótszabadság a gyermek után?\",[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$40:props:children:2:0:props:children:0:props:children:1:props:iconNode\",\"className\":\"lucide-chevron-down\",\"width\":20,\"height\":20,\"aria-hidden\":\"true\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"Igen, a 16 évnél fiatalabb gyermek után: egy gyermek után kettő, két gyermek után négy, kettőnél több gyermek után összesen hét munkanap (Mt. 118. § (1)). Fogyatékos gyermekenként további két munkanap jár (Mt. 118. § (2)).\"]]}]]}]\n5b:[\"$\",\"details\",\"5\",{\"children\":[[\"$\",\"summary\",null,{\"children\":[\"Kinek jár még pótszabadság?\",[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":\"$40:props:children:2:0:props:children:0:props:children:1:props:iconNode\",\"className\":\"lucide-chevron-down\",\"width\":20,\"height\":20,\"aria-hidden\":\"true\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"A fiatal munkavállalónak évenként öt munkanap, utoljára abban az évben, amelyben a 18. életévét betölti (Mt. 119. § (1)). A megváltozott munkaképességű, a fogyatékossági támogatásra jogosult és a vakok személyi járadékára jogosult munkavállalónak évenként öt munkanap (Mt. 120. §).\"]]}]]}]\n32:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n5e:I[27201,[\"$1b\"],\"IconMark\"]\n2f:null\n35:[[\"$\",\"title\",\"0\",{\"children\":\"Szabadság 2027: hány nap jár, és mi változik? | ÁllásKisokos\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Szabadság 2027: hány nap jár életkor szerint, a 2027-ben betöltött kor táblázata, a gyermek utáni és egyéb pótszabadságok, és mit mond a hatályos Mt. a 2027-es évre.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"szabadság 2027,szabadság kalkulátor 2027,hány nap szabadság jár 2027,pótszabadság 2027,életkor szerinti szabadság 2027\"}],[\"$\",\"meta\",\"3\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.allaskisokos.hu/szabadsag-2027\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Szabadság 2027: hány nap jár, és mi változik?\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Szabadság 2027: hány nap jár életkor szerint, a 2027-ben betöltött kor táblázata, a gyermek utáni és egyéb pótszabadságok, és mit mond a hatályos Mt. a 2027-es évre.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:url\",\"content\":\"https://www.allaskisokos.hu/szabadsag-2027\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:site_name\",\"content\":\"ÁllásKisokos.hu\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:locale\",\"content\":\"hu_HU\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image\",\"content\":\"https://www.allaskisokos.hu/szabadsag-2027/opengraph-image?a32b64af4bdfa70b\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:alt\",\"content\":\"ÁllásKisokos.hu cikk\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"16\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-17\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:title\",\"content\":\"Szabadság 2027: hány nap jár, és mi változik?\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:description\",\"content\":\"Szabadság 2027: hány nap jár életkor szerint, a 2027-ben betöltött kor táblázata, a gyermek utáni és egyéb pótszabadságok, és mit mond a hatályos Mt. a 2027-es évre.\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:image\",\"content\":\"https://www.allaskisokos.hu/szabadsag-2027/opengraph-image?a32b64af4bdfa70b\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:image:alt\",\"content\":\"ÁllásKisokos.hu cikk\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.14tp2zn87g3jy.ico\",\"sizes\":\"32x32\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"26\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"32x32\"}],[\"$\",\"link\",\"27\",{\"rel\":\"icon\",\"href\":\"/icon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"28\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png\"}],[\"$\",\"$L5e\",\"29\",{}]]\n"])</script></body></html>