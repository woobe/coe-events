    <script>
    function iPM() {
        let css = "";
        const t = ['padding', 'margin'];
        for (let e of t) {
            for (let i = 0; i <= 64; i += 4) {
                css += `
                    .${e[0]}-${i}{${e}:${i}px}
                    .${e[0]}b-${i}{${e}-bottom:${i}px}
                    .${e[0]}t-${i}{${e}-top:${i}px}
                    .${e[0]}l-${i}{${e}-left:${i}px}
                    .${e[0]}r-${i}{${e}-right:${i}px}
                    .${e[0]}x-${i}{${e}-left:${i}px;${e}-right:${i}px}
                    .${e[0]}y-${i}{${e}-top:${i}px;${e}-bottom:${i}px}`;
            }
        }

        const style = document.createElement('style');
        style.type = 'text/css';
        style.textContent = css;
        document.head.appendChild(style);
    }
    iPM();

</script>        <!-- Global site tag (gtag.js) - Google Analytics -->
