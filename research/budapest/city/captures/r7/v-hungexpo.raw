	<script id="hungexpo-consent-bootstrap">/** Consent Mode v2 bridge. Render synchronously before any measurement tags. */
(function (window, document) {
	'use strict';
	if (window.hungexpoConsent) return;
	window.dataLayer = window.dataLayer || [];
	window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
	var denied = {
		ad_storage: 'denied', analytics_storage: 'denied',
		ad_user_data: 'denied', ad_personalization: 'denied',
		functionality_storage: 'denied', personalization_storage: 'denied', security_storage: 'granted'
	};
	window.gtag('consent', 'default', Object.assign({ wait_for_update: 2000 }, denied));
	window.gtag('set', 'ads_data_redaction', true);
	// Cross-domain decoration is handled below with explicit consent checks.
	window.gtag('set', 'url_passthrough', false);
	var categories = {};
	var ready = false;
	var acted = false;
	var previous = null;
	var timer;
	var pending = [];
	var consentCookie = null;
	function cookies() { try { return document.cookie || ''; } catch (error) { return ''; } }
	function cookieValue() { return cookies().split(';').map(function (part) { return part.trim(); }).filter(function (part) { return part.indexOf('cookieyes-consent=') === 0; }).join(';'); }
	function own(object, key) { return Object.prototype.hasOwnProperty.call(object, key); }
	function yes(value) { return value === true || value === 'yes'; }
	function read() {
		try {
			if (typeof window.getCkyConsent === 'function') {
				var consent = window.getCkyConsent();
				if (consent && consent.categories) return { categories: consent.categories, acted: consent.isUserActionCompleted === true };
			}
			var store = window.cookieyes && window.cookieyes._ckyConsentStore;
			if (store && typeof store.forEach === 'function') {
				var result = {};
				store.forEach(function (value, key) { result[key] = value; });
				return { categories: result, acted: store.get('action') === 'yes' };
			}
		} catch (error) { /* An unavailable CMP must never grant consent. */ }
		return null;
	}
	// CookieYes category IDs are not Google consent types. Keep the translation
	// explicit: the current banner groups analytics and advertising as marketing.
	// First present category wins, including an explicit denial in a granular CMP.
	var categoryAliases = {
		analytics: ['analytics', 'marketing'],
		advertisement: ['advertisement', 'marketing'],
		functional: ['functional']
	};
	var googleConsentCategories = {
		analytics_storage: 'analytics',
		ad_storage: 'advertisement',
		ad_user_data: 'advertisement',
		ad_personalization: 'advertisement',
		functionality_storage: 'functional',
		personalization_storage: 'functional'
	};
	function hasConsent(type) {
		if (!ready || !acted || (consentCookie !== null && consentCookie !== cookieValue())) return false;
		if (type === 'marketing') {
			// Legacy embeds may contain both analytics and advertising tags.
			return hasConsent('analytics') && hasConsent('advertisement');
		}
		var aliases = own(categoryAliases, type) ? categoryAliases[type] : [type];
		for (var i = 0; i < aliases.length; i += 1) {
			if (own(categories, aliases[i])) return yes(categories[aliases[i]]);
		}
		return false;
	}
	function state() {
		var result = {};
		Object.keys(googleConsentCategories).forEach(function (type) {
			result[type] = hasConsent(googleConsentCategories[type]) ? 'granted' : 'denied';
		});
		// Essential security storage is not permission for optional processing.
		// Neither szukseges nor necessary grants functional/personalization storage.
		result.security_storage = 'granted';
		return result;
	}
	function clearTrackingCookies(next) {
		var domains = [null];
		var labels = window.location.hostname.split('.');
		for (var i = 0; i < labels.length - 1; i += 1) domains.push(labels.slice(i).join('.'));
		var paths = ['/'];
		var parts = window.location.pathname.split('/');
		for (var j = 1; j < parts.length; j += 1) {
			var path = parts.slice(0, j + 1).join('/');
			paths.push(path, path + '/');
		}
		cookies().split(';').forEach(function (entry) {
			var name = entry.split('=')[0].trim();
			var analytics = /^(_ga(?:_|$)|_gid$|_gat(?:_|$))/.test(name);
			var advertising = /^(_gcl_|_gac_|_fbp$|_fbc$|_rdt_|_uetsid$|_uetvid$|_ttp$|_pin_unauth$)/.test(name);
			if (!(analytics && next.analytics_storage === 'denied') && !(advertising && next.ad_storage === 'denied')) return;
			paths.forEach(function (path) {
				domains.forEach(function (domain) {
					try { document.cookie = name + '=; Max-Age=0; Path=' + path + (domain ? '; Domain=' + domain : '') + '; SameSite=Lax'; } catch (error) { /* Browser may block cookie access. */ }
				});
			});
		});
	}
	function refresh(snapshot) {
		var current = snapshot || read();
		if (!current) {
			if (!ready) return;
			current = { categories: {}, acted: false };
		}
		consentCookie = cookieValue();
		categories = current.categories;
		acted = current.acted;
		ready = true;
		var next = state();
		if (JSON.stringify(next) === JSON.stringify(previous)) return;
		var revoked = previous && Object.keys(next).some(function (key) { return previous[key] === 'granted' && next[key] === 'denied'; });
		previous = next;
		window.gtag('consent', 'update', next);
		clearTrackingCookies(next);
		// Synchronous cleanup listeners run before tags or a CMP-triggered reload.
		document.dispatchEvent(new CustomEvent('hungexpo_consent_update', { detail: next }));
		window.dataLayer.push({ event: 'hungexpo_consent_update', consent: next });
		pending.forEach(function (load) { load(); });
		// Removing script nodes cannot stop third-party code already executing.
		if (revoked) window.setTimeout(function () { window.location.reload(); }, 0);
	}
	function onUpdate(event) {
		var detail = event.detail;
		if (detail && Array.isArray(detail.accepted) && Array.isArray(detail.rejected)) {
			var next = {};
			detail.accepted.forEach(function (key) { next[key] = true; });
			detail.rejected.forEach(function (key) { next[key] = false; });
			// Initial banner events are not a substitute for an explicit user action.
			var current = read();
			refresh({ categories: next, acted: current ? current.acted : true });
		} else refresh();
	}
	function poll() {
		// CookieYes keeps an in-memory snapshot; reload if another tab changes it.
		if (consentCookie !== null && consentCookie !== cookieValue()) {
			window.location.reload();
			return;
		}
		refresh();
		// Keep watching late CMP initialization and changes in another tab.
		timer = window.setTimeout(poll, ready ? 1000 : 250);
	}
	document.addEventListener('cookieyes_consent_update', onUpdate);
	document.addEventListener('cookieyes_banner_loaded', function () { refresh(); });
	window.addEventListener('pageshow', function () { window.clearTimeout(timer); poll(); });
	document.addEventListener('visibilitychange', function () {
		window.clearTimeout(timer);
		if (!document.hidden) poll();
	});
	window.hasConsent = hasConsent;
	window.updateGoogleConsent = function () { refresh(); };
	window.hungexpoConsent = { hasConsent: hasConsent, getState: state, isReady: function () { return ready; } };

	// Consent-gated legacy ACF embeds: load once, in order, also after late acceptance.
	window.checkAndLoadContent = function (type, id, attribute, targetLocation) {
		var container = document.getElementById(id);
		if (!container || container.getAttribute('data-consent-registered')) return;
		container.setAttribute('data-consent-registered', 'true');
		function load() {
			if (!hasConsent(type) || container.getAttribute('data-consent-loaded')) return;
			container.setAttribute('data-consent-loaded', 'true');
			var content = container.getAttribute(attribute) || '';
			// ACF stores HTML, not form-urlencoded text. Preserve literal + and % signs.
			if (/^%3[cC]/.test(content.trim())) {
				try { content = decodeURIComponent(content); } catch (error) { return; }
			}
			var template = document.createElement('template');
			template.innerHTML = content;
			var target = targetLocation === 'head' ? document.head : document.body;
			Array.from(template.content.childNodes).reduce(function (chain, element) {
				return chain.then(function () {
					if (!hasConsent(type)) return;
					if (element.nodeName !== 'SCRIPT') { target.appendChild(element.cloneNode(true)); return; }
					return new Promise(function (resolve) {
						var script = document.createElement('script');
						Array.from(element.attributes).forEach(function (attr) { script.setAttribute(attr.name, attr.value); });
						script.textContent = element.textContent;
						if (script.src) { script.async = false; script.onload = resolve; script.onerror = resolve; }
						target.appendChild(script);
						if (!script.src) resolve();
					});
				});
			}, Promise.resolve()).catch(function (error) { console.error('Consent-gated embed failed:', id, error); });
		}
		pending.push(load);
		load();
	};
	poll();
}(window, document));
