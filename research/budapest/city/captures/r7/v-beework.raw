  const consentValue = squarespaceCookies.marketing === 'accepted' ? 'granted' : 'denied';

  const consentObj = {

    'ad_storage': consentValue,

    'ad_user_data': consentValue,

    'ad_personalization': consentValue

  };

  gtag('consent', 'update', consentObj);

}

</script>

