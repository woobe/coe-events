<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>


<script>
(function() {
  function getLangFromPath() {
    var p = window.location.pathname.split("/");
    return (p[1] && p[1].length === 2) ? p[1].toLowerCase() : "hu";
  }

  document.addEventListener("DOMContentLoaded", function() {
    var lang = getLangFromPath();

    // 1) data-lang a <html>-re, hogy a CSS tudjon szűrni
    document.documentElement.setAttribute("data-lang", (lang === "en" ? "en" : "hu"));

    // 2) régi switcherek törlése (duplikáció ellen)
    document.querySelectorAll(".languageSwitcher").forEach(function(el){ el.remove(); });

    // 3) desktop switcher - a nav UTOLSÓ elemeként
    var desktopContainer = document.querySelector("div.header-nav > div");
    if (desktopContainer) {
      var switcher = document.createElement("div");
      switcher.className = "header-nav-item languageSwitcher";
      switcher.innerHTML = (lang === "en")
        ? '<a href="/hu/home/" class="lang-hu">[HU]</a>'
        : '<a href="/en/home/" class="lang-en">[EN]</a>';
      desktopContainer.appendChild(switcher);
    }

    // 4) mobile switcher
    var mobileContainer = document.querySelector("div.header-menu-nav");
    if (mobileContainer) {
      var mobileSwitch = document.createElement("div");
      mobileSwitch.className = "container header-menu-nav-item languageSwitcher";
      mobileSwitch.innerHTML = (lang === "en")
        ? '<a href="/hu/home/" class="lang-hu">[HU]</a>'
        : '<a href="/en/home/" class="lang-en">[EN]</a>';
      mobileContainer.appendChild(mobileSwitch);
    }

    // 5) CTA gomb szöveg + link (a te régi map-od logikájával)
    var map = {
      hu: { text: "Ajánlatot kérek", url: "/hu/ajanlatot-kerek" },
      en: { text: "Request a quote", url: "/en/request-a-quote" }
    };
    if (map[lang]) {
      document.querySelectorAll(".header-actions-action--cta .btn, .header-menu-cta .btn")
        .forEach(function(btn){
          btn.setAttribute("href", map[lang].url);
          btn.textContent = map[lang].text;
        });
    }

    // 6) Footer nyelvek elrejtése (javítva az ID-k alapján)
// EN footer id: 6368e61ac8b112394d0138b6
// HU footer id: 63341065a8c104320f7a067d
if (lang === "hu") {
  // HU oldalon az EN footert rejtsük
  var enFooter = document.querySelector('[data-section-id="6368e61ac8b112394d0138b6"]');
  if (enFooter) enFooter.style.display = "none";
}
if (lang === "en") {
  // EN oldalon a HU footert rejtsük
  var huFooter = document.querySelector('[data-section-id="63341065a8c104320f7a067d"]');
  if (huFooter) huFooter.style.display = "none";
}
  });
})();
</script>




<script>
  /* FORM FORDITASOK, ha... */
  // Get the current URL
  var currentUrl = window.location.href;

  // Check if the URL contains "/hu/"
  if (currentUrl.includes("/hu/")) {
    // Create a new style element
    var style = document.createElement('style');
    style.type = 'text/css';

    // Define the CSS rules with !important
    var css = `
/* First name - for /hu/ */
.field.first-name .caption-text {
visibility: hidden !important;
}
.field.first-name .caption-text:before {
visibility: visible !important;
content: "Keresztnév" !important;
}

/* Last name - for /hu/ */
.field.last-name .caption-text {
visibility: hidden !important;
}
.field.last-name .caption-text:before {
visibility: visible !important;
content: "Vezetéknév" !important;
}

/* required - for /hu/ */
.description.required {
visibility: hidden !important;
}
.description.required:before {
visibility: visible !important;
content: "(kötelező)" !important;
}
`;

    // Add the CSS rules to the style element
    if (style.styleSheet) {
      style.styleSheet.cssText = css;
    } else {
      style.appendChild(document.createTextNode(css));
    }

    // Append the style element to the document's head
    document.head.appendChild(style);
  }
