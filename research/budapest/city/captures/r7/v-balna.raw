2026" class="flatpickr-day" tabindex="-1">22</span><span aria-label="July 23, 2026" class="flatpickr-day" tabindex="-1">23</span><span aria-current="date" aria-label="July 24, 2026" class="flatpickr-day today" tabindex="-1">24</span><span aria-label="July 25, 2026" class="flatpickr-day" tabindex="-1">25</span><span aria-label="July 26, 2026" class="flatpickr-day" tabindex="-1">26</span><span aria-label="July 27, 2026" class="flatpickr-day" tabindex="-1">27</span><span aria-label="July 28, 2026" class="flatpickr-day" tabindex="-1">28</span><span aria-label="July 29, 2026" class="flatpickr-day" tabindex="-1">29</span><span aria-label="July 30, 2026" class="flatpickr-day" tabindex="-1">30</span><span aria-label="July 31, 2026" class="flatpickr-day" tabindex="-1">31</span><span aria-label="August 1, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">1</span><span aria-label="August 2, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">2</span><span aria-label="August 3, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">3</span><span aria-label="August 4, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">4</span><span aria-label="August 5, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">5</span><span aria-label="August 6, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">6</span><span aria-label="August 7, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">7</span><span aria-label="August 8, 2026" class="flatpickr-day nextMonthDay" tabindex="-1">8</span></div></div></div></div></div><div class="flatpickr-calendar hasTime noCalendar animate" tabindex="-1"><div class="flatpickr-time time24hr" tabindex="-1"><div class="numInputWrapper"><input aria-label="Hour" class="numInput flatpickr-hour" max="23" maxlength="2" min="0" step="1" tabindex="-1" type="number"/><span class="arrowUp"></span><span class="arrowDown"></span></div><span class="flatpickr-time-separator">:</span><div class="numInputWrapper"><input aria-label="Minute" class="numInput flatpickr-minute" max="59" maxlength="2" min="0" step="5" tabindex="-1" type="number"/><span class="arrowUp"></span><span class="arrowDown"></span></div></div></div>
<div id="custom-image-viewer" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.85); z-index:9999; justify-content:center; align-items:center;">
<span class="viewer-close" style="position:absolute; top:20px; right:30px; font-size:60px; color:white; cursor:pointer;">×</span>
<img alt="Bálna Honvédelmi központ" id="viewer-image" src="" style="max-width: 100vh;box-shadow: 0 0 20px black;transition: all 0.3s ease;margin: 0 auto;position: absolute;left: 0;top: 50%;left: 50%;transform: translate(-50%, -50%);"/>
<span class="viewer-prev" style="position: absolute;left: 30px;font-size: 50px;color: white;cursor: pointer;top: 50%;left: 15%;text-shadow: 0 0 10px black; transform: translateY(-50%);">❮</span>
<span class="viewer-next" style="position: absolute;right: 30px;font-size: 50px;color: white;cursor: pointer;top: 50%;right: 15%;text-shadow: 0 0 10px black; transform: translateY(-50%);">❯</span>
</div>
<div id="customLightbox" style="display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; z-index: 9999;"><button style="position: absolute; left: 30px; top: 50%; transform: translateY(-50%); font-size: 2rem; color: white; background: rgba(0, 0, 0, 0.4); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; padding: 0.5em 0.8em;">‹</button><img alt="Bálna Honvédelmi központ" style="max-width: 90%; max-height: 90%; border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.7) 0px 0px 20px;"/><button style="position: absolute; right: 30px; top: 50%; transform: translateY(-50%); font-size: 2rem; color: white; background: rgba(0, 0, 0, 0.4); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; padding: 0.5em 0.8em;">›</button></div><button class="scrollTopBtn show">↑</button><script src="../Public/customs/popup.js"></script>

<script id="hmz-menu-shim">
(function () {
  var SUB = ".hm-subMenu, .hm-subsubMenu, .hm-subsubsubMenu";

  function archiveRoot() {
    var parts = location.pathname.split("/").filter(Boolean);
    if (!parts.length) return "/";
    return "/" + parts[0] + "/";
  }
  function fixRootLinks(root) {
    document.querySelectorAll("a[href^='/']").forEach(function (a) {
      var href = a.getAttribute("href");
      if (!href || href.indexOf("//") === 0) return;
      if (href.indexOf(root) === 0) return;
      if (href === "/") {
        a.setAttribute("href", root);
        return;
      }
      a.setAttribute("href", root + href.replace(/^[/]+/, ""));
    });
  }
  /* SteveJs horizontalMenu mindig új .hm-container-t appendel → dupla menü. */
  function dedupeMenuContainers() {
    document.querySelectorAll(".menu, [data-cms-type='Menu']").forEach(function (menu) {
      var containers = Array.from(menu.querySelectorAll(":scope > .hm-container"));
      if (containers.length < 2) return;
      containers.slice(0, -1).forEach(function (c) { c.remove(); });
      var icons = Array.from(menu.querySelectorAll(":scope > .hm-menuIcon"));
      if (icons.length > 1) icons.slice(0, -1).forEach(function (i) { i.remove(); });
    });
  }
  function patchHorizontalMenu() {
    if (!window.jQuery || !jQuery.fn || !jQuery.fn.horizontalMenu || jQuery.fn._hmzMenuPatched) return;
    var orig = jQuery.fn.horizontalMenu;
    jQuery.fn.horizontalMenu = function (options) {
      this.each(function () {
        jQuery(this).children(".hm-container, .hm-menuIcon").remove();
      });
      return orig.apply(this, arguments);
    };
    jQuery.fn._hmzMenuPatched = true;
  }
  function isSubMenuEl(el) {
    return el && el.classList && (
      el.classList.contains("hm-subMenu")
      || el.classList.contains("hm-subsubMenu")
      || el.classList.contains("hm-subsubsubMenu")
    );
  }
  function ensureGroup(parent) {
    var group = parent.parentElement;
    if (group && group.classList.contains("hm-menuGroup")) return group;
    group = document.createElement("div");
    group.className = "hm-menuGroup";
    parent.parentNode.insertBefore(group, parent);
    group.appendChild(parent);
    return group;
  }
  function normalizeMenuDom() {
    document.querySelectorAll("a.hm-subMenuIcon, a.hm-menuItem").forEach(function (parent) {
      var nested = parent.querySelector(":scope > .hm-subMenu, :scope > .hm-subsubMenu, :scope > .hm-subsubsubMenu");
      if (!nested && !parent.classList.contains("hm-subMenuIcon")) return;
      if (!nested) {
        var nxt = parent.nextElementSibling;
        if (isSubMenuEl(nxt)) nested = nxt;
      }
      if (!nested) return;
      parent.classList.add("hm-subMenuIcon");
      var group = ensureGroup(parent);
      if (nested.parentElement !== group) {
        nested.parentNode.removeChild(nested);
        group.appendChild(nested);
      }
      Array.from(group.children).forEach(function (child) {
        if (child !== parent && child !== nested && isSubMenuEl(child)) child.remove();
      });
    });
  }
  function childMenus(item) {
    return item.querySelectorAll(":scope > .hm-subMenu, :scope > .hm-subsubMenu, :scope > .hm-subsubsubMenu");
  }
  function siblingMenus(item) {
    var found = [];
    var next = item.nextElementSibling;
    while (next) {
      if (isSubMenuEl(next)) {
        found.push(next);
        next = next.nextElementSibling;
        continue;
      }
      if (next.classList.contains("hm-menuItem") || next.classList.contains("hm-menuGroup")) break;
      next = next.nextElementSibling;
    }
    return found;
  }
  function groupMenus(item) {
    var group = item.closest && item.closest(".hm-menuGroup");
    if (!group) return [];
    return Array.from(group.querySelectorAll(":scope > .hm-subMenu, :scope > .hm-subsubMenu, :scope > .hm-subsubsubMenu"));
  }
  function findMenus(item) {
    var direct = Array.from(childMenus(item));
    if (direct.length) return direct;
    var group = groupMenus(item);
    if (group.length) return group;
    return siblingMenus(item);
  }
  function hasSubMenu(item) {
    return item.classList.contains("hm-subMenuIcon") || findMenus(item).length > 0;
  }
  function showSubMenus(item) {
    findMenus(item).forEach(function (sm) { sm.classList.add("hm-showSubMenu"); });
    item.classList.add("hm-open");
    var group = item.closest && item.closest(".hm-menuGroup");
    if (group) group.classList.add("hm-open");
  }
  function hideSubMenus(item) {
    findMenus(item).forEach(function (sm) { sm.classList.remove("hm-showSubMenu"); });
    item.classList.remove("hm-open");
    var group = item.closest && item.closest(".hm-menuGroup");
    if (group) group.classList.remove("hm-open");
  }
  function closeOthers(keep) {
    document.querySelectorAll(".hm-menuItem.hm-open").forEach(function (el) {
      if (el !== keep) hideSubMenus(el);
    });
  }
  function isSubMenuLink(target) {
    return target.closest && target.closest(
      ".hm-subMenu .hm-menuItem, .hm-subsubMenu .hm-menuItem, .hm-subsubsubMenu .hm-menuItem"
    );
  }
  function bindSubMenuPanel(item, panel) {
    if (panel._hmzSubBound) return;
    panel._hmzSubBound = true;
    panel.addEventListener("mouseenter", function () { showSubMenus(item); });
    panel.addEventListener("mouseleave", function (e) {
      if (e.relatedTarget && (item.contains(e.relatedTarget) || panel.contains(e.relatedTarget))) return;
      hideSubMenus(item);
    });
  }
  function bindGroup(group) {
    if (group._hmzGroupBound) return;
    var item = group.querySelector(":scope > .hm-menuItem, :scope > a.hm-subMenuIcon");
    if (!item || !hasSubMenu(item)) return;
    group._hmzGroupBound = true;
    group.addEventListener("mouseenter", function () { showSubMenus(item); });
    group.addEventListener("mouseleave", function (e) {
      if (e.relatedTarget && group.contains(e.relatedTarget)) return;
      hideSubMenus(item);
    });
  }

  function bindMenus() {
    document.querySelectorAll(".hm-menuItem").forEach(function (item) {
      item._hmzMenuBound = false;
    });
    document.querySelectorAll(".hm-menuGroup").forEach(function (g) {
      g._hmzGroupBound = false;
      Array.from(g.children).forEach(function (p) {
        if (isSubMenuEl(p)) p._hmzSubBound = false;
      });
    });
    document.querySelectorAll(".hm-menuGroup").forEach(bindGroup);
    document.querySelectorAll(".hm-menuItem").forEach(function (item) {
      if (!hasSubMenu(item) || item._hmzMenuBound) return;
      item._hmzMenuBound = true;
      var panels = findMenus(item);
      panels.forEach(function (panel) { bindSubMenuPanel(item, panel); });

      item.addEventListener("mouseenter", function () { showSubMenus(item); });
      item.addEventListener("mouseleave", function (e) {
        if (e.relatedTarget && (item.contains(e.relatedTarget)
            || panels.some(function (p) { return p.contains(e.relatedTarget); }))) return;
        var group = item.closest && item.closest(".hm-menuGroup");
        if (group && e.relatedTarget && group.contains(e.relatedTarget)) return;
        hideSubMenus(item);
      });

      item.addEventListener("click", function (e) {
        if (isSubMenuLink(e.target)) return;
        if (!hasSubMenu(item)) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        var open = item.classList.contains("hm-open");
        closeOthers(null);
        if (!open) showSubMenus(item);
      }, true);
    });
  }

  /* SteveJs .children('.hm-subMenu') nem látja a hm-menuGroup testvér panelt – patch. */
  function patchJQueryMenuLookup() {
    if (!window.jQuery || jQuery.fn._hmzChildrenPatched) return;
    var origChildren = jQuery.fn.children;
    jQuery.fn.children = function (selector) {
      var result = origChildren.apply(this, arguments);
      if (!selector || typeof selector !== "string") return result;
      if (result.length) return result;
      if (!/hm-sub/.test(selector)) return result;
      var extra = [];
      this.each(function () {
        var el = this;
        var next = el.nextElementSibling;
        if (next && next.matches && next.matches(selector)) extra.push(next);
        var group = el.parentElement;
        if (group && group.classList && group.classList.contains("hm-menuGroup")) {
          Array.prototype.forEach.call(group.children, function (child) {
            if (child !== el && child.matches && child.matches(selector)) extra.push(child);
          });
        }
      });
      if (!extra.length) return result;
      return jQuery(extra);
    };
    jQuery.fn._hmzChildrenPatched = true;
  }

  function boot() {
    patchHorizontalMenu();
    dedupeMenuContainers();
    fixRootLinks(archiveRoot());
    normalizeMenuDom();
    patchJQueryMenuLookup();
    bindMenus();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  setTimeout(boot, 0);
  setTimeout(boot, 300);
  setTimeout(boot, 1000);
  setTimeout(boot, 2500);
  setTimeout(boot, 5000);
})();
</script>

<script id="hmz-carousel-shim">
(function () {
  function convertAnchor(a) {
    if (!a || a.tagName !== "A") return;
    var href = a.getAttribute("href") || "";
    var div = document.createElement("div");
    div.className = a.className;
    if (href) {
      div.setAttribute("data-href", href);
      div.setAttribute("role", "link");
      div.tabIndex = 0;
    }
    Array.from(a.attributes).forEach(function (attr) {
      if (attr.name === "href" || attr.name === "class") return;
      div.setAttribute(attr.name, attr.value);
    });
    while (a.firstChild) div.appendChild(a.firstChild);
    if (a.parentNode) a.parentNode.replaceChild(div, a);
    return div;
  }
  function unwrapEmptyClickables(root) {
    root.querySelectorAll("a.carousel-clickable-item, div.carousel-clickable-item").forEach(function (el) {
      if (el.querySelector(".image, .carousel-item, .button, img")) return;
      if ((el.textContent || "").trim()) return;
      el.remove();
    });
  }
  function fixExhibitionCarousel() {
    var roots = document.querySelectorAll(
      "[data-cms-type='BalnaCarousel'] .carousel-container, .exhibition-halls-carousel"
    );
    roots.forEach(function (root) {
      Array.from(root.querySelectorAll("a.carousel-clickable-item")).forEach(convertAnchor);
      unwrapEmptyClickables(root);
      root.querySelectorAll(".carousel-item").forEach(function (item) {
        item.setAttribute("data-hmz-carousel-fixed", "1");
      });
    });
  }
  function patchCarouselScript() {
    document.addEventListener("click", function (e) {
      var hit = e.target.closest && e.target.closest(".carousel-clickable-item[data-href]");
      if (!hit) return;
      if (e.target.closest("a.button, a[href]")) return;
      var href = hit.getAttribute("data-href");
      if (href) location.href = href;
    });
  }
  function preventDoubleWrap() {
    var container = document.querySelector("div[data-name='BalnaCarousel415'] .carousel-container");
    if (!container || container._hmzCarouselPatched) return;
    container._hmzCarouselPatched = true;
    var mo = new MutationObserver(function () {
      fixExhibitionCarousel();
    });
    mo.observe(container, { childList: true, subtree: true });
    setTimeout(function () { mo.disconnect(); }, 4000);
  }
  function boot() {
    fixExhibitionCarousel();
    preventDoubleWrap();
    patchCarouselScript();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  setTimeout(boot, 0);
  setTimeout(boot, 200);
  setTimeout(boot, 800);
  setTimeout(boot, 2000);
})();
</script>

<script id="hmz-cookie-shim">
(function () {
  document.addEventListener("click", function (e) {
    var ok = e.target.closest && e.target.closest(".cookieBtnOK");
    if (ok) {
      e.preventDefault();
      e.stopImmediatePropagation();
      try { localStorage.setItem("isCookieAccepted", "true"); } catch (err) {}
      var bar = document.querySelector(".cookieBar");
      if (bar) bar.remove();
      return;
    }
    var info = e.target.closest && e.target.closest(".cookieBtnInfo");
    if (info) {
      e.preventDefault();
      e.stopImmediatePropagation();
      window.location.href = "cookie-iranyelvek/index.html";
    }
  }, true);
})();
</script>

<script id="hmz-offline-nav">
(function () {
  function isMenuParentWithSub(a) {
    if (a.classList.contains("hm-subMenuIcon")) return true;
    if (a.querySelector(":scope > .hm-subMenu, :scope > .hm-subsubMenu, :scope > .hm-subsubsubMenu")) return true;
    if (a.closest && a.closest(".hm-menuGroup")
        && a.closest(".hm-menuGroup").querySelector(":scope > .hm-subMenu, :scope > .hm-subsubMenu, :scope > .hm-subsubsubMenu")) {
      return true;
    }
    var next = a.nextElementSibling;
    return next && (next.classList.contains("hm-subMenu")
      || next.classList.contains("hm-subsubMenu")
      || next.classList.contains("hm-subsubsubMenu"));
  }
  function forceNativeNav(e) {
    var a = e.currentTarget;
    var href = a.getAttribute("href");
    if (!href || href.charAt(0) === "#" || href.indexOf("javascript:") === 0) return;
    if (a.classList.contains("cookieBtnOK") || a.classList.contains("cookieBtnInfo")) return;
    if (isMenuParentWithSub(a) && !e.target.closest(".hm-subMenu, .hm-subsubMenu, .hm-subsubsubMenu")) {
      return;
    }
    e.preventDefault();
    e.stopImmediatePropagation();
    window.location.href = href;
  }
  function bindNav() {
    document.querySelectorAll("a[href]").forEach(function (a) {
      if (a._hmzNavBound) return;
      a._hmzNavBound = true;
      a.addEventListener("click", forceNativeNav, true);
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindNav);
  } else {
    bindNav();
  }
  setTimeout(bindNav, 500);
})();
</script>
</body></html>