<style id="hmz-offline-nav">
.hm-menuGroup { position: relative !important; display: inline-block !important; }
.hm-menuGroup > .hm-subMenu,
.hm-menuGroup > .hm-subsubMenu,
.hm-menuGroup > .hm-subsubsubMenu {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    min-width: 100% !important;
}
.hm-menuIcon { display: none !important; }
.hm-container { display: flex !important; flex-wrap: wrap; justify-content: center; }
.menu, .menuContainer, .menuSection, .header { overflow: visible !important; }
.menu { position: relative; z-index: 50; }
.hm-menuItem { position: relative; }
.hm-subMenu, .hm-subsubMenu, .hm-subsubsubMenu { z-index: 100 !important; }
.hm-menuItem:hover > .hm-subMenu,
.hm-menuItem:focus-within > .hm-subMenu,
.hm-menuItem.hm-open > .hm-subMenu,
.hm-subMenuIcon:hover + .hm-subMenu,
.hm-subMenuIcon.hm-open + .hm-subMenu,
.hm-menuGroup:hover > .hm-subMenu,
.hm-menuGroup.hm-open > .hm-subMenu,
.hm-menuGroup .hm-subMenu:hover,
.hm-subMenu:hover,
.hm-showSubMenu {
    visibility: visible !important; opacity: 1 !important;
    transform: translateY(0) !important; display: flex !important;
    pointer-events: auto !important;
}
.hm-menuGroup { z-index: 200 !important; }
.hm-menuGroup > .hm-subMenu { pointer-events: auto !important; }
.hm-subMenu .hm-menuItem:hover > .hm-subsubMenu,
.hm-subMenu .hm-menuItem:focus-within > .hm-subsubMenu,
.hm-subMenu .hm-menuItem.hm-open > .hm-subsubMenu,
.hm-subMenu .hm-showSubMenu {
    visibility: visible !important; opacity: 1 !important;
    transform: translateY(0) !important; display: flex !important;
}
.hm-subMenuIcon.hm-open > .hm-subMenu,
.hm-subMenuIcon:hover > .hm-subMenu {
    visibility: visible !important; opacity: 1 !important;
    transform: translateY(0) !important; display: block !important;
}
@media (max-width: 1200px) {
    .hm-container { display: flex !important; flex-direction: column !important; width: 100% !important; }
    .hm-menuGroup { display: block !important; width: 100% !important; }
    .hm-menuGroup > .hm-subMenu,
    .hm-menuGroup > .hm-subsubMenu,
    .hm-menuGroup > .hm-subsubsubMenu {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        width: 100% !important;
    }
    .hm-subMenu, .hm-subsubMenu {
        display: none !important; position: relative !important;
        visibility: visible !important; opacity: 1 !important; transform: none !important;
    }
    .hm-menuItem.hm-open > .hm-subMenu,
    .hm-menuItem.hm-open > .hm-subsubMenu,
    .hm-subMenuIcon.hm-open + .hm-subMenu,
    .hm-subMenuIcon:hover + .hm-subMenu,
    .hm-showSubMenu { display: flex !important; }
}
</style>

<script id="hmz-early-menu-patch">
(function () {
  function patch() {
    if (!window.jQuery || !jQuery.fn || !jQuery.fn.horizontalMenu || jQuery.fn._hmzMenuPatched) return false;
    var orig = jQuery.fn.horizontalMenu;
    jQuery.fn.horizontalMenu = function (options) {
      this.each(function () {
        jQuery(this).children(".hm-container, .hm-menuIcon").remove();
      });
      return orig.apply(this, arguments);
    };
    jQuery.fn._hmzMenuPatched = true;
    return true;
  }
  if (patch()) return;
  var n = 0;
  var t = setInterval(function () {
    if (patch() || ++n > 80) clearInterval(t);
  }, 50);
})();
</script>

<script id="hmz-offline-api">
(function () {
  var API_ROOT = "../_api/";
  var apiIndex = {"/admin/menu/getMenuItems?contentId=305": "5e0c941ab512", "/admin/menu/getMenuItems": "2f1508adffa0", "/admin/popup": "4c5ce3d5c25f", "/admin/alert": "c1de6abc8355", "/admin/menu/getMenuItems?contentId=1516": "214d7300b681", "/admin/menu/getMenuItems?contentId=642": "23af713497ca", "/admin/booking/getBlockedDates": "9e0f17a0415e", "/admin/menu/getMenuItems?contentId=810": "b118e9f77734", "/getDataGridPage?id=1187&page=1&path=https%3A%2F%2Fbalnabudapest.hu%2Fhirek-osszes": "56e5396e45d4", "/getDataGridPage": "56e5396e45d4", "/admin/menu/getMenuItems?contentId=1163": "01d8de1e03c3", "/admin/menu/getMenuItems?contentId=1064": "2f1508adffa0", "/getThumbnails?id=136": "59d52d07e53d", "/getThumbnails": "c82c494bfec7", "/getThumbnails?id=118": "82bac15d82a5", "/getThumbnails?id=139": "f55b0c038725", "/getThumbnails?id=133": "9ca16a15e03c", "/getThumbnails?id=129": "3accf3d3461f", "/getThumbnails?id=119": "790a75c7715a", "/getThumbnails?id=120": "948f2edfb854", "/getThumbnails?id=121": "56c2c076db31", "/getThumbnails?id=135": "c82c494bfec7", "/admin/menu/getMenuItems?contentId=431": "ac83abefb662", "/admin/menu/getMenuItems?contentId=738": "a11413cc42a8", "/admin/menu/getMenuItems?contentId=949": "03ce0da125fd", "/admin/menu/getMenuItems?contentId=855": "d00ddc7700c2"};

  function lookupKey(pathname, body) {
    if (!pathname) return null;
    var isApi = pathname.indexOf("/admin/") !== -1
      || pathname.indexOf("getDataGridPage") !== -1
      || pathname.indexOf("getThumbnails") !== -1;
    if (!isApi) return null;
    var keys = [];
    if (body) keys.push(pathname + "?" + body);
    keys.push(pathname);
    for (var i = 0; i < keys.length; i++) {
      var hash = apiIndex[keys[i]];
      if (hash) return API_ROOT + hash + ".json";
    }
    return null;
  }

  function bodyToString(body) {
    if (!body) return "";
    if (typeof body === "string") return body;
    if (body instanceof FormData) {
      var parts = [];
      body.forEach(function (v, k) { parts.push(k + "=" + encodeURIComponent(v)); });
      return parts.join("&");
    }
    if (typeof body === "object") {
      return Object.keys(body).map(function (k) {
        return encodeURIComponent(k) + "=" + encodeURIComponent(body[k]);
      }).join("&");
    }
    return "";
  }

  function syncGet(url) {
    var sync = new XMLHttpRequest();
    sync.open("GET", url, false);
    sync.send(null);
    return sync.responseText;
  }

  function fulfillXhr(xhr, text) {
    Object.defineProperty(xhr, "responseText", { value: text, configurable: true });
    Object.defineProperty(xhr, "response", { value: text, configurable: true });
    Object.defineProperty(xhr, "status", { value: 200, configurable: true });
    Object.defineProperty(xhr, "readyState", { value: 4, configurable: true });
    if (xhr.onload) xhr.onload();
    if (xhr.onreadystatechange) xhr.onreadystatechange();
  }

  function interceptAjax(opts) {
    var url = typeof opts === "object" ? opts.url : opts;
    if (!url || (url.indexOf("/admin/") === -1 && url.indexOf("getDataGridPage") === -1)) return false;
    try {
      var u = new URL(url, window.location.href);
      var body = typeof opts === "object" ? bodyToString(opts.data) : "";
      var local = lookupKey(u.pathname, body);
      if (!local) return false;
      var text = syncGet(local);
      if (typeof opts === "object" && opts.success) opts.success(text);
      return true;
    } catch (e) {}
    return false;
  }

  var origOpen = XMLHttpRequest.prototype.open;
  var origSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (method, url, async) {
    this._hmzMethod = (method || "GET").toUpperCase();
    this._hmzUrl = url;
    this._hmzAsync = async !== false;
    return origOpen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function (body) {
    try {
      var u = new URL(this._hmzUrl, window.location.href);
      var bodyStr = bodyToString(body);
      var local = lookupKey(u.pathname, bodyStr);
      if (local) {
        var xhr = this;
        var text = syncGet(local);
        fulfillXhr(xhr, text);
        return;
      }
    } catch (e) {}
    return origSend.apply(this, arguments);
  };

  function patchJQuery() {
    if (!window.jQuery || !jQuery.ajax) return;
    var origAjax = jQuery.ajax;
    jQuery.ajax = function (opts) {
      if (typeof opts === "object" && interceptAjax(opts)) return;
      return origAjax.apply(this, arguments);
    };
  }
  patchJQuery();
  setTimeout(patchJQuery, 100);
  setTimeout(patchJQuery, 500);
})();
</script>
