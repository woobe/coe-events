						</label>
						<input type="email" autocomplete="email" class="form-control" id="email" name="email"
							placeholder="Provide your email address" required>
					</div>
					<div class="form-group mb-2">
						<p class="text-left font-600">
							Which hall(s) would you like to lease? (Non-obligatory)						</p>
					</div>
										<div class="form-group form-row mb-0">
												<div class="form-check col-lg-4">
							<input type="checkbox" class="form-check-input"
								id="check-mainhall"
								name="check-mainhall">
							<label class="form-check-label"
								for="check-mainhall">
								Main Hall							</label>
						</div>
												<div class="form-check col-lg-4">
							<input type="checkbox" class="form-check-input"
								id="check-smallhall"
								name="check-smallhall">
							<label class="form-check-label"
								for="check-smallhall">
								Small Hall							</label>
						</div>
												<div class="form-check col-lg-4">
							<input type="checkbox" class="form-check-input"
								id="check-lokalen"
								name="check-lokalen">
							<label class="form-check-label"
								for="check-lokalen">
								Lokál							</label>
						</div>
												<div class="form-check col-lg-4">
							<input type="checkbox" class="form-check-input"
								id="check-terrace"
								name="check-terrace">
							<label class="form-check-label"
								for="check-terrace">
								Terrace							</label>
						</div>
												<div class="form-check col-lg-4">
							<input type="checkbox" class="form-check-input"
								id="check-akvariumbistroen"
								name="check-akvariumbistroen">
							<label class="form-check-label"
								for="check-akvariumbistroen">
								Akvárium Bistro							</label>
						</div>
												<div class="form-check col-lg-4">
							<input type="checkbox" class="form-check-input"
								id="check-aranyhallconferencecenter"
								name="check-aranyhallconferencecenter">
							<label class="form-check-label"
								for="check-aranyhallconferencecenter">
								Aranyhall conference center							</label>
						</div>
											</div>
										<div class="form-group pt-2">
						<label for="message">
							Message *
						</label>
						<textarea class="form-control" name="message" id="message" rows="8" autocomplete="off"
							placeholder="Write a few sentences about the event and the time of booking!"
							required></textarea>
