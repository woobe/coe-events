        color: var(--text-color, inherit);
    }
    #agenda-tag-filter .agenda-tag-filter-toggle {
        border: none;
        background: transparent;
        font-weight: 600;
        padding: .35rem .5rem;
        color: inherit;
    }
    #agenda-tag-filter .agenda-tag-filter-clear {
        color: var(--text-color, inherit);
        border-color: currentColor;
        opacity: .8;
    }
    #agenda-tag-filter .agenda-tag-filter-clear:hover {
        color: var(--text-color, inherit);
        border-color: currentColor;
        opacity: 1;
    }
    #agenda-tag-filter .agenda-tag-filter-label,
    [data-agenda-view] .agenda-tag {
        text-transform: uppercase;
    }
    #agenda-tag-filter .agenda-tag-filter-label::before,
    [data-agenda-view] .agenda-tag::before {
        content: "#";
    }
    #agenda-tag-filter .agenda-tag-filter-chevron {
        transition: transform .2s ease;
        font-size: .8em;
    }
    #agenda-tag-filter .agenda-tag-filter-toggle[aria-expanded="true"] .agenda-tag-filter-chevron {
        transform: rotate(180deg);
    }
    #agenda-tag-filter .agenda-tag-filter-count {
        background-color: var(--primary-color, #0d6efd);
        color: #fff;
        font-size: .7rem;
    }
    #agenda-tag-filter .agenda-tag-filter-option {
        cursor: pointer;
        font-weight: 400;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .08);
        transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
    }
    #agenda-tag-filter .agenda-tag-filter-option.active {
        border-color: transparent !important;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .18);
    }
    #agenda-tag-filter .agenda-tag-filter-option.active .agenda-tag-filter-color {
        display: none;
    }
    #agenda-tag-filter .agenda-tag-filter-color {
        display: inline-block;
        width: .75rem;
        height: .75rem;
    }
    [data-agenda-view] .agenda-item-room-context {
        display: none;
    }
</style>
