                            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"
                                  data-agenda-booking-submit-spinner></span>
                            <span data-agenda-booking-submit-label>FOGLALOK</span>
                        </button>
                    </form>
                </div>
            </div>
