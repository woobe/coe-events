                         data-agenda-booking-error aria-live="assertive"></div>
                    <div class="alert alert-success d-none" role="status"
                         data-agenda-booking-success aria-live="polite"></div>
                    <div class="small text-muted mb-3" data-agenda-booking-availability
                         role="status" aria-live="polite"></div>
