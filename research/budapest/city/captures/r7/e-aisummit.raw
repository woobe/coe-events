                             alt="face">
                    </div>
                    <div>
                        <div
                            class="speaker-name"> Matěj Misař </div>
                        <div class="position">
                            A Carebot társalapítója és vezérigazgatója.<br>                            Carebot                        </div>
                    </div>
                </div>
                                </div>
    </div>
