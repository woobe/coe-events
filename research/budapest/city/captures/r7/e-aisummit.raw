                             alt="face">
                    </div>
                    <div>
                        <div
                            class="speaker-name">Dr. Mezei Fruzsina</div>
                        <div class="position">
                            Digitális egészségügyi és innovációs szakértő<br>                            Medistance, Università Cattolica del Sacro Cuore                        </div>
                    </div>
                </div>
                                </div>
    </div>
