                        <input type="text" class="form-control" id="agendaBookingTicketHash"
                               name="ticket_hash" autocomplete="off" inputmode="text"
                               autocapitalize="characters" spellcheck="false" maxlength="12"
                               pattern="[A-Za-z0-9]{12}" placeholder="AB12CD34EF56"
                               required aria-describedby="agendaBookingError"
