<script id="wp-sentry-browser-js-before">
function wp_sentry_hook(options) {
    var themePath = "\/wp-content\/themes\/akvarium\/";

    if (themePath === '/wp-content/themes//') {
        return false;
    }

    options.beforeSend = function (event) {
        if (event.level && event.level !== 'error' && event.level !== 'fatal') {
            return null;
        }

        var values = (event.exception && event.exception.values) || [];

        for (var i = 0; i < values.length; i++) {
            var frames = (values[i].stacktrace && values[i].stacktrace.frames) || [];

            for (var j = 0; j < frames.length; j++) {
                if (frames[j].filename && frames[j].filename.indexOf(themePath) !== -1) {
                    return event;
                }
            }
        }

        return null;
    };

    return true;
}
//# sourceURL=wp-sentry-browser-js-before
