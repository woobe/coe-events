<script id="wp-sentry-browser-js-extra">
var wp_sentry = {"environment":"production","release":"1.0","context":{"tags":{"wordpress":"7.1.3","language":"en-US"}},"dsn":"https://ab2635b72746713b255ea7a8115077e7@o4510714584956928.ingest.de.sentry.io/4512287149654096"};
