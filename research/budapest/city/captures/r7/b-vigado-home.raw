5:38:01.652Z\"},\"oncomingEvents\":[{\"id\":206,\"title\":\"Symphonic visions: Journeys and passions\",\"description\":\"A concert by the Miskolc Symphony Orchestra\",\"coverImage\":{\"id\":639,\"alt\":\"Miskolci szimfónikusok\",\"prefix\":\"media\",\"folder\":{\"id\":25,\"name\":\"11. november\",\"folder\":14,\"documentsAndFolders\":{\"docs\":[{\"relationTo\":\"media\",\"value\":694},{\"relationTo\":\"media\",\"value\":693},{\"relationTo\":\"media\",\"value\":691},{\"relationTo\":\"media\",\"value\":682},{\"relationTo\":\"media\",\"value\":681},{\"relationTo\":\"media\",\"value\":680},{\"relationTo\":\"media\",\"value\":679},{\"relationTo\":\"media\",\"value\":678},{\"relationTo\":\"media\",\"value\":677},{\"relationTo\":\"media\",\"value\":676}],\"hasNextPage\":true},\"folderType\":[\"media\"],\"updatedAt\":\"2026-01-15T10:25:00.704Z\",\"createdAt\":\"2026-01-15T10:25:00.704Z\"},\"updatedAt\":\"2026-09-25T12:50:27.273Z\",\"createdAt\":\"2026-09-25T12:50:27.213Z\",\"url\":\"/api/media/file/miskolciszimfonikusok.jpg\",\"thumbnailURL\":null,\"filename\":\"miskolciszimfonikusok.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":324018,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"szimfonikus-latomasok-utak-es-szenvedelyek\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":5,\"name\":\"concert\",\"displayName\":\"Concert\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-19T14:29:00.498Z\",\"createdAt\":\"2025-11-11T08:56:11.206Z\"},\"room\":{\"id\":23,\"name\":\"Ceremonial Hall\",\"floor\":\"2. Floor\",\"coverImage\":{\"id\":38,\"alt\":\"Diszterem_Vigado\",\"prefix\":\"media\",\"folder\":3,\"updatedAt\":\"2025-11-06T10:16:52.916Z\",\"createdAt\":\"2025-11-06T10:16:52.916Z\",\"url\":\"/api/media/file/D%C3%ADszterem_Vigado.jpg\",\"thumbnailURL\":null,\"filename\":\"Díszterem_Vigado.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":777842,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-01-28T11:38:06.009Z\",\"createdAt\":\"2026-01-27T09:04:03.399Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"6ab66fda80d06d6bba832954\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The evening opens with the latest work by its conductor, \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Ádám Cser\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\", fresh from the composer’s desk. Visions – Symphonic Pictures will receive its world premiere.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Next, four piano pieces take on new life in orchestral arrangements by Miskolc-born Kristóf Siklósi, under the title European Journeys:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Franz Liszt: Mephisto Waltz No. 4\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Franz Liszt: Sleepless! Question and Answer\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Béla Bartók: Ostinato\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"György Kurtág: Pen-and-Ink Drawing, a Farewell to Erzsébet Schaár\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Frigyes Hidas is often described as the last Hungarian Romantic composer. He wrote for a wide range of wind instruments; tonight, the clarinet takes centre stage. The soloist in his \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Clarinet Concerto No. 2\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" is \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Gábor Varga,\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" a prominent figure on the Hungarian classical music scene.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Impulses for Orchestra is a concert work by composer and choreographer \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Árpád Könczei\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\", recipient of the UNITER Award and the Gyula Harangozó Award. It reflects his work across both art forms, bringing classical composition together with the energy of movement and dance.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The richly orchestrated \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Clown Gags and Passions – Symphonic Trilogy\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" evokes the characters, passions and antics of three familiar cultural or literary figures in its three movements; a composition by \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"György Selmeczi \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"will close the evening with its world premiere:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Pehlivani\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Play Casanova\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Limerick\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Organiser: Miskolc Symphony Orchestra\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"The concert is supported by the Hungarian Academy of Arts.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":360,\"adminTitle\":\"Symphonic visions: Journeys and passions - 2026.11.27 19:30\",\"title\":\"Symphonic visions: Journeys and passions\",\"slug\":\"szimfonikus-latomasok-utak-es-szenvedelyek\",\"slugLock\":false,\"startDate\":\"2026-11-27T18:30:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":null,\"ticketPrice\":\"Free, registration required\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":354,\"maxCounterPerUser\":4,\"openPositions\":13,\"acceptedRegistrations\":176,\"acceptedParticipants\":341,\"onWaitingList\":0,\"onWaitingListParticipants\":0,\"cancelledRegistrations\":13,\"cancelledParticipants\":18,\"pendingConfirmations\":19,\"pendingParticipants\":38},\"updatedAt\":\"2026-11-25T09:46:37.734Z\",\"createdAt\":\"2026-09-25T13:06:51.649Z\"}],\"updatedAt\":\"2026-11-04T12:56:12.303Z\",\"createdAt\":\"2026-09-25T13:05:20.532Z\"},{\"id\":222,\"title\":\"Advent Wreath-Making Workshop \",\"description\":\"Come and enjoy a cosy, creative afternoon with us at the Pesti Vigadó!\",\"coverImage\":{\"id\":658,\"alt\":\"adventi koszorú készítés\",\"prefix\":\"media\",\"folder\":\"$18:props:children:props:oncomingEvents:0:coverImage:folder\",\"updatedAt\":\"2026-10-12T14:50:34.766Z\",\"createdAt\":\"2026-10-12T14:50:34.680Z\",\"url\":\"/api/media/file/adventi-koszoru-keszites.jpg\",\"thumbnailURL\":null,\"filename\":\"adventi-koszoru-keszites.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":252263,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"adventi-koszoru-keszito-workshop\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":6,\"name\":\"Workshop\",\"displayName\":\"Workshop\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T11:10:06.141Z\",\"createdAt\":\"2025-11-25T17:04:55.065Z\"},\"room\":{\"id\":17,\"name\":\"Makovecz Imre Hall\",\"floor\":\"4. Floor\",\"coverImage\":{\"id\":82,\"alt\":\"Makovecz_terem\",\"prefix\":\"media\",\"folder\":3,\"updatedAt\":\"2025-11-17T13:03:01.405Z\",\"createdAt\":\"2025-11-17T13:03:01.405Z\",\"url\":\"/api/media/file/Makovecz_terem.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_terem.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":280445,\"width\":1500,\"height\":1000,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":150,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[{\"id\":\"691b1d26a980fa9a522e7ae1\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Makovecz Hall, located on the 4th floor of the Pesti Vigadó, is an ideal venue for smaller concerts, cultural events, and conferences.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"With a maximum capacity of 150 people, the Makovecz Hall is particularly well suited for conferences. You can view the different seating and layout options of the Makovecz Hall in the gallery below.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Capacity of the Makovecz Hall:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Theatre-style seating (depending on stage size and orientation): up to 120 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Standing reception: up to 150 guests\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null,\"textFormat\":1}}},{\"id\":\"691b1fcb6961fa18a1bcf6aa\",\"blockName\":null,\"slides\":[{\"id\":\"691b1fce6961fa18a1bcf6ab\",\"image\":{\"id\":83,\"alt\":\"Makovecz_terem_1\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:11:58.384Z\",\"createdAt\":\"2025-11-17T13:11:58.384Z\",\"url\":\"/api/media/file/Makovecz_1.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_1.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":615995,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1fd56961fa18a1bcf6ac\",\"image\":{\"id\":84,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:13:37.492Z\",\"createdAt\":\"2025-11-17T13:12:33.150Z\",\"url\":\"/api/media/file/Makovecz_2.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_2.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":638430,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1fdc6961fa18a1bcf6ad\",\"image\":{\"id\":85,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:13:37.491Z\",\"createdAt\":\"2025-11-17T13:12:37.193Z\",\"url\":\"/api/media/file/Makovecz_3.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_3.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":625526,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1fec6961fa18a1bcf6af\",\"image\":{\"id\":86,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:13:37.480Z\",\"createdAt\":\"2025-11-17T13:12:41.407Z\",\"url\":\"/api/media/file/Makovecz_4.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_4.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":582118,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1ff56961fa18a1bcf6b0\",\"image\":{\"id\":87,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:14:13.711Z\",\"createdAt\":\"2025-11-17T13:12:45.611Z\",\"url\":\"/api/media/file/Makovecz_5.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_5.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":578898,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"}],\"blockType\":\"galleryBlock\"}]},\"visitConfig\":{\"isVisitable\":null,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-01-29T10:09:25.369Z\",\"createdAt\":\"2025-11-17T13:04:47.138Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"6accf3f3d0a929af2134fc27\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Date: Saturday, 28 November 2026\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Time: 2:00 PM\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Venue: Pesti Vigadó, 1051 Budapest, Vigadó tér 2.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Participation fee: HUF 15,000 per person\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Join us for a festive and creative Advent wreath-making workshop, where you can create your very own unique wreath in a relaxed and inspiring atmosphere – and get into the Christmas spirit along the way!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"During the workshop:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"All the necessary materials, candles and tools will be provided.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"You will receive expert guidance and support to help you create a beautiful, one-of-a-kind wreath that reflects your personal style.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Enjoy a cosy festive atmosphere with hot tea, delicious pastries and plenty of Christmas cheer.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Duration: approximately 2.5 hours.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"And the best part? You’ll get to take your handmade Advent wreath home with you – a beautiful reminder of our festive afternoon that will brighten your home throughout the Advent season! \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Places are limited to a maximum of 12 participants, so advance ticket purchase is required.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The workshop will take place with a minimum of 3 participants.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Workshop leader: Júlia Keszericze-Cser\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"If you’d like to take a break from the year-end rush, get creative, recharge your batteries and experience a little Christmas magic in November, we’d love to welcome you!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":452,\"adminTitle\":\"Advent Wreath-Making Workshop  - 2026.11.28 14:00\",\"title\":\"Advent Wreath-Making Workshop \",\"slug\":\"advent-wreath-making-workshop-\",\"slugLock\":false,\"startDate\":\"2026-11-28T13:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"en\",\"interticketLink\":\"https://vigado.jegy.hu/program/advent-wreath-making-workshop-198924/1523548\",\"ticketPrice\":\"15 000 HUF\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-29T12:40:54.037Z\",\"createdAt\":\"2026-10-20T11:25:28.379Z\"}],\"updatedAt\":\"2026-10-29T12:45:52.658Z\",\"createdAt\":\"2026-10-12T14:59:45.453Z\"},{\"id\":8,\"title\":\"Historic walk tour at the birthplace of Budapest\",\"description\":\"Discover the 190-year-old history and architecture of the Pesti Vigadó!\",\"coverImage\":{\"id\":44,\"alt\":\"Epulettorteneti_seta_borito\",\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2025-11-11T12:51:45.161Z\",\"createdAt\":\"2025-11-11T12:51:45.160Z\",\"url\":\"/api/media/file/Epulettorteneti_seta_borito.jpg\",\"thumbnailURL\":null,\"filename\":\"Epulettorteneti_seta_borito.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":244625,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"mesel-a-vigado--epulettorteneti-seta\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":16,\"name\":\"Épületséta\",\"displayName\":\"Historic Walk Tour\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T10:41:31.337Z\",\"createdAt\":\"2026-01-15T14:13:18.872Z\"},\"room\":{\"id\":24,\"name\":\"Pesti Vigadó\",\"floor\":\"0 - 6th \",\"coverImage\":{\"id\":44,\"alt\":\"Epulettorteneti_seta_borito\",\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2025-11-11T12:51:45.161Z\",\"createdAt\":\"2025-11-11T12:51:45.160Z\",\"url\":\"/api/media/file/Epulettorteneti_seta_borito.jpg\",\"thumbnailURL\":null,\"filename\":\"Epulettorteneti_seta_borito.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":244625,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":null,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[]},\"visitConfig\":{\"isVisitable\":null,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-04-08T14:17:44.892Z\",\"createdAt\":\"2026-02-06T09:22:38.883Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"691330d53a4744dcf1c7cf14\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Discover the Pesti Vigadó, one of Budapest’s most impressive cultural landmarks, which is not only an architectural masterpiece but also a key venue in Hungarian history and the arts.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Pesti Vigadó warmly welcomes those interested in the building's beautiful interior, history, and panoramic views on scheduled dates. Visitors can explore the entire historic building accompanied by our professional guides, admire the impressive architectural features and hidden treasures, learn about the architects and artists who shaped this unique place, and discover how the building's role has evolved over the centuries.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Don't miss this unique opportunity to experience history up close within the magical walls of the Pesti Vigadó!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"IMPORTANT INFORMATION:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The expected duration of the tour is 60 minutes.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"We kindly ask our guests to comply with the house rules and accept the terms and conditions of our service.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Please read our Visitor Information Guide.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Visitors aged 70 and over can participate in the Architectural History Tours with a senior ticket.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"During the tour, visitors can explore parts of the building that are not typically open to the public or are only partially accessible! The ticket price includes the guided tour as well as access to all exhibitions.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"The maximum group size is 35 people, and reservations can be made with advance ticket purchase.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"For more information:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ticket Office: +36 (1) 328-3340\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Audience Management: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"autolink\",\"fields\":{\"url\":\"mailto:turizmus@vigado.hu\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":2,\"children\":[{\"mode\":\"normal\",\"text\":\"turizmus@vigado.hu\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Holders of the free Pesti Vigadó Club Card receive a 3% discount on the program price.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":406,\"adminTitle\":null,\"title\":\"$undefined\",\"slug\":\"historic-walk-tour-at-the-birthplace-of-budapest\",\"slugLock\":true,\"startDate\":\"2026-11-28T10:45:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"en\",\"interticketLink\":\"https://vigado.jegy.hu/program/historic-walk-tour-at-the-birthplace-of-budapest-163569/1513902\",\"ticketPrice\":\"$undefined\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-07T15:14:08.055Z\",\"createdAt\":\"2026-10-07T15:14:08.055Z\"},{\"id\":408,\"adminTitle\":null,\"title\":\"$undefined\",\"slug\":\"historic-walk-tour-at-the-birthplace-of-budapest\",\"slugLock\":true,\"startDate\":\"2026-11-29T10:45:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"en\",\"interticketLink\":\"https://vigado.jegy.hu/program/historic-walk-tour-at-the-birthplace-of-budapest-163569/1513903\",\"ticketPrice\":\"$undefined\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-07T15:16:14.328Z\",\"createdAt\":\"2026-10-07T15:16:14.328Z\"}],\"updatedAt\":\"2026-11-16T10:12:25.984Z\",\"createdAt\":\"2025-11-11T12:51:48.302Z\"},{\"id\":197,\"title\":\"In Search of the Golden Apples\",\"description\":\"A connecting workshop to the exhibition SECRET · STORY · FAIRYTALE\",\"coverImage\":{\"id\":662,\"alt\":\"az aranyalmák nyomában\",\"prefix\":\"media\",\"folder\":\"$18:props:children:props:oncomingEvents:0:coverImage:folder\",\"updatedAt\":\"2026-10-19T12:18:40.103Z\",\"createdAt\":\"2026-10-19T12:18:40.003Z\",\"url\":\"/api/media/file/az-aranyalmak-nyomaban.jpg\",\"thumbnailURL\":null,\"filename\":\"az-aranyalmak-nyomaban.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":731432,\"width\":3319,\"height\":1500,\"focalX\":50,\"focalY\":50},\"slug\":\"az-aranyalmak-nyomaban\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":\"$18:props:children:props:oncomingEvents:1:category\",\"room\":\"$18:props:children:props:oncomingEvents:2:room\",\"lengthInfo\":null,\"content\":[{\"id\":\"6a98326263b075f8cc4cf6e9\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Please note, that the event is in Hungarian!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"horizontalrule\",\"version\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Every night, someone carries away the golden apples growing on the mysterious tree of the Pesti Vigadó – or, as in the tale, the Fairy Palace. Many have tried to guard the magical fruit, but no one has succeeded so far.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"This time, it is Prince Árgyélus’s turn – and now, dear children aged 7–13, you can join him on his adventure.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"We will wander along the border between history and imagination, sometimes becoming creators, at other times observers. Through the tale, we can also discover something about our own stories, our world and one another. Participants will explore the intellectual and architectural world of the Pesti Vigadó through an interdisciplinary approach, using movement, storytelling, music and visual expression.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The session is led by architect Lili Kovács.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":461,\"adminTitle\":null,\"title\":\"$undefined\",\"slug\":\"az-aranyalmak-nyomaban\",\"slugLock\":true,\"startDate\":\"2026-11-29T15:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":\"https://vigado.jegy.hu/program/az-aranyalmak-nyomaban-muzeumpedagogiai-foglalkozas-196634/1527176\",\"ticketPrice\":\"$undefined\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-29T09:26:51.451Z\",\"createdAt\":\"2026-10-29T09:26:51.451Z\"}],\"updatedAt\":\"2026-11-25T09:55:54.925Z\",\"createdAt\":\"2026-09-02T14:29:56.345Z\"},{\"id\":124,\"title\":\"Chain reaction\",\"description\":\"A play by Katalin Vajda\",\"coverImage\":{\"id\":268,\"alt\":\"Láncreakció\",\"prefix\":\"media\",\"folder\":{\"id\":19,\"name\":\"05. május\",\"folder\":14,\"documentsAndFolders\":{\"docs\":[{\"relationTo\":\"media\",\"value\":576},{\"relationTo\":\"media\",\"value\":575},{\"relationTo\":\"media\",\"value\":574},{\"relationTo\":\"media\",\"value\":573},{\"relationTo\":\"media\",\"value\":572},{\"relationTo\":\"media\",\"value\":571},{\"relationTo\":\"media\",\"value\":570},{\"relationTo\":\"media\",\"value\":569},{\"relationTo\":\"media\",\"value\":309},{\"relationTo\":\"media\",\"value\":308}],\"hasNextPage\":true},\"folderType\":[\"media\"],\"updatedAt\":\"2026-01-15T10:17:58.577Z\",\"createdAt\":\"2026-01-15T10:17:58.577Z\"},\"updatedAt\":\"2026-04-08T08:24:13.752Z\",\"createdAt\":\"2026-04-08T08:24:13.629Z\",\"url\":\"/api/media/file/lancreakcio-web-cover.jpg\",\"thumbnailURL\":null,\"filename\":\"lancreakcio-web-cover.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":840594,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"lancreakcio\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":false,\"category\":{\"id\":11,\"name\":\"Teátrum\",\"displayName\":\"Theater\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T11:08:51.001Z\",\"createdAt\":\"2025-11-27T12:06:26.353Z\"},\"room\":{\"id\":18,\"name\":\"Sinkovits Imre Stage\",\"floor\":\"4. Floor\",\"coverImage\":{\"id\":88,\"alt\":\"Sinkovits_Imre_Kamaraszinpad\",\"prefix\":\"media\",\"folder\":3,\"updatedAt\":\"2025-11-17T13:18:53.945Z\",\"createdAt\":\"2025-11-17T13:18:53.943Z\",\"url\":\"/api/media/file/Sinkovits_kamaraszinpad.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_kamaraszinpad.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":713224,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":165,\"sidebarInfo\":\"\",\"rentUrl\":null,\"content\":[{\"id\":\"691b206b6961fa18a1bcf6b1\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Sinkovits Imre Chamber Stage, located on the 4th floor of the Pesti Vigadó, is designed to host stage performances.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Sinkovits Imre Chamber Stage is the only venue within the Pesti Vigadó with fixed seating. With its layout of 11 rows and 15 seats per row, the venue can accommodate a total of 165 guests for stage performances, conferences, talks, and film screenings held at the Chamber Stage.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"You can view the seating and setup of the Sinkovits Imre Chamber Stage in the gallery below.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null,\"textFormat\":1}}},{\"id\":\"691b21a76c6a9b7fb45313fa\",\"blockName\":null,\"slides\":[{\"id\":\"691b21ab6c6a9b7fb45313fb\",\"image\":{\"id\":89,\"alt\":\"Kamaraszinpad_elolnezet\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:00.086Z\",\"createdAt\":\"2025-11-17T13:21:25.031Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_1.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_1.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":628543,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21ac6c6a9b7fb45313fc\",\"image\":{\"id\":90,\"alt\":\"Kamaraszinpad_oldalnezet\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:00.088Z\",\"createdAt\":\"2025-11-17T13:21:29.350Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_2.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_2.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":681465,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21ac6c6a9b7fb45313fd\",\"image\":{\"id\":91,\"alt\":\"Kamaraszinpad_szinpad\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:00.080Z\",\"createdAt\":\"2025-11-17T13:21:33.682Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_3.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_3.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":575999,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21b06c6a9b7fb45313fe\",\"image\":{\"id\":92,\"alt\":\"Kamaraszinpad_oldalnezet\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:35.519Z\",\"createdAt\":\"2025-11-17T13:21:38.419Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_4.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_4.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":544100,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"}],\"blockType\":\"galleryBlock\"}]},\"visitConfig\":{\"isVisitable\":false,\"rentUrl\":\"\",\"content\":[]},\"updatedAt\":\"2026-01-29T10:07:25.200Z\",\"createdAt\":\"2025-11-17T13:18:58.191Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"69ce3b569140fd71d8ff80fa\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Please note, that the event is in Hungarian!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"horizontalrule\",\"version\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Chain Reaction\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\", a play by Katalin Vajda, explores the circumstances surrounding the invention of the atomic bomb, placing the brilliant Hungarian physicist Leó Szilárd at its centre. Taking the form of an unconventional moral “trial”, it evokes one of the defining historical moments of the 20th century while also bringing to the stage scientists including Albert Einstein and Werner Heisenberg, whose decisions and discoveries fundamentally shaped the fate of humanity. Tense, intellectually engaging and thought-provoking, the play uses historical events to raise questions that remain relevant today.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Chain Reaction\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" follows the great dramatic tradition of works that do more than simply tell a story: they confront opposing ideas and examine the contradictions behind human decisions. On stage, words, debate and the force of argument take centre stage.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"“He did more than anyone to bring the bomb into existence – and fought harder than anyone against it.”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Directed by Zoltán Rátóti, the production centres on a dilemma that remains just as relevant today: is a scientist responsible for how their discoveries are used, or does that responsibility lie instead with political and social decision-makers? \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Chain Reaction\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" offers no simple answers. The final verdict is left to the audience. Its aim is not to take sides but to provoke reflection and to recognise that the relationship between science, power and human responsibility is not merely a closed chapter of the past, but one of the defining dilemmas of our present and future.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Despite the seriousness of its subject, audiences can expect an accessible, highly enjoyable and entertaining production featuring outstanding actors, including László Görög, László Szacsvay, Lajos Ottó Horváth, Kinga Katona, István Hirtling, Ádám Schnell, Ágnes Bertalan, Kati Zsurzs, Erika Pápai, Artúr Kálid and Dávid Szatory.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Created to mark the 200th anniversary of the founding of the Hungarian Academy of Sciences, with the joint support of the Hungarian Academy of Sciences and the Hungarian Academy of Arts, as a production of Pesti Vigadó.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Cast:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Leó Szilárd, physicist: László Görög\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Judge: Lajos Ottó Horváth\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Defence counsel: Kinga Katona\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Prosecutor: Dávid Szatory\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Mother, Szilárd’s mother: Kati Zsurzs\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Trude, Szilárd’s wife: Erika Pápai\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Albert Einstein, physicist: Ádám Schnell\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Werner Heisenberg, physicist: István Hirtling\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"General Leslie R. Groves: Artúr Kálid\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Emil Kovács, pastor: László Szacsvay\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Sylvia Elliot, journalist: Ágnes Bertalan\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Girl: Júlia Lilla Horváth\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebre