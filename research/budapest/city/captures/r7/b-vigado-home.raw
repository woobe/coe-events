":true,\"startDate\":\"2026-12-31T09:30:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"hu\",\"interticketLink\":\"https://vigado.jegy.hu/program/mesel-a-vigado-epulettorteneti-seta-121329/1530247\",\"ticketPrice\":\"4 000 Ft\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-11-06T15:42:35.016Z\",\"createdAt\":\"2026-11-06T15:42:35.016Z\"},{\"id\":474,\"adminTitle\":\"Historic walk tour at the birthplace of Budapest - 2026.12.31 11:45\",\"title\":\"Historic walk tour at the birthplace of Budapest\",\"slug\":\"historic-walk-tour-at-the-birthplace-of-budapest\",\"slugLock\":true,\"startDate\":\"2026-12-31T10:45:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"en\",\"interticketLink\":\"https://vigado.jegy.hu/program/historic-walk-tour-at-the-birthplace-of-budapest-163569/1530255\",\"ticketPrice\":\"6 500 HUF\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-11-06T15:47:32.112Z\",\"createdAt\":\"2026-11-06T15:47:32.112Z\"}],\"updatedAt\":\"2026-11-16T10:12:25.984Z\",\"createdAt\":\"2025-11-11T12:51:48.302Z\"},{\"id\":124,\"title\":\"Chain reaction\",\"description\":\"A play by Katalin Vajda\",\"coverImage\":{\"id\":268,\"alt\":\"Láncreakció\",\"prefix\":\"media\",\"folder\":19,\"updatedAt\":\"2026-04-08T08:24:13.752Z\",\"createdAt\":\"2026-04-08T08:24:13.629Z\",\"url\":\"/api/media/file/lancreakcio-web-cover.jpg\",\"thumbnailURL\":null,\"filename\":\"lancreakcio-web-cover.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":840594,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"lancreakcio\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":false,\"category\":{\"id\":11,\"name\":\"Teátrum\",\"displayName\":\"Theater\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T11:08:51.001Z\",\"createdAt\":\"2025-11-27T12:06:26.353Z\"},\"room\":{\"id\":18,\"name\":\"Sinkovits Imre Stage\",\"floor\":\"4. Floor\",\"coverImage\":88,\"rentConfig\":{\"isRentable\":true,\"capacity\":165,\"sidebarInfo\":\"\",\"rentUrl\":null,\"content\":[{\"id\":\"691b206b6961fa18a1bcf6b1\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Sinkovits Imre Chamber Stage, located on the 4th floor of the Pesti Vigadó, is designed to host stage performances.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Sinkovits Imre Chamber Stage is the only venue within the Pesti Vigadó with fixed seating. With its layout of 11 rows and 15 seats per row, the venue can accommodate a total of 165 guests for stage performances, conferences, talks, and film screenings held at the Chamber Stage.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"You can view the seating and setup of the Sinkovits Imre Chamber Stage in the gallery below.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null,\"textFormat\":1}}},{\"id\":\"691b21a76c6a9b7fb45313fa\",\"blockName\":null,\"slides\":[{\"id\":\"691b21ab6c6a9b7fb45313fb\",\"image\":89,\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21ac6c6a9b7fb45313fc\",\"image\":90,\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21ac6c6a9b7fb45313fd\",\"image\":91,\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21b06c6a9b7fb45313fe\",\"image\":92,\"artist\":\"$undefined\",\"description\":\"$undefined\"}],\"blockType\":\"galleryBlock\"}]},\"visitConfig\":{\"isVisitable\":false,\"rentUrl\":\"\",\"content\":[]},\"updatedAt\":\"2026-01-29T10:07:25.200Z\",\"createdAt\":\"2025-11-17T13:18:58.191Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"69ce3b569140fd71d8ff80fa\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Please note, that the event is in Hungarian!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"horizontalrule\",\"version\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Chain Reaction\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\", a play by Katalin Vajda, explores the circumstances surrounding the invention of the atomic bomb, placing the brilliant Hungarian physicist Leó Szilárd at its centre. Taking the form of an unconventional moral “trial”, it evokes one of the defining historical moments of the 20th century while also bringing to the stage scientists including Albert Einstein and Werner Heisenberg, whose decisions and discoveries fundamentally shaped the fate of humanity. Tense, intellectually engaging and thought-provoking, the play uses historical events to raise questions that remain relevant today.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Chain Reaction\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" follows the great dramatic tradition of works that do more than simply tell a story: they confront opposing ideas and examine the contradictions behind human decisions. On stage, words, debate and the force of argument take centre stage.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"“He did more than anyone to bring the bomb into existence – and fought harder than anyone against it.”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Directed by Zoltán Rátóti, the production centres on a dilemma that remains just as relevant today: is a scientist responsible for how their discoveries are used, or does that responsibility lie instead with political and social decision-makers? \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Chain Reaction\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\" offers no simple answers. The final verdict is left to the audience. Its aim is not to take sides but to provoke reflection and to recognise that the relationship between science, power and human responsibility is not merely a closed chapter of the past, but one of the defining dilemmas of our present and future.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Despite the seriousness of its subject, audiences can expect an accessible, highly enjoyable and entertaining production featuring outstanding actors, including László Görög, László Szacsvay, Lajos Ottó Horváth, Kinga Katona, István Hirtling, Ádám Schnell, Ágnes Bertalan, Kati Zsurzs, Erika Pápai, Artúr Kálid and Dávid Szatory.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Created to mark the 200th anniversary of the founding of the Hungarian Academy of Sciences, with the joint support of the Hungarian Academy of Sciences and the Hungarian Academy of Arts, as a production of Pesti Vigadó.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Cast:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Leó Szilárd, physicist: László Görög\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Judge: Lajos Ottó Horváth\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Defence counsel: Kinga Katona\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Prosecutor: Dávid Szatory\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Mother, Szilárd’s mother: Kati Zsurzs\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Trude, Szilárd’s wife: Erika Pápai\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Albert Einstein, physicist: Ádám Schnell\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Werner Heisenberg, physicist: István Hirtling\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"General Leslie R. Groves: Artúr Kálid\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Emil Kovács, pastor: László Szacsvay\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Sylvia Elliot, journalist: Ágnes Bertalan\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Girl: Júlia Lilla Horváth\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Boy: Buda Buzádi\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Playwright: Katalin Vajda\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Set designer: Réka Pintér\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Costume designer: Hajnal Tordai\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Costume production: Márta Imréné Madarász\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Stage manager: Szilvia Pintér\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Composer: György Selmeczi\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Prompter: Katalin Gróf\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Assistant director: Péter Kernács\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Director: Zoltán Rátóti\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":415,\"adminTitle\":\"Chain reaction - 2026.12.01 19:00\",\"title\":\"Chain reaction\",\"slug\":\"lancreakcio\",\"slugLock\":false,\"startDate\":\"2026-12-01T18:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":\"https://vigado.jegy.hu/program/lancreakcio-196832/1519037\",\"ticketPrice\":\"Dynamic pricing\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-14T11:24:38.197Z\",\"createdAt\":\"2026-10-14T10:43:46.494Z\"},{\"id\":416,\"adminTitle\":\"Chain reaction - 2026.12.14 20:00\",\"title\":\"Chain reaction\",\"slug\":\"lancreakcio\",\"slugLock\":false,\"startDate\":\"2026-12-14T19:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":\"https://vigado.jegy.hu/program/lancreakcio-196832/1519038\",\"ticketPrice\":\"Dynamic pricing\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-14T11:24:50.987Z\",\"createdAt\":\"2026-10-14T10:44:24.182Z\"}],\"updatedAt\":\"2026-10-14T11:24:57.075Z\",\"createdAt\":\"2026-04-02T09:46:04.404Z\"},{\"id\":146,\"title\":\"Tomor Barnabás Project\",\"description\":\"The December concert of Vigadó Jazz Club\",\"coverImage\":{\"id\":289,\"alt\":\"Tomor Barnabás Project\",\"prefix\":\"media\",\"folder\":26,\"updatedAt\":\"2026-04-27T12:48:10.759Z\",\"createdAt\":\"2026-04-27T12:48:10.660Z\",\"url\":\"/api/media/file/tomor-barnabas-project-jazz-club.jpg\",\"thumbnailURL\":null,\"filename\":\"tomor-barnabas-project-jazz-club.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":150325,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"tomor-barnabas-project\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":8,\"name\":\"Vigadó Jazz Club\",\"displayName\":\"Vigadó Jazz Club\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-08-26T08:28:19.260Z\",\"createdAt\":\"2025-11-27T10:50:54.727Z\"},\"room\":\"$6:props:data:content:2:programs:1:room\",\"lengthInfo\":null,\"content\":[{\"id\":\"69ef5b1a4f0e80ad62a2ea7a\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Tomor Barnabás Project was founded in 2024. Keyboard instruments play a central role in the band’s sound, complemented by expressive guitar work, the instinctive voice of the saxophone, the distinctive tone of the violin, and the refined playing of the drums. Together, these elements shape the compositions into fresh, reinterpreted forms, while the program also features a selection of jazz-rock fusion pieces by some of the bandleader’s favorite composers.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":