<div id="leaflet-katedra-map"></div><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>document.addEventListener("DOMContentLoaded", function(){
var lat=47.49810;
var lng=19.05513;
var map=L.map('leaflet-katedra-map', {
scrollWheelZoom: false,
zoomControl: false
}).setView([lat, lng], 17);
L.control.zoom({
position: 'bottomleft'
}).addTo(map);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
maxZoom: 19,
attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
}).addTo(map);
var katedraIcon=L.icon({
iconUrl: 'https://teremberlesbudapest.hu/wp-content/uploads/2026/04/teremberles-logo-text.svg',
iconSize: [140, 70],
iconAnchor: [10, 45],
popupAnchor: [70, -30],
className: 'custom-leaflet-icon'
});
var marker=L.marker([lat, lng], {icon: katedraIcon}).addTo(map);
marker.bindPopup("<b>Katedra Nyelviskola</b><br>Belvárosi Központ");
setTimeout(function(){ map.invalidateSize(); }, 500);
});</script></div></div><div class="elementor-element elementor-element-038358f e-flex e-con-boxed e-con e-parent" data-id="038358f" data-element_type="container" data-e-type="container">
