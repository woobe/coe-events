<script id="cookieadmin_js-js-extra">var cookieadmin_policy={"cookieadmin_layout":"box","cookieadmin_modal":"center","cookieadmin_position":"bottom_left","cookieadmin_days":"365","cookieadmin_notice_title":"Tiszteletben tartjuk az \u00d6n mag\u00e1nszf\u00e9r\u00e1j\u00e1t","cookieadmin_notice":"A cookie-k seg\u00edtenek jav\u00edtani az \u00e9lm\u00e9nyt, szem\u00e9lyre szabott tartalmat ny\u00fajtani \u00e9s forgalmat elemezni. Kiv\u00e1laszthatja, mely cookie-kat enged\u00e9lyezi a \u003Cb\u003ETestreszab\u00e1s\u003C/b\u003E gombra kattintva. Kattintson a \u003Cb\u003EMind elfogad\u00e1sa\u003C/b\u003E gombra a hozz\u00e1j\u00e1rul\u00e1shoz vagy a \u003Cb\u003EMind elutas\u00edt\u00e1sa\u003C/b\u003E gombra a nem alapvet\u0151 cookie-k elutas\u00edt\u00e1s\u00e1hoz.","cookieadmin_preference_title":"Szem\u00e9lyre szabhatja cookie-be\u00e1ll\u00edt\u00e1sait","cookieadmin_preference":"Cookie-kat haszn\u00e1lunk a g\u00f6rd\u00fcl\u00e9keny navig\u00e1ci\u00f3 \u00e9s alapvet\u0151 webhelyfunkci\u00f3k biztos\u00edt\u00e1s\u00e1hoz. Az egyes cookie-kateg\u00f3ri\u00e1k r\u00e9szletes adatait al\u00e1bb tekintheti meg. \u003Cbr /\u003EA \u003Cb\u003ESz\u00fcks\u00e9ges\u003C/b\u003E cookie-k a b\u00f6ng\u00e9sz\u0151ben t\u00e1rol\u00f3dnak, mert alapvet\u0151ek a webhely m\u0171k\u00f6d\u00e9s\u00e9hez. \u003Cb\u003EEzekhez a cookie-khoz nem sz\u00fcks\u00e9ges az \u00d6n hozz\u00e1j\u00e1rul\u00e1sa a GDPR szerint.\u003C/b\u003E \u003Cbr /\u003EHarmadik f\u00e9lt\u0151l sz\u00e1rmaz\u00f3 cookie-kat is haszn\u00e1lunk a webhelyhaszn\u00e1lat elemz\u00e9s\u00e9re, az \u00d6n preferenci\u00e1inak megjegyz\u00e9s\u00e9re \u00e9s relev\u00e1ns tartalom, valamint hirdet\u00e9sek megjelen\u00edt\u00e9s\u00e9re. Ezek csak az \u00d6n hozz\u00e1j\u00e1rul\u00e1s\u00e1val aktiv\u00e1l\u00f3dnak. Enged\u00e9lyezheti vagy letilthatja ezeket a cookie-kat, de k\u00e9rj\u00fck, vegye figyelembe, hogy bizonyos t\u00edpusok kikapcsol\u00e1sa befoly\u00e1solhatja b\u00f6ng\u00e9sz\u00e9si \u00e9lm\u00e9ny\u00e9t.","reConsent_title":"Cookie-be\u00e1ll\u00edt\u00e1sok m\u00f3dos\u00edt\u00e1sa","cookieadmin_notice_title_color":"#000000","cookieadmin_notice_color":"#000000","cookieadmin_consent_inside_bg_color":"#ffffff","cookieadmin_consent_inside_border_color":"#abb8c3","cookieadmin_preference_title_color":"#000000","cookieadmin_details_wrapper_color":"#000000","cookieadmin_cookie_modal_bg_color":"#ffffff","cookieadmin_cookie_modal_border_color":"#000000","cookieadmin_customize_btn":"Testreszab\u00e1s","cookieadmin_customize_btn_color":"#000000","cookieadmin_customize_btn_bg_color":"#ffffff","cookieadmin_reject_btn":"Mind elutas\u00edt\u00e1sa","cookieadmin_reject_btn_color":"#000000","cookieadmin_reject_btn_bg_color":"#ffffff","cookieadmin_accept_btn":"Mind elfogad\u00e1sa","cookieadmin_accept_btn_color":"#ffffff","cookieadmin_accept_btn_bg_color":"#1863dc","cookieadmin_save_btn":"Be\u00e1ll\u00edt\u00e1sok ment\u00e9se","cookieadmin_save_btn_color":"#ffffff","cookieadmin_save_btn_bg_color":"#1863dc","cookieadmin_slider_off_bg_color":"#808080","cookieadmin_slider_on_bg_color":"#3582C4","cookieadmin_links_color":"#1863dc","cookieadmin_geo_tgt":"www","cookieadmin_reconsent_icon":"cookieadmin.svg","cookieadmin_reconsent_img_url":"","cookieadmin_re_consent_bg_color":"#374FD4","cookieadmin_privacy_policy":"","cookieadmin_cookie_policy":"","cookieadmin_privacy_policy_banner":"0","cookieadmin_privacy_policy_pref":"0","cookieadmin_policy_link_color":"#cbba8d","preload":[],"reload_on_consent":"on","ajax_url":"https://teremberlesbudapest.hu/wp-admin/admin-ajax.php","nonce":"e16b815b04","http_cookies":[],"home_url":"https://teremberlesbudapest.hu","plugin_url":"https://teremberlesbudapest.hu/wp-content/plugins/cookieadmin","is_pro":"cookieadmin-pro/cookieadmin-pro.php","ssl":"1","base_path":"/","lang":{"show_less":"Kevesebb megjelen\u00edt\u00e9se","duration":"Id\u0151tartam","session":"Munkamenet","days":"Napok"},"categorized_cookies":{"__cf_bm":{"cookie_name":"__cf_bm","category":"Functional","expires":"2026-05-31 08:25:44","description":"Cloudflare's bot products identify and mitigate automated traffic to protect your site from bad bots. Cloudflare places the __cf_bm cookie on End User devices that access Customer sites that are protected by Bot Management or Bot Fight Mode. The __cf_bm cookie is necessary for the proper functioning of these bot solutions.","patterns":"[]"},"_cfuvid":{"cookie_name":"_cfuvid","category":"Functional","expires":null,"description":"The _cfuvid cookie is only set when a site uses this option in a Rate Limiting Rule, and is only used to allow the Cloudflare WAF to distinguish individual users who share the same IP address.","patterns":"[]"},"cookieadmin_consent":{"cookie_name":"cookieadmin_consent","category":"Necessary","expires":null,"description":"Used to store CookieAdmin WordPress Plugin's consent information","patterns":"[]"}}};
