    <script>
        const startDate = new Date("2026-10-30T10:00:00");
        const endDate = new Date("2026-10-31T16:00:00");
        const storageKey = "popup_julius2026";

        const now = new Date();

        if (
            now >= startDate &&
            now <= endDate &&
            localStorage.getItem(storageKey) !== "true"
        ) {
            alert(
                `FIGYELEM!
Karbantartás miatt a magyarkozlony.hu oldalon
2026. október 31-én, szombaton, 7-16 óra között
szolgáltatáskiesés fordulhat elő.`
            );

            localStorage.setItem(storageKey, "true");
        }
