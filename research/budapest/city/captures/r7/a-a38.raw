<main class="main bg-white text-black">
    <div class="page-container">
        <div class="mb-4 md:mb-8"><header
	class="hero max-h-[600px] m-auto aspect-[375/250] md:aspect-[1440/436] bg-cover bg-center relative "
	style="background-image: url('https://www.a38.hu/themes/a38_2024/assets/img/postbanner.webp');"
>
	<div class="hidden w-full h-full"></div>
</header></div>
        <div class="container container-xsmall">
            <h1 class="font-n27 font-bold text-30 md:text-60 md:leading-72 text-center mb-4 md:mb-8">
                Contact
            </h1>
            <div class="">				
	<div>
    <iframe
        id="contactmap"
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d2267.635495881181!2d19.063127224229834!3d47.476503896976936!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x8a3fbd537ee2454e!2zQTM4IEhhasOz!5e0!3m2!1shu!2shu!4v1594058984053!5m2!1sen!2shu"
        width="100%"
        height="450"
        frameborder="0"
        style="border:0;float:right;margin-left:20px;"
        allowfullscreen=""
        aria-hidden="false"
        tabindex="0"
        class="mb-4 md:mb-8"
    ></iframe>

    <h2 class="text-25 md:text-40 font-black mb-3 lg:mb-4">A38 Ship</h2>

    <p class="text-16 mb-4">
        A38 Ship is anchored next to Petőfi bridge, Buda side on the lower quay. It is accessible by stairs located next
        to the tram stop. Please use the pedestrian crossing when you arrive!
    </p>

    <h3 class="text-18 font-black mb-2">Staff</h3>
    <p class="text-16 mb-4">See the <a href="/en/colleagues" class="text-blue-500 underline">Staff</a> page.</p>

    <h3 class="text-18 font-black mb-2">Ticket Office</h3>
    <p class="text-16 mb-4">
        Phone: <a href="tel:+3614643940" class="text-blue-500 underline">(06 1) 464 39 40</a><br />
        Open Mon-Sun: 8:00-22:00 or until the end of the last event.<br />
        Ticket information: <a href="mailto:info@a38.hu" class="text-blue-500 underline">info@a38.hu</a><br />
        <strong>After 10 PM, you can reach our duty phone for noise complaints only:</strong>
        <a href="tel:+36300190763" class="text-blue-500 underline">+36 30 019-0763</a>
    </p>

    <h3 class="text-18 font-black mb-2">Restaurant</h3>
    <p class="text-16 mb-4">
        Phone: <a href="tel:+3614643946" class="text-blue-500 underline">(06 1) 464 39 46</a><br />
        Open Mon-Fri: 11 AM - 10 PM, Sat: 4 PM - 10 PM<br />
        Reservations: <a href="mailto:etterem@a38.hu" class="text-blue-500 underline">etterem@a38.hu</a>
    </p>

    <!-- Public Transportation Details -->
    <h2 class="text-25 md:text-40 font-black mb-3 lg:mb-4">Public Transportation</h2>
    <div class="space-y-2 lg:space-y-3 mb-8 lg:mb-12">
        <div>
            <p class="text-18 font-black">Tram 4 and 6</p>
            <p class="text-16">
                2 minutes walk from PETŐFI HÍD, BUDAI HÍDFŐ stop.<br />
                The trams also run at night!
            </p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 203, 203A</p>
            <p class="text-16">2 minutes walk from NEUMANN JÁNOS UTCA stop.</p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 212</p>
            <p class="text-16">2 minutes walk from PETŐFI HÍD, BUDAI HÍDFŐ stop.</p>
        </div>
        <div>
            <p class="text-18 font-black">Tram 2, 2A</p>
            <p class="text-16">10 minutes walk from BORÁROS TÉR stop via Petőfi bridge.</p>
        </div>
        <div>
            <p class="text-18 font-black">Suburban Railway H7</p>
            <p class="text-16">10 minutes walk from BORÁROS TÉR stop via Petőfi bridge.</p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 15, 23, 23E, 54, 55, 115</p>
            <p class="text-16">10 minutes walk from BORÁROS TÉR stop via Petőfi bridge.</p>
        </div>
        <div>
            <p class="text-18 font-black">Tram 19, 41, 47, 49, 56</p>
            <p class="text-16">10 minutes walk from SZENT GELLÉRT TÉR stop along Műegyetem quay.</p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 7, 173, 133E</p>
            <p class="text-16">10 minutes walk from SZENT GELLÉRT TÉR stop along Műegyetem quay.</p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 103 from Népliget</p>
            <p class="text-16">5 minutes walk along the Danube from PÁZMÁNY PÉTER SÉTÁNY stop.</p>
        </div>
        <div>
            <p class="text-18">
                The D11 ship stops at A38 Ship twice a day at the EGYETEMVÁROS - A38 stop. One arrives early in the
                morning at 8:51 AM, and the other in the afternoon at 4:51 PM. See the full schedule
                <a href="https://bkk.hu/en/" class="text-blue-500 underline">here</a>.
            </p>
        </div>
    </div>

    <!-- Night Routes -->
    <h2 class="text-25 md:text-40 font-black mb-3 lg:mb-4">Night Routes</h2>
    <div class="space-y-2 lg:space-y-3 mb-8 lg:mb-12">
        <div>
            <p class="text-18 font-black">Tram 4 and 6</p>
            <p class="text-16">PETŐFI HÍD BUDAI HÍDFŐ stop.</p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 923, 966, 979, 979A</p>
            <p class="text-16">BORÁROS TÉR stop.</p>
        </div>
        <div>
            <p class="text-18 font-black">Bus 907, 973</p>
            <p class="text-16">SZENT GELLÉRT TÉR stop.</p>
        </div>
    </div>

    <!-- Parking Info -->
    <div class="mb-8 lg:mb-12">
        <h2 class="text-25 md:text-40 font-black mb-3 lg:mb-4">Parking</h2>
        <p class="text-16">
            We recommend parking your car at Pázmány Péter sétány, in front of the Eötvös Loránd University building, or
            on the lower quay about 100 meters south of A38 Ship. Please note that there are limited parking spaces
            directly in front of the ship.
        </p>
    </div>

    <!-- Bicycle Info -->
    <div class="mb-8 lg:mb-12">
        <h2 class="text-25 md:text-40 font-black mb-3 lg:mb-4">Bicycle</h2>
        <p class="text-16">
            You can reach the ship via the bike path on Műegyetem quay or Pázmány Péter sétány. While we don't have a
            dedicated bike locker, you can secure your bike to the railings near the ship's terrace.
        </p>
    </div>

    <!-- Boat Info -->
    <div class="mb-8 lg:mb-12">
        <h2 class="text-25 md:text-40 font-black mb-3 lg:mb-4">Motorboat, Small Boat</h2>
        <p class="text-16">
            You can also arrive by motorboat or small boat! We offer docking at A38 Ship, but please call us at
            <a href="tel:+36305928772" class="text-blue-500 underline">+36-30/592-8772</a> before you plan to arrive
            this way. See above for details on public transport ships.
        </p>
    </div>
</div></div>
        </div>
    </div>
</main>    
