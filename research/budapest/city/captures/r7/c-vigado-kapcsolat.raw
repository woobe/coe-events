th\":61,\"height\":65},\"url\":\"https://www.mma.hu/az-akademia\"},{\"label\":\"MMA | MMKI \",\"logo\":{\"alt\":\"MMA-logo-kutato\",\"url\":\"/api/media/file/MMA-logo-kutato.png\",\"width\":109,\"height\":75},\"url\":\"https://www.mma-mmki.hu/\"},{\"label\":\"Műcsarnok\",\"logo\":{\"alt\":\"Mucsarnok\",\"url\":\"/api/media/file/Mucsarnok.png\",\"width\":110,\"height\":60},\"url\":\"https://www.mucsarnok.hu/\"}],\"ungroupedLinks\":[{\"label\":\"Impresszum\",\"url\":\"/impresszum\"},{\"label\":\"Adatvédelem\",\"url\":\"/adatvedelem\"},{\"label\":\"Szerzői jogok\",\"url\":\"/szerzoi-jogok\"},{\"label\":\"Közérdekű adatok\",\"url\":\"/kozerdeku-adatok\"},{\"label\":\"Házirend\",\"url\":\"/hazirend\"},{\"label\":\"ÁSZF\",\"url\":\"/altalanos-szerzodesi-feltetelek\"},{\"label\":\"Akadálymentesítési nyilatkozat\",\"url\":\"/akadalymentesitesi-nyilatkozat\"}]},\"openingHours\":{\"id\":153,\"day\":\"2026-11-26T12:00:00.000Z\",\"openingTime\":\"2026-02-25T09:00:00.000Z\",\"closingTime\":\"2026-02-25T18:00:00.000Z\",\"isClosed\":false,\"message\":\"A II. emelet 10:00-19:00 óra között nem látogatható. \",\"updatedAt\":\"2026-10-30T15:39:55.379Z\",\"createdAt\":\"2026-10-30T15:38:01.652Z\"},\"oncomingEvents\":[{\"id\":206,\"title\":\"Szimfonikus látomások: Utak és szenvedélyek\",\"description\":\"A Miskolci Szimfonikus Zenekar koncertje\",\"coverImage\":{\"id\":639,\"alt\":\"Miskolci szimfónikusok\",\"prefix\":\"media\",\"folder\":{\"id\":25,\"name\":\"11. november\",\"folder\":14,\"documentsAndFolders\":{\"docs\":[{\"relationTo\":\"media\",\"value\":694},{\"relationTo\":\"media\",\"value\":693},{\"relationTo\":\"media\",\"value\":691},{\"relationTo\":\"media\",\"value\":682},{\"relationTo\":\"media\",\"value\":681},{\"relationTo\":\"media\",\"value\":680},{\"relationTo\":\"media\",\"value\":679},{\"relationTo\":\"media\",\"value\":678},{\"relationTo\":\"media\",\"value\":677},{\"relationTo\":\"media\",\"value\":676}],\"hasNextPage\":true},\"folderType\":[\"media\"],\"updatedAt\":\"2026-01-15T10:25:00.704Z\",\"createdAt\":\"2026-01-15T10:25:00.704Z\"},\"updatedAt\":\"2026-09-25T12:50:27.273Z\",\"createdAt\":\"2026-09-25T12:50:27.213Z\",\"url\":\"/api/media/file/miskolciszimfonikusok.jpg\",\"thumbnailURL\":null,\"filename\":\"miskolciszimfonikusok.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":324018,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"szimfonikus-latomasok-utak-es-szenvedelyek\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":5,\"name\":\"concert\",\"displayName\":\"Koncert\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-19T14:29:00.498Z\",\"createdAt\":\"2025-11-11T08:56:11.206Z\"},\"room\":{\"id\":23,\"name\":\"Díszterem\",\"floor\":\"2. emelet\",\"coverImage\":{\"id\":38,\"alt\":\"Diszterem_Vigado\",\"prefix\":\"media\",\"folder\":3,\"updatedAt\":\"2025-11-06T10:16:52.916Z\",\"createdAt\":\"2025-11-06T10:16:52.916Z\",\"url\":\"/api/media/file/D%C3%ADszterem_Vigado.jpg\",\"thumbnailURL\":null,\"filename\":\"Díszterem_Vigado.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":777842,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[]},\"visitConfig\":{\"isVisitable\":true,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-01-28T11:38:06.009Z\",\"createdAt\":\"2026-01-27T09:04:03.399Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"6ab66fda80d06d6bba832954\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Cser Ádám: Visions - szimfonikus képek ŐSBEMUTATÓ\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Siklósi Kristóf: Európai utak\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Hidas Frigyes: Klarinétverseny\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Könczei Árpád: Impulzusok ŐSBEMUTATÓ\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Selmeczi György: Clown gages and passions - szimfonikus trilógia (Bohóctréfák és szenvedélyek) ŐSBEMUTATÓ\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"km.: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Varga Gábor\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" – klarinét\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"vezényel: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Cser Ádám\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Műsorunk elején az est karmesterének, Cser Ádámnak legújabb alkotása szerepel, amelyen még épphogy megszáradt a tinta. A Miskolci Szimfonikus Zenekar a korábbiakban már több alkalommal tűzte műsorra a nagyszerű dirigens, zeneszerző alkotásait. Ezúttal ősbemutatóként hangzik majd el a \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Visions – szimfonikus képek \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"című opusz.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ezt követően \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Európai utak\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" címmel a miskolci születésű Siklósi Kristóf hangszerelésében kel újra életre négy zongoradarab:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Liszt Ferenc: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"4. Mefisztó-keringő\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Liszt Ferenc: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Álmatlanul! Kérdés és válasz\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Bartók Béla: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Ostinato\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Kurtág György: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Tollrajz, búcsózóul Schaár Erzsébetnek\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A szerző így kommentálta a Miskolci Szimfonikus Zenekarnak ajánlott művet: „\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"A sorozat koncepcióját tekintve legyen irányadó Bartók kortársának, József Attilának Thomas Mann üdvözlése című verse, minthogy ő nálam egyszerűbben, lényegre törőbben, mélyrehatóbban tudja megfogalmazni, mit érzek ezekkel a darabokkal kapcsolatban.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\"”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Hidas Frigyest az utolsó magyar romantikus zeneszerzőként szokás emlegetni. A legkülönfélébb fúvós hangszerekre írt műveket, amelyek közül a mai este folyamán a klarinét kerül a középpontba. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Klarinétverseny\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"ének szólistája Varga Gábor, a hazai komolyzenei hangversenyélet meghatározó szereplője, világjáró művész és több egyetem tanára.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Az\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\" Impulzusok zenekarra\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" (angolul \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Impulses for Orchestra\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\") az UNITER- és Harangozó Gyula-díjas zeneszerző és koreográfus, Könczei Árpád 2023-ban komponált komolyzenei alkotása. Az egytételes zenemű hangzását az impulzusok, vagyis a zenei cselekvések, a ritmikai lendületek, a hangmagasság-váltások, fokozások határozzák meg. A zenemű hangzásvilágát a szabad és kötött ritmusok, a dinamikai, valamint hangszínbeli kontrasztok adják. A darab - ,amely szintén ősbemutatóként hangzik el - remekül tükrözi a szerző kettős művészeti identitását, ahol a klasszikus zenei kompozíciós technikák találkoznak a dinamikus, mozgásalapú és strukturális energiákkal.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A színes hangszerelésű, nagyszabású zenekari mű, a \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Clown gages and passions\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" - szimfonikus trilógia (\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Bohóctréfák és szenvedélyek\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"mode\":\"normal\",\"text\":\") tételei három jól ismert kulturális vagy irodalmi alak karakterét, szenvedélyeit és „játékait” idézik meg:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Pehlivani\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Play Casanova\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Limerick\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\" \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Miskolchoz megannyi szállal kötődő, s a jó emlékű Új Zenei Műhelyt is vezető Selmeczi György kompozíciója ősbemutatóként zárja az estét.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Szervező: Miskolci Szimfonikus Zenekar\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A koncert támogatója a Magyar Művészeti Akadémia\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":360,\"adminTitle\":\"Szimfonikus látomások: Utak és szenvedélyek - 2026.11.27 19:30\",\"title\":\"Szimfonikus látomások: Utak és szenvedélyek\",\"slug\":\"szimfonikus-latomasok-utak-es-szenvedelyek\",\"slugLock\":false,\"startDate\":\"2026-11-27T18:30:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":null,\"ticketPrice\":\"TELTHÁZ!\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":354,\"maxCounterPerUser\":4,\"openPositions\":13,\"acceptedRegistrations\":176,\"acceptedParticipants\":341,\"onWaitingList\":0,\"onWaitingListParticipants\":0,\"cancelledRegistrations\":13,\"cancelledParticipants\":18,\"pendingConfirmations\":19,\"pendingParticipants\":38},\"updatedAt\":\"2026-11-25T09:46:37.734Z\",\"createdAt\":\"2026-09-25T13:06:51.649Z\"}],\"updatedAt\":\"2026-11-04T12:56:12.303Z\",\"createdAt\":\"2026-09-25T13:05:20.532Z\"},{\"id\":222,\"title\":\"Adventi koszorú készítő workshop\",\"description\":\"Hangolódj velünk az ünnepekre – készítsd el saját adventi koszorúdat!\",\"coverImage\":{\"id\":658,\"alt\":\"adventi koszorú készítés\",\"prefix\":\"media\",\"folder\":\"$18:props:children:props:oncomingEvents:0:coverImage:folder\",\"updatedAt\":\"2026-10-12T14:50:34.766Z\",\"createdAt\":\"2026-10-12T14:50:34.680Z\",\"url\":\"/api/media/file/adventi-koszoru-keszites.jpg\",\"thumbnailURL\":