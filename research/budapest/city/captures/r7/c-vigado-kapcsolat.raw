se_slideshow\":\"Diavetítés szüneteltetése\",\"resume_slideshow\":\"Diavetítés folytatása\",\"slide_announcement\":\"{current}. dia a(z) {total}-ből\",\"remove_filter\":\"Szűrő eltávolítása: {label}\"},\"Gallery\":{\"title\":\"Galéria ({count} kép)\",\"lightbox_title\":\"Galéria — {current} / {total} kép\"},\"Events\":{\"featured_events\":\"Kiemelt programok\",\"all_events\":\"Összes program\",\"constant\":\"Állandó\",\"upcoming_events\":\"Közelgő események\",\"concert\":\"Koncert\",\"exhibition\":\"Kiállítás\",\"informative\":\"Ismeretterjesztő\",\"general\":\"Általános\",\"archiv\":\"Archívum\",\"virtual\":\"Virtuális\",\"vigado-podcast\":\"Vigadó Podcast\",\"current_exhibitions\":\"Aktuális kiállításaink\",\"vigado_club_card_info\":\"A Vigadó Pontban váltsa ki a Pesti Vigadó Klubkártyát, amely tulajdonosai számára különleges kedvezményeket és jogosultságokat biztosítunk!\",\"all_exhibitions\":\"Összes kiállítás\",\"title\":\"Programok\",\"list_view_tab_label\":\"Lista nézet\",\"calendar_view_tab_label\":\"Naptár nézet\",\"category_filter_label\":\"Kategória\",\"room_filter_label\":\"Helyszín\",\"date_filter_label\":\"Időpont\",\"delete_filters_button_label\":\"Szűrők törlése\",\"apply_filters_button_label\":\"Alkalmaz\",\"apply_filters_button_disabled_tooltip\":\"Válasszon ki kezdő és befejező dátumot\",\"list_show_more_button_label\":\"Mutass többet\",\"no_events_alert_message\":\"Ezen a napon nincs program! Azonban kiállításainkra szeretettel várjuk!\",\"exhibitions_carosuel_title\":\"Kiállítások\",\"exhibition_banner_title\":\"Aktuális kiállításaink\",\"exhibition_banner_description\":\"A Vigadó Pontban váltsa ki a Pesti Vigadó Klubkártyát, amely tulajdonosai számára különleges kedvezményeket és jogosultságokat biztosítunk!\",\"exhibition_banner_button_label\":\"Összes kiállítás\",\"closed_alert_message\":\"A Vigadó épülete ezen a napon zárva tart!\",\"room_link_label\":\"A helyszínről\",\"ticket_types_label\":\"Jegytípusok\",\"share_label\":\"Megosztás\",\"buy_tickets\":\"Jegyvásárlás\",\"register_to_event\":\"Jelentkezés az eseményre\",\"publicationsTitle\":\"Megvásárolható kiadványok\",\"banner_more_button_label\":\"További információ\",\"galleryTitle\":\"Vigadó Galéria\",\"galleryDescription\":\"Fedezze fel régebbi kiállítasainkat és virtuális kiállításainkat a Vigadó Galériában!\",\"galleryYearFilterLabel\":\"Évszám\",\"currentExhibitions\":\"Aktuális kiállítások\",\"eventsByYearLabel\":\"Archív és virtuális Kiállítások\",\"countLabel\":\"darab\",\"multipleEvents\":\"Több időpont\",\"moreTimeSlots\":\"További időpontok\"},\"EventApplication\":{\"free\":\"Ingyenes\",\"formTitle\":\"Jelentkezés az eseményre\",\"formTitleCancellation\":\"Jelentkezés lemondása\",\"seatLabel\":\"Személy\",\"firstNamePlaceholder\":\"Keresztnév\",\"lastNamePlaceholder\":\"Vezetéknév\",\"emailPlaceholder\":\"E-mail cím\",\"formLabel\":\"Kérjük adja meg az adatait.\",\"waitlistFormAlert\":\"Sajnos ez az eseményünk már betelt. A jelentkezéssel egy várólistára kerül és amennyiben lemondás történik, értesítjük önt e-mailben.\",\"acceptTerms\":\"Elfogadom az \u003clink\u003eAdatkezelési tájékoztatót\u003c/link\u003e.\",\"submitLabel\":\"Jelentkezés\",\"pendingAlert\":\"A jelentkezés véglegesítéséhez kérjük, erősítse meg e-mail címét a kiküldött levélben található linken. Amennyiben nem kapta meg az e-mailt, kérhet újraküldést, vagy ellenőrizheti megadott címét.\",\"acceptedAlert\":\"A jelentkezése sikerült. A visszaigazolást elküldtük önnek e-mailben. Jó szórakozást kívánunk!\",\"cancelledAlert\":\"A jelentkezés lemondása sikerült.\",\"waitlistAlert\":\"Sikeresen jelentkezett a várólistára. A visszaigazolást elküldtünk önnek e-mailben. Amennyiben lemondás történik, értesíteni fogjuk a megadott elérhetőségen.\",\"failedAlert\":\"A megerősítés sikertelen volt. Kérjük próbálja újra.\",\"cancellationFailedError\":\"A jelentkezés lemondása sikertelen volt. Kérjük próbálja újra.\",\"genericError\":\"Hiba történt a jelentkezés során. Kérjük próbálja újra.\",\"duplicateEmailError\":\"Az eseményre regisztráltunk már jelentkezést ezzel az email címmel, kérjük próbáljon meg egy másik email címet.\",\"eventAlreadyStartedError\":\"Ez az esemény már elkezdődött vagy lezárult. Kérjük tekintse meg további eseményeinket!\",\"registrationClosedError\":\"Az eseményre jelenleg nem lehet jelentkezni. Kérjük tekintse meg további eseményeinket!\",\"formDescription\":\"{programTitle} — {eventDate}\"},\"Rooms\":{\"events_in_this_room\":\"Események ebben a teremben\",\"more_rooms\":\"További termek\",\"all_rooms\":\"Összes terem\",\"currently_not_available\":\"Jelenleg nem elérhető!\",\"visitable_rooms_title\":\"Látogatha­tó termek\",\"visitable_rooms_list_title\":\"Látogatható termek\",\"visitable_rooms_subtitle\":\"Rendezvényhelyszín a történelem szívében – a Pesti Vigadóban\",\"visitable_rooms_description\":\"A Pesti Vigadó a Magyar Művészeti Akadémia székházaként a hazai kulturális élet egyik meghatározó helyszíne, amely nemcsak történelmi múltjával, hanem kortárs művészeti eseményeivel is kiemelkedik. Az épület impozáns terei – ahol a 19. századtól napjainkig számos rangos esemény zajlott – külső partnerek számára is elérhetők rendezvényhelyszínként.\",\"rentals\":\"Terembérlés\",\"rentable_rooms_title\":\"Terem­bérlés\",\"rentable_rooms_subtitle\":\"Rendezvényhelyszín a történelem szívében – a Pesti Vigadóban\",\"rentable_rooms_description\":\"A Pesti Vigadó a Magyar Művészeti Akadémia székházaként a hazai kulturális élet egyik meghatározó helyszíne, amely nemcsak történelmi múltjával, hanem kortárs művészeti eseményeivel is kiemelkedik. Az épület impozáns terei – ahol a 19. századtól napjainkig számos rangos esemény zajlott – külső partnerek számára is elérhetők rendezvényhelyszínként.\",\"rentable_rooms_list_title\":\"Bérelhető termek\",\"rentable_rooms_alert\":\"A helyszín bérlésének lehetősége minden esetben egyedi elbírálás alapján történik. Az igénybevétel feltételeiről és a kapcsolódó szolgáltatásokról, valamint a szabad időpontokról írásos megkeresés alapján tudunk tájékoztatást adni az alábbi elérhetőségeken.\",\"rental_information_business_events_title\":\"Üzleti, céges rendezvények\",\"rental_information_business_contact_name\":\"Borók Zsuzsa\",\"rental_information_business_contact_role\":\"értékesítési és rendezvényszervezési vezető\",\"rental_information_business_contact_email\":\"rendezveny@vigado.hu\",\"rental_information_cultural_events_title\":\"Kulturális rendezvények\",\"rental_information_cultural_events_subtitle\":\"(koncertek, színpadi programok)\",\"rental_information_cultural_contact_name\":\"Sitkei Nóra\",\"rental_information_cultural_contact_role\":\"kulturális szervezési vezető\",\"rental_information_cultural_contact_email\":\"kulturalisprogramok@vigado.hu\",\"rental_information_exhibitions_title\":\"Kiállításszervezés, kiállítótermi programok\",\"rental_information_exhibitions_contact_name\":\"Juhos-Kiss Gellért\",\"rental_information_exhibitions_contact_role\":\"kiállításszervezési vezető\",\"rental_information_exhibitions_contact_email\":\"galeria@vigado.hu\",\"rental_information_ticketing_title\":\"Jegyértékesítés, közönségszervezés\",\"rental_information_ticketing_contact_name\":\"Moravcsik-Nagy Flóra\",\"rental_information_ticketing_contact_role\":\"közönségszervezési és turisztikai vezető\",\"rental_information_ticketing_contact_email\":\"kozonsegszolgalat@vigado.hu\",\"rentable_rooms_floorplan\":\"Alaprajz megtekintése\",\"rentable_rooms_capacity\":\"Termek befogadóképessége\",\"rentable_rooms_terms\":\"Általános Szerződési Feltételek\",\"capacity_label\":\"max. {capacity} fő\",\"availability_available\":\"Elérhető\",\"availability_not_available\":\"Nem elérhető\",\"panorama_title\":\"Panoráma — {title}\",\"panorama_keyboard_hint\":\"A nyíl billentyűkkel forgathatja a panorámát, a + és - billentyűkkel nagyíthat.\"},\"Search\":{\"inputPlaceholder\":\"Események\",\"searchButtonLabel\":\"Keresés\",\"resultsTitle\":\"Keresési találatok\",\"noResultsMessage