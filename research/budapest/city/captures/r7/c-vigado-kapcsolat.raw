mage\":{\"id\":85,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:13:37.491Z\",\"createdAt\":\"2025-11-17T13:12:37.193Z\",\"url\":\"/api/media/file/Makovecz_3.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_3.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":625526,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1fec6961fa18a1bcf6af\",\"image\":{\"id\":86,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:13:37.480Z\",\"createdAt\":\"2025-11-17T13:12:41.407Z\",\"url\":\"/api/media/file/Makovecz_4.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_4.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":582118,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b1ff56961fa18a1bcf6b0\",\"image\":{\"id\":87,\"alt\":\"Makovecz_terem_nezet\",\"prefix\":\"media\",\"folder\":7,\"updatedAt\":\"2025-11-17T13:14:13.711Z\",\"createdAt\":\"2025-11-17T13:12:45.611Z\",\"url\":\"/api/media/file/Makovecz_5.jpg\",\"thumbnailURL\":null,\"filename\":\"Makovecz_5.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":578898,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"}],\"blockType\":\"galleryBlock\"}]},\"visitConfig\":{\"isVisitable\":null,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-01-29T10:09:25.369Z\",\"createdAt\":\"2025-11-17T13:04:47.138Z\"},\"lengthInfo\":\"~ 2.5 óra\",\"content\":[{\"id\":\"6accf3f3d0a929af2134fc27\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Idén is szeretettel várunk adventi koszorú készítő workshopunkra, ahol egy kellemes, inspiráló délelőtt keretében elkészítheted a saját, egyedi adventi koszorúdat – és közben garantáltan karácsonyi hangulatba kerülünk!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A workshop során:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"minden szükséges alapanyagot, gyertyát és eszközt mi biztosítunk,\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"szakmai segítséget és útmutatást kapsz, hogy a saját ízlésedhez illő, egyedi koszorút alkotsd meg,\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"közben forró teával, süteménnyel és igazi karácsonyi hangulattal várunk.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"az alkotás időtartama: kb. 2,5 óra\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"És ami a legjobb: a workshop végén hazaviheted a saját kezed munkáját, amely az advent minden vasárnapján emlékeztet majd erre a közös, ünnepi délelőttre! :)\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A helyek száma korlátozott! A workshopon maximum 14 fő vehet részt, ezért az előzetes jegyvásárlás szükséges. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"A workshopot minimum 5 fő jelentkezése esetén tartjuk meg!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A programot tartja: Keszericze-Cser Júlia\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ha szeretnél egy kicsit kiszakadni az év végi rohanásból, alkotni, feltöltődni és már november végén megérezni a karácsony varázsát, szeretettel várunk!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"block\",\"fields\":{\"id\":\"6ae33f1174d202661ff331be\",\"href\":\"https://vigado.hu/en/programok/advent-wreath-making-workshop-?idopont=414\",\"title\":\"For english speakers!\",\"blockName\":\"\",\"blockType\":\"rtlinkboxblock\",\"description\":\"If you would like to take part in the wreath-making workshop, please purchase a ticket for the 2:00 p.m. session conducted in English.\"},\"format\":\"\",\"version\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":414,\"adminTitle\":\"Adventi koszorú készítő workshop - 2026.11.28 10:00\",\"title\":\"Adventi koszorú készítő workshop\",\"slug\":\"adventi-koszoru-keszito-workshop\",\"slugLock\":false,\"startDate\":\"2026-11-28T09:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"hu\",\"interticketLink\":\"https://vigado.jegy.hu/program/adventi-koszoru-keszito-workshop-198469/1518235\",\"ticketPrice\":\"15 000 Ft\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-20T11:23:16.744Z\",\"createdAt\":\"2026-10-12T14:57:45.710Z\"}],\"updatedAt\":\"2026-10-29T12:45:52.658Z\",\"createdAt\":\"2026-10-12T14:59:45.453Z\"},{\"id\":8,\"title\":\"Mesél a Vigadó – Épülettörténeti séta\",\"description\":\"Fedezze fel a Pesti Vigadó több mint 190 éves történelmét és építészetét! \",\"coverImage\":{\"id\":44,\"alt\":\"Epulettorteneti_seta_borito\",\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2025-11-11T12:51:45.161Z\",\"createdAt\":\"2025-11-11T12:51:45.160Z\",\"url\":\"/api/media/file/Epulettorteneti_seta_borito.jpg\",\"thumbnailURL\":null,\"filename\":\"Epulettorteneti_seta_borito.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":244625,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"mesel-a-vigado--epulettorteneti-seta\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":16,\"name\":\"Épületséta\",\"displayName\":\"Épületséta\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T10:41:31.337Z\",\"createdAt\":\"2026-01-15T14:13:18.872Z\"},\"room\":{\"id\":24,\"name\":\"Pesti Vigadó\",\"floor\":\"0-6\",\"coverImage\":{\"id\":44,\"alt\":\"Epulettorteneti_seta_borito\",\"prefix\":\"media\",\"folder\":null,\"updatedAt\":\"2025-11-11T12:51:45.161Z\",\"createdAt\":\"2025-11-11T12:51:45.160Z\",\"url\":\"/api/media/file/Epulettorteneti_seta_borito.jpg\",\"thumbnailURL\":null,\"filename\":\"Epulettorteneti_seta_borito.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":244625,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":null,\"capacity\":null,\"sidebarInfo\":null,\"rentUrl\":null,\"content\":[]},\"visitConfig\":{\"isVisitable\":null,\"rentUrl\":null,\"content\":[]},\"updatedAt\":\"2026-04-08T14:17:44.892Z\",\"createdAt\":\"2026-02-06T09:22:38.883Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"691330d53a4744dcf1c7cf14\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Fedezze fel a Pesti Vigadó több mint 190 éves történelmét és építészetét! \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ismerje meg a Pesti Vigadót, Budapest egyik legimpozánsabb kulturális örökségét, ami nemcsak építészeti remekmű, hanem a magyar történelem és művészetek színtere is.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Pesti Vigadó nagy szeretettel várja az épület gyönyörű belső terei, történelme és panorámája iránt érdeklődőket előre meghirdetett időpontokban. A látogatók szakképzett idegenvezetőink kíséretében járhatják be a teljes műemléki épületet, megtekinthetik az épület impozáns stílusjegyeit, rejtett kincseit, megismerkedhetnek az építészek és művészek munkájával, akik formálták ezt a különleges helyet, valamint felfedezhetik, hogyan alakult át az épület szerepe az évszázadok során.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ne hagyja ki ezt az egyedülálló lehetőséget, hogy a történelmet testközelből élhesse át a Pesti Vigadó varázslatos falai között!\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"FONTOS TUDNIVALÓK:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A vezetés várható időtartama 60 perc.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kérjük vendégeinket a házirend betartására és a szolgáltatásunkra vonatkozó feltételek elfogadására.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Kérjük, hogy olvassák el Intézménylátogatási tájékoztatónkat.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Az Épülettörténeti sétákra 70 év feletti Látogatóink nyugdíjas jegy megváltásával vehetnénk részt.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":5,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A túra során az épület azon részei is bejárhatók, melyek a nagyközönség számára nem vagy csak részben látogathatók! A jegyárba beletartozik az idegenvezetés mellett valamennyi kiállítás megtekintése is.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":6,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Csoportlétszám maximálisan 35 fő lehet, helyét előzetes jegyvásárlással tudja biztosítani.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"További információk:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Jegypénztár +36 (1) 328-3340\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Közönségszervezés: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"autolink\",\"fields\":{\"url\":\"mailto:turizmus@vigado.hu\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":2,\"children\":[{\"mode\":\"normal\",\"text\":\"turizmus@vigado.hu\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A díjmentes Pesti Vigadó Klubkártyával rendelkezőknek 3% kedvezményt biztosítunk a program árából.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":405,\"adminTitle\":\"Mesél a Vigadó – Épülettörténeti séta - 2026.11.28 10:30\",\"title\":\"Mesél a Vigadó – Épülettörténeti séta\",\"slug\":\"mesel-a-vigado--epulettorteneti-seta\",\"slugLock\":true,\"startDate\":\"2026-11-28T09:30:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"hu\",\"interticketLink\":\"https://vigado.jegy.hu/program/mesel-a-vigado-epulettorteneti-seta-121329/1513897\",\"ticketPrice\":\"4 000 Ft\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-07T15:13:31.323Z\",\"createdAt\":\"2026-10-07T15:13:31.323Z\"},{\"id\":407,\"adminTitle\":\"Mesél a Vigadó – Épülettörténeti séta - 2026.11.29 10:30\",\"title\":\"Mesél a Vigadó – Épülettörténeti séta\",\"slug\":\"mesel-a-vigado--epulettorteneti-seta\",\"slugLock\":true,\"startDate\":\"2026-11-29T09:30:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"hu\",\"interticketLink\":\"https://vigado.jegy.hu/program/mesel-a-vigado-epulettorteneti-seta-121329/1513898\",\"ticketPrice\":\"4 000 Ft\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-07T15:15:37.658Z\",\"createdAt\":\"2026-10-07T15:15:37.658Z\"}],\"updatedAt\":\"2026-11-16T10:12:25.984Z\",\"createdAt\":\"2025-11-11T12:51:48.302Z\"},{\"id\":197,\"title\":\"Az aranyalmák nyomában\",\"description\":\"A TITOK · TÖRTÉNET · MESE című kiállítás kísérőprogramja\",\"coverImage\":{\"id\":662,\"alt\":\"az aranyalmák nyomában\",\"prefix\":\"media\",\"folder\":\"$18:props:children:props:oncomingEvents:0:coverImage:folder\",\"updatedAt\":\"2026-10-19T12:18:40.103Z\",\"createdAt\":\"2026-10-19T12:18:40.003Z\",\"url\":\"/api/media/file/az-aranyalmak-nyomaban.jpg\",\"thumbnailURL\":null,\"filename\":\"az-aranyalmak-nyomaban.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":731432,\"width\":3319,\"height\":1500,\"focalX\":50,\"focalY\":50},\"slug\":\"az-aranyalmak-nyomaban\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":\"$18:props:children:props:oncomingEvents:1:category\",\"room\":\"$18:props:children:props:oncomingEvents:2:room\",\"lengthInfo\":null,\"content\":[{\"id\":\"6a98326263b075f8cc4cf6e9\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Valaki minden éjjel magával viszi a Pesti Vigadó – avagy Tündérpalota – különös fáján termő aranyalmáit. Sokan próbálták már megőrizni a mesebeli gyümölcsöket, de még senkinek sem sikerült.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Ezúttal Árgyélus királyfin a sor, és most kedves 7-13 évesek, Ti is vele tarthattok.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A történelem és a képzelet határán barangolunk, ahol egyszer alkotók, máskor szemlélők leszünk, a mesén keresztül pedig a saját történetünkkel, a világunkkal és egymással is találkozhatunk. A részvevők a Pesti Vigadó szellemi és építészeti közegét interdiszciplináris megközelítéssel - a mozgáson, a mesén, a zenén és a vizualitás nyelvén keresztül – fedezhetik fel.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A foglalkozást Kovács Lili építész vezeti.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A gyerekek a programon önállóan, szülői kíséret nélkül vesznek részt. A gyermek részvételi díja 2000 Ft. Amíg a gyerekek alkotnak és felfedeznek, a szülőknek lehetőségük van szintén 2000 Ft-os jegyet váltani, amellyel a foglalkozás ideje alatt kedvezményesen megtekinthetik aktuális kiállításainkat, valamint – az elérhetőség függvényében – a Pesti Vigadó épületét is bejárhatják.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2}],\"direction\":null}}}],\"events\":[{\"id\":461,\"adminTitle\":\"Az aranyalmák nyomában - 2026.11.29 16:00\",\"title\":\"Az aranyalmák nyomában\",\"slug\":\"az-aranyalmak-nyomaban\",\"slugLock\":true,\"startDate\":\"2026-11-29T15:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":\"https://vigado.jegy.hu/program/az-aranyalmak-nyomaban-muzeumpedagogiai-foglalkozas-196634/1527176\",\"ticketPrice\":\"2 000 Ft\",\"registrationParams\":{\"registrationEnabled\":false,\"maxParticipants\":1,\"maxCounterPerUser\":null,\"openPositions\":null,\"acceptedRegistrations\":null,\"acceptedParticipants\":null,\"onWaitingList\":null,\"onWaitingListParticipants\":null,\"cancelledRegistrations\":null,\"cancelledParticipants\":null,\"pendingConfirmations\":null,\"pendingParticipants\":null},\"updatedAt\":\"2026-10-29T09:26:51.451Z\",\"createdAt\":\"2026-10-29T09:26:51.451Z\"}],\"updatedAt\":\"2026-11-25T09:55:54.925Z\",\"createdAt\":\"2026-09-02T14:29:56.345Z\"},{\"id\":248,\"title\":\"A minőség erkölcse\",\"description\":\"A 125 éve született Németh Lászlóra emlékezünk\",\"coverImage\":{\"id\":691,\"alt\":\"Németh László\",\"prefix\":\"media\",\"folder\":\"$18:props:children:props:oncomingEvents:0:coverImage:folder\",\"updatedAt\":\"2026-11-17T15:42:45.986Z\",\"createdAt\":\"2026-11-17T15:42:45.898Z\",\"url\":\"/api/media/file/nemeth-laszlo.jpg\",\"thumbnailURL\":null,\"filename\":\"nemeth-laszlo.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":126345,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"a-minoseg-erkolcse\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":null,\"category\":{\"id\":10,\"name\":\"Irodalom\",\"displayName\":\"Irodalom\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T11:09:00.336Z\",\"createdAt\":\"2025-11-27T12:06:07.679Z\"},\"room\":{\"id\":18,\"name\":\"Sinkovits Imre Kamaraszínpad\",\"floor\":\"IV. emelet\",\"coverImage\":{\"id\":88,\"alt\":\"Sinkovits_Imre_Kamaraszinpad\",\"prefix\":\"media\",\"folder\":3,\"updatedAt\":\"2025-11-17T13:18:53.945Z\",\"createdAt\":\"2025-11-17T13:18:53.943Z\",\"url\":\"/api/media/file/Sinkovits_kamaraszinpad.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_kamaraszinpad.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":713224,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"rentConfig\":{\"isRentable\":true,\"capacity\":165,\"sidebarInfo\":\"\",\"rentUrl\":null,\"content\":[{\"id\":\"691b206b6961fa18a1bcf6b1\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Pesti Vigadó IV. emeletén található Sinkovits Imre Kamaraszínpad színpadi produkciók megrendezésére szolgál.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Sinkovits Imre Kamaraszínpad a Pesti Vigadó egyetlen, fix széksoros helyszíne. A 11 soros, soronként 15 székes elrendezésnek köszönhetően összesen 165-en vehetnek részt a Kamaraszínpadon megvalósuló színpadi produkciókon, konferenciákon, beszélgetéseken, vetítéseken.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Sinkovits Imre Kamaraszínpad berendezését az alábbi galérián keresztül tekintheti meg.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}},{\"id\":\"691b21a76c6a9b7fb45313fa\",\"blockName\":null,\"slides\":[{\"id\":\"691b21ab6c6a9b7fb45313fb\",\"image\":{\"id\":89,\"alt\":\"Kamaraszinpad_elolnezet\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:00.086Z\",\"createdAt\":\"2025-11-17T13:21:25.031Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_1.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_1.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":628543,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"\",\"description\":\"\"},{\"id\":\"691b21ac6c6a9b7fb45313fc\",\"image\":{\"id\":90,\"alt\":\"Kamaraszinpad_oldalnezet\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:00.088Z\",\"createdAt\":\"2025-11-17T13:21:29.350Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_2.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_2.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":681465,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21ac6c6a9b7fb45313fd\",\"image\":{\"id\":91,\"alt\":\"Kamaraszinpad_szinpad\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:00.080Z\",\"createdAt\":\"2025-11-17T13:21:33.682Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_3.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_3.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":575999,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"},{\"id\":\"691b21b06c6a9b7fb45313fe\",\"image\":{\"id\":92,\"alt\":\"Kamaraszinpad_oldalnezet\",\"prefix\":\"media\",\"folder\":8,\"updatedAt\":\"2025-11-17T13:22:35.519Z\",\"createdAt\":\"2025-11-17T13:21:38.419Z\",\"url\":\"/api/media/file/Sinkovits_Kamaraszinpad_4.jpg\",\"thumbnailURL\":null,\"filename\":\"Sinkovits_Kamaraszinpad_4.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":544100,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50},\"artist\":\"$undefined\",\"description\":\"$undefined\"}],\"blockType\":\"galleryBlock\"}]},\"visitConfig\":{\"isVisitable\":false,\"rentUrl\":\"\",\"content\":[]},\"updatedAt\":\"2026-01-29T10:07:25.200Z\",\"createdAt\":\"2025-11-17T13:18:58.191Z\"},\"lengthInfo\":null,\"content\":[{\"id\":\"6afc761f71188b964aa65fda\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"„Ami bennem lélek, veletek megy; ott fog köztetek lenni mindig. Megtalálsz virágaid között, mikor elhervadnak; megtalálsz a falevélben, mikor lehull; meghallasz az esti harangszóban, mikor elenyészik; s mikor megemlékezel rólam, mindig arccal szemközt fogok veled állani.”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"-- Jókai Mór: És mégis mozog a föld\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"125 éve, 1901-ben született Németh László Kossuth-díjas író, esszéista, drámaíró és műfordító, a 20. századi magyar irodalom egyik legmeghatározóbb, mégis magányos alakja. Eredetileg orvosként indult, és a jó diagnoszta éles szemével, valamint erős nevelői szándékkal vizsgálta a magyar társadalom és az egyén sorskérdéseit. Sokoldalú pályája során tanított, szerkesztett, sőt a Magyar Rádió irodalmi osztályát is vezette, miközben sajátos, reflexív prózájával és drámáival maradandót alkotott. Életműve – amelyben a gondolati mélység és a közösség iránti felelősségvállalás fonódik össze – ma is élénk viták és újrafelfedezések forrása.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Közreműködik:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Ember Léna, Gál Ádám Vajk, Grasso Marco, Hubbes Mátyás, Pozsgai Máté, Trill Bertalan\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" és \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Tüske Márton\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\",\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"a Színház- és Filmművészeti Egyetem hallgatói\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Zenei közreműködő: \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Juhász Zoltán\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"népzenész, az MMA rendes tagja\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Rendező:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Miklós-Kovács Bernát\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"a Színház- és Filmművészeti Egyetem hallgatója\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Köszöntőt mond:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"L. Simon László \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"József Attila- és Babérkoszorú-díjas költő, író, az MMA Irodalmi Tagozatának vezetője, az est szerkesztője\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Szervező: MMA - Irodalmi Tagozat\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}}}],\"events\":[{\"id\":488,\"adminTitle\":\"Örökségünk: „A minőség forradalmára, Németh László\\\" - 2026.11.30 18:00\",\"title\":\"Örökségünk: „A minőség forradalmára, Németh László\\\"\",\"slug\":\"oroksegunk-a-minoseg-forradalmara-nemeth-laszlo\",\"slugLock\":true,\"startDate\":\"2026-11-30T17:00:00.000Z\",\"endDate\":null,\"displayedOnLanguages\":\"both\",\"interticketLink\":null,\"ticketPrice\":\"Ingyenes, regisztráció szükséges!\",\"registrationParams\":{\"registrationEnabled\":true,\"maxParticipants\":120,\"maxCounterPerUser\":4,\"openPositions\":68,\"acceptedRegistrations\":35,\"acceptedParticipants\":52,\"onWaitingList\":0,\"onWaitingListParticipants\":0,\"cancelledRegistrations\":2,\"cancelledParticipants\":4,\"pendingConfirmations\":2,\"pendingParticipants\":4},\"updatedAt\":\"2026-11-26T07:03:03.023Z\",\"createdAt\":\"2026-11-17T16:00:16.731Z\"}],\"updatedAt\":\"2026-11-23T12:56:59.040Z\",\"createdAt\":\"2026-11-17T16:00:20.392Z\"},{\"id\":124,\"title\":\"Láncreakció\",\"description\":\"Vajda Katalin drámája\",\"coverImage\":{\"id\":268,\"alt\":\"Láncreakció\",\"prefix\":\"media\",\"folder\":{\"id\":19,\"name\":\"05. május\",\"folder\":14,\"documentsAndFolders\":{\"docs\":[{\"relationTo\":\"media\",\"value\":576},{\"relationTo\":\"media\",\"value\":575},{\"relationTo\":\"media\",\"value\":574},{\"relationTo\":\"media\",\"value\":573},{\"relationTo\":\"media\",\"value\":572},{\"relationTo\":\"media\",\"value\":571},{\"relationTo\":\"media\",\"value\":570},{\"relationTo\":\"media\",\"value\":569},{\"relationTo\":\"media\",\"value\":309},{\"relationTo\":\"media\",\"value\":308}],\"hasNextPage\":true},\"folderType\":[\"media\"],\"updatedAt\":\"2026-01-15T10:17:58.577Z\",\"createdAt\":\"2026-01-15T10:17:58.577Z\"},\"updatedAt\":\"2026-04-08T08:24:13.752Z\",\"createdAt\":\"2026-04-08T08:24:13.629Z\",\"url\":\"/api/media/file/lancreakcio-web-cover.jpg\",\"thumbnailURL\":null,\"filename\":\"lancreakcio-web-cover.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":840594,\"width\":1770,\"height\":800,\"focalX\":50,\"focalY\":50},\"slug\":\"lancreakcio\",\"slugLock\":true,\"alwaysActive\":false,\"isArchived\":false,\"category\":{\"id\":11,\"name\":\"Teátrum\",\"displayName\":\"Teátrum\",\"showInListFilters\":true,\"showInCalendarFilters\":true,\"updatedAt\":\"2026-02-11T11:08:51.001Z\",\"createdAt\":\"2025-11-27T12:06:26.353Z\"},\"room\":\"$18:props:children:props:oncomingEvents:4:room\",\"lengthInfo\":null,\"content\":[{\"id\":\"69ce3b569140fd71d8ff80fa\",\"blockName\":null,\"blockType\":\"textContentBlock\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Láncreakció Vajda Katalin drámája, amely az atombomba feltalálásának körülményeit vizsgálja, és középpontjába Szilárd Leó, a zseniális magyar fizikus alakját állítja. A mű egy rendhagyó, erkölcsi értelemben vett „tárgyalás” formájában idézi meg a 20. század egyik legmeghatározóbb történelmi pillanatát, miközben színre lépnek azok a tudósok is – köztük Albert Einstein és Werner Heisenberg –, akik döntéseikkel és felismeréseikkel alapvetően formálták az emberiség sorsát. A darab feszült, intellektuálisan izgalmas és gondolatébresztő szöveg, amely történelmi események színre vitelével a jelen számára is érvényes kérdéseket vet fel.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Láncreakció a nagy drámai hagyományokhoz kapcsolódik: olyan művekhez, amelyek nem pusztán történetet mesélnek, hanem gondolatokat ütköztetnek és az emberi döntések mögött húzódó ellentmondásokat vizsgálják. A színpadon a szó, a vita és az érvek súlya válik meghatározóvá.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"„Ő tette a legtöbbet azért, hogy létrejöjjön a bomba – és ő harcolt a legtöbbet ellene.”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A Rátóti Zoltán rendezésében megvalósuló előadás központi dilemmája ma is érvényes: felelős-e a tudós azért, ahogyan felfedezéseit felhasználják, vagy a felelősség inkább a politikai és társadalmi döntésekben keresendő. A Láncreakció nem kínál egyszerű válaszokat. A végső ítélet a nézőre marad. A cél nem az állásfoglalás, hanem a gondolatébresztés: annak felismerése, hogy a tudomány, a hatalom és az emberi felelősség kérdései nem a múlt lezárt problémái, hanem jelenünk és jövőnk meghatározó dilemmái. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A téma komolysága ellenére a nézők egy könnyedebb hangvételű kifejezetten élvezetes, szórakoztató előadásra számíthatnak, olyan nagyszerű színészek tolmácsolásában, mint: Görög László, Szacsvay László, Horváth Lajos Ottó, Katona Kinga, Hirtling István, Schnell Ádám, Bertalan Ágnes, Zsurzs Kati, Pápai Erika, Kálid Artúr, Szatory Dávid\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Készült a Magyar Tudományos Akadémia alapításának 200. évfordulója alkalmából, a Magyar Tudományos Akadémia és a Magyar Művészeti Akadémia közös támogatásával, a Pesti Vigadó produkciójaként.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":2,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":2},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"SZEREPOSZTÁS:\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Szilárd Leó, fizikus: Görög László\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Bíró: Horváth Lajos Ottó\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Ügyvédnő: Katona Kinga\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Ügyész: Szatory Dávid\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Anya, Szilárd anyja: Zsurzs Kati\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Trude, Szilárd felesége: Pápai Erika\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Albert Einstein, fizikus: Schnell Ádám\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Werner Heisenberg, fizikus: Hirtling István\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Leslie R. Groves, tábornok: Kálid Artúr\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Kovács Emil, lelkipásztor: Szacsvay László\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"linebreak\",\"version\":1},{\"mode\":\"normal\",\"text\":\"Sylvia Elliot, újságíró: Bertalan Ág