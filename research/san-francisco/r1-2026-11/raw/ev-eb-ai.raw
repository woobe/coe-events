11","end_time":"10:00","tags":[],"eventbrite_event_id":"2004116690972","promoted_listing_metadata":{"ad_id":"515529","is_promoted_event":true,"placement_id":"6a0c00a6-ec53-49f0-93b0-47b84093dbd5","campaign_id":"515529","experiments":[],"index_in_results":0,"include_follow_cta":false,"goal_adj_bid":0.0105},"primary_venue":null,"primary_organizer":{"website":"https://productschool.com/","organization_id":"235040984945","_type":"organizer","user_id":"235040984945","description":{"text":"Product School is the leader in AI training for Product teams, trusted by Fortune 500 companies and a community of 2M+ professionals. Our expert-led, live, hands-on programs, run by AI-first product leaders, embed practical AI skills to help organizations innovate faster, experiment at scale, and achieve measurable business outcomes."},"followed_by_you":false,"url":"https://www.eventbrite.com/o/product-school-15742648512","twitter":"productschool","long_description":{"text":"Product School is the global leader in AI training for Product teams, empowering professionals and organizations to unlock AI-driven growth and innovation. Trusted by Fortune 500 companies and a global community of two million product professionals, we provide expert-led, live programs that combine practical learning with hands-on application. Our training is built by AI-first product leaders who know what it takes to apply AI at scale\u2014not just in theory, but in the day-to-day decisions that drive real business results. From accelerating experimentation to embedding AI across the product lifecycle, we equip teams with lasting, career-defining skills. The result: organizations innovate faster, adapt with confidence, and achieve measurable outcomes while professionals future-proof their careers in the age of AI."},"logo_id":"1135125093","num_followers":27756,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"15742648512","name":"Product School"},"ticket_availability":