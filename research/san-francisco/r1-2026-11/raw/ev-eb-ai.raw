":false,"summary":"10+ free hands-on workshops for AI Product leaders. 20 minutes each, live and online, Dec 7-11.","is_online_event":true,"eid":"2004116690972","id":"2004116690972","published":"2026-11-20T14:02:35Z","privacy_setting":"unlocked","primary_organizer_id":"15742648512","is_series":false,"timezone":"America/Los_Angeles","start_date":"2026-12-07","start_time":"08:00","end_date":"2026-12-11","end_time":"10:00","tags":[],"eventbrite_event_id":"2004116690972","promoted_listing_metadata":{"ad_id":"515529","is_promoted_event":true,"placement_id":"6a0c00a6-ec53-49f0-93b0-47b84093dbd5","campaign_id":"515529","experiments":[],"index_in_results":0,"include_follow_cta":false,"goal_adj_bid":0.0105},"primary_venue":null,"primary_organizer":{"website":"https://productschool.com/","organization_id":"235040984945","_type":"organizer","user_id":"235040984945","description":{"text":"Product School is the leader in AI training for Product teams, trusted by Fortune 500 companies and a community of 2M+ professionals. Our expert-led, live, hands-on programs, run by AI-first product leaders, embed practical AI skills to help organizations innovate faster, experiment at scale, and achieve measurable business outcomes."},"followed_by_you":false,"url":"https://www.eventbrite.com/o/product-school-15742648512","twitter":"productschool","long_description":{"text":"Product School is the global leader in AI training for Product teams, empowering professionals and organizations to unlock AI-driven growth and innovation. Trusted by Fortune 500 companies and a global community of two million product professionals, we provide expert-led, live programs that combine practical learning with hands-on application. Our training is built by AI-first product leaders who know what it takes to apply AI at scale\u2014not just in theory, but in the day-to-day decisions that drive real business results. From accelerating experimentation to embedding AI across the product lifecycle, we equip teams with lasting, career-defining skills. The result: organizations innovate faster, adapt with confidence, and achieve measurable outcomes while professionals future-proof their careers in the age of AI."},"logo_id":"1135125093","num_followers":27756,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"15742648512","name":"Product School"},"ticket_availability":{"start_sales_date":{"timezone":"America/Los_Angeles","local":"2022-02-27T04:50:00","utc":"2022-02-27T12:50:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"USD","display":"0 USD","value":0},"quantity_sold_paid":0,"remaining_capacity":499838,"end_sales_date":{"timezone":"America/Los_Angeles","local":"2026-12-09T23:30:00","utc":"2026-12-10T07:30:00Z"},"num_ticket_classes":1,"has_available_hidden_tickets":false,"maximum_ticket_price":{"currency":"USD","display":"0.00 USD","value":0},"minimum_ticket_price":{"currency":"USD","display":"0.00 USD","value":0},"is_free":true,"maximum_ticket_price_rounded":{"currency":"USD","display":"0 USD","value":0},"is_hold_unavailable":false,"waitlist_enabled":false,"has_bogo_tickets":false,"has_available_tickets":true,"common_sales_end_date":null,"is_sold_out":false,"waitlist_available":false,"quantity_sold_free":162,"quantity_sold":162,"open_discount":null,"available_minimum_ticket_price":{"currency":"USD","display":"0.00 USD","value":0},"available_maximum_ticket_price":{"currency":"USD","display":"0.00 USD","value":0}},"urgency_signals":{"messages":[],"categories":[]},"image_large":{"edge_color_set":true,"edge_color":"","url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1198389191%2F235040984945%2F1%2Foriginal.20261120-125226?crop=focalpoint\u0026fit=crop\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.5\u0026fp-y=0.5\u0026s=5144f27590b1c2c37885c6fdc243ed0c","original":{"url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1198389191%2F235040984945%2F1%2Foriginal.20261