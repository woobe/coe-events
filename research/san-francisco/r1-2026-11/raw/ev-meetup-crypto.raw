ngels](https://github.com/LFX-Talent-Angels)\n\nLearning Tokens Webpage: [https://hyperledger-labs.github.io/learning-tokens/](https://hyperledger-labs.github.io/learning-tokens/)\n\nLearning Tokens GitHub: [https://github.com/hyperledger-labs/learning-tokens](https://github.com/hyperledger-labs/learning-tokens)\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-sf/events/317065270/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536718897"},"displayPhoto":{"__ref":"PhotoInfo:536718897"},"feeSettings":null,"group":{"__ref":"Group:19721233"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":49,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326567645"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:289690467"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:254826018"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249168611"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249171149"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:252674817"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:247987830"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:470351652"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:199310458"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:267182431"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537004277":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/0/b/5/highres_537004277.jpeg","id":"537004277"},"PhotoInfo:312725040":{"__typename":"PhotoInfo","id":"312725040","highResUrl":"https://secure.meetupstatic.com/photos/member/1/3/b/0/highres_312725040.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:298403500":{"__typename":"PhotoInfo","id":"298403500","highResUrl":"https://secure.meetupstatic.com/photos/member/5/b/c/c/highres_298403500.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:336350766":{"__typename":"Member","id":"336350766","name":"Sidhant ","memberPhoto":null},"Member:324035277":{"__typename":"Member","id":"324035277","name":"Jeff Pribich","memberPhoto":{"__ref":"PhotoInfo:312725040"}},"Member:304980905":{"__typename":"Member","id":"304980905","name":"Suba Shalini","memberPhoto":{"__ref":"PhotoInfo:298403500"}},"Event:317315311":{"__typename":"Event","id":"317315311","title":"Hyperledger Fabric for Aerospace Part Traceability: A Doctoral Research Overview","dateTime":"2026-12-01T09:00:00-08:00","description":"Aircraft parts and components move across airlines, manufacturers, suppliers, and maintenance organizations throughout their service lives. Keeping their maintenance and ownership records accurate and\nconsistent across these organizations is a continuing challenge, especially when each organization uses different enterprise systems.\n\nIn this session, Abhinag Vangala, a doctoral candidate at the University of the Cumberlands, will share an overview of his qualitative research on the use of Hyperledger Fabric for part and component traceability in\nmulti-organizational environments. The session will cover:\n\n* The traceability challenge in aerospace maintenance, repair, and overhaul (MRO)\n* What prior research has found, and where gaps remain\n* Why Hyperledger Fabric was selected for this study\n* The study’s three focus areas: system performance, enterprise system integration, and operational suitability\n\nThis session may interest Fabric developers, architects, and practitioners who have worked on networks involving multiple organizations.\n\nAbhinag will also share how U.S. based professionals with experience in Hyperledger Fabric or enterprise permissioned blockchain systems can voluntarily take part in the study.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-sf/events/317315311/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537004277"},"displayPhoto":{"__ref":"PhotoInfo:537004277"},"feeSettings":null,"group":{"__ref":"Group:19721233"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":44,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:312725040"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:298403500"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:254826018"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249168611"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249171149"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:252674817"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:247987830"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":5,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:351849423"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:336350766"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:324035277"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:267182431"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:304980905"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:451867167":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/b/f/f/highres_451867167.jpeg","id":"451867167"},"Group:1592417":{"__typename":"Group","id":"1592417","name":"Silicon Valley Startup:   Idea to IPO","urlname":"silicon-valley-startup-idea-to-ipo","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:451867167"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.52,"totalRatings":3759}},"isNewGroup":false},"PhotoInfo:7306436":{"__typename":"PhotoInfo","id":"7306436","highResUrl":"https://secure.meetupstatic.com/photos/member/b/5/6/4/highres_7306436.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:9421491":{"__typename":"Member","id":"9421491","name":"Rob","memberPhoto":{"__ref":"PhotoInfo:7306436"}},"Member:482431114":{"__typename":"Member","id":"482431114","name":"qashu17","memberPhoto":null},"PhotoInfo:178098082":{"__typename":"PhotoInfo","id":"178098082","highResUrl":"https://secure.meetupstatic.com/photos/member/4/6/a/2/highres_178098082.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:133572662":{"__typename":"Member","id":"133572662","name":"narendra d","memberPhoto":{"__ref":"PhotoInfo:178098082"}},"PhotoInfo:321093257":{"__typename":"PhotoInfo","id":"321093257","highResUrl":"https://secure.meetupstatic.com/photos/member/8/1/e/9/highres_321093257.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:192043354":{"__typename":"Member","id":"192043354","name":"K","memberPhoto":{"__ref":"PhotoInfo:321093257"}},"PhotoInfo:279769355":{"__typename":"PhotoInfo","id":"279769355","highResUrl":"https://secure.meetupstatic.com/photos/member/c/0/c/b/highres_279769355.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:259044957":{"__typename":"Member","id":"259044957","name":"Takuya Nagai","memberPhoto":{"__ref":"PhotoInfo:279769355"}},"PhotoInfo:36385352":{"__typename":"PhotoInfo","id":"36385352","highResUrl":"https://secure.meetupstatic.com/photos/member/6/3/0/8/highres_36385352.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:7127477":{"__typename":"Member","id":"7127477","name":"Li Zhang","memberPhoto":{"__ref":"PhotoInfo:36385352"}},"PhotoInfo:308102789":{"__typename":"PhotoInfo","id":"308102789","highResUrl":"https://secure.meetupstatic.com/photos/member/a/e/5/highres_308102789.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:184547521":{"__typename":"Member","id":"184547521","name":"Vijay Koduri","memberPhoto":{"__ref":"PhotoInfo:308102789"}},"PhotoInfo:300521704":{"__typename":"PhotoInfo","id":"300521704","highResUrl":"https://secure.meetupstatic.com/photos/member/a/2/e/8/highres_300521704.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:272312947":{"__typename":"Member","id":"272312947","name":"Adebayo Oloko","memberPhoto":{"__ref":"PhotoInfo:300521704"}},"PhotoInfo:302584787":{"__typename":"PhotoInfo","id":"302584787","highResUrl":"https://secure.meetupstatic.com/photos/member/1/2/b/3/highres_302584787.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:311528871":{"__typename":"Member","id":"311528871","name":"Richard Bristol","memberPhoto":{"__ref":"PhotoInfo:302584787"}},"Event:317561761":{"__typename":"Event","id":"317561761","title":"NEX-T AI SUMMIT 2026 : Meet Global AI Leaders","dateTime":"2026-12-05T09:00:00-08:00","description":"This event is organized by Next Fin AI.\n\nOur meetup group is collaborating by promoting this event.\n\nIn order to attend, please register here:\n\n[NEX-T AI SUMMIT 2026 : Meet Global AI Leaders · Luma](https://luma.com/NEX-T2026)\n\nOur meetup members get a discount!\n\nUse promo code:\n\nIPODISCOUNT\n\nHurry!\n\nSlots are limited!\n\n​**NEX-T is a global technology and investment summit dedicated to exploring how breakthrough innovations reshape industries, transform economies, and create the next generation of investment opportunities.**\n\n​**NEX-T 2026 is an invitation-only summit taking place at Stanford University on December 5, 2026. The theme is *Al at a Crossroads:Technology, Power, Capital \u0026the Next Investment Cycle.***\n\n​**As AI reshapes industries, economies, and global capital markets, where will the next major technological breakthroughs and investment opportunities emerge?**\n\n​The summit will bring together pioneering scientists, prominent venture capitalists, global macro investors, AI entrepreneurs, technology executives, and policymakers for a day of candid conversations and meaningful connections.\n\n## ​From Google X to SpaceX: The Visionaries Behind Silicon Valley's Biggest Technology Revolutions\n\n​Among the summit's most anticipated speakers is **Sebastian Thrun**, founder of Google X, co-founder of Udacity, and one of the world's foremost pioneers in artificial intelligence, robotics, and autonomous driving.\n\n​A former director of Stanford's Artificial Intelligence Laboratory, Thrun led the Stanford team that won the landmark 2005 DARPA Grand Challenge, helping lay the groundwork for the modern autonomous vehicle industry. He later played a foundational role in Google's self-driving car initiative and established Google X, the company's ambitious research organization dedicated to breakthrough technologies.\n\n​Few individuals have been as directly involved in transforming frontier scientific research into technologies capable of reshaping entire industries.\n\n​As AI moves beyond large language models toward autonomous agents, robotics, and physical intelligence, Thrun's perspective on the next technological frontier will be particularly significant.\n\n​**Ruchir Sharma**, Chairman of Rockefeller International and Founder and Chief Investment Officer of Breakout Capital, will bring a global macroeconomic and investment perspective to the summit.\n​A renowned investor, author, and commentator on international economic trends, Sharma previously held senior investment leadership positions at Morgan Stanley Investment Management.\n\n​His influential books, including *Breakout Nations* and *The Rise and Fall of Nations*, have examined the forces driving economic growth, market cycles, and shifts in global economic power.\n\n​At a time when AI-related capital expenditures are reshaping corporate balance sheets, equity valuations, and global investment flows, Sharma's insights into the relationship between technological disruption and macroeconomic cycles will be especially timely.\n\n​Another headline speaker, **Steve Jurvetson**, is among Silicon Valley's most recognized venture capitalists and a longtime investor in some of Elon Musk's most ambitious ventures.\n\n​As co-founder of Future Ventures and Draper Fisher Jurvetson, Jurvetson has backed transformative companies including Tesla, SpaceX, and xAI, placing him at the intersection of artificial intelligence, commercial space exploration, electric vehicles, and other frontier technologies.\n​His investment career spans several of Silicon Valley's most consequential innovation cycles.\n\n​As investors search for the next generation of trillion-dollar companies, Jurvetson's experience identifying transformative technologies before they achieve mainstream recognition offers a compelling perspective on where long-term value may emerge.\n\n## ​Stanford's Leading Scientists Explore AI's Next Trillion-Dollar Opportunity: Medicine\n\n​Beyond software, infrastructure, and robotics, NEX-T 2026 will devote significant attention to the convergence of artificial intelligence and life sciences — a field with the potential to fundamentally transform healthcare and create entirely new industries.\n\n​**Professor Michael Snyder**, the Ascherman Professor of Genetics and Director of the Center for Genomics and Personalized Medicine at Stanford University School of Medicine, is one of the world's leading pioneers in genomics and precision medicine.\n\n​His groundbreaking research integrates multi-omics, wearable technologies, and continuous health monitoring to advance personalized medicine, early disease detection, and preventive healthcare.\n​As AI enables scientists to analyze biological data at unprecedented scale and speed, Snyder's work provides a window into the future of predictive, data-driven medicine.\n\n​Joining him is **Joseph C. Wu, MD, PhD**, Professor of Medicine and Radiology at Stanford University and Director of the Stanford Cardiovascular Institute.\n\n​An internationally recognized physician-scientist and co-founder of Greenstone Biosciences, Wu has pioneered the use of stem cell technologies and patient-specific biological models to investigate cardiovascular disease, improve drug discovery, and advance precision medicine.\n\n​Together, their research illustrates how AI, biotechnology, and computational science could accelerate medical breakthroughs and open substantial new opportunities for entrepreneurs and investors.\n\n## ​From Siri to AI Agents: Zoom's Alex Acero on the Future of Intelligent Computing\n\n​**Dr. Alex Acero**, Distinguished Scientist and Head of AI Incubation at Zoom, will bring decades of experience at the forefront of artificial intelligence and human-computer interaction.\n\n​A member of the U.S. National Academy of Engineering, Acero previously served as Chief Scientist of Siri at Apple and held senior research leadership positions at Microsoft.\n\n​His career has spanned the evolution of speech recognition, natural language processing, conversational AI, and intelligent digital assistants.\n​As AI agents increasingly transform enterprise software, workplace productivity, and digital collaboration, Acero's experience offers valuable insight into how the next generation of AI systems may move from assisting users to performing increasingly sophisticated tasks.\n\n# ​Our Community and More Distinguished Speakers\n\n​Our inaugural NEX-T Summit, held at Stanford University in September 2025, brought together an exceptional group of leaders, including **John Hennessy**, Chairman of Alphabet and former President of Stanford University; **Gary Gensler**, former Chairman of the U.S. Securities and Exchange Commission; **Tianqiao Chen**, Founder and Chairman of Shanda Group; renowned Stanford scientists **Michael Snyder** and **Zhenan Bao**; **Adi Ignatius**, Editor-in-Chief of Harvard Business Review…….\n\nand more!\n\nIf you would like to have a demo / marketing table, please send an email message to:\n\nsiliconvalleysponsor@gmail.com\n\nPut this in the subject header:\n\nSat. 12/5/26 - Tabler","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/silicon-valley-startup-idea-to-ipo/events/317561761/","isAttending":false,"isSaved":false,"maxTickets":80,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:451867167"},"feeSettings":null,"group":{"__ref":"Group:1592417"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":21,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:9421491"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:482431114"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:133572662"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192043354"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:259044957"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:7127477"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:184547521"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:272312947"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:311528871"}}}]},"series":null,"venue":{"__typename":"Venue","name":"The Stanford Faculty Club","address":"439 Lagunita Dr, Stanford, CA 94305, USA","city":"Stanford","state":"CA","country":"us"}}},"_sentryTraceData":"8929b93879d059e44daa117ae3fdb7af-4082f3d1625193a4-0","_sentryBaggage":"sentry-environment=production,sentry-release=ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb,sentry-public_key=5d12cd2317664353456ab4c40d079af2,sentry-trace_id=8929b93879d059e44daa117ae3fdb7af,sentry-org_id=6787,sentry-sampled=false,sentry-sample_rand=0.5614715972540942,sentry-sample_rate=0.01"},"__N_SSP":true},"page":"/find","query":{"keywords":"crypto","location":"us--ca--San Francisco","source":"EVENTS"},"buildId":"ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb","isFallback":false,"isExperimentalCompile":false,"gssp":true,"locale":"en-US","locales":["en-US","en-AU","de","de-DE","es","es-ES","fr","fr-FR","it","it-IT","ja","ja-JP","ko","ko-KR","nl","nl-NL","pl","pl-PL","pt","pt-BR","ru","ru-RU","tr","tr-TR","th-TH"],"defaultLocale":"en-US","scriptLoader":[]}</script></body></html>