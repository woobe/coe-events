tic.com/images/classic-member/"},"Member:323419719":{"__typename":"Member","id":"323419719","name":"Vikesh Patel","memberPhoto":{"__ref":"PhotoInfo:302868344"}},"PhotoInfo:300220275":{"__typename":"PhotoInfo","id":"300220275","highResUrl":"https://secure.meetupstatic.com/photos/member/9/d/5/3/highres_300220275.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:312721120":{"__typename":"Member","id":"312721120","name":"Satej Sahu","memberPhoto":{"__ref":"PhotoInfo:300220275"}},"PhotoInfo:310140491":{"__typename":"PhotoInfo","id":"310140491","highResUrl":"https://secure.meetupstatic.com/photos/member/1/e/b/highres_310140491.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:254465031":{"__typename":"Member","id":"254465031","name":"Tosh","memberPhoto":{"__ref":"PhotoInfo:310140491"}},"PhotoInfo:324390142":{"__typename":"PhotoInfo","id":"324390142","highResUrl":"https://secure.meetupstatic.com/photos/member/7/5/b/e/highres_324390142.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:398414319":{"__typename":"Member","id":"398414319","name":"Sudharsan Srinivasan","memberPhoto":{"__ref":"PhotoInfo:324390142"}},"Event:317272375":{"__typename":"Event","id":"317272375","title":"Introducing ThunderID: Open Source Identity for Humans, AI Agents, and Machines","dateTime":"2026-12-10T08:00:00-08:00","description":"ThunderID ([https://github.com/thunder-id](https://github.com/thunder-id)) is an open source identity and access management project, hosted by LF Decentralized Trust as an incubation project. It is built from scratch in Go and treats humans, AI agents, and machines as first-class identities.\n\nIn this meetup, we will introduce the motivation behind ThunderID, including why it was built from scratch rather than extending existing IAM stacks. We will look at the challenges IAM now has to solve and how much the operational and environmental complexity of identity has changed. The session will introduce ThunderID’s key features and its four foundational pillars:\n\n⚡ Native agent identity\n⚡ Post-quantum safe by design\n⚡ Integration with decentralized identity infrastructure\n⚡ A high-performance, lightweight runtime with GitOps support\n\nThe session closes with practical demos showing how ThunderID addresses these problems.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-sf/events/317272375/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536963111"},"displayPhoto":{"__ref":"PhotoInfo:536963111"},"feeSettings":null,"group":{"__ref":"Group:19721233"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":18,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:260644924"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:358125163"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:351849423"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:1806638"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:405699869"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485383580"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:403749593"}}},{"__typename":"RsvpEdge","node"