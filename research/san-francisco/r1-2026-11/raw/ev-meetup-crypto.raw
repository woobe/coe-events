price of Bitcoin (and the overall crypto market) has literally been on a rollercoaster since the beginning of the year and we still have a month to go. Will the price of Bitcoin start to recover now that Anthropic has IPO'd?\n\nAre you doing any tax loss harvesting before the end of the year? Are you buying the dip? Do you have a crypto strategy to put in place at the beginning of the year?\n\nJoin us and share your crypto plans for the new year.\n\nDon't forget to join our mailing list for updates:\n[https://lp.fresnobitcoin.com/mailinglist](https://lp.fresnobitcoin.com/mailinglist)\n\nand see links to everything else we're doing at:\n[https://linktr.ee/fresnobitcoin](https://linktr.ee/fresnobitcoin)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/fresno-bitcoin-cryptocurrencies/events/317509856/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537217014"},"displayPhoto":{"__ref":"PhotoInfo:537217014"},"feeSettings":null,"group":{"__ref":"Group:19589386"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:184401853"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:242962658"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:10367191"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537173532":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/1/1/c/highres_537173532.jpeg","id":"537173532"},"PhotoInfo:11377629":{"__typename":"PhotoInfo","id":"11377629","highResUrl":"https://secure.meetupstatic.com/photos/member/9/2/f/d/highres_11377629.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:309890997":{"__typename":"PhotoInfo","id":"309890997","highResUrl":"https://secure.meetupstatic.com/photos/member/c/7/3/5/highres_309890997.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:254826018":{"__typename":"PhotoInfo","id":"254826018","highResUrl":"https://secure.meetupstatic.com/photos/member/1/7/8/2/highres_254826018.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:249168611":{"__typename":"PhotoInfo","id":"249168611","highResUrl":"https://secure.meetupstatic.com/photos/member/b/d/e/3/highres_249168611.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:249171149":{"__typename":"PhotoInfo","id":"249171149","highResUrl":"https://secure.meetupstatic.com/photos/member/c/7/c/d/highres_249171149.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:252674817":{"__typename":"PhotoInfo","id":"252674817","highResUrl":"https://secure.meetupstatic.com/photos/member/3/9/e/1/highres_252674817.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:247987830":{"__typename":"PhotoInfo","id":"247987830","highResUrl":"https://secure.meetupstatic.com/photos/member/1/e/9/6/highres_247987830.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:13476241":{"__typename":"Member","id":"13476241","name":"Ashish ","memberPhoto":{"__ref":"PhotoInfo:11377629"}},"Member:358125163":{"__typename":"Member","id":"358125163","name":"Jose Justiniano","memberPhoto":{"__ref":"PhotoInfo:309890997"}},"Event:317457066":{"__typename":"Event","id":"317457066","title":"Tokenization was the Beginning. Agentic Capital Markets is the endgame","dateTime":"2026-12-02T07:00:00-08:00","description":"Join us for a webinar with Brickken, an LFDT general member, on building Agentic Capital Markets. Tokenization has made financial assets programmable. What comes next when AI agents can help discover opportunities and coordinate activity within defined mandates? Edwin Mata, Brickken's CEO \u0026 Co-Founder, will discuss the permissions, legal enforceability and operational controls needed to make Agentic Capital Markets work for institutions.\n\nThe webinar will take place on Wednesday, **December 2** at **7AM PST/10AM EST/16:00 CET/08:30 PM IST**\n\nPlease register here: https://zoom.us/webinar/register/8716754539090/WN_2WwuUCLLSZao28Vv-TiPnw\n\nWe hope to see you there!","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-sf/events/317457066/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537173532"},"displayPhoto":{"__ref":"PhotoInfo:537173532"},"feeSettings":null,"group":{"__ref":"Group:19721233"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":36,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:11377629"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:309890997"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:254826018"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249168611"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249171149"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:252674817"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:247987830"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:351849423"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:13476241"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:358125163"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:495873745":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/8/3/d/1/highres_495873745.jpeg","id":"495873745"},"PhotoInfo:533898593":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/8/a/1/highres_533898593.jpeg","id":"533898593"},"Group:35023486":{"__typename":"Group","id":"35023486","name":"Crystal Rose Divine Healing","urlname":"crystal-rose-divine-healing","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:533898593"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.85,"totalRatings":331}},"isNewGroup":false},"PhotoInfo:266601701":{"__typename":"PhotoInfo","id":"266601701","highResUrl":"https://secure.meetupstatic.com/photos/member/5/4/c/5/highres_266601701.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:226890803":{"__typename":"Member","id":"226890803","name":"Crystal Connor","memberPhoto":{"__ref":"PhotoInfo:266601701"}},"Event:317435898":{"__typename":"Event","id":"317435898","dateTime":"2026-12-04T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"crystal-rose-divine-healing","__ref":"Group:35023486"},"title":"Friday Night Psychic Development \u0026 Messages With Crystal ","description":"Are you interested in connecting with your loved ones on the other side or spirit guides in the light, and higher self (soul) to receive messages for yourself and others?\n\nFriday Night Psychic Development \u0026 Messages is a hands on practice virtual event on zoom where you can practice learning how to get messages for yourself and others. Messages for yourself happen during meditation. Once we have concluded the meditation one by one we all share our experience and work on trying to get messages for others as they share. Messages may come from loved ones who have crossed over, your spirit guides, or your higher self (soul), galactic guides etcetera for yourself and others.\n\nYou will experience a guided meditation followed by talking about your experience, then a message from the facilitator as well as any messages from any participants on the zoom call who would like to share anything they received for you in the way of messages, signs, symbols etcetera. This is a safe place to receive messages from Spirit and to develop your own intuition. All levels welcome.\n\nFYI this call does run over at times depending on how many participants we have as well as how long it takes for everyone to practice giving messages and I will do my best to get to everyone but sometimes it is late when we finally wrap up.\n\nBring your light and energy and come with us on this journey to learn, grow your intuition, and experience a joyful and fun community of like minded individuals! We look forward to seeing you!\n\nPlease make sure your zoom name matches your name on whichever form of payment you used so I know to admit you :) If your zoom name doesn’t match your name on the form of payment used, please send me a message with your zoom name and your name as it shows on your form of payment so I know who you are to admit you.\n\nCost is $15\nPayPal: https://www.paypal.com/paypalme/crystalrose4444\nVenmo: @crystalrose4444\n\nJoin Zoom Meeting\nhttps://us02web.zoom.us/j/87996498927\n\nMeeting ID: 879 9649 8927\n\nQuestions? Contact via email: CrystalRoseDivineHealing@gmail.com","eventType":"ONLINE","eventUrl":"https://www.meetup.com/crystal-rose-divine-healing/events/317435898/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:495873745"},"displayPhoto":{"__ref":"PhotoInfo:495873745"},"feeSettings":{"__typename":"EventFeeSettings","accepts":"CASH","currency":"USD","amount":15},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:226890803"}}}]},"series":{"__typename":"Series","description":"Every 1st Friday of the month","weeklyRecurrence":null,"monthlyRecurrence":{"__typename":"MonthlyRecurrenceInfo","monthlyDayOfWeek":"FRIDAY","monthlyWeekOfMonth":1},"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:317435898"}},{"__typename":"EventEdge","node":{"__ref":"Event:317576238"}},{"__typename":"EventEdge","node":{"__ref":"Event:317576260"}},{"__typename":"EventEdge","node":{"__ref":"Event:cmhfztykcfbhb"}},{"__typename":"EventEdge","node":{"__ref":"Event:cmhfztykcgbdb"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"Event:317576238":{"__typename":"Event","id":"317576238","dateTime":"2027-01-01T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"crystal-rose-divine-healing"}},"Event:317576260":{"__typename":"Event","id":"317576260","dateTime":"2027-02-05T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"crystal-rose-divine-healing"}},"Event:cmhfztykcfbhb":{"__typename":"Event","id":"cmhfztykcfbhb","dateTime":"2027-03-05T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"crystal-rose-divine-healing"}},"Event:cmhfztykcgbdb":{"__typename":"Event","id":"cmhfztykcgbdb","dateTime":"2027-04-02T19:00:00-07:00","isAttending":false,"group":{"__typename":"Group","urlname":"crystal-rose-divine-healing"}},"PhotoInfo:536963111":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/a/4/7/highres_536963111.jpeg","id":"536963111"},"PhotoInfo:280597721":{"__typename":"PhotoInfo","id":"280597721","highResUrl":"https://secure.meetupstatic.com/photos/membe