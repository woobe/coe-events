<!DOCTYPE html><html lang="en-US"><head><meta charSet="utf-8" data-next-head=""/><style data-fullcalendar="true" data-next-head=""></style><meta name="viewport" content="width=device-width, initial-scale=1" data-next-head=""/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" data-next-head=""/><meta name="service" content="web-next" data-next-head=""/><meta name="X-Location" content="east" data-next-head=""/><meta name="X-Build-Version" content="ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb" data-next-head=""/><link rel="icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" type="image/x-icon" sizes="any" data-next-head=""/><link rel="shortcut icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" data-next-head=""/><link rel="apple-touch-icon" sizes="120x120" href="https://secure.meetupstatic.com/next/images/general/m_redesign_120x120.png" data-next-head=""/><link rel="apple-touch-icon" sizes="152x152" href="https://secure.meetupstatic.com/next/images/general/m_redesign_152x152.png" data-next-head=""/><link rel="apple-touch-icon" sizes="167x167" href="https://secure.meetupstatic.com/next/images/general/m_redesign_167x167.png" data-next-head=""/><link rel="shortcut icon" sizes="128x128" href="https://secure.meetupstatic.com/next/images/general/m_redesign_128x128.png" data-next-head=""/><link rel="shortcut icon" sizes="196x196" href="https://secure.meetupstatic.com/next/images/general/m_redesign_196x196.png" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Regular.1ca3b39b.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Medium.7b11edcf.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Bold.5c45f750.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Book.27256a60.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/Boyrun-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="https://www.facebook.com/tr?id=792405807634160&amp;ev=PageView&amp;noscript=1" as="image" data-next-head=""/><script type="application/ld+json" data-next-head="">{"@type":"Organization","@context":"https://schema.org","url":"https://www.meetup.com/find/","name":"Meetup","logo":"https://secure.meetupstatic.com/next/images/general/m_redesign_630x630.png","sameAs":["https://www.facebook.com/meetup/","https://twitter.com/Meetup/","https://www.youtube.com/meetup","https://www.instagram.com/meetup/"]}</script><title data-next-head="">Find Events &amp; Groups | Meetup</title><meta name="description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="fb:app_id" content="2403839689" data-next-head=""/><meta property="og:site_name" content="Meetup" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:title" content="Find Events &amp; Groups | Meetup" data-next-head=""/><meta property="og:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="og:url" content="https://www.meetup.com/find/" data-next-head=""/><meta property="og:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="al:android:app_name" content="Meetup" data-next-head=""/><meta property="al:android:package" content="com.meetup" data-next-head=""/><meta property="al:ios:app_store_id" content="375990038" data-next-head=""/><meta property="al:ios:app_name" content="Meetup" data-next-head=""/><meta property="al:web:should_fallback" content="true" data-next-head=""/><meta property="al:android:url" content="meetup://" data-next-head=""/><meta property="al:ios:url" content="meetup://" data-next-head=""/><meta property="al:web:url" content="https://www.meetup.com/" data-next-head=""/><meta property="twitter:card" content="summary_large_image" data-next-head=""/><meta property="twitter:site" content="@meetup" data-next-head=""/><meta property="twitter:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="twitter:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="twitter:app:id:iphone" content="375990038" data-next-head=""/><meta property="twitter:app:name:iphone" content="Meetup" data-next-head=""/><meta property="twitter:app:id:ipad" content="375990038" data-next-head=""/><meta property="twitter:app:name:ipad" content="Meetup" data-next-head=""/><meta property="twitter:app:id:googleplay" content="com.meetup" data-next-head=""/><meta property="twitter:app:name:googleplay" content="Meetup" data-next-head=""/><meta name="robots" content="noindex, follow" data-next-head=""/><link rel="canonical" href="https://www.meetup.com/find/" data-next-head=""/><link rel="preconnect" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com" data-next-head=""/><link rel="dns-prefetch" href="https://www.googletagmanager.com" data-next-head=""/><script type="application/ld+json" data-next-head="">[{"@context":"https://schema.org","@type":"Event","name":"Holiday Party & Socratic Seminar","url":"https://www.meetup.com/bay-area-bitcoiners/events/317385759/","description":"It’s that time of year again! On **December 12**, join Bitcoiners from across the Bay Area at **Presidio Bitcoin** for an afternoon of big ideas, good company, and holiday merriment.\nWe’ll kick things off with a Socratic Seminar, then keep the conversations going over food, drinks, and festive cheer. **Come for the ideas, the party, or both.**\nSchedule:\n12:00PM - Mingling\n12:15PM - Seminar\n2:00- 5:00PM - Holiday Party!\n\\-\\-\\-\\-\\-\nThe reading list for the Socratic Seminar be posted here a couple days before the meetup.\nThe seminar is for those interested in learning more about and discussing Bitcoin and related protocols. The event is formatted to foster debate, information sharing, and lively discussion.\nDiscussion topics from a variety of sources are collated by meetup members in the weeks preceding the event. We'll discuss pull requests in the Bitcoin Core and other relevant repositories, network statistics, research papers, technical blog posts and other relevant content.","startDate":"2026-12-12T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","address":{"@type":"PostalAddress","addressLocality":"","addressRegion":"","addressCountry":""}},"organizer":{"@type":"Organization","name":"Bay Area Bitcoiners","url":"https://www.meetup.com/bay-area-bitcoiners/"},"performer":"Bay Area Bitcoiners"},{"@context":"https://schema.org","@type":"Event","name":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","url":"https://www.meetup.com/lfdt-sf/events/317415397/","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-08T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317415397/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"Holiday Party & Socratic Seminar ","url":"https://www.meetup.com/sf-bitcoin-devs/events/317385528/","description":"It’s that time of year again! On **December 12**, join Bitcoiners from across the Bay Area at **Presidio Bitcoin** for an afternoon of big ideas, good company, and holiday merriment.\n\nWe’ll kick things off with a Socratic Seminar, then keep the conversations going over food, drinks, and festive cheer. **Come for the ideas, the party, or both.**\n\nSchedule:\n12:00PM - Mingling\n12:15PM - Seminar\n2:00- 5:00PM - Holiday Party!\n\n\\-\\-\\-\\-\\-\n\nThe reading list for the Socratic Seminar be posted [here](https://sfbitcoindevs.org) a couple days before the meetup.\n\nThe seminar is for those interested in learning more about and discussing Bitcoin and related protocols. The event is formatted to foster debate, information sharing, and lively discussion.\n\nDiscussion topics from a variety of sources are collated by meetup members in the weeks preceding the event. We'll discuss pull requests in the Bitcoin Core and other relevant repositories, network statistics, research papers, technical blog posts and other relevant content.","startDate":"2026-12-12T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Presidio Bitcoin","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"38 Keyes Ave, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"SF Bitcoin Devs","url":"https://www.meetup.com/sf-bitcoin-devs/"},"performer":"SF Bitcoin Devs"},{"@context":"https://schema.org","@type":"Event","name":"New Year's Crypto Plans","url":"https://www.meetup.com/fresno-bitcoin-cryptocurrencies/events/317509856/","description":"The price of Bitcoin (and the overall crypto market) has literally been on a rollercoaster since the beginning of the year and we still have a month to go. Will the price of Bitcoin start to recover now that Anthropic has IPO'd?\n\nAre you doing any tax loss harvesting before the end of the year? Are you buying the dip? Do you have a crypto strategy to put in place at the beginning of the year?\n\nJoin us and share your crypto plans for the new year.\n\nDon't forget to join our mailing list for updates:\n[https://lp.fresnobitcoin.com/mailinglist](https://lp.fresnobitcoin.com/mailinglist)\n\nand see links to everything else we're doing at:\n[https://linktr.ee/fresnobitcoin](https://linktr.ee/fresnobitcoin)","startDate":"2026-12-05T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/fresno-bitcoin-cryptocurrencies/events/317509856/"},"organizer":{"@type":"Organization","name":"Fresno Bitcoin & Cryptocurrency Investors","url":"https://www.meetup.com/fresno-bitcoin-cryptocurrencies/"},"performer":"Fresno Bitcoin & Cryptocurrency Investors"},{"@context":"https://schema.org","@type":"Event","name":"Tokenization was the Beginning. Agentic Capital Markets is the endgame","url":"https://www.meetup.com/lfdt-sf/events/317457066/","description":"Join us for a webinar with Brickken, an LFDT general member, on building Agentic Capital Markets. Tokenization has made financial assets programmable. What comes next when AI agents can help discover opportunities and coordinate activity within defined mandates? Edwin Mata, Brickken's CEO & Co-Founder, will discuss the permissions, legal enforceability and operational controls needed to make Agentic Capital Markets work for institutions.\n\nThe webinar will take place on Wednesday, **December 2** at **7AM PST/10AM EST/16:00 CET/08:30 PM IST**\n\nPlease register here: https://zoom.us/webinar/register/8716754539090/WN_2WwuUCLLSZao28Vv-TiPnw\n\nWe hope to see you there!","startDate":"2026-12-02T15:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317457066/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"Friday Night Psychic Development & Messages With Crystal ","url":"https://www.meetup.com/crystal-rose-divine-healing/events/317435898/","description":"Are you interested in connecting with your loved ones on the other side or spirit guides in the light, and higher self (soul) to receive messages for yourself and others?\n\nFriday Night Psychic Development & Messages is a hands on practice virtual event on zoom where you can practice learning how to get messages for yourself and others. Messages for yourself happen during meditation. Once we have concluded the meditation one by one we all share our experience and work on trying to get messages for others as they share. Messages may come from loved ones who have crossed over, your spirit guides, or your higher self (soul), galactic guides etcetera for yourself and others.\n\nYou will experience a guided meditation followed by talking about your experience, then a message from the facilitator as well as any messages from any participants on the zoom call who would like to share anything they received for you in the way of messages, signs, symbols etcetera. This is a safe place to receive messages from Spirit and to develop your own intuition. All levels welcome.\n\nFYI this call does run over at times depending on how many participants we have as well as how long it takes for everyone to practice giving messages and I will do my best to get to everyone but sometimes it is late when we finally wrap up.\n\nBring your light and energy and come with us on this journey to learn, grow your intuition, and experience a joyful and fun community of like minded individuals! We look forward to seeing you!\n\nPlease make sure your zoom name matches your name on whichever form of payment you used so I know to admit you :) If your zoom name doesn’t match your name on the form of payment used, please send me a message with your zoom name and your name as it shows on your form of payment so I know who you are to admit you.\n\nCost is $15\nPayPal: https://www.paypal.com/paypalme/crystalrose4444\nVenmo: @crystalrose4444\n\nJoin Zoom Meeting\nhttps://us02web.zoom.us/j/87996498927\n\nMeeting ID: 879 9649 8927\n\nQuestions? Contact via email: CrystalRoseDivineHealing@gmail.com","startDate":"2026-12-05T03:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/crystal-rose-divine-healing/events/317435898/"},"organizer":{"@type":"Organization","name":"Crystal Rose Divine Healing","url":"https://www.meetup.com/crystal-rose-divine-healing/"},"performer":"Crystal Rose Divine Healing"},{"@context":"https://schema.org","@type":"Event","name":"Introducing ThunderID: Open Source Identity for Humans, AI Agents, and Machines","url":"https://www.meetup.com/lfdt-sf/events/317272375/","description":"ThunderID ([https://github.com/thunder-id](https://github.com/thunder-id)) is an open source identity and access management project, hosted by LF Decentralized Trust as an incubation project. It is built from scratch in Go and treats humans, AI agents, and machines as first-class identities.\n\nIn this meetup, we will introduce the motivation behind ThunderID, including why it was built from scratch rather than extending existing IAM stacks. We will look at the challenges IAM now has to solve and how much the operational and environmental complexity of identity has changed. The session will introduce ThunderID’s key features and its four foundational pillars:\n\n⚡ Native agent identity\n⚡ Post-quantum safe by design\n⚡ Integration with decentralized identity infrastructure\n⚡ A high-performance, lightweight runtime with GitOps support\n\nThe session closes with practical demos showing how ThunderID addresses these problems.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-10T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317272375/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"Free Hugs: Volunteer & Dating","url":"https://www.meetup.com/hug-cry/events/317521793/","description":"\\#\\#\\# Why Volunteer? \\(An Alternative to Dating Apps\\)\n**Relationship Readiness Through Compassionate Service**\nSkip superficial swiping and build authentic connections through shared purpose. Volunteering offers a way to meet singles while practicing compassion and emotional openness.\nAttachment theory suggests that fear of rejection can make dating stressful, while discomfort with intimacy can make closeness difficult. Hug & Cry lets volunteers practice self-compassion, voluntary emotional expression, nonjudgmental listening, and respect for boundaries. They may become more comfortable with vulnerability.\nBefore asking, **“Do I like you?”** perhaps we can first ask, **“Do I feel safe being myself around you?”** Practicing compassion together may help volunteers bring authenticity and responsiveness to dates. This is a promising possibility, not a proven guarantee of romantic success.\n\\#\\#\\# About the Event\nJoin us in SF Bay Area to encourage emotional expression and strengthen human connection. The Hug & Cry Initiative creates welcoming spaces for self-compassion, vulnerability, and connection.\nIn a screen-dominated world, reconnect together. We all experience love, loss, loneliness, and need kindness. Whether offering a consensual hug, trying a self-compassion exercise, listening without rushing to advise, or sharing a conversation, your presence helps build a kinder community.\n\\#\\#\\# Volunteer & Social Roles\n\n* **Huggers & Gentle Prompts:** Offer hugs only with consent and share prompts such as “Give Yourself a Hug” ,\"It's OK not to be Ok\" and “It’s OK to Cry.”\n* **Connection Leads:** Welcome attendees, coordinate the space, and invite friendly conversations.\n* **Singles & Volunteer Social Mixer:** Meet fellow volunteers before and after shifts, share experiences, and build friendships through action.\n\n\\#\\#\\# Who Should Join\nSingles, mental health advocates, and open-hearted people seeking friendship, community, and authentic ways to meet others. No therapy experience is needed—kindness, respect, and an open mind. [https://dickensfair.com/](https://dickensfair.com/) Great Dickens Christmas Fair ,An immersive Victorian London recreation spanning over four acres of exhibition halls with lamplit streets, theatres, pubs, dance halls, artisan shops, holiday food (such as meat pies, roast beef, and cider), and hundreds of characters including Scrooge, Father Christmas, Edgar Allan Poe, and Charles Dickens. Special experiences include Port & Chocolate Tastings, pub crawls, drawing classes, and readings\n\n### Text me [WhatsAPP link](https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl&p=i&mlu=4&ilr=4&iam=2 \"https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl&p=i&mlu=4&ilr=4&iam=2\") ([https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl&p=i&mlu=4&ilr=4&iam=2](https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl&p=i&mlu=4&ilr=4&iam=2 \"https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl&p=i&mlu=4&ilr=4&iam=2\") ) or find us in TikTok Live @Hug & Cry","startDate":"2026-11-28T19:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Cow Palace Arena & Event Center","address":{"@type":"PostalAddress","addressLocality":"Daly City","addressRegion":"CA","addressCountry":"us","streetAddress":"2600 Geneva Ave, Daly City, CA 94014, USA, Daly City, CA"}},"organizer":{"@type":"Organization","name":"Hug & Cry","url":"https://www.meetup.com/hug-cry/"},"performer":"Hug & Cry"},{"@context":"https://schema.org","@type":"Event","name":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","url":"https://www.meetup.com/lfdt-silicon-valley/events/317415400/","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-08T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-silicon-valley/events/317415400/"},"organizer":{"@type":"Organization","name":"LFDT Silicon Valley","url":"https://www.meetup.com/lfdt-silicon-valley/"},"performer":"LFDT Silicon Valley"},{"@context":"https://schema.org","@type":"Event","name":"ZK Learning Group: Wrap-up 2026, ZK order book matching","url":"https://www.meetup.com/lfdt-sf/events/317272171/","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\n\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\n\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: [https://discord.com/channels/905194001349627914/1329201532628898036](https://discord.com/channels/905194001349627914/1329201532628898036)\n\nGithub repo for the lab:\n[https://github.com/LF-Decentralized-Trust-labs/zk-learning-group](https://github.com/LF-Decentralized-Trust-labs/zk-learning-group)\n\n**In this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.**\n\n**Zoom Meeting link:** [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317272171/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"Hedge West SF December 2026 Meetup","url":"https://www.meetup.com/hedge-west-sf-quant-data-and-ai/events/316558391/","description":"**The next quarterly HedgeWestSF meetup in San Francisco is on December 8, 2026 from 6pm to 9pm. Join us at The House of AI at 40 Boardman Place in San Francisco's West SOMA Neighborhood** **near 7th and Bryant Streets. Parking available at 71 Boardman Place.**\n\nPresentations:\n\n**Vladimir Ofitserov** (REVO Capital - revocm.com) - *Scaling Quant Research with AI*\n\n**Vinesh Jha** (ExtractAlpha - ExtractAlpha.com) - *Advances in Alternate Data Alpha. New research, emerging signals, and what systematic investors should be watching next* (Rescheduled from the last meetup)\n\n**Greg Kapoustin** (validityBase - [vbase.com](https://vbase.com/?utm_source=luma)) - *Why Backtests Aren’t Trusted: Common Mistakes and Their Solutions*\n\nCALL FOR SPONSORS - Help keep HedgeWestSF going by becoming a sponsor - https://hedgewestsf.org/sponsorship\nCALL FOR PRESENTATIONS - Want to present at a future HedgeWestSF? Email hedgewestsf@novumcove.com\n\n**HedgeWestSF is sponsored by Novum Cove Capital Management and ExtractAlpha.**\n\nFood and refreshments will be served. As always, professionals, students, and anyone with an interest in trading, quant, data, and AI in finance are welcome! Looking forward to seeing you there!","startDate":"2026-12-09T02:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"House of AI","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"40 Boardman Pl, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Hedge West SF - Quant, Data, and AI","url":"https://www.meetup.com/hedge-west-sf-quant-data-and-ai/"},"performer":"Hedge West SF - Quant, Data, and AI"},{"@context":"https://schema.org","@type":"Event","name":"LFDT Mentorship: Talent Angels - Final Mentorship Presentation","url":"https://www.meetup.com/lfdt-sf/events/317065270/","description":"This is a third event in a series about the Talent Angels mentorship project.\n\n**Speakers:**\nAlejandro Kantún, Shubhang Sinha, Aman Kumar Sarraf, Vishwajit Sarak-Patil\n\n**Mentors of the LFDT Mentorship Program:**\nAlfonso Govela, Alberto Ceballos, José Enmanuel Amaya Araujo, Noemí Muñiz\n\n**Resources:**\n**Part of the LFX Mentorship, Talent Angels @ Learning Tokens: AI Graph Agents for Human Skills Empowerment:** [https://mentorship.lfx.linuxfoundation.org/project/106dc6c2-c09d-44c7-b997-5647059d4491](https://mentorship.lfx.linuxfoundation.org/project/106dc6c2-c09d-44c7-b997-5647059d4491)\n\nTalent Angels GitHub: [https://github.com/LFX-Talent-Angels](https://github.com/LFX-Talent-Angels)\n\nLearning Tokens Webpage: [https://hyperledger-labs.github.io/learning-tokens/](https://hyperledger-labs.github.io/learning-tokens/)\n\nLearning Tokens GitHub: [https://github.com/hyperledger-labs/learning-tokens](https://github.com/hyperledger-labs/learning-tokens)\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-09T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317065270/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"Hyperledger Fabric for Aerospace Part Traceability: A Doctoral Research Overview","url":"https://www.meetup.com/lfdt-sf/events/317315311/","description":"Aircraft parts and components move across airlines, manufacturers, suppliers, and maintenance organizations throughout their service lives. Keeping their maintenance and ownership records accurate and\nconsistent across these organizations is a continuing challenge, especially when each organization uses different enterprise systems.\n\nIn this session, Abhinag Vangala, a doctoral candidate at the University of the Cumberlands, will share an overview of his qualitative research on the use of Hyperledger Fabric for part and component traceability in\nmulti-organizational environments. The session will cover:\n\n* The traceability challenge in aerospace maintenance, repair, and overhaul (MRO)\n* What prior research has found, and where gaps remain\n* Why Hyperledger Fabric was selected for this study\n* The study’s three focus areas: system performance, enterprise system integration, and operational suitability\n\nThis session may interest Fabric developers, architects, and practitioners who have worked on networks involving multiple organizations.\n\nAbhinag will also share how U.S. based professionals with experience in Hyperledger Fabric or enterprise permissioned blockchain systems can voluntarily take part in the study.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-01T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317315311/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"NEX-T AI SUMMIT 2026 : Meet Global AI Leaders","url":"https://www.meetup.com/silicon-valley-startup-idea-to-ipo/events/317561761/","description":"This event is organized by Next Fin AI.\n\nOur meetup group is collaborating by promoting this event.\n\nIn order to attend, please register here:\n\n[NEX-T AI SUMMIT 2026 : Meet Global AI Leaders · Luma](https://luma.com/NEX-T2026)\n\nOur meetup members get a discount!\n\nUse promo code:\n\nIPODISCOUNT\n\nHurry!\n\nSlots are limited!\n\n​**NEX-T is a global technology and investment summit dedicated to exploring how breakthrough innovations reshape industries, transform economies, and create the next generation of investment opportunities.**\n\n​**NEX-T 2026 is an invitation-only summit taking place at Stanford University on December 5, 2026. The theme is *Al at a Crossroads:Technology, Power, Capital &the Next Investment Cycle.***\n\n​**As AI reshapes industries, economies, and global capital markets, where will the next major technological breakthroughs and investment opportunities emerge?**\n\n​The summit will bring together pioneering scientists, prominent venture capitalists, global macro investors, AI entrepreneurs, technology executives, and policymakers for a day of candid conversations and meaningful connections.\n\n## ​From Google X to SpaceX: The Visionaries Behind Silicon Valley's Biggest Technology Revolutions\n\n​Among the summit's most anticipated speakers is **Sebastian Thrun**, founder of Google X, co-founder of Udacity, and one of the world's foremost pioneers in artificial intelligence, robotics, and autonomous driving.\n\n​A former director of Stanford's Artificial Intelligence Laboratory, Thrun led the Stanford team that won the landmark 2005 DARPA Grand Challenge, helping lay the groundwork for the modern autonomous vehicle industry. He later played a foundational role in Google's self-driving car initiative and established Google X, the company's ambitious research organization dedicated to breakthrough technologies.\n\n​Few individuals have been as directly involved in transforming frontier scientific research into technologies capable of reshaping entire industries.\n\n​As AI moves beyond large language models toward autonomous agents, robotics, and physical intelligence, Thrun's perspective on the next technological frontier will be particularly significant.\n\n​**Ruchir Sharma**, Chairman of Rockefeller International and Founder and Chief Investment Officer of Breakout Capital, will bring a global macroeconomic and investment perspective to the summit.\n​A renowned investor, author, and commentator on international economic trends, Sharma previously held senior investment leadership positions at Morgan Stanley Investment Management.\n\n​His influential books, including *Breakout Nations* and *The Rise and Fall of Nations*, have examined the forces driving economic growth, market cycles, and shifts in global economic power.\n\n​At a time when AI-related capital expenditures are reshaping corporate balance sheets, equity valuations, and global investment flows, Sharma's insights into the relationship between technological disruption and macroeconomic cycles will be especially timely.\n\n​Another headline speaker, **Steve Jurvetson**, is among Silicon Valley's most recognized venture capitalists and a longtime investor in some of Elon Musk's most ambitious ventures.\n\n​As co-founder of Future Ventures and Draper Fisher Jurvetson, Jurvetson has backed transformative companies including Tesla, SpaceX, and xAI, placing him at the intersection of artificial intelligence, commercial space exploration, electric vehicles, and other frontier technologies.\n​His investment career spans several of Silicon Valley's most consequential innovation cycles.\n\n​As investors search for the next generation of trillion-dollar companies, Jurvetson's experience identifying transformative technologies before they achieve mainstream recognition offers a compelling perspective on where long-term value may emerge.\n\n## ​Stanford's Leading Scientists Explore AI's Next Trillion-Dollar Opportunity: Medicine\n\n​Beyond software, infrastructure, and robotics, NEX-T 2026 will devote significant attention to the convergence of artificial intelligence and life sciences — a field with the potential to fundamentally transform healthcare and create entirely new industries.\n\n​**Professor Michael Snyder**, the Ascherman Professor of Genetics and Director of the Center for Genomics and Personalized Medicine at Stanford University School of Medicine, is one of the world's leading pioneers in genomics and precision medicine.\n\n​His groundbreaking research integrates multi-omics, wearable technologies, and continuous health monitoring to advance personalized medicine, early disease detection, and preventive healthcare.\n​As AI enables scientists to analyze biological data at unprecedented scale and speed, Snyder's work provides a window into the future of predictive, data-driven medicine.\n\n​Joining him is **Joseph C. Wu, MD, PhD**, Professor of Medicine and Radiology at Stanford University and Director of the Stanford Cardiovascular Institute.\n\n​An internationally recognized physician-scientist and co-founder of Greenstone Biosciences, Wu has pioneered the use of stem cell technologies and patient-specific biological models to investigate cardiovascular disease, improve drug discovery, and advance precision medicine.\n\n​Together, their research illustrates how AI, biotechnology, and computational science could accelerate medical breakthroughs and open substantial new opportunities for entrepreneurs and investors.\n\n## ​From Siri to AI Agents: Zoom's Alex Acero on the Future of Intelligent Computing\n\n​**Dr. Alex Acero**, Distinguished Scientist and Head of AI Incubation at Zoom, will bring decades of experience at the forefront of artificial intelligence and human-computer interaction.\n\n​A member of the U.S. National Academy of Engineering, Acero previously served as Chief Scientist of Siri at Apple and held senior research leadership positions at Microsoft.\n\n​His career has spanned the evolution of speech recognition, natural language processing, conversational AI, and intelligent digital assistants.\n​As AI agents increasingly transform enterprise software, workplace productivity, and digital collaboration, Acero's experience offers valuable insight into how the next generation of AI systems may move from assisting users to performing increasingly sophisticated tasks.\n\n# ​Our Community and More Distinguished Speakers\n\n​Our inaugural NEX-T Summit, held at Stanford University in September 2025, brought together an exceptional group of leaders, including **John Hennessy**, Chairman of Alphabet and former President of Stanford University; **Gary Gensler**, former Chairman of the U.S. Securities and Exchange Commission; **Tianqiao Chen**, Founder and Chairman of Shanda Group; renowned Stanford scientists **Michael Snyder** and **Zhenan Bao**; **Adi Ignatius**, Editor-in-Chief of Harvard Business Review…….\n\nand more!\n\nIf you would like to have a demo / marketing table, please send an email message to:\n\nsiliconvalleysponsor@gmail.com\n\nPut this in the subject header:\n\nSat. 12/5/26 - Tabler","startDate":"2026-12-05T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"The Stanford Faculty Club","address":{"@type":"PostalAddress","addressLocality":"Stanford","addressRegion":"CA","addressCountry":"us","streetAddress":"439 Lagunita Dr, Stanford, CA 94305, USA, Stanford, CA"}},"organizer":{"@type":"Organization","name":"Silicon Valley Startup:   Idea to IPO","url":"https://www.meetup.com/silicon-valley-startup-idea-to-ipo/"},"performer":"Silicon Valley Startup:   Idea to IPO"}]</script><link rel="preload" href="https://secure.meetupstatic.com/photos/event/7/f/f/e/highres_537092766.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/b/0/2/8/highres_537225096.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/7/f/3/b/highres_537092571.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/9/0/9/6/highres_537217014.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/1/1/c/highres_537173532.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/8/3/d/1/highres_495873745.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/5/a/4/7/highres_536963111.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/b/5/f/9/highres_537226585.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/b/0/7/8/highres_537225176.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/5/9/1/8/highres_536962808.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/2/d/e/highres_533993982.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/4/9/d/1/highres_536718897.jpeg" as="image" data-next-head=""/><meta name="next_csrf" content="99c2846d-ced8-451d-b3fb-caf4ee4b42e9"/><script>(function(){try{if(typeof performance==="undefined"||!performance.getEntriesByType)return;var n=performance.getEntriesByType("navigation");if(!n||!n[0]||!n[0].name)return;var u=new URL(n[0].name);var h=u.hash||"";var m=h.match(/:~:text=([^&]+)/);if(m){window.__meetup_text_fragment__={hasTextFragment:true,textFragment:decodeURIComponent(m[1]).trim().slice(0,100),capturedAt:Date.now()}}else{window.__meetup_text_fragment__={hasTextFragment:false,capturedAt:Date.now()}}}catch(e){}})()</script><script>(function(){try{var hasCookie=document.cookie.split(';').some(function(c){return c.trim()==='isNativeApp=true'});var hasParam=window.location.search.indexOf('isNativeApp=true')!==-1;if(!hasCookie&&!hasParam)return;var s=document.createElement('style');s.textContent='#onetrust-consent-sdk{display:none!important}';document.head.appendChild(s);win