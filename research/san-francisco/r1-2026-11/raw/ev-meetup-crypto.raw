3030567","name":"adnan","memberPhoto":{"__ref":"PhotoInfo:300652281"}},"PhotoInfo:309965296":{"__typename":"PhotoInfo","id":"309965296","highResUrl":"https://secure.meetupstatic.com/photos/member/1/4/b/0/highres_309965296.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:358507408":{"__typename":"Member","id":"358507408","name":"Santosh Tatke","memberPhoto":{"__ref":"PhotoInfo:309965296"}},"Member:475453887":{"__typename":"Member","id":"475453887","name":"Shaila","memberPhoto":null},"PhotoInfo:326558120":{"__typename":"PhotoInfo","id":"326558120","highResUrl":"https://secure.meetupstatic.com/photos/member/9/4/e/8/highres_326558120.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:425974450":{"__typename":"Member","id":"425974450","name":"Kaushik Datta Roy","memberPhoto":{"__ref":"PhotoInfo:326558120"}},"Member:485221504":{"__typename":"Member","id":"485221504","name":"Mike Orabueze","memberPhoto":null},"Member:382088913":{"__typename":"Member","id":"382088913","name":"AG","memberPhoto":null},"PhotoInfo:261301266":{"__typename":"PhotoInfo","id":"261301266","highResUrl":"https://secure.meetupstatic.com/photos/member/4/f/2/highres_261301266.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:215528073":{"__typename":"Member","id":"215528073","name":"Wes Helwig","memberPhoto":{"__ref":"PhotoInfo:261301266"}},"PhotoInfo:307827703":{"__typename":"PhotoInfo","id":"307827703","highResUrl":"https://secure.meetupstatic.com/photos/member/6/c/3/7/highres_307827703.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:12536563":{"__typename":"Member","id":"12536563","name":"Parth Patel","memberPhoto":{"__ref":"PhotoInfo:307827703"}},"PhotoInfo:261953532":{"__typename":"PhotoInfo","id":"261953532","highResUrl":"https://secure.meetupstatic.com/photos/member/d/1/1/c/highres_261953532.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:215045517":{"__typename":"Member","id":"215045517","name":"A. N.","memberPhoto":{"__ref":"PhotoInfo:261953532"}},"Member:485445473":{"__typename":"Member","id":"485445473","name":"Daniel","memberPhoto":null},"Member:485454248":{"__typename":"Member","id":"485454248","name":"Jishant Chandel","memberPhoto":null},"Member:50039782":{"__typename":"Member","id":"50039782","name":"rajesh","memberPhoto":null},"Event:316558391":{"__typename":"Event","id":"316558391","title":"Hedge West SF December 2026 Meetup","dateTime":"2026-12-08T18:00:00-08:00","description":"**The next quarterly HedgeWestSF meetup in San Francisco is on December 8, 2026 from 6pm to 9pm. Join us at The House of AI at 40 Boardman Place in San Francisco's West SOMA Neighborhood** **near 7th and Bryant Streets. Parking available at 71 Boardman Place.**\n\nPresentations:\n\n**Vladimir Ofitserov** (REVO Capital - revocm.com) - *Scaling Quant Research with AI*\n\n**Vinesh Jha** (ExtractAlpha - ExtractAlpha.com) - *Advances in Alternate Data Alpha. New research, emerging signals, and what systematic investors should be watching next* (Rescheduled from the last meetup)\n\n**Greg Kapoustin** (validityBase - [vbase.com](https://vbase.com/?utm_source=luma)) - *Why Backtests Aren’t Trusted: Common Mistakes and Their Solutions*\n\nCALL FOR SPONSORS - Help keep HedgeWestSF going by becoming a sponsor - https://hedgewestsf.org/sponsorship\nCALL FOR PRESENTATIONS - Want to present at a future HedgeWestSF? Email hedgewestsf@novumcove.com\n\n**HedgeWestSF is sponsored by Novum Cove Capital Management and ExtractAlpha.**\n\nFood and refreshments will be served. As always, professionals, students, and anyone with an interest in trading, quant, data, and AI in finance are welcome! Looking forward to seeing you there!","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/hedge-west-sf-quant-data-and-ai/events/316558391/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpSt