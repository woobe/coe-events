tings","average":4.56,"totalRatings":9}},"isNewGroup":false},"PhotoInfo:312440593":{"__typename":"PhotoInfo","id":"312440593","highResUrl":"https://secure.meetupstatic.com/photos/member/5/0/7/1/highres_312440593.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:309071746":{"__typename":"PhotoInfo","id":"309071746","highResUrl":"https://secure.meetupstatic.com/photos/member/2/d/e/2/highres_309071746.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:314493397":{"__typename":"PhotoInfo","id":"314493397","highResUrl":"https://secure.meetupstatic.com/photos/member/8/2/7/5/highres_314493397.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:323815311":{"__typename":"PhotoInfo","id":"323815311","highResUrl":"https://secure.meetupstatic.com/photos/member/d/8/0/f/highres_323815311.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:319594806":{"__typename":"PhotoInfo","id":"319594806","highResUrl":"https://secure.meetupstatic.com/photos/member/8/7/f/6/highres_319594806.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:301326167":{"__typename":"PhotoInfo","id":"301326167","highResUrl":"https://secure.meetupstatic.com/photos/member/1/8/1/7/highres_301326167.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:291269621":{"__typename":"PhotoInfo","id":"291269621","highResUrl":"https://secure.meetupstatic.com/photos/member/7/3/b/5/highres_291269621.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:313096152":{"__typename":"PhotoInfo","id":"313096152","highResUrl":"https://secure.meetupstatic.com/photos/member/3/f/1/8/highres_313096152.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:301034808":{"__typename":"Member","id":"301034808","name":"Mike Zhun Guo","memberPhoto":{"__ref":"PhotoInfo:313096152"}},"Event:317521793":{"__typename":"Event","id":"317521793","title":"Free Hugs: Volunteer \u0026 Dating","dateTime":"2026-11-28T11:00:00-08:00","description":"\\#\\#\\# Why Volunteer? \\(An Alternative to Dating Apps\\)\n**Relationship Readiness Through Compassionate Service**\nSkip superficial swiping and build authentic connections through shared purpose. Volunteering offers a way to meet singles while practicing compassion and emotional openness.\nAttachment theory suggests that fear of rejection can make dating stressful, while discomfort with intimacy can make closeness difficult. Hug \u0026 Cry lets volunteers practice self-compassion, voluntary emotional expression, nonjudgmental listening, and respect for boundaries. They may become more comfortable with vulnerability.\nBefore asking, **“Do I like you?”** perhaps we can first ask, **“Do I feel safe being myself around you?”** Practicing compassion together may help volunteers bring authenticity and responsiveness to dates. This is a promising possibility, not a proven guarantee of romantic success.\n\\#\\#\\# About the Event\nJoin us in SF Bay Area to encourage emotional expression and strengthen human connection. The Hug \u0026 Cry Initiative creates welcoming spaces for self-compassion, vulnerability, and connection.\nIn a screen-dominated world, reconnect together. We all experience love, loss, loneliness, and need kindness. Whether offering a consensual hug, trying a self-compassion exercise, listening without rushing to advise, or sharing a conversation, your presence helps build a kinder community.\n\\#\\#\\# Volunteer \u0026 Social Roles\n\n* **Huggers \u0026 Gentle Prompts:** Offer hugs only with consent and share prompts such as “Give Yourself a Hug” ,\"It's OK not to be Ok\" and “It’s OK to Cry.”\n* **Connection Leads:** Welcome attendees, coordinate the space, and invite friendly conversations.\n* **Singles \u0026 Volunteer Social Mixer:** Meet fellow volunteers before and after shifts, share experiences, and build friendships through action.\n\n\\#\\#\\# Who Should Join\nSingles, mental health advocates, and open-hearted people seeking friendship, community, and authentic ways to meet others. No therapy experience is needed—kindness, respect, and an open mind. [https://dickensfair.com/](https://dickensfair.com/) Great Dickens Christmas Fair ,An immersive Victorian London recreation spanning over four acres of exhibition halls with lamplit streets, theatres, pubs, dance halls, artisan shops, holiday food (such as meat pies, roast beef, and cider), and hundreds of characters including Scrooge, Father Christmas, Edgar Allan Poe, and Charles Dickens. Special experiences include Port \u0026 Chocolate Tastings, pub crawls, drawing classes, and readings\n\n### Text me [WhatsAPP link](https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl\u0026p=i\u0026mlu=4\u0026ilr=4\u0026iam=2 \"https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl\u0026p=i\u0026mlu=4\u0026ilr=4\u0026iam=2\") ([https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl\u0026p=i\u0026mlu=4\u0026ilr=4\u0026iam=2](https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl\u0026p=i\u0026mlu=4\u0026ilr=4\u0026iam=2 \"https://chat.whatsapp.com/BR6gfkLI34SJ41Lizhc1ls?s=cl\u0026p=i\u0026mlu=4\u0026ilr=4\u0026iam=2\") ) or find us in TikTok Live @Hug \u0026 Cry","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/hug-cry/events/317521793/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537226585"},"displayPhoto":{"__ref":"PhotoInfo:537226585"},"feeSettings":null,"group":{"__ref":"Group:36864321"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":35,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:312440593"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:309071746"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:314493397"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:323815311"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:319594806"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:301326167"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:291269621"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:301034808"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Cow Palace Arena \u0026 Event Center","address":"2600 Geneva Ave, Daly City, CA 94014, USA","city":"Daly City","state":"CA","country":"us"}},"PhotoInfo:537225176":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/0/7/8/highres_537225176.jpeg","id":"537225176"},"PhotoInfo:523675765":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/9/d/5/highres_523675765.jpeg","id":"523675765"},"Group:19659441":{"__typename":"Group","id":"19659441","name":"LFDT Silicon Valley","urlname":"lfdt-silicon-valley","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:523675765"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.52,"totalRatings":60}},"isNewGroup":false},"PhotoInfo:96234982":{"__typename":"PhotoInfo","id":"96234982","highResUrl":"https://secure.meetupstatic.com/photos/member/d/6/c/6/highres_96234982.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:258311560":{"__typename":"PhotoInfo","id":"258311560","highResUrl":"https://secure.meetupstatic.com/photos/member/2/d/2/8/highres_258311560.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:98877632":{"__typename":"PhotoInfo","id":"98877632","highResUrl":"https://secure.meetupstatic.com/photos/member/e/1/2/0/highres_98877632.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:147135242":{"__typename":"PhotoInfo","id":"147135242","highResUrl":"https://secure.meetupstatic.com/photos/member/3/b/8/a/highres_147135242.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:55469762":{"__typename":"PhotoInfo","id":"55469762","highResUrl":"https://secure.meetupstatic.com/photos/member/7/4/4/2/highres_55469762.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:9694915":{"__typename":"PhotoInfo","id":"9694915","highResUrl":"https://secure.meetupstatic.com/photos/member/8/8/6/3/highres_9694915.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:204563972":{"__typename":"PhotoInfo","id":"204563972","highResUrl":"https://secure.meetupstatic.com/photos/member/5/d/a/4/highres_204563972.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:485313953":{"__typename":"Member","id":"485313953","name":"charalampos","memberPhoto":null},"Event:317415400":{"__typename":"Event","id":"317415400","title":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","dateTime":"2026-12-08T09:00:00-08:00","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-silicon-valley/events/317415400/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537225176"},"displayPhoto":{"__ref":"PhotoInfo:537225176"},"feeSettings":null,"group":{"__ref":"Group:19659441"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":34,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:96234982"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:258311560"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:98877632"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:147135242"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:55469762"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:9694915"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:204563972"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485313953"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:208556900"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:536962808":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/9/1/8/highres_536962808.jpeg","id":"536962808"},"PhotoInfo:318450031":{"__typename":"PhotoInfo","id":"318450031","highResUrl":"https://secure.meetupstatic.com/photos/member/7/5/4/f/highres_318450031.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:389749595":{"__typename":"Member","id":"389749595","name":"Kevin Bravo","memberPhoto":{"__ref":"PhotoInfo:318450031"}},"Event:317272171":{"__typename":"Event","id":"317272171","title":"ZK Learning Group: Wrap-up 2026, ZK order book matching","dateTime":"2026-12-10T09:00:00-08:00","description":"ZK Learning Group: Wrap-up 2026, ZK order book matching\n\nA learning group for zero knowledge and SNARK application development.\nDuring the year we will systematically explore different aspects of zero knowledge and SNARK programming in application development.\n\nCoordination of the learning group is in the discord channel of Linux Foundation Decentralized Trust: [https://discord.com/channels/905194001349627914/1329201532628898036](https://discord.com/channels/905194001349627914/1329201532628898036)\n\nGithub repo for the lab:\n[https://github.com/LF-Decentralized-Trust-labs/zk-learning-group](https://github.com/LF-Decentralized-Trust-labs/zk-learning-group)\n\n**In this session, we will wrap up 2026 and investigate zero knowledge order book matching algorithms.**\n\n**Zoom Meeting link:** [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-sf/events/317272171/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536962808"},"displayPhoto":{"__ref":"PhotoInfo:536962808"},"feeSettings":null,"group":{"__ref":"Group:19721233"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":25,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:309890997"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:318450031"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:254826018"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249168611"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:249171149"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:252674817"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:247987830"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:351849423"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:358125163"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:389749595"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:533993982":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/2/d/e/highres_533993982.jpeg","id":"533993982"},"PhotoInfo:531091585":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/7/b/6/1/high