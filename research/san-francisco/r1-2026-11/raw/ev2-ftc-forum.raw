<script>
/* Preview, 29 Oct: the chooser lifts the card it points at. */
(function () {
  var pills = document.querySelectorAll("[data-choose]");
  pills.forEach(function (p) {
    p.addEventListener("click", function () {
      var id = p.getAttribute("data-choose");
      pills.forEach(function (o) { o.setAttribute("aria-current", o === p ? "true" : "false"); });
      document.querySelectorAll(".feature").forEach(function (c) { c.classList.toggle("is-chosen", c.id === id); });
    });
  });
})();
</script>
<script defer src="/_vercel/insights/script.js"></script>
