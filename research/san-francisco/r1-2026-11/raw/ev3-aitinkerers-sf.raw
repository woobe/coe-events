<script type="e8539e3ded626e527dabcfd3-text/javascript">
  (function() {
    function wireColorSchemeSwitchers() {
      document.querySelectorAll("[data-color-scheme-switcher]").forEach(function(switcher) {
        if (switcher.dataset.wired === "true") return;
        switcher.dataset.wired = "true";
  
        function update() {
          if (!window.mcTheme) return;
          var pref = window.mcTheme.getPref();
          var resolved = document.documentElement.dataset.theme || window.mcTheme.apply();
          var fixedScheme = window.mcTheme.getFixedScheme ? window.mcTheme.getFixedScheme() : null;
          switcher.querySelectorAll("[data-color-scheme-icon]").forEach(function(icon) {
            icon.hidden = icon.dataset.colorSchemeIcon !== pref;
          });
          var button = switcher.querySelector("[data-color-scheme-toggle]");
          var currentLabel = pref === "auto" ? "Auto theme (currently " + resolved + ")" : pref.charAt(0).toUpperCase() + pref.slice(1) + " theme";
          if (fixedScheme) currentLabel += "; this page stays " + fixedScheme;
          var order = ["auto", "light", "dark"];
          var next = order[(order.indexOf(pref) + 1) % order.length];
          var nextLabel = next.charAt(0).toUpperCase() + next.slice(1);
          if (button) {
            button.title = currentLabel + "; switch to " + nextLabel.toLowerCase();
            button.setAttribute("aria-label", currentLabel + ". Switch to " + nextLabel + " theme");
          }
        }
  
        var button = switcher.querySelector("[data-color-scheme-toggle]");
        if (button) button.addEventListener("click", function() {
          if (!window.mcTheme) return;
          var order = ["auto", "light", "dark"];
          var current = window.mcTheme.getPref();
          window.mcTheme.setPref(order[(order.indexOf(current) + 1) % order.length]);
          update();
        });
        window.addEventListener("ait:color-scheme-change", update);
        update();
      });
    }
  
    document.addEventListener("DOMContentLoaded", wireColorSchemeSwitchers);
    document.addEventListener("turbo:load", wireColorSchemeSwitchers);
    wireColorSchemeSwitchers();
  })();
</script>

