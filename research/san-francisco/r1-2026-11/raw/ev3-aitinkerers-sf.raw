<script src="/assets/inline_auth-f9e09043c7cc9b6934bf0bd459db336b4bf7103c25802421e151b3cdd508e91e.js" type="e8539e3ded626e527dabcfd3-text/javascript"></script>
<script type="e8539e3ded626e527dabcfd3-text/javascript">
  (function() {
    function initializeInlineAuth() {
      window.InlineAuth.initialize({"actionName":"","actionToken":"","signedInMessage":"You are signed in.","signedInFollowup":""});
    }
    if (window.InlineAuth && typeof window.InlineAuth.initialize === 'function') {
      initializeInlineAuth();
    } else {
      window.addEventListener('ait:inline-auth-ready', initializeInlineAuth, { once: true });
    }
  })();
</script>

<script type="e8539e3ded626e527dabcfd3-text/javascript">
  function disableInlineAuthForm() { /* noop */ }
  function enableInlineAuthForm() {
    $("#inline-auth-email-verification").hide();
    $(".auth-processing-spinner").removeClass("hidden");
    window.location.reload();
  }
</script>
<script type="e8539e3ded626e527dabcfd3-text/javascript">
  $(document).ready(function() {
    $('[data-contact-form-toggle][aria-controls="contact-us-form-20d1f4083304"]').on('click', function() {
      var $form = $(document.getElementById(this.getAttribute('aria-controls')));
      var expanded = this.getAttribute('aria-expanded') !== 'true';
      this.setAttribute('aria-expanded', String(expanded));
      $(this).find('.ait-contact-card-chevron').toggleClass('rotate-90', expanded);
      $form.stop(true, true);
  
      if (expanded) {
        $form.removeClass('hidden').hide().slideDown(200);
        var $email = $form.find('#inline-auth-email-input');
        if ($email.is(':visible')) {
          $email.focus();
        } else {
          $form.find('#contact_us_subject').focus();
        }
      } else {
        $form.slideUp(200, function() {
           $(this).addClass('hidden');
        });
      }
    });
  
    function send_message(subject, body, verb) {
      var url = "/blog/contact_us";
      var selectedSeries = $('#contact_us_series').val() || "";
      var data = {
        subject: subject,
        body: body,
        content_page_token: "",
        series_token: selectedSeries,
        verb: verb
      };
      if (window.contactUsSurveyUrl) {
        data.survey_url = window.contactUsSurveyUrl;
      }
      if (window.contactUsSurveyToken) {
        data.survey_token = window.contactUsSurveyToken;
      }
      
      if (typeof show_working === 'function') {
        show_working("Please wait...", "gen-ai-pulse", 30);
      }
      
      $('.show-contact-us-form, .contact-us-title').addClass('hidden');
      $('.message-sending-title').removeClass('hidden');
  
      $.post(url, data, function(response) {
        if (response.state == "success") {
          if (response.routed_to_hq || response.review_pending) {
            $('.message-sending-title').addClass('hidden');
            $('.message-sent-title').removeClass('hidden');
            $('.message-sent-heading').text('Submitted to HQ');
            $('.message-sent-subtext').text(response.message).removeClass('hidden');
            return;
          }
          if (response.message_center_url) {
            $('.message-sending-title').addClass('hidden');
            $('.message-sent-title').removeClass('hidden');
            $('.message-sent-heading').text('Opening Message Center...');
            $('.message-sent-subtext').text('Your message is posted. Taking you to the conversation now.').removeClass('hidden');
            window.location.assign(response.message_center_url);
            return;
          }
          $('.message-sending-title').addClass('hidden');
          $('.message-sent-title').removeClass('hidden');
          if (response.held_for_review) {
            $('.message-sent-heading').text('Message Received for Review');
            $('.message-sent-subtext').text(response.message).removeClass('hidden');
            return;
          }
          $('.message-sent-heading').text('Message Sent');
          $('.message-sent-subtext').empty().addClass('hidden');
          if (window.contactUsSurveyToken) {
            $('.message-sent-heading').text('Access Requested');
            $('.message-sent-subtext').text("The organizers have been notified of your request. You'll receive an email when access is granted.").removeClass('hidden');
          }
          if (typeof play_email_sent_sound === 'function') play_email_sent_sound();
        } else if (response.state == "reject") {
          if (typeof show_big_error === 'function') { show_big_error(response.title, response.message); } else { alert(response.message); }
          reset_form();
        } else if (response.state == "reply") {
          if (verb == "confirm") {
            var body_br = response.body.replace(/(?:\r\n|\r|\n)/g, '<br>');
            var preview = "<hr/><strong>Subject:</strong> " + response.subject + "<br/>" + body_br;
            var msg = "<p>" + response.message + "</p><p>" + preview + "</p>";
  
            if (typeof show_big_confirmation_with_cancel_action === 'function') {
              show_big_confirmation_with_cancel_action(
                response.title, msg, "url", "✉️ Yes, Send Email",
                { action: "send_message", subject: response.subject, message: response.body },
                { action: "do_nothing" },
                function(p) { if(p.action == "send_message") send_message(p.subject, p.message, "ok"); },
                'warning', "Cancel send"
              );
            }
          }
          reset_form();
        } else if (response.state == "error") {
          if (typeof show_big_error === 'function') { show_big_error(response.title, response.message); } else { alert(response.message); }
          reset_form();
        }
      }).fail(function(xhr) {
        alert((xhr.responseJSON && xhr.responseJSON.message) || "Something went wrong sending your message. Please try again.");
        reset_form();
      }).always(function() {
        if (typeof hide_working === 'function') hide_working();
      });
    }
  
    function reset_form() {
      $('.message-sent-heading').text('Message Sent');
      $('.message-sent-subtext').addClass('hidden');
      $('.message-sending-title, .message-sent-title').addClass('hidden');
      $('.show-contact-us-form, .contact-us-title').removeClass('hidden');
    }
  
    $('#contact_us_submit').on('click', function() {
      var subject = $('#contact_us_subject').val().trim();
      var message = $('#contact_us_message').val().trim();
      if (!subject || !message) {
        if (typeof show_big_error === 'function') { show_big_error("Error", "Please fill out both fields."); } else { alert("Please fill out both fields."); }
      } else {
        send_message(subject, message, "confirm");
      }
    });
  });
</script>

</div>
</div>
</section>
