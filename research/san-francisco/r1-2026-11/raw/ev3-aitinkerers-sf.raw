ters"},"offers":{"@type":"Offer","url":"https://sf.aitinkerers.org/p/google-deepmind-x-cactus-compute-global-hackathon-san-francisco","price":0,"priceCurrency":"USD","availability":"https://schema.org/SoldOut","validFrom":"2026-02-10T11:00:00-08:00"},"image":"https://images.aitinkerers.org/cdn-cgi/image/format=jpeg/integrated_text_banner/_fqwEDacPcQg.jpg","url":"https://sf.aitinkerers.org/p/google-deepmind-x-cactus-compute-global-hackathon-san-francisco"}},{"@type":"ListItem","position":17,"url":"https://sf.aitinkerers.org/p/inaugural-ai-tinkerers-sf-build-night","item":{"@context":"https://schema.org","@type":"Event","@id":"https://sf.aitinkerers.org/p/inaugural-ai-tinkerers-sf-build-night#event","name":"Inaugural AI Tinkerers SF Build Night","description":"Join the inaugural AI Tinkerers SF Build Night Feb 18, 2026, 5:30–8:30pm at CircleCI HQ—bring your laptop and keep hacking alongside other active AI builders; demos optional at 8:00. Entry is earned, not granted—register with technical context (email/LinkedIn/Twitter/GitHub).","startDate":"2026-02-18T17:30:00-08:00","endDate":"2026-02-18T20:30:00-08:00","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"Place","name":"Private venue","address":{"@type":"PostalAddress","streetAddress":"130 Sutter St Floor 7","addressLocality":"San Francisco","addressRegion":"CA","postalCode":"94104","addressCountry":"US"}},"organizer":{"@type":"Organization","@id":"https://sf.aitinkerers.org/#chapter-organization","name":"AI Tinkerers - San Francisco","url":"https://sf.aitinkerers.org/"},"performer":{"@type":"PerformingGroup","name":"San Francisco presenters"},"offers":{"@type":"Offer","url":"https://sf.aitinkerers.org/p/inaugural-ai-tinkerers-sf-build-night","price":0,"priceCurrency":"USD","availability":"https://schema.org/SoldOut","validFrom":"2026-01-31T12:23:32-08:00"},"image":"https://images.aitinkerers.org/cdn-cgi/image/format=jpeg/integrated_text_banner/_6XjNPe72_4Q.jpg","url":"https://sf.aitinkerers.org/p/inaugural-ai-tinkerers-sf-build-night"}},{"@type":"ListItem","position":18,"url":"https://sf.aitinkerers.org/p/openclaw-unhackathon","item":{"@context":"https://schema.org","@type":"Event","@id":"https://sf.aitinkerers.org/p/openclaw-unhackathon#event","name":"OpenClaw Unhackathon","description":"OpenClaw Unhackathon: a heads-down build day for OpenClaw/ClawdBot tinkerers—ship code, set up and harden infrastructure, develop/integrate plugins, and do peer debugging side-by-side. Sat, Feb 7, 2026, 2:00–6:00 PM in a Work OS office (address after acceptance), capped at 40 builders; include your build plan on registration. Food/drinks provided; thanks to Work OS.","startDate":"2026-02-07T14:00:00-08:00","endDate":"2026-02-07T18:00:00-08:00","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"Place","name":"Private venue","address":{"@type":"PostalAddress","streetAddress":"660 Market St STE 300","addressLocality":"San Francsico","addressRegion":"CA","postalCode":"","addressCountry":"US"}},"organizer":{"@type":"Organization","@id":"https://sf.aitinkerers.org/#chapter-organization","name":"AI Tinkerers - San Francisco","url":"https://sf.aitinkerers.org/"},"sponsor":[{"@type":"Organization","name":"Work OS","url":"https://workos.com/","logo":"https://images.aitinkerers.org/cdn-cgi/image/format=auto,background=transparent/blog_images/workos-inc-logo-vector-png-zeO-.png"},{"@type":"Organization","name":"CopilotKit","url":"https://www.copilotkit.ai/","logo":"https://images.aitinkerers.org/cdn-cgi/image/format=auto,background=transparent/blog_images/copilotkit-ai-logo-png-svg-vector-png-Wpld.png"},{"@type":"Organization","name":"Composio","url":"https://composio.dev","logo":"https://images.aitinkerers.org/cdn-cgi/image/format=auto,background=transparent/blog_images/f262441f820f89a39e1a62bb9c742b3f-png-CM_Q.png"},{"@typ