tAttendanceMode","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"Place","name":"Private venue","address":{"@type":"PostalAddress","streetAddress":"640 Sacramento St","addressLocality":"San Francisco","addressRegion":"CA","postalCode":"94111","addressCountry":"US"}},"organizer":{"@type":"Organization","@id":"https://sf.aitinkerers.org/#chapter-organization","name":"AI Tinkerers - San Francisco","url":"https://sf.aitinkerers.org/"},"sponsor":[{"@type":"Organization","name":"Amazon","logo":"https://images.aitinkerers.org/blog_images/1280px-amazon-logo-svg-png-u-LO.png"}],"performer":{"@type":"PerformingGroup","name":"San Francisco presenters"},"offers":{"@type":"Offer","url":"https://sf.aitinkerers.org/p/building-software-factories-vip-dinner-with-kiro-b-capital","price":0,"priceCurrency":"USD","availability":"https://schema.org/SoldOut","validFrom":"2026-04-22T13:58:58-07:00"},"image":"https://images.aitinkerers.org/cdn-cgi/image/format=jpeg/agentic_banner/_OWDh5njwbJI.jpg","url":"https://sf.aitinkerers.org/p/building-software-factories-vip-dinner-with-kiro-b-capital"}},{"@type":"ListItem","position":14,"url":"https://sf.aitinkerers.org/p/build-night-cage-the-claw","item":{"@context":"https://schema.org","@type":"Event","@id":"https://sf.aitinkerers.org/p/build-night-cage-the-claw#event","name":"Build Night: Cage the Claw","description":"Join AI Tinkerers’ Build Night “Cage the Claw” in San Francisco on Saturday, April 4, 2026 (2:00–8:00 PM), capacity 100 builders (address shared on acceptance). We’ll focus on OpenClaw execution: sandboxing/security, permission systems, consumer UI/UX, and deep API integrations; share demos 6:30–7:30. Sponsors: Oracle \u0026 NVIDIA; venue host: Composio.","startDate":"2026-04-04T19:00:00-07:00","endDate":"2026-04-04T20:30:00-07:00","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"Place","name":"Private venue","address":{"