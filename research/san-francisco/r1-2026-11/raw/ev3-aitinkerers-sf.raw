<script type="e8539e3ded626e527dabcfd3-text/javascript">
  (() => {
    const panel = document.getElementById("chapter-event-sharing");
    const preview = panel.querySelector("[data-chapter-event-preview]");
    const status = panel.querySelector("[data-chapter-event-copy-status]");
  
    panel.addEventListener("toggle", () => {
      if (panel.open && !preview.hasAttribute("src")) preview.src = preview.dataset.chapterEventPreview;
    });
  
    panel.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-chapter-event-copy]");
      if (!button) return;
  
      const value = button.dataset.chapterEventCopy;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        window.prompt("Copy this to your clipboard", value);
        return;
      }
  
      status.textContent = "Copied to clipboard.";
      const original = button.dataset.copyLabel ||= button.textContent.trim();
      button.textContent = "Copied";
      clearTimeout(button.copyReset);
      button.copyReset = setTimeout(() => { button.textContent = original; }, 1800);
    });
  })();
</script>

