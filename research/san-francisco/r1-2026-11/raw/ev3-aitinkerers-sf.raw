<meta content='#f4f3f1' id='metaThemeColor' name='theme-color'>
<script data-cfasync='false'>
(function() {
  if (window.mcTheme) {
    window.mcTheme.apply();
    return;
  }

  window.__mcViewerTimeZone = "Etc/UTC";
  window.__mcAutoThemeTimeZone = "Europe/London";
  window.__mcAutoThemeTimeZoneSource = "sensed from your location";
  window.__mcAutoThemeDebug = {"timezone":"Europe/London","timezone_source":"sensed from your location","viewer_timezone":"Etc/UTC","geo_city":"Reading","geo_region":"England","geo_country":"United Kingdom","geo_time_zone":"Europe/London","geo_latitude":51.4236,"geo_longitude":-0.9554};
  window.__mcColorSchemePreference = "auto";
  window.__mcColorSchemePreferenceStored = false;
  window.__mcColorSchemePreferenceCanPersist = false;
  window.__mcFixedColorScheme = "";

  var mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
  var autoTimeZone = window.__mcAutoThemeTimeZone || window.__mcViewerTimeZone || "UTC";
  var autoThemeGeo = window.__mcAutoThemeDebug || {};
  var localThemePrefKey = "mcThemePref";
  var validThemePrefs = ["auto", "light", "dark"];
  var solarDarkBufferMinutes = 30;
  var fixedColorScheme = validThemePrefs.indexOf(window.__mcFixedColorScheme) >= 1 ? window.__mcFixedColorScheme : "";

  function normalizedThemePref(value) {
    return validThemePrefs.indexOf(value) >= 0 ? value : "auto";
  }

  function localThemePref() {
    try { return normalizedThemePref(localStorage.getItem(localThemePrefKey)); }
    catch (_) { return "auto"; }
  }

  function persistedThemePref() {
    return normalizedThemePref(window.__mcColorSchemePreference || "auto");
  }

  function currentThemePref() {
    return window.__mcColorSchemePreferenceStored ? persistedThemePref() : localThemePref();
  }

  function cacheThemePref(pref) {
    try {
      if (pref === "auto") localStorage.removeItem(localThemePrefKey);
      else localStorage.setItem(localThemePrefKey, pref);
    } catch (_) {}
  }

  function saveThemePref(pref) {
    if (!window.__mcColorSchemePreferenceCanPersist) return Promise.resolve(null);
    var token = document.querySelector('meta[name="csrf-token"]');
    var body = new FormData();
    body.append("value", pref);
    return fetch("/preferences/color_scheme", {
      method: "PATCH",
      body: body,
      credentials: "same-origin",
      headers: {
        "X-Requested-With": "XMLHttpRequest",
        "X-CSRF-Token": token ? token.content : "",
        "Accept": "application/json"
      }
    }).then(function(response) { return response.json(); }).then(function(payload) {
      if (payload && payload.ok) {
        window.__mcColorSchemePreference = normalizedThemePref(payload.value);
        window.__mcColorSchemePreferenceStored = true;
      }
      return payload;
    }).catch(function() { return null; });
  }

  function hourInTimeZone(timeZone, date) {
    try {
      var hour = new Intl.DateTimeFormat("en-US", {
        timeZone: timeZone,
        hour: "numeric",
        hourCycle: "h23"
      }).format(date);
      var parsed = parseInt(hour, 10);
      return Number.isNaN(parsed) ? date.getHours() : parsed;
    } catch (_) {
      return date.getHours();
    }
  }

  function solarTimeForDate(date, latitude, longitude, eventName) {
    var rad = Math.PI / 180;
    var dayMs = 86400000;
    var julianOffset = 2440588;
    var julian2000 = 2451545;
    var j0 = 0.0009;
    var lw = -longitude * rad;
    var phi = latitude * rad;
    var days = (date.valueOf() / dayMs) - 0.5 + julianOffset - julian2000;
    var n = Math.round(days - j0 - lw / (2 * Math.PI));
    var ds = j0 + lw / (2 * Math.PI) + n;
    var meanAnomaly = rad * (357.5291 + 0.98560028 * ds);
    var equationOfCenter = rad * (1.9148 * Math.sin(meanAnomaly) + 0.0200 * Math.sin(2 * meanAnomaly) + 0.0003 * Math.sin(3 * meanAnomaly));
    var perihelion = rad * 102.9372;
    var eclipticLongitude = meanAnomaly + equationOfCenter + perihelion + Math.PI;
    var declination = Math.asin(Math.sin(eclipticLongitude) * Math.sin(rad * 23.4397));
    var solarTransit = julian2000 + ds + 0.0053 * Math.sin(meanAnomaly) - 0.0069 * Math.sin(2 * eclipticLongitude);
    var altitude = -0.833 * rad;
    var hourAngle = Math.acos((Math.sin(altitude) - Math.sin(phi) * Math.sin(declination)) / (Math.cos(phi) * Math.cos(declination)));
    if (!Number.isFinite(hourAngle)) return null;
    var approxSet = j0 + (hourAngle + lw) / (2 * Math.PI) + n;
    var sunsetJulian = solarTransit + (approxSet - ds);
    var sunriseJulian = solarTransit - (sunsetJulian - solarTransit);
    var julian = eventName === "sunrise" ? sunriseJulian : sunsetJulian;
    return new Date((julian + 0.5 - julianOffset) * dayMs);
  }

  function autoThemeSolarDebug(date) {
    var latitude = Number(autoThemeGeo.geo_latitude);
    var longitude = Number(autoThemeGeo.geo_longitude);
    if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return null;
    var sunrise = solarTimeForDate(date, latitude, longitude, "sunrise");
    var sunset = solarTimeForDate(date, latitude, longitude, "sunset");
    if (!sunrise || !sunset) return null;
    var lightStart = new Date(sunrise.getTime() - solarDarkBufferMinutes * 60 * 1000);
    var lightEnd = new Date(sunset.getTime() + solarDarkBufferMinutes * 60 * 1000);
    return { sunrise: sunrise, sunset: sunset, lightStart: lightStart, lightEnd: lightEnd, theme: (date >= lightStart && date < lightEnd) ? "light" : "dark" };
  }

  function resolveTheme(pref) {
    if (fixedColorScheme) return fixedColorScheme;
    if (pref === "light" || pref === "dark") return pref;
    // Native app chrome follows the device, including during sign-in.
    if (/AITMessageCenter(?:Android)?\//.test(navigator.userAgent)) return mediaQuery.matches ? "dark" : "light";
    var solar = autoThemeSolarDebug(new Date());
    if (solar) return solar.theme;
    var hour = hourInTimeZone(autoTimeZone, new Date());
    return (hour >= 19 || hour < 7) ? "dark" : "light";
  }

  function applyTheme() {
    var pref = currentThemePref();
    var resolved = resolveTheme(pref);
    document.documentElement.dataset.theme = resolved;
    if (fixedColorScheme) document.documentElement.dataset.fixedColorScheme = fixedColorScheme;
    else delete document.documentElement.dataset.fixedColorScheme;
    var meta = document.getElementById("metaThemeColor");
    if (meta) meta.content = resolved === "dark" ? "#161616" : "#f4f3f1";
    return resolved;
  }

  window.mcTheme = {
    apply: applyTheme,
    getPref: currentThemePref,
    getFixedScheme: function() { return fixedColorScheme || null; },
    setPref: function(value) {
      var pref = normalizedThemePref(value);
      window.__mcColorSchemePreference = pref;
      window.__mcColorSchemePreferenceStored = true;
      cacheThemePref(pref);
      var resolved = applyTheme();
      saveThemePref(pref);
      window.dispatchEvent(new CustomEvent("ait:color-scheme-change", { detail: { pref: pref, resolved: resolved } }));
      return resolved;
    },
    autoDebug: function() {
      var now = new Date();
      var hour = hourInTimeZone(autoTimeZone, now);
      return { autoTimeZone: autoTimeZone, browserPrefersDark: mediaQuery.matches, localHour: hour, timeRuleTheme: (hour >= 19 || hour < 7) ? "dark" : "light", solar: autoThemeSolarDebug(now) };
    }
  };

  if (!window.__mcColorSchemePreferenceStored) {
    if (window.__mcColorSchemePreferenceCanPersist) {
      var migratedPref = localThemePref();
      if (migratedPref !== "auto") saveThemePref(migratedPref);
    }
  } else {
    cacheThemePref(persistedThemePref());
  }

  applyTheme();
  if (mediaQuery.addEventListener) mediaQuery.addEventListener("change", applyTheme);
  document.addEventListener("visibilitychange", function() { if (!document.hidden) applyTheme(); });
  setInterval(applyTheme, 60000);
})();

</script>


