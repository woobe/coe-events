<script type="e8539e3ded626e527dabcfd3-text/javascript">
  (function() {
    var COOKIE_NAME = "ait_nav_dismissed_moments";
    var COOKIE_MAX_AGE = 604800;
  
    function readDismissedKeys() {
      var match = document.cookie.match(new RegExp('(?:^|; )' + COOKIE_NAME + '=([^;]*)'));
      if (!match) { return []; }
      try {
        return decodeURIComponent(match[1]).split(',').map(function(s) { return s.trim(); }).filter(Boolean);
      } catch (_) {
        return [];
      }
    }
  
    function persistDismissedKey(key) {
      if (typeof window.__aitMobileNavPersistDismiss === 'function') {
        window.__aitMobileNavPersistDismiss(key);
        return;
      }
      if (!key) { return; }
      var keys = readDismissedKeys().filter(function(existing) { return existing !== key; });
      keys.unshift(key);
      if (keys.length > 16) { keys = keys.slice(0, 16); }
      document.cookie = COOKIE_NAME + '=' + encodeURIComponent(keys.join(',')) + '; Path=/; Max-Age=' + COOKIE_MAX_AGE + '; SameSite=Lax';
    }
  
    var navEl = document.querySelector('[data-mobile-bottom-nav]');
    if (navEl && navEl.dataset.mobileNavAutoDismiss) {
      persistDismissedKey(navEl.dataset.mobileNavAutoDismiss);
    }
  
    if (window.__aitMobileBottomNavBound) { return; }
    window.__aitMobileBottomNavBound = true;
  
    document.addEventListener('click', function(event) {
      var dismissBtn = event.target && event.target.closest ? event.target.closest('[data-mobile-nav-dismiss]') : null;
      if (dismissBtn) {
        event.preventDefault();
        event.stopPropagation();
        var key = dismissBtn.getAttribute('data-mobile-nav-dismiss');
        persistDismissedKey(key);
        if (typeof window.__aitMobileNavSetSheetOpen === 'function') {
          window.__aitMobileNavSetSheetOpen(false);
        }
        var slot = dismissBtn.closest('[data-mobile-bottom-nav-slot]');
        var nav = dismissBtn.closest('[data-mobile-bottom-nav]');
        if (slot) { slot.remove(); }
        if (nav) {
          nav.classList.remove('ait-mobile-bottom-nav--has-moment', 'ait-mobile-bottom-nav--has-qr');
          var remaining = nav.querySelectorAll('[data-mobile-bottom-nav-item]').length;
          nav.setAttribute('data-mobile-bottom-nav-count', String(remaining));
          nav.removeAttribute('data-mobile-bottom-nav-moment');
        }
      }
    });
  })();
</script>

