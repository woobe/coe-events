<style id="wp-custom-css">
/* KEEP THE PAGE WIDE & BUTTONS BLUE */
.single-tribe_events .container {
    width: 100% !important;
    max-width: 1100px !important;
}

#main .template-event {
    padding-top: 0 !important;
    margin-top: -10px !important;
}

.tribe-events-button, .crm-container .crm-button {
    background: #36678a !important;
    color: #ffffff !important;
    padding: 12px 25px !important;
    text-transform: uppercase !important;
    border-radius: 4px !important;
    display: inline-block !important;
    text-decoration: none !important;
}

/* FIX MANUALLY INSERTED IMAGE STRETCHING */
.single-tribe_events .entry-content img {
    height: auto !important;
    max-width: 100% !important;
}

/* Force CiviCRM input visibility inside WordPress Legacy Widgets */
.widget_civicrm,
.widget-crm,
.block-editor-block-list__block[data-type="core/legacy-widget"],
.widget_text .crm-container {
  display: block !important;
  visibility: visible !important;
  width: 100% !important;
}

/* Force inner form inputs to expand in iOS 12 WebKit */
.widget_civicrm input[type="text"],
.widget_civicrm input[type="email"],
.crm-container .crm-form-text,
.crm-section input[type="text"],
.crm-section input[type="email"],
.crm-section input[type="tel"] {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  width: 100% !important;
  min-height: 42px !important;
  box-sizing: border-box !important;
}

/* Fix CiviCRM checkbox background overflow */
.crm-container input[type="checkbox"] {
  appearance: checkbox !important;
  -webkit-appearance: checkbox !important;
  background-color: transparent !important;
  background-image: none !important;
  width: auto !important;
  height: auto !important;
  display: inline-block !important;
}

/* Ensure wrapper divs/labels don't stretch as full blocks */
.crm-container .crm-section .content input[type="checkbox"] {
  margin-right: 8px;
}
</style>
