:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:3.84%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:3.84%;--awb-width-medium:50%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:3.84%;--awb-spacing-left-medium:3.84%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-center fusion-content-layout-column"><div class="fusion-image-element" style="--awb-aspect-ratio:1 / 1;--awb-object-position:20% 49%;--awb-caption-title-font-family:var(--h2_typography-font-family);--awb-caption-title-font-weight:var(--h2_typography-font-weight);--awb-caption-title-font-style:var(--h2_typography-font-style);--awb-caption-title-size:var(--h2_typography-font-size);--awb-caption-title-transform:var(--h2_typography-text-transform);--awb-caption-title-line-height:var(--h2_typography-line-height);--awb-caption-title-letter-spacing:var(--h2_typography-letter-spacing);"><span class=" fusion-imageframe imageframe-none imageframe-12 hover-type-none has-aspect-ratio"><img decoding="async" width="300" height="200" alt="Event rental dance studio empty with murals by artist Carlos Loarca" title="Dance studio" src="https://somarts.org/wp-content/uploads/2024/03/Dance_Studio_1-1200x800-1-300x200.jpeg" class="img-responsive wp-image-10537 img-with-aspect-ratio" data-parent-fit="cover" data-parent-container=".fusion-image-element" srcset="https://somarts.org/wp-content/uploads/2024/03/Dance_Studio_1-1200x800-1-200x133.jpeg 200w, https://somarts.org/wp-content/uploads/2024/03/Dance_Studio_1-1200x800-1-400x267.jpeg 400w, https://somarts.org/wp-content/uploads/2024/03/Dance_Studio_1-1200x800-1-600x400.jpeg 600w, https://somarts.org/wp-content/uploads/2024/03/Dance_Studio_1-1200x800-1-800x533.jpeg 800w, https://somarts.org/wp-content/uploads/2024/03/Dance_Studio_1-1200x800-1.jpeg 1200w" sizes="(max-width: 640px) 100vw, 600px" /></span></div></div></div><div class="fusion-layout-column fusion_builder_column fusion-builder-column-28 fusion_builder_column_1_2 1_2 fusion-flex-column fusion-flex-align-self-stretch" style="--awb-padding-top:10%;--awb-padding-right:10%;--awb-padding-bottom:10%;--awb-padding-left:10%;--awb-bg-size:cover;--awb-width-large:50%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:3.84%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:3.84%;--awb-width-medium:50%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:3.84%;--awb-spacing-left-medium:3.84%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-center fusion-content-layout-column"><div class="fusion-title title fusion-title-26 fusion-sep-none fusion-title-center fusion-title-text fusion-title-size-two" style="--awb-margin-top-small:0px;--awb-margin-right-small:0px;--awb-margin-bottom-small:20px;--awb-margin-left-small:0px;"><h2 class="fusion-title-heading title-heading-center fusion-responsive-typography-calculated" style="margin:0;--fontSize:65;line-height:1;">DANCE STUDIO</h2></div><div class="fusion-text fusion-text-19" style="--awb-content-alignment:center;"><p>Our sun-drenched dance studio includes a site specific mural by artist <a href="https://somarts.org/somarts-historical-timeline/">Carlos Loarca</a>. The dance studio can be used as a staging area, additional dressing room, meeting or rehearsal space.</p>
</div><div class="fusion-counters-box counters-box row fusion-clearfix fusion-columns-2" style="--awb-body-size:18;--awb-border-color:var(--awb-color1);--awb-color:var(--awb-color6);--awb-title-size:60;--awb-border-color:var(--awb-color1);"><div class="fusion-counter-box fusion-column col-counter-box counter-box-wrapper col-lg-6 col-md-6 col-sm-6" data-animationOffset="top-into-view"><div class="counter-box-container"><div class="content-box-percentage content-box-counter"><span class="display-counter" data-value="30" data-direction="up" data-decimals="0">0</span></div><div class="counter-box-content">Standing Capacity</div></div></div><div class="fusion-counter-box fusion-column col-counter-box counter-box-wrapper col-lg-6 col-md-6 col-sm-6" data-animationOffset="top-into-view"><div class="counter-box-container"><div class="content-box-percentage content-box-counter"><span class="display-counter" data-value="15" data-direction="up" data-decimals="0">0</span></div><div class="counter-box-content">Seated Capacity</div></div></div></div></div></div></div></div><div class="fusion-fullwidth fullwidth-box fusion-builder-row-10 fusion-flex-container nonhundred-percent-fullwidth non-hundred-percent-height-scrolling" style="--awb-border-radius-top-left:0px;--awb-border-radius-top-right:0px;--awb-border-radius-bottom-right:0px;--awb-border-radius-bottom-left:0px;--awb-padding-top:2%;--awb-padding-bottom:2%;--awb-flex-wrap:wrap;" ><div class="fusion-builder-row fusion-row fusion-flex-align-items-center fusion-flex-content-wrap" style="max-width:1248px;margin-left: calc(-4% / 2 );margin-right: calc(-4% / 2 );"><div class="fusion-layout-column fusion_builder_column fusion-builder-column-29 fusion_builder_column_1_2 1_2 fusion-flex-column fusion-flex-align-self-stretch" style="--awb-padding-top:10%;--awb-padding-right:10%;--awb-padding-bottom:10%;--awb-padding-left:10%;--awb-bg-size:cover;--awb-width-large:50%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:3.84%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:3.84%;--awb-width-medium:50%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:3.84%;--awb-spacing-left-medium:3.84%;--awb-width-small:100%;--awb-order-small:1;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-center fusion-content-layout-column"><div class="fusion-title title fusion-title-27 fusion-sep-none fusion-title-center fusion-title-text fusion-title-size-two" style="--awb-margin-top-small:0px;--awb-margin-right-small:0px;--awb-margin-bottom-small:20px;--awb-margin-left-small:0px;"><h2 class="fusion-title-heading title-heading-center fusion-responsive-typography-calculated" style="margin:0;--fontSize:65;line-height:1;">FLOORPLAN</h2></div><div class="fusion-text fusion-text-20" style="--awb-content-alignment:center;"><p>This floorplan shows the full event rentals space relative to the other distinct areas available to our clients: kitchenette/ bar area, lobby, gender-neutral bathrooms, a client office for staging/prep, a dressing room behind the stage and a classroom. The dance studio is upstairs and not currently ADA compliant. The patio is right outside the Main Entrance (indicated in blue type).</p>
</div></div></div><div class="fusion-layout-column fusion_builder_column fusion-builder-column-30 fusion_builder_column_1_2 1_2 fusion-flex-column fusion-flex-align-self-stretch" style="--awb-bg-size:cover;--awb-width-large:50%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:3.84%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:3.84%;--awb-width-medium:50%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:3.84%;--awb-spacing-left-medium:3.84%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-center fusion-content-layout-column"><div class="fusion-image-element" style="--awb-aspect-ratio: 100 / 52;--awb-caption-title-font-family:var(--h2_typography-font-family);--awb-caption-title-font-weight:var(--h2_typography-font-weight);--awb-caption-title-font-style:var(--h2_typography-font-style);--awb-caption-title-size:var(--h2_typography-font-size);--awb-caption-title-transform:var(--h2_typography-text-transform);--awb-caption-title-line-height:var(--h2_typography-line-height);--awb-caption-title-letter-spacing:var(--h2_typography-letter-spacing);"><span class=" fusion-imageframe imageframe-none imageframe-13 hover-type-none has-aspect-ratio"><a class="fusion-no-lightbox" href="https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-scaled.jpg" target="_blank" aria-label="ERP Rental Space Diagram 2025 May" rel="noopener noreferrer"><img decoding="async" width="1024" height="576" alt="SOMArts&#039; event rental space floor plan" src="https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-1024x576.jpg" class="img-responsive wp-image-13191 img-with-aspect-ratio" data-parent-fit="cover" data-parent-container=".fusion-image-element" srcset="https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-200x113.jpg 200w, https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-400x225.jpg 400w, https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-600x338.jpg 600w, https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-800x450.jpg 800w, https://somarts.org/wp-content/uploads/2025/05/ERP-Rental-Space-Diagram-2025-May-1200x675.jpg 1200w" sizes="(max-width: 640px) 100vw, 600px" /></a></span></div></div></div></div></div><div class="fusion-fullwidth fullwidth-box fusion-builder-row-11 fusion-flex-container has-pattern-background has-mask-background nonhundred-percent-fullwidth non-hundred-percent-height-scrolling" style="--awb-border-radius-top-left:0px;--awb-border-radius-top-right:0px;--awb-border-radius-bottom-right:0px;--awb-border-radius-bottom-left:0px;--awb-flex-wrap:wrap;" ><div class="fusion-builder-row fusion-row fusion-flex-align-items-flex-start fusion-flex-content-wrap" style="max-width:1248px;margin-left: calc(-4% / 2 );margin-right: calc(-4% / 2 );"><div class="fusion-layout-column fusion_builder_column fusion-builder-column-31 fusion_builder_column_1_1 1_1 fusion-flex-column" style="--awb-bg-size:cover;--awb-width-large:100%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:1.92%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:1.92%;--awb-width-medium:100%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:1.92%;--awb-spacing-left-medium:1.92%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-flex-start fusion-content-layout-column"><div class="fusion-title title fusion-title-28 fusion-sep-none fusion-title-text fusion-title-size-one" style="--awb-margin-top-small:0px;--awb-margin-right-small:0px;--awb-margin-bottom-small:20px;--awb-margin-left-small:0px;"><h1 class="fusion-title-heading title-heading-left fusion-responsive-typography-calculated" style="margin:0;--fontSize:85;line-height:.7;">Event Rental Packages</h1></div><div class="fusion-text fusion-text-21"><p>Our packages provide our starting price point based on the length of the event and number of days.  Even if you’re not sure whether your event will fit neatly into one of these packages – <b>please submit your request for a quote!</b> There are a number of ways we can try to accommodate your group.</p>
<p><strong>Important:</strong> these packages do not include discounts given to non-profits, security (which is determined based on anticipated attendance), nor the refundable damage deposit.</p>
</div><div class="accordian fusion-accordian" style="--awb-border-size:1px;--awb-icon-size:13px;--awb-content-font-size:16px;--awb-icon-alignment:left;--awb-hover-color:#f9f9f9;--awb-border-color:#cccccc;--awb-background-color:#ffffff;--awb-divider-color:#e0dede;--awb-divider-hover-color:#e0dede;--awb-icon-color:#ffffff;--awb-title-color:#f47b4c;--awb-content-color:#4a4e57;--awb-icon-box-color:#333333;--awb-toggle-hover-accent-color:#a0ce4e;--awb-title-font-family:&quot;Red Hat Display&quot;;--awb-title-font-weight:400;--awb-title-font-style:normal;--awb-content-font-family:&quot;IBM Plex Sans&quot;;--awb-content-font-style:normal;--awb-content-font-weight:400;"><div class="panel-group fusion-toggle-icon-boxed" id="accordion-13-1"><div class="fusion-panel panel-default panel-fe1cea92b55d9ff63 fusion-toggle-has-divider"><div class="panel-heading"><h4 class="panel-title toggle" id="toggle_fe1cea92b55d9ff63"><a aria-expanded="false" aria-controls="fe1cea92b55d9ff63" role="button" data-toggle="collapse" data-parent="#accordion-13-1" data-target="#fe1cea92b55d9ff63" href="#fe1cea92b55d9ff63"><span class="fusion-toggle-icon-wrapper" aria-hidden="true"><i class="fa-fusion-box active-icon awb-icon-minus" aria-hidden="true"></i><i class="fa-fusion-box inactive-icon awb-icon-plus" aria-hidden="true"></i></span><span class="fusion-toggle-heading">Essentials Package</span></a></h4></div><div id="fe1cea92b55d9ff63" class="panel-collapse collapse " aria-labelledby="toggle_fe1cea92b55d9ff63"><div class="panel-body toggle-content fusion-clearfix">
<p><b style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Attendance: </b><span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">100-150 guests</span><br />
<b style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Event length:</b><span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true"> 2-3 hours</span><br />
<span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Pricing starts at $4,549</span></p>
<p style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">The Essentials Package is the perfect choice for making your one-day event or pop-up truly memorable! This package includes:</p>
<ul>
<li><span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Day-long access to the event space (8 hours)</span></li>
<li><span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Full Audio and Lighting Package</span></li>
<li><span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Audio technician</span></li>
<li><span style="font-family: 'Freight Micro Medium'; line-height: 30px; font-size: 20px;" data-fusion-font="true">Set up and load out labor</span></li>
</ul>
</div></div></div><div class="fusion-panel panel-default panel-7b59c9edbb465effd fusion-toggle-has-divider"><div class="panel-heading"><h4 class="panel-title toggle" id="toggle_7b59c9edbb465effd"><a aria-expanded="false" aria-controls="7b59c9edbb465effd" role="button" data-toggle="collapse" data-parent="#accordion-13-1" data-target="#7b59c9edbb465effd" href="#7b59c9edbb465effd"><span class="fusion-toggle-icon-wrapper" aria-hidden="true"><i class="fa-fusion-box active-icon awb-icon-minus" aria-hidden="true"></i><i class="fa-fusion-box inactive-icon awb-icon-plus" aria-hidden="true"></i></span><span class="fusion-toggle-heading">Signature Package</span></a></h4></div><div id="7b59c9edbb465effd" class="panel-collapse collapse " aria-labelledby="toggle_7b59c9edbb465effd"><div class="panel-body toggle-content fusion-clearfix">
<p><b style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Attendance:</b><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true"> flexible based on our capacity maximums</span><br />
<b style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Event length: </b><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">4 hours</span><br />
<span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Pricing starts at $6,428</span></p>
<p style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">The Signature Package offers enhanced customization and event coordination support to elevate your experience. This package includes:</p>
<ul>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Day-long access to the event space (8 hours)</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Full Audio and Lighting Package</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Audio technician</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Set up and load out labor</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Custom lighting</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Video projection capabilities</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Stage manager</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Janitorial labor and disposal fee</span></li>
</ul>
</div></div></div><div class="fusion-panel panel-default panel-a65a1c6403ea4dc59 fusion-toggle-has-divider"><div class="panel-heading"><h4 class="panel-title toggle" id="toggle_a65a1c6403ea4dc59"><a aria-expanded="false" aria-controls="a65a1c6403ea4dc59" role="button" data-toggle="collapse" data-parent="#accordion-13-1" data-target="#a65a1c6403ea4dc59" href="#a65a1c6403ea4dc59"><span class="fusion-toggle-icon-wrapper" aria-hidden="true"><i class="fa-fusion-box active-icon awb-icon-minus" aria-hidden="true"></i><i class="fa-fusion-box inactive-icon awb-icon-plus" aria-hidden="true"></i></span><span class="fusion-toggle-heading">Deluxe Package</span></a></h4></div><div id="a65a1c6403ea4dc59" class="panel-collapse collapse " aria-labelledby="toggle_a65a1c6403ea4dc59"><div class="panel-body toggle-content fusion-clearfix">
<p><b style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Attendance:</b><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true"> Flexible based on our capacity maximums</span><br />
<b style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Event length:</b><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true"> All-day or two-day event</span><br />
<span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Pricing starts at $12,382</span></p>
<p style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">The Deluxe Package suits most all-day or two-day events, with all the features of the Signature Package:</p>
<ul>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Day-long access to the event space </span><b style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">(for 8 hour events, or 2 half-days)</b></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Full Audio and Lighting Package</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Audio technician</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Set up and load out labor</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Custom lighting</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Video projection capabilities</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Stage manager</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Janitorial labor and disposal fee</span></li>
</ul>
</div></div></div><div class="fusion-panel panel-default panel-46633b65ae7af47be fusion-toggle-has-divider"><div class="panel-heading"><h4 class="panel-title toggle" id="toggle_46633b65ae7af47be"><a aria-expanded="false" aria-controls="46633b65ae7af47be" role="button" data-toggle="collapse" data-parent="#accordion-13-1" data-target="#46633b65ae7af47be" href="#46633b65ae7af47be"><span class="fusion-toggle-icon-wrapper" aria-hidden="true"><i class="fa-fusion-box active-icon awb-icon-minus" aria-hidden="true"></i><i class="fa-fusion-box inactive-icon awb-icon-plus" aria-hidden="true"></i></span><span class="fusion-toggle-heading">Add-on Menu</span></a></h4></div><div id="46633b65ae7af47be" class="panel-collapse collapse " aria-labelledby="toggle_46633b65ae7af47be"><div class="panel-body toggle-content fusion-clearfix">
<p style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Enhance your event with our unique SOMArts’ “extras”:</p>
<ul>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Patio/Garden space </span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Dance studio for rehearsals </span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Side Classroom</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Live streaming to broadcast your event online </span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Event Recording </span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Bar management (typically doable for events under 200 people)</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Bleacher seating for black box theater layout</span></li>
<li aria-level="1"><span style="font-family: 'Freight Micro Medium'; font-size: 20px;" data-fusion-font="true">Outdoor Stage</span></li>
</ul>
</div></div></div></div></div></div></div></div></div><div class="fusion-fullwidth fullwidth-box fusion-builder-row-12 fusion-flex-container has-pattern-background has-mask-background nonhundred-percent-fullwidth non-hundred-percent-height-scrolling" style="--awb-border-radius-top-left:0px;--awb-border-radius-top-right:0px;--awb-border-radius-bottom-right:0px;--awb-border-radius-bottom-left:0px;--awb-flex-wrap:wrap;" ><div class="fusion-builder-row fusion-row fusion-flex-align-items-flex-start fusion-flex-justify-content-center fusion-flex-content-wrap" style="max-width:1248px;margin-left: calc(-4% / 2 );margin-right: calc(-4% / 2 );"><div class="fusion-layout-column fusion_builder_column fusion-builder-column-32 fusion_builder_column_4_5 4_5 fusion-flex-column" style="--awb-bg-size:cover;--awb-width-large:80%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:2.4%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:2.4%;--awb-width-medium:80%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:2.4%;--awb-spacing-left-medium:2.4%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-flex-start fusion-content-layout-column"><div class="fusion-text fusion-text-22" style="--awb-content-alignment:center;"></div><div class="fusion-title title fusion-title-29 fusion-sep-none fusion-title-center fusion-title-text fusion-title-size-three" style="--awb-margin-top-small:0px;--awb-margin-right-small:0px;--awb-margin-bottom-small:20px;--awb-margin-left-small:0px;"><h3 class="fusion-title-heading title-heading-center fusion-responsive-typography-calculated" style="margin:0;--fontSize:48;line-height:1;">What SOMArts provides</h3></div><div class="fusion-text fusion-text-23" style="--awb-content-alignment:center;"><p>Expert technical staff<br />
Set-up assistance<br />
Custom event lighting<br />
AV support<br />
Video projections<br />
Pipe and drape<br />
Tables and chairs<br />
Bleacher seating for black box theater layout</p>
</div><div style="text-align:center;"><a class="fusion-button button-flat fusion-button-default-size button-default fusion-button-default button-16 fusion-button-default-span fusion-button-default-type" style="--awb-margin-top:15px;" target="_blank" rel="noopener noreferrer" href="https://app.perfectvenue.com/venues/somarts-cultural-center-somarts-cultural-center/hello"><span class="fusion-button-text awb-button__text awb-button__text--default">GET A QUOTE</span></a></div></div></div></div></div><div class="fusion-fullwidth fullwidth-box fusion-builder-row-13 fusion-flex-container has-pattern-background has-mask-background nonhundred-percent-fullwidth non-hundred-percent-height-scrolling" style="--awb-border-radius-top-left:0px;--awb-border-radius-top-right:0px;--awb-border-radius-bottom-right:0px;--awb-border-radius-bottom-left:0px;--awb-flex-wrap:wrap;" ><div class="fusion-builder-row fusion-row fusion-flex-align-items-flex-start fusion-flex-justify-content-center fusion-flex-content-wrap" style="max-width:1248px;margin-left: calc(-4% / 2 );margin-right: calc(-4% / 2 );"><div class="fusion-layout-column fusion_builder_column fusion-builder-column-33 fusion_builder_column_3_4 3_4 fusion-flex-column" style="--awb-bg-size:cover;--awb-width-large:75%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:2.56%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:2.56%;--awb-width-medium:75%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:2.56%;--awb-spacing-left-medium:2.56%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-flex-start fusion-content-layout-column"><div class="fusion-text fusion-text-24"><p>Client Testimonials:</p>
</div><div class="fusion-testimonials clean awb-testimonials-layout-fade awb-testimonial-content-flex-start awb-speech-bubble-show awb-testimonial-author-inline fusion-testimonials-1" style="--awb-flex-align-items:stretch;--awb-backgroundcolor:var(--awb-color3);--awb-testimonial-border-style:solid;--awb-testimonial-border-color:var(--awb-color3);--awb-textcolor:var(--awb-color6);--awb-content-valign:center;--awb-initials-bg-color:var(--primary_color);--awb-initials-text-color:#ffffff;--awb-testimonial-icon-size:2em;--awb-navigation-size:12px;--awb-border-top-left-radius:0px;--awb-border-top-right-radius:0px;--awb-border-bottom-left-radius:0px;--awb-border-bottom-right-radius:0px;--testimonial-border-width-top:0px;--testimonial-border-width-right:0px;--testimonial-border-width-bottom:0px;--testimonial-border-width-left:0px;"><div class="reviews awb-carousel awb-swiper awb-swiper-dots-position-below" data-touchscroll="touch" data-loop="yes" data-pagination="bullets" data-autoplay="yes" data-autoplayspeed="4000" data-autoplaypause="no" style="--awb-arrow-bgcolor:rgba(0,0,0,0.6);--awb-arrow-color:#fff;--awb-arrow-hover-bgcolor:rgba(0,0,0,0.7);--awb-arrow-hover-color:#fff;--awb-dots-align:center;--awb-arrow-position-vertical-transform:none;" data-slide-effect="fade" data-itemmargin="0"><div class="swiper-wrapper"><div class="swiper-slide review avatar-above no-avatar"><blockquote class="testimonials-shortcode-blockquote"><div class="awb-quote"><div class="awb-quote-content">
<p>&#8220;SOMArts has been home to our annual ArtAuction for over 20 years, and we wouldn&#8217;t dream of using any other venue! The gallery space at SOMArts is perfect for displaying art, staging musical performances, and creating an accessible and inviting space for our community. The staff have always been extremely helpful and supportive in planning and executing the best event possible. We are proud to be longtime customers of SOMArts!&#8221;</p>
</div></div></blockquote><div class="author"><span class="company-name"><strong class="testimonial-name">Carlos</strong><span class="awb-testimonial-sep">, </span><span class="testimonial-extras"><span class="testimonial-company">Coalition on Homelessness</span></span></span></div></div><div class="swiper-slide review avatar-above no-avatar"><blockquote class="testimonials-shortcode-blockquote"><div class="awb-quote"><div class="awb-quote-content">
<p>&#8220;SOMArts is a phenomenal place for events. The space is very modifiable, and it&#8217;s easy to dress the space up or down for your needs. I also love that so many elements are inclusive (A/V, security, etc.), a rarity in event spaces! The staff are knowledgeable and very helpful. We&#8217;ve thrown several galas for our non-profit there and will keep returning!&#8221;</p>
</div></div></blockquote><div class="author"><span class="company-name"><strong class="testimonial-name">Sara</strong><span class="awb-testimonial-sep">, </span><span class="testimonial-extras"><span class="testimonial-company">Coleman Advocates</span></span></span></div></div><div class="swiper-slide review avatar-above no-avatar"><blockquote class="testimonials-shortcode-blockquote"><div class="awb-quote"><div class="awb-quote-content">
<p>“Our experience hosting our annual fundraiser with SOMArts was beyond expectations. We were met with a full team of event support before, during, and after the fundraiser to guide us with planning for food, beverages, live music, a silent auction, and the installation of our art auction. The SOMArts team has a can-do attitude, treats you with abundant hospitality, and helps think of every event detail while planning and executing your event. We had a seamless experience and couldn&#8217;t have created such a large-scale, impactful event without their support.&#8221;</p>
</div></div></blockquote><div class="author"><span class="company-name"><strong class="testimonial-name">Katie</strong><span class="awb-testimonial-sep">, </span><span class="testimonial-extras"><span class="testimonial-company">EduSkate + SF Skate Club</span></span></span></div></div></div></div></div></div></div></div></div><div class="fusion-fullwidth fullwidth-box fusion-builder-row-14 fusion-flex-container has-pattern-background has-mask-background nonhundred-percent-fullwidth non-hundred-percent-height-scrolling" style="--awb-border-radius-top-left:0px;--awb-border-radius-top-right:0px;--awb-border-radius-bottom-right:0px;--awb-border-radius-bottom-left:0px;--awb-flex-wrap:wrap;" ><div class="fusion-builder-row fusion-row fusion-flex-align-items-flex-start fusion-flex-justify-content-center fusion-flex-content-wrap" style="max-width:1248px;margin-left: calc(-4% / 2 );margin-right: calc(-4% / 2 );"><div class="fusion-layout-column fusion_builder_column fusion-builder-column-34 fusion_builder_column_3_4 3_4 fusion-flex-column" style="--awb-bg-size:cover;--awb-width-large:75%;--awb-flex-grow:0;--awb-flex-shrink:0;--awb-margin-top-large:0px;--awb-spacing-right-large:2.56%;--awb-margin-bottom-large:20px;--awb-spacing-left-large:2.56%;--awb-width-medium:75%;--awb-order-medium:0;--awb-flex-grow-medium:;--awb-flex-shrink-medium:;--awb-spacing-right-medium:2.56%;--awb-spacing-left-medium:2.56%;--awb-width-small:100%;--awb-order-small:0;--awb-flex-grow-small:;--awb-flex-shrink-small:;--awb-spacing-right-small:1.92%;--awb-spacing-left-small:1.92%;"><div class="fusion-column-wrapper fusion-column-has-shadow fusion-flex-justify-content-flex-start fusion-content-layout-column"><div class="fusion-title title fusion-title-30 fusion-sep-none fusion-title-center fusion-title-text fusion-title-size-two" style="--awb-margin-top-small:0px;--awb-margin-right-small:0px;--awb-margin-bottom-small:20px;--awb-margin-left-small:0px;"><h2 class="fusion-title-heading title-heading-center fusion-responsive-typography-calculated" style="margin:0;--fontSize:65;line-height:1;">Past Clients</h2></div><div class="fusion-text fusion-text-25 awb-text-cols fusion-text-columns-3" style="--awb-content-alignment:center;--awb-columns:3;--awb-column-spacing:2em;--awb-column-min-width:100px;"><p>Asian Pacific Islander Cultural Center (APICC)<br />
