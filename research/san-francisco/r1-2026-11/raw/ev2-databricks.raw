ndle":"dataaisummit2026_agenda_item","label":"Data Governance at Scale with ABAC at Atlassian"},{"id":"17749","uuid":"d29db724-3e23-48aa-b25b-e5752dcf47dd","type":"node","bundle":"dataaisummit2026_agenda_item","label":"Pipeline to Production in Minutes: How a Leading P\u0026C Insurer Achieved End-to-End DevOps on Databricks"},{"id":"17787","uuid":"243171c3-1dcc-4929-8dc3-2b7886951d1d","type":"node","bundle":"dataaisummit2026_agenda_item","label":"What Worked, What Didn’t: Virgin Atlantic’s Flight to Trusted Generative BI"}],"field_title":"SESSIONS"},{"id":"8811","uuid":"55ebbc94-35db-477a-bbe5-91be1d94f558","type":"sidebar_container","revision_id":"182357","field_body":[{"value":"\u003cp\u003eJoin thousands of data leaders, engineers, scientists and architects to explore the convergence of data and AI and the future of data-intelligent apps and agents.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eJoin thousands of data leaders, engineers, scientists and architects to explore the convergence of data and AI and the future of data-intelligent apps and agents.\u003c/p\u003e"}],"field_cta_group":[{"id":"8805","uuid":"d931b6ef-765a-419b-916c-455a6fd5ec19","type":"cta_group","revision_id":"182354","field_cta_group_align_items":"flex-start","field_cta_group_direction":"row"}],"field_dark":"0","field_header_size":"default","field_padding_bottom":"default","field_padding_top":"default","field_paragraphs":[{"id":"8810","uuid":"a0867e6a-3d49-418b-8776-ce36b80609e3","type":"sidebar_container_item","revision_id":"182356","field_paragraphs":[{"id":"8809","uuid":"a2b71331-2a69-4f7b-8a9e-4b00f34d0ab6","type":"cards_with_quote","revision_id":"182355","field_cards_with_quote_variant":"Horizontal","field_paragraphs":[{"id":"8806","uuid":"a02bb2c8-b021-4769-9647-2d731b812a80","type":"card","revision_id":"150048","field_body":[{"value":"\u003cp\u003eExplore the latest advances in Delta Lake, Apache Iceberg™, Apache Spark™, MLflow, Unity Catalog, Lakeflow, Databricks Apps, Databricks SQL and Lakebase — alongside agentic AI systems, AI/BI and open source frameworks such as DSPy, LangChain, PyTorch, dbt and Trino.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eExplore the latest advances in Delta Lake, Apache Iceberg™, Apache Spark™, MLflow, Unity Catalog, Lakeflow, Databricks Apps, Databricks SQL and Lakebase — alongside agentic AI systems, AI/BI and open source frameworks such as DSPy, LangChain, PyTorch, dbt and Trino.\u003c/p\u003e"}],"field_header_tag":"h3","field_image":[{"url":"https://microsites.databricks.com/sites/default/files/2026-01/dais24-photography-241%201.jpg","alt":"DAIS24","title":"","width":"375","height":"224"}],"field_media_image":[{"url":"https://microsites.databricks.com/sites/default/files/2023-06/DAIS-Black-Cluster06-D-Square%202.svg","alt":"specialevents-image-heroleft","title":"","width":"960","height":"740"}],"field_title":"Discover the Latest Technologies","field_title_super":"learn"},{"id":"8807","uuid":"6de0f163-fcea-4166-9a84-10b57935bc68","type":"card","revision_id":"150049","field_body":[{"value":"\u003cp\u003eInteract with thousands of your peers from the data and AI community, and grow your professional network through social meetups, the Expo and exclusive event parties.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eInteract with thousands of your peers from the data and AI community, and grow your professional network through social meetups, the Expo and exclusive event parties.\u003c/p\u003e"}],"field_header_tag":"h3","field_image":[{"url":"https://microsites.databricks.com/sites/default/files/2026-01/dais24-photography-680_1_1.png","alt":"DAIS 25","title":"","width":"376","height":"224"}],"field_title":"Make Meaningful Connections","field_title_super":"NETWORK"},{"id":"8808","uuid":"72b08580-8a2a-4472-96f3-83fc2de3b446","type":"card","revision_id":"150050","field_body":[{"value":"\u003cp\u003eSharpen your expertise with instructor-led, half-day training. Boost your credentials with our hands-on, lab-based format and get onsite certifications.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eSharpen your expertise with instructor-led, half-day training. Boost your credentials with our hands-on, lab-based format and get onsite certifications.\u003c/p\u003e"}],"field_header_tag":"h3","field_image":[{"url":"https://microsites.databricks.com/sites/default/files/2026-01/dais24-photography-294_1.png","alt":"DAIS 25","title":"","width":"376","height":"224"}],"field_title":"Access Training and Certification","field_title_super":"LEVEL UP YOUR SKILLS"}]}]}],"field_sticky":"1","field_title":"Why Attend"},{"id":"8802","uuid":"a1f77587-6258-46a1-993d-d23298539c7d","type":"sidebar_container","revision_id":"182366","field_cta_group":[{"id":"8796","uuid":"6e86e55b-f2ac-452f-8965-2b5de3d787f2","type":"cta_group","revision_id":"182358","field_cta_group_align_items":"flex-start","field_cta_group_direction":"row","field_paragraphs":[{"id":"8795","uuid":"a538fd5d-1140-4311-a339-4954717beb9f","type":"cta","revision_id":"131313","field_cta":[{"url":"/faq","title":"See full list"}],"field_cta_size":"regular","field_cta_style":"plain"}]}],"field_dark":"0","field_header_size":"default","field_padding_bottom":"default","field_padding_top":"default","field_paragraphs":[{"id":"8801","uuid":"c35fd09b-9876-4bb5-9361-b39b4d9ce6d8","type":"sidebar_container_item","revision_id":"182365","field_paragraphs":[{"id":"8800","uuid":"660c1546-bbeb-4724-a9df-8349b9d8b82e","type":"accordion_section","revision_id":"182364","field_accordion_items":[{"id":"8797","uuid":"31f9e38b-41fa-4e84-9ae2-0a649347d487","type":"accordion_item","revision_id":"182359","field_body":[{"value":"\u003cp\u003eAI/machine learning engineers, data scientists, data engineers and practitioners, app developers, database administrators, business executives, IT decision-makers, product managers, entrepreneurs, investors and more.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eAI/machine learning engineers, data scientists, data engineers and practitioners, app developers, database administrators, business executives, IT decision-makers, product managers, entrepreneurs, investors and more.\u003c/p\u003e"}],"field_header_tag":"h3","field_title":"Who should attend Data + AI Summit?"},{"id":"8798","uuid":"09c39997-6a8b-42fc-843a-78887fb9bbf5","type":"accordion_item","revision_id":"182360","field_body":[{"value":"\u003cp\u003eThe premier event for the global data, analytics and AI community. Summit brings together data practitioners, leaders and visionaries from more than 160 countries to explore the latest technologies and trends. Attendees can also participate in conference training and brand-new certification courses.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eThe premier event for the global data, analytics and AI community. Summit brings together data practitioners, leaders and visionaries from more than 160 countries to explore the latest technologies and trends. Attendees can also participate in conference training and brand-new certification courses.\u003c/p\u003e"}],"field_header_tag":"h3","field_title":"What is Data + AI Summit?"},{"id":"8799","uuid":"1c4faa2c-6c7c-4f49-8f3b-24a882c3a063","type":"accordion_item","revision_id":"182361","field_body":[{"value":"\u003cp\u003eThe conference will take place at Moscone North, West and South (the address is 747 Howard Street, San Francisco, CA 94103). Some events and activities may be a short walking distance from Moscone.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eThe conference will take place at Moscone North, West and South (the address is 747 Howard Street, San Francisco, CA 94103). Some events and activities may be a short walking distance from Moscone.\u003c/p\u003e"}],"field_header_tag":"h3","field_title":"Where will Data + AI Summit 2027 be held?"},{"id":"9078","uuid":"686e0da1-ad9f-4e16-b61c-dd2f241f2816","type":"accordion_item","revision_id":"182362","field_body":[{"value":"\u003cp\u003eWe’ve partnered with several hotels in San Francisco offering special group rates for attendees. Book through the Data + AI Summit registration page to receive the event rate (subject to availability). See the list of recommended \u003cu\u003e\u003ca href=\"/travel\"\u003ehotels\u003c/a\u003e\u003c/u\u003e, all conveniently located near Moscone Center. Due to the World Cup being hosted nearby, we recommend you book your hotel early.\u003c/p\u003e\r\n","format":"full_html","processed":"\u003cp\u003eWe’ve partnered with several hotels in San Francisco offering special group rates for attendees. Book through the Data + AI Summit registration page to receive the event rate (subject to availability). See the list of recommended \u003cu\u003e\u003ca href=\"/travel\"\u003ehotels\u003c/a\u003e\u003c/u\u003e, all conveniently located near Moscone Center. Due to the World Cup being hosted nearby, we recommend you book your hotel early.\u003c/p\u003e\n"}],"field_header_tag":"h3","field_title":"Where should I stay for the event? "},{"id":"9079","uuid":"bd73ed65-302e-44b6-9591-246182384235","type":"accordion_item","revision_id":"182363","field_body":[{"value":"\u003cp\u003eThe full conference all-access pass will include keynotes, Expo, breakout sessions, networking events and virtual access.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eThe full conference all-access pass will include keynotes, Expo, breakout sessions, networking events and virtual access.\u003c/p\u003e"}],"field_header_tag":"h3","field_title":"What is included in the full conference all-access pass?"}],"field_accordion_variant":"Large","field_header_tag":"h2"}]}],"field_sticky":"1","field_title":"FAQ"},{"id":"8803","uuid":"2d8e5fe7-ffd9-478a-9bfe-6dbc3e1d38c2","type":"horizontal_divider","revision_id":"182367","field_padding_bottom":"default","field_padding_top":"default"},{"id":"9101","uuid":"7add92c7-7b79-449a-850d-a380ab6d148a","type":"sponsors","revision_id":"182369","field_body":[{"value":"\u003cp\u003eData + AI Summit couldn’t happen without our awesome sponsors. Interested in sponsoring? Reach out to our Sponsorship Management team to learn about available opportunities.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eData + AI Summit couldn’t happen without our awesome sponsors. Interested in sponsoring? Reach out to our Sponsorship Management team to learn about available opportunities.\u003c/p\u003e"}],"field_cta_group":[{"id":"9100","uuid":"976ba643-3054-4db7-8878-26966da1868c","type":"cta_group","revision_id":"182368","field_cta_group_align_items":"flex-start","field_cta_group_direction":"row","field_paragraphs":[{"id":"9099","uuid":"f3078f1a-1973-43ba-916e-dce1a1cd8fa3","type":"cta","revision_id":"133744","field_cta":[{"url":"https://dataaisummit.databricks.com/flow/db/dais2026/sponsors/page/catalog","title":"SEE ALL SPONSORS"}],"field_cta_size":"regular","field_cta_style":"purple"}]}],"field_header_size":"default","field_images":[{"url":"https://microsites.databricks.com/sites/default/files/2026-04/logo-black-accenture.svg","alt":"accenture","title":"","width":null,"height":null},{"url":"https://microsites.databricks.com/sites/default/files/2026-04/logo-black-aws.svg","alt":"aws","title":"","width":null,"height":null},{"url":"https://microsites.databricks.com/sites/default/files/2026-02/capital-one-software.svg","alt":"Capital One Software","title":"","width":null,"height":null},{"url":"https://microsites.databricks.com/sites/default/files/2025-02/deloitte.svg","alt":"deloitte logo","title":"","width":"166","height":"45"},{"url":"https://microsites.databricks.com/sites/default/files/2025-04/ey.svg","alt":"EY logo","title":"","width":"68","height":"69"},{"url":"https://microsites.databricks.com/sites/default/files/2025-02/fivetran.svg","alt":"fivetran logo","title":"","width":"160","height":"45"},{"url":"https://microsites.databrick