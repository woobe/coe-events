,{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"content_translation_source":"und","content_translation_outdated":false,"content_translation_status":true,"content_translation_created":"2026-01-10T15:54:53+00:00","content_translation_uid":null,"relationshipNames":["content_translation_uid"]}]},{"type":"menu_link_content--menu_link_content","id":"menu_link_content:2c3ef4b7-e429-4fe8-bf84-2a951cc29b04","description":null,"enabled":true,"expanded":false,"menu_name":"data-ai-summit-2026","meta":{"entity_id":"141"},"options":{"external":true},"parent":"","provider":"menu_link_content","route":{"name":"","parameters":[]},"title":"Sponsors","url":"https://dataaisummit.databricks.com/flow/db/dais2026/sponsors/page/catalog","weight":0,"langcode":"en","changed":"2026-04-15T17:01:03+00:00","metatag":[{"tag":"meta","attributes":{"name":"title","content":"| Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/jsonapi/menu_items/data-ai-summit-2026"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en_US"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"content_translation_source":"und","content_translation_outdated":false,"content_translation_status":true,"content_translation_created":"2026-01-10T15:49:25+00:00","content_translation_uid":null,"relationshipNames":["content_translation_uid"]}],"homeSessions":[{"type":"node--dataaisummit2026_agenda_item","id":"0dc8c3aa-168b-4cce-aa29-311b1f229747","drupal_internal__nid":17767,"drupal_internal__vid":29454,"langcode":"en","revision_timestamp":"2026-11-06T21:45:36+00:00","status":true,"title":"AI Agents for the Frontline: 7-Eleven’s GenAI Maintenance Assistant","created":"2026-02-11T01:15:19+00:00","changed":"2026-11-06T21:45:30+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"AI Agents for the Frontline: 7-Eleven’s GenAI Maintenance Assistant | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026agendaitem/ai-agents-frontline-7-elevens-genai-maintenance-assistant"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026agendaitem/ai-agents-frontline-7-elevens-genai-maintenance-assistant"}},{"tag":"meta","attributes":{"property":"og:title","content":"AI Agents for the Frontline: 7-Eleven’s GenAI Maintenance Assistant | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026agendaitem/ai-agents-frontline-7-elevens-genai-maintenance-assistant","pid":17794,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_agenda_body":{"value":"\u003cp\u003eMaintenance technicians at 7-Eleven rely on preventive maintenance, catalogue and parts documents for equipment like HVACs and ovens — often using only their phones. These documents span thousands of files in formats like PDFs and spreadsheets stored in shared drives, making it hard to find the right information quickly. High attrition and missed training sessions compounds knowledge gaps. To address this, 7-Eleven developed a GenAI agentic system using Mosaic AI, Agent Bricks and Databricks Hybrid Search that enables technicians to 1) Retrieve relevant maintenance documents with concise answers 2) Capture equipment images and receive troubleshooting solutions 3) Access parts information by equipment brand 4) Get solutions from the internet. This chatbot bridges knowledge gaps with instant access to institutional knowledge. We will walk through how we built this system, our evaluation methodologies and the three-step prompt framework including guardrails for safe internet searches.\u003c/p\u003e\u003cbr /\u003e\n","format":"basic_html","processed":"\u003cp\u003eMaintenance technicians at 7-Eleven rely on preventive maintenance, catalogue and parts documents for equipment like HVACs and ovens — often using only their phones. These documents span thousands of files in formats like PDFs and spreadsheets stored in shared drives, making it hard to find the right information quickly. High attrition and missed training sessions compounds knowledge gaps. To address this, 7-Eleven developed a GenAI agentic system using Mosaic AI, Agent Bricks and Databricks Hybrid Search that enables technicians to 1) Retrieve relevant maintenance documents with concise answers 2) Capture equipment images and receive troubleshooting solutions 3) Access parts information by equipment brand 4) Get solutions from the internet. This chatbot bridges knowledge gaps with instant access to institutional knowledge. We will walk through how we built this system, our evaluation methodologies and the three-step prompt framework including guardrails for safe internet searches.\u003c/p\u003e\u003cbr\u003e"},"field_agenda_code_id":"D26B1508","field_agenda_duration":"40","field_agenda_ends":"2026-06-16T19:10:00+00:00","field_agenda_starts":"2026-06-16T18:30:00+00:00","field_agenda_unique_id":"1770018587845001TiLl","field_metatags":null,"field_price":null,"field_slides_url":"https://microsites.databricks.com/sites/default/files/dais/2026/D26B1508.pdf","field_video_chunks":[],"field_video_transcript":null,"field_video_url":"https://cdnapisec.kaltura.com/p/6501692/embedPlaykitJs/uiconf_id/57932942?autoembed=true\u0026targetId=kaltura_player_822453946\u0026entry_id=1_kzkz9m24","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/0dc8c3aa-168b-4cce-aa29-311b1f229747?resourceVersion=id%3A29454"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/0dc8c3aa-168b-4cce-aa29-311b1f229747?resourceVersion=rel%3Aworking-copy"}},"node_type":{"type":"node_type--node_type","id":"02af01b1-e063-4d57-a525-a7a8f2f9b968","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_agenda_item"}},"revision_uid":null,"uid":null,"field_agenda_category":[{"type":"taxonomy_term--dataaisummit_agenda_category","id":"45101628-cc08-4890-9077-6124dc23dd96","drupal_internal__tid":2024,"drupal_internal__revision_id":2024,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"AI/BI","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"AI/BI | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2024"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en_US"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content