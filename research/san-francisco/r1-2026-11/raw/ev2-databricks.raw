_term--dataaisummit_areas_of_interest","id":"ab552e41-ce9f-4e43-a74b-96c62dcc352c","resourceIdObjMeta":{"drupal_internal__target_id":2061}}],"field_content":[{"type":"paragraph--full_summary","id":"9d497c20-8eff-4bae-aa7a-72329dc9b506","resourceIdObjMeta":{"target_revision_id":184437,"drupal_internal__target_id":12272}},{"type":"paragraph--accordion_section","id":"7452898f-3351-49f7-b52f-d71a4a89eaf7","resourceIdObjMeta":{"target_revision_id":184443,"drupal_internal__target_id":12278}}],"field_session_sub_category":{"type":"taxonomy_term--dataaisummit_session_sub_cat","id":"90f7ba42-d2d0-41f7-aa83-f9405b2cda5f","resourceIdObjMeta":{"drupal_internal__target_id":2031}},"field_slides":[],"relationshipNames":["node_type","revision_uid","uid","field_agenda_category","field_agenda_delivery","field_agenda_event_type","field_agenda_industry","field_agenda_level","field_agenda_room","field_agenda_speakers","field_agenda_track","field_areas_of_interest","field_content","field_session_sub_category","field_slides"]},{"type":"node--dataaisummit2026_agenda_item","id":"8212bcd4-4803-4aa0-a314-f329511511e5","drupal_internal__nid":17770,"drupal_internal__vid":29445,"langcode":"en","revision_timestamp":"2026-11-06T21:45:32+00:00","status":true,"title":"Beyond the Trace: adidas’ Agent Digital Twin for Governance, Cost and ROI","created":"2026-02-11T01:15:19+00:00","changed":"2026-11-06T21:45:30+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Beyond the Trace: adidas’ Agent Digital Twin for Governance, Cost and ROI | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026agendaitem/beyond-trace-adidas-agent-digital-twin-governance-cost-and-roi"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026agendaitem/beyond-trace-adidas-agent-digital-twin-governance-cost-and-roi"}},{"tag":"meta","attributes":{"property":"og:title","content":"Beyond the Trace: adidas’ Agent Digital Twin for Governance, Cost and ROI | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026agendaitem/beyond-trace-adidas-agent-digital-twin-governance-cost-and-roi","pid":17797,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_agenda_body":{"value":"\u003cp\u003eYour agent answered but can you prove why, what it cost, and what breaks when a tool or prompt changes? AI spend is forecast near $1.5T in 2025 and GenAI at $644B, yet Gartner predicts \u003e40% of agentic AI projects will be canceled by end-2027 as costs rise and controls lag. At adidas (200+ serving endpoints, 300+ data and AI products, 6k+ registered models, 600k+ pipeline runs), we go beyond per-run traces to an agent digital twin: A lakehouse control plane mapping agent → tool → prompt → retrieval → model call → post-processing, then rolling up risk, quality and unit economics across a fleet. You’ll see a Databricks pattern with MLflow Tracing, Unity Catalog + system tables for audit evidence and DBU/cost signals, plus eval/optimization loops with governance guardrails.\u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cp\u003e \u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cp\u003eKey highlights:\u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cul\u003e\u003cbr /\u003e\n\t\u003cli\u003eDigital-twin control plane for fleets\u003c/li\u003e\u003cbr /\u003e\n\t\u003cli\u003ePer-hop unit economics + cost leak forensics\u003c/li\u003e\u003cbr /\u003e\n\t\u003cli\u003eContinuous audit evidence by design\u003c/li\u003e\u003cbr /\u003e\n\t\u003cli\u003eROI attribution by agent behavior\u003c/li\u003e\u003cbr /\u003e\n\u003c/ul\u003e\u003cbr /\u003e\n","format":"basic_html","processed":"\u003cp\u003eYour agent answered but can you prove why, what it cost, and what breaks when a tool or prompt changes? AI spend is forecast near $1.5T in 2025 and GenAI at $644B, yet Gartner predicts \u0026gt;40% of agentic AI projects will be canceled by end-2027 as costs rise and controls lag. At adidas (200+ serving endpoints, 300+ data and AI products, 6k+ registered models, 600k+ pipeline runs), we go beyond per-run traces to an agent digital twin: A lakehouse control plane mapping agent → tool → prompt → retrieval → model call → post-processing, then rolling up risk, quality and unit economics across a fleet. You’ll see a Databricks pattern with MLflow Tracing, Unity Catalog + system tables for audit evidence and DBU/cost signals, plus eval/optimization loops with governance guardrails.\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cp\u003eKey highlights:\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cul\u003e\u003cbr\u003e\n\t\u003cli\u003eDigital-twin control plane for fleets\u003c/li\u003e\u003cbr\u003e\n\t\u003cli\u003ePer-hop unit economics + cost leak forensics\u003c/li\u003e\u003cbr\u003e\n\t\u003cli\u003eContinuous audit evidence by design\u003c/li\u003e\u003cbr\u003e\n\t\u003cli\u003eROI attribution by agent behavior\u003c/li\u003e\u003cbr\u003e\n\u003c/ul\u003e\u003cbr\u003e"},"field_agenda_code_id":"D26B1598","field_agenda_duration":"40","field_agenda_ends":"2026-06-16T19:10:00+00:00","field_agenda_starts":"2026-06-16T18:30:00+00:00","field_agenda_unique_id":"1770216370308001El1b","field_metatags":null,"fie