tent_translation_uid"]},"field_agenda_speakers":[{"type":"node--dataaisummit2026_speaker","id":"a9d7eef1-9a69-488c-88f0-2b1d598d7dae","title":"Harshit Mishra","field_speaker_company":"Nationwide Insurance","field_speaker_job_title":"Data Engineer Lead","drupal_internal__nid":17747,"drupal_internal__vid":25383,"langcode":"en","revision_timestamp":"2026-02-10T23:15:19+00:00","status":true,"created":"2026-02-10T23:15:19+00:00","changed":"2026-08-05T17:15:24+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Harshit Mishra | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026speaker/harshit-mishra"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026speaker/harshit-mishra"}},{"tag":"meta","attributes":{"property":"og:title","content":"Harshit Mishra | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026speaker/harshit-mishra","pid":17774,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_headline":null,"field_import_hash":"6a5293ca4d31c2b92802da0004cb925b5a276fe29ace04ab3541d49f003adf8f4d0091ff78e4dfcf43cd1f18daeeafd02c25cd3c5ca7c74d5381a51fb1365930","field_metatags":null,"field_speaker_bio":{"value":"Harshit Mishra\u003cbr /\u003e\nPrincipal Data Engineer\u003cbr /\u003e\nNationwide Insurance – P\u0026C Data Organization\u003cbr /\u003e\n\u003cbr /\u003e\n15+ years of experience working across diverse data projects and technologies.\u003cbr /\u003e\n6+ years of expertise with Databricks, focusing on building data pipelines, managing Databricks infrastructure and implementing standards and best practices.\u003cbr /\u003e\nCurrently serving as a Principal Data Engineer, leading the Data Enablement Team in the Nationwide P\u0026C Data Organization.\u003cbr /\u003e\nPassionate about driving data modernization, efficiency, and delivering business value through innovative data solutions.\u003cbr /\u003e\n","format":"basic_html","processed":"Harshit Mishra\u003cbr\u003e\nPrincipal Data Engineer\u003cbr\u003e\nNationwide Insurance – P\u0026amp;C Data Organization\u003cbr\u003e\n\u003cbr\u003e\n15+ years of experience working across diverse data projects and technologies.\u003cbr\u003e\n6+ years of expertise with Databricks, focusing on building data pipelines, managing Databricks infrastructure and implementing standards and best practices.\u003cbr\u003e\nCurrently serving as a Principal Data Engineer, leading the Data Enablement Team in the Nationwide P\u0026amp;C Data Organization.\u003cbr\u003e\nPassionate about driving data modernization, efficiency, and delivering business value through innovative data solutions.\u003cbr\u003e"},"field_speaker_first_name":"Harshit","field_speaker_last_name":"Mishra","field_speaker_unique_id":"1654551243760001AKBJ_176365898538dais2026","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/a9d7eef1-9a69-488c-88f0-2b1d598d7dae?resourceVersion=id%3A25383"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/a9d7eef1-9a69-488c-88f0-2b1d598d7dae?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":17747},"node_type":{"type":"node_type--node_type","id":"4a4790a8-5e3c-45d2-8f0f-ffb0a609a5db","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_speaker"}},"revision_uid":null,"uid":null,"field_media_image":null,"field_speaker_image":{"type":"file--file","id":"280800f1-2b9b-4067-ad6b-b8f77cb7f963","resourceIdObjMeta":{"alt":"Harshit Mishra","title":"Harshit Mishra","width":684,"height":682,"drupal_internal__target_id":5298}},"relationshipNames":["node_type","revision_uid","uid","field_media_image","field_speaker_image"]}],"field_agenda_track":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"66783aa9-1610-4485-a574-c1400298f698","drupal_internal__tid":2068,"drupal_internal__revision_id":2068,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"Application Development","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Application Development | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2068"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en_US"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":null,"pid":null,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"content_translation_created":"2026-04-14T20:59:45+00:00","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/taxonomy_term/dataaisummit_agenda_track/66783aa9-1610-4485-a574-c1400298f698?resourceVersion=id%3A2068"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/taxonomy_term/dataaisummit_agenda_track/66783aa9-1610-4485-a574-c1400298f698?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":2068},"vid":{"type":"taxonomy_vocabulary--taxonomy_vocabulary","id":"143091c9-ad85-4cf5-86e7-e229c84fcdd0","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit_agenda_track"}},"revision_user":null,"parent":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"virtual","resourceIdObjMeta":{"links":{"help":{"href":"https://www.drupal.org/docs/8/modules/json-api/core-concepts#virtual","meta":{"about":"Usage and meaning of the 'virtual' resource identifier."}}}}}],"content_translation_uid":null,"relationshipNames":["vid","revision_user","parent","content_translation_uid"]}],"field_areas_of_interest":[{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"079fc596-ffb7-4bc9-a3c2-5a71ea8a9a9c","resourceIdObjMeta":{"drupal_internal__target_id":2069}},{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"dc6aa70e-ad16-40e4-8dfa-e0fd5e78a5ed","resourceIdObjMeta":{"drupal_internal__target_id":2030}}],"field_content":[],"field_session_sub_category":{"type":"taxonomy_term--dataaisummit_session_sub_cat","id":"90f7ba42-d2d0-41f7-aa83-f9405b2cda5f","resourceIdObjMeta":{"drupal_internal__target_id":2031}},"field_slides":[],"relationshipNames":["node_type","revision_uid","uid","field_agenda_category","field_agenda_delivery","field_agenda_event_type","field_agenda_industry","field_agenda_level","field_agenda_room","field_agenda_speakers","field_agenda_track","field_areas_of_interest","field_content","field_session_sub_category","field_slides"]},{"type":"node--dataaisummit2026_agenda_item","id":"243171c3-1dcc-4929-8dc3-2b7886951d1d","drupal_internal__nid":17787,"drupal_internal__vid":29384,"langcode":"en","revision_timestamp":"2026-10-13T13:34:00+00:00","status":true,"title":"What Worked, What Didn’t: Virgin Atlantic’s Flight to Trusted Generative BI","created":"2026-02-11T02:15:19+00:00","changed":"2026-10-13T13:34:00+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"What Worked, What Didn’t: Virgin Atlantic’s Flight to Trusted Generative BI | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026agendaitem/what-worked-what-didnt-virgin-atlantics-flight-trusted-generative-bi"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026agendaitem/what-worked-what-didnt-virgin-atlantics-flight-trusted-generative-bi"}},{"tag":"meta","attributes":{"property":"og:title","content":"What Worked, What Didn’t: Virgin Atlantic’s Flight to Trusted Generative BI | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026agendaitem/what-worked-what-didnt-virgin-atlantics-flight-trusted-generative-bi","pid":17814,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_agenda_body":{"value":"\u003cp\u003eAs decision-making at Virgin Atlantic sped up, our BI stack creaked. Leaders wanted answers in hours and questions increasingly cut across commercial, operational, and customer data. Like many teams, we turned to GenBI to close that gap.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eOur first attempt didn’t go well. Answers arrived faster, but confidence dropped. Without shared metric definitions, visible lineage, or governance designed in from the start, ambiguity scaled faster than trust. “Is this right?” became the default question again.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eIn this session, we share how we rebuilt GenBI on trusted foundations using Databricks. We’ll show how Unity Catalog and UC Metrics Views anchor AI answers to signed-off metrics, how Databricks Genie enables users to interrogate and explain results, and why explainability became part of the user experience.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\r\n\r\n\u003cp\u003eAttendees will leave with practical lessons for moving to decision-grade GenBI, drawn from real production use cases and delivered as a visual, story-led case study.\u003c/p\u003e\r\n","format":"basic_html","processed":"\u003cp\u003eAs decision-making at Virgin Atlantic sped up, our BI stack creaked. Leaders wanted answers in hours and questions increasingly cut across commercial, operational, and customer data. Like many teams, we turned to GenBI to close that gap.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eOur first attempt didn’t go well. Answers arrived faster, but confidence dropped. Without shared metric definitions, visible lineage, or governance designed in from the start, ambiguity scaled faster than trust. “Is this right?” became the default question again.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eIn this session, we share how we rebuilt GenBI on trusted foundations using Databricks. We’ll show how Unity Catalog and UC Metrics Views anchor AI answers to signed-off metrics, how Databricks Genie enables users to interrogate and explain results, and why explainability became part of the user experience.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAttendees will leave with practical lessons for moving to decision-grade GenBI, drawn from real production use cases and delivered as a visual, story-led case study.\u003c/p\u003e"},"field_agenda_code_id":"D26B1686","field_agenda_duration":"40","field_agenda_ends":"2026-06-17T22:40:00+00:00","field_agenda_starts":"2026-06-17T22:00:00+00:00","field_agenda_unique_id":"1770375058767001Pla6","field_metatags":null,"field_price":null,"field_slides_url":"https://microsites.databricks.com/sites/default/files/dais/2026/D26B1686.pdf","field_video_chunks":[],"field_video_transcript":null,"field_video_url":"https://cdnapisec.kaltura.com/p/6501692/embedPlaykitJs/uiconf_id/57932942?autoembed=true\u0026targetId=kaltura_player_1_orzymrgp\u0026entry_id=1_orzymrgp","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/243171c3-1dcc-4929-8dc3-2b7886951d1d?resourceVersion=id%3A29384"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/243171c3-1dcc-4929-8dc3-2b7886951d1d?resourceVersion=rel%3Aworking-copy"}},"node_type":{"type":"node_type--node_type","id":"02af01b1-e063-4d57-a525-a7a8f2f9b968","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_agenda_item"}},"revision_uid":null,"uid":null,"field_agenda_category":[{"type":"taxonomy_term--dataaisummit_agenda_category","id":"45101628-cc08-4890-9077-6124dc23dd96","drupal_internal__tid":2024,"drupal_internal__revision_id":2024,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"AI/BI","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"AI/BI | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2024"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/site