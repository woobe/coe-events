4+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Mahavir Teraiya | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026speaker/mahavir-teraiya"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026speaker/mahavir-teraiya"}},{"tag":"meta","attributes":{"property":"og:title","content":"Mahavir Teraiya | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026speaker/mahavir-teraiya","pid":17784,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_headline":null,"field_import_hash":"9056c0d41ea5203417f759d0f08ffb6a7f04008bb40399d0b2a6672eab3d54b3033c5c6911e15012b5f9758fd7e116ce77d4f517ca7921a67de2e9fac447828e","field_metatags":null,"field_speaker_bio":{"value":"Mahavir Teraiya is a Senior Resident Solutions Architect at Databricks with 15+ years of experience in Data, ML, and large-scale AI platform design. Formerly with AWS and Zalando, he now focuses on helping enterprise customers scale GenAI through agentic workflows. At DAIS, Mahavir will present the groundbreaking GenAI platform built with Adidas the first of its kind in EMEA driving 20% productivity gains and up to 91% cost savings. He is currently pursuing a PhD in Federated Learning and an MBA in IT. A passionate technologist and frequent speaker at AWS events and GopherCon, Mahavir thrives at the intersection of cutting-edge tech and business value.","format":"basic_html","processed":"Mahavir Teraiya is a Senior Resident Solutions Architect at Databricks with 15+ years of experience in Data, ML, and large-scale AI platform design. Formerly with AWS and Zalando, he now focuses on helping enterprise customers scale GenAI through agentic workflows. At DAIS, Mahavir will present the groundbreaking GenAI platform built with Adidas the first of its kind in EMEA driving 20% productivity gains and up to 91% cost savings. He is currently pursuing a PhD in Federated Learning and an MBA in IT. A passionate technologist and frequent speaker at AWS events and GopherCon, Mahavir thrives at the intersection of cutting-edge tech and business value."},"field_speaker_first_name":"Mahavir","field_speaker_last_name":"Teraiya","field_speaker_unique_id":"1736855656393001Lxh4_176365898538dais2026","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/9b3d58aa-3fa2-43b1-bd90-1cfe12d57a10?resourceVersion=id%3A25393"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/9b3d58aa-3fa2-43b1-bd90-1cfe12d57a10?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":17757},"node_type":{"type":"node_type--node_type","id":"4a4790a8-5e3c-45d2-8f0f-ffb0a609a5db","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_speaker"}},"revision_uid":null,"uid":null,"field_media_image":null,"field_speaker_image":{"type":"file--file","id":"312979f8-1a67-4742-9bc1-83918132949f","resourceIdObjMeta":{"alt":"Mahavir Teraiya","title":"Mahavir Teraiya","width":300,"height":300,"drupal_internal__target_id":5418}},"relationshipNames":["node_type","revision_uid","uid","field_media_image","field_speaker_image"]},{"type":"node--dataaisummit2026_speaker","id":"4f83ee6e-343f-4f65-8c6d-0fa19d0614b8","title":"Pandey, Rahul","field_speaker_company":"adidas","field_speaker_job_title":"Senior Solution Architect","drupal_internal__nid":17756,"drupal_internal__vid":25392,"langcode":"en","revision_timestamp":"2026-02-11T01:15:19+00:00","status":true,"created":"2026-02-11T01:15:19+00:00","changed":"2026-08-05T17:15:24+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Pandey, Rahul | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026speaker/pandey-rahul"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026speaker/pandey-rahul"}},{"tag":"meta","attributes":{"property":"og:title","content":"Pandey, Rahul | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026speaker/pandey-rahul","pid":17783,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_headline":null,"field_import_hash":"1b81b5afc5ba55edb8281a8f9aad2d6a29d496d183e95312350488340755fe76b4186e6179f51705821eb2cc32ee6f50d34393bb8e753493f35f54e29290aced","field_metatags":null,"field_speaker_bio":{"value":"Rahul is a Senior Solution Architect at Adidas, where he focuses on constructing ML architecture designs that are both cost-effective and efficient. Currently, he is taking responsibility as a Machine Learning Journey Owner in the Lakehouse platform, taking charge of advancing the field of machine learning. One of his primary motivations is to promote awareness of sustainability in AI among Data Science teams","format":"basic_html","processed":"Rahul is a Senior Solution Architect at Adidas, where he focuses on constructing ML architecture designs that are both cost-effective and efficient. Currently, he is taking responsibility as a Machine Learning Journey Owner in the Lakehouse platform, taking charge of advancing the field of machine learning. One of his primary motivations is to promote awareness of sustainability in AI among Data Science teams"},"field_speaker_first_name":"Pandey,","field_speaker_last_name":"Rahul","field_speaker_unique_id":"1673628265860001uwUr_176365898538dais2026","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/4f83ee6e-343f-4f65-8c6d-0fa19d0614b8?resourceVersion=id%3A25392"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/4f83ee6e-343f-4f65-8c6d-0fa19d0614b8?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":17756},"node_type":{"type":"node_type--node_type","id":"4a4790a8-5e3c-45d2-8f0f-ffb0a609a5db","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_speaker"}},"revision_uid":null,"uid":null,"field_media_image":null,"field_speaker_image":{"type":"file--file","id":"692d8a73-2eee-4df7-a1c4-a7304117c228","resourceIdObjMeta":{"alt":"Pandey, Rahul","title":"Pandey, Rahul","width":1112,"height":1113,"drupal_internal__target_id":6188}},"relationshipNames":["node_type","revision_uid","uid","field_media_image","field_speaker_image"]}],"field_agenda_track":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"4388f357-1cb8-4a3c-ae63-640532d15bc9","drupal_internal__tid":2032,"drupal_internal__revision_id":2032,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"Artificial Intelligence \u0026 Agents","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Artificial Intelligence \u0026 Agents | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2032"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en_US"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":null,"pid":null,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"content_translation_created":"2026-04-14T20:59:45+00:00","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/taxonomy_term/dataaisummit_agenda_track/4388f357-1cb8-4a3c-ae63-640532d15bc9?resourceVersion=id%3A2032"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/taxonomy_term/dataaisummit_agenda_track/4388f357-1cb8-4a3c-ae63-640532d15bc9?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":2032},"vid":{"type":"taxonomy_vocabulary--taxonomy_vocabulary","id":"143091c9-ad85-4cf5-86e7-e229c84fcdd0","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit_agenda_track"}},"revision_user":null,"parent":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"virtual","resourceIdObjMeta":{"links":{"help":{"href":"https://www.drupal.org/docs/8/modules/json-api/core-concepts#virtual","meta":{"about":"Usage and meaning of the 'virtual' resource identifier."}}}}}],"content_translation_uid":null,"relationshipNames":["vid","revision_user","parent","content_translation_uid"]}],"field_areas_of_interest":[{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"11d2750d-b60d-4939-ab4c-81854fd96889","resourceIdObjMeta":{"drupal_internal__target_id":2033}},{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"4fbf1e51-149a-444a-bf47-5546ca31f286","resourceIdObjMeta":{"drupal_internal__target_id":2048}},{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"7797f941-3c51-4028-953d-32639abc8f10","resourceIdObjMeta":{"drupal_internal__target_id":2073}}],"field_content":[{"type":"paragraph--full_summary","id":"47e35c50-d1fb-407c-b232-2244f3465423","resourceIdObjMeta":{"target_revision_id":184374,"drupal_internal__target_id":12209}},{"type":"paragraph--accordion_section","id":"deeb95ec-2d7f-4fc0-8719-1f91d091bb93","resourceIdObjMeta":{"target_revision_id":184380,"drupal_internal__target_id":12215}}],"field_session_sub_category":{"type":"taxonomy_term--dataaisummit_session_sub_cat","id":"90f7ba42-d2d0-41f7-aa83-f9405b2cda5f","resourceIdObjMeta":{"drupal_internal__target_id":2031}},"field_slides":[],"relationshipNames":["node_type","revision_uid","uid","field_agenda_category","field_agenda_delivery","field_agenda_event_type","field_agenda_industry","field_agenda_level","field_agenda_room","field_agenda_speakers","field_agenda_track","field_areas_of_interest","field_content","field_session_sub_category","field_slides"]},{"type":"node--dataaisummit2026_agenda_item","id":"b1563832-103c-48d6-ba68-e073497588cd","drupal_internal__nid":17774,"drupal_internal__vid":25410,"langcode":"en","revision_timestamp":"2026-02-11T01:15:19+00:00","status":true,"title":"Building the Commercial Lakehouse: AI-Driven, Open and Interoperable","created":"2026-02-11T01:15:19+00:00","changed":"2026-07-14T17:24:54+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Building the Commercial Lakehouse: AI-Driven, Open and Interoperable | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026agendaitem/building-commercial-lakehouse-ai-driven-open-and-interoperable"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026agendaitem/building-commercial-lakehouse-ai-driven-open-and-interoperable"}},{"tag":"meta","attributes":{"property":"og:title","content":"Building the Commercial Lakehouse: AI-Driven, Open and Interoperable | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026agendaitem/building-commercial-lakehouse-ai-driven-open-and-interoperable","pid":17801,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_agenda_body":{"value":"\u003cp\u003eAstraZeneca modernized its Commercial data estate, transitioning from legacy EMR to a high-performance global commercial lakehouse. At the core lies Unity Catalog (UC), established as the unified governance layer. We demonstrate how UC enables a true open architecture, orchestrating seamless federation for legacy Glue workloads and utilizing Iceberg REST integration to provide zero-copy access for iceberg clients e.g., Snowflake.\u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cp\u003e \u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cp\u003eThe transformation was powered by a multi-agent AI migration system, utilizing LLMs and testing agents to automate the conversion of 250+ pipelines into a rigorous Medallion architecture. Key components include Databricks Asset Bundles for versioned CI/CD, Liquid Clustering for storage optimization.\u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cp\u003e \u003c/p\u003e\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cp\u003eProcessing complex external data sources (Claims, CRM, Digital), this platform delivered 50% cost savings. This session covers the multi-agent migration architecture, UC-centric interoperability design patterns and lessons from modernizing commercial data at scale.\u003c/p\u003e\u003cbr /\u003e\n","format":"basic_html","processed":"\u003cp\u003eAstraZeneca modernized its Commercial data estate, transitioning from legacy EMR to a high-performance global commercial lakehouse. At the core lies Unity Catalog (UC), established as the unified governance layer. We demonstrate how UC enables a true open architecture, orchestrating seamless federation for legacy Glue workloads and utilizing Iceberg REST integration to provide zero-copy access for iceberg clients e.g., Snowflake.\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cp\u003eThe transformation was powered by a multi-agent AI migration system, utilizing LLMs and testing agents to automate the conversion of 250+ pipelines into a rigorous Medallion architecture. Key components include Databricks Asset Bundles for versioned CI/CD, Liquid Clustering for storage optimization.\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cbr\u003e\n\u003cbr\u003e\n\u003cp\u003eProcessing complex external data sources (Claims, CRM, Digital), this platform delivered 50% cost savings. This session covers the multi-agent migration architecture, UC-centric interoperability design patterns and lessons from modernizing commercial data at scale.\u003c/p\u003e\u003cbr\u003e"},"field_agenda_code_id":"D26B1520","field_agenda_duration":"40","field_agenda_ends":"2026-06-16T21:30:00+00:00","field_agenda_starts":"2026-06-16T20:50:00+00:00","field_agenda_unique_id":"1770048333069001cIV5","field_metatags":null,"field_price":null,"field_slides_url":"https://microsites.databricks.com/sites/default/files/dais/2026/D26B1520.pdf","field_video_chunks":[],"field_video_transcript":null,"field_video_url":"https://cdnapisec.kaltura.com/p/6501692/embedPlaykitJs/uiconf_id/57932942?autoembed=true\u0026targetId=kaltura_player_10167439\u0026entry_id=1_rm0yj9m6","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/b1563832-103c-48d6-ba68-e073497588cd?resourceVersion=id%3A25410"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/b1563832-103c-48d6-ba68-e073497588cd?resourceVersion=rel%3Aworking-copy"}},"node_type":{"type":"node_type--node_type","id":"02af01b1-e063-4d57-a525-a7a8f2f9b968","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_agenda_item"}},"revision_uid":null,"uid":null,"field_agenda_category":[{"type":"taxonomy_term--dataaisummit_agenda_category","id":"7feb4123-da0f-4799-bd38-054ffa4a6b4c","drupal_internal__tid":2063,"drupal_internal__revision_id":2063,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"Delta Sharing","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Delta Sharing | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2063"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en_US"}},{"tag":"meta