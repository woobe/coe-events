s.com/dataaisummit2026speaker/sumedh-datar"}},{"tag":"meta","attributes":{"property":"og:title","content":"Sumedh Datar | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026speaker/sumedh-datar","pid":17778,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_headline":null,"field_import_hash":"8ae9026cf7e2c229897206d595fc9a1892c15145bdb3a86e89969f5cf3caa5a4019729330e0f46d8061a1e6df31f583d825965b7945f066ef2dedfc09c2c3541","field_metatags":null,"field_speaker_bio":{"value":"Sumedh is a Staff Engineer - Manager heading GenAI Engineering and Research at 7-Eleven. A pioneer in retail technology, he holds over 40 patents in computer vision and helped develop 7-Eleven’s first cashierless store and \"Quick Checkout\" systems. Recently, he architected a nationwide Generative AI solution for maintenance that improved productivity by 90% and drove over $10 million in cost savings. An avid researcher and reviewer for top-tier AI conferences like ICML and BMVC, Sumedh is a frequent speaker and panelist at global events, where he shares his expertise on transforming retail through cutting-edge AI.","format":"basic_html","processed":"Sumedh is a Staff Engineer - Manager heading GenAI Engineering and Research at 7-Eleven. A pioneer in retail technology, he holds over 40 patents in computer vision and helped develop 7-Eleven’s first cashierless store and \"Quick Checkout\" systems. Recently, he architected a nationwide Generative AI solution for maintenance that improved productivity by 90% and drove over $10 million in cost savings. An avid researcher and reviewer for top-tier AI conferences like ICML and BMVC, Sumedh is a frequent speaker and panelist at global events, where he shares his expertise on transforming retail through cutting-edge AI."},"field_speaker_first_name":"Sumedh","field_speaker_last_name":"Datar","field_speaker_unique_id":"1744323109465001PDVA_176365898538dais2026","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/be332265-cba4-4895-9c0b-bc550fec3e67?resourceVersion=id%3A25387"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/be332265-cba4-4895-9c0b-bc550fec3e67?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":17751},"node_type":{"type":"node_type--node_type","id":"4a4790a8-5e3c-45d2-8f0f-ffb0a609a5db","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_speaker"}},"revision_uid":null,"uid":null,"field_media_image":null,"field_speaker_image":{"type":"file--file","id":"18dd2b51-3044-44ce-9cdd-d2d420a7a267","resourceIdObjMeta":{"alt":"Sumedh Datar","title":"Sumedh Datar","width":1973,"height":1973,"drupal_internal__target_id":6211}},"relationshipNames":["node_type","revision_uid","uid","field_media_image","field_speaker_image"]}],"field_agenda_track":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"4388f357-1cb8-4a3c-ae63-640532d15bc9","drupal_internal__tid":2032,"drupal_internal__revision_id":2032,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"Artificial Intelligence \u0026 Agents","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Artificial Intelligence \u0026 Agents | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2032"}},{"tag":"meta","attributes":{"prop