ision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Alessandro Moro | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026speaker/alessandro-moro"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026speaker/alessandro-moro"}},{"tag":"meta","attributes":{"property":"og:title","content":"Alessandro Moro | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026speaker/alessandro-moro","pid":18224,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_headline":null,"field_import_hash":"78b89325a67c9b57efc1fe31692e50d52a4927da5c27c44229ffad77f34b25cb7af2e1c632c8263c6e260f6fe3e73cf0daf6f28942e12e29a98edca0dd5f4382","field_metatags":null,"field_speaker_bio":{"value":"Alessandro Moro is a Delivery Solutions Architect at Databricks with nearly a decade of experience in Data and AI across highly regulated industries, including Banking and Pharma. Since joining Databricks in 2022, he has helped several enterprises deliver strategic AI use cases and deploy open, interoperable Lakehouse architectures at scale.","format":"basic_html","processed":"Alessandro Moro is a Delivery Solutions Architect at Databricks with nearly a decade of experience in Data and AI across highly regulated industries, including Banking and Pharma. Since joining Databricks in 2022, he has helped several enterprises deliver strategic AI use cases and deploy open, interoperable Lakehouse architectures at scale."},"field_speaker_first_name":"Alessandro","field_speaker_last_name":"Moro","field_speaker_unique_id":"1673646691191001HpeS_176365898538dais2026","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/30f6a840-8b57-4e3b-a31f-acac87a21b5b?resourceVersion=id%3A26187"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/30f6a840-8b57-4e3b-a31f-acac87a21b5b?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":18178},"node_type":{"type":"node_type--node_type","id":"4a4790a8-5e3c-45d2-8f0f-ffb0a609a5db","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_speaker"}},"revision_uid":null,"uid":null,"field_media_image":null,"field_speaker_image":{"type":"file--file","id":"61cdb486-52de-4393-8728-aa8065191db4","resourceIdObjMeta":{"alt":"Alessandro Moro","title":"Alessandro Moro","width":300,"height":300,"drupal_internal__target_id":5411}},"relationshipNames":["node_type","revision_uid","uid","field_media_image","field_speaker_image"]},{"type":"node--dataaisummit2026_speaker","id":"59da99e4-b9fe-41e1-abbd-3ca11a4029fb","title":"Paul Kuntz","field_speaker_company":"AstraZeneca","field_speaker_job_title":"Commercial Data Lake Capability Lead","drupal_internal__nid":17762,"drupal_internal__vid":25398,"langcode":"en","revision_timestamp":"2026-02-11T01:15:19+00:00","status":true,"created":"2026-02-11T01:15:19+00:00","changed":"2026-08-05T17:15:24+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Paul Kuntz | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026speaker/paul-kuntz"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026speaker/paul-kuntz"}},{"tag":"meta","attributes":{"property":"og:title","content":"Paul Kuntz | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026speaker/paul-kuntz","pid":17789,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_headline":null,"field_import_hash":"61f68b502a5d22b108dbb45a0ea2de4b0a872abb8c156712421ff3ee19c1bce151ef0faf3512c3d62f64da96dfce19fa91177bcd96e6935cb303d4ced6844cc3","field_metatags":null,"field_speaker_bio":{"value":"I am a Capability Lead, with 12+ years in banking and 14+ years in the Pharmaceuticals Industry. Currently, I am the Capability Lead for the Commercial Data Lake at AstraZeneca Pharmaceuticals. I have worked in a broad range of IT capacities, from business analyst, database developer, to data warehouse design and information architect, providing a wide range of technical skills: from cloud services, to database platforms, to modern technology like Databricks.\u003cbr /\u003e\nDuring my time at AstraZeneca, I was instrumental in the implementation of our data lake capabilities.  Recently I spear-headed the journey to migrate to Databricks Lakehouse capabilities, leveraging the full compliment of Databricks technologies to evolve our Commercial capabilities. ","format":"basic_html","processed":"I am a Capability Lead, with 12+ years in banking and 14+ years in the Pharmaceuticals Industry. Currently, I am the Capability Lead for the Commercial Data Lake at AstraZeneca Pharmaceuticals. I have worked in a broad range of IT capacities, from business analyst, database developer, to data warehouse design and information architect, providing a wide range of technical skills: from cloud services, to database platforms, to modern technology like Databricks.\u003cbr\u003e\nDuring my time at AstraZeneca, I was instrumental in the implementation of our data lake capabilities.  Recently I spear-headed the journey to migrate to Databricks Lakehouse capabilities, leveraging the full compliment of Databricks technologies to evolve our Commercial capabilities."},"field_speaker_first_name":"Paul","field_speaker_last_name":"Kuntz","field_speaker_unique_id":"1657129989080001V6oo_176365898538dais2026","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/59da99e4-b9fe-41e1-abbd-3ca11a4029fb?resourceVersion=id%3A25398"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_speaker/59da99e4-b9fe-41e1-abbd-3ca11a4029fb?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":17762},"node_type":{"type":"node_type--node_type","id":"4a4790a8-5e3c-45d2-8f0f-ffb0a609a5db","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_speaker"}},"revision_uid":null,"uid":null,"field_media_image":null,"field_speaker_image":{"type":"file--file","id":"e8effb0b-96a0-40da-b75c-b539adab26d5","resourceIdObjMeta":{"alt":"Paul Kuntz","title":"Paul Kuntz","width":299,"height":299,"drupal_internal__target_id":5415}},"relationshipNames":["node_type","revision_uid","uid","field_media_image","field_speaker_image"]}],"field_agenda_track":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"3553a08d-9169-489c-a0b3-e809f341c7f1","drupal_internal__tid":2046,"drupal_internal__revision_id":2046,"langcode":"en","revision_created":"2026-04-14T20:59:45+00:00","status":true,"name":"Governance \u0026 Security","description":null,"weight":0,"changed":"2026-04-14T20:59:45+00:00","default_langcode":true,"revision_translation_affected":true,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Governance \u0026 Security | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/taxonomy/term/2046"}},{"tag":"meta","attributes":{"property":"og:title","content":"| Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en_US"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":null,"pid":null,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"content_translation_created":"2026-04-14T20:59:45+00:00","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/taxonomy_term/dataaisummit_agenda_track/3553a08d-9169-489c-a0b3-e809f341c7f1?resourceVersion=id%3A2046"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/taxonomy_term/dataaisummit_agenda_track/3553a08d-9169-489c-a0b3-e809f341c7f1?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"drupal_internal__target_id":2046},"vid":{"type":"taxonomy_vocabulary--taxonomy_vocabulary","id":"143091c9-ad85-4cf5-86e7-e229c84fcdd0","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit_agenda_track"}},"revision_user":null,"parent":[{"type":"taxonomy_term--dataaisummit_agenda_track","id":"virtual","resourceIdObjMeta":{"links":{"help":{"href":"https://www.drupal.org/docs/8/modules/json-api/core-concepts#virtual","meta":{"about":"Usage and meaning of the 'virtual' resource identifier."}}}}}],"content_translation_uid":null,"relationshipNames":["vid","revision_user","parent","content_translation_uid"]}],"field_areas_of_interest":[{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"6cbb491d-4e16-40f4-8bb4-82fed6c12545","resourceIdObjMeta":{"drupal_internal__target_id":2071}},{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"81baaed5-9506-44c1-852f-99641c50bfb5","resourceIdObjMeta":{"drupal_internal__target_id":2029}},{"type":"taxonomy_term--dataaisummit_areas_of_interest","id":"dc6aa70e-ad16-40e4-8dfa-e0fd5e78a5ed","resourceIdObjMeta":{"drupal_internal__target_id":2030}}],"field_content":[],"field_session_sub_category":{"type":"taxonomy_term--dataaisummit_session_sub_cat","id":"90f7ba42-d2d0-41f7-aa83-f9405b2cda5f","resourceIdObjMeta":{"drupal_internal__target_id":2031}},"field_slides":[],"relationshipNames":["node_type","revision_uid","uid","field_agenda_category","field_agenda_delivery","field_agenda_event_type","field_agenda_industry","field_agenda_level","field_agenda_room","field_agenda_speakers","field_agenda_track","field_areas_of_interest","field_content","field_session_sub_category","field_slides"]},{"type":"node--dataaisummit2026_agenda_item","id":"617d0685-df2d-4c19-9be2-f96494b71a36","drupal_internal__nid":17726,"drupal_internal__vid":25333,"langcode":"en","revision_timestamp":"2026-02-09T19:22:34+00:00","status":true,"title":"Data Governance at Scale with ABAC at Atlassian","created":"2026-02-09T19:22:34+00:00","changed":"2026-07-14T17:15:24+00:00","promote":true,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":null,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Data Governance at Scale with ABAC at Atlassian | Databricks"}},{"tag":"link","attributes":{"rel":"canonical","href":"https://microsites.databricks.com/dataaisummit2026agendaitem/data-governance-scale-abac-atlassian"}},{"tag":"meta","attributes":{"property":"og:type","content":"website"}},{"tag":"meta","attributes":{"property":"og:url","content":"https://microsites.databricks.com/dataaisummit2026agendaitem/data-governance-scale-abac-atlassian"}},{"tag":"meta","attributes":{"property":"og:title","content":"Data Governance at Scale with ABAC at Atlassian | Databricks"}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.databricks.com/dataaisummit/sites/default/files/2026-02/dais26-og-1200x628.jpg"}},{"tag":"meta","attributes":{"property":"og:locale","content":"en"}},{"tag":"meta","attributes":{"property":"article:publisher","content":"https://www.facebook.com/databricksinc/"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}}],"path":{"alias":"/dataaisummit2026agendaitem/data-governance-scale-abac-atlassian","pid":17753,"langcode":"en"},"content_translation_source":"und","content_translation_outdated":false,"body":null,"field_agenda_body":{"value":"\u003cp\u003eAtlassian’s internal data platform is the backbone for analytics, product insights and business decisions across the company. Managing data access policies at this scale is complex. In this talk, we’ll share how Atlassian embeds robust data governance policies, balancing agility with compliance, and innovation with security. Learn how we handle access management, data classification, and policy enforcement across diverse teams and tools. A key part of our approach is leveraging Databricks Attribute-Based Access Control (ABAC) to manage and abstract complex business policies. ABAC enables us to flexibly enforce fine-grained access controls (FGAC) using data tagging along with tag-driven policies, adapting quickly to changing requirements while keeping implementation logic abstracted from users. Join us for insights into the challenges, lessons learned, and solutions that keep our data platform secure and well-governed.\u003c/p\u003e\u003cbr /\u003e\n","format":"basic_html","processed":"\u003cp\u003eAtlassian’s internal data platform is the backbone for analytics, product insights and business decisions across the company. Managing data access policies at this scale is complex. In this talk, we’ll share how Atlassian embeds robust data governance policies, balancing agility with compliance, and innovation with security. Learn how we handle access management, data classification, and policy enforcement across diverse teams and tools. A key part of our approach is leveraging Databricks Attribute-Based Access Control (ABAC) to manage and abstract complex business policies. ABAC enables us to flexibly enforce fine-grained access controls (FGAC) using data tagging along with tag-driven policies, adapting quickly to changing requirements while keeping implementation logic abstracted from users. Join us for insights into the challenges, lessons learned, and solutions that keep our data platform secure and well-governed.\u003c/p\u003e\u003cbr\u003e"},"field_agenda_code_id":"D26B1058","field_agenda_duration":"40","field_agenda_ends":"2026-06-17T19:10:00+00:00","field_agenda_starts":"2026-06-17T18:30:00+00:00","field_agenda_unique_id":"1765864099677001oebk","field_metatags":null,"field_price":null,"field_slides_url":"https://microsites.databricks.com/sites/default/files/dais/2026/D26B1058.pdf","field_video_chunks":[],"field_video_transcript":null,"field_video_url":"https://cdnapisec.kaltura.com/p/6501692/embedPlaykitJs/uiconf_id/57932942?autoembed=true\u0026targetId=kaltura_player_1_1b1omzxf\u0026entry_id=1_1b1omzxf","links":{"self":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/617d0685-df2d-4c19-9be2-f96494b71a36?resourceVersion=id%3A25333"},"working-copy":{"href":"https://microsites.databricks.com/jsonapi/node/dataaisummit2026_agenda_item/617d0685-df2d-4c19-9be2-f96494b71a36?resourceVersion=rel%3Aworking-copy"}},"node_type":{"type":"node_type--node_type","id":"02af01b1-e063-4d57-a525-a7a8f2f9b968","resourceIdObjMeta":{"drupal_internal__target_id":"dataaisummit2026_agenda_item"}},"revision_uid":null,"uid":null,"field_agenda_category":[{"type":"taxonomy_term--dataaisummit_agenda_category",