<!DOCTYPE html><html lang="en-US"><head><meta charSet="utf-8" data-next-head=""/><style data-fullcalendar="true" data-next-head=""></style><meta name="viewport" content="width=device-width, initial-scale=1" data-next-head=""/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" data-next-head=""/><meta name="service" content="web-next" data-next-head=""/><meta name="X-Location" content="east" data-next-head=""/><meta name="X-Build-Version" content="ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb" data-next-head=""/><link rel="icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" type="image/x-icon" sizes="any" data-next-head=""/><link rel="shortcut icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" data-next-head=""/><link rel="apple-touch-icon" sizes="120x120" href="https://secure.meetupstatic.com/next/images/general/m_redesign_120x120.png" data-next-head=""/><link rel="apple-touch-icon" sizes="152x152" href="https://secure.meetupstatic.com/next/images/general/m_redesign_152x152.png" data-next-head=""/><link rel="apple-touch-icon" sizes="167x167" href="https://secure.meetupstatic.com/next/images/general/m_redesign_167x167.png" data-next-head=""/><link rel="shortcut icon" sizes="128x128" href="https://secure.meetupstatic.com/next/images/general/m_redesign_128x128.png" data-next-head=""/><link rel="shortcut icon" sizes="196x196" href="https://secure.meetupstatic.com/next/images/general/m_redesign_196x196.png" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Regular.1ca3b39b.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Medium.7b11edcf.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Bold.5c45f750.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Book.27256a60.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/Boyrun-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="https://www.facebook.com/tr?id=792405807634160&amp;ev=PageView&amp;noscript=1" as="image" data-next-head=""/><script type="application/ld+json" data-next-head="">{"@type":"Organization","@context":"https://schema.org","url":"https://www.meetup.com/find/","name":"Meetup","logo":"https://secure.meetupstatic.com/next/images/general/m_redesign_630x630.png","sameAs":["https://www.facebook.com/meetup/","https://twitter.com/Meetup/","https://www.youtube.com/meetup","https://www.instagram.com/meetup/"]}</script><title data-next-head="">Find Events &amp; Groups | Meetup</title><meta name="description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="fb:app_id" content="2403839689" data-next-head=""/><meta property="og:site_name" content="Meetup" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:title" content="Find Events &amp; Groups | Meetup" data-next-head=""/><meta property="og:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="og:url" content="https://www.meetup.com/find/" data-next-head=""/><meta property="og:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="al:android:app_name" content="Meetup" data-next-head=""/><meta property="al:android:package" content="com.meetup" data-next-head=""/><meta property="al:ios:app_store_id" content="375990038" data-next-head=""/><meta property="al:ios:app_name" content="Meetup" data-next-head=""/><meta property="al:web:should_fallback" content="true" data-next-head=""/><meta property="al:android:url" content="meetup://" data-next-head=""/><meta property="al:ios:url" content="meetup://" data-next-head=""/><meta property="al:web:url" content="https://www.meetup.com/" data-next-head=""/><meta property="twitter:card" content="summary_large_image" data-next-head=""/><meta property="twitter:site" content="@meetup" data-next-head=""/><meta property="twitter:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="twitter:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="twitter:app:id:iphone" content="375990038" data-next-head=""/><meta property="twitter:app:name:iphone" content="Meetup" data-next-head=""/><meta property="twitter:app:id:ipad" content="375990038" data-next-head=""/><meta property="twitter:app:name:ipad" content="Meetup" data-next-head=""/><meta property="twitter:app:id:googleplay" content="com.meetup" data-next-head=""/><meta property="twitter:app:name:googleplay" content="Meetup" data-next-head=""/><meta name="robots" content="noindex, follow" data-next-head=""/><link rel="canonical" href="https://www.meetup.com/find/" data-next-head=""/><link rel="preconnect" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com" data-next-head=""/><link rel="dns-prefetch" href="https://www.googletagmanager.com" data-next-head=""/><script type="application/ld+json" data-next-head="">[{"@context":"https://schema.org","@type":"Event","name":"[SF] AI Builder Tour with Bluehost","url":"https://www.meetup.com/sv-enterprise-ai/events/317572865/","description":"**Important**: Registration on the[ ](https://www.aicamp.ai/event/eventdetails/W2026120306)[event website](https://www.aicamp.ai/event/eventdetails/W2026111709) is required for admission.\n(RSVP on meetup is turned off)\n\nJoin us for the Bluehost AI Builder Tour - San Francisco, an in-person experience bringing together entrepreneurs, developers, creators, and local AI builders ready to move from vision to launch and scale.\n\nWhether you're developing your next big idea, launching a business, or scaling something you've already built, this is your opportunity to connect with fellow builders, explore new possibilities, and get expert feedback.\n\n**Three awards, three chances to win awards - $30,000**:\nExplore three exciting opportunities to compete:\n\n* Build with Anything — Create an AI-powered solution using the tools of your choice.\n* Build & Win with Bluehost — Build a website or app using Bluehost AI Builder.\n* Vibeathon — Put your AI-powered creativity and building skills to the test.\n\n**What to Expect:**\n\n* Local AI Builder Showcases: Hear from local builders about their projects, challenges, and lessons learned.\n* Build, Host & Scale: Discover Bluehost innovations to help build, host, and run your projects.\n* Interactive AI Workshop: Bring your ideas or work in progress and get feedback from AI builders and experts.\n* Peer-to-Peer Breakouts: Discuss AI agents, infrastructure, performance, and costs with peers and experts.\n* Community & Networking: Connect with local AI builders, entrepreneurs, and industry experts.\n\n**Featured Speakers:**\n\n* Salim Ali, Bluehost\n* Antonis Papatsaras, Bluehost\n* Vishwa Shroff, Bluehost\n* Ana Ramdas, Build First\n* and more\n*\n\n**Agenda:**\n\n* 9:00am–9:30am: Coffee, Networking & Demos\n* 9:30am–10:00am: Welcome & Introduction\n* 10:00am–12:00pm: AI Builder Showcases & Workshop\n* 12:00pm–1:00pm: Lunch\n* 1:00pm–3:00pm: Interactive Workshop & Expert Feedback\n* 3:15pm–4:30pm: Peer Discussions & Expert Consultations\n* 5:00pm onwards: Happy Hour & Networking\n*","startDate":"2026-12-09T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"The Avalon","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"1244 Sutter St, San Francisco, CA 94109, USA, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Silicon Valley Enterprise AI","url":"https://www.meetup.com/sv-enterprise-ai/"},"performer":"Silicon Valley Enterprise AI"},{"@context":"https://schema.org","@type":"Event","name":"AI Book Club: Reinforcement Learning from Human Feedback (RLHF)","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685013/","description":"**Novembers's book is \"Reinforcement Learning from Human Feedback\"!**\n\n​This is a casual-style event. Not a structured presentation on topics. Sometimes, the discussion even drifts away from the chapters, but feel free to grab the mic to help steer it back.\n\n​Feel free to join the discussion even if you have not read the book chapters! :)\n​Want to discuss the contents during the reading week? Join the AI Slack group: https://slack.flyte.org/\n​-------------------------------------------------\nAbout the book:\n\n* ​Title: **Reinforcement Learning from Human Feedback**\n* ​Authors: Nathan Lambert\n* ​Published: August 2026\n\n​Manning (Promo code: AIBookClub should give you 45% off: [https://www.manning.com/books/reinforcement-learning-from-human-feedback](https://www.manning.com/books/reinforcement-learning-from-human-feedback?utm_source=luma)\n​O'rielly platform: [https://learning.oreilly.com/library/view/reinforcement-learning-from/9781633434301/](https://learning.oreilly.com/library/view/reinforcement-learning-from/9781633434301/?utm_source=luma)\n​\n​Chapters:\n\n* ​1 Introduction\n* ​2 A tiny history of RLHF\n* ​3 Training overview\n* ​4 Instruction fine-tuning\n* ​5 Reward modeling\n* ​6 Reinforcement learning\n* ​7 Reasoning and inference-time scaling\n* ​8 Direct-alignment algorithms\n* ​9 Rejection sampling\n* ​10 The nature of preferences\n* ​11 Preference data\n* ​12 Synthetic data\n* ​13 Tool use and function calling\n* ​14 Over-optimization\n* ​15 Regularization\n* ​16 Evaluation\n* ​17 Crafting model character and products\n\n​**Book Description**\n​***Reinforcement Learning from Human Feedback: LLM alignment and post-training* helps you understand how modern AI models can be adapted to better match the needs and expectations of their users. Rather than surveying the vast field of reinforcement learning, elite AI researcher Nathan Lambert concentrates exclusively on RLHF and its immediate importance to post-training generative AI models.**\n\n**This compact book gets right to the point. Early chapters establish the training overview, explain instruction fine-tuning, and build reliable reward models. The middle chapters transition into the heart of alignment, exploring core policy gradient algorithms, Direct Preference Optimization (DPO), and inference-time scaling. Later chapters tackle the messy reality of data, guiding you through preference data collection, synthetic data generation, and the nuances of function calling.**","startDate":"2026-12-08T21:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685013/"},"organizer":{"@type":"Organization","name":"AI Builders and Learners SF","url":"https://www.meetup.com/ai-builders-and-learners-sf/"},"performer":"AI Builders and Learners SF"},{"@context":"https://schema.org","@type":"Event","name":"Build an Agentic AI Model Factory: Own Your AI","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318556/","description":"​**Build a Sovereign AI Factory: an ML Engineer Agent that evaluates, fine-tunes, deploys, and improves open models.**\nRSVP on Luma for live link: https://luma.com/vfhq98ji\n\n​AI teams are starting to look beyond renting every capability from an external API, they're building systems they own and control. In this hands-on session we'll build exactly that by creating an ML Engineer Agent that will manage a model factory to select and fine-tune the best models for your applications.\n\n​We'll start with a walkthrough where we build an agent that evaluates open models in parallel, fine-tunes promising candidates, deploys the winner, and retrains automatically when performance drops. Think of it as the first brick in your own **model factory**: a repeatable system for evaluating, improving, and deploying models *you* control.\n\n​You'll see how [Union.ai](https://union.ai/?utm_source=luma) & Flyte give your AI workflows a **durable runtime** with *infrastructure as context,* so agents adapt infra resources, recover from failures, and keep moving without re-running completed work. And because it all runs in **your own cloud**, you own the full stack end to end: **your models, your data, your infrastructure, your IP.**","startDate":"2026-12-09T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318556/"},"organizer":{"@type":"Organization","name":"AI Builders and Learners SF","url":"https://www.meetup.com/ai-builders-and-learners-sf/"},"performer":"AI Builders and Learners SF"},{"@context":"https://schema.org","@type":"Event","name":"From your current skills to a practical AI workflow","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480885/","description":"A live, interactive AumOS session, open to everyone. Level: foundations / mixed professional audience.\n\n**What you will do:** A workflow map, a simple AI decision exercise and a realistic next learning step.\n\n**Prerequisites:** No coding or AI background required; bring a work problem you can discuss without confidential data.\n\n**Take-away:** One-page workflow canvas and a small deterministic-versus-AI decision exercise.\n\n**Format:** 90 minutes, live online, with a worked example, exercise, discussion and questions. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized examples.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to ask a question, share a relevant experience and meet people building with AI around the world. No employer, university or independent community endorsement is implied.","startDate":"2026-11-29T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480885/"},"organizer":{"@type":"Organization","name":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/"},"performer":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS"},{"@context":"https://schema.org","@type":"Event","name":"TechConnect - Virtual Job and Networking Event for Data AI Tech Professionals","url":"https://www.meetup.com/big-data-gods/events/317298027/","description":"**Welcome to TechConnect: Virtual Job & Networking Event for Data, AI, & Tech Professionals!**\nAre you a professional in the fields of data, AI, or technology? TechConnect is the premier virtual networking event that brings together data scientists, AI specialists, software developers, and tech enthusiasts to connect with employers and explore exciting career opportunities in the tech industry.\nEvent Details:\n\n* Time: 4-6 pm (Local Time)\n* Venue: Virtual. RSVP [here](https://events.tao.ai/pod/tech.specialists.club/cont-te5gd5wngmz9)\n* Hosted by: No Worker Left Behind (NWLB)\n\nWhy Attend TechConnect?\n\n* Discover Job Opportunities: Access a wide range of job openings in data science, artificial intelligence, machine learning, software development, cybersecurity, and more.\n* Network with Peers: Connect with tech recruiters, hiring managers, and professionals from leading companies in the tech space.\n* Career Development: Get valuable tips on building a successful tech career, advancing in your current role, or transitioning to new areas in the tech field.\n\nHow to Participate:\n\n1. Register: Create your profile and complete your settings on this platform.\n2. RSVP for the Event: Secure your spot to access job listings and network with tech employers and industry experts.\n3. Engage with the Community: Join discussions, share your experiences, and connect with fellow tech professionals to explore new career paths.\n\nFor Data, AI, & Tech Professionals: Whether you're a seasoned data scientist, AI engineer, software developer, or just starting in tech, TechConnect offers the networking and resources you need to excel in your career.\nInvite Your Network: Know someone in tech? Share TechConnect with them and help grow their professional network and career opportunities in data, AI, and tech.\nTags: #TechCareers, #DataScienceJobs, #AIJobs, #MachineLearningCareers, #SoftwareDevelopment, #TechNetworking, #DataJobs, #AIProfessionals, #TechOpportunities, #VirtualJobFair, #CybersecurityJobs, #CloudComputing, #TechIndustry, #TechCareerGrowth, #TechHiring, #TechTalent, #TechConnect, #JobFairTech, #AIAndDataCareers, #CareerInTech","startDate":"2026-12-03T00:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/big-data-gods/events/317298027/"},"organizer":{"@type":"Organization","name":"Big Data Gods","url":"https://www.meetup.com/big-data-gods/"},"performer":"Big Data Gods"},{"@context":"https://schema.org","@type":"Event","name":"How Reliable Are AI Agents That Query Live Data","url":"https://www.meetup.com/datatalks-meetups-global/events/317427864/","description":"How Reliable Are AI Agents That Query Live Data with Edoardo Dusi\nEdoardo Dusi, Senior Developer Advocate at AWS, talks about what it takes to trust AI agents that query live data, including where they break down and how to check their answers.\nAsk your questions for Edoardo here: [https://qna.dtcdev.click/r/podcast-ai-agents-live-data](https://qna.dtcdev.click/r/podcast-ai-agents-live-data)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","startDate":"2026-12-02T11:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/datatalks-meetups-global/events/317427864/"},"organizer":{"@type":"Organization","name":"DataTalks.Club Meetups Global","url":"https://www.meetup.com/datatalks-meetups-global/"},"performer":"DataTalks.Club Meetups Global"},{"@context":"https://schema.org","@type":"Event","name":"Info Session on Mentor-Led Data Science Internship Program","url":"https://www.meetup.com/introduction-to-data-science/events/317473011/","description":"Please register using the zoom link to get a reminder:\n\nhttps://us02web.zoom.us/webinar/register/8617335660229/WN_baWalUCNS1Op_cp9UHkCgw\n\nAttention all aspiring data scientists! Magnimind Academy has one-of-its-kind mentorship and internship program for students lacking a portfolio but having the fundamentals. This fifteen-week boot camp is designed to provide you with:\n\n-Real industry projects\n-Expert data scientists\n-Project-based intensive training\n-Mock interviews -Resume polish\n-Post-interview feedback\n\nWe will be hosting an information session to discuss the program in more detail. Whether you're a recent graduate or looking to transition into the field, this program is perfect for those who are serious about a career in data science.\n\nJoin us to learn more about this exciting program and get your questions answered. RSVP now to reserve your spot!\n\nAgenda:\n(PDT) 11:00 am - 11:05 am Arrival and socializing and Opening\n(PDT) 11:05 am - 12:00 pm \"Info Session on Mentor-Led Data Science Internship Program\"\n(PDT) 12:00 pm - 12:10 pm Q&A\n\nAbout Dr. Murat Baday:\n\nDr. Baday is the co-founder of Magnimind Academy. He is passionate about everything related to data science, education, and entrepreneurship. He received a biophysics PhD from the University of Illinois and continued his studies at Stanford Univ as a Postdoc. He has published several papers and patents and he is the co-founder of several biotechs and AI startups.\n\nAbout Dr. Yasin Ceran:\n\nYasin Ceran is passionate about all things data and holds a vast experience in data analysis, mathematical modeling and Apache Spark, and in SQL, Python and R. He is currently an associate professor at KAIST, South Korea, as well as teaching at San Jose State University at the heart of Silicon Valley. Yasin has worked rigorously on an array of data-related projects encompassing data mining, statistics, modeling, and is dedicated to sharing his experience and expertise with learners.\n\nPlease register using the zoom link to get a reminder:\n\nhttps://us02web.zoom.us/webinar/register/8617335660229/WN_baWalUCNS1Op_cp9UHkCgw","startDate":"2026-12-12T19:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/introduction-to-data-science/events/317473011/"},"organizer":{"@type":"Organization","name":"Silicon Valley Data Science, ML, AI Platform","url":"https://www.meetup.com/introduction-to-data-science/"},"performer":"Silicon Valley Data Science, ML, AI Platform"},{"@context":"https://schema.org","@type":"Event","name":"From Ad-Hoc SQL to AI Agents","url":"https://www.meetup.com/datatalks-meetups-global/events/317427643/","description":"From Ad-Hoc SQL to AI Agents with Madhu Gurramkonda\nMadhu Gurramkonda, Head of Data Analytics and AI at Amazon (speaking in a personal capacity), talks about how a data team moves from answering ad-hoc SQL requests one at a time to running AI agents that business teams can use, including the foundations that come first and how to check answers before anyone sees them.\nAsk your questions for Madhu here: [https://qna.dtcdev.click/r/podcast-from-ad-hoc-sql-to-ai-agents](https://qna.dtcdev.click/r/podcast-from-ad-hoc-sql-to-ai-agents)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","startDate":"2026-12-01T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/datatalks-meetups-global/events/317427643/"},"organizer":{"@type":"Organization","name":"DataTalks.Club Meetups Global","url":"https://www.meetup.com/datatalks-meetups-global/"},"performer":"DataTalks.Club Meetups Global"},{"@context":"https://schema.org","@type":"Event","name":"Make Your GPU Earn Its Keep: A Kernel Engineering Deep Dive","url":"https://www.meetup.com/ai-performance-engineering-sf2/events/317171691/","description":"**Monday, November 30, 2026 · 9:00–10:00 AM PST · Online**\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\nA powerful GPU can spend plenty of time waiting. What is it waiting for—and how do you find out?\n**Talk #0: Welcome and Meetup Updates**\nby Chris Fregly and Antje Barth\n**Talk #1: From “Why Is This Slow?” to a Faster Kernel**\nby Dr. Rajat “Raj” Dandekar, Co-founder of Vizuara\nJoin Raj for a focused tour of the engineering behind fast AI kernels, drawing on Vizuara’s Kernel Engineering course on Maven. We’ll connect the roofline model to CUDA execution and the GPU memory hierarchy, then look at how profiling guides optimizations such as coalesced memory access, tiling, and tensor-core use. Matrix multiplication and attention provide context for seeing how those ideas fit together in modern AI workloads, including FlashAttention.\nThe goal is a practical way to decide what to measure, which bottleneck matters, and whether an optimization helped. The session is dedicated to Raj’s talk, with time for audience questions.\n**Who it’s for:** Engineers comfortable with Python or basic PyTorch. Prior CUDA or C++ experience is not required.\n**Bio:** Dr. Rajat Dandekar is a co-founder of Vizuara and a Kernel Engineering course instructor. He holds a PhD in Mechanical Engineering from Purdue University and BTech and MTech degrees from IIT Madras.\n**Based on:** [Kernel Engineering: From CUDA Foundations to Frontier AI Kernels](https://maven.com/rajat-dandekar/kernel-engineering)\n**Scheduling note:** November 30 is the proposed new date; speaker confirmation is pending.\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\n**Related Links**\nGithub Repo: [http://github.com/cfregly/ai-performance-engineering/](http://github.com/cfregly/ai-performance-engineering/)\nO’Reilly Book: [https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/](https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/)\nYouTube: [https://www.youtube.com/@AIPerformanceEngineering](https://www.youtube.com/@AIPerformanceEngineering)\nGenerative AI Free Course on DeepLearning.ai: [https://bit.ly/gllm](https://bit.ly/gllm)","startDate":"2026-11-30T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-performance-engineering-sf2/events/317171691/"},"organizer":{"@type":"Organization","name":"AI Performance Engineering Meetup (SF2)","url":"https://www.meetup.com/ai-performance-engineering-sf2/"},"performer":"AI Performance Engineering Meetup (SF2)"},{"@context":"https://schema.org","@type":"Event","name":"The Real Cost of a Useful AI Feature","url":"https://www.meetup.com/datatalks-meetups-global/events/317429299/","description":"The Real Cost of a Useful AI Feature with Ian Vanagas\nIan Vanagas, Editorial Lead at PostHog, talks about what it actually costs to ship an AI feature that people use, including the product and engineering work around the model itself.\nAsk your questions for Ian here: [https://qna.dtcdev.click/r/podcast-the-real-cost-of-a-useful-ai-feature](https://qna.dtcdev.click/r/podcast-the-real-cost-of-a-useful-ai-feature)\nWe will stream live on our YouTube channel: https://www.youtube.com/c/DataTalksClub\nDataTalks.Club is the place to talk about data. Join our Slack: https://datatalks.club/slack.html","startDate":"2026-12-01T11:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/datatalks-meetups-global/events/317429299/"},"organizer":{"@type":"Organization","name":"DataTalks.Club Meetups Global","url":"https://www.meetup.com/datatalks-meetups-global/"},"performer":"DataTalks.Club Meetups Global"},{"@context":"https://schema.org","@type":"Event","name":"From HR Reports to People Analytics with AI","url":"https://www.meetup.com/datatalks-meetups-global/events/317427888/","description":"From HR Reports to People Analytics with AI with Sofiia Hordiienko\nSofiia Hordiienko, HR Data Analyst, talks about moving from routine HR reports to people analytics that actually helps leaders decide, including how she uses Power BI, SQL, Excel, and Python, and how AI fits into that work.\nAsk your questions for Sofiia here: [https://qna.dtcdev.click/r/podcast-people-analytics-ai](https://qna.dtcdev.click/r/podcast-people-analytics-ai)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","startDate":"2026-11-30T11:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/datatalks-meetups-global/events/317427888/"},"organizer":{"@type":"Organization","name":"DataTalks.Club Meetups Global","url":"https://www.meetup.com/datatalks-meetups-global/"},"performer":"DataTalks.Club Meetups Global"},{"@context":"https://schema.org","@type":"Event","name":"Hedge West SF December 2026 Meetup","url":"https://www.meetup.com/hedge-west-sf-quant-data-and-ai/events/316558391/","description":"**The next quarterly HedgeWestSF meetup in San Francisco is on December 8, 2026 from 6pm to 9pm. Join us at The House of AI at 40 Boardman Place in San Francisco's West SOMA Neighborhood** **near 7th and Bryant Streets. Parking available at 71 Boardman Place.**\n\nPresentations:\n\n**Vladimir Ofitserov** (REVO Capital - revocm.com) - *Scaling Quant Research with AI*\n\n**Vinesh Jha** (ExtractAlpha - ExtractAlpha.com) - *Advances in Alternate Data Alpha. New research, emerging signals, and what systematic investors should be watching next* (Rescheduled from the last meetup)\n\n**Greg Kapoustin** (validityBase - [vbase.com](https://vbase.com/?utm_source=luma)) - *Why Backtests Aren’t Trusted: Common Mistakes and Their Solutions*\n\nCALL FOR SPONSORS - Help keep HedgeWestSF going by becoming a sponsor - https://hedgewestsf.org/sponsorship\nCALL FOR PRESENTATIONS - Want to present at a future HedgeWestSF? Email hedgewestsf@novumcove.com\n\n**HedgeWestSF is sponsored by Novum Cove Capital Management and ExtractAlpha.**\n\nFood and refreshments will be served. As always, professionals, students, and anyone with an interest in trading, quant, data, and AI in finance are welcome! Looking forward to seeing you there!","startDate":"2026-12-09T02:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"House of AI","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"40 Boardman Pl, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Hedge West SF - Quant, Data, and AI","url":"https://www.meetup.com/hedge-west-sf-quant-data-and-ai/"},"performer":"Hedge West SF - Quant, Data, and AI"},{"@context":"https://schema.org","@type":"Event","name":"Building Reliable Data Pipelines with AI Agents","url":"https://www.meetup.com/datatalks-meetups-global/events/317528615/","description":"Building Reliable Data Pipelines with AI Agents with Hrishi Olickel\nHrishi Olickel, co-founder and CEO of Southbridge AI, talks about putting AI agents to work inside messy operational data pipelines: the silent failures that happen when models touch tabular data, deterministic code guards around model steps, and testing pipelines against checked edge cases.\nAsk your questions for Hrishi here: [https://qna.dtcdev.click/r/podcast-data-pipelines-ai-agents](https://qna.dtcdev.click/r/podcast-data-pipelines-ai-agents)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","startDate":"2026-12-14T11:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/datatalks-meetups-global/events/317528615/"},"organizer":{"@type":"Organization","name":"DataTalks.Club Meetups Global","url":"https://www.meetup.com/datatalks-meetups-global/"},"performer":"DataTalks.Club Meetups Global"},{"@context":"https://schema.org","@type":"Event","name":"Beyond Analytics: Turning Microsoft Fabric Insights Into Decisions","url":"https://www.meetup.com/silicon-valley-machine-learning-learners-and-entrepreneurs/events/317563808/","description":"This event is organized by SAS.\n\nThis event is being promoted by many groups.\n\nOur meetup group is participating by promoting this event.\nOur meetup group is collaborating by promoting this event.\n\nThis is an online event.\n\nAttendees can be located anywhere in the world!\n\nThis event is FREE to attend!\n\nIn order to attend, please register here:\n[https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html](https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html)\nOrganizations have more data, analytics and predictive capabilities than ever. Yet turning those insights into timely, consistent business decisions remains a challenge.\nDisconnected systems, manual processes and fragmented operations often stand in the way. For example, banks have customer data, predictive models and business criteria spread throughout the organization, slowing loans and credit decisions.\nJoin experts from SAS and Katalyze to explore how decision intelligence bridges the gap between insights, actions and business outcomes. Discover how SAS Decision Builder on Microsoft Fabric helps organizations connect analytics, business rules and organizational judgment to make more consistent, governed decisions.\n\n## You’ll learn more about:\n\n* Bridging the decision gap: Why insights don’t always translate into action and business outcomes – and how decision intelligence helps.\n* Connecting decision-making components: How business rules, predictive models, organizational judgment and governance work together.\n* Overcoming organizational barriers: How to address disconnected workflows, manual processes and unclear decision ownership.\n* Operationalizing decisions with SAS: How SAS Decision Builder on Microsoft Fabric orchestrates governed decision workflows using data in Microsoft OneLake.\n* Putting decision intelligence into practice: How SAS and Katalyze can help identify high-value decisioning opportunities in the pharmaceutical, financial services and legal industries.\n\nTry SAS Decision Builder for free today: [https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview](https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview)","startDate":"2026-12-01T15:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/silicon-valley-machine-learning-learners-and-entrepreneurs/events/317563808/"},"organizer":{"@type":"Organization","name":"Silicon Valley AI, Machine Learning, Big Data Entrepreneurs","url":"https://www.meetup.com/silicon-valley-machine-learning-learners-and-entrepreneurs/"},"performer":"Silicon Valley AI, Machine Learning, Big Data Entrepreneurs"},{"@context":"https://schema.org","@type":"Event","name":"AIConnect: Global Virtual Job & Career Networking Event for AI Specialists","url":"https://www.meetup.com/ac-sfo/events/317530584/","description":"Are you an AI engineer, data scientist, machine learning researcher, or aspiring innovator in the world of artificial intelligence? **AIConnect** is your dynamic **AI networking event online** designed to foster real-time conversations, career growth, and collaboration opportunities — all within a vibrant and self-led virtual space.\n\nWhether you're exploring job roles in AI, hoping to demo your latest project, or searching for your next co-developer or data scientist partner, **AIConnect** offers a one-of-a-kind experience to connect with the global **machine learning community meetup** — anytime, from anywhere.\n\n🎥 **Watch how it works in our explainer video:**\n👉 [https://www.youtube.com/watch?v=bH3uNrkUTuw](https://www.youtube.com/watch?v=bH3uNrkUTuw)\n**💡 Why Join AIConnect?**\n\nThis is not just another virtual event. It’s a **collaboration platform for AI specialists** where you can grow your professional network, showcase your AI/ML portfolio, exchange ideas, and chat directly with fellow participants, recruiters, and service providers.\nDesigned for **AI career fair virtual** seekers and builders alike, the platform supports live 1-1 **video or text chats**, and offers open access to diverse community-led channels tailored to your interests.\n**💬 Brainstorming & Discussion Channels Include:**\n\n* **General** – Your go-to hub for announcements, orientation, and casual community-wide conversation.\n* **Intros** – Introduce yourself, your research, your startup, or just share your journey in AI.\n* **Networking** – Showcase your AI/ML projects, portfolios, startup pitches, or job aspirations.\n* **Help Wanted** – Looking for team members, mentorship, freelance gigs, or offering support? Post here.\n* **Industry Room Tech** – Dive into the latest developments in AI frameworks, ML pipelines, data tools, and tech trends.\n\nWhether you’re a beginner or a pro, a researcher or a recruiter — this space empowers growth through **project demos, career discussions, and research conversations.**\n**🧠 What You’ll Gain:**\n\n* Direct access to a **global AI talent and hiring ecosystem**\n* Exposure to cutting-edge projects via the **AI project showcase event**\n* Connections with peers and thought leaders across AI, ML, and data science\n* Career insights and opportunities from fellow professionals and employers\n* A flexible environment to network, brainstorm, and build meaningful collaborations\n* Instant 1-on-1 video or text chats for deeper engagement\n\n**📍 Where:**\nJoin virtually at:\n👉 [https://events.tao.ai/pod/analytics.club/jknf0o9m3kix](https://events.tao.ai/pod/analytics.club/jknf0o9m3kix)\n**🕔 When:**\nEvery session starts at **5:00 PM – 7:00 PM local time** — recurring monthly on Fridays. Mark your calendar and come prepared to connect!\n**👥 Who Should Attend:**\n\n* AI engineers, ML developers, and data scientists\n* Startup founders and entrepreneurs in the AI/tech space\n* Recruiters, hiring managers, and project collaborators\n* Students, academics, and early-career professionals\n* Anyone passionate about AI, machine learning, and applied tech innovation\n\n**📩 Questions or Suggestions?**\nWe’d love to hear from you. Reach us anytime here:\n👉 [https://noworkerleftbehind.org/event_support](https://noworkerleftbehind.org/event_support)\n**🔖 Hashtags:**\n#AIConnect #AINetworkingEventOnline #AICareerFairVirtual #MachineLearningCommunityMeetup #AIProjectShowcaseEvent #CollaborationPlatformForAISpecialists #MLJobs #GlobalAINetworking #TechNetworkingEvent #AIProfessionalsUnite","startDate":"2026-12-11T22:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ac-sfo/events/317530584/"},"organizer":{"@type":"Organization","name":"Analytics.Club San Francisco","url":"https://www.meetup.com/ac-sfo/"},"performer":"Analytics.Club San Francisco"}]</script><link rel="preload" href="https://secure.meetupstatic.com/photos/event/c/f/8/4/highres_537293124.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/0/4/c/highres_536284172.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/a/2/3/highres_537006691.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/4/9/0/8/highres_537198696.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/9/1/f/4/highres_525757364.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/9/4/a/highres_537130570.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/e/8/1/highres_537187809.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/8/a/d/highres_537130413.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/c/8/2/f/highres_530811247.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/f/b/c/highres_537132220.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/2/9/8/c/highres_537130636.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/2/d/e/highres_533993982.jpeg" as="image" data-next-head=""/><meta name="next_csrf" content="d8953936-2cef-48d1-b3b2-98b9d869add3"/><script>(function(){try{if(typeof performance==="undefined"||!performance.getEntriesByType)return;var n=performance.getEntriesByType("navigation");if(!n||!n[0]||!n[0].name)return;var u=new URL(n[0].name);var h=u.hash||"";var m=h.match(/:~:text=([^&]+)/);if(m){window.__meetup_text_fragment__={hasTextFragment:true,textFragment:decodeURIComponent(m[1]).trim().slice(0,100),capturedAt:Date.now()}}else{window.__meetup_text_fragment__={hasTextFragment:false,capturedAt:Date.now()}}}catch(e){}})()</script><script>(function(){try{var hasCookie=document.cookie.split(';').some(function(c){return c.trim()==='isNativeApp=true'});var hasParam=window.location.search.indexOf('isNativeApp=true')!==-1;if(!hasCookie&&!hasParam)return;var s=document.createElement('style');s.textContent='#onetrust-consent-sdk{display:none!important}';document.head.appendChild(s);window.OptanonWrapper=function(){window.OneTrust&&window.One