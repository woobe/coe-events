8199","name":"benlu369","memberPhoto":null},"Member:478370143":{"__typename":"Member","id":"478370143","name":"Diepak","memberPhoto":null},"PhotoInfo:281608910":{"__typename":"PhotoInfo","id":"281608910","highResUrl":"https://secure.meetupstatic.com/photos/member/7/0/e/e/highres_281608910.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:265729578":{"__typename":"Member","id":"265729578","name":"Bill H","memberPhoto":{"__ref":"PhotoInfo:281608910"}},"PhotoInfo:32980442":{"__typename":"PhotoInfo","id":"32980442","highResUrl":"https://secure.meetupstatic.com/photos/member/9/d/f/a/highres_32980442.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:32288812":{"__typename":"Member","id":"32288812","name":"Ravi K. Chandna","memberPhoto":{"__ref":"PhotoInfo:32980442"}},"PhotoInfo:325870606":{"__typename":"PhotoInfo","id":"325870606","highResUrl":"https://secure.meetupstatic.com/photos/member/2/9/6/e/highres_325870606.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:481098609":{"__typename":"Member","id":"481098609","name":"Ashley A.","memberPhoto":{"__ref":"PhotoInfo:325870606"}},"Member:485072118":{"__typename":"Member","id":"485072118","name":"Badari K","memberPhoto":null},"Member:485271394":{"__typename":"Member","id":"485271394","name":"Ravi V.","memberPhoto":null},"Event:317480885":{"__typename":"Event","id":"317480885","title":"From your current skills to a practical AI workflow","dateTime":"2026-11-29T09:00:00-08:00","description":"A live, interactive AumOS session, open to everyone. Level: foundations / mixed professional audience.\n\n**What you will do:** A workflow map, a simple AI decision exercise and a realistic next learning step.\n\n**Prerequisites:** No coding or AI background required; bring a work problem you can discuss without confidential data.\n\n**Take-away:** One-page workflow canvas and a small deterministic-versus-AI decision exercise.\n\n**Format:** 90 minutes, live online, with a worked example, exercise, discussion and questions. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized examples.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to ask a question, share a relevant experience and meet people building with AI around the world. No employer, university or independent community endorsement is implied.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480885/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537198696"},"displayPhoto":{"__ref":"PhotoInfo:537198696"},"feeSettings":null,"group":{"__ref":"Group:38779152"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":8,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:485397589"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:477798199"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:478370143"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:265729578"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:32288812"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481098609"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485072118"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485271394"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:525757364":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/9/1/f/4/highres_525757364.jpeg","id":"525757364"},"PhotoInfo:261708302":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/c/a/e/highres_261708302.jpeg","id":"261708302"},"Group:7972442":{"__typename":"Group","id":"7972442","name":"Big Data Gods","urlname":"big-data-gods","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:261708302"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.72,"totalRatings":43}},"isNewGroup":false},"PhotoInfo:326326713":{"__typename":"PhotoInfo","id":"326326713","highResUrl":"https://secure.meetupstatic.com/photos/member/b/6/7/9/highres_326326713.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326543009":{"__typename":"PhotoInfo","id":"326543009","highResUrl":"https://secure.meetupstatic.com/photos/member/5/9/e/1/highres_326543009.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:325541948":{"__typename":"PhotoInfo","id":"325541948","highResUrl":"https://secure.meetupstatic.com/photos/member/a/3/d/c/highres_325541948.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:324724399":{"__typename":"PhotoInfo","id":"324724399","highResUrl":"https://secure.meetupstatic.com/photos/member/1/1/2/f/highres_324724399.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:324951244":{"__typename":"PhotoInfo","id":"324951244","highResUrl":"https://secure.meetupstatic.com/photos/member/c/8/2/c/highres_324951244.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:272042314":{"__typename":"PhotoInfo","id":"272042314","highResUrl":"https://secure.meetupstatic.com/photos/member/9/0/a/highres_272042314.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326027839":{"__typename":"PhotoInfo","id":"326027839","highResUrl":"https://secure.meetupstatic.com/photos/member/b/a/d/f/highres_326027839.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:252243837":{"__typename":"PhotoInfo","id":"252243837","highResUrl":"https://secure.meetupstatic.com/photos/member/e/f/d/highres_252243837.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:197078094":{"__typename":"Member","id":"197078094","name":"Vishal Kumar","memberPhoto":{"__ref":"PhotoInfo:252243837"}},"Member:199126543":{"__typename":"Member","id":"199126543","name":"Sherry Dwelle","memberPhoto":{"__ref":"PhotoInfo:326326713"}},"Member:480404262":{"__typename":"Member","id":"480404262","name":"harini.nitt","memberPhoto":{"__ref":"PhotoInfo:326543009"}},"Member:480753694":{"__typename":"Member","id":"480753694","name":"tamara96","memberPhoto":{"__ref":"PhotoInfo:325541948"}},"Member:476089854":{"__typename":"Member","id":"476089854","name":"annacanales166","memberPhoto":{"__ref":"PhotoInfo:324724399"}},"Member:461518070":{"__typename":"Member","id":"461518070","name":"Ani","memberPhoto":{"__ref":"PhotoInfo:324951244"}},"Member:184457208":{"__typename":"Member","id":"184457208","name":"Jean Horta","memberPhoto":{"__ref":"PhotoInfo:272042314"}},"Member:473448037":{"__typename":"Member","id":"473448037","name":"Manasi","memberPhoto":{"__ref":"PhotoInfo:326027839"}},"Event:317298027":{"__typename":"Event","id":"317298027","dateTime":"2026-12-02T16:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"big-data-gods","__ref":"Group:7972442"},"title":"TechConnect - Virtual Job and Networking Event for Data AI Tech Professionals","description":"**Welcome to TechConnect: Virtual Job \u0026 Networking Event for Data, AI, \u0026 Tech Professionals!**\nAre you a professional in the fields of data, AI, or technology? TechConnect is the premier virtual networking event that brings together data scientists, AI specialists, software developers, and tech enthusiasts to connect with employers and explore exciting career opportunities in the tech industry.\nEvent Details:\n\n* Time: 4-6 pm (Local Time)\n* Venue: Virtual. RSVP [here](https://events.tao.ai/pod/tech.specialists.club/cont-te5gd5wngmz9)\n* Hosted by: No Worker Left Behind (NWLB)\n\nWhy Attend TechConnect?\n\n* Discover Job Opportunities: Access a wide range of job openings in data science, artificial intelligence, machine learning, software development, cybersecurity, and more.\n* Network with Peers: Connect with tech recruiters, hiring managers, and professionals from leading companies in the tech space.\n* Career Development: Get valuable tips on building a successful tech career, advancing in your current role, or transitioning to new areas in the tech field.\n\nHow to Participate:\n\n1. Register: Create your profile and complete your settings on this platform.\n2. RSVP for the Event: Secure your spot to access job listings and network with tech employers and industry experts.\n3. Engage with the Community: Join discussions, share your experiences, and connect with fellow tech professionals to explore new career paths.\n\nFor Data, AI, \u0026 Tech Professionals: Whether you're a seasoned data scientist, AI engineer, software developer, or just starting in tech, TechConnect offers the networking and resources you need to excel in your career.\nInvite Your Network: Know someone in tech? Share TechConnect with them and help grow their professional network and career opportunities in data, AI, and tech.\nTags: #TechCareers, #DataScienceJobs, #AIJobs, #MachineLearningCareers, #SoftwareDevelopment, #TechNetworking, #DataJobs, #AIProfessionals, #TechOpportunities, #VirtualJobFair, #CybersecurityJobs, #CloudComputing, #TechIndustry, #TechCareerGrowth, #TechHiring, #TechTalent, #TechConnect, #JobFairTech, #AIAndDataCareers, #CareerInTech","eventType":"ONLINE","eventUrl":"https://www.meetup.com/big-data-gods/events/317298027/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:525757364"},"displayPhoto":{"__ref":"PhotoInfo:525757364"},"feeSettings":null,"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":27,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326326713"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326543009"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:325541948"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:324724399"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:324951244"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272042314"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326027839"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":8,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:197078094"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:199126543"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:480404262"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:480753694"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:476089854"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:461518070"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:184457208"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:473448037"}}}]},"series":{"__typename":"Series","description":"Every 1st Wednesday of the month until December 2, 2026","weeklyRecurrence":null,"monthlyRecurrence":{"__typename":"MonthlyRecurrenceInfo","monthlyDayOfWeek":"WEDNESDAY","monthlyWeekOfMonth":1},"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:317298027"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537130570":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/9/4/a/highres_537130570.jpeg","id":"537130570"},"PhotoInfo:505128407":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/d/1/7/highres_505128407.jpeg","id":"505128407"},"Group:36420270":{"__typename":"Group","id":"36420270","name":"DataTalks.Club Meetups Global","urlname":"datatalks-meetups-global","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:505128407"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.56,"totalRatings":170}},"isNewGroup":false},"PhotoInfo:324827439":{"__typename":"PhotoInfo","id":"324827439","highResUrl":"https://secure.meetupstatic.com/photos/member/b/9/4/f/highres_324827439.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:323577827":{"__typename":"Member","id":"323577827","name":"DataTalks.Club Events","memberPhoto":{"__ref":"PhotoInfo:324827439"}},"PhotoInfo:326049558":{"__typename":"PhotoInfo","id":"326049558","highResUrl":"https://secure.meetupstatic.com/photos/member/2/5/5/6/highres_326049558.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:479500421":{"__typename":"Member","id":"479500421","name":"pratiklinkedin2005","memberPhoto":{"__ref":"PhotoInfo:326049558"}},"Member:481023935":{"__typename":"Member","id":"481023935","name":"Miranda Gahrmann","memberPhoto":null},"PhotoInfo:278912249":{"__typename":"PhotoInfo","id":"278912249","highResUrl":"https://secure.meetupstatic.com/photos/member/7/d/f/9/highres_278912249.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:243175151":{"__typename":"Member","id":"243175151","name":"Dr Suman Suman","memberPhoto":{"__ref":"PhotoInfo:278912249"}},"Event:317427864":{"__typename":"Event","id":"317427864","title":"How Reliable Are AI Agents That Query Live Data","dateTime":"2026-12-02T03:30:00-08:00","description":"How Reliable Are AI Agents That Query Live Data with Edoardo Dusi\nEdoardo Dusi, Senior Developer Advocate at AWS, talks about what it takes to trust AI agents that query live data, including where they break down and how to check their answers.\nAsk your questions for Edoardo here: [https://qna.dtcdev.click/r/podcast-ai-agents-live-data](https://qna.dtcdev.click/r/podcast-ai-agents-live-data)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/datatalks-meetups-global/events/317427864/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537130570"},"displayPhoto":{"__ref":"PhotoInfo:537130570"},"feeSettings":null,"group":{"__ref":"Group:36420270"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":4,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:323577827"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member"