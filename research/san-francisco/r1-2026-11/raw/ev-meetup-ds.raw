07"}},"PhotoInfo:317920025":{"__typename":"PhotoInfo","id":"317920025","highResUrl":"https://secure.meetupstatic.com/photos/member/9/c/5/9/highres_317920025.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:409220946":{"__typename":"Member","id":"409220946","name":"Sridhar","memberPhoto":{"__ref":"PhotoInfo:317920025"}},"PhotoInfo:245015766":{"__typename":"PhotoInfo","id":"245015766","highResUrl":"https://secure.meetupstatic.com/photos/member/8/b/b/6/highres_245015766.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:170378192":{"__typename":"Member","id":"170378192","name":"Dennis","memberPhoto":{"__ref":"PhotoInfo:245015766"}},"PhotoInfo:19864691":{"__typename":"PhotoInfo","id":"19864691","highResUrl":"https://secure.meetupstatic.com/photos/member/1/2/5/3/highres_19864691.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:21291201":{"__typename":"Member","id":"21291201","name":"Vincent Button","memberPhoto":{"__ref":"PhotoInfo:19864691"}},"PhotoInfo:249391708":{"__typename":"PhotoInfo","id":"249391708","highResUrl":"https://secure.meetupstatic.com/photos/member/7/b/d/c/highres_249391708.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:192049571":{"__typename":"Member","id":"192049571","name":"Nicolas Cabrera","memberPhoto":{"__ref":"PhotoInfo:249391708"}},"Member:426007475":{"__typename":"Member","id":"426007475","name":"Lu de Souza","memberPhoto":null},"PhotoInfo:307057654":{"__typename":"PhotoInfo","id":"307057654","highResUrl":"https://secure.meetupstatic.com/photos/member/9/3/1/6/highres_307057654.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:277527916":{"__typename":"Member","id":"277527916","name":"Nhi Nguyen","memberPhoto":{"__ref":"PhotoInfo:307057654"}},"PhotoInfo:270416943":{"__typename":"PhotoInfo","id":"270416943","highResUrl":"https://secure.meetupstatic.com/photos/member/d/e/6/f/highres_270416943.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:235853473":{"__typename":"Member","id":"235853473","name":"Patrick Nicolas","memberPhoto":{"__ref":"PhotoInfo:270416943"}},"PhotoInfo:325089705":{"__typename":"PhotoInfo","id":"325089705","highResUrl":"https://secure.meetupstatic.com/photos/member/2/5/e/9/highres_325089705.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:231349645":{"__typename":"Member","id":"231349645","name":"Pranav Padmane","memberPhoto":{"__ref":"PhotoInfo:325089705"}},"Event:317318556":{"__typename":"Event","id":"317318556","title":"Build an Agentic AI Model Factory: Own Your AI","dateTime":"2026-12-09T12:00:00-08:00","description":"​**Build a Sovereign AI Factory: an ML Engineer Agent that evaluates, fine-tunes, deploys, and improves open models.**\nRSVP on Luma for live link: https://luma.com/vfhq98ji\n\n​AI teams are starting to look beyond renting every capability from an external API, they're building systems they own and control. In this hands-on session we'll build exactly that by creating an ML Engineer Agent that will manage a model factory to select and fine-tune the best models for your applications.\n\n​We'll start with a walkthrough where we build an agent that evaluates open models in parallel, fine-tunes promising candidates, deploys the winner, and retrains automatically when performance drops. Think of it as the first brick in your own **model factory**: a repeatable system for evaluating, improving, and deploying models *you* control.\n\n​You'll see how [Union.ai](https://union.ai/?utm_source=luma) \u0026 Flyte give your AI workflows a **durable runtime** with *infrastructure as context,* so agents adapt infra resources, recover from failures, and keep moving without re-running completed work. And because it all runs in **your own cloud**, you own the full stack end to end: **your models, your data, your infrastructure, your IP.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318556/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537006691"},"displayPhoto":{"__ref":"PhotoInfo:537006691"},"feeSettings":null,"group":{"__ref":"Group:37611478"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":35,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:128320322"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:75593802"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:208020395"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:186964545"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485083030"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:255456816"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:216134378"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:40689492"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:473662108"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:249240604"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:409220946"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:170378192"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:21291201"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:184561930"}}},{"__typename":"RsvpEdge","node":{"__