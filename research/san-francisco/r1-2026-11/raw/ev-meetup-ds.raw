tupstatic.com/photos/member/d/d/7/e/highres_278876702.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:273995656":{"__typename":"PhotoInfo","id":"273995656","highResUrl":"https://secure.meetupstatic.com/photos/member/8/b/4/8/highres_273995656.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:286030230":{"__typename":"PhotoInfo","id":"286030230","highResUrl":"https://secure.meetupstatic.com/photos/member/2/7/f/6/highres_286030230.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326623663":{"__typename":"PhotoInfo","id":"326623663","highResUrl":"https://secure.meetupstatic.com/photos/member/a/a/8/f/highres_326623663.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:422112058":{"__typename":"Member","id":"422112058","name":"Evelyn Miller","memberPhoto":{"__ref":"PhotoInfo:326623663"}},"PhotoInfo:320130112":{"__typename":"PhotoInfo","id":"320130112","highResUrl":"https://secure.meetupstatic.com/photos/member/7/5/a/0/highres_320130112.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:327746702":{"__typename":"Member","id":"327746702","name":"Gokhan","memberPhoto":{"__ref":"PhotoInfo:320130112"}},"PhotoInfo:312352473":{"__typename":"PhotoInfo","id":"312352473","highResUrl":"https://secure.meetupstatic.com/photos/member/c/c/f/9/highres_312352473.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:315770441":{"__typename":"Member","id":"315770441","name":"Dr. Murat Baday","memberPhoto":{"__ref":"PhotoInfo:312352473"}},"PhotoInfo:321538591":{"__typename":"PhotoInfo","id":"321538591","highResUrl":"https://secure.meetupstatic.com/photos/member/e/4/d/f/highres_321538591.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:122733212":{"__typename":"Member","id":"122733212","name":"Murat Baday","memberPhoto":{"__ref":"PhotoInfo:321538591"}},"PhotoInfo:322527972":{"__typename":"PhotoInfo","id":"322527972","highResUrl":"https://secure.meetupstatic.com/photos/member/6/d/4/4/highres_322527972.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:332483692":{"__typename":"Member","id":"332483692","name":"Magnimind Academy","memberPhoto":{"__ref":"PhotoInfo:322527972"}},"Member:290132061":{"__typename":"Member","id":"290132061","name":"Vishnu Prashanth","memberPhoto":{"__ref":"PhotoInfo:303441520"}},"Member:482758371":{"__typename":"Member","id":"482758371","name":"miguel","memberPhoto":{"__ref":"PhotoInfo:325989334"}},"Member:311716030":{"__typename":"Member","id":"311716030","name":"Tushar Jain","memberPhoto":{"__ref":"PhotoInfo:299763665"}},"Event:317473011":{"__typename":"Event","id":"317473011","title":"Info Session on Mentor-Led Data Science Internship Program","dateTime":"2026-12-12T11:00:00-08:00","description":"Please register using the zoom link to get a reminder:\n\nhttps://us02web.zoom.us/webinar/register/8617335660229/WN_baWalUCNS1Op_cp9UHkCgw\n\nAttention all aspiring data scientists! Magnimind Academy has one-of-its-kind mentorship and internship program for students lacking a portfolio but having the fundamentals. This fifteen-week boot camp is designed to provide you with:\n\n-Real industry projects\n-Expert data scientists\n-Project-based intensive training\n-Mock interviews -Resume polish\n-Post-interview feedback\n\nWe will be hosting an information session to discuss the program in more detail. Whether you're a recent graduate or looking to transition into the field, this program is perfect for those who are serious about a career in data science.\n\nJoin us to learn more about this exciting program and get your questions answered. RSVP now to reserve your spot!\n\nAgenda:\n(PDT) 11:00 am - 11:05 am Arrival and socializing and Opening\n(PDT) 11:05 am - 12:00 pm \"Info Session on Mentor-Led Data Science Internship Program\"\n(PDT) 12:00 pm - 12:10 pm Q\u0026A\n\nAbout Dr. Murat Baday:\n\nDr. Baday is the co-founder of Magnimind Academy. He is passionate about everything related to data science, education, and entrepreneurship. He received a biophysics PhD from the University of Illinois and continued his studies at Stanford Univ as a Postdoc. He has published several papers and patents and he is the co-founder of several biotechs and AI startups.\n\nAbout Dr. Yasin Ceran:\n\nYasin Ceran is passionate about all things data and holds a vast experience in data analysis, mathematical modeling and Apache Spark, and in SQL, Python and R. He is currently an associate professor at KAIST, South Korea, as well as teaching at San Jose State University at the heart of Silicon Valley. Yasin has worked rigorously on an array of data-related projects encompassing data mining, statistics, modeling, and is dedicated to sharing his experience and expertise with learners.\n\nPlease register using the zoom link to get a reminder:\n\nhttps://us02web.zoom.us/webinar/register/8617335660229/WN_baWalUCNS1Op_cp9UHkCgw","eventType":"ONLINE","eventUrl":"https://www.meetup.com/introduction-to-data-science/events/317473011/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537187809"},"displayPhoto":{"__ref":"PhotoInfo:537187809"},"feeSettings":null,"group":{"__ref":"Group:29235959"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":47,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:303441520"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:278912249"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:325989334"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:299763665"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:278876702"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:273995656"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:286030230"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":9,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:422112058"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:327746702"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:315770441"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:122733212"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:332483692"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:290132061"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:243175151"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:482758371"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:311716030"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537130413":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/8/a/d/highres_537130413.jpeg","id":"537130413"},"Member:509897":{"__typename":"Member","id":"509897","name":"Chris E","memberPhoto":null},"PhotoInfo:290918290":{"__typename":"PhotoInfo","id":"290918290","highResUrl":"https://secure.meetupstatic.com/photos/member/9/5/9/2/highres_290918290.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:264527206":{"__typename":"Member","id":"264527206","name":"Frank Merwerth ","memberPhoto":{"__ref":"PhotoInfo:290918290"}},"PhotoInfo:324378823":{"__typename":"PhotoInfo","id":"324378823","highResUrl":"https://secure.meetupstatic.com/photos/member/4/9/8/7/highres_324378823.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:341071310":{"__typename":"Member","id":"341071310","name":"Cevik","memberPhoto":{"__ref":"PhotoInfo:324378823"}},"Event:317427643":{"__typename":"Event","id":"317427643","title":"From Ad-Hoc SQL to AI Agents","dateTime":"2026-12-01T08:00:00-08:00","description":"From Ad-Hoc SQL to AI Agents with Madhu Gurramkonda\nMadhu Gurramkonda, Head of Data Analytics and AI at Amazon (speaking in a personal capacity), talks about how a data team moves from answering ad-hoc SQL requests one at a time to running AI agents that business teams can use, including the foundations that come first and how to check answers before anyone sees them.\nAsk your questions for Madhu here: [https://qna.dtcdev.click/r/podcast-from-ad-hoc-sql-to-ai-agents](https://qna.dtcdev.click/r/podcast-from-ad-hoc-sql-to-ai-agents)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/datatalks-meetups-global/events/317427643/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537130413"},"displayPhoto":{"__ref":"PhotoInfo:537130413"},"feeSettings":null,"group":{"__ref":"Group:36420270"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":6,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:323577827"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:479500421"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:509897"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:264527206"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:341071310"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:243175151"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:530811247":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/8/2/f/highres_530811247.jpeg","id":"530811247"},"PhotoInfo:530811686":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/9/e/6/highres_530811686.jpeg","id":"530811686"},"Group:20910460":{"__typename":"Group","id":"20910460","name":"AI Performance Engineering Meetup (SF2)","urlname":"ai-performance-engineering-sf2","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:530811686"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":5,"totalRatings":16}},"isNewGroup":false},"PhotoInfo:261568117":{"__typename":"PhotoInfo","id":"261568117","highResUrl":"https://secure.meetupstatic.com/photos/member/6/d/d/5/highres_261568117.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:279975840":{"__typename":"PhotoInfo","id":"279975840","highResUrl":"https://secure.meetupstatic.com/photos/member/3/d/e/0/highres_279975840.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:245799031":{"__typename":"PhotoInfo","id":"245799031","highResUrl":"https://secure.meetupstatic.com/photos/member/9/8/7/7/highres_245799031.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:60549462":{"__typename":"PhotoInfo","id":"60549462","highResUrl":"https://secure.meetupstatic.com/photos/member/2/4/f/6/highres_60549462.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:275920665":{"__typename":"PhotoInfo","id":"275920665","highResUrl":"https://secure.meetupstatic.com/photos/member/9/e/d/9/highres_275920665.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:250498727":{"__typename":"PhotoInfo","id":"250498727","highResUrl":"https://secure.meetupstatic.com/photos/member/e/5/6/7/highres_250498727.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:7880149":{"__typename":"PhotoInfo","id":"7880149","highResUrl":"https://secure.meetupstatic.com/photos/member/4/e/b/5/highres_7880149.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:14250450":{"__typename":"Member","id":"14250450","name":"Chris Fregly","memberPhoto":{"__ref":"PhotoInfo:261568117"}},"PhotoInfo:295205782":{"__typename":"PhotoInfo","id":"295205782","highResUrl":"https://secure.meetupstatic.com/photos/member/1/6/9/6/highres_295205782.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:297055394":{"__typename":"Member","id":"297055394","name":"Chris Fregly","memberPhoto":{"__ref":"PhotoInfo:295205782"}},"Event:317171691":{"__typename":"Event","id":"317171691","title":"Make Your GPU Earn Its Keep: A Kernel Engineering Deep Dive","dateTime":"2026-11-30T09:00:00-08:00","description":"**Monday, November 30, 2026 · 9:00–10:00 AM PST · Online**\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\nA powerful GPU can spend plenty of time waiting. What is it waiting for—and how do you find out?\n**Talk #0: Welcome and Meetup Updates**\nby Chris Fregly and Antje Barth\n**Talk #1: From “Why Is This Slow?” to a Faster Kernel**\nby Dr. Rajat “Raj” Dandekar, Co-founder of Vizuara\nJoin Raj for a focused tour of the engineering behind fast AI kernels, drawing on Vizuara’s Kernel Engineering course on Maven. We’ll connect the roofline model to CUDA execution and the GPU memory hierarchy, then look at how profiling guides optimizations such as coalesced memory access, tiling, and tensor-core use. Matrix multiplication and attention provide context for seeing how those ideas fit together in modern AI workloads, including FlashAttention.\nThe goal is a practical way to decide what to measure, which bottleneck matters, and whether an optimization helped. The session is dedicated to Raj’s talk, with time for audience questions.\n**Who it’s for:** Engineers comfortable with Python or basic PyTorch. Prior CUDA or C++ experience is not required.\n**Bio:** Dr. Rajat Dandekar is a co-founder of Vizuara and a Kernel Engineering course instructor. He holds a PhD in Mechanical Engineering from Purdue University and BTech and MTech degrees from IIT Madras.\n**Based on:** [Kernel Engineering: From CUDA Foundations to Frontier AI Kernels](https://maven.com/rajat-dandekar/kernel-engineering)\n**Scheduling note:** November 30 is the proposed new date; speaker confirmation is pending.\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\n**Related Links**\nGithub Repo: [http://github.com/cfregly/ai-performance-engineering/](http://github.com/cfregly/ai-performance-engineering/)\nO’Reilly Book: [https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/](https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/)\nYouTube: [https://www.youtube.com/@AIPerformanceEngineering](https://www.youtube.com/@AIPerformanceEngineering)\nGenerative AI Free Course on DeepLearning.ai: [https://bit.ly/gllm](https://bit.ly/gllm)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-performance-engineering-sf2/events/317171691/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:530811247"},"displayPhoto":{"__ref":"PhotoInfo:530811247"},"feeSettings":null,"group":{"__ref":"Group:20910460"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":47,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:261568117"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:279975840"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:245799031"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:60549462"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:275920665"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:250498727"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:7880149"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:14250450"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:297055394"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537132220":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/f/b/c/highres_537132220.jpeg","id":"537132220"},"PhotoInfo:319511705":{"__typename":"PhotoInfo","id":"319511705","highResUrl":"https://secure.meetupstatic.com/photos/member/2/d/b/9/highres_319511705.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:298145820":{"__typename":"Member","id":"298145820","name":"Charles Stockman","memberPhoto":{"__ref":"PhotoInfo:319511705"}},"Event:317429299":{"__typename":"Event","id":"317429299","title":"The Real Cost of a Useful AI Feature","dateTime":"2026-12-01T03:30:00-08:00","description":"The Real Cost of a Useful AI Feature with Ian Vanagas\nIan Vanagas, Editorial Lead at PostHog, talks about what it actually costs to ship an AI feature that people use, including the product and engineering work around the model itself.\nAsk your questions for Ian here: [https://qna.dtcdev.click/r/podcast-the-real-cost-of-a-useful-ai-feature](https://qna.dtcdev.click/r/podcast-the-real-cost-of-a-useful-ai-feature)\nWe will stream live on our YouTube channel: https://www.youtube.com/c/DataTalksClub\nDataTalks.Club is the place to talk about data. Join our Slack: https://datatalks.club/slack.html","eventType":"ONLINE","eventUrl":"https://www.meetup.com/datatalks-meetups-global/events/317429299/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537132220"},"displayPhoto":{"__ref":"PhotoInfo:537132220"},"feeSettings":null,"group":{"__ref":"Group:36420270"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:323577827"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:298145820"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:509897"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537130636":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/9/8/c/highres_537130636.jpeg","id":"537130636"},"Event:317427888":{"__typename":"Event","id":"317427888","title":"From HR Reports to People Analytics with AI","dateTime":"2026-11-30T03:30:00-08:00","description":"From HR Reports to People Analytics with AI with Sofiia Hordiienko\nSofiia Hordiienko, HR Data Analyst, talks about moving from routine HR reports to people analytics that actually helps leaders decide, including how she uses Power BI, SQL, Excel, and Python, and how AI fits into that work.\nAsk your questions for Sofiia here: [https://qna.dtcdev.click/r/podcast-people-analytics-ai](https://qna.dtcdev.click/r/podcast-people-analytics-ai)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/datatalks-meetups-global/events/317427888/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537130636"},"displayPhoto":{"__ref":"PhotoInfo:537130636"},"feeSettings":null,"group":{"__ref":"Group:36420270"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:323577827"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:509897"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:243175151"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:533993982":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/2/d/e/highres_533993982.jpeg","id":"533993982"},"PhotoInfo:531091585":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/7/b/6/1/highres_531091585.jpeg","id":"531091585"},"Group:38241400":{"__typename":"Group","id":"38241400","name":"Hedge West SF - Quant, Data, and AI","urlname":"hedge-west-sf-quant-data-and-ai","timezone":"America/Los_Angeles","keyGroupPhoto":{"__r