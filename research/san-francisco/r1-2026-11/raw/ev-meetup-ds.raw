"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485454248"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:50039782"}}}]},"series":null,"venue":{"__typename":"Venue","name":"House of AI","address":"40 Boardman Pl","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:537236664":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/d/5/8/highres_537236664.jpeg","id":"537236664"},"PhotoInfo:26977352":{"__typename":"PhotoInfo","id":"26977352","highResUrl":"https://secure.meetupstatic.com/photos/member/9/1/e/8/highres_26977352.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:521544":{"__typename":"Member","id":"521544","name":"Josh","memberPhoto":{"__ref":"PhotoInfo:26977352"}},"Event:317528615":{"__typename":"Event","id":"317528615","title":"Building Reliable Data Pipelines with AI Agents","dateTime":"2026-12-14T03:30:00-08:00","description":"Building Reliable Data Pipelines with AI Agents with Hrishi Olickel\nHrishi Olickel, co-founder and CEO of Southbridge AI, talks about putting AI agents to work inside messy operational data pipelines: the silent failures that happen when models touch tabular data, deterministic code guards around model steps, and testing pipelines against checked edge cases.\nAsk your questions for Hrishi here: [https://qna.dtcdev.click/r/podcast-data-pipelines-ai-agents](https://qna.dtcdev.click/r/podcast-data-pipelines-ai-agents)\nWe will stream live on our YouTube channel: [https://www.youtube.com/@DataTalksClub](https://www.youtube.com/@DataTalksClub)\nDataTalks.Club is the place to talk about data. Join our Slack community: [https://datatalks.club/slack.html](https://datatalks.club/slack.html)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/datatalks-meetups-global/events/317528615/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537236664"},"displayPhoto":{"__ref":"PhotoInfo:537236664"},"feeSettings":null,"group":{"__ref":"Group:36420270"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":4,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:323577827"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:521544"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:298145820"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:264527206"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:459993399":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/8/2/7/7/highres_459993399.jpeg","id":"459993399"},"Group:19165930":{"__typename":"Group","id":"19165930","name":"Silicon Valley AI, Machine Learning, Big Data Entrepreneurs","urlname":"Silicon-Valley-Machine-Learning-Learners-and-Entrepreneurs","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:459993399"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.03,"totalRatings":62}},"isNewGroup":false},"PhotoInfo:251744791":{"__typename":"PhotoInfo","id":"251744791","highResUrl":"https://secure.meetupstatic.com/photos/member/a/e/f/7/highres_251744791.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:12193373":{"__typename":"Member","id":"12193373","name":"Albert","memberPhoto":{"__ref":"PhotoInfo:251744791"}},"Event:317563808":{"__typename":"Event","id":"317563808","title":"Beyond Analytics: Turning Microsoft Fabric Insights Into Decisions","dateTime":"2026-12-01T07:00:00-08:00","description":"This event is organized by SAS.\n\nThis event is being promoted by many groups.\n\nOur meetup group is participating by promoting this event.\nOur meetup group is collaborating by promoting this event.\n\nThis is an online event.\n\nAttendees can be located anywhere in the world!\n\nThis event is FREE to attend!\n\nIn order to attend, please register here:\n[https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html](https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html)\nOrganizations have more data, analytics and predictive capabilities than ever. Yet turning those insights into timely, consistent business decisions remains a challenge.\nDisconnected systems, manual processes and fragmented operations often stand in the way. For example, banks have customer data, predictive models and business criteria spread throughout the organization, slowing loans and credit decisions.\nJoin experts from SAS and Katalyze to explore how decision intelligence bridges the gap between insights, actions and business outcomes. Discover how SAS Decision Builder on Microsoft Fabric helps organizations connect analytics, business rules and organizational judgment to make more consistent, governed decisions.\n\n## You’ll learn more about:\n\n* Bridging the decision gap: Why insights don’t always translate into action and business outcomes – and how decision intelligence helps.\n* Connecting decision-making components: How business rules, predictive models, organizational judgment and governance work together.\n* Overcoming organizational barriers: How to address disconnected workflows, manual processes and unclear decision ownership.\n* Operationalizing decisions with SAS: How SAS Decision Builder on Microsoft Fabric orchestrates governed decision workflows using data in Microsoft OneLake.\n* Putting decision intelligence into practice: How SAS and Katalyze can help identify high-value decisioning opportunities in the pharmaceutical, financial services and legal industries.\n\nTry SAS Decision Builder for free today: [https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview](https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/silicon-valley-machine-learning-learners-and-entrepreneurs/events/317563808/","isAttending":false,"isSaved":false,"maxTickets":100,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:459993399"},"feeSettings":null,"group":{"__ref":"Group:19165930"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:12193373"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:525050934":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/6/f/6/highres_525050934.jpeg","id":"525050934"},"PhotoInfo:520924685":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/2/4/d/highres_520924685.jpeg","id":"520924685"},"Group:18224500":{"__typename":"Group","id":"18224500","name":"Analytics.Club San Francisco","urlname":"ac-sfo","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:520924685"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":3.53,"totalRatings":15}},"isNewGroup":false},"PhotoInfo:9183390":{"__typename":"PhotoInfo","id":"9183390","highResUrl":"https://secure.meetupstatic.com/photos/member/d/3/e/highres_9183390.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:260316712":{"__typename":"PhotoInfo","id":"260316712","highResUrl":"https://secure.meetupstatic.com/photos/member/8/f/6/8/highres_260316712.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:281246326":{"__typename":"PhotoInfo","id":"281246326","highResUrl":"https://secure.meetupstatic.com/photos/member/6/6/d/6/highres_281246326.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:16398171":{"__typename":"PhotoInfo","id":"16398171","highResUrl":"https://secure.meetupstatic.com/photos/member/4/6/f/b/highres_16398171.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:64811452":{"__typename":"PhotoInfo","id":"64811452","highResUrl":"https://secure.meetupstatic.com/photos/member/2/c/b/c/highres_64811452.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:11230467":{"__typename":"PhotoInfo","id":"11230467","highResUrl":"https://secure.meetupstatic.com/photos/member/2/8/e/3/highres_11230467.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:11887163":{"__typename":"PhotoInfo","id":"11887163","highResUrl":"https://secure.meetupstatic.com/photos/member/1/b/f/b/highres_11887163.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:241905978":{"__typename":"PhotoInfo","id":"241905978","highResUrl":"https://secure.meetupstatic.com/photos/member/b/3/9/a/highres_241905978.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:182788010":{"__typename":"Member","id":"182788010","name":"Vishal Kumar","memberPhoto":{"__ref":"PhotoInfo:241905978"}},"Event:317530584":{"__typename":"Event","id":"317530584","dateTime":"2026-12-11T14:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"ac-sfo","__ref":"Group:18224500"},"title":"AIConnect: Global Virtual Job \u0026 Career Networking Event for AI Specialists","description":"Are you an AI engineer, data scientist, machine learning researcher, or aspiring innovator in the world of artificial intelligence? **AIConnect** is your dynamic **AI networking event online** designed to foster real-time conversations, career growth, and collaboration opportunities — all within a vibrant and self-led virtual space.\n\nWhether you're exploring job roles in AI, hoping to demo your latest project, or searching for your next co-developer or data scientist partner, **AIConnect** offers a one-of-a-kind experience to connect with the global **machine learning community meetup** — anytime, from anywhere.\n\n🎥 **Watch how it works in our explainer video:**\n👉 [https://www.youtube.com/watch?v=bH3uNrkUTuw](https://www.youtube.com/watch?v=bH3uNrkUTuw)\n**💡 Why Join AIConnect?**\n\nThis is not just another virtual event. It’s a **collaboration platform for AI specialists** where you can grow your professional network, showcase your AI/ML portfolio, exchange ideas, and chat directly with fellow participants, recruiters, and service providers.\nDesigned for **AI career fair virtual** seekers and builders alike, the platform supports live 1-1 **video or text chats**, and offers open access to diverse community-led channels tailored to your interests.\n**💬 Brainstorming \u0026 Discussion Channels Include:**\n\n* **General** – Your go-to hub for announcements, orientation, and casual community-wide conversation.\n* **Intros** – Introduce yourself, your research, your startup, or just share your journey in AI.\n* **Networking** – Showcase your AI/ML projects, portfolios, startup pitches, or job aspirations.\n* **Help Wanted** – Looking for team members, mentorship, freelance gigs, or offering support? Post here.\n* **Industry Room Tech** – Dive into the latest developments in AI frameworks, ML pipelines, data tools, and tech trends.\n\nWhether you’re a beginner or a pro, a researcher or a recruiter — this space empowers growth through **project demos, career discussions, and research conversations.**\n**🧠 What You’ll Gain:**\n\n* Direct access to a **global AI talent and hiring ecosystem**\n* Exposure to cutting-edge projects via the **AI project showcase event**\n* Connections with peers and thought leaders across AI, ML, and data science\n* Career insights and opportunities from fellow professionals and employers\n* A flexible environment to network, brainstorm, and build meaningful collaborations\n* Instant 1-on-1 video or text chats for deeper engagement\n\n**📍 Where:**\nJoin virtually at:\n👉 [https://events.tao.ai/pod/analytics.club/jknf0o9m3kix](https://events.tao.ai/pod/analytics.club/jknf0o9m3kix)\n**🕔 When:**\nEvery session starts at **5:00 PM – 7:00 PM local time** — recurring monthly on Fridays. Mark your calendar and come prepared to connect!\n**👥 Who Should Attend:**\n\n* AI engineers, ML developers, and data scientists\n* Startup founders and entrepreneurs in the AI/tech space\n* Recruiters, hiring managers, and project collaborators\n* Students, academics, and early-career professionals\n* Anyone passionate about AI, machine learning, and applied tech innovation\n\n**📩 Questions or Suggestions?**\nWe’d love to hear from you. Reach us anytime here:\n👉 [https://noworkerleftbehind.org/event_support](https://noworkerleftbehind.org/event_support)\n**🔖 Hashtags:**\n#AIConnect #AINetworkingEventOnline #AICareerFairVirtual #MachineLearningCommunityMeetup #AIProjectShowcaseEvent #CollaborationPlatformForAISpecialists #MLJobs #GlobalAINetworking #TechNetworkingEvent #AIProfessionalsUnite","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ac-sfo/events/317530584/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:525050934"},"displayPhoto":{"__ref":"PhotoInfo:525050934"},"feeSettings":null,"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":22,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:9183390"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260316712"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:281246326"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:16398171"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:64811452"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:11230467"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:11887163"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:182788010"}}}]},"series":{"__typename":"Series","description":"Every 2nd Friday of the month until December 11, 2026","weeklyRecurrence":null,"monthlyRecurrence":{"__typename":"MonthlyRecurrenceInfo","monthlyDayOfWeek":"FRIDAY","monthlyWeekOfMonth":2},"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:317530584"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}}},"_sentryTraceData":"ae2302638744d58e26a1e81f769269ae-fa0e64e2b14cb839-0","_sentryBaggage":"sentry-environment=production,sentry-release=ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb,sentry-public_key=5d12cd2317664353456ab4c40d079af2,sentry-trace_id=ae2302638744d58e26a1e81f769269ae,sentry-org_id=6787,sentry-sampled=false,sentry-sample_rand=0.3765968309509149,sentry-sample_rate=0.01"},"__N_SSP":true},"page":"/find","query":{"keywords":"data science","location":"us--ca--San Francisco","source":"EVENTS"},"buildId":"ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb","isFallback":false,"isExperimentalCompile":false,"gssp":true,"locale":"en-US","locales":["en-US","en-AU","de","de-DE","es","es-ES","fr","fr-FR","it","it-IT","ja","ja-JP","ko","ko-KR","nl","nl-NL","pl","pl-PL","pt","pt-BR","ru","ru-RU","tr","tr-TR","th-TH"],"defaultLocale":"en-US","scriptLoader":[]}</script></body></html>