					<h3>Event Details</h3>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Event Type</span><div class="formRowColWide">
						<oncord-combobox id="event_type" aria-label="Event Type" data-validations="\Controls\Forms\Validations\Mandatory" style class name="event_type"><input type="hidden" id="event_type" aria-label="Event Type" data-validations="\Controls\Forms\Validations\Mandatory" style class name="event_type" onchange="triggerEventAjax(this, &quot;onchange&quot;, &quot;event_type_ajaxevent&quot;, null, event); " value=""><script type="application/json">[{"value":"","label":"\u2014 Select an Event Type \u2014"},{"value":"Presentation","label":"Presentation"},{"value":"Conference (no slideshow)","label":"Conference (no slideshow)"},{"value":"Conference with Slideshow","label":"Conference with Slideshow"},{"value":"Movie Screening","label":"Movie Screening"},{"value":"Private Event","label":"Private Event"},{"value":"Other","label":"Other \u2014 please specify below"}]</script></oncord-combobox>
					</div><div class="formRowPadding"></div></div>
					<oncord-ajaxregion id="event_type_ajaxregion">
						
					</oncord-ajaxregion>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Event Description</span><span class="formRowDescription">Brief description of your event, program, or purpose...</span><div class="formRowColWide">
						<textarea id="event_description" aria-label="Event Description" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" autosize="true" name="event_description" style="width: 100%; height: 100px;"></textarea>
					</div><div class="formRowPadding"></div></div>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Expected Number of Attendees</span><span class="formRowDescription">Maximum venue capacity: 74 seated guests.</span><div class="formRowColWide">
						<input id="expected_attendees" aria-label="Expected Number of Attendees" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" data-validations="\Controls\Forms\Validations\Mandatory" type="text" name="expected_attendees" style="width: 100%;" />
					</div><div class="formRowPadding"></div></div>

					<h3>Session &amp; Dates</h3>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Preferred Session</span><div class="formRowColWide">
						<div id="session_preference" class="s8-radiobuttongroup">
							<input type="hidden" name="session_preference_hidden" value="1" /><span class="s8-radiobutton-wrapper" for="s8-formsradiobutton4"><label class="s8-radiobutton-container"><input type="radio" id="s8-formsradiobutton4" aria-label="Preferred Session" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();triggerEventAjax(this, &quot;onchange&quot;, &quot;session_ajaxevent&quot;, null, event);" data-validations="\Controls\Forms\Validations\Mandatory" name="session_preference" value="Evening" /><span class="s8-radiobutton"></span></label><label class="s8-radiobutton-label" for="s8-formsradiobutton4"> Evening (Monday – Sunday)</label></span>
							<span class="s8-radiobutton-wrapper" for="s8-formsradiobutton5"><label class="s8-radiobutton-container"><input type="radio" id="s8-formsradiobutton5" aria-label="Preferred Session" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();triggerEventAjax(this, &quot;onchange&quot;, &quot;session_ajaxevent&quot;, null, event);" data-validations="\Controls\Forms\Validations\Mandatory" name="session_preference" value="Daytime" /><span class="s8-radiobutton"></span></label><label class="s8-radiobutton-label" for="s8-formsradiobutton5"> Daytime (Monday – Saturday)</label></span>
						</div>
					</div><div class="formRowPadding"></div></div>
					<oncord-ajaxregion id="session_ajaxregion">
						
						
					</oncord-ajaxregion>
					<p>Please provide up to three preferred dates in order of preference. Date requests are not a guarantee of availability — AFSF will confirm based on the current schedule.</p>
					<div  class="formRow formRow1Col"><span class="formRowLabel">First Choice Date</span><div class="formRowColWide">
						<oncord-datepicker minDate="26 Nov 2026" showDaysInNextAndPreviousMonths id="preferred_date_1_container"><input type="text" id="preferred_date_1" autocomplete="off" aria-label="First Choice Date" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" data-validations="\Controls\Forms\Validations\Mandatory" name="preferred_date_1" style="width: 8em;" value="26 Nov 2026" placeholder="Date" autocomplete="off" /></oncord-datepicker>
					</div><div class="formRowPadding"></div></div>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Second Choice Date</span><div class="formRowColWide">
						<oncord-datepicker minDate="26 Nov 2026" showDaysInNextAndPreviousMonths id="preferred_date_2_container"><input type="text" id="preferred_date_2" autocomplete="off" aria-label="Second Choice Date" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="preferred_date_2" style="width: 8em;" value="26 Nov 2026" placeholder="Date" autocomplete="off" /></oncord-datepicker>
					</div><div class="formRowPadding"></div></div>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Third Choice Date</span><div class="formRowColWide">
						<oncord-datepicker minDate="26 Nov 2026" showDaysInNextAndPreviousMonths id="preferred_date_3_container"><input type="text" id="preferred_date_3" autocomplete="off" aria-label="Third Choice Date" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="preferred_date_3" style="width: 8em;" value="26 Nov 2026" placeholder="Date" autocomplete="off" /></oncord-datepicker>
					</div><div class="formRowPadding"></div></div>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Are your dates flexible?</span><div class="formRowColWide">
						<div id="dates_flexible" class="s8-radiobuttongroup">
							<input type="hidden" name="dates_flexible_hidden" value="1" /><span class="s8-radiobutton-wrapper" for="s8-formsradiobutton6"><label class="s8-radiobutton-container"><input type="radio" id="s8-formsradiobutton6" aria-label="Are your dates flexible?" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" data-validations="\Controls\Forms\Validations\Mandatory" name="dates_flexible" value="Yes" /><span class="s8-radiobutton"></span></label><label class="s8-radiobutton-label" for="s8-formsradiobutton6"> Yes — I can adjust if my preferred date is unavailable</label></span>
							<span class="s8-radiobutton-wrapper" for="s8-formsradiobutton7"><label class="s8-radiobutton-container"><input type="radio" id="s8-formsradiobutton7" aria-label="Are your dates flexible?" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" data-validations="\Controls\Forms\Validations\Mandatory" name="dates_flexible" value="No" /><span class="s8-radiobutton"></span></label><label class="s8-radiobutton-label" for="s8-formsradiobutton7"> No — my date is fixed</label></span>
						</div>
					</div><div class="formRowPadding"></div></div>

					<h3>Add-On Options</h3>
					<p>Select any additional services you require. Costs shown are for reference.</p>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Catering & Beverages (renter-provided)</span><div class="formRowColWide">
						<input type="hidden" name="addons_hidden[]" value="addon_catering" /><span id="addon_catering_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_catering" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="Catering &amp; Beverages (renter-provided)" /><span class="s8-checkbox"></span></label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">+$150 for Independent Artists &amp; Nonprofits · +$200 for Private Events · Additional cleaning surcharge applies</p>
						<input type="hidden" name="addons_hidden[]" value="addon_alcohol" /><span id="addon_alcohol_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_alcohol" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="Alcohol Service" /><span class="s8-checkbox"></span></label><label class="s8-checkbox-label" for="addon_alcohol"> Alcohol Service</label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">All servers must hold a valid California RBS certification — proof required in advance. Select the option below if you need AFSF to provide a certified server.</p>
						<input type="hidden" name="addons_hidden[]" value="addon_afsf_server" /><span id="addon_afsf_server_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_afsf_server" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="AFSF Event Host as Certified Alcohol Server" /><span class="s8-checkbox"></span></label><label class="s8-checkbox-label" for="addon_afsf_server"> AFSF Event Host as Certified Alcohol Server</label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">+$125 flat fee · Host acts as designated alcohol server only — not general catering staff · Must be confirmed at booking</p>
						<input type="hidden" name="addons_hidden[]" value="addon_projector" /><span id="addon_projector_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_projector" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="Projector" /><span class="s8-checkbox"></span></label><label class="s8-checkbox-label" for="addon_projector"> Projector</label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">Please confirm file format and resolution requirements in the notes below.</p>
						<input type="hidden" name="addons_hidden[]" value="addon_sound" /><span id="addon_sound_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_sound" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="Sound System" /><span class="s8-checkbox"></span></label><label class="s8-checkbox-label" for="addon_sound"> Sound System</label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">Please describe your audio needs (microphone, music playback, etc.) in the notes below.</p>
						<input type="hidden" name="addons_hidden[]" value="addon_movie" /><span id="addon_movie_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_movie" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="Movie Screening" /><span class="s8-checkbox"></span></label><label class="s8-checkbox-label" for="addon_movie"> Movie Screening</label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">Film must be provided in MP4 format at least 5 business days in advance · Renter is responsible for all screening rights and licenses.</p>
						<input type="hidden" name="addons_hidden[]" value="addon_weekend_holiday" /><span id="addon_weekend_holiday_wrapper" class="s8-checkbox-wrapper" tabindex="0"><label class="s8-checkbox-container"><input type="checkbox" id="addon_weekend_holiday" aria-label="Catering &amp; Beverages (renter-provided)" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" name="addons[]" value="Weekend &amp; Holiday Rental (Saturday 1-5 pm / Sunday 9 am-5 pm / Holidays)" /><span class="s8-checkbox"></span></label><label class="s8-checkbox-label" for="addon_weekend_holiday"> Weekend & Holiday Rental (Saturday 1–5 pm / Sunday 9 am–5 pm / Holidays)</label></span>
						<p style="font-size: 13px; color: #696A6C; margin: 2px 0 12px;">+$60 per hour front desk staffing surcharge · Alcohol service and AFSF event host are not available · All other add-on fees and policies apply.</p>
					</div><div class="formRowPadding"></div></div>

					<h3>Additional Notes</h3>
					<div  class="formRow formRow1Col"><span class="formRowLabel">Anything else we should know?</span><span class="formRowDescription">Technical requirements, accessibility needs, special setup requests, questions about the space...</span><div class="formRowColWide">
						<textarea id="additional_notes" aria-label="Anything else we should know?" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" autosize="true" name="additional_notes" style="width: 100%; height: 120px;"></textarea>
					</div><div class="formRowPadding"></div></div>

					<div class="alert">
						<strong>Full payment is due 10 days before the event.</strong> The rental is not confirmed until payment is received. All fees are non-refundable.
					</div>
					<div  class="formRow formRow1Col"><div class="formRowColWide">
						<button type="submit" id="s8-formssubmitbutton1" onchange="if (this.value &amp;&amp; this.value.trim) this.value = this.value.trim();" onclick="var nForm = this.form;nForm.submitButton = this;" name="s8-formssubmitbutton1" value="1">Submit Rental Request</button>
					</div><div class="formRowPadding"></div></div>

					
				</form>

			</div>
		</div>
	</body>
</html>

				
					
						
					
				
