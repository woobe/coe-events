							</li></ul><script>
(()=>{
	let n = document.getElementById("navMain");
	if (!n) return;
	let arrClasses = ["s8-navigationPrimaryItem--active"];
	let strPath = window.location.pathname;
	n.querySelectorAll('a').forEach((a) => {
		// Skip placeholder anchors (href="" or "#...") so they don't falsely resolve to the current URL
		let strRaw = a.getAttribute('href') || '';
		if (!strRaw || strRaw[0] === '#') return;
		let oURL, p;
		try { oURL = new URL(a.href); p = oURL.pathname; } catch (e) { return; }
		if (oURL.host !== window.location.host) return;
		let bActive = strPath === p || (p && p !== '/' && strPath.startsWith(p));
		if (!bActive) return;
		let nLI = a.closest('li');
		if (nLI && n.contains(nLI)) for (let c of arrClasses) nLI.classList.add(c);
	});
})();
</script><script>
(()=>{
	let n = document.getElementById("navMain");
	if(n && window.matchMedia('(max-width: 700px)').matches) { localStorage.setItem('primnavcollapse' + window.outerWidth, true); n.classList.add('s8-navigationPrimary--displayStateMobile'); }
})();
</script>
