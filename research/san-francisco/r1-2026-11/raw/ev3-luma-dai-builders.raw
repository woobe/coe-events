dars":[],"event_invite":null,"manager_info":null,"guest_info":null,"host_info":null,"sold_out":false,"locale":"en","theme_meta":{"theme":"warp"},"ticket_transfer_enabled":false,"tint_color":"#146AEB","can_register_for_multiple_tickets":false,"font_title":"roc-grotesk","description_mirror":{"type":"doc","content":[{"type":"heading","attrs":{"level":2},"content":[{"text":"Action Required: Pre-register for AWS Builder Loft","type":"text"}]},{"type":"paragraph","content":[{"text":"Hi everyone,","type":"text"}]},{"type":"paragraph","content":[{"text":"To ensure a fast check-in at the ","type":"text"},{"text":"Decentralised AI Builders Meetup","type":"text","marks":[{"type":"bold"}]},{"text":", our venue partner (AWS Builder Loft) requires you to register in their internal system:","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Register Here:","type":"text","marks":[{"type":"bold"}]},{"text":" ","type":"text"},{"text":"https://events.builder.aws.com/OaWvbG","type":"text","marks":[{"type":"link","attrs":{"href":"https://events.builder.aws.com/OaWvbG"}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Note:","type":"text","marks":[{"type":"bold"}]},{"text":" The link may display the name ","type":"text"},{"text":"\"X402 BUILDERS Meetup\"","type":"text","marks":[{"type":"bold"}]},{"text":"—this is correct.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Important:","type":"text","marks":[{"type":"bold"}]},{"text":" Bring a ","type":"text"},{"text":"valid photo ID","type":"text","marks":[{"type":"bold"}]},{"text":" for security at the entrance.","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"Completing this now will save you from waiting in long lines at the door. See you there!","type":"text"}]},{"type":"paragraph","content":[{"text":"Best regards, ","type":"text"},{"text":"BitsLab Team","type":"text","marks":[{"type":"bold"}]}]},{"type":"horizontal_rule"},{"type":"paragraph","content":[{"text":"LLMs generate text.","type":"text"},{"type":"hard_break"},{"text":"Agents execute tasks.","type":"text"},{"type":"hard_break"},{"text":"Blockchains provide state, ownership, and settlement.","type":"text"}]},{"type":"paragraph","content":[{"text":"If agents are to operate autonomously, they need verifiable identity, permissionless payments, and trust-minimized coordination — not platform accounts.","type":"text"}]},{"type":"paragraph","content":[{"text":"This meetup explores how AI and crypto can combine to create entirely new digital ecosystems.","type":"text"}]},{"type":"horizontal_rule"},{"type":"paragraph","content":[{"text":"Topics","type":"text","marks":[{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Agent-to-Agent commerce (A2A)","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"x402 ecosystem \u0026 ERC-8004","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Crypto settlement layer for AI","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Secure agent execution \u0026 identity","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Machine payments \u0026 PayFi","type":"text"}]}]}]},{"type":"horizontal_rule"},{"type":"paragraph","content":[{"text":"Agenda","type":"text","marks":[{"type":"bold"}]}]},{"type":"image","attrs":{"alt":null,"src":"https://images.lumacdn.com/editor-images/6a/0d887e75-c113-43a2-96dc-5ef1cb1cfa1a.jpg","width":1800,"height":3260,"image_id":"local-upload-blob:https://luma.com/d09d9abb-f32d-45c8-89ba-f4e51b18ef92","mime_type":null,"uploaded_at":"2026-03-05T13:31:17.092+08:00","is_uploading":false,"resize_width":null}},{"type":"paragraph","content":[{"text":"5:00-6:00 pm check-in","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"6:00-6:10 pm Keynote: ","type":"text","marks":[{"type":"bold"}]},{"text":"AI Security for Digital Assets, Peter \u0026 Fox, BitsLab","type":"text"}]},{"type":"paragraph","content":[{"text":"6:10-6:40 pm Panel: ","type":"text","marks":[{"type":"bold"}]},{"text":"Building Autonomous AI Systems on Open Networks","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Leo — Cofounder \u0026 CTO, AEON","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Regan — Cofounder \u0026 CTO, PIN AI","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Scott — Cofounder \u0026 CTO, Kite AI","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"6:40-6:50 pm Keynote: ","type":"text","marks":[{"type":"bold"}]},{"text":"Wallet V - Make Crypto Great for All, Stephen, Virgo","type":"text"}]},{"type":"paragraph","content":[{"text":"6:50-7:20 pm Panel:","type":"text","marks":[{"type":"bold"}]},{"text":" AI as an Economic Actor — Data, Identity \u0026 Capital","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Don Gossen — Co-founder and CEO, Nevermined","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Victor — Founder, Namefi by D3Serve Labs","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Roy Liu — Co-founder, Superpower","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Kira Song, Investor","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"7:20 pm Networking","type":"text","marks":[{"type":"bold"}]}]},{"type":"horizontal_rule"},{"type":"paragraph","content":[{"text":"About BitsLab","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"BitsLab","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.bitslab.xyz/"}}]},{"text":" is an AI-driven security company focused on digital asset protection. It delivers an integrated solution of \"audit services + AI security engine + security tools\" for emerging Web3 ecosystems, helping developers and end users build, trade, and interact on-chain with greater safety.","type":"text"}]},{"type":"paragraph","content":[{"text":"About Virgo","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Virgo is focusing on bridging the gap between traditional finance and Web3 by offering compliant fiat-to-crypto trading, OTC services, and wealth management for both retail and institutional clients. Its mission is to accelerate the global adoption of digital assets through a secure, user-friendly, and transparent ecosystem.","type":"text"}]},{"type":"paragraph","content":[{"text":"About Langrenus Fund","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Langrenus Fund is a boutique investment institute, leading in Web 3.0 Investment, SPAC Advisory, Capital Raise, and M\u0026A for Emerging growth companies since 2019.","type":"text"}]},{"type":"paragraph","content":[{"text":"About AEON","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"AEON is the next-generation crypto payment framework, built for AI to power intelligent, automated transactions across Web3, and to make crypto seamless, usable, and intuitive in everyday real life.","type":"text"}]},{"type":"paragraph","content":[{"text":"About PIN AI","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"PIN AI is an open platform for Personal AI, empowering users to reclaim their data from centralised platforms and train private, on-device AI models. The PIN Network integrates private compute, Trusted Execution Environments (TEEs), and blockchain verification to ensure secure interactions between humans and AI.","type":"text"}]},{"type":"paragraph","content":[{"text":"About SafenAI","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"SafenAI is a non-profit committed to fostering collaboration, equipping future leaders navigate the risks of the AI era, and driving early-stage innovations into mainstream applications.","type":"text"}]},{"type":"paragraph","content":[{"text":"About CipherOwl","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"The CipherOwl API provides comprehensive information about cryptocurrency addresses for regulatory compliance and risk assessment. These APIs enable you to check sanctions status, evaluate risk scores, and access related compliance data.","type":"text"}]},{"type":"paragraph","content":[{"text":"About Kite AI","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Kite AI enables AI agents to autonomously transact at scale with cryptographic safety and native x402 compatibility—solving the infrastructure crisis imprisoning the agent economy today.","type":"text"}]},{"type":"paragraph","content":[{"text":"About NameFi","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Namefi is an ICANN-accredited registrar that tokenises DNS ownership so you can register, trade, and build with AI tooling and on-chain security.","type":"text"}]},{"type":"horizontal_rule"},{"type":"paragraph","content":[{"text":"Format","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Lightning Keynotes → Panel → Networking","type":"text"}]},{"type":"horizontal_rule"},{"type":"paragraph","content":[{"text":"Pizza \u0026 drinks provided 🍕","type":"text"}]},{"type":"paragraph"},{"type":"heading","attrs":{"level":1},"content":[{"text":"Important: Action Required for Your Entry to AWS Builder Loft","type":"text"}]},{"type":"paragraph","content":[{"text":"Hi everyone,","type":"text"}]},{"type":"paragraph","content":[{"text":"We are looking forward to seeing you at the Decentralized AI Builders Meetup!","type":"text"}]},{"type":"paragraph","content":[{"text":"To ensure a smooth and fast check-in process on the day of the event, our venue partner, AWS Builder Loft, now requires all attendees to register through their official internal system in addition to our event platform.","type":"text"}]},{"type":"paragraph","content":[{"text":"What you need to do:\nRegister here: ","type":"text"},{"text":"https://events.builder.aws.com/OaWvbG","type":"text","marks":[{"type":"link","attrs":{"href":"https://events.builder.aws.com/OaWvbG"}}]}]},{"type":"paragraph","content":[{"text":"Note on Event Name: Please don't be confused if the link shows the event name as \"X402 BUILDERS Meetup\"—this is the correct link for our session.","type":"text"}]},{"type":"paragraph","content":[{"text":"Bring your ID: Please remember to bring a valid photo ID for security verification at the entrance.","type":"text"}]},{"type":"paragraph","content":[{"text":"Completing this registration now will help you avoid long lines and manual sign-ups at the door. Thank you for your cooperation, and we’ll see you soon!","type":"text"}]},{"type":"paragraph","content":[{"text":"Best regards,\nBitsLab Team","type":"text"}]}]},"eth_address_requirement":null,"faqs":null,"name_requirement":"full-name","phone_number_requirement":null,"solana_address_requirement":null,"registration_questions":[],"prefilled_answers":{},"is_flagged":false,"is_managing_calendar_admin":false,"show_unlock_code_option":false,"has_multiple_ticket_types":false,"membership_tiers":[],"membership_info":null,"waitlist_active":false,"route":null,"featured_city":null}}}},"page":"/[...url]","query":{"url":["yzmp69am"]},"buildId":"2MSlq9Ju5mQDpkEJwF9w2","isFallback":false,"isExperimentalCompile":false,"gip":true,"appGip":true,"scriptLoader":[]}</script><script>window.__CF$cv$params={r:'a604ca659ef79455',t:'MTc5NTY1MzA5MA==',u:'01a21543bd2b77d6884701b066747aef',ut:'NfoTUJs79Fbu.nXMxnZbny1m3VTfHK2x