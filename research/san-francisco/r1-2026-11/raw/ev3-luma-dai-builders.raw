mage/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=18,height=18/avatars-default/avatar_11.png&quot;)" class="jsx-1044599047 avatar"></div><div style="background-color:var(--yellow-content);transform:scale(0)" class="jsx-5191f4da6f3e0a15 online-indicator animated"></div></div><div class="lux-menu-trigger-wrapper jsx-785100558 tooltip absolute-fill"></div></div></div><div class="jsx-2175501575 name-label text-ellipses min-width-0">Hosted by BitsLab &amp; 5 others</div></div></div><div class="jsx-385187311 meta flex-column flex-start"><div class="jsx-24a6e3efa1c3922 row-container rounded-squircle"><div class="jsx-3387162495 shimmer-wrapper"><div class="jsx-100837539 icon-row flex-center gap-3"><div class="jsx-100837539 icon-container flex-center-center rounded overflow-hidden flex-shrink-0"><div class="jsx-3387162495 calendar-card full-height"><div class="jsx-3387162495 month"></div><div class="jsx-3387162495 flex-center-center"><div class="jsx-3387162495 day shimmer"></div></div></div></div><div class="jsx-100837539 flex-1"><div class="jsx-100837539 title text-ellipses"><div class="jsx-3387162495 shimmer title"></div></div><div class="jsx-100837539 desc text-ellipses"><div class="jsx-3387162495 shimmer desc"></div></div></div></div></div></div><a href="https://www.google.com/maps/search/?api=1&amp;query=37.790321299999995%2C-122.399369&amp;query_place_id=ChIJYU1rSACBhYAR8gX_suu-tiA" class="row-container" target="_blank" rel="nofollow noopener"><div class="jsx-100837539 icon-row flex-center gap-3 location-row"><div class="jsx-100837539 icon-container flex-center-center rounded overflow-hidden flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><g fill="none" fill-rule="evenodd" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M2 6.854C2 11.02 7.04 15 8 15s6-3.98 6-8.146C14 3.621 11.314 1 8 1S2 3.62 2 6.854"></path><path d="M9.5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"></path></g></svg></div><div class="jsx-100837539 flex-1"><div class="jsx-100837539 title text-ellipses"><div class="jsx-716bec2817eb1288 flex-center gap-1"><div class="jsx-716bec2817eb1288 text-ellipses">AWS Builder Loft</div><div class="jsx-716bec2817eb1288 icon text-tinted animated"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path fill="currentColor" d="M3.525 11.414a.75.75 0 0 0 1.061 1.061l6.109-6.109v5.579a.75.75 0 0 0 1.5 0v-7.39a.75.75 0 0 0-.75-.75h-7.39a.75.75 0 0 0 0 1.5h5.579Z"></path></svg></div></div></div><div class="jsx-100837539 desc text-ellipses">San Francisco, United States</div></div></div></a></div></div></div><div class="jsx-d366b683862c4de2 liquid-glass rounded-card relative"><div class="glass-container relative animated"><div class="glass rounded-card" style="position:relative;overflow:hidden;padding:var(--liquid-glass-padding)"><span class="absolute-fill" style="backdrop-filter:blur(4px) saturate(100%) var(--glass-brightness, brightness(1))"></span><span class="glass-dodge absolute-fill"></span><span class="glass-lighter absolute-fill"></span><div class="relative"><div class="jsx-ebc17e4706cf462a header"><div class="jsx-a76e40116a177307 title-label text-tinted fs-sm">Registration</div></div><div class="inner"><div class="jsx-5b96bbb25927e633"><div class="jsx-5b96bbb25927e633 flex-column content"><div class="jsx-5b384f005caa455a info-rows flex-column one"><div class="jsx-1881656847 flex-start info-row"><div class="jsx-1881656847 icon rounded standard flex-center-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16"><path fill="currentColor" d="M11 .625c.483 0 .875.392.875.875v1.105c.801.107 1.486.33 2.05.841q.132.121.254.254c.52.575.743 1.275.846 2.096.102.802.1 1.818.1 3.079 0 1.26.002 2.277-.1 3.08-.103.82-.325 1.52-.846 2.095q-.121.132-.254.254c-.575.52-1.275.743-2.096.846-.802.102-1.818.1-3.079.1h-1.5c-1.26 0-2.277.002-3.08-.1-.82-.103-1.52-.325-2.095-.846a4 4 0 0 1-.254-.254c-.52-.575-.743-1.275-.846-2.096-.102-.802-.1-1.818-.1-3.079 0-1.26-.002-2.277.1-3.08.103-.82.326-1.52.846-2.095q.121-.132.254-.254c.564-.51 1.249-.734 2.05-.84V1.5a.875.875 0 0 1 1.75 0v1.007q.633-.008 1.375-.007h1.5q.742-.001 1.375.007V1.5c0-.483.392-.875.875-.875M4.5 10.25a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3.5 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3.5 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-7-4a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3.5 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3.5 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"></path></svg></div><div class="jsx-1881656847"><div class="jsx-1881656847 title">Past Event</div></div></div></div><div class="jsx-4fc9988e16909c6d message">Welcome! To join the event, please register below. </div><div class="jsx-5b96bbb25927e633 mt-1 flex-column content"><div class="jsx-5b96bbb25927e633 cta-wrapper"><div class="jsx-5b96bbb25927e633 cta flex-center gap-2 mb-1"><button class="btn lux-button flex-center medium primary solid variant-color-primary full-width no-icon" type="button"><div class="label">Register</div></button></div></div></div></div></div></div></div></div></div><span style="mix-blend-mode:screen;opacity:0.25" class="jsx-d366b683862c4de2 border rounded-card"></span><span style="mix-blend-mode:overlay" class="jsx-d366b683862c4de2 border rounded-card"></span></div><div class="jsx-5981e6e33e2304d4 content-card pb-1 event-about-card"><div class="jsx-5981e6e33e2304d4 card-title flex-center gap-2 spread"><div class="jsx-5981e6e33e2304d4 title-label text-tinted fs-sm">About Event</div></div><div class="jsx-5981e6e33e2304d4 content"><div class="spark-content" dir="auto"><h2>​<span>Action Required: Pre-register for AWS Builder Loft</span></h2><p class="">​<span>Hi everyone,</span></p><p class="">​<span>To ensure a fast check-in at the </span><strong><span>Decentralised AI Builders Meetup</span></strong><span>, our venue partner (AWS Builder Loft) requires you to register in their internal system:</span></p><ul><li><p class="">​<strong><span>Register Here:</span></strong><span> </span><a href="https://events.builder.aws.com/OaWvbG?utm_source=luma" target="_blank" rel="nofollow noopener"><span>https://events.builder.aws.com/OaWvbG</span></a></p></li><li><p class="">​<strong><span>Note:</span></strong><span> The link may display the name </span><strong><span>&quot;X402 BUILDERS Meetup&quot;</span></strong><span>—this is correct.</span></p></li><li><p class="">​<strong><span>Important:</span></strong><span> Bring a </span><strong><span>valid photo ID</span></strong><span> for security at the entrance.</span></p></li></ul><p class="">​<span>Completing this now will save you from waiting in long lines at the door. See you there!</span></p><p class="">​<span>Best regards, </span><strong><span>BitsLab Team</span></strong></p><hr/><p class="">​<span>LLMs generate text.</span><br/><span>Agents execute tasks.</span><br/><span>Blockchains provide state, ownership, and settlement.</span></p><p class="">​<span>If agents are to operate autonomously, they need verifiable identity, permissionless payments, and trust-minimized coordination — not platform accounts.</span></p><p class="">​<span>This meetup explores how AI and crypto can combine to create entirely new digital ecosystems.</span></p><hr/><p class="">​<strong><span>Topics</span></strong></p><ul><li><p class="">​<span>Agent-to-Agent commerce (A2A)</span></p></li><li><p class="">​<span>x402 ecosystem &amp; ERC-8004</span></p></li><li><p class="">​<span>Crypto settlement layer for AI</span></p></li><li><p class="">​<span>Secure agent execution &amp; identity</span></p></li><li><p class="">​<span>Machine payments &amp; PayFi</span></p></li></ul><hr/><p class="">​<strong><span>Agenda</span></strong></p><div class="jsx-3f972241fdb6f08b lightbox-wrapper"><span style="display:contents" class="jsx-87857fa05d052c09"><button type="button" style="display:block;margin:auto;width:1800px;max-width:100%;object-fit:cover;border-radius:var(--border-radius);overflow:hidden" aria-haspopup="dialog" aria-expanded="false" aria-label="Full resolution image" class="jsx-c16bdb41654b4b17 button-reset"><div style="cursor:zoom-in;padding-bottom:181.1%" class="jsx-bf40f23d3e10e809 img-aspect-ratio rounded"><img src="https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,quality=75,width=800,height=1448.888888888889/editor-images/6a/0d887e75-c113-43a2-96dc-5ef1cb1cfa1a.jpg" alt="User Uploaded Image" fetchPriority="auto" loading="eager" class="jsx-bf40f23d3e10e809 "/></div></button></span></div><p class="">​<strong><span>5:00-6:00 pm check-in</span></strong></p><p class="">​<strong><span>6:00-6:10 pm Keynote: </span></strong><span>AI Security for Digital Assets, Peter &amp; Fox, BitsLab</span></p><p class="">​<strong><span>6:10-6:40 pm Panel: </span></strong><span>Building Autonomous AI Systems on Open Networks</span></p><ul><li><p class="">​<span>Leo — Cofounder &amp; CTO, AEON</span></p></li><li><p class="">​<span>Regan — Cofounder &amp; CTO, PIN AI</span></p></li><li><p class="">​<span>Scott — Cofounder &amp; CTO, Kite AI</span></p></li></ul><p class="">​<strong><span>6:40-6:50 pm Keynote: </span></strong><span>Wallet V - Make Crypto Great for All, Stephen, Virgo</span></p><p class="">​<strong><span>6:50-7:20 pm Panel:</span></strong><span> AI as an Economic Actor — Data, Identity &amp; Capital</span></p><ul><li><p class="">​<span>Don Gossen — Co-founder and CEO, Nevermined</span></p></li><li><p class="">​<span>Victor — Founder, Namefi by D3Serve Labs</span></p></li><li><p class="">​<span>Roy Liu — Co-founder, Superpower</span></p></li><li><p class="">​<span>Kira Song, Investor</span></p></li></ul><p class="">​<strong><span>7:20 pm Networking</span></strong></p><hr/><p class="">​<strong><span>About BitsLab</span></strong></p><p class="">​<a href="https://www.bitslab.xyz/?utm_source=luma" target="_blank" rel="nofollow noopener"><span>BitsLab</span></a><span> is an AI-driven security company focused on digital asset protection. It delivers an integrated solution of &quot;audit services + AI security engine + security tools&quot; for emerging Web3 ecosystems, helping developers and end users build, trade, and interact on-chain with greater safety.</span></p><p class="">​<strong><span>About Virgo</span></strong></p><p class="">​<span>Virgo is focusing on bridging the gap between traditional finance and Web3 by offering compliant fiat-to-crypto trading, OTC services, and wealth management for both retail and institutional clients. Its mission is to accelerate the global adoption of digital assets through a secure, user-friendly, and transparent ecosystem.</span></p><p class="">​<strong><span>About Langrenus Fund</span></strong></p><p class="">​<span>Langrenus Fund is a boutique investment institute, leading in Web 3.0 Investment, SPAC Advisory, Capital Raise, and M&amp;A for Emerging growth companies since 2019.</span></p><p class="">​<strong><span>About AEON</span></strong></p><p class="">​<span>AEON is the next-generation crypto payment framework, built for AI to power intelligent, automated transactions across Web3, and to make crypto seamless, usable, and intuitive in everyday real life.</span></p><p class="">​<strong><span>About PIN AI</span></strong></p><p class="">​<span>PIN AI is an open platform for Personal AI, empowering users to reclaim their data from centralised platforms and train private, on-device AI models. The PIN Network integrates private compute, Trusted Execution Environments (TEEs), and blockchain verification to ensure secure interactions between humans and AI.</span></p><p class="">​<strong><span>About SafenAI</span></strong></p><p class="">​<span>SafenAI is a non-profit committed to fostering collaboration, equipping future leaders navigate the risks of the AI era, and driving early-stage innovations into mainstream applications.</span></p><p class="">​<strong><span>About CipherOwl</span></strong></p><p class="">​<span>The CipherOwl API provides comprehensive information about cryptocurrency addresses for regulatory compliance and risk assessment. These APIs enable you to check sanctions status, evaluate risk scores, and access related compliance data.</span></p><p class="">​<strong><span>About Kite AI</span></strong></p><p class="">​<span>Kite AI enables AI agents to autonomously transact at scale with cryptographic safety and native x402 compatibility—solving the infrastructure crisis imprisoning the agent economy today.</span></p><p class="">​<strong><span>About NameFi</span></strong></p><p class="">​<span>Namefi is an ICANN-accredited registrar that tokenises DNS ownership so you can register, trade, and build with AI tooling and on-chain security.</span></p><hr/><p class="">​<strong><span>Format</span></strong></p><p class="">​<span>Lightning Keynotes → Panel → Networking</span></p><hr/><p class="">​<span>Pizza &amp; drinks provided 🍕</span></p><p class="empty">​</p><h1>​<span>Important: Action Required for Your Entry to AWS Builder Loft</span></h1><p class="">​<span>Hi everyone,</span></p><p class="">​<span>We are looking forward to seeing you at the Decentralized AI Builders Meetup!</span></p><p class="">​<span>To ensure a smooth and fast check-in process on the day of the event, our venue partner, AWS Builder Loft, now requires all attendees to register through their official internal system in addition to our event platform.</span></p><p class="">​<span>What you need to do:
Register here: </span><a href="https://events.builder.aws.com/OaWvbG?utm_source=luma" target="_blank" rel="nofollow noopener"><span>https://events.builder.aws.com/OaWvbG</span></a></p><p class="">​<span>Note on Event Name: Please don&#x27;t be confused if the link shows the event name as &quot;X402 BUILDERS Meetup&quot;—this is the correct link for our session.</span></p><p class="">​<span>Bring your ID: Please remember to bring a valid photo ID for security verification at the entrance.</span></p><p class="">​<span>Completing this registration now will help you avoid long lines and manual sign-ups at the door. Thank you for your cooperation, and we’ll see you soon!</span></p><p class="">​<span>Best regards,
BitsLab Team</span></p></div></div></div><div class="jsx-5981e6e33e2304d4 content-card"><div class="jsx-5981e6e33e2304d4 card-title flex-center gap-2 spread"><div class="jsx-5981e6e33e2304d4 title-label text-tinted fs-sm">Location</div></div><div class="jsx-5981e6e33e2304d4 content"><div class="jsx-bc498e5f7dced08b info"><div class="cursor-copy jsx-bc498e5f7dced08b"><div class="jsx-bc498e5f7dced08b fw-medium">AWS Builder Loft</div><div class="jsx-bc498e5f7dced08b text-tinted fs-sm mt-05">525 Market St, San Francisco, CA 94105, USA</div></div></div><div class="jsx-bc498e5f7dced08b gmaps"><a aria-label="View on Google Maps" tabindex="-1" href="https://www.google.com/maps/search/?api=1&amp;query=37.790321299999995%2C-122.399369&amp;query_place_id=ChIJYU1rSACBhYAR8gX_suu-tiA" class="rounded overflow-hidden block" target="_blank" rel="nofollow noopener"><iframe src="https://www.google.com/maps/embed/v1/place?center=37.790321299999995%2C-122.399369&amp;key=AIzaSyDKCkbEi-ihGgegHT5k7KwIH5X5jz2zTx8&amp;q=place_id%3AChIJYU1rSACBhYAR8gX_suu-tiA&amp;zoom=13" tabindex="-1" loading="lazy" style="width:100%;border:none;height:199px;display:flex;pointer-events:none" class="adaptive-inverted-filter" referrerPolicy="no-referrer-when-downgrade"></iframe></a></div></div></div><div class="event-page-mobile-only"><div class="jsx-5981e6e33e2304d4 content-card"><div class="jsx-5981e6e33e2304d4 card-title flex-center gap-2 spread"><div class="jsx-5981e6e33e2304d4 title-label text-tinted fs-sm">Hosted By</div></div><div class="jsx-5981e6e33e2304d4 content"><div class="jsx-1ec5dbfac506f7c2 flex-column hosts gap-25"><div class="jsx-1ec5dbfac506f7c2 flex-center gap-2"><a class="lux-menu-trigger-wrapper flex-center host-row gap-2 flex-1 hover-brand-link" href="/user/bitslab"><div class="jsx-1246016807 avatar-wrapper small"><div style="background-image:url(&quot;https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=24,height=24/avatars/w