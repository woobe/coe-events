le(0)" class="jsx-5191f4da6f3e0a15 online-indicator animated"></div></div><div class="lux-menu-trigger-wrapper jsx-4246396296 tooltip absolute-fill"></div></div><div class="jsx-4246396296 head flex-start"><div class="jsx-1246016807 avatar-wrapper small"><div style="background-image:url(&quot;https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=24,height=24/avatars/io/16796861-c6e1-431f-af2e-029b36e00db2.jpg&quot;)" class="jsx-1246016807 avatar"></div><div style="background-color:var(--yellow-content);transform:scale(0)" class="jsx-5191f4da6f3e0a15 online-indicator animated"></div></div><div class="lux-menu-trigger-wrapper jsx-4246396296 tooltip absolute-fill"></div></div><div class="jsx-4246396296 head flex-start"><div class="jsx-1246016807 avatar-wrapper small"><div style="background-image:url(&quot;https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=24,height=24/avatars/72/761e9e14-12a9-4932-b6be-2536ccd01cd2.jpg&quot;)" class="jsx-1246016807 avatar"></div><div style="background-color:var(--yellow-content);transform:scale(0)" class="jsx-5191f4da6f3e0a15 online-indicator animated"></div></div><div class="lux-menu-trigger-wrapper jsx-4246396296 tooltip absolute-fill"></div></div><div class="jsx-4246396296 head flex-start"><div class="jsx-1246016807 avatar-wrapper small"><div style="background-image:url(&quot;https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=24,height=24/uploads/u6/bf679027-37f6-4dd6-9792-fcc93fd21f91.png&quot;)" class="jsx-1246016807 avatar"></div><div style="background-color:var(--yellow-content);transform:scale(0)" class="jsx-5191f4da6f3e0a15 online-indicator animated"></div></div><div class="lux-menu-trigger-wrapper jsx-4246396296 tooltip absolute-fill"></div></div><div class="jsx-4246396296 head flex-start"><div class="jsx-1246016807 avatar-wrapper small"><div style="background-image:url(&quot;https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=24,height=24/avatars/hs/9792f202-4146-429f-82d2-6abeab635201.jpg&quot;)" class="jsx-1246016807 avatar"></div><div style="background-color:var(--yellow-content);transform:scale(0)" class="jsx-5191f4da6f3e0a15 online-indicator animated"></div></div><div class="lux-menu-trigger-wrapper jsx-4246396296 tooltip absolute-fill"></div></div></div></div><div class="jsx-e3338a5f18b9fdd0 text-tinted fs-sm guests-string animated">Alexa D, Patrick Mitchell and 155 others</div></button></div></div></div><div class="jsx-7c512a2b35d5f664 flex-column"><button class="btn lux-button flex-center small secondary link variant-color-secondary no-icon" type="button"><div class="label">Contact the Host</div></button><button class="btn lux-button flex-center small secondary link variant-color-secondary no-icon" type="button"><div class="label">Report Event</div></button></div></div></div><div class="event-page-right flex-1"><div class="jsx-385187311 top-wrapper flex-column gap-2"><div class="jsx-385187311 top-card-content"><div class="jsx-385187311 flex-start spread gap-2 title-wrapper"><div class="jsx-385187311 min-width-0"><h1 class="jsx-385187311 title text-primary mb-0">Decentralized AI Builders Meetup</h1></div></div><div class="hosts"><div class="flex-center gap-2 text-tinted"><div style="--size:1.125rem;--cutout-avatar-percentage-visible:0.5;--head-margin-percentage:0.1" class="jsx-785100558 heads flex-center"><div class="jsx-785100558 head flex-start"><div class="jsx-1044599047 avatar-wrapper small"><div style="background-image:url(&quot;https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,anim=false,background=white,quality=75,width=18,height=18/avatars/wz/4ca3d79d-2982-403d-b2d5-52e61cd93767.jpg&quot;)" class="jsx-1044599047 avatar"></div><div style="background-color:var(--yellow-content);transform:scale(0)" class="jsx-519