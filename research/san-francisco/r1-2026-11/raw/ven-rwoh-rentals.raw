<style id="wp-custom-css">
body { margin:0; }
header {
    z-index: 99;
}

.about_header {
	z-index: -20; 
}

.top_header {
	z-index: -20; 
}

.tec-slider-container.datetop ul.tec-slider-list li {
    height: 300px;
    width: 290px !important;
}


/*  New header */

span.the {
    font-size: 45px;
    font-weight: 100;
}

span.perform {
    font-size: 80px;
    color: #D85A29;
    font-weight: 400;
}


span.art {
    font-size: 70px;
}

span.end {
    font-size: 40px;
    color: #8090A7;
    font-weight: 100 !important;
    text-transform: uppercase;
}

/* headei image text */
.event_img, .podcast_img, .about_img, .rental_img {
	position:relative;
}


.event_txt, .podcast_txt, .about_txt, .rental_txt {
    position: absolute;
    right: -16px;
    top: 10px;
    margin-top: 10px;
    color: #fff;
    font-size: 15px !important;
}

.community_img {
	position: relative;
}

.community_txt {
    position: absolute;
    right: -16px;
    margin-top: 0px;
    margin-right: 53px;
    color: #fff;
    font-size: 15px !important;
}


@media (min-width:768px) and (max-width:1900px){
		.podcast_txt {
			margin-top: 20px !Important;
	}

	.rental_txt {
			margin-top: 40px !Important;
	}
}


/* event section */

.tec-slider-title {
    font-family: 'Outfit';
    font-weight: 500 !important;
	color: #3697B6;
}

.tec-sse-date-month {
    font-family: 'jost' !important;
    font-weight: 500;
}

@media (min-width:320px) and (max-width:767px){
		span.perform {
			font-size: 55px;
			color: #D85A29;
			font-weight: 400;
	}
	
	.community_txt {
    margin-right: 0px;   
   }
	
	
}
.upcomming .e-hotspot {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
	top: 8%;
  left: 50%;
	transform: translate(-50%, -50%);
  z-index: 1;
}

.upcomming .elementor-5418 .elementor-element.elementor-element-700eba93 .elementor-repeater-item-7424f2b {
  left: 50%;
  transform: translate(-50%, -50%);
}

.upcomming .dualbutton   .e-hotspot{
	transform:unset;
	top: 0% !important;
}
@media (min-width:320px) and (max-width:767px){
	.upcomming .dualbutton   .e-hotspot{
	transform:unset;
	top: 8% !important;
}
	.upcomming .upcoming.dualbutton   .e-hotspot{
	transform:unset;
	top: 27% !important;
}
	.tec-events-elementor-event-widget__venue-container {margin: 0px !important;
width: 100% !important;
height: auto !important;
display: block !important;
padding: 20px 30px !important;}
	
}

.wpforms-container .wpforms-field-label, .elementor-element div.wpforms-container-full .wpforms-form * {font-family: "Outfit", Sans-serif;}

.e-hotspot__tooltip{
    max-width: 500px !important;
    display: block;
	white-space: normal !important;}

.elementor-element-7bd9338, .elementor-element-47720244 {overflow-x: hidden;}

.tribe-common-c-btn {
background-color: var( --e-global-color-primary );
padding: 10px 20px;
margin-top: 8px;
display: inline-block;
border-radius: 10px;
color: black;
}

.tribe-common-c-btn:hover {
background-color: #FE8B4D;
}

.tribe-events .tribe-events-calendar-list__event-date-tag-datetime {
height: auto !important;
    padding: 15px 0px !important;
	background-color: #FF8C4D !important;
}


.tribe-events-calendar-list__event-date-tag {display:none;}
.tribe-events-calendar-list__event {
    flex-direction: row !important;
	}

	.tribe-event-date-start, .tribe-event-date-end, .tribe-event-time {font-size: 18px;
    font-weight: bold;}

.tribe-events-calendar-list__month-separator h3 {
height: auto !important;
    padding: 15px 30px !important;
	background-color: #FF8C4D !important;
}

.tribe-events .tribe-events-calendar-list__month-separator:after {
    background-color: white !important;
}

.event_slider .elementor-shortcode {display: inline-block;
color: #1d3060;
font-family: "Jost", Sans-serif;
background-color: #FE8B4D;
font-weight: bold;
padding: 5px 10px;}
.event_slider h1 a {line-height: 30px !important;}
.event_slider h1 a:hover {color: #fff !important;}
.event_slider img {transition:all 0.5s ease-in;}
.event_slider img:hover {opacity:60%;}



/* Move arrows outside */
.elementor-swiper-button-prev {
    left: -60px !important;
}

.elementor-swiper-button-next {
    right: -60px !important;
}


/* Larger dots */
.swiper-pagination-bullet {
    width: 14px !important;
    height: 14px !important;
    margin: 0 7px !important;
	background-color: #fff !important;
	opacity:100% !important;
}

.swiper-pagination-bullet-active {
    transform: scale(1.25);
	background-color: #FE8B4D !important;
}

.swiper-pagination {margin-top:40px;}

@media (max-width:1240px){
.elementor-swiper-button-prev, .elementor-swiper-button-next {
    display: none !important;
}
}
</style>
</head>
