/* Default comment here */ 

jQuery(document).ready(function( $ ){
		$(window).scroll(function() {    
			var scroll = $(window).scrollTop();

			if (scroll >= 50) {
				$(".home_header").addClass("top_head");
			} else {
				$(".home_header").removeClass("top_head");
			}
		});
});

</script>
<script type="text/javascript">
/* Default comment here */ 
jQuery(document).ready(function( $ ){
		$(window).scroll(function() {    
			var scroll = $(window).scrollTop();

			if (scroll >= 150) {
				$(".home_header").addClass("scroll_header");
				$(".bayview").css("display", "none");
			} else {
				$(".home_header").removeClass("scroll_header");
				$(".bayview").css("display", "block");
			}
		});
});







</script>
