    <div id="innerWrapper">
      <div id="title-area">
	<h1 class="site-title" data-content-field="site-title">
	  <a href="/">
	    
	    
	      The Lab
	    
	    
	  </a>
	</h1>
      
	
      

	<!--SITE contact info-->
	<div class="contact-info">
	  
	    
	      
	      <p class="site-location">
		<a href="//maps.google.com/maps?q=2948 16th St,San Francisco, CA, 94103"><span>2948 16th St</span>
		<span>San Francisco, CA, 94103</span>
		</a>
	      </p>
	      
	    
	  
	  
	    <p class="phone">(415) 864-8855</p>
	    <p class="email"><a href="mailto:thelabsf@thelab.org">thelabsf@thelab.org</a></p>
	  
	</div>
	
	  <div data-content-field="site-description" class="site-desc"><p>The Lab is a nonprofit experimental art and performance space located in the Mission District of San Francisco.</p></div>
	
      </div>


    <!--CONTENT INJECTION POINT-->
      <section id="content">
	<div class="main-content-wrapper cf" data-content-field="main-content">
	  <!-- CATEGORY NAV -->
	  
	  <div class="sqs-layout sqs-grid-12 columns-12" data-type="page" data-updated-on="1776734035906" id="page-55d0e8e5e4b05658d74ab385"><div class="row sqs-row"><div class="col sqs-col-12 span-12"><div class="sqs-block website-component-block sqs-block-website-component sqs-block-html html-block" data-block-css="[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/df7f5d71-6242-4dcf-8914-1d4ab30e2391_1080/website.components.html.styles.css&quot;]" data-block-scripts="[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/df7f5d71-6242-4dcf-8914-1d4ab30e2391_1080/website.components.html.visitor.js&quot;]" data-block-type="1337" data-definition-name="website.components.html" data-sqsp-block="text" data-website-component-id="ed836ffb5b65cc1ccc54" id="block-ed836ffb5b65cc1ccc54"><div class="sqs-block-content"><div class="sqs-text-block-container">
  
  <div class="sqs-html-content" data-sqsp-text-block-content><h1 style="white-space:pre-wrap;">Rent The Lab for Private Events</h1></div>


  <style>.fe-block-ed836ffb5b65cc1ccc54 {mix-blend-mode: ;
    }</style>
<style class="transform-overrides-vars">
  
</style>




</div>
</div></div><div class="sqs-block website-component-block sqs-block-website-component sqs-block-html html-block" data-block-css="[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/df7f5d71-6242-4dcf-8914-1d4ab30e2391_1080/website.components.html.styles.css&quot;]" data-block-scripts="[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/df7f5d71-6242-4dcf-8914-1d4ab30e2391_1080/website.components.html.visitor.js&quot;]" data-block-type="1337" data-definition-name="website.components.html" data-sqsp-block="text" data-website-component-id="yui_3_17_2_1_1776733364821_5677" id="block-yui_3_17_2_1_1776733364821_5677"><div class="sqs-block-content"><div class="sqs-text-block-container">
  
  <div class="sqs-html-content" data-sqsp-text-block-content><p class="" style="white-space:pre-wrap;">The Lab occupies an approximately 6,700 sq. ft. space in the historic Redstone Building in the Mission District, one block from the 16th &amp; Mission BART stop and easily accessible from anywhere in the Bay Area through multiple MUNI lines. Constructed in 1914 as the San Francisco Labor Temple, the space features recently refinished century-old hardwood floors, unique architectural features, and a modern office and green room partition design.</p><p class="" style="white-space:pre-wrap;">Features include a state-of-the-art Meyer Sound system with a full backline including projection and live conferencing capabilities. The space is wheelchair accessible through an ADA lift in the main entrance of the building. Rentals include the use of the sound system, projection, lighting, and green room, as well as the primary 3,500 sq. ft. performance space in the historic Main Auditorium of the San Francisco Labor Temple. The front area is available on a case-by-case basis between exhibitions for an additional fee.</p><p class="" style="white-space:pre-wrap;">Please email <a href="mailto:rentals@thelab.org?" target="_blank">rentals@thelab.org</a> for inquiries and availability.</p></div>


  <style>.fe-block-yui_3_17_2_1_1776733364821_5677 {mix-blend-mode: ;
    }</style>
<style class="transform-overrides-vars">
  
</style>




</div>
</div></div><div class="sqs-block gallery-block sqs-block-gallery sqs-col-6 span-6 float float-right" data-aspect-ratio="50" data-block-json="&#123;&quot;hSize&quot;:6,&quot;floatDir&quot;:&quot;right&quot;,&quot;methodOption&quot;:&quot;transient&quot;,&quot;existingGallery&quot;:null,&quot;newWindow&quot;:false,&quot;active-alignment&quot;:&quot;center&quot;,&quot;aspect-ratio&quot;:&quot;square&quot;,&quot;aspectRatio&quot;:50,&quot;auto-crop&quot;:true,&quot;autoplay&quot;:false,&quot;blockAnimation&quot;:&quot;none&quot;,&quot;collectionId&quot;:&quot;55dfc1fee4b07f8b43785f74&quot;,&quot;controls&quot;:true,&quot;design&quot;:&quot;slider&quot;,&quot;lightbox&quot;:true,&quot;lightboxTheme&quot;:&quot;dark&quot;,&quot;padding&quot;:10,&quot;show-meta&quot;:true,&quot;show-meta-basic&quot;:true,&quot;show-meta-only-title&quot;:false,&quot;show-meta-only-description&quot;:false,&quot;square-thumbs&quot;:false,&quot;thumbnails-per-row&quot;:3,&quot;vSize&quot;:null,&quot;transientGalleryId&quot;:&quot;55dfc1fee4b07f8b43785f74&quot;&#125;" data-block-type="8" data-sqsp-block="gallery" id="block-yui_3_17_2_3_1440727342872_5086"><div class="sqs-block-content">



