tic.com/images/classic-member/"},"Member:474708208":{"__typename":"Member","id":"474708208","name":"Yashi ","memberPhoto":{"__ref":"PhotoInfo:325023260"}},"Member:484958756":{"__typename":"Member","id":"484958756","name":"ununseptium2014","memberPhoto":null},"PhotoInfo:283324074":{"__typename":"PhotoInfo","id":"283324074","highResUrl":"https://secure.meetupstatic.com/photos/member/f/e/a/highres_283324074.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:258215365":{"__typename":"Member","id":"258215365","name":"Sarangaraja S","memberPhoto":{"__ref":"PhotoInfo:283324074"}},"PhotoInfo:203729332":{"__typename":"PhotoInfo","id":"203729332","highResUrl":"https://secure.meetupstatic.com/photos/member/7/2/9/4/highres_203729332.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:122383142":{"__typename":"Member","id":"122383142","name":"Misho Krastev","memberPhoto":{"__ref":"PhotoInfo:203729332"}},"Member:320768085":{"__typename":"Member","id":"320768085","name":"Habibur Rahman","memberPhoto":null},"PhotoInfo:308306993":{"__typename":"PhotoInfo","id":"308306993","highResUrl":"https://secure.meetupstatic.com/photos/member/6/9/7/1/highres_308306993.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:22460521":{"__typename":"Member","id":"22460521","name":"Lucia","memberPhoto":{"__ref":"PhotoInfo:308306993"}},"PhotoInfo:326703031":{"__typename":"PhotoInfo","id":"326703031","highResUrl":"https://secure.meetupstatic.com/photos/member/b/d/7/highres_326703031.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:253150233":{"__typename":"Member","id":"253150233","name":"Sharmistha Das","memberPhoto":{"__ref":"PhotoInfo:326703031"}},"PhotoInfo:311070523":{"__typename":"PhotoInfo","id":"311070523","highResUrl":"https://secure.meetupstatic.com/photos/member/7/7/3/b/highres_311070523.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:364174870":{"__typename":"Member","id":"364174870","name":"Nuno Edgar Nunes Fernandes (Engi","memberPhoto":{"__ref":"PhotoInfo:311070523"}},"PhotoInfo:310484789":{"__typename":"PhotoInfo","id":"310484789","highResUrl":"https://secure.meetupstatic.com/photos/member/a/e/f/5/highres_310484789.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:254048595":{"__typename":"Member","id":"254048595","name":"Raviraj Nallasivam","memberPhoto":{"__ref":"PhotoInfo:310484789"}},"PhotoInfo:289882750":{"__typename":"PhotoInfo","id":"289882750","highResUrl":"https://secure.meetupstatic.com/photos/member/5/8/d/e/highres_289882750.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:284320017":{"__typename":"Member","id":"284320017","name":"Aram Dovlatyan","memberPhoto":{"__ref":"PhotoInfo:289882750"}},"Member:86406952":{"__typename":"Member","id":"86406952","name":"Peter Yeh","memberPhoto":null},"Event:317171245":{"__typename":"Event","id":"317171245","title":"Make Your GPU Earn Its Keep: A Kernel Engineering Deep Dive","dateTime":"2026-11-30T09:00:00-08:00","description":"**Monday, November 30, 2026 · 9:00–10:00 AM PST · Online**\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\nA powerful GPU can spend plenty of time waiting. What is it waiting for—and how do you find out?\n**Talk #0: Welcome and Meetup Updates**\nby Chris Fregly and Antje Barth\n**Talk #1: From “Why Is This Slow?” to a Faster Kernel**\nby Dr. Rajat “Raj” Dandekar, Co-founder of Vizuara\nJoin Raj for a focused tour of the engineering behind fast AI kernels, drawing on Vizuara’s Kernel Engineering course on Maven. We’ll connect the roofline model to CUDA execution and the GPU memory hierarchy, then look at how profiling guides optimizations such as coalesced memory access, tiling, and tensor-core use. Matrix multiplication and attention provide context for seeing how those ideas fit together in modern AI workloads, including FlashAttention.\nThe goal is a practical way to decide what to measure, which bottleneck matters, and whether an optimization helped. The session is dedicated to Raj’s talk, with time for audience questions.\n**Who it’s for:** Engineers comfortable with Python or basic PyTorch. Prior CUDA or C++ experience is not required.\n**Bio:** Dr. Rajat Dandekar is a co-founder of Vizuara and a Kernel Engineering course instructor. He holds a PhD in Mechanical Engineering from Purdue University and BTech and MTech degrees from IIT Madras.\n**Based on:** [Kernel Engineering: From CUDA Foundations to Frontier AI Kernels](https://maven.com/rajat-dandekar/kernel-engineering)\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\n**Related Links**\nGithub Repo: [http://github.com/cfregly/ai-performance-engineering/](http://github.com/cfregly/ai-performance-engineering/)\nO’Reilly Book: [https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/](https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/)\nYouTube: [https://www.youtube.com/@AIPerformanceEngineering](https://www.youtube.com/@AIPerformanceEngineering)\nGenerative AI Free Course on DeepLearning.ai: [https://bit.ly/gllm](https://bit.ly/gllm)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-performance-engineering/events/317171245/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:530811064"},"displayPhoto":{"__ref":"PhotoInfo:530811064"},"feeSettings":null,"group":{"__ref":"Group:18712511"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":68,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:189432966"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:14250450"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:119557692"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:323615590"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:187509745"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:6703968"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:250286797"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:228005851"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:474708208"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484958756"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:258215365"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:187840554"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:122383142"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:320768085"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:22460521"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:253150233"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:364174870"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:254048595"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:284320017"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:86406952"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:527566842":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/6/f/a/highres_527566842.jpeg","id":"527566842"},"Group:35924669":{"__typename":"Group","id":"35924669","name":"Bay Area Voice AI Happy Hours: Tech Share and Paper Reading","urlname":"bay-area-voice-ai-happy-hours","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:527566842"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.41,"totalRatings":34}},"isNewGroup":false},"PhotoInfo:321799560":{"__typename":"PhotoInfo","id":"321799560","highResUrl":"https://secure.meetupstatic.com/photos/member/4/c/6/8/highres_321799560.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:311227885":{"__typename":"PhotoInfo","id":"311227885","highResUrl":"https://secure.meetupstatic.com/photos/member/1/e/c/d/highres_311227885.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:31474792":{"__typename":"PhotoInfo","id":"31474792","highResUrl":"https://secure.meetupstatic.com/photos/member/8/7/e/8/highres_31474792.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:323850268":{"__typename":"PhotoInfo","id":"323850268","highResUrl":"https://secure.meetupstatic.com/photos/member/7/6/3/c/highres_323850268.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:285346755":{"__typename":"PhotoInfo","id":"285346755","highResUrl":"https://secure.meetupstatic.com/photos/member/b/6/a/3/highres_285346755.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:244697166":{"__typename":"PhotoInfo","id":"244697166","highResUrl":"https://secure.meetupstatic.com/photos/member/4/3/0/e/highres_244697166.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:272071643":{"__typename":"PhotoInfo","id":"272071643","highResUrl":"https://secure.meetupstatic.com/photos/member/7/b/9/b/highres_272071643.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:148878902":{"__typename":"PhotoInfo","id":"148878902","highResUrl":"https://secure.meetupstatic.com/photos/member/4/9/d/6/highres_148878902.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:99252352":{"__typename":"Member","id":"99252352","name":"Wei Chu","memberPhoto":{"__ref":"PhotoInfo:148878902"}},"Member:297604928":{"__typename":"Member","id":"297604928","name":"pavansai tadepalli","memberPhoto":{"__ref":"PhotoInfo:321799560"}},"Member:364887674":{"__typename":"Member","id":"364887674","name":"Teodor Marchitan","memberPhoto":{"__ref":"PhotoInfo:311227885"}},"Member:31209532":{"__typename":"Member","id":"31209532","name":"Bharath Rengarajan","memberPhoto":{"__ref":"PhotoInfo:31474792"}},"Member:193032549":{"__typename":"Member","id":"193032549","name":"susan susan","memberPhoto":{"__ref":"PhotoInfo:323850268"}},"Event:317548418":{"__typename":"Event","id":"317548418","title":"Local+Online Meetup: In-House ASR Architecture \u0026 Accurate Word Timestamps #001","dateTime":"2026-12-03T18:30:00-08:00","description":"Join fellow speech engineers, researchers, and voice AI builders in the South Bay for an evening of technical talks, paper deep dives, and casual networking!\n\n**Event Details**\n\n* **Who should come:** Voice AI researchers, engineers, and entrepreneurs\n* **When:** Every other Thursday, 6:30 PM – 8:30 PM\n* **Format:** Hybrid (in person at Hacker Dojo, plus online via **YouTube Live at https://www.youtube.com/@olewave** and Bilibili Live — direct stream links will be shared later)\n* **Cost:** Draft beer is free; $10 onsite food \u0026 drink chip-in for pizza and non-alcoholic beverages (free for students with valid ID)\n* **Food \u0026 drinks:** Draft beer, pizza, and non-alcoholic beverages provided\n\n**Agenda**\n**6:30 PM – 7:00 PM \\| Arrival \u0026 Open Networking** Grab a drink, meet fellow voice AI builders and researchers, and settle in.\n**7:00 PM – 8:00 PM \\| Main Program**\n\n* **7:00 PM – 7:05 PM:** **Voice AI News \u0026 Community Updates** (5 min)\n* **7:05 PM – 7:30 PM:** **Tech Share: Building In-House Voice AI Solutions - ASR - Part 1: Overview and Architecture** (20 min talk + 5 min Q\u0026A) — Practical architecture, data, and deployment lessons learned from a speech AI veteran with more than 10 years of industry consulting experience.\n* **7:30 PM – 7:35 PM:** **Quick Break** (5 min) — Grab a drink refill and stretch before the paper walkthrough.\n* **7:35 PM – 8:00 PM:** **Paper Reading Deep Dive: Accurate ASR Word Timestamps** (20 min walkthrough + 5 min Q\u0026A) — A walkthrough of **FA-Bench** and its open leaderboard, followed by a look at how **Olign** achieves high-precision word- and phone-level speech alignment.\n\n**8:00 PM – 8:30 PM \\| Happy Hour Mingle \u0026 Wrap\\-Up** Continue the conversation with the speaker, exchange contacts, and hang out until close.\n\n**About the Speaker**\n**Wei Chu** has more than 10 years of experience in building internal voice AI solutions to beat external tech-giant API vendors in accuracy, latency, and cost. He received his PhD in speech from the EE Department at UCLA and is the Founder and CEO of **Olewave**, which focuses on voice datasets, benchmarks, and solutions. He also hosts the Olewave Speech \u0026 NLP Paper Reading channel on YouTube (**[youtube.com/@olewave](https://www.google.com/search?q=https%3A%2F%2Fyoutube.com%2F%40olewave)**) and organizes the Bay Area Voice AI Happy Hours Meetup (**[https://www.meetup.com/bay-area-voice-ai-happy-hours](https://www.meetup.com/bay-area-voice-ai-happy-hours)**). Outside of work, he likes soccer, fish cuisines, and traveling to learn languages, peoples, and cultures.\n\n**Location \u0026 How to Get There**\n**Venue:** Hacker Dojo **Address:** 3200 Patrick Henry Dr #250, Santa Clara, CA 95054 **Getting in:** Please use the main entrance with the automatic doors at 3200 Patrick Henry Dr.\n\n* **Driving \u0026 Parking:** Easily accessible via US-101 (exit Great America Pkwy / Bowers Ave) or CA-237 (exit Great America Pkwy). Free surface parking is available in the lot surrounding the building—look for Suite #250.\n* **Public Transit (VTA Light Rail \u0026 Caltrain):**\n* **VTA Light Rail:** Take the Orange Line to the **Great America Station** or **Old Ironsides Station**, both about a 10–15 minute walk from the venue.\n* **Caltrain + Transfer:** Take Caltrain to **Mountain View Station** and transfer to the VTA Orange Line toward Alum Rock, exiting at Great America Station (or take a \\~10-minute rideshare from Lawrence or Sunnyvale Caltrain stations).\n* **Biking:** Located right near the San Tomas Aquino Creek Trail for a direct, car-free bike commute from surrounding Silicon Valley neighborhoods.\n\n**Call for Volunteers**\nWe are looking for volunteers to help with check-in, A/V and livestream setup, and food/drink logistics! If you'd like to pitch in (volunteers get free admission and food), please message the organizers or reach out via Luma/Meetup.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/bay-area-voice-ai-happy-hours/events/317548418/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:527566842"},"feeSettings":null,"group":{"__ref":"Group:35924669"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":31,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:321799560"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:311227885"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:31474792"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:323850268"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:285346755"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:244697166"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272071643"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":5,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:99252352"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:297604928"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:364887674"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:31209532"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:193032549"}}}]},"series":null,"venue":null},"PhotoInfo:536590404":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/8/a/4/highres_536590404.jpeg","id":"536590404"},"PhotoInfo:511165198":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/6/2/6/e/highres_511165198.jpeg","id":"511165198"},"Group:36761044":{"__typename":"Group","id":"36761044","name":"Santa Cruz AI and Machine Learning Meetup Group","urlname":"santa-cruz-machine-learning-meetup-group","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:511165198"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.33,"totalRatings":3}},"isNewGroup":false},"PhotoInfo:305380178":{"__typename":"PhotoInfo","id":"305380178","highResUrl":"https://secure.meetupstatic.com/photos/member/9/c/f/2/highres_305380178.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:17297441":{"__typename":"Member","id":"17297441","name":"Jimmy Guerrero","memberPhoto":{"__ref":"PhotoInfo:305380178"}},"Event:316757887":{"__typename":"Event","id":"316757887","title":"Dec 10 - AI, ML and Computer Vision Meetup","dateTime":"2026-12-10T09:00:00-08:00","description":"Join our virtual meetup to hear talks from experts on cutting-edge topics across AI, ML, and computer vision.\n\n**Date, Time and Location**\n\nDec 10, 2026\n9:00 AM - 11:00 AM PST\nOnline. **[Register for the Zoom!](https://voxel51.com/events/ai-ml-and-computer-vision-meetup-december-10-2026)**\n\n**Your mAP is fine. Your slices are not. Finding the images that actually matter**\n\nA single mAP can look acceptable while one slice is unusable, small objects, occlusion, or a confused class. I will run a pretrained detector on a few hundred public images (COCO-style, not a production crawl), report the headline metric, then break the same run by slice and walk through the worst samples.\n\nThe claim is modest: you do not need a million images or a trained-from-scratch model to see what the mean is hiding, and you cannot relabel everything, so the next labeling budget should follow those slices. No employer data and no confidential dashboards.\n\n*About the Speaker*\n\n[Amandeep Jiddewar](https://www.linkedin.com/in/amanfj/) is a Machine Learning Engineer at Pinterest, with prior work in U.S. manufacturing analytics (CertainTeed / Saint-Gobain) and marketplace allocation (QuinStreet). Emory Goizueta MSBA (2019), Kaggle Expert. This talk is in his personal capacity and does not represent his current or prior employers.\n\n**Production AI Agents: Tool Use, Evaluation, Guardrails and Observability**\n\nBuilding an AI agent is easy. Knowing whether it is behaving reliably in production is much harder. This session explores how to evaluate agents that use tools and external systems, including tool-call validation, tracing, observability, failure analysis, guardrails, permissions, and human review.\n\nAttendees will learn practical patterns for understanding not just what an agent answered, but why it acted and whether the action was safe.\n\n*About the Speaker*\n\n[Akshay Talathi](https://www.linkedin.com/in/akshaytalathi/) is a Vice President at Goldman Sachs with over 10 years of experience building large-scale, cloud-native, and distributed systems across financial services and technology. His current focus is GenAI and agentic AI, including production AI agents, MCP, enterprise integrations, guardrails, observability, and reliable AI-driven workflows.\n\n**From Virtual Worlds to Physical AI: Building Simulation Pipelines That Survive the Real World**\n\nRobots are moving beyond perception systems that only detect and classify objects toward systems that must understand a scene, learn behaviors, and act in the physical world. In this talk, I’ll show a practical Physical AI workflow using OpenUSD, BowerBot, NVIDIA Isaac Sim and Isaac Lab to build a robot’s virtual world, including its body, cameras, sensors, and environment.\n\nWe’ll explore how demonstrations and reinforcement learning can teach behaviors in simulation, how vision and sensor data become observations for a robot policy, and what needs to match when transferring that behavior to real hardware. The demo follows a small robot from a simulated environment toward a real-world task, exposing both the power and the limitations of sim-to-real.\n\nThe goal is to make the path from pixels to actions concrete for computer vision and machine learning practitioners.\n\n*About the Speaker*\n\n[Arturo Morales Rangel](https://www.linkedin.com/in/arturo-morales-rangel) is the founder of Binary Core LLC, a Physical AI engineering company working across simulation, perception, robot learning, and deployment.\n\n**Prompting Video-Language Models in Production: Lessons from Enterprise Video Tagging and Evaluation**\n\nVideo-language models can now describe, tag and answer questions about long-form video, but production results depend heavily on prompt design and evaluation. This talk shares field lessons from deploying such models for media, news, streaming and sports organizations, including how to structure prompts for consistent, schema-bound outputs across hours of footage.\n\nOn one sports video-tagging project, consolidating the prompt definitions cut estimated processing cost about 3x, and about 90% of the originally reported issues were later resolved through prompting alone. I'll also walk through building evaluation frameworks for video outputs, including for hard domains like egocentric video, and what changes when migrating between model versions.\n\nAttendees will leave with reusable prompt patterns and an evaluation checklist they can apply to their own video pipelines.\n\n*About the Speaker*\n\n[Yash Gugale](https://www.linkedin.com/in/yashgugale/) is a Senior Forward Deployed Engineer at TwelveLabs in New York, integrating video foundation models (Marengo for embeddings and search, Pegasus for video-language understanding) for media, news, streaming and sports customers. He previously spent about six years in video streaming engineering at Peloton and Samsung TV Plus, and holds an MS in Computer Graphics Technology from Purdue.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/santa-cruz-machine-learning-meetup-group/events/316757887/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536590404"},"displayPhoto":{"__ref":"PhotoInfo:536590404"},"feeSettings":null,"group":{"__ref":"Group:36761044"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:17297441"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:526117592":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/9/2/d/8/highres_526117592.jpeg","id":"526117592"},"PhotoInfo:512793226":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/8/1/c/a/highres_512793226.jpeg","id":"512793226"},"Group:37053014":{"__typename":"Group","id":"37053014","name":"Bay Area AI War Room","urlname":"bay-area-artificial-war-room","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:512793226"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.82,"totalRatings":93}},"isNewGroup":false},"PhotoInfo:319476118":{"__typename":"PhotoInfo","id":"319476118","highResUrl":"https://secure.meetupstatic.com/photos/member/8/d/1/6/highres_319476118.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:3954380":{"__typename":"Member","id":"3954380","name":"Toby W","memberPhoto":{"__ref":"PhotoInfo:319476118"}},"PhotoInfo:254796038":{"__typename":"PhotoInfo","id":"254796038","highResUrl":"https://secure.meetupstatic.com/photos/member/8/c/c/6/highres_254796038.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:146053142":{"__typename":"Member","id":"146053142","name":"Rob T","memberPhoto":{"__ref":"PhotoInfo:254796038"}},"PhotoInfo:326203158":{"__typename":"PhotoInfo","id":"326203158","highResUrl":"https://secure.meetupstatic.com/photos/member/a/8/9/6/highres_326203158.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:481728431":{"__typename":"Member","id":"481728431","name":"Shaheen Kazi","memberPhoto":{"__ref":"PhotoInfo:326203158"}},"Member:414936896":{"__typename":"Member","id":"414936896","name":"bipop upreti","memberPhoto":null},"PhotoInfo:326480038":{"__typename":"PhotoInfo","id":"326480038","highResUrl":"https://