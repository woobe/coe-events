","name":"Julio Saldaña","memberPhoto":{"__ref":"PhotoInfo:299135068"}},"Member:182554862":{"__typename":"Member","id":"182554862","name":"Shawn","memberPhoto":null},"PhotoInfo:326354896":{"__typename":"PhotoInfo","id":"326354896","highResUrl":"https://secure.meetupstatic.com/photos/member/3/a/3/0/highres_326354896.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:319483528":{"__typename":"Member","id":"319483528","name":"Bhuvan Nallamothu","memberPhoto":{"__ref":"PhotoInfo:326354896"}},"PhotoInfo:326330419":{"__typename":"PhotoInfo","id":"326330419","highResUrl":"https://secure.meetupstatic.com/photos/member/c/4/f/3/highres_326330419.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:438003859":{"__typename":"Member","id":"438003859","name":"Diana Hart","memberPhoto":{"__ref":"PhotoInfo:326330419"}},"Event:317318592":{"__typename":"Event","id":"317318592","title":"Build a Better AI Homelab with Flyte","dateTime":"2026-12-16T12:00:00-08:00","description":"​**Build a Sovereign AI Factory: an ML Engineer Agent that evaluates, fine-tunes, deploys, and improves open models.**\nRSVP on Luma for live link: https://luma.com/vfhq98ji\n\n​AI teams are starting to look beyond renting every capability from an external API, they're building systems they own and control. In this hands-on session we'll build exactly that by creating an ML Engineer Agent that will manage a model factory to select and fine-tune the best models for your applications.\nRSVP on Luma for live link: https://luma.com/wy08j2yx\n\n​We'll start with a walkthrough where we build an agent that evaluates open models in parallel, fine-tunes promising candidates, deploys the winner, and retrains automatically when performance drops. Think of it as the first brick in your own **model factory**: a repeatable system for evaluating, improving, and deploying models *you* control.\n\n​You'll see how [Union.ai](https://union.ai/?utm_source=luma) \u0026 Flyte give your AI workflows a **durable runtime** with *infrastructure as context,* so agents adapt infra resources, recover from failures, and keep moving without re-running completed work. And because it all runs in **your own cloud**, you own the full stack end to end: **your models, your data, your infrastructure, your IP.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318592/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537083575"},"displayPhoto":{"__ref":"PhotoInfo:537083575"},"feeSettings":null,"group":{"__ref":"Group:37611478"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":12,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:128320322"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192049571"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:255456816"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:249240604"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:277527916"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:305725644"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:231156172"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:182554862"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:426007475"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:319483528"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:170378192"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:438003859"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:536284245":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/0/9/5/highres_536284245.jpeg","id":"536284245"},"PhotoInfo:28732422":{"__typename":"PhotoInfo","id":"28732422","highResUrl":"https://secure.meetupstatic.com/photos/member/c/c/c/6/highres_28732422.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:29144702":{"__typename":"Member","id":"29144702","name":"Si Lam","memberPhoto":{"__ref":"PhotoInfo:28732422"}},"Member:480114164":{"__typename":"Member","id":"480114164","name":"Saye Arumugam","memberPhoto":null},"Member:196442663":{"__typename":"Member","id":"196442663","name":"Aru","memberPhoto":null},"Member:478801738":{"__typename":"Member","id":"478801738","name":"Mohamed Samir","memberPhoto":null},"PhotoInfo:124818612":{"__typename":"PhotoInfo","id":"124818612","highResUrl":"https://secure.meetupstatic.com/photos/member/4/8/b/4/highres_124818612.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:3719457":{"__typename":"Member","id":"3719457","name":"Jon Seidel","memberPhoto":{"__ref":"PhotoInfo:124818612"}},"Member:484350668":{"__typename":"Member","id":"484350668","name":"Surabhi","memberPhoto":null},"PhotoInfo:8634370":{"__typename":"PhotoInfo","id":"8634370","highResUrl":"https://secure.meetupstatic.com/photos/member/d/4/6/2/highres_8634370.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:3684577":{"__typename":"Member","id":"3684577","name":"Bogdan ","memberPhoto":{"__ref":"PhotoInfo:8634370"}},"PhotoInfo:289420360":{"__typename":"PhotoInfo","id":"289420360","highResUrl":"https://secure.meetupstatic.com/photos/member/9/d/a/8/highres_289420360.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:237976151":{"__typename":"Member","id":"237976151","name":"Shirley","memberPhoto":{"__ref":"PhotoInfo:289420360"}},"PhotoInfo:314947981":{"__typename":"PhotoInfo","id":"314947981","highResUrl":"https://secure.meetupstatic.com/photos/member/1/f/2/d/highres_314947981.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:163140262":{"__typename":"Member","id":"163140262","name":"Miguel Acuña","memberPhoto":{"__ref":"PhotoInfo:314947981"}},"Member:481854508":{"__typename":"Member","id":"481854508","name":"William Duhamel","memberPhoto":null},"Event:316685067":{"__typename":"Event","id":"316685067","title":"AI Book Club: An Illustrated Guide to AI Agents","dateTime":"2026-12-22T13:00:00-08:00","description":"​**Decembers book is \"An Illustrated Guide to AI Agents\"!**\n​This is a casual-style event. Not a structured presentation on topics. Sometimes, the discussion even drifts away from the chapters, but feel free to grab the mic to help steer it back.\n\n​Feel free to join the discussion even if you have not read the book chapters! :)\n​Want to discuss the contents during the reading week? Join the AI Slack group: https://slack.flyte.org/\n​-------------------------------------------------\nAbout the book:\n\n* ​Title: **An Illustrated Guide to AI Agents**\n* ​Authors: Maarten Grootendorst, Jay Alammar\n* ​Published: September 2026\n\n​O'rielly platform: [https://learning.oreilly.com/library/view/an-illustrated-guide/9798341662681/](https://learning.oreilly.com/library/view/an-illustrated-guide/9798341662681/?utm_source=luma)\n​\n​Chapters:\n\n1. ​Introduction\n2. ​Large Language Models\n3. ​Reasoning Large Language Models\n4. ​Memory\n5. ​Tool Usage, Learning, and Protocols\n6. ​Planning and Reflection\n7. ​Evaluating Agents\n8. ​8. Multi-Agent Systems\n9. ​Multi-Modal Understanding\n10. ​Code Agents and Code LLMs\n\n​**Book Description**\n​Artificial intelligence is entering a new phase. AI agents can now reason, plan, and act with increasing independence. From accelerating scientific breakthroughs to supporting creative work, these systems are quickly reshaping industries and everyday life. This book provides the conceptual foundation and practical insights you need to understand—and effectively work with—this emerging technology.\n\n​Through hundreds of clear graphic illustrations, Maarten Grootendorst and Jay Alammar explain how AI agents are built, how they think, and where they're heading. Designed for professionals, students, and curious learners alike, this guide goes beyond the buzz to reveal what's actually happening inside these systems, why it matters, and how to apply the knowledge in real-world contexts. *An Illustrated Guide to AI Agents* is your essential reference for navigating the next frontier of artificial intelligence.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685067/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536284245"},"displayPhoto":{"__ref":"PhotoInfo:536284245"},"feeSettings":null,"group":{"__ref":"Group:37611478"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":18,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:128320322"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:29144702"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:480114164"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:196442663"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:478801738"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:5163558"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:249240604"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:3719457"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:409220946"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484350668"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:3684577"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:237976151"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:163140262"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192049571"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:277527916"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481854508"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:319483528"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:438003859"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537198714":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/9/1/a/highres_537198714.jpeg","id":"537198714"},"PhotoInfo:537198615":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/8/b/7/highres_537198615.jpeg","id":"537198615"},"Group:38779152":{"__typename":"Group","id":"38779152","name":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS","urlname":"aumos-sf-bay-area-ai-builders-open-source","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:537198615"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":0,"totalRatings":0}},"isNewGroup":true},"PhotoInfo:326687763":{"__typename":"PhotoInfo","id":"326687763","highResUrl":"https://secure.meetupstatic.com/photos/member/b/a/9/3/highres_326687763.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:485397589":{"__typename":"Member","id":"485397589","name":"Vikram Jha","memberPhoto":{"__ref":"PhotoInfo:326687763"}},"PhotoInfo:308592744":{"__typename":"PhotoInfo","id":"308592744","highResUrl":"https://secure.meetupstatic.com/photos/member/3/1/c/8/highres_308592744.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:52330362":{"__typename":"Member","id":"52330362","name":"Anne","memberPhoto":{"__ref":"PhotoInfo:308592744"}},"PhotoInfo:32980442":{"__typename":"PhotoInfo","id":"32980442","highResUrl":"https://secure.meetupstatic.com/photos/member/9/d/f/a/highres_32980442.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:32288812":{"__typename":"Member","id":"32288812","name":"Ravi K. Chandna","memberPhoto":{"__ref":"PhotoInfo:32980442"}},"Event:317480895":{"__typename":"Event","id":"317480895","title":"Build and evaluate a retrieval workflow: evidence before confidence","dateTime":"2026-12-06T09:00:00-08:00","description":"A live, interactive AumOS session, open to everyone. Level: engineering; guided build with observer option.\n\n**What you will do:** Inspect a small retrieval workflow and test whether its answers are supported by the provided documents.\n\n**Prerequisites:** Basic Python/Git helpful for the hands-on path; a guided observer path will be available.\n\n**Take-away:** Small document set, question set, expected evidence and an evaluation worksheet.\n\n**Format:** 90 minutes, live online, with a worked example, exercise, discussion and questions. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized examples.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to ask a question, share a relevant experience and meet people building with AI around the world. No employer, university or independent community endorsement is implied.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480895/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537198714"},"displayPhoto":{"__ref":"PhotoInfo:537198714"},"feeSettings":null,"group":{"__ref":"Group:38779152"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:485397589"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:52330362"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:32288812"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537198744":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/9/3/8/highres_537198744.jpeg","id":"537198744"},"Event:317480915":{"__typename":"Event","id":"317480915","title":"Open-source AI contribution clinic: reproduce, review and improve","dateTime":"2026-12-20T09:00:00-08:00","description":"A live, interactive AumOS session, open to everyone. Level: engineering / open source \u0026 research.\n\n**What you will do:** Turn a technical question into a small, attributable and reproducible contribution proposal.\n\n**Prerequisites:** Bring a public issue, documentation problem or small experiment; beginners can use a guided documentation track.\n\n**Take-away:** Reproduction note or draft contribution with setup, expected behavior, observed behavior and limits.\n\n**Format:** 90 minutes, live online, with a worked example, exercise, discussion and questions. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized examples.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to ask a question, share a relevant experience and meet people building with AI around the world. No employer, university or independent community endorsement is implied.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480915/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537198744"},"displayPhoto":{"__ref":"PhotoInfo:537198744"},"feeSettings":null,"group":{"__ref":"Group:38779152"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:485397589"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:32288812"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537203492":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/b/c/4/highres_537203492.jpeg","id":"537203492"},"Member:477798199":{"__typename":"Member","id":"477798199","name":"benlu369","memberPhoto":null},"Event:317491600":{"__typename":"Event","id":"317491600","title":"Frontier AI, live: what changed this month and what holds up","dateTime":"2026-12-05T09:00:00-08:00","description":"A live AumOS session for experienced engineers, researchers and senior practitioners. Level: Frontier.\n\n**What you will do:** Take apart two or three recent results in models, reasoning, agents or on-device AI; test one claim live on open models; and agree on the open research questions the community works on next.\n\n**Prerequisites:** Working knowledge of machine learning or LLM systems. A short pre-read goes to everyone who RSVPs. Newcomers are welcome to listen.\n\n**Take-away:** Shared notes, a reproduction notebook and a list of open research tracks you can join or lead.\n\n**Format:** 90 minutes, live online: a short teardown, a live test and open discussion. Want to present a result at a future session? Say so in the group. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized material.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to challenge a claim, share a result and meet people working at the frontier of AI around the world. No employer, university or independent community endorsement is implied.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317491600/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537203492"},"displayPhoto":{"__ref":"PhotoInfo:537203492"},"feeSettings":null,"group":{"__ref":"Group:38779152"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:477798199"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:32288812"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:523081294":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/0/e/highres_523081294.jpeg","id":"523081294"},"PhotoInfo:512443640":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/a/a/7/8/highres_512443640.jpeg","id":"512443640"},"Group:19871729":{"__typename":"Group","id":"19871729","name":"West Coast Machine Learning Meetup (aka East Bay/Trivalley)","urlname":"west-coast-machine-learning-meetup","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:512443640"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.87,"totalRatings":559}},"isNewGroup":false},"PhotoInfo:254634635":{"__typename":"PhotoInfo","id":"254634635","highResUrl":"https://secure.meetupstatic.com/photos/member/d/5/6/b/highres_254634635.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:201236193":{"__typename":"Member","id":"201236193","name":"David Selinger","memberPhoto":{"__ref":"PhotoInfo:254634635"}},"PhotoInfo:162240942":{"__typename":"PhotoInfo","id":"162240942","highResUrl":"https://secure.meetupstatic.com/photos/member/3/a/e/highres_162240942.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:72601442":{"__typename":"Member","id":"72601442","name":"Jerry Kurata","memberPhoto":{"__ref":"PhotoInfo:162240942"}},"PhotoInfo:279449204":{"__typename":"PhotoInfo","id":"279449204","highResUrl":"https://secure.meetupstatic.com/photos/member/7/2/1/4/highres_279449204.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:260322518":{"__typename":"Member","id":"260322518","name":"Patrick Darrow","memberPhoto":{"__ref":"PhotoInfo:279449204"}},"PhotoInfo:258325460":{"__typename":"PhotoInfo","id":"258325460","highResUrl":"https://secure.meetupstatic.com/photos/member/6/3/7/4/highres_258325460.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:160436552":{"__typename":"Member","id":"160436552","name":"rstager","memberPhoto":{"__ref":"PhotoInfo:258325460"}},"PhotoInfo:313582322":{"__typename":"PhotoInfo","id":"313582322","highResUrl":"https://secure.meetupstatic.com/photos/member/5/7/3/2/highres_313582322.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:340945940":{"__typename":"Member","id":"340945940","name":"Bobby","memberPhoto":{"__ref":"PhotoInfo:313582322"}},"PhotoInfo:326342561":{"__typename":"PhotoInfo","id":"326342561","highResUrl":"https://secure.meetupstatic.com/photos/member/a/0/1/highres_326342561.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:468344591":{"__typename":"Member","id":"468344591","name":"akhilraj0226","memberPhoto":{"__ref":"PhotoInfo:326342561"}},"PhotoInfo:298891925":{"__typename":"PhotoInfo","id":"298891925","highResUrl":"https://secure.meetupstatic.com/photos/member/7/c/b/5/highres_298891925.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:306780321":{"__typename":"Member","id":"306780321","name":"Bhavesh","memberPhoto":{"__ref":"PhotoInfo:298891925"}},"PhotoInfo:299401786":{"__typename":"PhotoInfo","id":"299401786","highResUrl":"https://secure.meetupstatic.com/photos/member/6/f/a/highres_299401786.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:182421092":{"__typename":"Member","id":"182421092","name":"DISHANT GHAI","memberPhoto":{"__ref":"PhotoInfo:299401786"}},"PhotoInfo:242714302":{"__typename":"PhotoInfo","id":"242714302","highResUrl":"https://secure.meetupstatic.com/photos/member/3/7/d/e/highres_242714302.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:183394743":{"__typename":"Member","id":"183394743","name":"Aditi Banarse","memberPhoto":{"__ref":"PhotoInfo:242714302"}},"PhotoInfo:317241723":{"__typename":"PhotoInfo","id":"317241723","highResUrl":"https://secure.meetupstatic.com/photos/member/5/4/d/b/highres_317241723.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:189351979":{"__typename":"Member","id":"189351979","name":"Eddie Avinashi ","memberPhoto":{"__ref":"PhotoInfo:317241723"}},"Event:315814934":{"__typename":"Event","id":"315814934","dateTime":"2026-11-26T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"west-coast-machine-learning-meetup","__ref":"Group:19871729"},"title":"Weekly paper review, coding project, or random discussion","description":"This is a placeholder for our weekly meeting. We will update the meeting description each week to include the topic of the week. Stay tuned :)\n\nEvery week we meet (virtually) and discuss the most interesting topics in AI, ML and Deep Learning.\nWe usually rotate weeks so that every other week one of the members presents a deep learning/machine learning paper, frequently paired with a video explaining the concepts. In the off weeks, we present information about different projects. We cover computer vision, language (LLM's), health/hard science and generative models (Diffusion, GAN's etc.).\nPeople of all levels of skill are welcome--from newbies to machine learning, to PhD's in DL/ML/AI.\nWe have been meeting for over 6 years weekly and have developed a neat pace and community--and all are welcome. Come join us and stay abreast of the biggest topics in Artificial Intelligence.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/west-coast-machine-learning-meetup/events/315814934/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:523081294"},"displayPhoto":{"__ref":"PhotoInfo:523081294"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":11,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:201236193"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:72601442"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:260322518"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:160436552"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:340945940"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:468344591"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:319483528"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:306780321"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:182421092"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:183394743"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:189351979"}}}]},"series":{"__typename":"Series","description":"Every week on Thursday until January 7, 2027","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["THURSDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:315814934"}},{"__typename":"EventEdge","node":{"__ref":"Event:315814935"}},{"__typename":"EventEdge","node":{"__ref":"Event:315814936"}},{"__typename":"EventEdge","node":{"__ref":"Event:315814938"}},{"__typename":"EventEdge","node":{"__ref":"Event:315814939"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"Event:315814935":{"__typename":"Event","id":"315814935","dateTime":"2026-12-03T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"west-coast-machine-learning-meetup"}},"Event:315814936":{"__typename":"Event","id":"315814936","dateTime":"2026-12-10T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"west-coast-machine-learning-meetup"}},"Event:315814938":{"__typename":"Event","id":"315814938","dateTime":"2026-12-17T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"west-coast-machine-learning-meetup"}},"Event:315814939":{"__typename":"Event","id":"315814939","dateTime":"2026-12-24T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"west-coast-machine-learning-meetup"}},"PhotoInfo:524022737":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/a/6/f/1/highres_524022737.jpeg","id":"524022737"},"PhotoInfo:524092457":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/c/e/9/highres_524092457.jpeg","id":"524092457"},"Group:37788123":{"__typename":"Group","id":"37788123","name":"Study Machine Learning","urlname":"study-machine-learning","timezone":"America/New_York","keyGroupPhoto":{"__ref":"PhotoInfo:524092457"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.57,"totalRatings":63}},"isNewGroup":false},"PhotoInfo:321096522":{"__typename":"PhotoInfo","id":"321096522","highResUrl":"https://secure.meetupstatic.com/photos/member/8/e/a/a/highres_321096522.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:7320375":{"__typename":"Member","id":"7320375","name":"William Eagan","memberPhoto":{"__ref":"PhotoInfo:321096522"}},"PhotoInfo:304987110":{"__typename":"PhotoInfo","id":"304987110","highResUrl":"https://secure.meetupstatic.com/photos/member/1/b/c/6/highres_304987110.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:332394038":{"__typename":"Member","id":"332394038","name":"Anup K","memberPhoto":{"__ref":"PhotoInfo:304987110"}},"Event:317389239":{"__typename":"Event","id":"317389239","dateTime":"2026-12-01T19:00:00-05:00","isAttending":false,"group":{"__typename":"Group","urlname":"study-machine-learning","__ref":"Group:37788123"},"title":"Welcome to the Machine Learning Study Group #67","description":"Join us for our 67th Machine Learning Study Group meeting!\nDuring the second half we will walk through a more advanced ML topic.\n\nThe first half will be devoted to helping people start and continue their journey to a Machine Learning engineer.\n\nWhether you're a complete beginner or experienced practitioner, you're welcome to join. We'll review fundamentals and build from there. During the Zoom session, you'll have the opportunity to share your own ML/AI projects.\n\nWhat we've done over the past year:\n\\- First\\, we learned to run Llama 2 locally using Ollama\n\\- Then\\, we expanded to cloud platforms\\, running models on Colab and other services \\(we may demonstrate this again on Colab and Kaggle\\)\nWe have demonstrated RAG (Retrieval-Augmented Generation)locally and in Google Colab.\nNext we demonstrated fine-tuning on a cloud platform.\nWe examined LM Studio and vLLM\nWe also worked with agents and writing an LLM from scratch.\nBuilding another RAG system.\nConverting huggingface gguf files to the ollama format.\nCome learn together in a supportive environment where no question is too basic!","eventType":"ONLINE","eventUrl":"https://www.meetup.com/study-machine-learning/events/317389239/","isSaved":false,"maxTickets":20,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:524022737"},"displayPhoto":{"__ref":"PhotoInfo:524022737"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:7320375"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:332394038"}}}]},"series":{"__typename":"Series","description":"Every week on Tuesday until July 11, 2027","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["TUESDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:317389239"}},{"__typename":"EventEdge","node":{"__ref":"Event:317490356"}},{"__typename":"EventEdge","node":{"__ref":"Event:317580597"}},{"__typename":"EventEdge","node":{"__ref":"Event:317580598"}},{"__typename":"EventEdge","node":{"__ref":"Event:317580599"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"Event:317490356":{"__typename":"Event","id":"317490356","dateTime":"2026-12-08T19:00:00-05:00","isAttending":false,"group":{"__typename":"Group","urlname":"study-machine-learning"}},"Event:317580597":{"__typename":"Event","id":"317580597","dateTime":"2026-12-15T19:00:00-05:00","isAttending":false,"group":{"__typename":"Group","urlname":"study-machine-learning"}},"Event:317580598":{"__typename":"Event","id":"317580598","dateTime":"2026-12-22T19:00:00-05:00","isAttending":false,"group":{"__typename":"Group","urlname":"study-machine-learning"}},"Event:317580599":{"__typename":"Event","id":"317580599","dateTime":"2026-12-29T19:00:00-05:00","isAttending":false,"group":{"__typename":"Group","urlname":"study-machine-learning"}},"PhotoInfo:530811064":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/7/7/8/highres_530811064.jpeg","id":"530811064"},"PhotoInfo:530880354":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/6/2/highres_530880354.jpeg","id":"530880354"},"Group:18712511":{"__typename":"Group","id":"18712511","name":"AI Performance Engineering Meetup (San Francisco, Global)","urlname":"ai-performance-engineering","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:530880354"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.61,"totalRatings":1130}},"isNewGroup":false},"PhotoInfo:326544911":{"__typename":"PhotoInfo","id":"326544911","highResUrl":"https://secure.meetupstatic.com/photos/member/6/1/4/f/highres_326544911.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:189432966":{"__typename":"Member","id":"189432966","name":"Antje Barth","memberPhoto":{"__ref":"PhotoInfo:326544911"}},"PhotoInfo:261568117":{"__typename":"PhotoInfo","id":"261568117","highResUrl":"https://secure.meetupstatic.com/photos/member/6/d/d/5/highres_261568117.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:14250450":{"__typename":"Member","id":"14250450","name":"Chris Fregly","memberPhoto":{"__ref":"PhotoInfo:261568117"}},"PhotoInfo:321280772":{"__typename":"PhotoInfo","id":"321280772","highResUrl":"https://secure.meetupstatic.com/photos/member/9/f/4/4/highres_321280772.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:119557692":{"__typename":"Member","id":"119557692","name":"Jorge Cardona","memberPhoto":{"__ref":"PhotoInfo:321280772"}},"PhotoInfo