rl":"https://secure.meetupstatic.com/photos/member/2/2/6/d/highres_318368813.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:287518559":{"__typename":"Member","id":"287518559","name":"BadrDeen ","memberPhoto":{"__ref":"PhotoInfo:318368813"}},"PhotoInfo:59549752":{"__typename":"PhotoInfo","id":"59549752","highResUrl":"https://secure.meetupstatic.com/photos/member/7/4/3/8/highres_59549752.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:7810093":{"__typename":"Member","id":"7810093","name":"Geetha Srikantan","memberPhoto":{"__ref":"PhotoInfo:59549752"}},"PhotoInfo:310101208":{"__typename":"PhotoInfo","id":"310101208","highResUrl":"https://secure.meetupstatic.com/photos/member/5/2/d/8/highres_310101208.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:9868539":{"__typename":"Member","id":"9868539","name":"David MacMillan","memberPhoto":{"__ref":"PhotoInfo:310101208"}},"Member:387052180":{"__typename":"Member","id":"387052180","name":"Sandy","memberPhoto":null},"Event:315280338":{"__typename":"Event","id":"315280338","dateTime":"2026-12-01T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"handsonprogrammingevents","__ref":"Group:1652785"},"title":"Deep Learning Study Group","description":"Deep learning is evolving quickly. Important new developments are appearing daily. This group attempts to keep up by reading and discussing current deep learning literature. This meetup uses discussion among the participants to speed understanding of current research results. That requires that some participants read the paper before attending. Anyone is welcome to attend and listen without reading the paper. If nobody reads the paper the meeting will be short.\n\nPaper for December 1, 2026:\nUnderstanding, Predicting, and Steering LLM Behavior via Representational Effective Theory\nhttps://arxiv.org/pdf/2605.09294\n\nPapers that we're reading, code that participants generate and other random stuff can be found at github site for the group.\nhttps://github.com/davidmacmillan/DeepLearningStudyGroup","eventType":"ONLINE","eventUrl":"https://www.meetup.com/handsonprogrammingevents/events/315280338/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:450113198"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":10,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:9640968"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:6546554"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:102443632"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:36379222"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483659648"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:319483528"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:287518559"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:7810093"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:9868539"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:387052180"}}}]},"series":{"__typename":"Series","description":"Every week on Tuesday until January 25, 2028","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["TUESDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:315280338"}},{"__typename":"EventEdge","node":{"__ref":"Event:315280358"}},{"__typename":"EventEdge","node":{"__ref":"Event:315280342"}},{"__typename":"EventEdge","node":{"__ref":"Event:315280344"}},{"__typename":"EventEdge","node":{"__ref":"Event:315280346"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"Event:315280358":{"__typename":"Event","id":"315280358","dateTime":"2026-12-08T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"handsonprogrammingevents"}},"Event:315280342":{"__typename":"Event","id":"315280342","dateTime":"2026-12-15T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"handsonprogrammingevents"}},"Event:315280344":{"__typename":"Event","id":"315280344","dateTime":"2026-12-22T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"handsonprogrammingevents"}},"Event:315280346":{"__typename":"Event","id":"315280346","dateTime":"2026-12-29T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"handsonprogrammingevents"}},"PhotoInfo:537224596":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/a/e/3/4/highres_537224596.jpeg","id":"537224596"},"PhotoInfo:497238944":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/a/0/0/highres_497238944.jpeg","id":"497238944"},"Group:28219081":{"__typename":"Group","id":"28219081","name":"Bay Area Research in NLP and ML","urlname":"Bay-Area-Research-in-NLP-and-ML","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:497238944"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.84,"totalRatings":170}},"isNewGroup":false},"PhotoInfo:310707362":{"__typename":"PhotoInfo","id":"310707362","highResUrl":"https://secure.meetupstatic.com/photos/member/6/a/e/2/highres_310707362.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:325870606":{"__typename":"PhotoInfo","id":"325870606","highResUrl":"https://secure.meetupstatic.com/photos/member/2/9/6/e/highres_325870606.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:276537640":{"__typename":"PhotoInfo","id":"276537640","highResUrl":"https://secure.meetupstatic.com/photos/member/e/1/2/8/highres_276537640.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:278805410":{"__typename":"PhotoInfo","id":"278805410","highResUrl":"https://secure.meetupstatic.com/photos/member/b/1/6/2/highres_278805410.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:301163743":{"__typename":"PhotoInfo","id":"301163743","highResUrl":"https://secure.meetupstatic.com/photos/member/5/c/b/f/highres_301163743.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:260873630":{"__typename":"PhotoInfo","id":"260873630","highResUrl":"https://secure.meetupstatic.com/photos/member/d/1/7/e/highres_260873630.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:253997535":{"__typename":"PhotoInfo","id":"253997535","highResUrl":"https://secure.meetupstatic.com/photos/member/4/4/7/f/highres_253997535.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:362353325":{"__typename":"Member","id":"362353325","name":"Max","memberPhoto":{"__ref":"PhotoInfo:310707362"}},"Member:481098609":{"__typename":"Member","id":"481098609","name":"Ashley A.","memberPhoto":{"__ref":"PhotoInfo:325870606"}},"Event:317519279":{"__typename":"Event","id":"317519279","title":"Agentic AI Year in Review","dateTime":"2026-12-08T17:00:00-08:00","description":"**Agentic AI Year in Review!**\nJoin us for an exciting evening discussing the top startup trends in Agentic AI of 2026 and predictions for 2027.\n\n**Featuring:**\n\n* [Shruti Merchant](https://www.linkedin.com/in/shrutimerchant/), Partner, Pear VC\n* [Tabish Gilani](https://www.linkedin.com/in/tabishgilani/), Product Growth Partner, a16z Speedrun\n* [Tracy Rubin](https://www.linkedin.com/in/tracy-rubin-a54439156/), Partner, Cooley LLP\n\n**Registration**\nTo attend, you need to [register at luma](https://luma.com/veyokv1b?utm_source=nlp) **\u003c-** **Please register at Luma as the venue requires this.**\n\n**Agenda**\nDate: Tues December 8th, 5:00pm (**doors open at 5pm**)\nLocation: GitHub, 275 Brannan St, San Francisco (entrance on Brannan)\n\n* 5:00-6:00pm doors open for networking\n* 6:00-7:00pm panel discussion\n* 7:00-7:30pm additional networking\n\n**Want to demo?**\nIf you are interested in demoing at a future event, please fill out the [application form](https://forms.gle/ahzwgnAAs51pdiTQ9).","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/bay-area-research-in-nlp-and-ml/events/317519279/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537224596"},"displayPhoto":{"__ref":"PhotoInfo:537224596"},"feeSettings":null,"group":{"__ref":"Group:28219081"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":32,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:310707362"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:325870606"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:276537640"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:278805410"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:301163743"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260873630"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:253997535"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:58505672"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:362353325"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481098609"}}}]},"series":null,"venue":{"__typename":"Venue","name":"GitHub","address":"275 Brannan St","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:474552125":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/f/5/d/highres_474552125.jpeg","id":"474552125"},"Group:25755416":{"__typename":"Group","id":"25755416","name":"Sunnyvale Data Science Meetup","urlname":"meetup-group-iZENgAjf","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:474552125"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4,"totalRatings":4}},"isNewGroup":false},"PhotoInfo:251744791":{"__typename":"PhotoInfo","id":"251744791","highResUrl":"https://secure.meetupstatic.com/photos/member/a/e/f/7/highres_251744791.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:12193373":{"__typename":"Member","id":"12193373","name":"Albert","memberPhoto":{"__ref":"PhotoInfo:251744791"}},"PhotoInfo:304249967":{"__typename":"PhotoInfo","id":"304249967","highResUrl":"https://secure.meetupstatic.com/photos/member/c/3/2/f/highres_304249967.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:329415998":{"__typename":"Member","id":"329415998","name":"Lísia Galli","memberPhoto":{"__ref":"PhotoInfo:304249967"}},"Event:317563874":{"__typename":"Event","id":"317563874","title":"Beyond Analytics: Turning Microsoft Fabric Insights Into Decisions","dateTime":"2026-12-01T07:00:00-08:00","description":"This event is organized by SAS.\n\nThis event is being promoted by many groups.\n\nOur meetup group is participating by promoting this event.\nOur meetup group is collaborating by promoting this event.\n\nThis is an online event.\n\nAttendees can be located anywhere in the world!\n\nThis event is FREE to attend!\n\nIn order to attend, please register here:\n[https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html](https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html)\nOrganizations have more data, analytics and predictive capabilities than ever. Yet turning those insights into timely, consistent business decisions remains a challenge.\nDisconnected systems, manual processes and fragmented operations often stand in the way. For example, banks have customer data, predictive models and business criteria spread throughout the organization, slowing loans and credit decisions.\nJoin experts from SAS and Katalyze to explore how decision intelligence bridges the gap between insights, actions and business outcomes. Discover how SAS Decision Builder on Microsoft Fabric helps organizations connect analytics, business rules and organizational judgment to make more consistent, governed decisions.\n\n## You’ll learn more about:\n\n* Bridging the decision gap: Why insights don’t always translate into action and business outcomes – and how decision intelligence helps.\n* Connecting decision-making components: How business rules, predictive models, organizational judgment and governance work together.\n* Overcoming organizational barriers: How to address disconnected workflows, manual processes and unclear decision ownership.\n* Operationalizing decisions with SAS: How SAS Decision Builder on Microsoft Fabric orchestrates governed decision workflows using data in Microsoft OneLake.\n* Putting decision intelligence into practice: How SAS and Katalyze can help identify high-value decisioning opportunities in the pharmaceutical, financial services and legal industries.\n\nTry SAS Decision Builder for free today: [https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview](https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/meetup-group-izengajf/events/317563874/","isAttending":false,"isSaved":false,"maxTickets":100,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:474552125"},"feeSettings":null,"group":{"__ref":"Group:25755416"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:12193373"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:329415998"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:531025547":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/6/3/c/b/highres_531025547.jpeg","id":"531025547"},"PhotoInfo:530453004":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/f/0/c/highres_530453004.jpeg","id":"530453004"},"Group:36685518":{"__typename":"Group","id":"36685518","name":"Silicon Valley Generative AI ~ The AI Collective Network","urlname":"silicon-valley-generative-ai","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:530453004"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.55,"totalRatings":377}},"isNewGroup":false},"PhotoInfo:277268655":{"__typename":"PhotoInfo","id":"277268655","highResUrl":"https://secure.meetupstatic.com/photos/member/2/1/c/f/highres_277268655.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:254657649":{"__typename":"Member","id":"254657649","name":"Jason Eckstein","memberPhoto":{"__ref":"PhotoInfo:277268655"}},"Member:485061099":{"__typename":"Member","id":"485061099","name":"Minchee Yang","memberPhoto":null},"PhotoInfo:326567645":{"__typename":"PhotoInfo","id":"326567645","highResUrl":"https://secure.meetupstatic.com/photos/member/b/a/1/d/highres_326567645.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:470351652":{"__typename":"Member","id":"470351652","name":"Terence J.H","memberPhoto":{"__ref":"PhotoInfo:326567645"}},"PhotoInfo:268391876":{"__typename":"PhotoInfo","id":"268391876","highResUrl":"https://secure.meetupstatic.com/photos/member/2/e/6/4/highres_268391876.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:154394392":{"__typename":"Member","id":"154394392","name":"stayeb","memberPhoto":{"__ref":"PhotoInfo:268391876"}},"PhotoInfo:261783169":{"__typename":"PhotoInfo","id":"261783169","highResUrl":"https://secure.meetupstatic.com/photos/member/c/6/1/highres_261783169.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:107220852":{"__typename":"Member","id":"107220852","name":"Tushar K Gerg","memberPhoto":{"__ref":"PhotoInfo:261783169"}},"PhotoInfo:254496117":{"__typename":"PhotoInfo","id":"254496117","highResUrl":"https://secure.meetupstatic.com/photos/member/8/d/1/5/highres_254496117.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:200972279":{"__typename":"Member","id":"200972279","name":"Nancy Avila","memberPhoto":{"__ref":"PhotoInfo:254496117"}},"PhotoInfo:303441520":{"__typename":"PhotoInfo","id":"303441520","highResUrl":"https://secure.meetupstatic.com/photos/member/5/4/1/0/highres_303441520.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:290132061":{"__typename":"Member","id":"290132061","name":"Vishnu Prashanth","memberPhoto":{"__ref":"PhotoInfo:303441520"}},"PhotoInfo:326713097":{"__typename":"PhotoInfo","id":"326713097","highResUrl":"https://secure.meetupstatic.com/photos/member/3/3/2/9/highres_326713097.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:485499192":{"__typename":"Member","id":"485499192","name":"Prashanth Jain P","memberPhoto":{"__ref":"PhotoInfo:326713097"}},"Member:450038728":{"__typename":"Member","id":"450038728","name":"jennyzyu","memberPhoto":null},"PhotoInfo:246664428":{"__typename":"PhotoInfo","id":"246664428","highResUrl":"https://secure.meetupstatic.com/photos/member/1/1/4/c/highres_246664428.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:188073865":{"__typename":"Member","id":"188073865","name":"Jose John","memberPhoto":{"__ref":"PhotoInfo:246664428"}},"PhotoInfo:322821073":{"__typename":"PhotoInfo","id":"322821073","highResUrl":"https://secure.meetupstatic.com/photos/member/5/2/5/1/highres_322821073.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:404781062":{"__typename":"Member","id":"404781062","name":"Jojo Ye","memberPhoto":{"__ref":"PhotoInfo:322821073"}},"Member:456969153":{"__typename":"Member","id":"456969153","name":"suparna","memberPhoto":null},"PhotoInfo:299106637":{"__typename":"PhotoInfo","id":"299106637","highResUrl":"https://secure.meetupstatic.com/photos/member/1/9/e/d/highres_299106637.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:7558057":{"__typename":"Member","id":"7558057","name":"Dimitri Papaioannou","memberPhoto":{"__ref":"PhotoInfo:299106637"}},"Event:317464502":{"__typename":"Event","id":"317464502","title":"Multi Agent Reinforcement Learning: AlphaStar League Training","dateTime":"2026-11-30T17:30:00-08:00","description":"Last meeting, we reviewed the initial announcement of the DeepMind agent AlphaStar and its preliminary competitive results against professional StarCraft 2 players. This time we will focus more on material in section Chapter 9.9.3 of [Multi-Agent Reinforcement Learning: Foundations and Modern Approaches](https://www.marl-book.com/) which discusses the league training approach to developing robust strategies. We will also look at the associated [blog post and Nature paper](https://deepmind.google/blog/alphastar-grandmaster-level-in-starcraft-ii-using-multi-agent-reinforcement-learning/) that explain the training in detail with ablations that show which components of the population training were necessary to reach top performance.\n\nMeetup Links:\n[Recordings of Previous RL Meetings](https://youtube.com/playlist?list=PLYqXmZaxvwmy2CNaK-DLailou1VIU1UZn\u0026si=n6uQm863MCcHuKT7)\n[Recordings of Previous MARL Meetings](https://youtube.com/playlist?list=PLYqXmZaxvwmzikjw-cNyZfI051ms05czB\u0026si=A7-AeX0dcRW67PDB)\n[Short RL Tutorials](https://youtube.com/playlist?list=PLYqXmZaxvwmyLEXMpk-n4RFr59tpJjNXt\u0026si=RHy_FAnOJnPa4p1N)\n[My exercise solutions and chapter notes for Sutton-Barto](https://github.com/jekyllstein/Reinforcement-Learning-Sutton-Barto-Exercise-Solutions)\n[My MARL repository](https://github.com/jekyllstein/MARL_course/tree/main)\n[Kickoff Slides which contain other links](https://docs.google.com/presentation/d/1QD3iw5BgIpPpl_K_ApAlDr1NRseR1WmXme1dKQGqTOg/edit?usp=sharing)\n[MARL Kickoff Slides](https://docs.google.com/presentation/d/1FHXGVWkzjKsnNxzVN-29dx5vdkffAx5Vji5nWrDvg1Y/edit?usp=sharing)\n\nMARL Links:\n[Multi-Agent Reinforcement Learning: Foundations and Modern Approaches](https://www.marl-book.com/)\n[MARL Summer Course Videos](https://youtube.com/playlist?list=PLkoCa1tf0XjCU6GkAfRCkChOOSH6-JC_2\u0026si=lEljXo65s3fMUsRC)\n[MARL Slides](https://github.com/marl-book/slides)\n\nSutton and Barto Links:\n[Reinforcement Learning: An Introduction by Richard S. Sutton and Andrew G. Barto](http://incompleteideas.net/book/the-book.html)\n[Video lectures from a similar course](https://youtube.com/playlist?list=PLqYmG7hTraZDVH599EItlEWsUOsJbAodm)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/silicon-valley-generative-ai/events/317464502/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:531025547"},"displayPhoto":{"__ref":"PhotoInfo:531025547"},"feeSettings":null,"group":{"__ref":"Group:36685518"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":17,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:254657649"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485061099"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:438003859"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:470351652"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:154394392"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:107220852"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:200972279"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:290132061"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485499192"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:450038728"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:287518559"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:187840554"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:188073865"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:404781062"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:456969153"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:324749081"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:7558057"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:275629809":{"__typename":"PhotoInfo","id":"275629809","highResUrl":"https://secure.meetupstatic.com/photos/member/c/2/9/1/highres_275629809.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:250461911":{"__typename":"Member","id":"250461911","name":"Rob","memberPhoto":{"__ref":"PhotoInfo:275629809"}},"Event:317557797":{"__typename":"Event","id":"317557797","title":"AI INFRA SUMMIT","dateTime":"2026-12-09T08:00:00-08:00","description":"This event is organized by Ignite GTM.\n\nOur meetup group is collaborating by promoting this event.\n\nIn order to attend, please register here:\n\n[AI INFRA SUMMIT 6 · Luma](https://luma.com/aiinfra6?coupon=IPO20\u0026tk=ZDbDIC)\n\nOur meetup members get 20 PERCENT OFF!\n\nUse promo code:\n\nIPO20\n\nHurry!\n\nSlots are limited!\n\nAI is no longer an experiment. It’s the infrastructure race shaping economic power, technological sovereignty, and the next decade of global growth.\n\n​AI INFRA SUMMIT 6 brings this conversation to San Francisco, the center of gravity for AI innovation and deployment. This is where the builders of the AI stack come together: founders, operators, investors, policymakers, and infrastructure leaders powering the next generation of compute, data centers, and intelligent systems.\n\n​From chips to clusters to agentic workloads, AIS6 focuses on the systems turning AI from promise into production.\n​If you’re building, funding, or scaling at the AI infrastructure layer, this is where you align with the ecosystem defining what comes next.\n\n***\n\n## ​**Who Attends**\n\n* ​AI-native founders and builders\n* ​Cloud and infrastructure providers\n* ​Investors, venture capitalists, and strategic partners\n* ​Energy, chip, and data center operators\n* ​Policy and ecosystem leaders\n\n***\n\n## ​**Event Details**\n\n​**Date:** Wednesday, December 9th, 2026\n**Location:** San Francisco\n**Time:** 8:30 a.m.–8:00 p.m. PT\n**Host:** IgniteGTM\n\nIf you would like to have a demo / marketing table, please send an email message to:\n\nsiliconvalleysponsor@gmail.com\n\nPut this in the subject header:\n\nW 12/9/26 - Tabler","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/meetup-group-izengajf/events/317557797/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:474552125"},"feeSettings":null,"group":{"__ref":"Group:25755416"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:250461911"}}}]},"series":null,"venue":{"__typename":"Venue","name":"The Midway","address":"900 Marin St, San Francisco, CA 94124, USA","city":"San Francisco","state":"CA","country":"us"}}},"_sentryTraceData":"3b24d132dcf4a34603d0abc83bc8f9c9-b0da05747d2d2425-0","_sentryBaggage":"sentry-environment=production,sentry-release=ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb,sentry-public_key=5d12cd2317664353456ab4c40d079af2,sentry-trace_id=3b24d132dcf4a34603d0abc83bc8f9c9,sentry-org_id=6787,sentry-sampled=false,sentry-sample_rand=0.6231368368565546,sentry-sample_rate=0.01"},"__N_SSP":true},"page":"/find","query":{"keywords":"machine learning","location":"us--ca--San Francisco","source":"EVENTS"},"buildId":"ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb","isFallback":false,"isExperimentalCompile":false,"gssp":true,"locale":"en-US","locales":["en-US","en-AU","de","de-DE","es","es-ES","fr","fr-FR","it","it-IT","ja","ja-JP","ko","ko-KR","nl","nl-NL","pl","pl-PL","pt","pt-BR","ru","ru-RU","tr","tr-TR","th-TH"],"defaultLocale":"en-US","scriptLoader":[]}</script></body></html>