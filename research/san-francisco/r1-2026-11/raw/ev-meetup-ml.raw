<!DOCTYPE html><html lang="en-US"><head><meta charSet="utf-8" data-next-head=""/><style data-fullcalendar="true" data-next-head=""></style><meta name="viewport" content="width=device-width, initial-scale=1" data-next-head=""/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" data-next-head=""/><meta name="service" content="web-next" data-next-head=""/><meta name="X-Location" content="east" data-next-head=""/><meta name="X-Build-Version" content="ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb" data-next-head=""/><link rel="icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" type="image/x-icon" sizes="any" data-next-head=""/><link rel="shortcut icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" data-next-head=""/><link rel="apple-touch-icon" sizes="120x120" href="https://secure.meetupstatic.com/next/images/general/m_redesign_120x120.png" data-next-head=""/><link rel="apple-touch-icon" sizes="152x152" href="https://secure.meetupstatic.com/next/images/general/m_redesign_152x152.png" data-next-head=""/><link rel="apple-touch-icon" sizes="167x167" href="https://secure.meetupstatic.com/next/images/general/m_redesign_167x167.png" data-next-head=""/><link rel="shortcut icon" sizes="128x128" href="https://secure.meetupstatic.com/next/images/general/m_redesign_128x128.png" data-next-head=""/><link rel="shortcut icon" sizes="196x196" href="https://secure.meetupstatic.com/next/images/general/m_redesign_196x196.png" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Regular.1ca3b39b.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Medium.7b11edcf.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Bold.5c45f750.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Book.27256a60.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/Boyrun-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="https://www.facebook.com/tr?id=792405807634160&amp;ev=PageView&amp;noscript=1" as="image" data-next-head=""/><script type="application/ld+json" data-next-head="">{"@type":"Organization","@context":"https://schema.org","url":"https://www.meetup.com/find/","name":"Meetup","logo":"https://secure.meetupstatic.com/next/images/general/m_redesign_630x630.png","sameAs":["https://www.facebook.com/meetup/","https://twitter.com/Meetup/","https://www.youtube.com/meetup","https://www.instagram.com/meetup/"]}</script><title data-next-head="">Find Events &amp; Groups | Meetup</title><meta name="description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="fb:app_id" content="2403839689" data-next-head=""/><meta property="og:site_name" content="Meetup" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:title" content="Find Events &amp; Groups | Meetup" data-next-head=""/><meta property="og:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="og:url" content="https://www.meetup.com/find/" data-next-head=""/><meta property="og:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="al:android:app_name" content="Meetup" data-next-head=""/><meta property="al:android:package" content="com.meetup" data-next-head=""/><meta property="al:ios:app_store_id" content="375990038" data-next-head=""/><meta property="al:ios:app_name" content="Meetup" data-next-head=""/><meta property="al:web:should_fallback" content="true" data-next-head=""/><meta property="al:android:url" content="meetup://" data-next-head=""/><meta property="al:ios:url" content="meetup://" data-next-head=""/><meta property="al:web:url" content="https://www.meetup.com/" data-next-head=""/><meta property="twitter:card" content="summary_large_image" data-next-head=""/><meta property="twitter:site" content="@meetup" data-next-head=""/><meta property="twitter:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="twitter:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="twitter:app:id:iphone" content="375990038" data-next-head=""/><meta property="twitter:app:name:iphone" content="Meetup" data-next-head=""/><meta property="twitter:app:id:ipad" content="375990038" data-next-head=""/><meta property="twitter:app:name:ipad" content="Meetup" data-next-head=""/><meta property="twitter:app:id:googleplay" content="com.meetup" data-next-head=""/><meta property="twitter:app:name:googleplay" content="Meetup" data-next-head=""/><meta name="robots" content="noindex, follow" data-next-head=""/><link rel="canonical" href="https://www.meetup.com/find/" data-next-head=""/><link rel="preconnect" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com" data-next-head=""/><link rel="dns-prefetch" href="https://www.googletagmanager.com" data-next-head=""/><script type="application/ld+json" data-next-head="">[{"@context":"https://schema.org","@type":"Event","name":"Agentic AI Year in Review","url":"https://www.meetup.com/bay-area-bot-chat-and-conversational-app-developers/events/317519271/","description":"**Agentic AI Year in Review!**\nJoin us for an exciting evening discussing the top startup trends in Agentic AI of 2026 and predictions for 2027.\n\n**Featuring:**\n\n* [Shruti Merchant](https://www.linkedin.com/in/shrutimerchant/), Partner, Pear VC\n* [Tabish Gilani](https://www.linkedin.com/in/tabishgilani/), Product Growth Partner, a16z Speedrun\n* [Tracy Rubin](https://www.linkedin.com/in/tracy-rubin-a54439156/), Partner, Cooley LLP\n\n**Registration**\nTo attend, you need to [register at luma](https://luma.com/veyokv1b?utm_source=bachat) **<-** **Please register at Luma as the venue requires this.**\n\n**Agenda**\nDate: Tues December 8th, 5:00pm (**doors open at 5pm**)\nLocation: GitHub, 275 Brannan St, San Francisco (entrance on Brannan)\n\n* 5:00-6:00pm doors open for networking\n* 6:00-7:00pm panel discussion\n* 7:00-7:30pm additional networking\n\n**Want to demo?**\nIf you are interested in demoing at a future event, please fill out the [application form](https://forms.gle/ahzwgnAAs51pdiTQ9).","startDate":"2026-12-09T01:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"GitHub","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"275 Brannan St, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Bay Area Chatbot, Voice Assistants, and Conversational AI","url":"https://www.meetup.com/bay-area-bot-chat-and-conversational-app-developers/"},"performer":"Bay Area Chatbot, Voice Assistants, and Conversational AI"},{"@context":"https://schema.org","@type":"Event","name":"[SF] AI Builder Tour with Bluehost","url":"https://www.meetup.com/sv-enterprise-ai/events/317572865/","description":"**Important**: Registration on the[ ](https://www.aicamp.ai/event/eventdetails/W2026120306)[event website](https://www.aicamp.ai/event/eventdetails/W2026111709) is required for admission.\n(RSVP on meetup is turned off)\n\nJoin us for the Bluehost AI Builder Tour - San Francisco, an in-person experience bringing together entrepreneurs, developers, creators, and local AI builders ready to move from vision to launch and scale.\n\nWhether you're developing your next big idea, launching a business, or scaling something you've already built, this is your opportunity to connect with fellow builders, explore new possibilities, and get expert feedback.\n\n**Three awards, three chances to win awards - $30,000**:\nExplore three exciting opportunities to compete:\n\n* Build with Anything — Create an AI-powered solution using the tools of your choice.\n* Build & Win with Bluehost — Build a website or app using Bluehost AI Builder.\n* Vibeathon — Put your AI-powered creativity and building skills to the test.\n\n**What to Expect:**\n\n* Local AI Builder Showcases: Hear from local builders about their projects, challenges, and lessons learned.\n* Build, Host & Scale: Discover Bluehost innovations to help build, host, and run your projects.\n* Interactive AI Workshop: Bring your ideas or work in progress and get feedback from AI builders and experts.\n* Peer-to-Peer Breakouts: Discuss AI agents, infrastructure, performance, and costs with peers and experts.\n* Community & Networking: Connect with local AI builders, entrepreneurs, and industry experts.\n\n**Featured Speakers:**\n\n* Salim Ali, Bluehost\n* Antonis Papatsaras, Bluehost\n* Vishwa Shroff, Bluehost\n* Ana Ramdas, Build First\n* and more\n*\n\n**Agenda:**\n\n* 9:00am–9:30am: Coffee, Networking & Demos\n* 9:30am–10:00am: Welcome & Introduction\n* 10:00am–12:00pm: AI Builder Showcases & Workshop\n* 12:00pm–1:00pm: Lunch\n* 1:00pm–3:00pm: Interactive Workshop & Expert Feedback\n* 3:15pm–4:30pm: Peer Discussions & Expert Consultations\n* 5:00pm onwards: Happy Hour & Networking\n*","startDate":"2026-12-09T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"The Avalon","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"1244 Sutter St, San Francisco, CA 94109, USA, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Silicon Valley Enterprise AI","url":"https://www.meetup.com/sv-enterprise-ai/"},"performer":"Silicon Valley Enterprise AI"},{"@context":"https://schema.org","@type":"Event","name":"AI Book Club: Reinforcement Learning from Human Feedback (RLHF)","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685013/","description":"**Novembers's book is \"Reinforcement Learning from Human Feedback\"!**\n\n​This is a casual-style event. Not a structured presentation on topics. Sometimes, the discussion even drifts away from the chapters, but feel free to grab the mic to help steer it back.\n\n​Feel free to join the discussion even if you have not read the book chapters! :)\n​Want to discuss the contents during the reading week? Join the AI Slack group: https://slack.flyte.org/\n​-------------------------------------------------\nAbout the book:\n\n* ​Title: **Reinforcement Learning from Human Feedback**\n* ​Authors: Nathan Lambert\n* ​Published: August 2026\n\n​Manning (Promo code: AIBookClub should give you 45% off: [https://www.manning.com/books/reinforcement-learning-from-human-feedback](https://www.manning.com/books/reinforcement-learning-from-human-feedback?utm_source=luma)\n​O'rielly platform: [https://learning.oreilly.com/library/view/reinforcement-learning-from/9781633434301/](https://learning.oreilly.com/library/view/reinforcement-learning-from/9781633434301/?utm_source=luma)\n​\n​Chapters:\n\n* ​1 Introduction\n* ​2 A tiny history of RLHF\n* ​3 Training overview\n* ​4 Instruction fine-tuning\n* ​5 Reward modeling\n* ​6 Reinforcement learning\n* ​7 Reasoning and inference-time scaling\n* ​8 Direct-alignment algorithms\n* ​9 Rejection sampling\n* ​10 The nature of preferences\n* ​11 Preference data\n* ​12 Synthetic data\n* ​13 Tool use and function calling\n* ​14 Over-optimization\n* ​15 Regularization\n* ​16 Evaluation\n* ​17 Crafting model character and products\n\n​**Book Description**\n​***Reinforcement Learning from Human Feedback: LLM alignment and post-training* helps you understand how modern AI models can be adapted to better match the needs and expectations of their users. Rather than surveying the vast field of reinforcement learning, elite AI researcher Nathan Lambert concentrates exclusively on RLHF and its immediate importance to post-training generative AI models.**\n\n**This compact book gets right to the point. Early chapters establish the training overview, explain instruction fine-tuning, and build reliable reward models. The middle chapters transition into the heart of alignment, exploring core policy gradient algorithms, Direct Preference Optimization (DPO), and inference-time scaling. Later chapters tackle the messy reality of data, guiding you through preference data collection, synthetic data generation, and the nuances of function calling.**","startDate":"2026-12-08T21:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685013/"},"organizer":{"@type":"Organization","name":"AI Builders and Learners SF","url":"https://www.meetup.com/ai-builders-and-learners-sf/"},"performer":"AI Builders and Learners SF"},{"@context":"https://schema.org","@type":"Event","name":"Build an Agentic AI Model Factory: Own Your AI","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318556/","description":"​**Build a Sovereign AI Factory: an ML Engineer Agent that evaluates, fine-tunes, deploys, and improves open models.**\nRSVP on Luma for live link: https://luma.com/vfhq98ji\n\n​AI teams are starting to look beyond renting every capability from an external API, they're building systems they own and control. In this hands-on session we'll build exactly that by creating an ML Engineer Agent that will manage a model factory to select and fine-tune the best models for your applications.\n\n​We'll start with a walkthrough where we build an agent that evaluates open models in parallel, fine-tunes promising candidates, deploys the winner, and retrains automatically when performance drops. Think of it as the first brick in your own **model factory**: a repeatable system for evaluating, improving, and deploying models *you* control.\n\n​You'll see how [Union.ai](https://union.ai/?utm_source=luma) & Flyte give your AI workflows a **durable runtime** with *infrastructure as context,* so agents adapt infra resources, recover from failures, and keep moving without re-running completed work. And because it all runs in **your own cloud**, you own the full stack end to end: **your models, your data, your infrastructure, your IP.**","startDate":"2026-12-09T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318556/"},"organizer":{"@type":"Organization","name":"AI Builders and Learners SF","url":"https://www.meetup.com/ai-builders-and-learners-sf/"},"performer":"AI Builders and Learners SF"},{"@context":"https://schema.org","@type":"Event","name":"Build a Better AI Homelab with Flyte","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318592/","description":"​**Build a Sovereign AI Factory: an ML Engineer Agent that evaluates, fine-tunes, deploys, and improves open models.**\nRSVP on Luma for live link: https://luma.com/vfhq98ji\n\n​AI teams are starting to look beyond renting every capability from an external API, they're building systems they own and control. In this hands-on session we'll build exactly that by creating an ML Engineer Agent that will manage a model factory to select and fine-tune the best models for your applications.\nRSVP on Luma for live link: https://luma.com/wy08j2yx\n\n​We'll start with a walkthrough where we build an agent that evaluates open models in parallel, fine-tunes promising candidates, deploys the winner, and retrains automatically when performance drops. Think of it as the first brick in your own **model factory**: a repeatable system for evaluating, improving, and deploying models *you* control.\n\n​You'll see how [Union.ai](https://union.ai/?utm_source=luma) & Flyte give your AI workflows a **durable runtime** with *infrastructure as context,* so agents adapt infra resources, recover from failures, and keep moving without re-running completed work. And because it all runs in **your own cloud**, you own the full stack end to end: **your models, your data, your infrastructure, your IP.**","startDate":"2026-12-16T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318592/"},"organizer":{"@type":"Organization","name":"AI Builders and Learners SF","url":"https://www.meetup.com/ai-builders-and-learners-sf/"},"performer":"AI Builders and Learners SF"},{"@context":"https://schema.org","@type":"Event","name":"AI Book Club: An Illustrated Guide to AI Agents","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685067/","description":"​**Decembers book is \"An Illustrated Guide to AI Agents\"!**\n​This is a casual-style event. Not a structured presentation on topics. Sometimes, the discussion even drifts away from the chapters, but feel free to grab the mic to help steer it back.\n\n​Feel free to join the discussion even if you have not read the book chapters! :)\n​Want to discuss the contents during the reading week? Join the AI Slack group: https://slack.flyte.org/\n​-------------------------------------------------\nAbout the book:\n\n* ​Title: **An Illustrated Guide to AI Agents**\n* ​Authors: Maarten Grootendorst, Jay Alammar\n* ​Published: September 2026\n\n​O'rielly platform: [https://learning.oreilly.com/library/view/an-illustrated-guide/9798341662681/](https://learning.oreilly.com/library/view/an-illustrated-guide/9798341662681/?utm_source=luma)\n​\n​Chapters:\n\n1. ​Introduction\n2. ​Large Language Models\n3. ​Reasoning Large Language Models\n4. ​Memory\n5. ​Tool Usage, Learning, and Protocols\n6. ​Planning and Reflection\n7. ​Evaluating Agents\n8. ​8. Multi-Agent Systems\n9. ​Multi-Modal Understanding\n10. ​Code Agents and Code LLMs\n\n​**Book Description**\n​Artificial intelligence is entering a new phase. AI agents can now reason, plan, and act with increasing independence. From accelerating scientific breakthroughs to supporting creative work, these systems are quickly reshaping industries and everyday life. This book provides the conceptual foundation and practical insights you need to understand—and effectively work with—this emerging technology.\n\n​Through hundreds of clear graphic illustrations, Maarten Grootendorst and Jay Alammar explain how AI agents are built, how they think, and where they're heading. Designed for professionals, students, and curious learners alike, this guide goes beyond the buzz to reveal what's actually happening inside these systems, why it matters, and how to apply the knowledge in real-world contexts. *An Illustrated Guide to AI Agents* is your essential reference for navigating the next frontier of artificial intelligence.","startDate":"2026-12-22T21:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-builders-and-learners-sf/events/316685067/"},"organizer":{"@type":"Organization","name":"AI Builders and Learners SF","url":"https://www.meetup.com/ai-builders-and-learners-sf/"},"performer":"AI Builders and Learners SF"},{"@context":"https://schema.org","@type":"Event","name":"Build and evaluate a retrieval workflow: evidence before confidence","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480895/","description":"A live, interactive AumOS session, open to everyone. Level: engineering; guided build with observer option.\n\n**What you will do:** Inspect a small retrieval workflow and test whether its answers are supported by the provided documents.\n\n**Prerequisites:** Basic Python/Git helpful for the hands-on path; a guided observer path will be available.\n\n**Take-away:** Small document set, question set, expected evidence and an evaluation worksheet.\n\n**Format:** 90 minutes, live online, with a worked example, exercise, discussion and questions. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized examples.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to ask a question, share a relevant experience and meet people building with AI around the world. No employer, university or independent community endorsement is implied.","startDate":"2026-12-06T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480895/"},"organizer":{"@type":"Organization","name":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/"},"performer":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS"},{"@context":"https://schema.org","@type":"Event","name":"Open-source AI contribution clinic: reproduce, review and improve","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480915/","description":"A live, interactive AumOS session, open to everyone. Level: engineering / open source & research.\n\n**What you will do:** Turn a technical question into a small, attributable and reproducible contribution proposal.\n\n**Prerequisites:** Bring a public issue, documentation problem or small experiment; beginners can use a guided documentation track.\n\n**Take-away:** Reproduction note or draft contribution with setup, expected behavior, observed behavior and limits.\n\n**Format:** 90 minutes, live online, with a worked example, exercise, discussion and questions. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized examples.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to ask a question, share a relevant experience and meet people building with AI around the world. No employer, university or independent community endorsement is implied.","startDate":"2026-12-20T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317480915/"},"organizer":{"@type":"Organization","name":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/"},"performer":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS"},{"@context":"https://schema.org","@type":"Event","name":"Frontier AI, live: what changed this month and what holds up","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317491600/","description":"A live AumOS session for experienced engineers, researchers and senior practitioners. Level: Frontier.\n\n**What you will do:** Take apart two or three recent results in models, reasoning, agents or on-device AI; test one claim live on open models; and agree on the open research questions the community works on next.\n\n**Prerequisites:** Working knowledge of machine learning or LLM systems. A short pre-read goes to everyone who RSVPs. Newcomers are welcome to listen.\n\n**Take-away:** Shared notes, a reproduction notebook and a list of open research tracks you can join or lead.\n\n**Format:** 90 minutes, live online: a short teardown, a live test and open discussion. Want to present a result at a future session? Say so in the group. Free and open to everyone, wherever you are. The online room link is shared with everyone who RSVPs, and Meetup shows the start time in your own time zone. Use only public, synthetic, licensed or authorized material.\n\nHosted by AumOS, a global, community-led initiative to democratize AI for everyone, everywhere. What we make together is shared openly.\n\nCome ready to challenge a claim, share a result and meet people working at the frontier of AI around the world. No employer, university or independent community endorsement is implied.","startDate":"2026-12-05T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/events/317491600/"},"organizer":{"@type":"Organization","name":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS","url":"https://www.meetup.com/aumos-sf-bay-area-ai-builders-open-source/"},"performer":"AI for Everyone SF Bay Area | Beginner to Expert · AumOS"},{"@context":"https://schema.org","@type":"Event","name":"Weekly paper review, coding project, or random discussion","url":"https://www.meetup.com/west-coast-machine-learning-meetup/events/315814934/","description":"This is a placeholder for our weekly meeting. We will update the meeting description each week to include the topic of the week. Stay tuned :)\n\nEvery week we meet (virtually) and discuss the most interesting topics in AI, ML and Deep Learning.\nWe usually rotate weeks so that every other week one of the members presents a deep learning/machine learning paper, frequently paired with a video explaining the concepts. In the off weeks, we present information about different projects. We cover computer vision, language (LLM's), health/hard science and generative models (Diffusion, GAN's etc.).\nPeople of all levels of skill are welcome--from newbies to machine learning, to PhD's in DL/ML/AI.\nWe have been meeting for over 6 years weekly and have developed a neat pace and community--and all are welcome. Come join us and stay abreast of the biggest topics in Artificial Intelligence.","startDate":"2026-11-27T02:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/west-coast-machine-learning-meetup/events/315814934/"},"organizer":{"@type":"Organization","name":"West Coast Machine Learning Meetup (aka East Bay/Trivalley)","url":"https://www.meetup.com/west-coast-machine-learning-meetup/"},"performer":"West Coast Machine Learning Meetup (aka East Bay/Trivalley)"},{"@context":"https://schema.org","@type":"Event","name":"Welcome to the Machine Learning Study Group #67","url":"https://www.meetup.com/study-machine-learning/events/317389239/","description":"Join us for our 67th Machine Learning Study Group meeting!\nDuring the second half we will walk through a more advanced ML topic.\n\nThe first half will be devoted to helping people start and continue their journey to a Machine Learning engineer.\n\nWhether you're a complete beginner or experienced practitioner, you're welcome to join. We'll review fundamentals and build from there. During the Zoom session, you'll have the opportunity to share your own ML/AI projects.\n\nWhat we've done over the past year:\n\\- First\\, we learned to run Llama 2 locally using Ollama\n\\- Then\\, we expanded to cloud platforms\\, running models on Colab and other services \\(we may demonstrate this again on Colab and Kaggle\\)\nWe have demonstrated RAG (Retrieval-Augmented Generation)locally and in Google Colab.\nNext we demonstrated fine-tuning on a cloud platform.\nWe examined LM Studio and vLLM\nWe also worked with agents and writing an LLM from scratch.\nBuilding another RAG system.\nConverting huggingface gguf files to the ollama format.\nCome learn together in a supportive environment where no question is too basic!","startDate":"2026-12-02T00:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/study-machine-learning/events/317389239/"},"organizer":{"@type":"Organization","name":"Study Machine Learning","url":"https://www.meetup.com/study-machine-learning/"},"performer":"Study Machine Learning"},{"@context":"https://schema.org","@type":"Event","name":"Make Your GPU Earn Its Keep: A Kernel Engineering Deep Dive","url":"https://www.meetup.com/ai-performance-engineering/events/317171245/","description":"**Monday, November 30, 2026 · 9:00–10:00 AM PST · Online**\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\nA powerful GPU can spend plenty of time waiting. What is it waiting for—and how do you find out?\n**Talk #0: Welcome and Meetup Updates**\nby Chris Fregly and Antje Barth\n**Talk #1: From “Why Is This Slow?” to a Faster Kernel**\nby Dr. Rajat “Raj” Dandekar, Co-founder of Vizuara\nJoin Raj for a focused tour of the engineering behind fast AI kernels, drawing on Vizuara’s Kernel Engineering course on Maven. We’ll connect the roofline model to CUDA execution and the GPU memory hierarchy, then look at how profiling guides optimizations such as coalesced memory access, tiling, and tensor-core use. Matrix multiplication and attention provide context for seeing how those ideas fit together in modern AI workloads, including FlashAttention.\nThe goal is a practical way to decide what to measure, which bottleneck matters, and whether an optimization helped. The session is dedicated to Raj’s talk, with time for audience questions.\n**Who it’s for:** Engineers comfortable with Python or basic PyTorch. Prior CUDA or C++ experience is not required.\n**Bio:** Dr. Rajat Dandekar is a co-founder of Vizuara and a Kernel Engineering course instructor. He holds a PhD in Mechanical Engineering from Purdue University and BTech and MTech degrees from IIT Madras.\n**Based on:** [Kernel Engineering: From CUDA Foundations to Frontier AI Kernels](https://maven.com/rajat-dandekar/kernel-engineering)\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\n**Related Links**\nGithub Repo: [http://github.com/cfregly/ai-performance-engineering/](http://github.com/cfregly/ai-performance-engineering/)\nO’Reilly Book: [https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/](https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/)\nYouTube: [https://www.youtube.com/@AIPerformanceEngineering](https://www.youtube.com/@AIPerformanceEngineering)\nGenerative AI Free Course on DeepLearning.ai: [https://bit.ly/gllm](https://bit.ly/gllm)","startDate":"2026-11-30T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/ai-performance-engineering/events/317171245/"},"organizer":{"@type":"Organization","name":"AI Performance Engineering Meetup (San Francisco, Global)","url":"https://www.meetup.com/ai-performance-engineering/"},"performer":"AI Performance Engineering Meetup (San Francisco, Global)"},{"@context":"https://schema.org","@type":"Event","name":"Local+Online Meetup: In-House ASR Architecture & Accurate Word Timestamps #001","url":"https://www.meetup.com/bay-area-voice-ai-happy-hours/events/317548418/","description":"Join fellow speech engineers, researchers, and voice AI builders in the South Bay for an evening of technical talks, paper deep dives, and casual networking!\n\n**Event Details**\n\n* **Who should come:** Voice AI researchers, engineers, and entrepreneurs\n* **When:** Every other Thursday, 6:30 PM – 8:30 PM\n* **Format:** Hybrid (in person at Hacker Dojo, plus online via **YouTube Live at https://www.youtube.com/@olewave** and Bilibili Live — direct stream links will be shared later)\n* **Cost:** Draft beer is free; $10 onsite food & drink chip-in for pizza and non-alcoholic beverages (free for students with valid ID)\n* **Food & drinks:** Draft beer, pizza, and non-alcoholic beverages provided\n\n**Agenda**\n**6:30 PM – 7:00 PM \\| Arrival & Open Networking** Grab a drink, meet fellow voice AI builders and researchers, and settle in.\n**7:00 PM – 8:00 PM \\| Main Program**\n\n* **7:00 PM – 7:05 PM:** **Voice AI News & Community Updates** (5 min)\n* **7:05 PM – 7:30 PM:** **Tech Share: Building In-House Voice AI Solutions - ASR - Part 1: Overview and Architecture** (20 min talk + 5 min Q&A) — Practical architecture, data, and deployment lessons learned from a speech AI veteran with more than 10 years of industry consulting experience.\n* **7:30 PM – 7:35 PM:** **Quick Break** (5 min) — Grab a drink refill and stretch before the paper walkthrough.\n* **7:35 PM – 8:00 PM:** **Paper Reading Deep Dive: Accurate ASR Word Timestamps** (20 min walkthrough + 5 min Q&A) — A walkthrough of **FA-Bench** and its open leaderboard, followed by a look at how **Olign** achieves high-precision word- and phone-level speech alignment.\n\n**8:00 PM – 8:30 PM \\| Happy Hour Mingle & Wrap\\-Up** Continue the conversation with the speaker, exchange contacts, and hang out until close.\n\n**About the Speaker**\n**Wei Chu** has more than 10 years of experience in building internal voice AI solutions to beat external tech-giant API vendors in accuracy, latency, and cost. He received his PhD in speech from the EE Department at UCLA and is the Founder and CEO of **Olewave**, which focuses on voice datasets, benchmarks, and solutions. He also hosts the Olewave Speech & NLP Paper Reading channel on YouTube (**[youtube.com/@olewave](https://www.google.com/search?q=https%3A%2F%2Fyoutube.com%2F%40olewave)**) and organizes the Bay Area Voice AI Happy Hours Meetup (**[https://www.meetup.com/bay-area-voice-ai-happy-hours](https://www.meetup.com/bay-area-voice-ai-happy-hours)**). Outside of work, he likes soccer, fish cuisines, and traveling to learn languages, peoples, and cultures.\n\n**Location & How to Get There**\n**Venue:** Hacker Dojo **Address:** 3200 Patrick Henry Dr #250, Santa Clara, CA 95054 **Getting in:** Please use the main entrance with the automatic doors at 3200 Patrick Henry Dr.\n\n* **Driving & Parking:** Easily accessible via US-101 (exit Great America Pkwy / Bowers Ave) or CA-237 (exit Great America Pkwy). Free surface parking is available in the lot surrounding the building—look for Suite #250.\n* **Public Transit (VTA Light Rail & Caltrain):**\n* **VTA Light Rail:** Take the Orange Line to the **Great America Station** or **Old Ironsides Station**, both about a 10–15 minute walk from the venue.\n* **Caltrain + Transfer:** Take Caltrain to **Mountain View Station** and transfer to the VTA Orange Line toward Alum Rock, exiting at Great America Station (or take a \\~10-minute rideshare from Lawrence or Sunnyvale Caltrain stations).\n* **Biking:** Located right near the San Tomas Aquino Creek Trail for a direct, car-free bike commute from surrounding Silicon Valley neighborhoods.\n\n**Call for Volunteers**\nWe are looking for volunteers to help with check-in, A/V and livestream setup, and food/drink logistics! If you'd like to pitch in (volunteers get free admission and food), please message the organizers or reach out via Luma/Meetup.","startDate":"2026-12-04T02:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","address":{"@type":"PostalAddress","addressLocality":"","addressRegion":"","addressCountry":""}},"organizer":{"@type":"Organization","name":"Bay Area Voice AI Happy Hours: Tech Share and Paper Reading","url":"https://www.meetup.com/bay-area-voice-ai-happy-hours/"},"performer":"Bay Area Voice AI Happy Hours: Tech Share and Paper Reading"},{"@context":"https://schema.org","@type":"Event","name":"Dec 10 - AI, ML and Computer Vision Meetup","url":"https://www.meetup.com/santa-cruz-machine-learning-meetup-group/events/316757887/","description":"Join our virtual meetup to hear talks from experts on cutting-edge topics across AI, ML, and computer vision.\n\n**Date, Time and Location**\n\nDec 10, 2026\n9:00 AM - 11:00 AM PST\nOnline. **[Register for the Zoom!](https://voxel51.com/events/ai-ml-and-computer-vision-meetup-december-10-2026)**\n\n**Your mAP is fine. Your slices are not. Finding the images that actually matter**\n\nA single mAP can look acceptable while one slice is unusable, small objects, occlusion, or a confused class. I will run a pretrained detector on a few hundred public images (COCO-style, not a production crawl), report the headline metric, then break the same run by slice and walk through the worst samples.\n\nThe claim is modest: you do not need a million images or a trained-from-scratch model to see what the mean is hiding, and you cannot relabel everything, so the next labeling budget should follow those slices. No employer data and no confidential dashboards.\n\n*About the Speaker*\n\n[Amandeep Jiddewar](https://www.linkedin.com/in/amanfj/) is a Machine Learning Engineer at Pinterest, with prior work in U.S. manufacturing analytics (CertainTeed / Saint-Gobain) and marketplace allocation (QuinStreet). Emory Goizueta MSBA (2019), Kaggle Expert. This talk is in his personal capacity and does not represent his current or prior employers.\n\n**Production AI Agents: Tool Use, Evaluation, Guardrails and Observability**\n\nBuilding an AI agent is easy. Knowing whether it is behaving reliably in production is much harder. This session explores how to evaluate agents that use tools and external systems, including tool-call validation, tracing, observability, failure analysis, guardrails, permissions, and human review.\n\nAttendees will learn practical patterns for understanding not just what an agent answered, but why it acted and whether the action was safe.\n\n*About the Speaker*\n\n[Akshay Talathi](https://www.linkedin.com/in/akshaytalathi/) is a Vice President at Goldman Sachs with over 10 years of experience building large-scale, cloud-native, and distributed systems across financial services and technology. His current focus is GenAI and agentic AI, including production AI agents, MCP, enterprise integrations, guardrails, observability, and reliable AI-driven workflows.\n\n**From Virtual Worlds to Physical AI: Building Simulation Pipelines That Survive the Real World**\n\nRobots are moving beyond perception systems that only detect and classify objects toward systems that must understand a scene, learn behaviors, and act in the physical world. In this talk, I’ll show a practical Physical AI workflow using OpenUSD, BowerBot, NVIDIA Isaac Sim and Isaac Lab to build a robot’s virtual world, including its body, cameras, sensors, and environment.\n\nWe’ll explore how demonstrations and reinforcement learning can teach behaviors in simulation, how vision and sensor data become observations for a robot policy, and what needs to match when transferring that behavior to real hardware. The demo follows a small robot from a simulated environment toward a real-world task, exposing both the power and the limitations of sim-to-real.\n\nThe goal is to make the path from pixels to actions concrete for computer vision and machine learning practitioners.\n\n*About the Speaker*\n\n[Arturo Morales Rangel](https://www.linkedin.com/in/arturo-morales-rangel) is the founder of Binary Core LLC, a Physical AI engineering company working across simulation, perception, robot learning, and deployment.\n\n**Prompting Video-Language Models in Production: Lessons from Enterprise Video Tagging and Evaluation**\n\nVideo-language models can now describe, tag and answer questions about long-form video, but production results depend heavily on prompt design and evaluation. This talk shares field lessons from deploying such models for media, news, streaming and sports organizations, including how to structure prompts for consistent, schema-bound outputs across hours of footage.\n\nOn one sports video-tagging project, consolidating the prompt definitions cut estimated processing cost about 3x, and about 90% of the originally reported issues were later resolved through prompting alone. I'll also walk through building evaluation frameworks for video outputs, including for hard domains like egocentric video, and what changes when migrating between model versions.\n\nAttendees will leave with reusable prompt patterns and an evaluation checklist they can apply to their own video pipelines.\n\n*About the Speaker*\n\n[Yash Gugale](https://www.linkedin.com/in/yashgugale/) is a Senior Forward Deployed Engineer at TwelveLabs in New York, integrating video foundation models (Marengo for embeddings and search, Pegasus for video-language understanding) for media, news, streaming and sports customers. He previously spent about six years in video streaming engineering at Peloton and Samsung TV Plus, and holds an MS in Computer Graphics Technology from Purdue.","startDate":"2026-12-10T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/santa-cruz-machine-learning-meetup-group/events/316757887/"},"organizer":{"@type":"Organization","name":"Santa Cruz AI and Machine Learning Meetup Group","url":"https://www.meetup.com/santa-cruz-machine-learning-meetup-group/"},"performer":"Santa Cruz AI and Machine Learning Meetup Group"},{"@context":"https://schema.org","@type":"Event","name":"Bay Area AI War Room - Berkeley Edition - Saturday, 10:00 AM","url":"https://www.meetup.com/bay-area-artificial-war-room/events/313150527/","description":"Models, agent, systems, ethics, the law, business, art and impact we discuss it all. With the DeepSeek hoopla fading, what of Reasoning models?\n\nInspired by the Berkeley AI War Room, we invite you to join us at the same venue, same time, and with the same dynamic community.\n\nCome share your interests, showcase your projects, and discuss the latest trends and news that's shaping the AI landscape at a rapid pace.","startDate":"2026-12-05T18:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Victory Point Cafe","address":{"@type":"PostalAddress","addressLocality":"Berkeley","addressRegion":"CA","addressCountry":"us","streetAddress":"1797 Shattuck Ave. Ste A, Berkeley, CA"}},"organizer":{"@type":"Organization","name":"Bay Area AI War Room","url":"https://www.meetup.com/bay-area-artificial-war-room/"},"performer":"Bay Area AI War Room"},{"@context":"https://schema.org","@type":"Event","name":"Deep Learning Study Group","url":"https://www.meetup.com/handsonprogrammingevents/events/315280338/","description":"Deep learning is evolving quickly. Important new developments are appearing daily. This group attempts to keep up by reading and discussing current deep learning literature. This meetup uses discussion among the participants to speed understanding of current research results. That requires that some participants read the paper before attending. Anyone is welcome to attend and listen without reading the paper. If nobody reads the paper the meeting will be short.\n\nPaper for December 1, 2026:\nUnderstanding, Predicting, and Steering LLM Behavior via Representational Effective Theory\nhttps://arxiv.org/pdf/2605.09294\n\nPapers that we're reading, code that participants generate and other random stuff can be found at github site for the group.\nhttps://github.com/davidmacmillan/DeepLearningStudyGroup","startDate":"2026-12-02T02:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/handsonprogrammingevents/events/315280338/"},"organizer":{"@type":"Organization","name":"Silicon Valley Hands On Programming Events","url":"https://www.meetup.com/handsonprogrammingevents/"},"performer":"Silicon Valley Hands On Programming Events"},{"@context":"https://schema.org","@type":"Event","name":"Agentic AI Year in Review","url":"https://www.meetup.com/bay-area-research-in-nlp-and-ml/events/317519279/","description":"**Agentic AI Year in Review!**\nJoin us for an exciting evening discussing the top startup trends in Agentic AI of 2026 and predictions for 2027.\n\n**Featuring:**\n\n* [Shruti Merchant](https://www.linkedin.com/in/shrutimerchant/), Partner, Pear VC\n* [Tabish Gilani](https://www.linkedin.com/in/tabishgilani/), Product Growth Partner, a16z Speedrun\n* [Tracy Rubin](https://www.linkedin.com/in/tracy-rubin-a54439156/), Partner, Cooley LLP\n\n**Registration**\nTo attend, you need to [register at luma](https://luma.com/veyokv1b?utm_source=nlp) **<-** **Please register at Luma as the venue requires this.**\n\n**Agenda**\nDate: Tues December 8th, 5:00pm (**doors open at 5pm**)\nLocation: GitHub, 275 Brannan St, San Francisco (entrance on Brannan)\n\n* 5:00-6:00pm doors open for networking\n* 6:00-7:00pm panel discussion\n* 7:00-7:30pm additional networking\n\n**Want to demo?**\nIf you are interested in demoing at a future event, please fill out the [application form](https://forms.gle/ahzwgnAAs51pdiTQ9).","startDate":"2026-12-09T01:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"GitHub","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"275 Brannan St, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Bay Area Research in NLP and ML","url":"https://www.meetup.com/bay-area-research-in-nlp-and-ml/"},"performer":"Bay Area Research in NLP and ML"},{"@context":"https://schema.org","@type":"Event","name":"Beyond Analytics: Turning Microsoft Fabric Insights Into Decisions","url":"https://www.meetup.com/meetup-group-izengajf/events/317563874/","description":"This event is organized by SAS.\n\nThis event is being promoted by many groups.\n\nOur meetup group is participating by promoting this event.\nOur meetup group is collaborating by promoting this event.\n\nThis is an online event.\n\nAttendees can be located anywhere in the world!\n\nThis event is FREE to attend!\n\nIn order to attend, please register here:\n[https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html](https://www.sas.com/en_us/webinars/beyond-analytics-turning-microsoft-fabric-insights-into-decisions.html)\nOrganizations have more data, analytics and predictive capabilities than ever. Yet turning those insights into timely, consistent business decisions remains a challenge.\nDisconnected systems, manual processes and fragmented operations often stand in the way. For example, banks have customer data, predictive models and business criteria spread throughout the organization, slowing loans and credit decisions.\nJoin experts from SAS and Katalyze to explore how decision intelligence bridges the gap between insights, actions and business outcomes. Discover how SAS Decision Builder on Microsoft Fabric helps organizations connect analytics, business rules and organizational judgment to make more consistent, governed decisions.\n\n## You’ll learn more about:\n\n* Bridging the decision gap: Why insights don’t always translate into action and business outcomes – and how decision intelligence helps.\n* Connecting decision-making components: How business rules, predictive models, organizational judgment and governance work together.\n* Overcoming organizational barriers: How to address disconnected workflows, manual processes and unclear decision ownership.\n* Operationalizing decisions with SAS: How SAS Decision Builder on Microsoft Fabric orchestrates governed decision workflows using data in Microsoft OneLake.\n* Putting decision intelligence into practice: How SAS and Katalyze can help identify high-value decisioning opportunities in the pharmaceutical, financial services and legal industries.\n\nTry SAS Decision Builder for free today: [https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview](https://marketplace.microsoft.com/en-us/product/saas/sas-institute-560503.sas-saas-db-msft-fabric?tab=overview)","startDate":"2026-12-01T15:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/meetup-group-izengajf/events/317563874/"},"organizer":{"@type":"Organization","name":"Sunnyvale Data Science Meetup","url":"https://www.meetup.com/meetup-group-izengajf/"},"performer":"Sunnyvale Data Science Meetup"},{"@context":"https://schema.org","@type":"Event","name":"Multi Agent Reinforcement Learning: AlphaStar League Training","url":"https://www.meetup.com/silicon-valley-generative-ai/events/317464502/","description":"Last meeting, we reviewed the initial announcement of the DeepMind agent AlphaStar and its preliminary competitive results against professional StarCraft 2 players. This time we will focus more on material in section Chapter 9.9.3 of [Multi-Agent Reinforcement Learning: Foundations and Modern Approaches](https://www.marl-book.com/) which discusses the league training approach to developing robust strategies. We will also look at the associated [blog post and Nature paper](https://deepmind.google/blog/alphastar-grandmaster-level-in-starcraft-ii-using-multi-agent-reinforcement-learning/) that explain the training in detail with ablations that show which components of the population training were necessary to reach top performance.\n\nMeetup Links:\n[Recordings of Previous RL Meetings](https://youtube.com/playlist?list=PLYqXmZaxvwmy2CNaK-DLailou1VIU1UZn&si=n6uQm863MCcHuKT7)\n[Recordings of Previous MARL Meetings](https://youtube.com/playlist?list=PLYqXmZaxvwmzikjw-cNyZfI051ms05czB&si=A7-AeX0dcRW67PDB)\n[Short RL Tutorials](https://youtube.com/playlist?list=PLYqXmZaxvwmyLEXMpk-n4RFr59tpJjNXt&si=RHy_FAnOJnPa4p1N)\n[My exercise solutions and chapter notes for Sutton-Barto](https://github.com/jekyllstein/Reinforcement-Learning-Sutton-Barto-Exercise-Solutions)\n[My MARL repository](https://github.com/jekyllstein/MARL_course/tree/main)\n[Kickoff Slides which contain other links](https://docs.google.com/presentation/d/1QD3iw5BgIpPpl_K_ApAlDr1NRseR1WmXme1dKQGqTOg/edit?usp=sharing)\n[MARL Kickoff Slides](https://docs.google.com/presentation/d/1FHXGVWkzjKsnNxzVN-29dx5vdkffAx5Vji5nWrDvg1Y/edit?usp=sharing)\n\nMARL Links:\n[Multi-Agent Reinforcement Learning: Foundations and Modern Approaches](https://www.marl-book.com/)\n[MARL Summer Course Videos](https://youtube.com/playlist?list=PLkoCa1tf0XjCU6GkAfRCkChOOSH6-JC_2&si=lEljXo65s3fMUsRC)\n[MARL Slides](https://github.com/marl-book/slides)\n\nSutton and Barto Links:\n[Reinforcement Learning: An Introduction by Richard S. Sutton and Andrew G. Barto](http://incompleteideas.net/book/the-book.html)\n[Video lectures from a similar course](https://youtube.com/playlist?list=PLqYmG7hTraZDVH599EItlEWsUOsJbAodm)","startDate":"2026-12-01T01:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/silicon-valley-generative-ai/events/317464502/"},"organizer":{"@type":"Organization","name":"Silicon Valley Generative AI ~ The AI Collective Network","url":"https://www.meetup.com/silicon-valley-generative-ai/"},"performer":"Silicon Valley Generative AI ~ The AI Collective Network"},{"@context":"https://schema.org","@type":"Event","name":"AI INFRA SUMMIT","url":"https://www.meetup.com/meetup-group-izengajf/events/317557797/","description":"This event is organized by Ignite GTM.\n\nOur meetup group is collaborating by promoting this event.\n\nIn order to attend, please register here:\n\n[AI INFRA SUMMIT 6 · Luma](https://luma.com/aiinfra6?coupon=IPO20&tk=ZDbDIC)\n\nOur meetup members get 20 PERCENT OFF!\n\nUse promo code:\n\nIPO20\n\nHurry!\n\nSlots are limited!\n\nAI is no longer an experiment. It’s the infrastructure race shaping economic power, technological sovereignty, and the next decade of global growth.\n\n​AI INFRA SUMMIT 6 brings this conversation to San Francisco, the center of gravity for AI innovation and deployment. This is where the builders of the AI stack come together: founders, operators, investors, policymakers, and infrastructure leaders powering the next generation of compute, data centers, and intelligent systems.\n\n​From chips to clusters to agentic workloads, AIS6 focuses on the systems turning AI from promise into production.\n​If you’re building, funding, or scaling at the AI infrastructure layer, this is where you align with the ecosystem defining what comes next.\n\n***\n\n## ​**Who Attends**\n\n* ​AI-native founders and builders\n* ​Cloud and infrastructure providers\n* ​Investors, venture capitalists, and strategic partners\n* ​Energy, chip, and data center operators\n* ​Policy and ecosystem leaders\n\n***\n\n## ​**Event Details**\n\n​**Date:** Wednesday, December 9th, 2026\n**Location:** San Francisco\n**Time:** 8:30 a.m.–8:00 p.m. PT\n**Host:** IgniteGTM\n\nIf you would like to have a demo / marketing table, please send an email message to:\n\nsiliconvalleysponsor@gmail.com\n\nPut this in the subject header:\n\nW 12/9/26 - Tabler","startDate":"2026-12-09T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-1-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"The Midway","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"900 Marin St, San Francisco, CA 94124, USA, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Sunnyvale Data Science Meetup","url":"https://www.meetup.com/meetup-group-izengajf/"},"performer":"Sunnyvale Data Science Meetup"}]</script><link rel="preload" href="https://secure.meetupstatic.com/photos/event/a/e/1/6/highres_537224566.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/c/f/8/4/highres_537293124.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/0/4/c/highres_536284172.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/a/2/3/highres_537006691.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/5/c/1/7/highres_537083575.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/1/0/9/5/highres_536284245.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/4/9/1/a/highres_537198714.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secure.meetupstatic.com/photos/event/4/9/3/8/highres_537198744.jpeg" as="image" data-next-head=""/><link rel="preload" href="https://secu