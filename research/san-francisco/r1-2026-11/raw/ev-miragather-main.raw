l details will be shared with approved guests only.\n\nPlaces are limited and attendance is by invitatio...","banner":"https://images.lumacdn.com/uploads/ay/bd03192f-84fe-4545-a0f5-110220f90cb2.png","starred":false,"event":"Pyth at Davos: Finance, Elevated","startDate":"2027-01-20","endDate":"2027-01-20","timeOverride":null,"city":["Davos"],"country":["Switzerland 🇨🇭"],"region":["Europe"],"timezone":["Europe/Zurich"],"link":"https://lu.ma/pyth-a5m7","organizer":"Pyth Network","twitter":null,"telegram":null,"tags":["Conference","Other"],"topics":["TradFi","Institutional","Markets"],"usersGoingObj":[{"handle":"pythnetwork","avatar":"https://cdn.lu.ma/avatars/97/f976b799-7132-4171-8005-6b586d1a4dfa","name":"Pyth Network","followerCount":0,"airtableId":"recfJuZf0nvsM0qfO"}],"usersInterestedObj":[{"handle":"0x51111b238dDC12d84c893487384E577c47095846","avatar":"https://sbcbnzaajijsbkrjsmec.supabase.co/storage/v1/object/public/profile_images/recon4COokNg2hpJ8_2026-09-03T19-32.png","name":"shellych12","followerCount":0,"airtableId":"recon4COokNg2hpJ8"}],"benefits":null,"series":[{"id":"recbyti1WmCR2rr9w","title":"Davos Events","color":"#FADDFF","slug":"DavosEvents2027","shortSlug":"DavE2027","visible":true,"clickable":false,"logo":"https://media2.giphy.com/media/v1.Y2lkPTc5MGI3NjExOWRhdWFhMzRzb2h5MThhdG14c3EydDBiOWd0aXB0cTJ1ZW93YjZ4aiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/MTv8XST1wSVQ6x9KMH/giphy.webp","banner":""}],"slug":"Pyth-at-Davos:-Finance,-Elevated-2027-jV","shortSlug":"PythatDavosFinanceElevated2027","logo":null,"created":"2026-10-22T14:03:53.000Z","promoted":false,"promoType":[],"companies":["recnlEVIKjPFgMAFc"],"showCompaniesAttendingUnderEvent":false,"paidEvent":false,"ticketPrice":"Free","expectedAttendance":null,"hostIds":["recfJuZf0nvsM0qfO"],"hostObjArray":[{"id":"recfJuZf0nvsM0qfO","name":"Pyth Network","handle":"pythnetwork"}],"creator":"recF9sCTa8Jy0JZKK","colivingBanner":null,"mapLink":"","promoStatus":[]},{"id":"recuRkf4ZzyjOjZRf","description":"Over 150 senior institutional investors, family offices and alternative investment professionals gather to discuss the latest trends, opportunities, and challenges in the dynamic world of private markets. The private markets landscape has undergone a profound transformation in recent years. With traditional asset classes facing increasing volatility and lower returns, investors are turning to alternative investments to diversify their portfolios and seek superior risk-adjusted returns. Whether you are a seasoned investor, a fund manager, or a service provider, this conference provides a platform to connect with industry leaders, share insights, and explore new investment opportunities.","banner":null,"starred":false,"event":"Monterrey Private Markets Meeting","startDate":"2027-01-21","endDate":"2027-01-21","timeOverride":null,"city":["Monterrey"],"country":["Mexico 🇲🇽"],"region":["LATAM"],"timezone":["America/Mexico_City"],"link":"https://www.carmocompanies.com/monterrey-private-markets-meeting","organizer":null,"twitter":null,"telegram":null,"tags":["Conference","Other"],"topics":["Institutional","TradFi","VC"],"usersGoingObj":[{"handle":"coiniseasy","avatar":"https://sbcbnzaajijsbkrjsmec.supabase.co/storage/v1/object/public/profile_images/coiniseasy_2024-08-23T13:44.png","name":"CoinEasy","followerCount":16854,"airtableId":"recSuKJyQsMfXfHvX"}],"usersInterestedObj":[{"handle":"0xF7Fa26804108295aA11e2e8022CC162F615666F1","avatar":"data:image/svg+xml;base64,","name":"0xF7Fa…66F1","followerCount":0,"airtableId":"rec4GD3kdHqJJLLQS"}],"benefits":null,"series":[{"id":"","title":"","color":"","slug":"","shortSlug":"","visible":false,"clickable":false,"logo":"","banner":""}],"slug":"Monterrey-Private-Markets-Meeting-2027","shortSlug":"MonterreyPrivateMarketsMeeting2027","logo":null,"created":"2026-05-19T09:26:49.000Z","promoted":false,"promoType":[],"companies":["receZb9D41LVil6SF"],"showCompaniesAttendingUnderEvent":false,"paidEvent":false,"ticketPrice":null,"expectedAttendan