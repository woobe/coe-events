__typename":"GroupStatsEventRatings","average":4.61,"totalRatings":62}},"isNewGroup":false},"PhotoInfo:322478377":{"__typename":"PhotoInfo","id":"322478377","highResUrl":"https://secure.meetupstatic.com/photos/member/9/5/e/9/highres_322478377.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:410031833":{"__typename":"Member","id":"410031833","name":"Amit Sinha","memberPhoto":{"__ref":"PhotoInfo:322478377"}},"Member:484144165":{"__typename":"Member","id":"484144165","name":"sunwoo","memberPhoto":null},"PhotoInfo:325501192":{"__typename":"PhotoInfo","id":"325501192","highResUrl":"https://secure.meetupstatic.com/photos/member/4/a/8/highres_325501192.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:256593961":{"__typename":"Member","id":"256593961","name":"Wilson A. Geronimo R.","memberPhoto":{"__ref":"PhotoInfo:325501192"}},"PhotoInfo:326346912":{"__typename":"PhotoInfo","id":"326346912","highResUrl":"https://secure.meetupstatic.com/photos/member/1/b/0/0/highres_326346912.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:484075313":{"__typename":"Member","id":"484075313","name":"saanjanashinde963","memberPhoto":{"__ref":"PhotoInfo:326346912"}},"PhotoInfo:316286395":{"__typename":"PhotoInfo","id":"316286395","highResUrl":"https://secure.meetupstatic.com/photos/member/6/7/1/b/highres_316286395.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:399463121":{"__typename":"Member","id":"399463121","name":"Mr H","memberPhoto":{"__ref":"PhotoInfo:316286395"}},"Event:316362930":{"__typename":"Event","id":"316362930","dateTime":"2026-11-26T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"ml-ai-learning-circle","__ref":"Group:37938314"},"title":"AI Builders Thursdays | Weekly AI Demos, Talks \u0026 Networking","description":"🚀 **Build Your Own AI Chatbot with Python \u0026 OpenAI SDK!**\nYou’ve used ChatGPT, Claude, and other AI chatbots. **Now it’s time to build your own!**\nIn our next meetup, we’ll go beyond simply using AI tools and learn how to build a working AI chatbot using Python and the OpenAI API.\n💻 **We’ll start with a quick setup:**\n\n* Setting up your OpenAI API environment\n* Installing and using the OpenAI Python SDK\n* Connecting your Python application to an LLM\n\n🛠️ **Hands-On Lab: Build Your First GPT-Powered Chatbot!**\n**By the end of the session, you’ll have built your own AI chatbot from scratch using code—not just used ChatGPT or Claude!**\n✅ Beginner-friendly\n✅ Live coding and hands-on learning\n✅ Real-world AI development skills\n🔥 **Stop just using AI. Start building with AI!**\nDon’t miss this session! Come ready to code, learn, and build something exciting.\nSee you at the meetup! 🚀","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ml-ai-learning-circle/events/316362930/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_APPROVAL","featuredEventPhoto":{"__ref":"PhotoInfo:535393108"},"displayPhoto":{"__ref":"PhotoInfo:535393108"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":5,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:410031833"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484144165"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:256593961"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484075313"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:399463121"}}}]},"series":{"__typename":"Series","description":"Every 2 weeks on Thursday until January 26, 2027","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["THURSDAY"],"weeklyInterval":2},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:316362930"}},{"__typename":"EventEdge","node":{"__ref":"Event:fngkbvyjcqbwb"}},{"__typename":"EventEdge","node":{"__ref":"Event:fngkbvyjcqbpc"}},{"__typename":"EventEdge","node":{"__ref":"Event:fngkbvykccbsb"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"Event:fngkbvyjcqbwb":{"__typename":"Event","id":"fngkbvyjcqbwb","dateTime":"2026-12-17T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"ml-ai-learning-circle"}},"Event:fngkbvyjcqbpc":{"__typename":"Event","id":"fngkbvyjcqbpc","dateTime":"2026-12-31T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"ml-ai-learning-circle"}},"Event:fngkbvykccbsb":{"__typename":"Event","id":"fngkbvykccbsb","dateTime":"2027-01-14T19:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"ml-ai-learning-circle"}},"PhotoInfo:527566842":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/6/f/a/highres_527566842.jpeg","id":"527566842"},"Group:35924669":{"__typename":"Group","id":"35924669","name":"Bay Area Voice AI Happy Hours: Tech Share and Paper Reading","urlname":"bay-area-voice-ai-happy-hours","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:527566842"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.41,"totalRatings":34}},"isNewGroup":false},"PhotoInfo:321799560":{"__typename":"PhotoInfo","id":"321799560","highResUrl":"https://secure.meetupstatic.com/photos/member/4/c/6/8/highres_321799560.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:311227885":{"__typename":"PhotoInfo","id":"311227885","highResUrl":"https://secure.meetupstatic.com/photos/member/1/e/c/d/highres_311227885.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:31474792":{"__typename":"PhotoInfo","id":"31474792","highResUrl":"https://secure.meetupstatic.com/photos/member/8/7/e/8/highres_31474792.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:323850268":{"__typename":"PhotoInfo","id":"323850268","highResUrl":"https://secure.meetupstatic.com/photos/member/7/6/3/c/highres_323850268.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:285346755":{"__typename":"PhotoInfo","id":"285346755","highResUrl":"https://secure.meetupstatic.com/photos/member/b/6/a/3/highres_285346755.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:244697166":{"__typename":"PhotoInfo","id":"244697166","highResUrl":"https://secure.meetupstatic.com/photos/member/4/3/0/e/highres_244697166.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:272071643":{"__typename":"PhotoInfo","id":"272071643","highResUrl":"https://secure.meetupstatic.com/photos/member/7/b/9/b/highres_272071643.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:148878902":{"__typename":"PhotoInfo","id":"148878902","highResUrl":"https://secure.meetupstatic.com/photos/member/4/9/d/6/highres_148878902.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:99252352":{"__typename":"Member","id":"99252352","name":"Wei Chu","memberPhoto":{"__ref":"PhotoInfo:148878902"}},"Member:297604928":{"__typename":"Member","id":"297604928","name":"pavansai tadepalli","memberPhoto":{"__ref":"PhotoInfo:321799560"}},"Member:364887674":{"__typename":"Member","id":"364887674","name":"Teodor Marchitan","memberPhoto":{"__ref":"PhotoInfo:311227885"}},"Member:31209532":{"__typename":"Member","id":"31209532","name":"Bharath Rengarajan","memberPhoto":{"__ref":"PhotoInfo:31474792"}},"Member:193032549":{"__typename":"Member","id":"193032549","name":"susan susan","memberPhoto":{"__ref":"PhotoInfo:323850268"}},"Event:317548418":{"__typename":"Event","id":"317548418","title":"Local+Online Meetup: In-House ASR Architecture \u0026 Accurate Word Timestamps #001","dateTime":"2026-12-03T18:30:00-08:00","description":"Join fellow speech engineers, researchers, and voice AI builders in the South Bay for an evening of technical talks, paper deep dives, and casual networking!\n\n**Event Details**\n\n* **Who should come:** Voice AI researchers, engineers, and entrepreneurs\n* **When:** Every other Thursday, 6:30 PM – 8:30 PM\n* **Format:** Hybrid (in person at Hacker Dojo, plus online via **YouTube Live at https://www.youtube.com/@olewave** and Bilibili Live — direct stream links will be shared later)\n* **Cost:** Draft beer is free; $10 onsite food \u0026 drink chip-in for pizza and non-alcoholic beverages (free for students with valid ID)\n* **Food \u0026 drinks:** Draft beer, pizza, and non-alcoholic beverages provided\n\n**Agenda**\n**6:30 PM – 7:00 PM \\| Arrival \u0026 Open Networking** Grab a drink, meet fellow voice AI builders and researchers, and settle in.\n**7:00 PM – 8:00 PM \\| Main Program**\n\n* **7:00 PM – 7:05 PM:** **Voice AI News \u0026 Community Updates** (5 min)\n* **7:05 PM – 7:30 PM:** **Tech Share: Building In-House Voice AI Solutions - ASR - Part 1: Overview and Architecture** (20 min talk + 5 min Q\u0026A) — Practical architecture, data, and deployment lessons learned from a speech AI veteran with more than 10 years of industry consulting experience.\n* **7:30 PM – 7:35 PM:** **Quick Break** (5 min) — Grab a drink refill and stretch before the paper walkthrough.\n* **7:35 PM – 8:00 PM:** **Paper Reading Deep Dive: Accurate ASR Word Timestamps** (20 min walkthrough + 5 min Q\u0026A) — A walkthrough of **FA-Bench** and its open leaderboard, followed by a look at how **Olign** achieves high-precision word- and phone-level speech alignment.\n\n**8:00 PM – 8:30 PM \\| Happy Hour Mingle \u0026 Wrap\\-Up** Continue the conversation with the speaker, exchange contacts, and hang out until close.\n\n**About the Speaker**\n**Wei Chu** has more than 10 years of experience in building internal voice AI solutions to beat external tech-giant API vendors in accuracy, latency, and cost. He received his PhD in speech from the EE Department at UCLA and is the Founder and CEO of **Olewave**, which focuses on voice datasets, benchmarks, and solutions. He also hosts the Olewave Speech \u0026 NLP Paper Reading channel on YouTube (**[youtube.com/@olewave](https://www.google.com/search?q=https%3A%2F%2Fyoutube.com%2F%40olewave)**) and organizes the Bay Area Voice AI Happy Hours Meetup (**[https://www.meetup.com/bay-area-voice-ai-happy-hours](https://www.meetup.com/bay-area-voice-ai-happy-hours)**). Outside of work, he likes soccer, fish cuisines, and traveling to learn languages, peoples, and cultures.\n\n**Location \u0026 How to Get There**\n**Venue:** Hacker Dojo **Address:** 3200 Patrick Henry Dr #250, Santa Clara, CA 95054 **Getting in:** Please use the main entrance with the automatic doors at 3200 Patrick Henry Dr.\n\n* **Driving \u0026 Parking:** Easily accessible via US-101 (exit Great America Pkwy / Bowers Ave) or CA-237 (exit Great America Pkwy). Free surface parking is available in the lot surrounding the building—look for Suite #250.\n* **Public Transit (VTA Light Rail \u0026 Caltrain):**\n* **VTA Light Rail:** Take the Orange Line to the **Great America Station** or **Old Ironsides Station**, both about a 10–15 minute walk from the venue.\n* **Caltrain + Transfer:** Take Caltrain to **Mountain View Station** and transfer to the VTA Orange Line toward Alum Rock, exiting at Great America Station (or take a \\~10-minute rideshare from Lawrence or Sunnyvale Caltrain stations).\n* **Biking:** Located right near the San Tomas Aquino Creek Trail for a direct, car-free bike commute from surrounding Silicon Valley neighborhoods.\n\n**Call for Volunteers**\nWe are looking for volunteers to help with check-in, A/V and livestream setup, and food/drink logistics! If you'd like to pitch in (volunteers get free admission and food), please message the organizers or reach out via Luma/Meetup.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/bay-area-voice-ai-happy-hours/events/317548418/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:527566842"},"feeSettings":null,"group":{"__ref":"Group:35924669"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":31,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:321799560"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:311227885"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:31474792"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:323850268"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:285346755"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:244697166"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:272071643"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":5,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:99252352"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:297604928"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:364887674"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:31209532"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:193032549"}}}]},"series":null,"venue":null},"PhotoInfo:537293130":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/f/8/a/highres_537293130.jpeg","id":"537293130"},"PhotoInfo:507371509":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/c/f/5/highres_507371509.jpeg","id":"507371509"},"Group:18354966":{"__typename":"Group","id":"18354966","name":"SF AI","urlname":"sfbay-ai","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:507371509"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.58,"totalRatings":1344}},"isNewGroup":false},"PhotoInfo:85605692":{"__typename":"PhotoInfo","id":"85605692","highResUrl":"https://secure.meetupstatic.com/photos/member/b/2/7/c/highres_85605692.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:126714832":{"__typename":"PhotoInfo","id":"126714832","highResUrl":"https://secure.meetupstatic.com/photos/member/d/6/3/0/highres_126714832.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:11754622":{"__typename":"PhotoInfo","id":"11754622","highResUrl":"https://secure.meetupstatic.com/photos/member/d/5/5/e/highres_11754622.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:46097512":{"__typename":"PhotoInfo","id":"46097512","highResUrl":"https://secure.meetupstatic.com/photos/member/4/4/6/8/highres_46097512.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:242849431":{"__typename":"PhotoInfo","id":"242849431","highResUrl":"https://secure.meetupstatic.com/photos/member/7/2/f/7/highres_242849431.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:126192802":{"__typename":"PhotoInfo","id":"126192802","highResUrl":"https://secure.meetupstatic.com/photos/member/3/2/0/2/highres_126192802.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:97739722":{"__typename":"PhotoInfo","id":"97739722","highResUrl":"https://secure.meetupstatic.com/photos/member/e/9/4/a/highres_97739722.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Event:317572861":{"__typename":"Event","id":"317572861","title":"[SF] AI Builder Tour with Bluehost","dateTime":"2026-12-09T09:00:00-08:00","description":"**Important**: Registration on the[ ](https://www.aicamp.ai/event/eventdetails/W2026120306)[event website](https://www.aicamp.ai/event/eventdetails/W2026111709) is required for admission.\n(RSVP on meetup is turned off)\n\nJoin us for the Bluehost AI Builder Tour - San Francisco, an in-person experience bringing together entrepreneurs, developers, creators, and local AI builders ready to move from vision to launch and scale.\n\nWhether you're developing your next big idea, launching a business, or scaling something you've already built, this is your opportunity to connect with fellow builders, explore new possibilities, and get expert feedback.\n\n**Three awards, three chances to win awards - $30,000**:\nExplore three exciting opportunities to compete:\n\n* Build with Anything — Create an AI-powered solution using the tools of your choice.\n* Build \u0026 Win with Bluehost — Build a website or app using Bluehost AI Builder.\n* Vibeathon — Put your AI-powered creativity and building skills to the test.\n\n**What to Expect:**\n\n* Local AI Builder Showcases: Hear from local builders about their projects, challenges, and lessons learned.\n* Build, Host \u0026 Scale: Discover Bluehost innovations to help build, host, and run your projects.\n* Interactive AI Workshop: Bring your ideas or work in progress and get feedback from AI builders and experts.\n* Peer-to-Peer Breakouts: Discuss AI agents, infrastructure, performance, and costs with peers and experts.\n* Community \u0026 Networking: Connect with local AI builders, entrepreneurs, and industry experts.\n\n**Featured Speakers:**\n\n* Salim Ali, Bluehost\n* Antonis Papatsaras, Bluehost\n* Vishwa Shroff, Bluehost\n* Ana Ramdas, Build First\n* and more\n*\n\n**Agenda:**\n\n* 9:00am–9:30am: Coffee, Networking \u0026 Demos\n* 9:30am–10:00am: Welcome \u0026 Introduction\n* 10:00am–12:00pm: AI Builder Showcases \u0026 Workshop\n* 12:00pm–1:00pm: Lunch\n* 1:00pm–3:00pm: Interactive Workshop \u0026 Expert Feedback\n* 3:15pm–4:30pm: Peer Discussions \u0026 Expert Consultations\n* 5:00pm onwards: Happy Hour \u0026 Networking\n*","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/sfbay-ai/events/317572861/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537293130"},"displayPhoto":{"__ref":"PhotoInfo:537293130"},"feeSettings":null,"group":{"__ref":"Group:18354966"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":46,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:85605692"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:126714832"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:11754622"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:46097512"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:242849431"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:126192802"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:97739722"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:98671552"}}}]},"series":null,"venue":{"__typename":"Venue","name":"The Avalon","address":"1244 Sutter St, San Francisco, CA 94109, USA","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:537224596":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/a/e/3/4/highres_537224596.jpeg","id":"537224596"},"PhotoInfo:497238944":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/4/a/0/0/highres_497238944.jpeg","id":"497238944"},"Group:28219081":{"__typename":"Group","id":"28219081","name":"Bay Area Research in NLP and ML","urlname":"Bay-Area-Research-in-NLP-and-ML","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:497238944"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.84,"totalRatings":170}},"isNewGroup":false},"PhotoInfo:310707362":{"__typename":"PhotoInfo","id":"310707362","highResUrl":"https://secure.meetupstatic.com/photos/member/6/a/e/2/highres_310707362.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:325870606":{"__typename":"PhotoInfo","id":"325870606","highResUrl":"https://secure.meetupstatic.com/photos/member/2/9/6/e/highres_325870606.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:276537640":{"__typename":"PhotoInfo","id":"276537640","highResUrl":"https://secure.meetupstatic.com/photos/member/e/1/2/8/highres_276537640.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:278805410":{"__typename":"PhotoInfo","id":"278805410","highResUrl":"https://secure.meetupstatic.com/photos/member/b/1/6/2/highres_278805410.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:301163743":{"__typename":"PhotoInfo","id":"301163743","highResUrl":"https://secure.meetupstatic.com/photos/member/5/c/b/f/highres_301163743.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:260873630":{"__typename":"PhotoInfo","id":"260873630","highResUrl":"https://secure.meetupstatic.com/photos/member/d/1/7/e/highres_260873630.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:253997535":{"__typename":"PhotoInfo","id":"253997535","highResUrl":"https://secure.meetupstatic.com/photos/member/4/4/7/f/highres_253997535.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:362353325":{"__typename":"Member","id":"362353325","name":"Max","memberPhoto":{"__ref":"PhotoInfo:310707362"}},"Member:481098609":{"__typename":"Member","id":"481098609","name":"Ashley A.","memberPhoto":{"__ref":"PhotoInfo:325870606"}},"Event:317519279":{"__typename":"Event","id":"317519279","title":"Agentic AI Year in Review","dateTime":"2026-12-08T17:00:00-08:00","description":"**Agentic AI Year in Review!**\nJoin us for an exciting evening discussing the top startup trends in Agentic AI of 2026 and predictions for 2027.\n\n**Featuring:**\n\n* [Shruti Merchant](https://www.linkedin.com/in/shrutimerchant/), Partner, Pear VC\n* [Tabish Gilani](https://www.linkedin.com/in/tabishgilani/), Product Growth Partner, a16z Speedrun\n* [Tracy Rubin](https://www.linkedin.com/in/tracy-rubin-a54439156/), Partner, Cooley LLP\n\n**Registration**\nTo attend, you need to [register at luma](https://luma.com/veyokv1b?utm_source=nlp) **\u003c-** **Please register at Luma as the venue requires this.**\n\n**Agenda**\nDate: Tues December 8th, 5:00pm (**doors open at 5pm**)\nLocation: GitHub, 275 Brannan St, San Francisco (entrance on Brannan)\n\n* 5:00-6:00pm doors open for networking\n* 6:00-7:00pm panel discussion\n* 7:00-7:30pm additional networking\n\n**Want to demo?**\nIf you are interested in demoing at a future event, please fill out the [application form](https://forms.gle/ahzwgnAAs51pdiTQ9).","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/bay-area-research-in-nlp-and-ml/events/317519279/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537224596"},"displayPhoto":{"__ref":"PhotoInfo:537224596"},"feeSettings":null,"group":{"__ref":"Group:28219081"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":32,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:310707362"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:325870606"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:276537640"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:278805410"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:301163743"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260873630"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:253997535"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:58505672"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:362353325"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481098609"}}}]},"series":null,"venue":{"__typename":"Venue","name":"GitHub","address":"275 Brannan St","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:536901746":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/4/f/2/highres_536901746.jpeg","id":"536901746"},"PhotoInfo:492753013":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/8/0/f/5/highres_492753013.jpeg","id":"492753013"},"Group:25567857":{"__typename":"Group","id":"25567857","name":"IEEE Computational Intelligence Society - SCV Chapter","urlname":"IEEE_CIS_SCV","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:492753013"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.75,"totalRatings":24}},"isNewGroup":false},"PhotoInfo:322697890":{"__typename":"PhotoInfo","id":"322697890","highResUrl":"https://secure.meetupstatic.com/photos/member/4/5/e/2/highres_322697890.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:471082762":{"__typename":"Member","id":"471082762","name":"IEEE Computational Intelligence ","memberPhoto":{"__ref":"PhotoInfo:322697890"}},"PhotoInfo:279409466":{"__typename":"PhotoInfo","id":"279409466","highResUrl":"https://secure.meetupstatic.com/photos/member/c/1/3/a/highres_279409466.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:260217159":{"__typename":"Member","id":"260217159","name":"Aaron ","memberPhoto":{"__ref":"PhotoInfo:279409466"}},"PhotoInfo:253140794":{"__typename":"PhotoInfo","id":"253140794","highResUrl":"https://secure.meetupstatic.com/photos/member/3/1/a/highres_253140794.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:9994197":{"__typename":"Member","id":"9994197","name":"Joseph","memberPhoto":{"__ref":"PhotoInfo:253140794"}},"Member:339335732":{"__typename":"Member","id":"339335732","name":"Amy","memberPhoto":null},"PhotoInfo:324913648":{"__typename":"PhotoInfo","id":"324913648","highResUrl":"https://secure.meetupstatic.com/photos/member/3/5/5/0/highres_324913648.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:177637782":{"__typename":"Member","id":"177637782","name":"Deepa Sankaran","memberPhoto":{"__ref":"PhotoInfo:324913648"}},"Member:449761164":{"__typename":"Member","id":"449761164","name":"Alex","memberPhoto":null},"PhotoInfo:307338950":{"__typename":"PhotoInfo","id":"307338950","highResUrl":"https://secure.meetupstatic.com/photos/member/4/a/0/6/highres_307338950.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:109627512":{"__typename":"Member","id":"109627512","name":"Annie","memberPhoto":{"__ref":"PhotoInfo:307338950"}},"PhotoInfo:326724513":{"__typename":"PhotoInfo","id":"326724513","highResUrl":"https://secure.meetupstatic.com/photos/member/5/f/c/1/highres_326724513.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:330079493":{"__typename":"Member","id":"330079493","name":"Ashok Murugan","memberPhoto":{"__ref":"PhotoInfo:326724513"}},"Event:317228051":{"__typename":"Event","id":"317228051","title":"ISCI 2026 - Agentic AI: From Hype to Reality","dateTime":"2026-11-28T08:00:00-08:00","description":"***\n\nJoin us for the **International Symposium on Computational Intelligence (ISCI) 2026**, a premier virtual half-day event on Agentic AI: From Hype to Reality, broadly covering what it takes to build, trust, and stand behind AI agents in real-world use. The symposium brings together researchers and practitioners to discuss how agentic AI works in practice.\n**What to Expect**\n\n* **Expert Presentations** \\- 30\\-45 minute talks from internationally recognized speakers\n* **Interactive Q\u0026A Sessions** \\- 15\\-minute Q\u0026A following each presentation\n* **Global Perspective** \\- Speakers from Australia\\, India and beyond\n* **Live Streaming** \\- Real\\-time access via zoom\n\n**Talks \u0026 Speakers**\n\n* **Enough of scaling laws! Let's focus on downscaling** - Prof. Tanmoy Chakraborty, IIT Delhi, India\n* **AI Agents to Agentic AI: From Historical Perspective** \\- Prof\\. Dipankar Dasgupta\\, The University of Memphis\\, US\n* **From Learning to Unlearning: Building Secure and Trustworthy AI Agents for the AGI Era** - Prof. Danda B. Rawat, Howard University, Washington, US\n* **On the Possibility and Impossibility of Trusted Agentic Artificial Intelligence** \\- Prof\\. Hussein Abbass\\, University of New South Wales\\, Australia\n\nMore details at: https://events.vtools.ieee.org/m/589225","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ieee_cis_scv/events/317228051/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536901746"},"displayPhoto":{"__ref":"PhotoInfo:536901746"},"feeSettings":null,"group":{"__ref":"Group:25567857"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":10,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:471082762"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:260217159"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:9994197"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:339335732"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:412465248"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:177637782"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:216134378"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:449761164"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:109627512"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:330079493"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537221482":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/a/2/0/a/highres_537221482.jpeg","id":"537221482"},"Group:38728113":{"__typename":"Group","id":"38728113","name":"VentureBeat AI Impact Series - SF","urlname":"venturebeat-ai-impact-series-sf","timezone":"America/Los_Angeles","keyGroupPhoto":null,"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":0,"totalRatings":0}},"isNewGroup":true},"PhotoInfo:320080425":{"__typename":"PhotoInfo","id":"320080425","highResUrl":"https://secure.meetupstatic.com/photos/member/9/d/e/9/highres_320080425.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326291471":{"__typename":"PhotoInfo","id":"326291471","highResUrl":"https://secure.meetupstatic.com/photos/member/2/c/c/f/highres_326291471.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326587967":{"__typename":"PhotoInfo","id":"326587967","highResUrl":"https://secure.meetupstatic.com/photos/member/1/f/1/f/highres_326587967.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:281995243":{"__typename":"PhotoInfo","id":"281995243","highResUrl":"https://secure.meetupstatic.com/photos/member/d/7/c/b/highres_281995243.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:285095778":{"__typename":"PhotoInfo","id":"285095778","highResUrl":"https://secure.meetupstatic.com/photos/member/8/b/c/2/highres_285095778.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:260666758":{"__typename":"PhotoInfo","id":"260666758","highResUrl":"https://secure.meetupstatic.com/photos/member/6/8/8/6/highres_260666758.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326322742":{"__typename":"PhotoInfo","id":"326322742","highResUrl":"https://secure.meetupstatic.com/photos/member/a/6/f/6/highres_326322742.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:483979606":{"__typename":"Member","id":"483979606","name":"VB Events","memberPhoto":{"__ref":"PhotoInfo:326322742"}},"Member:72475702":{"__typename":"Member","id":"72475702","name":"Gary","memberPhoto":{"__ref":"PhotoInfo:320080425"}},"Event:317461038":{"__typename":"Event","id":"317461038","title":"The Context Layer: Where Inference Gets Won or Lost in 2027","dateTime":"2026-12-10T17:00:00-08:00","description":"**About the Topic:**\n​2026 was the year the industry stopped counting tokens and started counting what they produced. First came tokenmaxxing, then the discipline of cost per task, and now a harder question is surfacing in every serious AI program: once you’ve made inference efficient, where do you spend what you freed up? The answer increasingly isn’t more GPUs. It’s context. Agents don’t answer prompts; they complete tasks across hundreds of steps, and at every step they need persistent, accurate, fast-to-reach, and affordable working memory. That memory has to live somewhere between the GPU and the data layer, and most enterprises haven’t yet decided where it lives, who owns it, or how to measure whether it’s working.\n\n​This salon brings together the practitioners furthest along in building that layer: the neoclouds already hitting the wall, the enterprises just arriving at it, and the infrastructure leaders defining what the context layer should be. Expect a frank conversation about the trade-offs between memory, data access, and GPU time, the new measures replacing utilization, and the emerging best practices for an inference year that starts in January.\n\n**​Featured Speakers:**\n\n* Aanchal Gupta, CSO, Adobe\n* ​Liran Zvibel, CEO and Co-Founder of WEKA\n\n**​Participate in the Conversation:**\nLink to register: https://luma.com/hv2l9g51\n\n​Request your seat today. Space is intentionally limited to keep the room small and the conversation real. This is an in-person only event.\n\n​NOTE: It can take up to 24 hours for reservation processing. Please also check your spam mail for email from VentureBeat regarding the event.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/venturebeat-ai-impact-series-sf/events/317461038/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537221482"},"displayPhoto":{"__ref":"PhotoInfo:537221482"},"feeSettings":null,"group":{"__ref":"Group:38728113"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":40,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:320080425"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326291471"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326587967"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326480038"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:281995243"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:285095778"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:260666758"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":2,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:483979606"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:72475702"}}}]},"series":null,"venue":{"__typename":"Venue","name":"San Francisco","address":"San Francisco, CA, USA","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:474552125":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/2/f/5/d/highres_474552125.jpeg","id":"474552125"},"Group:25755416":{"__typename":"Group","id":"25755416","name":"Sunnyvale Data Science Meetup","urlname":"meetup-group-iZENgAjf","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:474552125"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4,"totalRatings":4}},"isNewGroup":false},"PhotoInfo:275629809":{"__typename":"PhotoInfo","id":"275629809","highResUrl":"https://secure.meetupstatic.com/photos/member/c/2/9/1/highres_275629809.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:250461911":{"__typename":"Member","id":"250461911","name":"Rob","memberPhoto":{"__ref":"PhotoInfo:275629809"}},"Event:317557797":{"__typename":"Event","id":"317557797","title":"AI INFRA SUMMIT","dateTime":"2026-12-09T08:00:00-08:00","description":"This event is organized by Ignite GTM.\n\nOur meetup group is collaborating by promoting this event.\n\nIn order to attend, please register here:\n\n[AI INFRA SUMMIT 6 · Luma](https://luma.com/aiinfra6?coupon=IPO20\u0026tk=ZDbDIC)\n\nOur meetup members get 20 PERCENT OFF!\n\nUse promo code:\n\nIPO20\n\nHurry!\n\nSlots are limited!\n\nAI is no longer an experiment. It’s the infrastructure race shaping economic power, technological sovereignty, and the next decade of global growth.\n\n​AI INFRA SUMMIT 6 brings this conversation to San Francisco, the center of gravity for AI innovation and deployment. This is where the builders of the AI stack come together: founders, operators, investors, policymakers, and infrastructure leaders powering the next generation of compute, data centers, and intelligent systems.\n\n​From chips to clusters to agentic workloads, AIS6 focuses on the systems turning AI from promise into production.\n​If you’re building, funding, or scaling at the AI infrastructure layer, this is where you align with the ecosystem defining what comes next.\n\n***\n\n## ​**Who Attends**\n\n* ​AI-native founders and builders\n* ​Cloud and infrastructure providers\n* ​Investors, venture capitalists, and strategic partners\n* ​Energy, chip, and data center operators\n* ​Policy and ecosystem leaders\n\n***\n\n## ​**Event Details**\n\n​**Date:** Wednesday, December 9th, 2026\n**Location:** San Francisco\n**Time:** 8:30 a.m.–8:00 p.m. PT\n**Host:** IgniteGTM\n\nIf you would like to have a demo / marketing table, please send an email message to:\n\nsiliconvalleysponsor@gmail.com\n\nPut this in the subject header:\n\nW 12/9/26 - Tabler","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/meetup-group-izengajf/events/317557797/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:474552125"},"feeSettings":null,"group":{"__ref":"Group:25755416"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:250461911"}}}]},"series":null,"venue":{"__typename":"Venue","name":"The Midway","address":"900 Marin St, San Francisco, CA 94124, USA","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:523081294":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/5/0/e/highres_523081294.jpeg","id":"523081294"},"PhotoInfo:512443640":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/a/a/7/8/highres_512443640.jpeg","id":"512443640"},"Group:19871729":{"__typename":"Group","id":"19871729","name":"West Coast Machine Learning Meetup (aka East Bay/Trivalley)","urlname":"west-coast-machine-learning-meetup","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:512443640"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.87,"totalRatings":559}},"isNewGroup":false},"PhotoInfo:254634635":{"__typename":"PhotoInfo","id":"254634635","highResUrl":"https://secure.meetupstatic.com/photos/member/d/5/6/b/highres_254634635.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:201236193":{"__typename":"Member","id":"201236193","name":"David Selinger","memberPhoto":{"__ref":"PhotoInfo:254634635"}},"PhotoInfo:162240942":{"__typename":"PhotoInfo","id":"162240942","highResUrl":"https://secure.meetupstatic.com/photos/member/3/a/e/highres_162240942.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:72601442":{"__t