r:142203262"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537220106":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/9/c/a/a/highres_537220106.jpeg","id":"537220106"},"PhotoInfo:326714521":{"__typename":"PhotoInfo","id":"326714521","highResUrl":"https://secure.meetupstatic.com/photos/member/3/8/b/9/highres_326714521.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:263347230":{"__typename":"PhotoInfo","id":"263347230","highResUrl":"https://secure.meetupstatic.com/photos/member/1/c/3/e/highres_263347230.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326224950":{"__typename":"PhotoInfo","id":"326224950","highResUrl":"https://secure.meetupstatic.com/photos/member/1/3/5/6/highres_326224950.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:116258122":{"__typename":"PhotoInfo","id":"116258122","highResUrl":"https://secure.meetupstatic.com/photos/member/9/4/e/a/highres_116258122.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326298020":{"__typename":"PhotoInfo","id":"326298020","highResUrl":"https://secure.meetupstatic.com/photos/member/4/6/6/4/highres_326298020.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:323226814":{"__typename":"PhotoInfo","id":"323226814","highResUrl":"https://secure.meetupstatic.com/photos/member/1/a/9/e/highres_323226814.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:240560723":{"__typename":"Member","id":"240560723","name":"Deepa Vishwanath","memberPhoto":{"__ref":"PhotoInfo:326714521"}},"Member:212122791":{"__typename":"Member","id":"212122791","name":"Jody Zhao","memberPhoto":{"__ref":"PhotoInfo:263347230"}},"Event:317513615":{"__typename":"Event","id":"317513615","title":"Sales Funnels with Claude: See a Real One Opened Up, Page by Page [ONLINE]","dateTime":"2026-12-07T12:00:00-08:00","description":"A sales funnel used to take a copywriter, a designer, a developer and about three months. In this class Aida shows how her team now builds the offer, the pages and the follow-up emails with Claude in days, including for owners who don't have a product to sell yet.\n\nAida uses a well-known study on choice, a client example and her own team's funnel to show what a simple route from first click to repeat purchase looks like, then opens the real funnel and goes through it page by page.\n\n**What we'll cover:**\n• Why too many choices stop people buying, and what to remove first\n• The steps from stranger to repeat customer, and where most businesses stop\n• How a small first offer can cover the cost of finding a customer\n• Selling to the audience or network you already have, without ads\n• Using Claude to turn what you know into a first product\n• A real funnel opened up and explained page by page\n\n**Format:** An online class of about 60 minutes. Aida presents on screen, and our team answers questions in the chat.\n\n**Who it's for:** business owners, founders, coaches and service providers in Palo Alto and Silicon Valley who want customers to arrive more predictably. No marketing or technical background needed.\n\n**Bring:** a notebook, the link to your website or sales page if you have one, and one offer you sell or would like to sell.\n\n**Hosted by:** Aida from the Bridges Network.\n\n**When you RSVP:** three optional questions: one task you'd love AI to take off your plate, whether you would like a free AI consultation, and a phone number for an SMS reminder. Skip any you like.\n\n**Please note:** the last part introduces our team's done-for-you funnel service and invites anyone interested to book a call. Everything above is covered first.\n\n**Where:** Online, on our class page. The link appears here once you RSVP \"Going.\" The page asks for a name and email to let you in. No cost.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/palo-alto-ai-business-vibes/events/317513615/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537220106"},"displayPhoto":{"__ref":"PhotoInfo:537220106"},"feeSettings":null,"group":{"__ref":"Group:38686071"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":41,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326714521"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:301692602"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:263347230"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326224950"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:116258122"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326298020"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:323226814"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":4,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:483882102"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:240560723"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:311828677"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:212122791"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:537006691":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/a/2/3/highres_537006691.jpeg","id":"537006691"},"PhotoInfo:279535265":{"__typename":"PhotoInfo","id":"279535265","highResUrl":"https://secure.meetupstatic.com/photos/member/d/7/e/1/highres_279535265.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:75593802":{"__typename":"Member","id":"75593802","name":"Kevin Shin","memberPhoto":{"__ref":"PhotoInfo:279535265"}},"PhotoInfo:257890031":{"__typename":"PhotoInfo","id":"257890031","highResUrl":"https://secure.meetupstatic.com/photos/member/2/7/2/f/highres_257890031.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:208020395":{"__typename":"Member","id":"208020395","name":"Saurabh","memberPhoto":{"__ref":"PhotoInfo:257890031"}},"PhotoInfo:245918173":{"__typename":"PhotoInfo","id":"245918173","highResUrl":"https://secure.meetupstatic.com/photos/member/9/5/1/d/highres_245918173.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:186964545":{"__typename":"Member","id":"186964545","name":"Srimaan Yarram","memberPhoto":{"__ref":"PhotoInfo:245918173"}},"PhotoInfo:326603298":{"__typename":"PhotoInfo","id":"326603298","highResUrl":"https://secure.meetupstatic.com/photos/member/5/b/0/2/highres_326603298.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:485083030":{"__typename":"Member","id":"485083030","name":"austejalzr","memberPhoto":{"__ref":"PhotoInfo:326603298"}},"Member:255456816":{"__typename":"Member","id":"255456816","name":"Praveen Sitaraman","memberPhoto":null},"PhotoInfo:307193049":{"__typename":"PhotoInfo","id":"307193049","highResUrl":"https://secure.meetupstatic.com/photos/member/c/f/3/9/highres_307193049.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:216134378":{"__typename":"Member","id":"216134378","name":"JTech","memberPhoto":{"__ref":"PhotoInfo:307193049"}},"PhotoInfo:321626094":{"__typename":"PhotoInfo","id":"321626094","highResUrl":"https://secure.meetupstatic.com/photos/member/6/5/e/e/highres_321626094.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:40689492":{"__typename":"Member","id":"40689492","name":"David Esser","memberPhoto":{"__ref":"PhotoInfo:321626094"}},"PhotoInfo:326194607":{"__typename":"PhotoInfo","id":"326194607","highResUrl":"https://secure.meetupstatic.com/photos/member/8/7/2/f/highres_326194607.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:473662108":{"__typename":"Member","id":"473662108","name":"Oleg","memberPhoto":{"__ref":"PhotoInfo:326194607"}},"PhotoInfo:317920025":{"__typename":"PhotoInfo","id":"317920025","highResUrl":"https://secure.meetupstatic.com/photos/member/9/c/5/9/highres_317920025.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:409220946":{"__typename":"Member","id":"409220946","name":"Sridhar","memberPhoto":{"__ref":"PhotoInfo:317920025"}},"PhotoInfo:245015766":{"__typename":"PhotoInfo","id":"245015766","highResUrl":"https://secure.meetupstatic.com/photos/member/8/b/b/6/highres_245015766.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:170378192":{"__typename":"Member","id":"170378192","name":"Dennis","memberPhoto":{"__ref":"PhotoInfo:245015766"}},"PhotoInfo:19864691":{"__typename":"PhotoInfo","id":"19864691","highResUrl":"https://secure.meetupstatic.com/photos/member/1/2/5/3/highres_19864691.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:21291201":{"__typename":"Member","id":"21291201","name":"Vincent Button","memberPhoto":{"__ref":"PhotoInfo:19864691"}},"PhotoInfo:249391708":{"__typename":"PhotoInfo","id":"249391708","highResUrl":"https://secure.meetupstatic.com/photos/member/7/b/d/c/highres_249391708.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:192049571":{"__typename":"Member","id":"192049571","name":"Nicolas Cabrera","memberPhoto":{"__ref":"PhotoInfo:249391708"}},"Member:426007475":{"__typename":"Member","id":"426007475","name":"Lu de Souza","memberPhoto":null},"PhotoInfo:307057654":{"__typename":"PhotoInfo","id":"307057654","highResUrl":"https://secure.meetupstatic.com/photos/member/9/3/1/6/highres_307057654.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:277527916":{"__typename":"Member","id":"277527916","name":"Nhi Nguyen","memberPhoto":{"__ref":"PhotoInfo:307057654"}},"PhotoInfo:270416943":{"__typename":"PhotoInfo","id":"270416943","highResUrl":"https://secure.meetupstatic.com/photos/member/d/e/6/f/highres_270416943.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:235853473":{"__typename":"Member","id":"235853473","name":"Patrick Nicolas","memberPhoto":{"__ref":"PhotoInfo:270416943"}},"PhotoInfo:325089705":{"__typename":"PhotoInfo","id":"325089705","highResUrl":"https://secure.meetupstatic.com/photos/member/2/5/e/9/highres_325089705.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:231349645":{"__typename":"Member","id":"231349645","name":"Pranav Padmane","memberPhoto":{"__ref":"PhotoInfo:325089705"}},"Event:317318556":{"__typename":"Event","id":"317318556","title":"Build an Agentic AI Model Factory: Own Your AI","dateTime":"2026-12-09T12:00:00-08:00","description":"​**Build a Sovereign AI Factory: an ML Engineer Agent that evaluates, fine-tunes, deploys, and improves open models.**\nRSVP on Luma for live link: https://luma.com/vfhq98ji\n\n​AI teams are starting to look beyond renting every capability from an external API, they're building systems they own and control. In this hands-on session we'll build exactly that by creating an ML Engineer Agent that will manage a model factory to select and fine-tune the best models for your applications.\n\n​We'll start with a walkthrough where we build an agent that evaluates open models in parallel, fine-tunes promising candidates, deploys the winner, and retrains automatically when performance drops. Think of it as the first brick in your own **model factory**: a repeatable system for evaluating, improving, and deploying models *you* control.\n\n​You'll see how [Union.ai](https://union.ai/?utm_source=luma) \u0026 Flyte give your AI workflows a **durable runtime** with *infrastructure as context,* so agents adapt infra resources, recover from failures, and keep moving without re-running completed work. And because it all runs in **your own cloud**, you own the full stack end to end: **your models, your data, your infrastructure, your IP.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-builders-and-learners-sf/events/317318556/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537006691"},"displayPhoto":{"__ref":"PhotoInfo:537006691"},"feeSettings":null,"group":{"__ref":"Group:37611478"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":35,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:128320322"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:75593802"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:208020395"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:186964545"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485083030"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:255456816"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:216134378"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:40689492"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:473662108"}}},{"__typename":"RsvpEdge","node":{"__