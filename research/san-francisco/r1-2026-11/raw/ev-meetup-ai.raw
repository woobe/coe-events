"__typename":"GroupStatsEventRatings","average":4.6,"totalRatings":15}},"isNewGroup":false},"Member:476801500":{"__typename":"Member","id":"476801500","name":"Aloke","memberPhoto":null},"Member:397244272":{"__typename":"Member","id":"397244272","name":"Ivan Demianchuk","memberPhoto":null},"PhotoInfo:315865430":{"__typename":"PhotoInfo","id":"315865430","highResUrl":"https://secure.meetupstatic.com/photos/member/6/3/5/6/highres_315865430.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:183442392":{"__typename":"Member","id":"183442392","name":"Yuliia Boiko","memberPhoto":{"__ref":"PhotoInfo:315865430"}},"Member:295179269":{"__typename":"Member","id":"295179269","name":"Vanessa Chen","memberPhoto":null},"Member:483048306":{"__typename":"Member","id":"483048306","name":"Derek Wild","memberPhoto":null},"Member:482781602":{"__typename":"Member","id":"482781602","name":"Undral","memberPhoto":null},"PhotoInfo:322954665":{"__typename":"PhotoInfo","id":"322954665","highResUrl":"https://secure.meetupstatic.com/photos/member/8/7/6/9/highres_322954665.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:303411825":{"__typename":"Member","id":"303411825","name":"Arion Poole","memberPhoto":{"__ref":"PhotoInfo:322954665"}},"Member:484737327":{"__typename":"Member","id":"484737327","name":"Jake Bloom","memberPhoto":null},"PhotoInfo:300652281":{"__typename":"PhotoInfo","id":"300652281","highResUrl":"https://secure.meetupstatic.com/photos/member/c/c/3/9/highres_300652281.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:13030567":{"__typename":"Member","id":"13030567","name":"adnan","memberPhoto":{"__ref":"PhotoInfo:300652281"}},"PhotoInfo:309965296":{"__typename":"PhotoInfo","id":"309965296","highResUrl":"https://secure.meetupstatic.com/photos/member/1/4/b/0/highres_309965296.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:35