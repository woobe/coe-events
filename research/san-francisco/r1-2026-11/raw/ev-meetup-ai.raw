s://secure-content.meetupstatic.com/images/classic-member/"},"Member:122383142":{"__typename":"Member","id":"122383142","name":"Misho Krastev","memberPhoto":{"__ref":"PhotoInfo:203729332"}},"Member:320768085":{"__typename":"Member","id":"320768085","name":"Habibur Rahman","memberPhoto":null},"PhotoInfo:308306993":{"__typename":"PhotoInfo","id":"308306993","highResUrl":"https://secure.meetupstatic.com/photos/member/6/9/7/1/highres_308306993.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:22460521":{"__typename":"Member","id":"22460521","name":"Lucia","memberPhoto":{"__ref":"PhotoInfo:308306993"}},"PhotoInfo:326703031":{"__typename":"PhotoInfo","id":"326703031","highResUrl":"https://secure.meetupstatic.com/photos/member/b/d/7/highres_326703031.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:253150233":{"__typename":"Member","id":"253150233","name":"Sharmistha Das","memberPhoto":{"__ref":"PhotoInfo:326703031"}},"PhotoInfo:311070523":{"__typename":"PhotoInfo","id":"311070523","highResUrl":"https://secure.meetupstatic.com/photos/member/7/7/3/b/highres_311070523.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:364174870":{"__typename":"Member","id":"364174870","name":"Nuno Edgar Nunes Fernandes (Engi","memberPhoto":{"__ref":"PhotoInfo:311070523"}},"PhotoInfo:310484789":{"__typename":"PhotoInfo","id":"310484789","highResUrl":"https://secure.meetupstatic.com/photos/member/a/e/f/5/highres_310484789.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:254048595":{"__typename":"Member","id":"254048595","name":"Raviraj Nallasivam","memberPhoto":{"__ref":"PhotoInfo:310484789"}},"PhotoInfo:289882750":{"__typename":"PhotoInfo","id":"289882750","highResUrl":"https://secure.meetupstatic.com/photos/member/5/8/d/e/highres_289882750.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:284320017":{"__typename":"Member","id":"284320017","name":"Aram Dovlatyan","memberPhoto":{"__ref":"PhotoInfo:289882750"}},"Member:86406952":{"__typename":"Member","id":"86406952","name":"Peter Yeh","memberPhoto":null},"Event:317171245":{"__typename":"Event","id":"317171245","title":"Make Your GPU Earn Its Keep: A Kernel Engineering Deep Dive","dateTime":"2026-11-30T09:00:00-08:00","description":"**Monday, November 30, 2026 · 9:00–10:00 AM PST · Online**\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\nA powerful GPU can spend plenty of time waiting. What is it waiting for—and how do you find out?\n**Talk #0: Welcome and Meetup Updates**\nby Chris Fregly and Antje Barth\n**Talk #1: From “Why Is This Slow?” to a Faster Kernel**\nby Dr. Rajat “Raj” Dandekar, Co-founder of Vizuara\nJoin Raj for a focused tour of the engineering behind fast AI kernels, drawing on Vizuara’s Kernel Engineering course on Maven. We’ll connect the roofline model to CUDA execution and the GPU memory hierarchy, then look at how profiling guides optimizations such as coalesced memory access, tiling, and tensor-core use. Matrix multiplication and attention provide context for seeing how those ideas fit together in modern AI workloads, including FlashAttention.\nThe goal is a practical way to decide what to measure, which bottleneck matters, and whether an optimization helped. The session is dedicated to Raj’s talk, with time for audience questions.\n**Who it’s for:** Engineers comfortable with Python or basic PyTorch. Prior CUDA or C++ experience is not required.\n**Bio:** Dr. Rajat Dandekar is a co-founder of Vizuara and a Kernel Engineering course instructor. He holds a PhD in Mechanical Engineering from Purdue University and BTech and MTech degrees from IIT Madras.\n**Based on:** [Kernel Engineering: From CUDA Foundations to Frontier AI Kernels](https://maven.com/rajat-dandekar/kernel-engineering)\n**Zoom link:** [https://us02web.zoom.us/j/82308186562](https://us02web.zoom.us/j/82308186562)\n**Related Links**\nGithub Repo: [http://github.com/cfregly/ai-performance-engineering/](http://github.com/cfregly/ai-performance-engineering/)\nO’Reilly Book: [https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/](https://www.amazon.com/Systems-Performance-Engineering-Optimizing-Algorithms/dp/B0F47689K8/)\nYouTube: [https://www.youtube.com/@AIPerformanceEngineering](https://www.youtube.com/@AIPerformanceEngineering)\nGenerative AI Free Course on DeepLearning.ai: [https://bit.ly/gllm](https://bit.ly/gllm)","eventType":"ONLINE","eventUrl":"https://www.meetup.com/ai-performance-engineering/events/317171245/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:530811064"},"displayPhoto":{"__ref":"PhotoInfo:530811064"},"feeSettings":null,"group":{"__ref":"Group:18712511"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":68,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:189432966"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:14250450"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:119557692"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:323615590"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:187509745"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:6703968"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:250286797"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:228005851"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:474708208"}}},{"__typename":"RsvpE