":"370184357","name":"H.E. Johnson","memberPhoto":{"__ref":"PhotoInfo:325894801"}},"Member:402696400":{"__typename":"Member","id":"402696400","name":"Nasrin Hassanlou","memberPhoto":null},"PhotoInfo:301692602":{"__typename":"PhotoInfo","id":"301692602","highResUrl":"https://secure.meetupstatic.com/photos/member/3/1/3/a/highres_301692602.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:311828677":{"__typename":"Member","id":"311828677","name":"Mr Bee ","memberPhoto":{"__ref":"PhotoInfo:301692602"}},"Member:483714118":{"__typename":"Member","id":"483714118","name":"Yen Hoang","memberPhoto":null},"PhotoInfo:213215092":{"__typename":"PhotoInfo","id":"213215092","highResUrl":"https://secure.meetupstatic.com/photos/member/8/9/1/4/highres_213215092.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:4215201":{"__typename":"Member","id":"4215201","name":"Gene Z","memberPhoto":{"__ref":"PhotoInfo:213215092"}},"Event:317273671":{"__typename":"Event","id":"317273671","title":"10 Everyday Business Tasks You Can Hand to Claude Today [ONLINE]","dateTime":"2026-11-30T12:00:00-08:00","description":"Most owners use Claude for one or two things and miss the rest. Aida walks Palo Alto owners through everyday tasks Claude handles well, from writing and summarising to planning, using Projects, file uploads and saved instructions.\n\n**What we'll cover:**\n• The five Claude features owners use every day\n• Projects, file uploads and saved instructions explained simply\n• Writing, summarising and planning faster\n• Building your own everyday Claude routine\n\n**Format:** Live on Google Meet with business owners from Palo Alto and the Bridges Network. We work through it together on screen, and questions are answered as we go.\n\n**Who it's for:** owners and managers who have tried Claude but don't use it daily yet.\n\n**Bring:** a laptop and a free Claude account.\n\n**Hosted by:** Aida from the Bridges Network.\n\n**When you RSVP:** two optional questions: whether you would like a free AI consultation, and your phone number if you want an SMS reminder before we start. Both are optional, so skip them if you like.\n\n**Fair to mention:** we end with a brief word about our done-for-you help. Everything above is taught in full beforehand.\n\n**Where:** Google Meet. The link appears here once you RSVP \"Going.\" 45 minutes, no cost.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/palo-alto-ai-business-vibes/events/317273671/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536964926"},"displayPhoto":{"__ref":"PhotoInfo:536964926"},"feeSettings":null,"group":{"__ref":"Group:38686071"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":19,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:483882102"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:8758593"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:484001163"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:483014709"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:275230560"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:10154438"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:192856490"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:121291762"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:313067465"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:6850738"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member"