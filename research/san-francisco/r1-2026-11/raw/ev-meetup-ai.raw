e.meetupstatic.com/photos/member/4/3/4/9/highres_283397225.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:270193374":{"__typename":"Member","id":"270193374","name":"Rob","memberPhoto":{"__ref":"PhotoInfo:283397225"}},"Member:74382202":{"__typename":"Member","id":"74382202","name":"Michael Balk","memberPhoto":{"__ref":"PhotoInfo:257421942"}},"Member:189133188":{"__typename":"Member","id":"189133188","name":"KP","memberPhoto":{"__ref":"PhotoInfo:320597636"}},"Event:317557787":{"__typename":"Event","id":"317557787","title":"AI INFRASUMMIT 6","dateTime":"2026-12-09T08:00:00-08:00","description":"This event is organized by Ignite GTM.\n\nOur meetup group is collaborating by promoting this event.\n\nIn order to attend, please register here:\n\n[AI INFRA SUMMIT 6 · Luma](https://luma.com/aiinfra6?coupon=IPO20\u0026tk=ZDbDIC)\n\nOur meetup members get 20 PERCENT OFF!\n\nUse promo code:\n\nIPO20\n\nHurry!\n\nSlots are limited!\n\nAI is no longer an experiment. It’s the infrastructure race shaping economic power, technological sovereignty, and the next decade of global growth.\n\n​AI INFRA SUMMIT 6 brings this conversation to San Francisco, the center of gravity for AI innovation and deployment. This is where the builders of the AI stack come together: founders, operators, investors, policymakers, and infrastructure leaders powering the next generation of compute, data centers, and intelligent systems.\n\n​From chips to clusters to agentic workloads, AIS6 focuses on the systems turning AI from promise into production.\n​If you’re building, funding, or scaling at the AI infrastructure layer, this is where you align with the ecosystem defining what comes next.\n\n***\n\n## ​**Who Attends**\n\n* ​AI-native founders and builders\n* ​Cloud and infrastructure providers\n* ​Investors, venture capitalists, and strategic partners\n* ​Energy, chip, and data center operators\n* ​Policy and ecosystem leaders\n\n***\n\n## ​**Event Details**\n\n​**Date:** Wednesday, December 9th, 2026\n**Location:** San Francisco\n**Time:** 8:30 a.m.–8:00 p.m. PT\n**Host:** IgniteGTM\n\nIf you would like to have a demo / marketing table, please send an email message to:\n\nsiliconvalleysponsor@gmail.com\n\nPut this in the subject header:\n\nW 12/9/26 - Tabler","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/the-future-of-ai-entrepreneurship-venture/events/317557787/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":{"__ref":"PhotoInfo:535634915"},"feeSettings":null,"group":{"__ref":"Group:18367525"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":38,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:257421942"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:320597636"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:243467230"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:246150221"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:173492962"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:122165242"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:206655002"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:270193374"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:74382202"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:189133188"}}}]},"series":null,"venue":{"__typename":"Venue","name":"The Midway","address":"900 Marin St, San Francisco, CA 94124, USA","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:536284172":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/1/0/4/c/hi