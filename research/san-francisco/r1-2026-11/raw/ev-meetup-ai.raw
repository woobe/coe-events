76866"}},"Member:485521717":{"__typename":"Member","id":"485521717","name":"Taranpreet Singh","memberPhoto":null},"Member:485522831":{"__typename":"Member","id":"485522831","name":"steve.sjlguitars","memberPhoto":null},"Event:313150527":{"__typename":"Event","id":"313150527","dateTime":"2026-12-05T10:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"bay-area-artificial-war-room","__ref":"Group:37053014"},"title":"Bay Area AI War Room - Berkeley Edition - Saturday, 10:00 AM","description":"Models, agent, systems, ethics, the law, business, art and impact we discuss it all. With the DeepSeek hoopla fading, what of Reasoning models?\n\nInspired by the Berkeley AI War Room, we invite you to join us at the same venue, same time, and with the same dynamic community.\n\nCome share your interests, showcase your projects, and discuss the latest trends and news that's shaping the AI landscape at a rapid pace.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/bay-area-artificial-war-room/events/313150527/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:526117592"},"displayPhoto":{"__ref":"PhotoInfo:526117592"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":20,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:3954380"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:146053142"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:481728431"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:414936896"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:10646989"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:280157663"}}},{"__typename":"RsvpEdge","node":{"__typename":"