326420138.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:324130336":{"__typename":"PhotoInfo","id":"324130336","highResUrl":"https://secure.meetupstatic.com/photos/member/2/8/6/0/highres_324130336.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:303173263":{"__typename":"PhotoInfo","id":"303173263","highResUrl":"https://secure.meetupstatic.com/photos/member/d/0/0/f/highres_303173263.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:326195586":{"__typename":"PhotoInfo","id":"326195586","highResUrl":"https://secure.meetupstatic.com/photos/member/8/b/0/2/highres_326195586.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:324338822":{"__typename":"PhotoInfo","id":"324338822","highResUrl":"https://secure.meetupstatic.com/photos/member/9/7/a/6/highres_324338822.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:270668333":{"__typename":"PhotoInfo","id":"270668333","highResUrl":"https://secure.meetupstatic.com/photos/member/2/0/8/d/highres_270668333.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:323844187":{"__typename":"PhotoInfo","id":"323844187","highResUrl":"https://secure.meetupstatic.com/photos/member/5/e/7/b/highres_323844187.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:319337210":{"__typename":"PhotoInfo","id":"319337210","highResUrl":"https://secure.meetupstatic.com/photos/member/4/3/3/a/highres_319337210.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:105350372":{"__typename":"Member","id":"105350372","name":"Elena Kaprenko","memberPhoto":{"__ref":"PhotoInfo:319337210"}},"Member:32691172":{"__typename":"Member","id":"32691172","name":"Monserrat ","memberPhoto":{"__ref":"PhotoInfo:326420138"}},"Member:206852635":{"__typename":"Member","id":"206852635","name":"Dolapo Obat","memberPhoto":{"__ref":"PhotoInfo:324130336"}},"Event:317300525":{"__typename":"Event","id":"317300525","title":"San Francisco AI \u0026 ML Professionals, Investors and Start-Ups Networking","dateTime":"2026-12-08T19:00:00-08:00","description":"🔔 **Please Note:** RSVP on Meetup **does not guarantee entry**.\nTo attend, you **must register through the official ticket link** here: [https://www.eventbrite.com/e/sf-ai-tech-startups-investors-innovators-networking-mixer-tickets-2004164381616](https://www.eventbrite.com/e/sf-ai-tech-startups-investors-innovators-networking-mixer-tickets-2004164381616)\n\nStep into the vibrant world of artificial intelligence and machine learning at our exclusive San Francisco AI \u0026 Machine Learnig Network Mixer. This event caters to innovators, thinkers, and investors in the AI and ML spheres, providing a unique opportunity to connect with industry leaders, discover cutting-edge projects, and explore potential collaborations.\n\n**Event Highlights:**\n**One-Minute Presentations:** A rapid-fire session where AI and ML startups can pitch their innovations and business ideas directly to a curated audience of peers and potential investors. Each presentation is limited to one minute, emphasizing clarity and impact.\n**Structured Networking Opportunities:** Engage in meaningful discussions with fellow innovators and industry leaders. This event is designed to foster connections that lead to collaboration, investment, and growth.\n**Investment \u0026 Business Growth Opportunities** – Discover potential deals, secure funding, and connect with professionals offering valuable expertise.\n\n**Who Should Attend:**\n\n* **Emerging AI and ML Startups:** Showcase your innovations and seek partnerships or funding in a focused setting.\n* **Investors:** Find pioneering startups within the AI and ML domains that align with your investment criteria.\n* **AI and ML Professionals:** Network with peers, discuss advancements and industry challenges, and potentially find your next career move.\n* **Students and Academics:** Immerse yourself in the industry environment, gain insights, and connect with potential mentors and collaborators.\n\n**Why This Event is a Must:**\n\n* **Effective Networking:** Tailored specifically for the AI and ML communities, this mixer facilitates targeted networking, helping you build meaningful connections that can lead to collaborative projects or ventures.\n* **Opportunity for Exposure:** Startups can gain visibility by presenting their projects during one-minute pitches, directly communicating their value to an audience that includes potential investors and collaborators.\n* **Insight into Industry Trends:** Keep up-to-date with the latest research and commercial opportunities in AI and ML through conversations with industry insiders and thought leaders.\n* **Career Opportunities:** Professionals looking to advance in the AI and ML fields can discover new opportunities and expand their networks in a dynamic, supportive environment.\n\nDon’t miss this opportunity to engage with the forefront of AI and ML innovation. Whether you’re looking to invest, collaborate, or just learn about the next big thing in tech, our San Francisco AI \u0026 ML Network Mixer is the place to be. Secure your spot today and be part of shaping the future of technology!\n\n**Why attend:**\n**1-Minute Elevator Pitches:** Every attendee will have the chance to do a **short, 1-minute pitch** to the room — introduce yourself, share what you’re building or working on, and let others know what kind of co-founder, partner, or expertise you’re looking for.\n**Networking**: Experience an evening of dynamic networking in a relaxed and welcoming atmosphere. Meet IT professionals from diverse backgrounds, including software development, cybersecurity, data science, cloud computing, artificial intelligence, and more.\n**Career Advancement Opportunities**: Explore potential career opportunities by interacting with representatives from leading tech companies and startups. Discover the latest job openings and internships in the IT and Technology sectors.\n\nThe event will be held in a sophisticated and vibrant venue, adorned with modern decor and equipped with state-of-the-art facilities to ensure your comfort and convenience throughout the day.\n\n**Register now - space is limited to 50 attendees only!**\n**P.S. Click Follow for future event alerts!**","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/sanfrancisco-startup-pitch-and-networking/events/317300525/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:530635762"},"displayPhoto":{"__ref":"PhotoInfo:530635762"},"feeSettings":null,"group":{"__ref":"Group:38178788"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":45,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326420138"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:324130336"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:303173263"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326195586"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:324338822"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:270668333"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:323844187"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:105350372"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:32691172"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:206852635"}}}]},"series":null,"venue":{"__typename":"Venue","name":"Hawthorn SF Nightclub and Lounge","address":"46 Geary St, San Francisco, CA 94108, USA","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:526117592":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/9/2/d/8/highres_526117592.jpeg","id":"526117592"},"PhotoInfo:512793226":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/8/1/c/a/highres_512793226.jpeg","id":"512793226"},"Group:37053014":{"__typename":"Group","id":"37053014","name":"Bay Area AI War Room","urlname":"bay-area-artificial-war-room","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:512793226"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.82,"totalRatings":93}},"isNewGroup":false},"PhotoInfo:319476118":{"__typename":"PhotoInfo","id":"319476118","highResUrl":"https://secure.meetupstatic.com/photos/member/8/d/1/6/highres_319476118.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:3954380":{"__typename":"Member","id":"3954380","name":"Toby W","memberPhoto":{"__ref":"PhotoInfo:319476118"}},"PhotoInfo:254796038":{"__typename":"PhotoInfo","id":"254796038","highResUrl":"https://secure.meetupstatic.com/photos/member/8/c/c/6/highres_254796038.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:146053142":{"__typename":"Member","id":"146053142","name":"Rob T","memberPhoto":{"__ref":"PhotoInfo:254796038"}},"PhotoInfo:326203158":{"__typename":"PhotoInfo","id":"326203158","highResUrl":"https://secure.meetupstatic.com/photos/member/a/8/9/6/highres_326203158.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:481728431":{"__typename":"Member","id":"481728431","name":"Shaheen Kazi","memberPhoto":{"__ref":"PhotoInfo:326203158"}},"Member:414936896":{"__typename":"Member","id":"414936896","name":"bipop upre