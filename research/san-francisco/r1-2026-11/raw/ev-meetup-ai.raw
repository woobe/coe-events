t, San Francisco (entrance on Brannan)\n\n* 5:00-6:00pm doors open for networking\n* 6:00-7:00pm panel discussion\n* 7:00-7:30pm additional networking\n\n**Want to demo?**\nIf you are interested in demoing at a future event, please fill out the [application form](https://forms.gle/ahzwgnAAs51pdiTQ9).","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/bay-area-bot-chat-and-conversational-app-developers/events/317519271/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537224566"},"displayPhoto":{"__ref":"PhotoInfo:537224566"},"feeSettings":null,"group":{"__ref":"Group:19723324"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":24,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:322506640"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:304395885"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:253289320"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:115807152"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:268906375"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:277082818"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:64474142"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":3,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:58505672"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:40855042"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:11885543"}}}]},"series":null,"venue":{"__typename":"Venue","name":"GitHub","address":"275 Brannan St","city":"San Francisco","state":"CA","country":"us"}},"PhotoInfo:528686063":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/6/5/c/f/