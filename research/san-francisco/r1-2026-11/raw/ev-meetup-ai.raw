ry, hosted by Myriad Genetics at its amazing SSF Nexus facility.\n\nPLEASE REGISTER ONLY THROUGH THE LINK BELOW:\nhttps://ardigen.com/scaling-agentic-ai-in-drug-discovery-event-2026/","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/baybifx/events/317528641/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537236665"},"displayPhoto":{"__ref":"PhotoInfo:537236665"},"feeSettings":null,"group":{"__ref":"Group:1532598"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":8,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:10533381"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:207050865"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:333002042"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:468086129"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:329354039"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:266570539"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:2130753"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:66550962"}}}]},"series":null,"venue":{"__typename":"Venue","name":"233 East Grand Avenue","address":"233 E Grand Ave., South San Francisco, CA 94080, USA","city":"South San Francisco","state":"CA","country":"us"}},"PhotoInfo:535634915":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/3/a/4/3/highres_535634915.jpeg","id":"535634915"},"Group:18367525":{"__typename":"Group","id":"18367525","name":"The future of AI, Entrepreneurship and Venture Capital","u