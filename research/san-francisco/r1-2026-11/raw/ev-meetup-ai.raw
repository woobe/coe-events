re-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:11244851":{"__typename":"PhotoInfo","id":"11244851","highResUrl":"https://secure.meetupstatic.com/photos/member/6/1/1/3/highres_11244851.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:99408592":{"__typename":"PhotoInfo","id":"99408592","highResUrl":"https://secure.meetupstatic.com/photos/member/b/d/d/0/highres_99408592.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:2501635":{"__typename":"PhotoInfo","id":"2501635","highResUrl":"https://secure.meetupstatic.com/photos/member/a/2/a/3/highres_2501635.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"PhotoInfo:281010481":{"__typename":"PhotoInfo","id":"281010481","highResUrl":"https://secure.meetupstatic.com/photos/member/7/7/1/1/highres_281010481.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:98671552":{"__typename":"Member","id":"98671552","name":"April","memberPhoto":{"__ref":"PhotoInfo:281010481"}},"Event:317572865":{"__typename":"Event","id":"317572865","title":"[SF] AI Builder Tour with Bluehost","dateTime":"2026-12-09T09:00:00-08:00","description":"**Important**: Registration on the[ ](https://www.aicamp.ai/event/eventdetails/W2026120306)[event website](https://www.aicamp.ai/event/eventdetails/W2026111709) is required for admission.\n(RSVP on meetup is turned off)\n\nJoin us for the Bluehost AI Builder Tour - San Francisco, an in-person experience bringing together entrepreneurs, developers, creators, and local AI builders ready to move from vision to launch and scale.\n\nWhether you're developing your next big idea, launching a business, or scaling something you've already built, this is your opportunity to connect with fellow builders, explore new possibilities, and get expert feedback.\n\n**Three awards, three chances to win awards - $30,000**:\nExplore three exciting opportunities to compete:\n\n* Build with Anything — Create an AI-powered solution using the tools of your choice.\n* Build \u0026 Win with Bluehost — Build a website or app using Bluehost AI Builder.\n* Vibeathon — Put your AI-powered creativity and building skills to the test.\n\n**What to Expect:**\n\n* Local AI Builder Showcases: Hear from local builders about their projects, challenges, and lessons learned.\n* Build, Host \u0026 Scale: Discover Bluehost innovations to help build, host, and run your projects.\n* Interactive AI Workshop: Bring your ideas or work in progress and get feedback from AI builders and experts.\n* Peer-to-Peer Breakouts: Discuss AI agents, infrastructure, performance, and costs with peers and experts.\n* Community \u0026 Networking: Connect with local AI builders, entrepreneurs, and industry experts.\n\n**Featured Speakers:**\n\n* Salim Ali, Bluehost\n* Antonis Papatsaras, Bluehost\n* Vishwa Shroff, Bluehost\n* Ana Ramdas, Build First\n* and more\n*\n\n**Agenda:**\n\n* 9:00am–9:30am: Coffee, Networking \u0026 Demos\n* 9:30am–10:00am: Welcome \u0026 Introduction\n* 10:00am–12:00pm: AI Builder Showcases \u0026 Workshop\n* 12:00pm–1:00pm: Lunch\n* 1:00pm–3:00pm: Interactive Workshop \u0026 Expert Feedback\n* 3:15pm–4:30pm: Peer Discussions \u0026 Expert Consultations\n* 5:00pm onwards: Happy Hour \u0026 Networking\n*","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/sv-enterprise-ai/events/317572865/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537293124"},"displayPhoto":{"__ref":"PhotoInfo:537293124"},"feeSettings":null,"group":{"__ref":"Group:677520"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":50,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:131439832"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:57733482"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo