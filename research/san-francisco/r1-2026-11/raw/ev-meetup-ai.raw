pstatic.com/photos/member/7/c/b/5/highres_298891925.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:306780321":{"__typename":"Member","id":"306780321","name":"Bhavesh","memberPhoto":{"__ref":"PhotoInfo:298891925"}},"PhotoInfo:299401786":{"__typename":"PhotoInfo","id":"299401786","highResUrl":"https://secure.meetupstatic.com/photos/member/6/f/a/highres_299401786.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:182421092":{"__typename":"Member","id":"182421092","name":"DISHANT GHAI","memberPhoto":{"__ref":"PhotoInfo:299401786"}},"PhotoInfo:242714302":{"__typename":"PhotoInfo","id":"242714302","highResUrl":"https://secure.meetupstatic.com/photos/member/3/7/d/e/highres_242714302.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:183394743":{"__typename":"Member","id":"183394743","name":"Aditi Banarse","memberPhoto":{"__ref":"PhotoInfo:242714302"}},"PhotoInfo:317241723":{"__typename":"PhotoInfo","id":"317241723","highResUrl":"https://secure.meetupstatic.com/photos/member/5/4/d/b/highres_317241723.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:189351979":{"__typename":"Member","id":"189351979","name":"Eddie Avinashi ","memberPhoto":{"__ref":"PhotoInfo:317241723"}},"Event:315814934":{"__typename":"Event","id":"315814934","dateTime":"2026-11-26T18:30:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"west-coast-machine-learning-meetup","__ref":"Group:19871729"},"title":"Weekly paper review, coding project, or random discussion","description":"This is a placeholder for our weekly meeting. We will update the meeting description each week to include the topic of the week. Stay tuned :)\n\nEvery week we meet (virtually) and discuss the most interesting topics in AI, ML and Deep Learning.\nWe usually rotate weeks so that every other week one of the members presents a deep learning/machine learning paper, frequently paired with a video explaining the concepts. In the off weeks, we present information about different projects. We cover computer vision, language (LLM's), health/hard science and generative models (Diffusion, GAN's etc.).\nPeople of all levels of skill are welcome--from newbies to machine learning, to PhD's in DL/ML/AI.\nWe have been meeting for over 6 years weekly and have developed a neat pace and community--and all are welcome. Come join us and stay abreast of the biggest topics in Artificial Intelligence.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/west-coast-machine-learning-meetup/events/315814934/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:523081294"},"displayPhoto":{"__ref":"PhotoInfo:523081294"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":11,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:201236193"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:72601442"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:260322518"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:160436552"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:340945940"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:468344591"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:319483528"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:306780321"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:182421092"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:183394743"}}},{"__typename":