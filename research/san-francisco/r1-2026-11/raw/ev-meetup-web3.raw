","name":"Austin Conlon","memberPhoto":null},"PhotoInfo:38510862":{"__typename":"PhotoInfo","id":"38510862","highResUrl":"https://secure.meetupstatic.com/photos/member/c/6/a/e/highres_38510862.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:13547168":{"__typename":"Member","id":"13547168","name":"J'aime Ohm","memberPhoto":{"__ref":"PhotoInfo:38510862"}},"Member:370349090":{"__typename":"Member","id":"370349090","name":"Abigail Ackerman","memberPhoto":{"__ref":"PhotoInfo:324942197"}},"Member:479310919":{"__typename":"Member","id":"479310919","name":"bremeyer.tech","memberPhoto":null},"Member:2888571":{"__typename":"Member","id":"2888571","name":"Gregory Williams","memberPhoto":{"__ref":"PhotoInfo:282637094"}},"Member:53091362":{"__typename":"Member","id":"53091362","name":"Kevin L","memberPhoto":{"__ref":"PhotoInfo:295908225"}},"Member:485399302":{"__typename":"Member","id":"485399302","name":"Micah Johnson","memberPhoto":{"__ref":"PhotoInfo:326687515"}},"Member:333948766":{"__typename":"Member","id":"333948766","name":"Annie Salazar","memberPhoto":{"__ref":"PhotoInfo:317101920"}},"Event:314414516":{"__typename":"Event","id":"314414516","title":"Swift Automation with Leo | Bay Area Swift","dateTime":"2026-12-10T19:00:00-08:00","description":"Join Bay Area Swift at Sentry HQ for a talk on Swift automation by Leo, joining remotely.\nThe second talk is to be determined. If you’d like to speak, tell us what you’d like to present when you [RSVP on Luma](https://luma.com/xga430jj).\nEveryone is welcome, whether you’re just curious about Apple platform development or have been developing since NeXTSTEP.\n7 PM — Snacks and networking\n7:30 PM — Talks\n9 PM — Continue at a nearby bar\nGetting to Sentry HQ by transit\nMeet us at 45 Fremont St., San Francisco, between Market and Mission streets.\n\n* BART or Muni Metro — Get off at Embarcadero or Montgomery Street. From Market Street, turn onto Fremont Street toward Mission. [Station area map](https://www.bart.gov/sites/default/files/2024-12/HSP_EM-stops.pdf)\n* Bus — Take AC Transit, Golden Gate Transit, or Muni to Salesforce Transit Center. From the Mission and Fremont exit, head toward Market Street on Fremont. [Transit Center routes](https://www.tjpa.org/salesforce-transit-center/transportation)\n* Caltrain — From 4th and King, take the N Judah toward Ocean Beach and get off at Embarcadero. [N Judah route](https://www.sfmta.com/routes/n-judah)\n* Ferry — From the Ferry Building, walk up Market Street away from the waterfront, then turn left onto Fremont Street. [Walking map](https://www.bart.gov/sites/default/files/2024-12/HSP_EM-stops.pdf)\n\nFood and drinks will be provided. Update your RSVP if your plans change.\nRecordings will be shared on Vimeo with speaker permission.\nhttps://vimeo.com/showcase/11607564\nContact us if you’d like to speak, volunteer, or provide a venue or sponsorship for future events.\nThanks to Sentry for hosting.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/swift-language/events/314414516/","isAttending":false,"isSaved":false,"maxTickets":130,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537077495"},"displayPhoto":{"__ref":"PhotoInfo:537077495"},"feeSettings":null,"group":{"__ref":"Group:14837862"},"socialProofInsights":{"__typename":"SocialProofInsights","isTrendingEvent":false,"totalInterestedUsers":43,"interestedUsersSample":[{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:324942197"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:282637094"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:295908225"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:326687515"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:317101920"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:61390042"}},{"__typename":"Member","memberPhoto":{"__ref":"PhotoInfo:52636922"}}]},"rsvps":{"__typename":"RsvpConnection","totalCount":8,"edges":[{"__typename"