os/member/b/3/c/b/highres_257026027.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:9829147":{"__typename":"Member","id":"9829147","name":"Jon Bauer","memberPhoto":{"__ref":"PhotoInfo:257026027"}},"PhotoInfo:300964866":{"__typename":"PhotoInfo","id":"300964866","highResUrl":"https://secure.meetupstatic.com/photos/member/1/3/0/2/highres_300964866.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:248450763":{"__typename":"Member","id":"248450763","name":"Bret Carpenter","memberPhoto":{"__ref":"PhotoInfo:300964866"}},"PhotoInfo:317487719":{"__typename":"PhotoInfo","id":"317487719","highResUrl":"https://secure.meetupstatic.com/photos/member/6/c/4/7/highres_317487719.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:403749593":{"__typename":"Member","id":"403749593","name":"Benson","memberPhoto":{"__ref":"PhotoInfo:317487719"}},"Member:485383580":{"__typename":"Member","id":"485383580","name":"d3c509b","memberPhoto":null},"Member:320182211":{"__typename":"Member","id":"320182211","name":"Eric Drury","memberPhoto":null},"Member:267182431":{"__typename":"Member","id":"267182431","name":"Ankita Patidar","memberPhoto":null},"PhotoInfo:310113469":{"__typename":"PhotoInfo","id":"310113469","highResUrl":"https://secure.meetupstatic.com/photos/member/8/2/b/d/highres_310113469.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:359289533":{"__typename":"Member","id":"359289533","name":"Mücahit KARSON","memberPhoto":{"__ref":"PhotoInfo:310113469"}},"PhotoInfo:289690467":{"__typename":"PhotoInfo","id":"289690467","highResUrl":"https://secure.meetupstatic.com/photos/member/2/8/e/3/highres_289690467.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:199310458":{"__typename":"Member","id":"199310458","name":"Alfonso Govela","memberPhoto":{"__ref":"PhotoInfo:289690467"}},"PhotoInfo:316614431":{"__typename":"PhotoInfo","id":"316614431","highResUrl":"https://secure.meetupstatic.com/photos/member/d/4/9/f/highres_316614431.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:226579671":{"__typename":"Member","id":"226579671","name":"Lyn Brooks","memberPhoto":{"__ref":"PhotoInfo:316614431"}},"PhotoInfo:322109447":{"__typename":"PhotoInfo","id":"322109447","highResUrl":"https://secure.meetupstatic.com/photos/member/7/3/0/7/highres_322109447.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:208556900":{"__typename":"Member","id":"208556900","name":"LF Decentralized Trust","memberPhoto":{"__ref":"PhotoInfo:322109447"}},"PhotoInfo:281616795":{"__typename":"PhotoInfo","id":"281616795","highResUrl":"https://secure.meetupstatic.com/photos/member/8/f/b/b/highres_281616795.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:265749755":{"__typename":"Member","id":"265749755","name":"Mirko Mollik","memberPhoto":{"__ref":"PhotoInfo:281616795"}},"PhotoInfo:324866218":{"__typename":"PhotoInfo","id":"324866218","highResUrl":"https://secure.meetupstatic.com/photos/member/6/6/6/a/highres_324866218.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:222737551":{"__typename":"Member","id":"222737551","name":"Peter Konopacki","memberPhoto":{"__ref":"PhotoInfo:324866218"}},"Event:317415397":{"__typename":"Event","id":"317415397","title":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","dateTime":"2026-12-08T09:00:00-08:00","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","eventType":"ONLINE","eventUrl":"https://www.meetup.com/lfdt-sf/events/317415397/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537225096"},"displayPhoto":{"__ref":"PhotoInfo:537225096"},"feeSettings":null,"group":{"__ref":"Group:19721233"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":13,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:351849423"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:9829147"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:248450763"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:403749593"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485383580"}}},{"__typename":"RsvpE