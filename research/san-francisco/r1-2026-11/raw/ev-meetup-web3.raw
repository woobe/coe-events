member/8/e/6/0/highres_260376448.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:213490489":{"__typename":"Member","id":"213490489","name":"Bob Scully","memberPhoto":{"__ref":"PhotoInfo:260376448"}},"PhotoInfo:264806154":{"__typename":"PhotoInfo","id":"264806154","highResUrl":"https://secure.meetupstatic.com/photos/member/6/6/2/a/highres_264806154.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:74119042":{"__typename":"Member","id":"74119042","name":"Mark Casey","memberPhoto":{"__ref":"PhotoInfo:264806154"}},"PhotoInfo:281995243":{"__typename":"PhotoInfo","id":"281995243","highResUrl":"https://secure.meetupstatic.com/photos/member/d/7/c/b/highres_281995243.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:13217331":{"__typename":"Member","id":"13217331","name":"Ed","memberPhoto":{"__ref":"PhotoInfo:281995243"}},"PhotoInfo:326417711":{"__typename":"PhotoInfo","id":"326417711","highResUrl":"https://secure.meetupstatic.com/photos/member/4/5/2/f/highres_326417711.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:474187338":{"__typename":"Member","id":"474187338","name":"Cheerie","memberPhoto":{"__ref":"PhotoInfo:326417711"}},"PhotoInfo:326257358":{"__typename":"PhotoInfo","id":"326257358","highResUrl":"https://secure.meetupstatic.com/photos/member/9/1/e/e/highres_326257358.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:356088516":{"__typename":"Member","id":"356088516","name":"Shashank Agrawal","memberPhoto":{"__ref":"PhotoInfo:326257358"}},"Event:317385528":{"__typename":"Event","id":"317385528","title":"Holiday Party \u0026 Socratic Seminar ","dateTime":"2026-12-12T12:00:00-08:00","description":"It’s that time of year again! On **December 12**, join Bitcoiners from across the Bay Area at **Presidio Bitcoin** for an afternoon of big ideas, good company, and holiday merriment.\n\nWe’ll kick things off with a Socratic Seminar, then keep the conversations going over food, drinks, and festive cheer. **Come for the ideas, the party, or both.**\n\nSchedule:\n12:00PM - Mingling\n12:15PM - Seminar\n2:00- 5:00PM - Holiday Party!\n\n\\-\\-\\-\\-\\-\n\nThe reading list for the Socratic Seminar be posted [here](https://sfbitcoindevs.org) a couple days before the meetup.\n\nThe seminar is for those interested in learning more about and discussing Bitcoin and related protocols. The event is formatted to foster debate, information sharing, and lively discussion.\n\nDiscussion topics from a variety of sources are collated by meetup members in the weeks preceding the event. We'll discuss pull requests in the Bitcoin Core and other relevant repositories, network statistics, research papers, technical blog posts and other relevant content.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/sf-bitcoin-devs/events/317385528/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537092571"},"displayPhoto":{"__ref":"PhotoInfo:537092571"},"feeSettings":null,"group":{"__ref":"Group:11063732"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":18,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:336476870"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:83251502"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:102564852"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:357322468"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:274041594"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:457744898"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"