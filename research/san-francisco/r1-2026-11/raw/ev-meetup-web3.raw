3":{"__typename":"PhotoInfo","id":"256449043","highResUrl":"https://secure.meetupstatic.com/photos/member/2/3/5/3/highres_256449043.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:204954042":{"__typename":"Member","id":"204954042","name":"Thomas V.","memberPhoto":{"__ref":"PhotoInfo:256449043"}},"Member:80753352":{"__typename":"Member","id":"80753352","name":"Courtney Faust","memberPhoto":null},"PhotoInfo:196231952":{"__typename":"PhotoInfo","id":"196231952","highResUrl":"https://secure.meetupstatic.com/photos/member/7/c/d/0/highres_196231952.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:145670132":{"__typename":"Member","id":"145670132","name":"Radina Matic","memberPhoto":{"__ref":"PhotoInfo:196231952"}},"PhotoInfo:314632291":{"__typename":"PhotoInfo","id":"314632291","highResUrl":"https://secure.meetupstatic.com/photos/member/c/c/4/3/highres_314632291.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:4344270":{"__typename":"Member","id":"4344270","name":"Sharon Ford","memberPhoto":{"__ref":"PhotoInfo:314632291"}},"PhotoInfo:319330726":{"__typename":"PhotoInfo","id":"319330726","highResUrl":"https://secure.meetupstatic.com/photos/member/2/9/e/6/highres_319330726.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:133844492":{"__typename":"Member","id":"133844492","name":"Béryl DLG","memberPhoto":{"__ref":"PhotoInfo:319330726"}},"Event:316764360":{"__typename":"Event","id":"316764360","dateTime":"2026-12-03T08:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"wordpress-accessibility-meetup-group","__ref":"Group:35277578"},"title":"How to Code Accessible Gutenberg Blocks: William Patton","description":"Building a custom Gutenberg block that looks polished is easy. Building one that actually works for keyboard and screen reader users in the editor, on the frontend, and in any interactive behavior it adds is where most blocks are overlooked.\n\nThis session walks through building an accessible custom block from the ground up across all three of those layers: keyboard and screen-reader support inside the block editor, semantic markup in the rendered frontend output, and correct ARIA Authoring Practices patterns for common interactive block widgets like tabs, accordions, and modals. Plus diving into what the Interactivity API does and doesn’t handle for you automatically.\n\n**Thank you to our sponsors:**\n\n* Live captions and post-event transcription: [Kinsta](https://kinsta.com/?utm_source=meetup.com\u0026utm_medium=sponsorship\u0026utm_campaign=accessibility_meetup)\n* Organizer and host: [Equalize Digital Accessibility Checker](https://equalizedigital.com/accessibility-checker/?utm_source=meetup\u0026utm_medium=event-description)\n* **Your Business here!** [Learn about sponsorship](https://equalizedigital.com/wordpress-accessibility-meetup/sponsor/?utm_source=meetup\u0026utm_medium=event-description)\n\n**Event Details:**\nThis meetup will be held at U.S. 8 AM Pacific, which is 10 AM U.S. Central, 4 PM in the UK, and 8:30 PM IST.\n\nRSVP to receive the link.\n\n**Accessibility \u0026 Accommodations:**\nThis meetup will be held virtually over Zoom and live captioned.\n\nSlide links will be provided when applicable, and presenters are encouraged to make slides as accessible as possible with alternative text for images, etc.\n\nWe're working to secure sponsors so that we can offer ASL interpretation.\n\nAll are welcome to attend. If you need specific accommodations to make this meetup work for you, please contact an organizer, and we will try our best to accommodate you.\n\n**Code of Conduct:**\nPlease note that this group is a welcoming space for all, and all members must follow the [WordPress Online Code of Conduct](https://make.wordpress.org/community/handbook/virtual-events/online-code-of-conduct/).\n\nBy RSVPing to this meetup, you agree to abide by these guidelines. If you have concerns that the Online Code of Conduct is not being followed, please contact an organizer.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/wordpress-accessibility-meetup-group/events/316764360/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:536372417"},"displayPhoto":{"__ref":"PhotoInfo:536372417"},"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":21,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:139421922"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:351934200"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:407722838"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:225798895"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485217868"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:348119035"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:281684118"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:485089201"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:188769800"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:235281037"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:201858380"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:477129660"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:209421229"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:424786058"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:347005231"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:204954042"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:80753352"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:145670132"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:4344270"}}},{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":false,"member":{"__ref":"Member:133844492"}}}]},"series":{"__typename":"Series","description":"Every 1st Thursday of the month","weeklyRecurrence":null,"monthlyRecurrence":{"__typename":"MonthlyRecurrenceInfo","monthlyDayOfWeek":"THURSDAY","monthlyWeekOfMonth":1},"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:316764360"}},{"__typename":"EventEdge","node":{"__ref":"Event:317566338"}},{"__typename":"EventEdge","node":{"__ref":"Event:bxmrksykcdbgb"}},{"__typename":"EventEdge","node":{"__ref":"Event:bxmrksykcfbgb"}},{"__typename":"EventEdge","node":{"__ref":"Event:314088201"}}]}},"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"Event:317566338":{"__typename":"Event","id":"317566338","dateTime":"2027-01-07T08:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"wordpress-accessibility-meetup-group"}},"Event:bxmrksykcdbgb":{"__typename":"Event","id":"bxmrksykcdbgb","dateTime":"2027-02-04T08:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"wordpress-accessibility-meetup-group"}},"Event:bxmrksykcfbgb":{"__typename":"Event","id":"bxmrksykcfbgb","dateTime":"2027-03-04T08:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"wordpress-accessibility-meetup-group"}},"Event:314088201":{"__typename":"Event","id":"314088201","dateTime":"2027-04-01T08:00:00-07:00","isAttending":false,"group":{"__typename":"Group","urlname":"wordpress-accessibility-meetup-group"}},"Group:22994647":{"__typename":"Group","id":"22994647","name":"Live Premium Project Tutorial","urlname":"Live-Premium-Project","timezone":"America/Los_Angeles","keyGroupPhoto":null,"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":5,"totalRatings":1}},"isNewGroup":false},"PhotoInfo:248271745":{"__typename":"PhotoInfo","id":"248271745","highResUrl":"https://secure.meetupstatic.com/photos/member/c/a/2/1/highres_248271745.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-member/"},"Member:190494119":{"__typename":"Member","id":"190494119","name":"Yan de Mello","memberPhoto":{"__ref":"PhotoInfo:248271745"}},"Event:317319076":{"__typename":"Event","id":"317319076","dateTime":"2026-11-26T14:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project","__ref":"Group:22994647"},"title":"How to create a Zoo management web app","description":"All companies need software to manage their operation even zoos. Employees management, Animals inventory, planning of feeding we are going to develop this.\n\nThis tutorial will cover how to build this kind of application with symfony and PHP. To follow this tutorial you need some requirement listed below.\n\nWhat are the requirements?\n\nThis section will cover requirements of programming language, skills viewers should have to understand and follow this tutorial.\n\nHTML/CSSDatabases driven websitesPHP POO and SQLMVC comprehension (for symfony 3)And the most important is: desire to learnWhat is the target audience?\n\nLearners who want to enhance their knowledge This course will help the students who are doing their final projects\n\nWhen are the streaming sessions (streaming schedule)?\n\nWeekly 4:30 PM EST New York time on Tuesday and Thursday\n\nProject Start Date: Tuesday, March 28, 2017\n\nWhere can I find sources ?\n\nSources are available on GitHub pkshetlie/ZooManager (https://github.com/pkshetlie/ZooManager) pushed after each session.\n\nProject Overview:For information : one session is about 3 or 4h maybe more if session is not completed, questions are allowed in English and in French, I respond in the question language. Maybe the project must continue after all session to improve the application.","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/live-premium-project/events/317319076/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":null,"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:190494119"}}}]},"series":{"__typename":"Series","description":"Every week on Thursday","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["THURSDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:317319076"}},{"__typename":"EventEdge","node":{"__ref":"Event:317418888"}},{"__typename":"EventEdge","node":{"__ref":"Event:317519152"}},{"__typename":"EventEdge","node":{"__ref":"Event:jxpswmyjcqbwb"}},{"__typename":"EventEdge","node":{"__ref":"Event:jxpswmyjcqbgc"}}]}},"venue":{"__typename":"Venue","name":"LiveEdu.tv","address":"https://www.liveedu.tv/pkshetlie/R8kme-how-to-create-a-zoo-management-web-app/","city":"San Francisco","state":"CA","country":"us"}},"Event:317418888":{"__typename":"Event","id":"317418888","dateTime":"2026-12-03T14:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:317519152":{"__typename":"Event","id":"317519152","dateTime":"2026-12-10T14:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:jxpswmyjcqbwb":{"__typename":"Event","id":"jxpswmyjcqbwb","dateTime":"2026-12-17T14:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:jxpswmyjcqbgc":{"__typename":"Event","id":"jxpswmyjcqbgc","dateTime":"2026-12-24T14:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:317322445":{"__typename":"Event","id":"317322445","dateTime":"2026-11-26T18:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project","__ref":"Group:22994647"},"title":"Creating an Instagram Service in Django","description":"This tutorial will cover everything from A to Z of building the backend of an Instagram-like service. We will start with setting up the environment using Vagrant, Python, Postgres, and Django while I help explain best practices for rapidly prototyping an API centric application. From there we will install the required Django plugins (such as Django Rest Framework), build the views and serializes, and handle user authentication. The next component will be dealing with image uploading, applying filters, and saving the data to a CDN capable location (S3). We’ll wrap up the project by creating all the other API endpoints such as getting profile info, liking, commenting, and following. I hope this tutorial series gives you a great idea of the many complexities that exist when building applications.\n\nDjango boilerplate can be found here: https://github.com/tsavecodes/djawesome\n\nTutorial overview\n\nheader\nWhat are the requirements?\n\nPython + Django\nDatabases driven websites (we’ll be using Postgres)\nLinux (we’ll be hosting on Ubuntu)\nI’ll be developing on a Mac, but since we are using Vagrant any OS should do\n\nWhat is the target audience?\n\nLearners who want to understand Django’s structure for big applications\nLearners who want to enhance their knowledge of API best practices\nLearners who don’t know how to get started building an application","eventType":"PHYSICAL","eventUrl":"https://www.meetup.com/live-premium-project/events/317322445/","isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":null,"displayPhoto":null,"feeSettings":null,"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":1,"edges":[{"__typename":"RsvpEdge","node":{"__typename":"Rsvp","isHost":true,"member":{"__ref":"Member:190494119"}}}]},"series":{"__typename":"Series","description":"Every week on Thursday","weeklyRecurrence":{"__typename":"WeeklyRecurrenceInfo","weeklyDaysOfWeek":["THURSDAY"],"weeklyInterval":1},"monthlyRecurrence":null,"events({\"numberOfEvents\":5,\"startDate\":\"2026-11-25\"})":{"__typename":"SeriesEventConnection","edges":[{"__typename":"EventEdge","node":{"__ref":"Event:317322445"}},{"__typename":"EventEdge","node":{"__ref":"Event:317424357"}},{"__typename":"EventEdge","node":{"__ref":"Event:317522307"}},{"__typename":"EventEdge","node":{"__ref":"Event:pxpswmyjcqbwb"}},{"__typename":"EventEdge","node":{"__ref":"Event:pxpswmyjcqbgc"}}]}},"venue":{"__typename":"Venue","name":"LiveEdu.tv","address":"https://www.liveedu.tv/tylersavery/R0kJ7-creating-an-instagram-service-in-django/","city":"San Francisco","state":"CA","country":"us"}},"Event:317424357":{"__typename":"Event","id":"317424357","dateTime":"2026-12-03T18:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:317522307":{"__typename":"Event","id":"317522307","dateTime":"2026-12-10T18:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:pxpswmyjcqbwb":{"__typename":"Event","id":"pxpswmyjcqbwb","dateTime":"2026-12-17T18:00:00-08:00","isAttending":false,"group":{"__typename":"Group","urlname":"Live-Premium-Project"}},"Event:pxpswmyjcqbgc":{"__typename":"Event","id":"pxpswmyjcqbgc","da