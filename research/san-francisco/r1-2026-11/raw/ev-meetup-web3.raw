rch"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:315633447"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:314414516"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:317415397"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:317172030"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:317385528"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:317201577"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}},{"__typename":"EventSearchEdge","node":{"__ref":"Event:317373220"},"metadata":{"__typename":"SearchMetadata","recId":"5d49931c-b9a5-4a15-a00d-51b0b2822971","recSource":"event-search"}}]}},"PhotoInfo:537123505":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/d/b/1/highres_537123505.jpeg","id":"537123505"},"PhotoInfo:451846646":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/b/6/3/6/highres_451846646.jpeg","id":"451846646"},"Group:2048391":{"__typename":"Group","id":"2048391","name":"BayNode - The Bay Area Node.js Meetup","urlname":"baynode","timezone":"America/Los_Angeles","keyGroupPhoto":{"__ref":"PhotoInfo:451846646"},"stats":{"__typename":"GroupStats","eventRatings":{"__typename":"GroupStatsEventRatings","average":4.62,"totalRatings":241}},"isNewGroup":false},"Event:317415266":{"__typename":"Event","id":"317415266","title":"Dec 8 - How to Let Long-tail Guide Your 3D Annotation Workshop","dateTime":"2026-12-08T09:00:00-08:00","description":"Join us on Dec 8 for the “How to Let Long-tail Guide Your 3D Annotation” workshop with [Eric Hofesmann](https://www.linkedin.com/in/eric-hofesmann/).\n\n**Date, Time and Location**\n\nDec 08, 2026\n9:00 AM - 10:00 AM PST\nOnline. **[Register for the Zoom!](https://voxel51.com/events/how-to-let-long-tail-guide-your-3d-annotation-december-8-2026)**\n\nAutonomous driving models rarely fail on the common case. They fail on the long-tail: the pedestrian stepping out from behind a parked truck or a construction zone that matches nothing in the training set. Each of those moments lives in synchronized multi-sensor data, made up of a LiDAR sweep, a ring of cameras, a timestamp, and a calibration. Fixing one means finding it, labeling it in 3D, and proving the next model handles it.\n\nIn this live session, we will take long-tail driving scenarios from discovery to 3D labels to evaluation, and make the case that 3D ground truth should be built where your data lives, not exported away from it.","eventType":"ONLINE","eventUrl":"https://www.meetup.com/baynode/events/317415266/","isAttending":false,"isSaved":false,"maxTickets":0,"rsvpState":"JOIN_OPEN","featuredEventPhoto":{"__ref":"PhotoInfo:537123505"},"displayPhoto":{"__ref":"PhotoInfo:537123505"},"feeSettings":null,"group":{"__ref":"Group:2048391"},"socialProofInsights":null,"rsvps":{"__typename":"RsvpConnection","totalCount":0,"edges":[]},"series":null,"venue":{"__typename":"Venue","name":"Online event","address":"","city":"","state":"","country":""}},"PhotoInfo:473750337":{"__typename":"PhotoInfo","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/