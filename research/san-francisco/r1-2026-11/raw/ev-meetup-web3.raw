<!DOCTYPE html><html lang="en-US"><head><meta charSet="utf-8" data-next-head=""/><style data-fullcalendar="true" data-next-head=""></style><meta name="viewport" content="width=device-width, initial-scale=1" data-next-head=""/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" data-next-head=""/><meta name="service" content="web-next" data-next-head=""/><meta name="X-Location" content="east" data-next-head=""/><meta name="X-Build-Version" content="ccd1aebcde5d2dfdbf081f86deedb26c82a71fdb" data-next-head=""/><link rel="icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" type="image/x-icon" sizes="any" data-next-head=""/><link rel="shortcut icon" href="https://secure.meetupstatic.com/next/images/favicon.ico" data-next-head=""/><link rel="apple-touch-icon" sizes="120x120" href="https://secure.meetupstatic.com/next/images/general/m_redesign_120x120.png" data-next-head=""/><link rel="apple-touch-icon" sizes="152x152" href="https://secure.meetupstatic.com/next/images/general/m_redesign_152x152.png" data-next-head=""/><link rel="apple-touch-icon" sizes="167x167" href="https://secure.meetupstatic.com/next/images/general/m_redesign_167x167.png" data-next-head=""/><link rel="shortcut icon" sizes="128x128" href="https://secure.meetupstatic.com/next/images/general/m_redesign_128x128.png" data-next-head=""/><link rel="shortcut icon" sizes="196x196" href="https://secure.meetupstatic.com/next/images/general/m_redesign_196x196.png" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Regular.1ca3b39b.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Medium.7b11edcf.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Bold.5c45f750.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/NeuSans-Book.27256a60.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="/_next/static/media/Boyrun-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-head=""/><link rel="preload" href="https://www.facebook.com/tr?id=792405807634160&amp;ev=PageView&amp;noscript=1" as="image" data-next-head=""/><script type="application/ld+json" data-next-head="">{"@type":"Organization","@context":"https://schema.org","url":"https://www.meetup.com/find/","name":"Meetup","logo":"https://secure.meetupstatic.com/next/images/general/m_redesign_630x630.png","sameAs":["https://www.facebook.com/meetup/","https://twitter.com/Meetup/","https://www.youtube.com/meetup","https://www.instagram.com/meetup/"]}</script><title data-next-head="">Find Events &amp; Groups | Meetup</title><meta name="description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="fb:app_id" content="2403839689" data-next-head=""/><meta property="og:site_name" content="Meetup" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:title" content="Find Events &amp; Groups | Meetup" data-next-head=""/><meta property="og:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="og:url" content="https://www.meetup.com/find/" data-next-head=""/><meta property="og:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="al:android:app_name" content="Meetup" data-next-head=""/><meta property="al:android:package" content="com.meetup" data-next-head=""/><meta property="al:ios:app_store_id" content="375990038" data-next-head=""/><meta property="al:ios:app_name" content="Meetup" data-next-head=""/><meta property="al:web:should_fallback" content="true" data-next-head=""/><meta property="al:android:url" content="meetup://" data-next-head=""/><meta property="al:ios:url" content="meetup://" data-next-head=""/><meta property="al:web:url" content="https://www.meetup.com/" data-next-head=""/><meta property="twitter:card" content="summary_large_image" data-next-head=""/><meta property="twitter:site" content="@meetup" data-next-head=""/><meta property="twitter:image" content="https://secure.meetupstatic.com/next/images/shared/meetup-flyer.png" data-next-head=""/><meta property="twitter:description" content="Find Meetup events and groups so you can do more of what matters to you and meet people near you who share your interests." data-next-head=""/><meta property="twitter:app:id:iphone" content="375990038" data-next-head=""/><meta property="twitter:app:name:iphone" content="Meetup" data-next-head=""/><meta property="twitter:app:id:ipad" content="375990038" data-next-head=""/><meta property="twitter:app:name:ipad" content="Meetup" data-next-head=""/><meta property="twitter:app:id:googleplay" content="com.meetup" data-next-head=""/><meta property="twitter:app:name:googleplay" content="Meetup" data-next-head=""/><meta name="robots" content="noindex, follow" data-next-head=""/><link rel="canonical" href="https://www.meetup.com/find/" data-next-head=""/><link rel="preconnect" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="dns-prefetch" href="https://secure-content.meetupstatic.com" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com" data-next-head=""/><link rel="dns-prefetch" href="https://www.googletagmanager.com" data-next-head=""/><script type="application/ld+json" data-next-head="">[{"@context":"https://schema.org","@type":"Event","name":"Dec 8 - How to Let Long-tail Guide Your 3D Annotation Workshop","url":"https://www.meetup.com/baynode/events/317415266/","description":"Join us on Dec 8 for the “How to Let Long-tail Guide Your 3D Annotation” workshop with [Eric Hofesmann](https://www.linkedin.com/in/eric-hofesmann/).\n\n**Date, Time and Location**\n\nDec 08, 2026\n9:00 AM - 10:00 AM PST\nOnline. **[Register for the Zoom!](https://voxel51.com/events/how-to-let-long-tail-guide-your-3d-annotation-december-8-2026)**\n\nAutonomous driving models rarely fail on the common case. They fail on the long-tail: the pedestrian stepping out from behind a parked truck or a construction zone that matches nothing in the training set. Each of those moments lives in synchronized multi-sensor data, made up of a LiDAR sweep, a ring of cameras, a timestamp, and a calibration. Fixing one means finding it, labeling it in 3D, and proving the next model handles it.\n\nIn this live session, we will take long-tail driving scenarios from discovery to 3D labels to evaluation, and make the case that 3D ground truth should be built where your data lives, not exported away from it.","startDate":"2026-12-08T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/baynode/events/317415266/"},"organizer":{"@type":"Organization","name":"BayNode - The Bay Area Node.js Meetup","url":"https://www.meetup.com/baynode/"},"performer":"BayNode - The Bay Area Node.js Meetup"},{"@context":"https://schema.org","@type":"Event","name":"Web3 and AI networking at The Rose & Crown","url":"https://www.meetup.com/palo-alto-cryptomondays-meetup/events/317377428/","description":"Professional Networking, AI and Web3 Chat\n-Meet other people in AI and Web3\n-Discuss current trends and pitch your ideas\n-Come and join us at The Rose and Crown!","startDate":"2026-12-01T02:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"The Rose & Crown","address":{"@type":"PostalAddress","addressLocality":"Palo Alto","addressRegion":"CA","addressCountry":"us","streetAddress":"547 Emerson St, Palo Alto, CA"}},"organizer":{"@type":"Organization","name":"CryptoMondays Palo Alto Meetup","url":"https://www.meetup.com/palo-alto-cryptomondays-meetup/"},"performer":"CryptoMondays Palo Alto Meetup"},{"@context":"https://schema.org","@type":"Event","name":"How to Code Accessible Gutenberg Blocks: William Patton","url":"https://www.meetup.com/wordpress-accessibility-meetup-group/events/316764360/","description":"Building a custom Gutenberg block that looks polished is easy. Building one that actually works for keyboard and screen reader users in the editor, on the frontend, and in any interactive behavior it adds is where most blocks are overlooked.\n\nThis session walks through building an accessible custom block from the ground up across all three of those layers: keyboard and screen-reader support inside the block editor, semantic markup in the rendered frontend output, and correct ARIA Authoring Practices patterns for common interactive block widgets like tabs, accordions, and modals. Plus diving into what the Interactivity API does and doesn’t handle for you automatically.\n\n**Thank you to our sponsors:**\n\n* Live captions and post-event transcription: [Kinsta](https://kinsta.com/?utm_source=meetup.com&utm_medium=sponsorship&utm_campaign=accessibility_meetup)\n* Organizer and host: [Equalize Digital Accessibility Checker](https://equalizedigital.com/accessibility-checker/?utm_source=meetup&utm_medium=event-description)\n* **Your Business here!** [Learn about sponsorship](https://equalizedigital.com/wordpress-accessibility-meetup/sponsor/?utm_source=meetup&utm_medium=event-description)\n\n**Event Details:**\nThis meetup will be held at U.S. 8 AM Pacific, which is 10 AM U.S. Central, 4 PM in the UK, and 8:30 PM IST.\n\nRSVP to receive the link.\n\n**Accessibility & Accommodations:**\nThis meetup will be held virtually over Zoom and live captioned.\n\nSlide links will be provided when applicable, and presenters are encouraged to make slides as accessible as possible with alternative text for images, etc.\n\nWe're working to secure sponsors so that we can offer ASL interpretation.\n\nAll are welcome to attend. If you need specific accommodations to make this meetup work for you, please contact an organizer, and we will try our best to accommodate you.\n\n**Code of Conduct:**\nPlease note that this group is a welcoming space for all, and all members must follow the [WordPress Online Code of Conduct](https://make.wordpress.org/community/handbook/virtual-events/online-code-of-conduct/).\n\nBy RSVPing to this meetup, you agree to abide by these guidelines. If you have concerns that the Online Code of Conduct is not being followed, please contact an organizer.","startDate":"2026-12-03T16:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/wordpress-accessibility-meetup-group/events/316764360/"},"organizer":{"@type":"Organization","name":"WordPress Accessibility Meetup","url":"https://www.meetup.com/wordpress-accessibility-meetup-group/"},"performer":"WordPress Accessibility Meetup"},{"@context":"https://schema.org","@type":"Event","name":"How to create a Zoo management web app","url":"https://www.meetup.com/live-premium-project/events/317319076/","description":"All companies need software to manage their operation even zoos. Employees management, Animals inventory, planning of feeding we are going to develop this.\n\nThis tutorial will cover how to build this kind of application with symfony and PHP. To follow this tutorial you need some requirement listed below.\n\nWhat are the requirements?\n\nThis section will cover requirements of programming language, skills viewers should have to understand and follow this tutorial.\n\nHTML/CSSDatabases driven websitesPHP POO and SQLMVC comprehension (for symfony 3)And the most important is: desire to learnWhat is the target audience?\n\nLearners who want to enhance their knowledge This course will help the students who are doing their final projects\n\nWhen are the streaming sessions (streaming schedule)?\n\nWeekly 4:30 PM EST New York time on Tuesday and Thursday\n\nProject Start Date: Tuesday, March 28, 2017\n\nWhere can I find sources ?\n\nSources are available on GitHub pkshetlie/ZooManager (https://github.com/pkshetlie/ZooManager) pushed after each session.\n\nProject Overview:For information : one session is about 3 or 4h maybe more if session is not completed, questions are allowed in English and in French, I respond in the question language. Maybe the project must continue after all session to improve the application.","startDate":"2026-11-26T22:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"LiveEdu.tv","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"https://www.liveedu.tv/pkshetlie/R8kme-how-to-create-a-zoo-management-web-app/, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Live Premium Project Tutorial","url":"https://www.meetup.com/live-premium-project/"},"performer":"Live Premium Project Tutorial"},{"@context":"https://schema.org","@type":"Event","name":"Creating an Instagram Service in Django","url":"https://www.meetup.com/live-premium-project/events/317322445/","description":"This tutorial will cover everything from A to Z of building the backend of an Instagram-like service. We will start with setting up the environment using Vagrant, Python, Postgres, and Django while I help explain best practices for rapidly prototyping an API centric application. From there we will install the required Django plugins (such as Django Rest Framework), build the views and serializes, and handle user authentication. The next component will be dealing with image uploading, applying filters, and saving the data to a CDN capable location (S3). We’ll wrap up the project by creating all the other API endpoints such as getting profile info, liking, commenting, and following. I hope this tutorial series gives you a great idea of the many complexities that exist when building applications.\n\nDjango boilerplate can be found here: https://github.com/tsavecodes/djawesome\n\nTutorial overview\n\nheader\nWhat are the requirements?\n\nPython + Django\nDatabases driven websites (we’ll be using Postgres)\nLinux (we’ll be hosting on Ubuntu)\nI’ll be developing on a Mac, but since we are using Vagrant any OS should do\n\nWhat is the target audience?\n\nLearners who want to understand Django’s structure for big applications\nLearners who want to enhance their knowledge of API best practices\nLearners who don’t know how to get started building an application","startDate":"2026-11-27T02:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"LiveEdu.tv","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"https://www.liveedu.tv/tylersavery/R0kJ7-creating-an-instagram-service-in-django/, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Live Premium Project Tutorial","url":"https://www.meetup.com/live-premium-project/"},"performer":"Live Premium Project Tutorial"},{"@context":"https://schema.org","@type":"Event","name":"Meditation For Beginners: Free Webinar & Online offering","url":"https://www.meetup.com/anythingfun/events/315633447/","description":"","startDate":"2026-11-26T02:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/anythingfun/events/315633447/"},"organizer":{"@type":"Organization","name":"Bay Area Hiking And Anything Fun","url":"https://www.meetup.com/anythingfun/"},"performer":"Bay Area Hiking And Anything Fun"},{"@context":"https://schema.org","@type":"Event","name":"Swift Automation with Leo | Bay Area Swift","url":"https://www.meetup.com/swift-language/events/314414516/","description":"Join Bay Area Swift at Sentry HQ for a talk on Swift automation by Leo, joining remotely.\nThe second talk is to be determined. If you’d like to speak, tell us what you’d like to present when you [RSVP on Luma](https://luma.com/xga430jj).\nEveryone is welcome, whether you’re just curious about Apple platform development or have been developing since NeXTSTEP.\n7 PM — Snacks and networking\n7:30 PM — Talks\n9 PM — Continue at a nearby bar\nGetting to Sentry HQ by transit\nMeet us at 45 Fremont St., San Francisco, between Market and Mission streets.\n\n* BART or Muni Metro — Get off at Embarcadero or Montgomery Street. From Market Street, turn onto Fremont Street toward Mission. [Station area map](https://www.bart.gov/sites/default/files/2024-12/HSP_EM-stops.pdf)\n* Bus — Take AC Transit, Golden Gate Transit, or Muni to Salesforce Transit Center. From the Mission and Fremont exit, head toward Market Street on Fremont. [Transit Center routes](https://www.tjpa.org/salesforce-transit-center/transportation)\n* Caltrain — From 4th and King, take the N Judah toward Ocean Beach and get off at Embarcadero. [N Judah route](https://www.sfmta.com/routes/n-judah)\n* Ferry — From the Ferry Building, walk up Market Street away from the waterfront, then turn left onto Fremont Street. [Walking map](https://www.bart.gov/sites/default/files/2024-12/HSP_EM-stops.pdf)\n\nFood and drinks will be provided. Update your RSVP if your plans change.\nRecordings will be shared on Vimeo with speaker permission.\nhttps://vimeo.com/showcase/11607564\nContact us if you’d like to speak, volunteer, or provide a venue or sponsorship for future events.\nThanks to Sentry for hosting.","startDate":"2026-12-11T03:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Sentry HQ","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"45 Fremont St, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Swift Language User Group x Cocoaheads | SF & Silicon Valley","url":"https://www.meetup.com/swift-language/"},"performer":"Swift Language User Group x Cocoaheads | SF & Silicon Valley"},{"@context":"https://schema.org","@type":"Event","name":"Talk to EUDI Wallets Without Reading 1,400 Pages of Specs","url":"https://www.meetup.com/lfdt-sf/events/317415397/","description":"Connecting a service to EUDI Wallets is like a family dinner with 27 relatives who each speak their own versioned dialect of the same language. You need fluent OID4VCI, OID4VP, SD-JWT VC, ISO mdoc, status lists, trust lists and X.509, ideally by yesterday.\n\nEUDIPLO ([https://github.com/EUDIPLO](https://github.com/EUDIPLO)) is an open source project hosted by LF Decentralized Trust. It’s the diplomat you send so you don’t have to go yourself. Your backend makes plain HTTP calls, and EUDIPLO handles the handshakes and cryptographic small talk with the wallets.\n\nThe meetup will cover the following parts:\n\\- Issue\\, request and “show me your ID before I give you one\\,” all in one API\n\\- Conformance\\-tested against the OpenID Foundation suites\n\\- Multi\\-tenancy\\, key and certificate management\\, ETSI trust lists\n\\- From zero to running with eudiplo demo\n\\- your questions how to use and contribute\n\nThe session ends with a live demo, if the demo gods cooperate.\n\n**Zoom Meeting Link**: [https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09](https://zoom.us/my/hyperledger.community.3?pwd=UE90WHhEaHRqOGEyMkV3cldKa2d2dz09)\n\n**Please note: This event is being shared with our entire global community. If you're interested in this content but can't attend the event live, feel free to sign up and we will send you a link to the recording after the meetup is over.**","startDate":"2026-12-08T17:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://www.meetup.com/lfdt-sf/events/317415397/"},"organizer":{"@type":"Organization","name":"LFDT San Francisco","url":"https://www.meetup.com/lfdt-sf/"},"performer":"LFDT San Francisco"},{"@context":"https://schema.org","@type":"Event","name":"Mozzi On Arduino (Circuit Hacking Mondays)","url":"https://www.meetup.com/noisebridge/events/317172030/","description":"Mozzi is a library of audio functions that run on Arduino and ESP 32\nmicroprocessors.\n\nMozzi is a well documented collection of audio programs with example sketches, detailed notes and a support community. I first heard about Mozzi on the Noisebridge-Discord pedal building channel. The Arduino/Mozzi system is a popular platform for making custom guitar effects pedals and synth modules. This CHM workshop presents the Mozzi/Arduino setup, a simple sound production circuit (transistor amplifier and speaker) and runs through some of the examples provided through the Arduino iDE.\n\nContinuing where we left off but come anyway if you missed the first class.","startDate":"2026-12-01T03:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-5-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Noisebridge","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"US","streetAddress":"272 Capp St, Noisebridge, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Noisebridge Hackerspace","url":"https://www.meetup.com/noisebridge/"},"performer":"Noisebridge Hackerspace"},{"@context":"https://schema.org","@type":"Event","name":"Holiday Party & Socratic Seminar ","url":"https://www.meetup.com/sf-bitcoin-devs/events/317385528/","description":"It’s that time of year again! On **December 12**, join Bitcoiners from across the Bay Area at **Presidio Bitcoin** for an afternoon of big ideas, good company, and holiday merriment.\n\nWe’ll kick things off with a Socratic Seminar, then keep the conversations going over food, drinks, and festive cheer. **Come for the ideas, the party, or both.**\n\nSchedule:\n12:00PM - Mingling\n12:15PM - Seminar\n2:00- 5:00PM - Holiday Party!\n\n\\-\\-\\-\\-\\-\n\nThe reading list for the Socratic Seminar be posted [here](https://sfbitcoindevs.org) a couple days before the meetup.\n\nThe seminar is for those interested in learning more about and discussing Bitcoin and related protocols. The event is formatted to foster debate, information sharing, and lively discussion.\n\nDiscussion topics from a variety of sources are collated by meetup members in the weeks preceding the event. We'll discuss pull requests in the Bitcoin Core and other relevant repositories, network statistics, research papers, technical blog posts and other relevant content.","startDate":"2026-12-12T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-3-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Presidio Bitcoin","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"38 Keyes Ave, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"SF Bitcoin Devs","url":"https://www.meetup.com/sf-bitcoin-devs/"},"performer":"SF Bitcoin Devs"},{"@context":"https://schema.org","@type":"Event","name":"Embarcadero Night Skate & Pizza","url":"https://www.meetup.com/gist-irl/events/317201577/","description":"**RSVP via:**\nhttps://app.gistirl.com/event-details/uAYeW8e993ZaoVscFCH1?utm_source=meetup&utm_content=a\n**Early Bird Discounts | More $ Later**\n\nHey late-night rollers,\n\nCome feel the cool bay breeze and catch the rhythm of the Friday night skate beats along the Embarcadero with a fresh crew. Join me for an easygoing evening where we'll start with an hour of app-guided chats to meet some great people, and then form small groups to hit the pavement and grab some food.\n\nWe'll spend the first part of the night jumping into quick one-on-one rounds. The Gist IRL app sets up the pairings for us, giving you a chance to easily chat with other active folks who love being out after the sun goes down. After we break the ice, we get to the best part. You'll choose the people you clicked with most, join the Friday night roll along the Embarcadero, and grab late-night pizza slices together.\n\nBy the end of the night, you have a solid crew of 4-6 to cruise the waterfront with and split late-night pizza slices. Whether this bunch becomes your regular Friday night roll crew or it's just one incredibly fun evening under the city lights, you'll be glad you brought your gear.\n\nThe Plan:\n\n- 7:30PM: Check-In. Follow the link to set up your quick profile on your phone.\n- 7:35PM - 8:55PM: One-on-One Rounds. The app pairs you for focused chats. Find out who shares your late-night energy, favorite routes, and passion for moving after dark.\n- 8:55PM+: Form Groups & head down the Embarcadero together to catch the skate beats and grab late-night pizza slices. Reconnect with your favorite matches, form groups of 4-6, and head down the Embarcadero together to catch the skate beats and grab late-night pizza slices — your group leaves together tonight.\n\nInstead of just adding random names to your phone, let's actually join the night roll and grab pizza tonight. You might just meet the exact right people for future night rolls and late-night food spots to explore together. And to make things totally seamless, you can use the app to message your new friends later on without ever having to trade phone numbers.\n\nI can't wait to hit the waterfront and catch some miles with you all tonight.\n\nA few favorite spots nearby:\nJoyride Pizza (Pier 1) - Steps away along the waterfront, this breezy outpost dishes out caramelized-edge Detroit square slices and local soft serve with prime bay views.\nGolden Boy Pizza - An iconic North Beach counter serving cult-favorite, focaccia-style square slices like clam-and-garlic late into the night.\nTony's Coal-Fired Pizza & Slice House - World pizza champion Tony Gemignani's bustling walk-up window serves award-winning, crispy New York and Sicilian slices to go.\nEscape from New York Pizza - A casual Financial District staple slinging classic, foldable thin-crust slices until the early morning hours.\nJoyride Pizza (Market Street) - Walkable straight up lower Market from the plaza, this late-night outpost keeps the oven fired until 2 a.m. for crispy, cheesy Detroit-style slabs.\n\n**RSVP via:**\nhttps://app.gistirl.com/event-details/uAYeW8e993ZaoVscFCH1?utm_source=meetup&utm_content=a\n**Early Bird Discounts | More $ Later**","startDate":"2026-12-05T03:30:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-4-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"Ferry Building","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"1 Ferry Building, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Gist IRL SF","url":"https://www.meetup.com/gist-irl/"},"performer":"Gist IRL SF"},{"@context":"https://schema.org","@type":"Event","name":"Ruby on Rails 'Yelp' clone","url":"https://www.meetup.com/live-premium-project/events/317373220/","description":"This tutorial will cover all the details (resources, tools, languages etc) that are necessary to build a complete and operational Job Searching Website. You will be guided through all the steps and concepts, starting from the basic ones like setting up the right tools and frameworks to the more advanced topics related to the development. And ultimately you will be able to create your own Job listing or searching website without any difficulty.","startDate":"2026-11-30T20:00:00.000Z","endDate":"","eventStatus":"https://schema.org/EventScheduled","image":"/images/fallbacks/redesign/group-cover-2-square.webp","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":"LiveEdu.tv","address":{"@type":"PostalAddress","addressLocality":"San Francisco","addressRegion":"CA","addressCountry":"us","streetAddress":"https://www.liveedu.tv/gregersen/REd45-ruby-on-rails-yelp-clone/, San Francisco, CA"}},"organizer":{"@type":"Organization","name":"Live Premium Project Tutorial","url":"https://www.meetup.com/live-premium-project/"},"performer":"Live Premium Project Tutorial"}]</script><link rel="preload" href="https://secure.meetupstatic.com/photos/event/d/b/1/hi