<style id="wp-custom-css">
header#header #large-wrap #pre-nav ul.social-icons li.logo a {
	width: 221px;
}

h2, h3 {
	line-height: 1.2em;
}

/* Give Donation Plugin Styles */

.give-progress-bar {
    height: 20px;
    position: relative;
    background: #eee;
    border-radius: 25px;
    overflow: hidden;
    width:100%;
}

#give-form-30976-wrap{
	margin:0 auto;
}
#give-form-30976-wrap ul{
    list-style: none;
	
}
#give-form-30976-wrap li{
   display: inline-block;
	margin-right:5px;	
}


#give-donation-level-radio-list>li {
    list-style-type: none;
    list-style-image: none;
    margin-right: 2% !important;
	margin-bottom:2% !important;
	color: #333333;
    background-color: #e6e6e6;
	border: 1px solid #adadad;
	stroke-width: 2px;
	padding-bottom: 2px;
	
}
section.p2 {
    width: 100%;
     padding: 1em 0;
}
.give-btn {
    border: 1px solid #ccc;
    cursor: pointer;
	width:100%;
	font-size: 1.25em;
	font-weight: 700;
    text-decoration: none;
    line-height: 2em;
    background-color: #68bb66 !important;
    box-shadow: 3px 3px 0px #1E86A9 !important;
    outline: 0;
    color: #FFF !important;
    transition: background-color 0.2s ease-out, box-shadow 0.2s ease-out;
} 
[id*=give-form] .give-form-title {
    padding: 2px;
    margin: 0 0 15px;
	display:none;
}

