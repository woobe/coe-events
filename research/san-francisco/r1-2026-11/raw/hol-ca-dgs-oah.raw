        <script type="text/javascript">

            $(document).ready(function () {

                var accordionContents = "";
                var breadCrumbContents = "";
                var navContents = "";

                $('.accordionclick').each(function () {
                    accordionContents += $(this).html();
                });

                $('.bread-crumbhtml').each(function () {
                    breadCrumbContents += $(this).html();
                });

                $('.local-navhtml').each(function () {
                    navContents += $(this).html();
                });

                $('#accordionclick').html(accordionContents);
                $('#bread-crumbhtml').html(breadCrumbContents);
                $('#local-navhtml').html(navContents);

            });

        </script>

